# Database
DATABASE_URL=postgres://rr:firefly@localhost:5432/rr?sslmode=disable

# Stripe (payments + tax)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to any value in local dev to stop the per-minute subscription renewal
# scheduler from running on boot (it charges due subscriptions via Stripe).
# Leave unset in staging/prod so renewals process normally.
DISABLE_RENEWAL_SCHEDULER=

# QuickBooks Online (wholesale invoicing + net-7 billing).
# Leave QB_CLIENT_ID blank to disable the integration entirely (no QB workers,
# no reconciliation poll). When set, QB_WEBHOOK_VERIFIER_TOKEN and
# QB_TOKEN_ENCRYPTION_KEY are required.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox                 # "sandbox" or "production"
QB_REDIRECT_URI=                       # OAuth callback, e.g. https://host/admin/settings/integrations/quickbooks/callback
QB_WEBHOOK_VERIFIER_TOKEN=             # Intuit webhook verifier token (POST /webhooks/quickbooks)
QB_TOKEN_ENCRYPTION_KEY=               # base64-encoded 32-byte AES-256 key for token storage at rest

# Shipping label provider. Shippo is the active provider; EasyPost is kept as
# a fallback (set EASYPOST_API_KEY and leave SHIPPO_API_KEY blank to use it).
SHIPPO_API_KEY=
EASYPOST_API_KEY=
# Secret for the inbound Shippo tracking webhook. Shippo can't sign webhooks,
# so this rides in the URL path: register the webhook in Shippo as
# https://<host>/webhooks/shippo/<this-secret> for the track_updated event.
# Leave blank to disable the endpoint. Use a long random string.
SHIPPO_WEBHOOK_SECRET=

# Email (Postmark)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
BASE_URL=
STORE_NAME=
STAFF_NOTIFICATION_EMAIL=

# Merchant local timezone (IANA name) — used for "today/this week" dashboard boundaries
MERCHANT_TIMEZONE=America/Los_Angeles

# Hour (0–23, merchant-local) that subscriptions renew at. Renewals batch into
# this pre-dawn window so the day's orders are ready for morning fulfillment
# instead of trickling in. Defaults to 2 (2am) when unset.
RENEWAL_ANCHOR_HOUR=2

# Hour (0–23, merchant-local) before which renewal notification emails (receipt,
# past-due, subscription-ended) are held, so the pre-dawn batch doesn't ping
# customers at 2am. Renewals at/after this hour email immediately. Default 8.
RENEWAL_EMAIL_SEND_HOUR=8

# Cloudflare Images (product media)
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGES_BASE_URL=

# Cloudflare Turnstile (bot protection on public forms — /wholesale/apply)
# Leave both empty to disable verification (honeypot still active).
# Cloudflare always-pass test pair (use in dev only):
#   site=1x00000000000000000000AA  secret=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (private object storage — shipping labels)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# QuickBooks tenant. Single-tenant deployments leave this blank (defaults to a
# fixed UUID). Set to a valid UUID only if you run multiple QB-connected tenants.
TENANT_ID=

# Set to "true" only for local http development. The OAuth state cookie is
# marked Secure by default and won't be sent back over plain http://localhost,
# which breaks the QuickBooks connect flow (CSRF check fails). Never set in prod.
INSECURE_COOKIES=

# Sentry (error tracking) — leave DSN empty to disable
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# WooCommerce Migration (only needed for cmd/migrate)
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_BASE_URL=https://rockabillyroasting.com
