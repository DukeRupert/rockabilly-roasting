# Database
DATABASE_URL=postgres://rr:firefly@localhost:5432/rr?sslmode=disable

# Stripe (payments + tax)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to any value in local dev to stop the per-minute subscription renewal
# scheduler from running on boot (it charges due subscriptions via Stripe).
# Leave unset in staging/prod so renewals process normally.
DISABLE_RENEWAL_SCHEDULER=

# QuickBooks Online (wholesale invoicing + net-7 billing).
# Leave QB_CLIENT_ID blank to disable the integration entirely (no QB workers,
# no reconciliation poll). When set, QB_WEBHOOK_VERIFIER_TOKEN,
# QB_TOKEN_ENCRYPTION_KEY, and QB_SALES_ITEM_ID are required.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox                 # "sandbox" or "production"
QB_REDIRECT_URI=                       # OAuth callback, e.g. https://host/admin/settings/integrations/quickbooks/callback
QB_WEBHOOK_VERIFIER_TOKEN=             # Intuit webhook verifier token (POST /webhooks/quickbooks)
QB_TOKEN_ENCRYPTION_KEY=               # base64-encoded 32-byte AES-256 key for token storage at rest
QB_SALES_ITEM_ID=                      # QB Item ID every invoice product line bills against (QBO requires an ItemRef per line)
QB_SHIPPING_ITEM_ID=                   # optional QB Item ID for the shipping line; falls back to QB_SALES_ITEM_ID

# Shipping label provider. Shippo is the active provider; EasyPost is kept as
# a fallback (set EASYPOST_API_KEY and leave SHIPPO_API_KEY blank to use it).
SHIPPO_API_KEY=
EASYPOST_API_KEY=
# Label file format Shippo returns: PNG (default), PDF (8.5x11), or PDF_4x6
# (4x6 thermal label). PNG is what the merchant's label printer prints cleanest.
# Leave blank for PNG.
SHIPPO_LABEL_FORMAT=
# Secret for the inbound Shippo tracking webhook. Shippo can't sign webhooks,
# so this rides in the URL path: register the webhook in Shippo as
# https://<host>/webhooks/shippo/<this-secret> for the track_updated event.
# Leave blank to disable the endpoint. Use a long random string.
SHIPPO_WEBHOOK_SECRET=

# Email (Postmark)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
BASE_URL=
STORE_NAME=
STAFF_NOTIFICATION_EMAIL=                # staff inbox for wholesale applications + QB invoicing failure alerts

# Merchant local timezone (IANA name) — used for "today/this week" dashboard boundaries
MERCHANT_TIMEZONE=America/Los_Angeles

# Hour (0–23, merchant-local) that subscriptions renew at. Renewals batch into
# this pre-dawn window so the day's orders are ready for morning fulfillment
# instead of trickling in. Defaults to 2 (2am) when unset.
RENEWAL_ANCHOR_HOUR=2

# Hour (0–23, merchant-local) before which renewal notification emails (receipt,
# past-due, subscription-ended) are held, so the pre-dawn batch doesn't ping
# customers at 2am. Renewals at/after this hour email immediately. Default 8.
RENEWAL_EMAIL_SEND_HOUR=8

# Weekly wholesale order reminder ("place your order before the cutoff").
# Migrated off the standalone rr service in 2026-08. Defaults: Friday, 10am,
# merchant-local. ORDER_REMINDER_TIMEZONE exists because the old service ran on
# America/Denver while MERCHANT_TIMEZONE here is America/Los_Angeles — set it
# only if the reminder must fire on a different clock from renewals.
# ORDER_REMINDER_WEEKDAY=Friday
# ORDER_REMINDER_HOUR=10
# ORDER_REMINDER_TIMEZONE=America/Denver
# Set to any value to stop the weekly reminder firing (useful in dev/staging).
# DISABLE_ORDER_REMINDERS=1

# Signs the one-click opt-out links in reminder emails (HMAC, no DB rows, never
# expires — an unsubscribe link has to work for as long as the email sits in an
# inbox). Any long random string; generate with: openssl rand -hex 32
#
# Unset is safe but degrades: the reminder omits the link and falls back to
# "reply and we'll take you off the list", and the List-Unsubscribe headers are
# dropped, so Gmail/Apple show no native unsubscribe button. The server logs a
# warning at boot when this happens.
#
# Rotating this invalidates every outstanding link in already-delivered email.
UNSUBSCRIBE_SECRET=

# Signs the one-click "switch to pickup" links in order confirmation emails
# (HMAC, no DB rows, 14-day expiry — unlike an opt-out link, this one mutates an
# order, so it should not still be live in a forwarded inbox months later).
# Any long random string; generate with: openssl rand -hex 32
#
# No minimum length is enforced, but use at least 32 bytes of entropy: the order
# ID travels in the clear and this signature is the only thing making the link
# unforgeable. Past 64 bytes adds nothing — HMAC hashes longer keys down.
#
# Falls back to UNSUBSCRIBE_SECRET when unset, so the feature works on existing
# deployments without a new variable; the token's purpose is inside the signed
# payload, so sharing one key cannot let an opt-out link stand in for an order
# link. Set this to rotate the two independently.
#
# With neither set, orders still place normally — the confirmation email just
# omits the pickup offer and asks the customer to reply. The server logs a
# warning at boot.
#
# Rotating this invalidates every outstanding link in already-delivered email.
ORDER_ACTION_SECRET=

# Product media delivery. Public domain fronting the R2 bucket with Cloudflare
# Image Transformations enabled, e.g. https://media.rockabillyroasting.com —
# no trailing slash. Product image URLs are built as
#   <MEDIA_BASE_URL>/cdn-cgi/image/<params>/<r2_key>
#
# Unset does not fail the boot: URLs come out root-relative (/cdn-cgi/image/...)
# and resolve against the storefront's own domain, which only works if that
# domain is itself proxied through Cloudflare with Transformations turned on.
# Set it explicitly rather than relying on that.
MEDIA_BASE_URL=

# Cloudflare Turnstile (bot protection on public forms — /wholesale/apply)
# Leave both empty to disable verification (honeypot still active).
# Cloudflare always-pass test pair (use in dev only):
#   site=1x00000000000000000000AA  secret=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Broadwave (newsletter list behind the storefront footer signup form).
# The form posts to Hiri's /newsletter/subscribe, which calls Broadwave with
# this key — it must never appear in a template, it used to be a hidden input
# in the footer and bots scraped it. Leave BROADWAVE_API_KEY empty to disable
# (the form then accepts input and subscribes nobody).
# BROADWAVE_BASE_URL defaults to https://broadwave.fireflysoftware.dev
BROADWAVE_BASE_URL=
BROADWAVE_API_KEY=
BROADWAVE_LIST=rockabilly-roasting-newsletter

# Google Geocoding API — address to lat/lng for delivery route planning. The
# only paid external call in the routing feature, and cache-first: repeat
# customers are geocoded exactly once, so the real bill is pennies a month.
# Leave empty to disable — cached addresses still resolve and new ones fail
# loudly rather than routing a driver to a guessed coordinate.
# Requires the "Geocoding API" enabled on the key's Google Cloud project.
GOOGLE_GEOCODING_API_KEY=

# Cloudflare R2 (S3-compatible object storage). One bucket backs both product
# images (served publicly via MEDIA_BASE_URL above) and shipping labels
# (fetched through the app, never linked directly).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# QuickBooks tenant. Single-tenant deployments leave this blank (defaults to a
# fixed UUID). Set to a valid UUID only if you run multiple QB-connected tenants.
TENANT_ID=

# Set to "true" only for local http development. The OAuth state cookie is
# marked Secure by default and won't be sent back over plain http://localhost,
# which breaks the QuickBooks connect flow (CSRF check fails). Never set in prod.
INSECURE_COOKIES=

# Sentry (error tracking) — leave DSN empty to disable
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# WooCommerce Migration (only needed for cmd/migrate)
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_BASE_URL=https://rockabillyroasting.com
