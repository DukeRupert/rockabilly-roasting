package admin

import "encoding/json"

// Action affordances for admin buttons.
//
// Two pieces, used together:
//
//   - ActionWrap renders a hover/focus tooltip next to an action so staff can
//     see what a button does BEFORE clicking it. The caller puts
//     aria-describedby={hintID} on the button itself, so the hint is announced
//     to screen readers along with the label rather than being decoration.
//
//   - ActionConfirm replaces window.confirm() on consequential actions. The
//     browser dialog could only render one unstyled paragraph, so the real
//     consequences ("this does not refund the payment") were being crammed
//     into a sentence nobody finishes reading. The dialog below gets a title,
//     a lead line, and a scannable list of what actually happens.
//
// Both are admin-scoped: quiet hairlines and rr-* tokens, no stamp shadows.
// See docs/admin-ui.md.

// ActionWrap positions a tooltip against the action it describes. hint may be
// empty, in which case only the children render — handy for call sites that
// build the hint conditionally.
templ ActionWrap(hintID string, hint string) {
	<span class="action-wrap">
		{ children... }
		if hint != "" {
			<span id={ hintID } role="tooltip" class="action-hint">{ hint }</span>
		}
	</span>
}

// ActionConfirm is the copy shown in the confirmation dialog. Points is the
// list of consequences — write them as plain statements of what happens
// ("The customer is not emailed"), not as warnings.
type ActionConfirm struct {
	Title   string   `json:"title"`
	Lead    string   `json:"lead"`
	Points  []string `json:"points"`
	Confirm string   `json:"confirm"`
	Danger  bool     `json:"danger"`
}

// ConfirmAttrs spreads onto the submit BUTTON to route its action through the
// confirmation dialog instead of straight to the server:
//
//	<button type="submit" { ConfirmAttrs(c)... }>Cancel order</button>
//
// It has to be the click, not the form's submit event: the admin layout sets
// hx-boost="true" on <body>, so htmx intercepts form submits and fires its own
// AJAX request. An @submit.prevent stops the browser's native submission but
// not htmx's — the action would go through with the dialog never shown.
// Cancelling the click means no submit event is ever generated, which is the
// same reason the old onclick="return confirm(…)" worked.
//
// The copy rides along as JSON in a data attribute rather than being
// interpolated into the Alpine expression — quoting order totals and copy
// with apostrophes inside an inline handler is how you get a silently broken
// button. x-data="" gives the button its own Alpine scope so it works anywhere
// on the page, and the event is dispatched at the window so the single dialog
// host can live wherever it fits the layout.
func ConfirmAttrs(c ActionConfirm) templ.Attributes {
	payload, err := json.Marshal(c)
	if err != nil {
		// Marshalling a struct of strings and bools cannot fail. If it somehow
		// did, fall back to a plain form: submitting without a confirmation is
		// bad, but a form that cannot submit at all is worse.
		return templ.Attributes{}
	}
	return templ.Attributes{
		"x-data":         "",
		"data-confirm":   string(payload),
		"@click.prevent": "$dispatch('admin-confirm', { form: $el.form, copy: JSON.parse($el.dataset.confirm) })",
	}
}

// ConfirmJSAttrs is ConfirmAttrs for actions whose copy is only known in the
// browser — the fulfillment page's bulk buttons, where the count comes from
// the Alpine selection. copyExpr is a JavaScript expression evaluated in the
// button's Alpine scope that must produce the same shape as ActionConfirm:
//
//	ConfirmJSAttrs(`{ title: 'Buy ' + selected.length + ' labels?', danger: true }`)
//
// Prefer ConfirmAttrs wherever the copy is static — it keeps the words in Go
// where they can be read and reviewed alongside the action.
func ConfirmJSAttrs(copyExpr string) templ.Attributes {
	return templ.Attributes{
		"@click.prevent": "$dispatch('admin-confirm', { form: $el.form, copy: " + copyExpr + " })",
	}
}

// ConfirmDataAttrs spreads onto an element that already carries hx-confirm,
// giving that confirmation the full title/lead/points treatment:
//
//	<form hx-post="…" hx-confirm="Delete this option?" { ConfirmDataAttrs(c)... }>
//
// htmx-driven actions do not go through a form submit, so ConfirmAttrs's click
// hook does not apply — admin-confirm.js intercepts htmx:confirm instead and
// reads this attribute. hx-confirm must stay: it is what makes htmx raise the
// event at all. Its text becomes the fallback if this JSON ever fails to parse.
func ConfirmDataAttrs(c ActionConfirm) templ.Attributes {
	payload, err := json.Marshal(c)
	if err != nil {
		return templ.Attributes{}
	}
	return templ.Attributes{"data-confirm": string(payload)}
}

// ConfirmDialogHost renders the single dialog every ConfirmAttrs button on the
// page shares. Include it once per page that uses ConfirmAttrs, ConfirmJSAttrs,
// or hx-confirm — hx-confirm is routed through the same dialog by
// admin-confirm.js rather than the browser's own prompt.
templ ConfirmDialogHost() {
	<div
		x-data="adminConfirm"
		@admin-confirm.window="ask($event)"
		@keydown.escape.window="close()"
	>
		<div
			x-cloak
			x-show="open"
			class="fixed inset-0 z-50 flex items-center justify-center p-4"
			role="dialog"
			aria-modal="true"
			:aria-label="copy.title"
		>
			<div class="absolute inset-0 bg-rr-heading/40" @click="close()"></div>
			<div class="relative w-full max-w-md border border-rr-border bg-rr-surface p-5 shadow-sm">
				<h2 class="text-base font-semibold text-rr-heading" x-text="copy.title"></h2>
				<p class="mt-1.5 text-sm text-rr-body" x-text="copy.lead"></p>
				<template x-if="copy.points && copy.points.length">
					<ul class="mt-3 space-y-1.5 border-t border-rr-border pt-3">
						<template x-for="point in copy.points" :key="point">
							<li class="flex gap-2 text-sm text-rr-body">
								<span class="text-rr-muted" aria-hidden="true">&mdash;</span>
								<span x-text="point"></span>
							</li>
						</template>
					</ul>
				</template>
				<div class="mt-5 flex justify-end gap-2">
					<button type="button" class="btn-secondary" @click="close()">Cancel</button>
					<button
						type="button"
						x-ref="confirm"
						@click="go()"
						:class="copy.danger ? 'btn-danger' : 'btn-confirm'"
						x-text="copy.confirm || 'Confirm'"
					></button>
				</div>
			</div>
		</div>
	</div>
}
