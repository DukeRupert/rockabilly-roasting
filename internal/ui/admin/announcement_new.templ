package admin

import (
	"strconv"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type AnnouncementNewProps struct {
	// Counts is the live headcount per audience, so the choice is made against
	// real numbers rather than a guess about how big the retail list is.
	Counts map[domain.AnnouncementAudience]int
	// Selected is the audience to preselect, so a link in from the Order
	// Reminders page lands on "wholesale" already chosen.
	Selected domain.AnnouncementAudience
	// DefaultSendAt prefills the schedule field with merchant-local "now".
	DefaultSendAt string
	// TZAbbrev labels the schedule field with the shop's timezone, so nobody
	// has to wonder whose 9am they just typed.
	TZAbbrev string
	// TestAddress is where the preview send goes — the signed-in staff member.
	TestAddress string
	StaffName   string
	StaffRole   string
}

// audienceCount reads a headcount out of the map and pluralizes it. Staff read
// these three lines side by side to pick an audience; "1 accounts" reads like a
// bug in the count rather than a real number.
func audienceCount(counts map[domain.AnnouncementAudience]int, a domain.AnnouncementAudience) string {
	if counts[a] == 1 {
		return "1 account"
	}
	return strconv.Itoa(counts[a]) + " accounts"
}

// AnnouncementTestResult is the inline answer to a test send. Rendered on its
// own so the composer can swap just this line and keep the draft intact —
// losing what you typed is how previewing stops being worth doing.
templ AnnouncementTestResult(message string, ok bool) {
	if ok {
		<p class="text-sm text-rr-heading">{ message }</p>
	} else {
		<p class="text-sm text-rr-red">{ message }</p>
	}
}

templ AnnouncementNewContent(props AnnouncementNewProps) {
	@adminSectionTabs(customersTabs(), "/admin/announcements")
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Write an Announcement</h1>
			<p class="mt-1 text-sm text-rr-muted">
				Plain text only &mdash; blank lines start a new paragraph, and links pasted in full become clickable. It goes out in the shop's email template, so don't paste HTML.
			</p>
		</div>
	</div>
	<form method="post" action="/admin/announcements" class="mt-8 max-w-2xl space-y-6">
		<div>
			<span class="block text-sm/6 font-medium text-rr-heading">Who gets it</span>
			<div class="mt-2 space-y-2">
				<label class="flex items-start gap-3 border border-rr-border bg-rr-surface p-3">
					<input type="radio" name="audience" value="all" checked?={ props.Selected == domain.AnnouncementAudienceAll } class="mt-1"/>
					<span class="text-sm">
						<span class="font-medium text-rr-heading">All customers</span>
						<span class="block text-rr-muted">{ audienceCount(props.Counts, domain.AnnouncementAudienceAll) } &mdash; everyone below, combined.</span>
					</span>
				</label>
				<label class="flex items-start gap-3 border border-rr-border bg-rr-surface p-3">
					<input type="radio" name="audience" value="retail" checked?={ props.Selected == domain.AnnouncementAudienceRetail } class="mt-1"/>
					<span class="text-sm">
						<span class="font-medium text-rr-heading">Retail customers</span>
						<span class="block text-rr-muted">{ audienceCount(props.Counts, domain.AnnouncementAudienceRetail) } &mdash; retail customers who have actually ordered or hold a subscription. Signups who never bought are left out.</span>
					</span>
				</label>
				<label class="flex items-start gap-3 border border-rr-border bg-rr-surface p-3">
					<input type="radio" name="audience" value="wholesale" checked?={ props.Selected == domain.AnnouncementAudienceWholesale } class="mt-1"/>
					<span class="text-sm">
						<span class="font-medium text-rr-heading">Wholesale accounts</span>
						<span class="block text-rr-muted">{ audienceCount(props.Counts, domain.AnnouncementAudienceWholesale) } &mdash; approved wholesale only, plus any teammates on those accounts.</span>
					</span>
				</label>
			</div>
			<p class="mt-2 text-xs text-rr-muted">
				Counts are what would send right now. The real list is worked out at send time, so anyone who unsubscribes or gets suspended in between is dropped.
			</p>
		</div>
		<div>
			<label for="subject" class="block text-sm/6 font-medium text-rr-heading">Subject</label>
			<div class="mt-2">
				<input
					type="text"
					name="subject"
					id="subject"
					required
					maxlength="120"
					placeholder="e.g. Labor Day: Monday's delivery moves to Tuesday"
					class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"
				/>
			</div>
			<p class="mt-1 text-xs text-rr-muted">Doubles as the heading inside the email.</p>
		</div>
		<div>
			<label for="body" class="block text-sm/6 font-medium text-rr-heading">Message</label>
			<div class="mt-2">
				<textarea
					name="body"
					id="body"
					rows="10"
					required
					placeholder="The shop is closed Monday for Labor Day, so the Monday delivery run moves to Tuesday.&#10;&#10;Everything else is unchanged — order by the usual cutoff and we'll have it on the van."
					class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"
				></textarea>
			</div>
		</div>
		<div>
			<span class="block text-sm/6 font-medium text-rr-heading">When</span>
			<div class="mt-2 space-y-2">
				<label class="flex items-center gap-3 text-sm text-rr-heading">
					<input type="radio" name="when" value="now" checked/>
					Send as soon as I confirm
				</label>
				<label class="flex flex-wrap items-center gap-3 text-sm text-rr-heading">
					<input type="radio" name="when" value="schedule"/>
					Send at
					<input
						type="datetime-local"
						name="send_at"
						value={ props.DefaultSendAt }
						class="rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
					/>
					<span class="text-rr-muted">{ props.TZAbbrev } (shop time)</span>
				</label>
			</div>
			<p class="mt-2 text-xs text-rr-muted">A scheduled announcement can be cancelled any time before it starts sending.</p>
		</div>
		<div class="border-t border-rr-border pt-6">
			<div class="flex flex-wrap items-center gap-3">
				<button
					type="submit"
					class="rounded-sm bg-rr-red px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
					onclick="return confirm('Send this to the selected audience? This cannot be undone once it starts sending.')"
				>
					Schedule announcement
				</button>
				<!--
					Posts the draft to a preview endpoint and swaps only the
					result line, so everything typed above survives. hx-include
					pulls the subject and body out of the form this button sits
					in without submitting it.
				-->
				<button
					type="button"
					hx-post="/admin/announcements/test"
					hx-include="closest form"
					hx-target="#test-result"
					hx-swap="innerHTML"
					class="rounded-sm border border-rr-border bg-rr-surface px-3 py-1.5 text-sm/6 font-semibold text-rr-heading hover:bg-rr-raised"
				>
					Send me a test first
				</button>
				<a href="/admin/announcements" class="text-sm/6 font-semibold text-rr-muted hover:text-rr-heading">Cancel</a>
			</div>
			<div id="test-result" class="mt-3">
				if props.TestAddress != "" {
					<p class="text-sm text-rr-muted">The test goes to { props.TestAddress }.</p>
				}
			</div>
		</div>
	</form>
}

templ AnnouncementNew(props AnnouncementNewProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Write an Announcement",
		ActivePath: "/admin/customers",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@AnnouncementNewContent(props)
	}
}
