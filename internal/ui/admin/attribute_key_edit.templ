package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type AttributeKeyEditProps struct {
	Set       *domain.AttributeSet
	Key       *domain.AttributeKey
	KeyCount  int
	Flash     string
	StaffName string
	StaffRole string
}

templ AttributeKeyEditContent(props AttributeKeyEditProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">{ props.Key.Name }</h1>
			<p class="mt-2 text-sm text-rr-muted">
				Attribute key in
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/attributes/%s", props.Set.ID)) } class="text-rr-red hover:text-rr-red-lt">{ props.Set.Name }</a>
			</p>
		</div>
		<div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/admin/attributes/%s", props.Set.ID)) }
				class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border-2 border-rr-border hover:bg-rr-raised"
			>
				Back to set
			</a>
		</div>
	</div>
	if props.Flash != "" {
		<div class="mt-4 rounded-sm badge-green p-4">
			<div class="flex">
				<div class="flex-shrink-0">
					<svg class="size-5" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
					</svg>
				</div>
				<div class="ml-3">
					<p class="text-sm font-medium">{ props.Flash }</p>
				</div>
			</div>
		</div>
	}
	<!-- Edit key form — Alpine.js manages type selection, tag editor, and change warning -->
	<form
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/admin/attributes/%s/keys/%s", props.Set.ID, props.Key.ID)) }
		x-data={ fmt.Sprintf(`{
			valueType: '%s',
			originalType: '%s',
			allowedValues: %s,
			newValue: '',
			get typeChanged() { return this.valueType !== this.originalType },
			get isEnum() { return this.valueType === 'enum' || this.valueType === 'multi_enum' },
			addValue() {
				let v = this.newValue.trim();
				if (v && !this.allowedValues.includes(v)) {
					this.allowedValues.push(v);
				}
				this.newValue = '';
			},
			removeValue(i) {
				this.allowedValues.splice(i, 1);
			}
		}`, props.Key.ValueType, props.Key.ValueType, allowedValuesJSON(props.Key)) }
	>
		<!-- Zone 1: Identity -->
		<div class="mt-8 border-2 border-rr-border bg-rr-surface">
			<div class="px-4 py-5 sm:px-6">
				<h3 class="text-base/7 font-semibold text-rr-heading">Identity</h3>
			</div>
			<div class="border-t border-rr-border px-4 py-5 sm:px-6">
				<div class="flex items-end gap-3 flex-wrap">
					<div class="flex-1 min-w-[200px]">
						<label for="key_name" class="block text-sm/6 font-medium text-rr-heading">Name</label>
						<div class="mt-2">
							<input type="text" id="key_name" name="name" value={ props.Key.Name } required class={ inputClasses(false) }/>
						</div>
					</div>
					<div class="flex-1 min-w-[200px]">
						<label for="key_slug" class="block text-sm/6 font-medium text-rr-heading">Slug</label>
						<div class="mt-2">
							<input type="text" id="key_slug" name="slug" value={ props.Key.Slug } class={ inputClasses(false) }/>
						</div>
					</div>
					<div class="w-20">
						<label for="key_position" class="block text-sm/6 font-medium text-rr-heading">Order</label>
						<div class="mt-2">
							<input type="number" id="key_position" name="position" value={ fmt.Sprintf("%d", props.Key.Position) } class={ inputClasses(false) }/>
						</div>
						<p class="mt-1 text-xs text-rr-muted">
							of { fmt.Sprintf("%d", props.KeyCount) }
						</p>
					</div>
				</div>
			</div>
		</div>
		<!-- Zone 2: Behavior -->
		<div class="mt-8 border-2 border-rr-border bg-rr-surface">
			<div class="px-4 py-5 sm:px-6">
				<h3 class="text-base/7 font-semibold text-rr-heading">Behavior</h3>
			</div>
			<div class="border-t border-rr-border px-4 py-5 sm:px-6 space-y-6">
				<!-- Value type tile selector -->
				<div>
					<span class="block text-sm/6 font-medium text-rr-heading mb-3">Value type</span>
					<!-- Hidden input synced to Alpine -->
					<input type="hidden" name="value_type" x-bind:value="valueType"/>
					<div class="grid grid-cols-2 gap-2 sm:grid-cols-5">
						@typeTile("text", "Abc", "Text", "Free input")
						@typeTile("enum", "List", "Enum", "Pick one")
						@typeTile("multi_text", "Tags", "Multi Text", "Free tags")
						@typeTile("multi_enum", "Checks", "Multi Enum", "Pick many")
						@typeTile("boolean", "Toggle", "Boolean", "Yes / No")
					</div>
				</div>
				<!-- Type change warning -->
				<div
					x-show="typeChanged"
					x-cloak
					class="rounded-sm px-4 py-3 ring-1 ring-rr-amber bg-rr-amber-dark/20"
				>
					<div class="flex items-start gap-2">
						<svg class="size-5 text-rr-amber mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
						</svg>
						<p class="text-sm text-rr-amber-lt">
							Changing the value type may invalidate existing product data using this key.
							<span x-show="!isEnum && allowedValues.length > 0">Allowed values will be cleared.</span>
						</p>
					</div>
				</div>
				<!-- Allowed values tag editor -->
				<div x-show="isEnum" x-cloak>
					<span class="block text-sm/6 font-medium text-rr-heading mb-2">Allowed values</span>
					<!-- Hidden input serializes the array as comma-separated for the form post -->
					<input type="hidden" name="allowed_values" x-bind:value="allowedValues.join(', ')"/>
					<div class="border-2 border-rr-border bg-rr-surface px-3 py-2 min-h-[44px] flex flex-wrap items-center gap-2">
						<template x-for="(val, i) in allowedValues" :key="i">
							<span class="inline-flex items-center gap-1 rounded-sm bg-rr-raised px-2 py-1 text-sm text-rr-body ring-1 ring-rr-border">
								<span x-text="val"></span>
								<button type="button" @click="removeValue(i)" class="text-rr-muted hover:text-rr-red ml-0.5" aria-label="Remove value">
									<svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor">
										<path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"></path>
									</svg>
								</button>
							</span>
						</template>
						<input
							type="text"
							x-model="newValue"
							@keydown.enter.prevent="addValue()"
							placeholder="Add value..."
							class="flex-1 min-w-[120px] bg-transparent text-sm text-rr-heading placeholder:text-rr-muted outline-none"
						/>
					</div>
					<p class="mt-1 text-xs text-rr-muted">Press Enter to add. Required for enum types.</p>
				</div>
				<div x-show="!isEnum" x-cloak>
					<p class="text-sm text-rr-muted">No predefined values for this type.</p>
				</div>
				<!-- Filterable / Sortable toggle switches -->
				<div class="space-y-0 divide-y divide-rr-border border-2 border-rr-border">
					@toggleRow("filterable", "Filterable", "Shows in the storefront filter sidebar", props.Key.Filterable)
					@toggleRow("sortable", "Sortable", "Available in the storefront sort dropdown", props.Key.Sortable)
				</div>
			</div>
		</div>
		<!-- Save button -->
		<div class="mt-6 flex justify-end">
			<button type="submit" class="rounded-sm bg-rr-red px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt">
				Save changes
			</button>
		</div>
	</form>
	<!-- Zone 3: Danger -->
	<div class="mt-8 border-2 border-rr-border bg-rr-surface">
		<div class="px-4 py-5 sm:px-6 flex items-center justify-between">
			<div>
				<h3 class="text-sm font-medium text-rr-heading">Delete attribute key</h3>
				<p class="mt-0.5 text-sm text-rr-muted">Product values using this key will be lost.</p>
			</div>
			<form
				method="post"
				action={ templ.SafeURL(fmt.Sprintf("/admin/attributes/%s/keys/%s/delete", props.Set.ID, props.Key.ID)) }
				onsubmit="return confirm('Are you sure you want to delete this attribute key?')"
			>
				<button type="submit" class="btn-danger">
					Delete key
				</button>
			</form>
		</div>
	</div>
}

// typeTile renders a selectable tile for the value type picker.
templ typeTile(value, icon, label, desc string) {
	<button
		type="button"
		@click={ fmt.Sprintf("valueType = '%s'", value) }
		x-bind:class={ fmt.Sprintf("valueType === '%s' ? 'ring-2 ring-rr-amber bg-rr-raised' : 'ring-2 ring-rr-border hover:bg-rr-raised/50'", value) }
		class="rounded-sm px-3 py-3 text-left transition-colors cursor-pointer"
	>
		<span class="block text-xs font-semibold text-rr-muted uppercase tracking-wider">{ icon }</span>
		<span class="block text-sm font-medium text-rr-heading mt-1">{ label }</span>
		<span class="block text-xs text-rr-muted mt-0.5">{ desc }</span>
	</button>
}

// toggleRow renders a labeled toggle switch with description.
templ toggleRow(name, label, description string, checked bool) {
	<label class="flex items-center justify-between px-4 py-4 cursor-pointer hover:bg-rr-raised/30 transition-colors">
		<div>
			<span class="block text-sm font-medium text-rr-heading">{ label }</span>
			<span class="block text-xs text-rr-muted mt-0.5">{ description }</span>
		</div>
		<div class="relative shrink-0 ml-4">
			<input
				type="checkbox"
				name={ name }
				value="true"
				if checked {
					checked
				}
				class="sr-only peer"
			/>
			<div class="w-9 h-5 rounded-full bg-rr-border peer-checked:bg-rr-amber transition-colors"></div>
			<div class="absolute left-0.5 top-0.5 w-4 h-4 rounded-full bg-rr-heading transition-transform peer-checked:translate-x-4"></div>
		</div>
	</label>
}

// allowedValuesJSON returns the allowed values as a JSON array string for Alpine.js.
func allowedValuesJSON(key *domain.AttributeKey) string {
	if len(key.AllowedValues) == 0 {
		return "[]"
	}
	result := "["
	for i, v := range key.AllowedValues {
		if i > 0 {
			result += ","
		}
		result += "'" + v + "'"
	}
	result += "]"
	return result
}

templ AttributeKeyEdit(props AttributeKeyEditProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      props.Key.Name + " - Attribute Key",
		ActivePath: "/admin/attributes",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@AttributeKeyEditContent(props)
	}
}
