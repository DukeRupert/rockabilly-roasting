package admin

import (
	"fmt"
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type AuditListProps struct {
	Entries         []domain.AuditEntry
	ActorTypeFilter string
	ActionFilter    string
	ResourceFilter  string
	Page            int
	PerPage         int
	HasMore         bool
	MerchantTZ      *time.Location
	StaffName       string
	StaffRole       string
}

func auditActorBadgeClass(t domain.AuditActorType) string {
	switch t {
	case domain.AuditActorTypeStaff:
		return "badge badge-slate"
	case domain.AuditActorTypeCustomer:
		return "badge badge-green"
	case domain.AuditActorTypeSystem:
		return "badge badge-grey"
	default:
		return "badge badge-grey"
	}
}

func auditActionDisplay(action string) string {
	// "order.refunded" → "Order Refunded"
	parts := strings.SplitN(action, ".", 2)
	if len(parts) == 2 {
		resource := strings.ReplaceAll(parts[0], "_", " ")
		verb := strings.ReplaceAll(parts[1], "_", " ")
		return strings.Title(resource) + " " + strings.Title(verb)
	}
	return action
}

func auditFilterURL(page int, actorType, action, resource string) string {
	url := fmt.Sprintf("/admin/audit?page=%d", page)
	if actorType != "" {
		url += "&actor_type=" + actorType
	}
	if action != "" {
		url += "&action=" + action
	}
	if resource != "" {
		url += "&resource_type=" + resource
	}
	return url
}

templ AuditListContent(props AuditListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Audit Log</h1>
			<p class="mt-1 text-sm text-rr-muted">Track all changes made to your store</p>
		</div>
	</div>
	<!-- Filters -->
	<form method="get" action="/admin/audit" class="mt-6 flex flex-wrap items-center gap-3">
		<div class="grid grid-cols-1">
			<select
				name="actor_type"
				onchange="this.form.submit()"
				class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
			>
				<option value="">All actors</option>
				<option value="staff" selected?={ props.ActorTypeFilter == "staff" }>Staff</option>
				<option value="customer" selected?={ props.ActorTypeFilter == "customer" }>Customer</option>
				<option value="system" selected?={ props.ActorTypeFilter == "system" }>System</option>
			</select>
			<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</div>
		<div class="grid grid-cols-1">
			<select
				name="resource_type"
				onchange="this.form.submit()"
				class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
			>
				<option value="">All resources</option>
				<option value="order" selected?={ props.ResourceFilter == "order" }>Orders</option>
				<option value="product" selected?={ props.ResourceFilter == "product" }>Products</option>
				<option value="variant" selected?={ props.ResourceFilter == "variant" }>Variants</option>
				<option value="subscription" selected?={ props.ResourceFilter == "subscription" }>Subscriptions</option>
				<option value="customer" selected?={ props.ResourceFilter == "customer" }>Customers</option>
				<option value="address" selected?={ props.ResourceFilter == "address" }>Addresses</option>
				<option value="invoice" selected?={ props.ResourceFilter == "invoice" }>Invoices</option>
			</select>
			<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</div>
		if props.ActorTypeFilter != "" || props.ResourceFilter != "" || props.ActionFilter != "" {
			<a href="/admin/audit" class="text-sm text-rr-muted hover:text-rr-body underline">Clear filters</a>
		}
	</form>
	<!-- Audit table -->
	<div class="mt-6">
		if len(props.Entries) == 0 {
			<div class="border border-dashed border-rr-border p-12 text-center">
				<svg class="mx-auto size-12 text-rr-border" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15a2.25 2.25 0 0 1 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No audit entries</h3>
				<p class="mt-1 text-sm text-rr-muted">No audit entries match the current filters.</p>
			</div>
		} else {
			<div class="overflow-hidden border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">When</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Actor</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Action</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">Resource</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, e := range props.Entries {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-rr-muted sm:pl-6">
									<time datetime={ e.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>
										{ e.CreatedAt.In(props.MerchantTZ).Format("Jan 2 15:04 MST") }
									</time>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									<span class={ auditActorBadgeClass(e.ActorType) }>
										{ string(e.ActorType) }
									</span>
									<span class="ml-1 text-rr-body">{ e.ActorName }</span>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm font-medium text-rr-heading">
									{ auditActionDisplay(e.Action) }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									<span class="text-rr-body">{ e.ResourceType }</span>
									<span class="ml-1 font-mono text-xs text-rr-border">{ e.ResourceID.String()[:8] }</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(auditFilterURL(props.Page-1, props.ActorTypeFilter, props.ActionFilter, props.ResourceFilter)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Previous
						</a>
					}
				</div>
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(auditFilterURL(props.Page+1, props.ActorTypeFilter, props.ActionFilter, props.ResourceFilter)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

templ AuditList(props AuditListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Audit Log",
		ActivePath: "/admin/audit",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@AuditListContent(props)
	}
}
