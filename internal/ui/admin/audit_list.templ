package admin

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// AuditListProps carries the audit log page's rows plus the entire filter
// state. Every control routes its href through auditURL using these fields, so
// no control silently drops another's state — the bug that makes a filter UI
// feel broken.
type AuditListProps struct {
	Entries []domain.AuditEntry

	Search          string
	ActorTypeFilter string
	// Area is an action namespace ("order"); ActionFilter is one exact action
	// inside it ("order.refunded"). The handler drops a stale action when the
	// area changes, so these two are always consistent by the time they land.
	Area           string
	ActionFilter   string
	ResourceFilter string

	// Pinned identities. These arrive from links — the actor and resource cells
	// in the table, or an "audit log" link on a detail page — and render as
	// removable chips. The labels are resolved by the handler so a chip never
	// reads as a bare uuid.
	ActorID       string
	ActorLabel    string
	ResourceID    string
	ResourceLabel string
	// CustomerID pins one customer from either side — what they did and what
	// was done to their account. It is how the customer detail page's activity
	// timeline hands off to the full log.
	CustomerID    string
	CustomerLabel string

	Range string
	From  string
	To    string
	Sort  string

	// Dropdown options, read from what the log actually contains.
	Areas         []string
	Actions       []string
	ResourceTypes []string

	TotalCount int
	Page       int
	PerPage    int
	HasMore    bool

	MerchantTZ *time.Location
	StaffName  string
	StaffRole  string
}

func auditActorBadgeClass(t domain.AuditActorType) string {
	switch t {
	case domain.AuditActorTypeStaff:
		return "badge badge-slate"
	case domain.AuditActorTypeCustomer:
		return "badge badge-green"
	case domain.AuditActorTypeSystem:
		return "badge badge-grey"
	default:
		return "badge badge-grey"
	}
}

// auditActionDisplay turns "order.refunded" into "Order refunded". Only the
// first word is capitalized: a table of title-cased phrases reads as a list of
// proper nouns rather than a list of things that happened.
func auditActionDisplay(action string) string {
	parts := strings.SplitN(action, ".", 2)
	if len(parts) != 2 {
		return action
	}
	return auditHumanize(parts[0]) + " " + strings.ReplaceAll(parts[1], "_", " ")
}

// auditHumanize turns a snake_case token into a capitalized phrase, for the
// dropdown options and the leading word of an action label.
func auditHumanize(s string) string {
	s = strings.ReplaceAll(s, "_", " ")
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

// auditQueryValues renders the current filter state as query parameters,
// omitting anything at its default. Every URL on the page starts here.
func auditQueryValues(p AuditListProps) url.Values {
	v := url.Values{}
	set := func(k, val string) {
		if val != "" {
			v.Set(k, val)
		}
	}
	set("q", p.Search)
	set("actor_type", p.ActorTypeFilter)
	set("area", p.Area)
	set("action", p.ActionFilter)
	set("resource_type", p.ResourceFilter)
	set("actor_id", p.ActorID)
	set("resource_id", p.ResourceID)
	set("customer_id", p.CustomerID)
	set("range", p.Range)
	if p.Range == "custom" {
		set("from", p.From)
		set("to", p.To)
	}
	set("sort", auditSortParam(p.Sort))
	return v
}

// auditSortParam blanks the default sort so it never appears in a URL — the
// hidden input the search box carries would otherwise push "sort=newest" into
// the address bar on the first keystroke.
func auditSortParam(sort string) string {
	if sort == "oldest" {
		return "oldest"
	}
	return ""
}

// auditURL builds a list URL from the current state with the given overrides
// applied. An override to "" removes the parameter.
func auditURL(p AuditListProps, page int, overrides map[string]string) string {
	v := auditQueryValues(p)
	for k, val := range overrides {
		if val == "" {
			v.Del(k)
		} else {
			v.Set(k, val)
		}
	}
	if page > 1 {
		v.Set("page", fmt.Sprintf("%d", page))
	}
	if len(v) == 0 {
		return "/admin/audit"
	}
	return "/admin/audit?" + v.Encode()
}

// auditFilterURL changes one dimension and resets to page 1 — a page number is
// only meaningful relative to a result set.
func auditFilterURL(p AuditListProps, dimension, value string) string {
	overrides := map[string]string{dimension: value}
	// Leaving the custom range drops the dates with it, and changing the area
	// drops the exact action, which no longer belongs to it.
	if dimension == "range" && value != "custom" {
		overrides["from"], overrides["to"] = "", ""
	}
	if dimension == "area" {
		overrides["action"] = ""
	}
	return auditURL(p, 1, overrides)
}

// auditSortURL flips the chronology.
func auditSortURL(p AuditListProps) string {
	if p.Sort == "oldest" {
		return auditURL(p, 1, map[string]string{"sort": ""})
	}
	return auditURL(p, 1, map[string]string{"sort": "oldest"})
}

func auditSortIndicator(p AuditListProps) string {
	if p.Sort == "oldest" {
		return "↑"
	}
	return "↓"
}

// auditActorHref pins one actor, so clicking a name in the table answers
// "what else did this person do?" without anyone typing a uuid.
func auditActorHref(p AuditListProps, e domain.AuditEntry) string {
	if e.ActorID == nil {
		return ""
	}
	return auditURL(p, 1, map[string]string{"actor_id": e.ActorID.String()})
}

// auditResourceHref pins one resource — the whole history of a single order,
// customer, or machine, in the order it happened.
func auditResourceHref(p AuditListProps, e domain.AuditEntry) string {
	return auditURL(p, 1, map[string]string{
		"resource_id":   e.ResourceID.String(),
		"resource_type": e.ResourceType,
	})
}

// anyAuditFilterActive drives the "Clear all" escape hatch.
func anyAuditFilterActive(p AuditListProps) bool {
	return p.Search != "" || p.ActorTypeFilter != "" || p.Area != "" ||
		p.ActionFilter != "" || p.ResourceFilter != "" || p.ActorID != "" ||
		p.ResourceID != "" || p.CustomerID != "" || p.Range != ""
}

func (p AuditListProps) showingStart() int {
	if p.TotalCount == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p AuditListProps) showingEnd() int {
	end := p.Page * p.PerPage
	if end > p.TotalCount {
		return p.TotalCount
	}
	return end
}

// auditActorTabs are the primary split: who did it. They carry no counts —
// counting every entry per actor type means scanning the whole log on every
// page load, and the log only grows.
var auditActorTabs = []adminListPill{
	{"", "Everything"},
	{"staff", "Staff"},
	{"customer", "Customers"},
	{"system", "System"},
}

var auditRangePills = []adminListPill{
	{"", "All time"},
	{"today", "Today"},
	{"7d", "7 days"},
	{"30d", "30 days"},
	{"month", "This month"},
	{"custom", "Custom"},
}

// auditNoMatchMessage is built in Go so punctuation lands tight against the
// closing quote — templ inserts whitespace between adjacent expressions.
func auditNoMatchMessage(p AuditListProps) string {
	if p.Search == "" {
		return "No entries match the current filters."
	}
	return fmt.Sprintf("Nothing for %q. Search matches the person's name and the action — try a name, or a word like \"refund\".", p.Search)
}

// auditSelect renders one labelled dropdown that submits its form on change.
templ auditSelect(id, name, label, allLabel, active string, options []string) {
	<div>
		<label for={ id } class="label-font block text-xs uppercase tracking-wide text-rr-muted">{ label }</label>
		<div class="mt-1 grid grid-cols-1">
			<select
				id={ id }
				name={ name }
				onchange="this.form.submit()"
				class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
			>
				<option value="">{ allLabel }</option>
				for _, o := range options {
					<option value={ o } selected?={ active == o }>{ auditOptionLabel(o) }</option>
				}
			</select>
			<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</div>
	</div>
}

// auditOptionLabel humanizes a facet value. Exact actions keep their namespace
// stripped — the area select right beside them already says which area you are
// in, so repeating it in every option wastes the width.
func auditOptionLabel(v string) string {
	if _, verb, found := strings.Cut(v, "."); found {
		return auditHumanize(verb)
	}
	return auditHumanize(v)
}

// auditChip renders a pinned identity filter with an × that removes it.
templ auditChip(label, value, href string) {
	<span class="inline-flex items-center gap-1.5 rounded-sm border border-rr-heading bg-rr-heading px-2.5 py-1 text-sm font-medium text-rr-bg">
		<span class="opacity-70">{ label }</span>
		<span>{ value }</span>
		<a href={ templ.SafeURL(href) } class="ml-0.5 opacity-70 hover:opacity-100" aria-label={ "Remove " + label + " filter" }>&times;</a>
	</span>
}

templ AuditListContent(props AuditListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-end sm:justify-between">
		<div>
			<h1 class="admin-page-title">Audit Log</h1>
			<p class="mt-1 text-sm text-rr-muted">Every change to the store — who did it, what they touched, and when.</p>
		</div>
	</div>
	<!-- Filter masthead — actor tabs + search, matching the orders and
	     subscriptions lists. Tabs left, search right on desktop; stacked with
	     tabs on top on mobile. -->
	<section class="mt-4" aria-label="Filter the audit log">
		<!-- One form for every control on the page.
		     Each parameter appears exactly once inside it, which is the whole
		     point: hx-include resolves a selector with querySelectorAll and
		     appends *every* match, so a name carried both as a hidden input and
		     as a real control was sent twice and the server read whichever came
		     first in the document — the stale hidden copy. A date typed into
		     the custom range and not yet applied was discarded by the next
		     keystroke in the search box. With one element per name, what is on
		     screen is what gets sent. -->
		<form method="get" action="/admin/audit">
			<!-- State with no control of its own: the tabs, pills, sort header
			     and chips are links, so their value has to ride along here. -->
			<input type="hidden" name="actor_type" value={ props.ActorTypeFilter }/>
			<input type="hidden" name="actor_id" value={ props.ActorID }/>
			<input type="hidden" name="resource_id" value={ props.ResourceID }/>
			<input type="hidden" name="customer_id" value={ props.CustomerID }/>
			<input type="hidden" name="sort" value={ auditSortParam(props.Sort) }/>
			if props.Range != "custom" {
				<!-- Under a preset the dates are implied, and the inputs that
				     would carry them are not rendered. -->
				<input type="hidden" name="range" value={ props.Range }/>
			}
			<div class="flex flex-col-reverse items-stretch gap-3 md:flex-row md:items-center md:justify-between md:gap-6">
				<nav class="flex flex-wrap items-center gap-2 label-font" aria-label="Actor">
					for _, tab := range auditActorTabs {
						<a
							href={ templ.SafeURL(auditFilterURL(props, "actor_type", tab.Value)) }
							class={ adminTabClass(props.ActorTypeFilter == tab.Value) }
							if props.ActorTypeFilter == tab.Value {
								aria-current="page"
							}
						>
							<span>{ tab.Label }</span>
						</a>
					}
				</nav>
				<!-- Search — refreshes the table inline as you type. -->
				<div class="md:w-72 md:shrink-0">
					<label for="audit-search" class="sr-only">Search the audit log</label>
					<input
						id="audit-search"
						type="search"
						name="q"
						value={ props.Search }
						placeholder="Search by person, action, or ID"
						hx-get="/admin/audit"
						hx-trigger="input changed delay:300ms, search"
						hx-target="#main-content"
						hx-push-url="true"
						hx-include="closest form"
						class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
					/>
				</div>
			</div>
			<!-- Date range. Quieter than the tabs: it narrows within the actor split
		     rather than switching what you are looking at. -->
			<div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2">
				<div class="flex flex-wrap items-center gap-2">
					<span class="label-font text-xs uppercase tracking-wide text-rr-muted">When</span>
					for _, f := range auditRangePills {
						<a
							href={ templ.SafeURL(auditFilterURL(props, "range", f.Value)) }
							class={ adminPillClasses(props.Range == f.Value) }
							if props.Range == f.Value {
								aria-current="page"
							}
						>
							{ f.Label }
						</a>
					}
				</div>
			</div>
			if props.Range == "custom" {
				<div class="mt-3 flex flex-wrap items-end gap-3">
					<input type="hidden" name="range" value="custom"/>
					<div>
						<label for="audit-from" class="label-font block text-xs uppercase tracking-wide text-rr-muted">From</label>
						<input id="audit-from" type="date" name="from" value={ props.From } class="mt-1 rounded-sm bg-rr-surface px-2 py-1 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"/>
					</div>
					<div>
						<label for="audit-to" class="label-font block text-xs uppercase tracking-wide text-rr-muted">To</label>
						<input id="audit-to" type="date" name="to" value={ props.To } class="mt-1 rounded-sm bg-rr-surface px-2 py-1 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"/>
					</div>
					<button type="submit" class="btn-secondary">Apply</button>
				</div>
			}
			<!-- What happened, and to what. Two questions, deliberately separate:
		     an "email.shipment_sent" entry is recorded against resource_type
		     "order", so Area finds the mail and Resource finds everything that
		     ever touched that order. Action only appears once an area narrows
		     it — the log holds a couple of hundred distinct actions. -->
			<div class="mt-3 flex flex-wrap items-end gap-3">
				@auditSelect("audit-area", "area", "Area", "All areas", props.Area, props.Areas)
				if len(props.Actions) > 1 {
					@auditSelect("audit-action", "action", "Action", "Any "+auditHumanize(props.Area)+" action", props.ActionFilter, props.Actions)
				}
				@auditSelect("audit-resource", "resource_type", "Resource", "All resources", props.ResourceFilter, props.ResourceTypes)
				<noscript>
					<button type="submit" class="btn-secondary">Apply</button>
				</noscript>
				if anyAuditFilterActive(props) {
					<a href="/admin/audit" class="pb-1 text-sm font-medium text-rr-red hover:text-rr-red-lt">Clear all</a>
				}
			</div>
		</form>
		if props.ActorID != "" || props.ResourceID != "" || props.CustomerID != "" {
			<div class="mt-3 flex flex-wrap items-center gap-2">
				if props.ActorID != "" {
					@auditChip("Actor", auditChipValue(props.ActorLabel, props.ActorID), auditURL(props, 1, map[string]string{"actor_id": ""}))
				}
				if props.CustomerID != "" {
					@auditChip("Customer", auditChipValue(props.CustomerLabel, props.CustomerID), auditURL(props, 1, map[string]string{"customer_id": ""}))
				}
				if props.ResourceID != "" {
					@auditChip("Resource", auditChipValue(props.ResourceLabel, props.ResourceID), auditURL(props, 1, map[string]string{"resource_id": "", "resource_type": ""}))
				}
			</div>
		}
	</section>
	<!-- Audit table -->
	<div class="mt-4">
		if len(props.Entries) == 0 {
			<div class="border border-rr-border bg-rr-surface px-6 py-14 text-center">
				<h2 class="admin-page-title text-2xl">
					if anyAuditFilterActive(props) {
						Nothing matches.
					} else {
						Nothing logged yet.
					}
				</h2>
				<p class="mt-3 text-sm text-rr-body">
					if anyAuditFilterActive(props) {
						{ auditNoMatchMessage(props) }
					} else {
						The log fills itself as staff and customers work. Nothing has happened yet.
					}
				</p>
				if anyAuditFilterActive(props) {
					<div class="mt-6">
						<a href="/admin/audit" class="inline-flex items-center rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading hover:bg-rr-raised">
							Clear all filters
						</a>
					</div>
				}
			</div>
		} else {
			<div class="overflow-hidden border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">
								<a href={ templ.SafeURL(auditSortURL(props)) } class="inline-flex items-center gap-1 hover:text-rr-red" aria-current="true">
									When
									<span class="text-rr-red">{ auditSortIndicator(props) }</span>
								</a>
							</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Actor</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Action</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">Resource</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, e := range props.Entries {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-rr-muted sm:pl-6">
									<time datetime={ e.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>
										{ e.CreatedAt.In(props.MerchantTZ).Format("Jan 2 15:04 MST") }
									</time>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									<span class={ auditActorBadgeClass(e.ActorType) }>
										{ string(e.ActorType) }
									</span>
									if href := auditActorHref(props, e); href != "" {
										<a href={ templ.SafeURL(href) } class="ml-1 text-rr-body underline decoration-rr-border underline-offset-2 hover:text-rr-red" title="Show everything this person did">{ e.ActorName }</a>
									} else {
										<span class="ml-1 text-rr-body">{ e.ActorName }</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm font-medium text-rr-heading">
									{ auditActionDisplay(e.Action) }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									<a href={ templ.SafeURL(auditResourceHref(props, e)) } class="hover:text-rr-red" title="Show this record's whole history">
										<span class="text-rr-body">{ e.ResourceType }</span>
										<span class="ml-1 font-mono text-xs text-rr-muted">{ e.ResourceID.String()[:8] }</span>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(auditURL(props, props.Page-1, nil)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Previous
						</a>
					}
				</div>
				if props.TotalCount > 0 {
					<p class="text-sm text-rr-muted">
						<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingStart()) }</span>–<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingEnd()) }</span> of <span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.TotalCount) }</span>
					</p>
				} else {
					<!-- No total on the unfiltered view: counting the whole log to
					     get one costs a scan of every row ever written. Narrow by
					     anything and the exact count comes back. -->
					<p class="text-sm text-rr-muted">Page <span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.Page) }</span></p>
				}
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(auditURL(props, props.Page+1, nil)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

// auditChipValue prefers the resolved label and falls back to the id fragment
// the table itself displays, so the chip always names something recognizable.
func auditChipValue(label, id string) string {
	if label != "" {
		return label
	}
	if len(id) >= 8 {
		return id[:8]
	}
	return id
}

templ AuditList(props AuditListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Audit Log",
		ActivePath: "/admin/audit",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@AuditListContent(props)
	}
}
