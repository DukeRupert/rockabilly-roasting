	}
}

templ FulfillmentStatusBadge(status domain.FulfillmentStatus) {
	<span class={ fulfillmentStatusBadgeClasses(status) }>
		{ string(status) }
	</span>
}

func subscriptionStatusBadgeClasses(status domain.SubscriptionStatus) string {
	switch status {
	case domain.SubscriptionStatusActive:
		return "badge badge-dot badge-teal-solid"
