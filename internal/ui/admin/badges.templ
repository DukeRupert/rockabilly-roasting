// flashToast renders a success message inline. It uses the same OOB toast
// infrastructure as the admin layout — the htmx:oobAfterSwap listener
// animates the slide-in and auto-dismisses after 5 seconds.
templ flashToast(message string) {
	<div id="toast-container" hx-swap-oob="innerHTML:#toast-container">
		<div class="pointer-events-none fixed inset-0 z-50 flex items-end justify-end p-6">
			<div
				class="pointer-events-auto max-w-sm rounded-lg p-4 shadow-lg ring-1 bg-green-50 text-green-800 ring-green-600/10"
				style="transition: transform 300ms ease-out, opacity 300ms ease-out; transform: translateX(100%); opacity: 0;"
				role="alert"
				data-toast
			>
				<div class="flex items-start">
					<svg class="size-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
					</svg>
					<p class="ml-3 flex-1 text-sm font-medium">{ message }</p>
					<div class="ml-4 flex shrink-0">
						<button type="button" data-toast-close class="inline-flex rounded-md hover:opacity-70">
							<span class="sr-only">Close</span>
							<svg class="size-5" viewBox="0 0 20 20" fill="currentColor">
								<path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"></path>
							</svg>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}
