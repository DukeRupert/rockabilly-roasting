func discountActiveBadgeClasses(active bool) string {
	if active {
		return "badge badge-dot badge-green"
	}
	return "badge badge-dot badge-grey"
}

templ DiscountActiveBadge(active bool) {
	if active {
		<span class={ discountActiveBadgeClasses(active) }>active</span>
	} else {
		<span class={ discountActiveBadgeClasses(active) }>inactive</span>
	}
}

