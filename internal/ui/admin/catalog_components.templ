package admin

import "github.com/dukerupert/hiri/internal/domain"

func statusBadgeClasses(status domain.ProductStatus) string {
	switch status {
	case domain.ProductStatusActive:
		return "badge badge-green"
	case domain.ProductStatusArchived:
		return "badge badge-grey"
	default:
		return "badge badge-amber"
	}
}

templ StatusBadge(status domain.ProductStatus) {
	<span class={ statusBadgeClasses(status) }>
		{ string(status) }
	</span>
}
