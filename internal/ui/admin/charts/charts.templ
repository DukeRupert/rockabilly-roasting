// Package charts holds reusable SVG chart partials for the admin UI.
//
// Charts are pure rendering: callers compute purpose-shaped data, normalize
// magnitudes to [0,1], and pre-format all label strings (currency, dates).
// This keeps charts trivially reusable across reports without coupling them
// to business types.
package charts

import (
	"encoding/json"
	"fmt"
)

// ChartPoint is a single time-series datum for vertical bar charts.
//   - Label: x-axis label (e.g. "Apr 22")
//   - Sub: value label rendered above the bar (e.g. "$1,240")
//   - Magnitude: bar height as a fraction of the available area, in [0,1]
//   - Highlight: when true, the bar is rendered in the accent color
type ChartPoint struct {
	Label     string
	Sub       string
	Magnitude float64
	Highlight bool
}

// LabeledValue is a single datum for horizontal bar charts.
//   - Label: row label (e.g. product title)
//   - Sub: secondary value label (e.g. "$1,240")
//   - Value: primary value label (e.g. "248 units")
//   - Magnitude: bar width as a fraction of the available area, in [0,1]
type LabeledValue struct {
	Label     string
	Sub       string
	Value     string
	Magnitude float64
}

// trendJSON serializes a time-series into the compact shape admin-charts.js
// reads from the canvas data-trend attribute: parallel arrays of x labels,
// magnitudes (the [0,1] bar heights, reused as line y-values), and the
// pre-formatted tooltip values. encoding/json HTML-escapes <,>,& and templ
// escapes the attribute quotes, so embedding the result in an attribute is safe.
func trendJSON(data []ChartPoint) string {
	type payload struct {
		Labels []string  `json:"labels"`
		Mags   []float64 `json:"mags"`
		Subs   []string  `json:"subs"`
	}
	p := payload{
		Labels: make([]string, len(data)),
		Mags:   make([]float64, len(data)),
		Subs:   make([]string, len(data)),
	}
	for i, d := range data {
		p.Labels[i] = d.Label
		p.Mags[i] = d.Magnitude
		p.Subs[i] = d.Sub
	}
	b, err := json.Marshal(p)
	if err != nil {
		return "{}"
	}
	return string(b)
}

// Trend renders a Chart.js time-series from []ChartPoint. kind selects the
// rendering: "line" draws a filled line of non-negative magnitudes (e.g. revenue
// or a running total); "delta" draws a zero-centered bar chart of signed
// magnitudes in [-1,1], gains up and losses down (e.g. net subscription change).
// The trend is baked into the canvas data-trend attribute and drawn by
// rrRenderTrends (admin-charts.js) on initial load and after every htmx card
// swap via a global htmx:load hook. id must be unique per page.
templ Trend(id, kind string, data []ChartPoint) {
	if len(data) == 0 {
		<p class="text-sm text-rr-muted">No data.</p>
	} else {
		<div class="relative" style="height: 14rem;">
			<canvas id={ id } data-trend={ trendJSON(data) } data-kind={ kind } role="img" aria-label="Trend chart"></canvas>
		</div>
	}
}

// barsJSON serializes []LabeledValue into the shape admin-charts.js reads from
// the canvas data-bars attribute: parallel arrays of row labels, the [0,1] bar
// magnitudes (relative to the leader), the pre-formatted primary value drawn at
// each bar's end, and the secondary value shown in the tooltip. encoding/json
// HTML-escapes <,>,& and templ escapes the attribute quotes, so embedding the
// result in an attribute is safe.
func barsJSON(data []LabeledValue) string {
	type payload struct {
		Labels []string  `json:"labels"`
		Mags   []float64 `json:"mags"`
		Values []string  `json:"values"`
		Subs   []string  `json:"subs"`
	}
	p := payload{
		Labels: make([]string, len(data)),
		Mags:   make([]float64, len(data)),
		Values: make([]string, len(data)),
		Subs:   make([]string, len(data)),
	}
	for i, v := range data {
		p.Labels[i] = v.Label
		p.Mags[i] = v.Magnitude
		p.Values[i] = v.Value
		p.Subs[i] = v.Sub
	}
	b, err := json.Marshal(p)
	if err != nil {
		return "{}"
	}
	return string(b)
}

// Bars renders a horizontal Chart.js bar chart of labeled values: row labels on
// the y-axis, bar length proportional to Magnitude, the primary Value drawn at
// the bar's end and the secondary Sub shown on hover. The data is baked into the
// canvas data-bars attribute and drawn by rrRenderTrends (admin-charts.js) on
// initial load and after every htmx card swap. id must be unique per page.
// Height scales with the row count so bars keep a comfortable thickness.
templ Bars(id string, data []LabeledValue) {
	if len(data) == 0 {
		<p class="text-sm text-rr-muted">No data.</p>
	} else {
		<div class="relative" style={ fmt.Sprintf("height: %.2frem;", float64(len(data))*2.6+1.0) }>
			<canvas id={ id } data-bars={ barsJSON(data) } role="img" aria-label="Top sellers"></canvas>
		</div>
	}
}
