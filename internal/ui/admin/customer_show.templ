package admin

import (
	"fmt"
	"strconv"
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// CustomerShowProps backs one customer's page. The page is two-column: the main
// column is what they have done (orders, subscriptions, activity), the rail is
// what they are (contact details, account settings, addresses). Before that split
// it was nine full-width slabs, with the email address — the most-used field on
// the page — buried more than halfway down.
type CustomerShowProps struct {
	Customer      *domain.Customer
	Addresses     []domain.Address
	PriceLists    []domain.PriceList
	RecentOrders  []domain.Order
	Subscriptions []domain.Subscription
	Activity      []domain.AuditEntry
	// OrderCount and LifetimeSpend count confirmed, non-cancelled orders — the
	// same definition the revenue dashboards use.
	// AnnouncementsEnabled is read separately from the customer row — see
	// CustomerStore.GetAnnouncementsEnabled for why it is not a field on
	// domain.Customer.
	AnnouncementsEnabled bool
	OrderCount           int
	LifetimeSpend        int
	LastOrderAt          *time.Time
	MerchantTZ           *time.Location
	StaffName            string
	StaffRole            string
	// TeamMembers are the additional logins on a wholesale account. Empty for
	// retail customers, which have no teammates.
	TeamMembers []domain.CustomerUser
	// ApprovedByName is the staff member who approved the wholesale
	// application, resolved from Customer.ApprovedBy. Empty when the account
	// was never approved, or when that staff record no longer exists.
	ApprovedByName string
	// Equipment is the machines this customer has on the register. Only
	// populated when the equipment service module is switched on — the card
	// does not render at all otherwise, so a shop that does not service
	// machines never sees the word.
	Equipment       []domain.Equipment
	// ServiceCost is what this account has taken in parts and hours, including
	// the call-outs that never named a machine.
	ServiceCost []domain.ServiceCostWindow
	// ServiceLaborRates cost those hours; unset hides the money.
	ServiceLaborRates domain.ServiceLaborRates
	// CanViewServiceCost gates the money card. The machines are configuration
	// and anyone who can open the customer sees them; what servicing them cost
	// is service data, and follows service:view like the dashboard chip does.
	CanViewServiceCost bool
	ServiceEnabled  bool
	CanWriteService bool
	// CanEditEmail gates the inline email editor. The route is gated
	// independently on customers:write; this only keeps the form from showing
	// to staff whose submit would bounce.
	CanEditEmail bool
}

func (p CustomerShowProps) IsWholesale() bool {
	return p.Customer.AccountType == domain.AccountTypeWholesale
}

// boolToggleValue returns the value a toggle form should post: the opposite of
// the current state, so the single button flips the setting.
func boolToggleValue(current bool) string {
	if current {
		return "false"
	}
	return "true"
}

func customerLastOrderLabel(p CustomerShowProps) string {
	if p.LastOrderAt == nil {
		return "Never"
	}
	return p.LastOrderAt.In(p.MerchantTZ).Format("Jan 2, 2006")
}

// customerBackPath returns to the channel the customer belongs to, so the back
// link lands on the list the staffer was actually looking at.
func customerBackPath(p CustomerShowProps) string {
	if p.IsWholesale() {
		return CustomersWholesalePath
	}
	return CustomersRetailPath
}

// Wholesale status changes appear in three places — this page, and both the
// inline and kebab layouts of the wholesale customer list. Sharing the copy
// keeps them from drifting apart.

func declineWholesaleConfirm() ActionConfirm {
	return ActionConfirm{
		Title: "Decline this wholesale application?",
		Lead:  "Turns down the application. The person keeps their retail account and can still order at retail prices.",
		Points: []string{
			"They are not emailed a rejection — tell them yourself if they are expecting an answer.",
			"You can approve them later if they reapply or you change your mind.",
		},
		Confirm: "Decline application",
		Danger:  true,
	}
}

func suspendWholesaleConfirm() ActionConfirm {
	return ActionConfirm{
		Title: "Suspend this wholesale account?",
		Lead:  "Stops the account ordering at wholesale prices until you reactivate it.",
		Points: []string{
			"They lose access to the wholesale portal immediately.",
			"Open orders and invoices are untouched — chase or cancel those separately.",
			"They are not emailed about the suspension.",
		},
		Confirm: "Suspend account",
		Danger:  true,
	}
}

func reactivateWholesaleConfirm() ActionConfirm {
	return ActionConfirm{
		Title: "Reactivate this wholesale account?",
		Lead:  "Restores wholesale pricing and portal access.",
		Points: []string{
			"The customer is emailed a new setup link straight away.",
			"They go back on the price list they were on before.",
		},
		Confirm: "Reactivate and email",
	}
}

templ CustomerShowContent(props CustomerShowProps) {
	@ConfirmDialogHost()
	<!-- Header -->
	<div class="sm:flex sm:items-start sm:justify-between">
		<div>
			<div class="flex flex-wrap items-center gap-3">
				<h1 class="admin-page-title">
					if props.Customer.CompanyName != nil && *props.Customer.CompanyName != "" {
						{ *props.Customer.CompanyName }
					} else {
						{ props.Customer.FirstName } { props.Customer.LastName }
					}
				</h1>
				if props.IsWholesale() {
					<span class="badge badge-indigo">B2B</span>
				} else {
					<span class="badge badge-neutral">B2C</span>
				}
				if !props.Customer.EmailVerified {
					<span class="badge badge-amber">unverified email</span>
				}
			</div>
			<p class="mt-1 text-sm text-rr-muted">
				if props.Customer.CompanyName != nil && *props.Customer.CompanyName != "" {
					{ props.Customer.FirstName } { props.Customer.LastName } &middot;
				}
				{ props.Customer.Email }
			</p>
		</div>
		<div class="mt-4 sm:mt-0">
			<a href={ templ.SafeURL(customerBackPath(props)) } class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">&larr; Back to customers</a>
		</div>
	</div>
	<!-- Wholesale application: the one thing here that is an action, not a setting -->
	if props.IsWholesale() && props.Customer.WholesaleStatus != nil {
		@customerWholesaleBanner(props)
	}
	<!-- What this customer is worth, in three numbers -->
	<dl class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
		<div class="border border-rr-border bg-rr-surface p-4">
			<dt class="text-sm font-medium text-rr-muted">Orders</dt>
			<dd class="mt-1 text-lg font-semibold text-rr-heading tabular-nums">{ fmt.Sprintf("%d", props.OrderCount) }</dd>
		</div>
		<div class="border border-rr-border bg-rr-surface p-4">
			<dt class="text-sm font-medium text-rr-muted">Lifetime spend</dt>
			<dd class="mt-1 text-lg font-semibold text-rr-heading tabular-nums">{ formatCents(props.LifetimeSpend) }</dd>
		</div>
		<div class="border border-rr-border bg-rr-surface p-4">
			<dt class="text-sm font-medium text-rr-muted">Last order</dt>
			<dd class="mt-1 text-lg font-semibold text-rr-heading">{ customerLastOrderLabel(props) }</dd>
		</div>
	</dl>
	<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
		<!-- Main column: what this customer has done -->
		<div class="space-y-8 lg:col-span-2">
			@customerOrdersSection(props)
			@customerSubscriptionsSection(props)
			@CustomerActivity(props.Customer.ID, props.Activity, props.MerchantTZ)
		</div>
		<!-- Rail: who they are, and how the account is configured -->
		<div class="space-y-6 lg:sticky lg:top-6 lg:self-start">
			@customerContactCard(props)
			@customerSettingsCard(props)
			@customerAddressesCard(props)
			if props.ServiceEnabled {
				@customerEquipmentCard(props)
				if props.CanViewServiceCost {
					@serviceCostRailCard(props.ServiceCost, props.showServiceCost())
				}
			}
			if len(props.TeamMembers) > 0 {
				@customerTeamCard(props)
			}
		</div>
	</div>
}

// safeWebsiteURL turns the free-text website from a wholesale application into
// a link target, or returns "" when it cannot be made safe.
//
// This value is typed by the public applicant and reaches templ.SafeURL, which
// bypasses templ's own sanitizer — so the scheme allow-list here is the only
// thing standing between an applicant and a javascript: or data: URL on a
// staff page. Anything without a scheme is assumed https, which is what people
// mean when they type "example.com".
func safeWebsiteURL(raw string) string {
	v := strings.TrimSpace(raw)
	if v == "" {
		return ""
	}
	if strings.Contains(v, "://") {
		lower := strings.ToLower(v)
		if strings.HasPrefix(lower, "http://") || strings.HasPrefix(lower, "https://") {
			return v
		}
		return ""
	}
	// A bare "javascript:alert(1)" has a colon but no "://".
	if i := strings.IndexByte(v, ':'); i >= 0 && !strings.Contains(v[:i], ".") {
		return ""
	}
	return "https://" + v
}

// wholesaleApplicationRow is one label/value line in the application block.
templ wholesaleApplicationRow(label string) {
	<div>
		<dt class="text-xs text-rr-muted">{ label }</dt>
		<dd class="mt-0.5 text-sm text-rr-heading">{ children... }</dd>
	</div>
}

// customerWholesaleBanner is the wholesale application: what they told us, who
// ruled on it, and the buttons to rule on it.
//
// It used to show the status badge and the Approve/Decline buttons and nothing
// else — staff were asked to approve an account with none of the application
// in front of them. Website was collected on the public form and displayed
// nowhere; approved_at/approved_by were recorded and displayed nowhere; and
// wholesale_notes (the decline reason) had a complete backend with no UI at
// either end, so it was always written empty and never read back.
// teamMemberLastSeen is the "when did this login last get used" line. An
// invited teammate who has never signed in is worth spotting — it usually means
// the invite went to the wrong address or landed in spam.
func teamMemberLastSeen(u domain.CustomerUser, loc *time.Location) string {
	if u.LastLoginAt == nil {
		return "Never signed in"
	}
	return "Last seen " + u.LastLoginAt.In(loc).Format("Jan 2, 2006")
}

// customerTeamCard lists the additional logins on a wholesale account.
//
// Staff had no view of these at all: customer_users was invisible in admin, so
// "who else can sign in to this account, and has that invite ever been used?"
// could only be answered from the database.
//
// Read-only on purpose. Inviting and revoking teammates is the account holder's
// own flow on the storefront; this is here so support can see the account.
templ customerTeamCard(props CustomerShowProps) {
	<div class="border border-rr-border bg-rr-surface p-4">
		<h2 class="label-font text-xs uppercase tracking-wide text-rr-muted">Additional logins</h2>
		<ul role="list" class="mt-3 flex flex-col gap-3">
			for _, u := range props.TeamMembers {
				<li class="flex flex-col gap-0.5">
					<div class="flex items-center gap-2">
						if u.Name != "" {
							<span class="text-sm font-semibold text-rr-heading">{ u.Name }</span>
						}
						if u.PasswordHash == nil {
							<span class="badge badge-amber">invite pending</span>
						}
					</div>
					<a href={ templ.SafeURL("mailto:" + u.Email) } class="break-all text-xs text-rr-muted hover:text-rr-red">{ u.Email }</a>
					<span class="text-xs text-rr-muted">
						{ teamMemberLastSeen(u, props.MerchantTZ) }
						<span class="mx-1 text-rr-border">&middot;</span>
						Invited { u.InvitedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
					</span>
					if !u.ReceivesNotifications {
						<span class="text-xs text-rr-muted">Does not receive account email</span>
					}
				</li>
			}
		</ul>
	</div>
}

templ customerWholesaleBanner(props CustomerShowProps) {
	{{ status := *props.Customer.WholesaleStatus }}
	<div class="mt-4 border border-rr-border bg-rr-surface p-4">
		<div class="sm:flex sm:items-center sm:justify-between">
			<div class="flex items-center gap-3">
				<h2 class="text-sm font-medium text-rr-heading">Wholesale application</h2>
				@WholesaleStatusBadge(status)
			</div>
			<div class="mt-3 sm:mt-0">
				if status == domain.WholesaleStatusPending {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/approve", props.Customer.ID)) }>
						<button type="submit" class="btn-confirm">Approve</button>
					</form>
				}
				if status == domain.WholesaleStatusApproved {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/suspend", props.Customer.ID)) }>
						@ActionWrap("hint-wholesale-suspend", "Cuts off wholesale pricing and portal access until you reactivate the account.") {
							<button
								type="submit"
								class="btn-danger"
								aria-describedby="hint-wholesale-suspend"
								{ ConfirmAttrs(suspendWholesaleConfirm())... }
							>Suspend</button>
						}
					</form>
				}
				if status == domain.WholesaleStatusSuspended {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/reactivate", props.Customer.ID)) }>
						@ActionWrap("hint-wholesale-reactivate", "Restores wholesale access and emails the customer a fresh setup link.") {
							<button
								type="submit"
								class="btn-confirm"
								aria-describedby="hint-wholesale-reactivate"
								{ ConfirmAttrs(reactivateWholesaleConfirm())... }
							>Reactivate</button>
						}
					</form>
				}
			</div>
		</div>
		<!-- What they actually told us on the application form. -->
		<dl class="mt-4 grid grid-cols-2 gap-4 border-t border-rr-border pt-3 sm:grid-cols-4">
			if props.Customer.CompanyName != nil && *props.Customer.CompanyName != "" {
				@wholesaleApplicationRow("Company") {
					{ *props.Customer.CompanyName }
				}
			}
			if props.Customer.Website != nil && *props.Customer.Website != "" {
				@wholesaleApplicationRow("Website") {
					if href := safeWebsiteURL(*props.Customer.Website); href != "" {
						<a
							href={ templ.SafeURL(href) }
							target="_blank"
							rel="noopener noreferrer"
							class="break-all text-rr-red hover:text-rr-red-lt"
						>{ *props.Customer.Website }</a>
					} else {
						<span class="break-all">{ *props.Customer.Website }</span>
					}
				}
			}
			if props.Customer.Phone != nil && *props.Customer.Phone != "" {
				@wholesaleApplicationRow("Phone") {
					<a href={ templ.SafeURL("tel:" + *props.Customer.Phone) } class="hover:text-rr-red">{ *props.Customer.Phone }</a>
				}
			}
			@wholesaleApplicationRow("Applied") {
				{ props.Customer.CreatedAt.In(props.MerchantTZ).Format("January 2, 2006") }
			}
			if status == domain.WholesaleStatusApproved && props.Customer.ApprovedAt != nil {
				@wholesaleApplicationRow("Approved") {
					{ props.Customer.ApprovedAt.In(props.MerchantTZ).Format("January 2, 2006") }
					if props.ApprovedByName != "" {
						<span class="text-rr-muted">by { props.ApprovedByName }</span>
					}
				}
			}
		</dl>
		<!-- The decline reason: captured here, read back below. The service has
		     always written it; nothing ever sent it or showed it. -->
		if status == domain.WholesaleStatusDeclined {
			<div class="mt-3 border-t border-rr-border pt-3">
				<p class="text-xs text-rr-muted">Decline reason</p>
				if props.Customer.WholesaleNotes != nil && *props.Customer.WholesaleNotes != "" {
					<p class="mt-0.5 whitespace-pre-line text-sm text-rr-heading">{ *props.Customer.WholesaleNotes }</p>
				} else {
					<p class="mt-0.5 text-sm text-rr-muted">None recorded.</p>
				}
			</div>
		}
		if status == domain.WholesaleStatusPending {
			<form
				method="post"
				action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/decline", props.Customer.ID)) }
				class="mt-3 flex flex-col gap-2 border-t border-rr-border pt-3"
			>
				<label for="wholesale-decline-notes" class="text-xs text-rr-muted">
					Decline reason &mdash; recorded on the account, not emailed to the applicant
				</label>
				<textarea
					id="wholesale-decline-notes"
					name="notes"
					rows="2"
					class="w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none sm:max-w-lg"
					placeholder="Why this application was turned down."
				></textarea>
				@ActionWrap("hint-wholesale-decline", "Turns down the wholesale application. The account stays as a retail customer, and your reason is saved here.") {
					<button
						type="submit"
						class="btn-danger self-start"
						aria-describedby="hint-wholesale-decline"
						{ ConfirmAttrs(declineWholesaleConfirm())... }
					>Decline</button>
				}
			</form>
		}
	</div>
}

templ customerOrdersSection(props CustomerShowProps) {
	<div>
		<div class="sm:flex sm:items-center sm:justify-between">
			<h2 class="text-sm font-semibold text-rr-heading">Recent orders</h2>
			if len(props.RecentOrders) > 0 {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/admin/orders?q=%s", props.Customer.Email)) }
					class="text-sm font-semibold text-rr-red hover:text-rr-red-lt"
				>
					View all &rarr;
				</a>
			}
		</div>
		if len(props.RecentOrders) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No orders placed yet.</p>
		} else {
			<div class="mt-2 overflow-hidden border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">Placed</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Total</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, o := range props.RecentOrders {
							<tr class="row-link">
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID.String())) }
										class="row-link-target font-medium text-rr-red hover:text-rr-red-lt"
									>
										if o.Number != "" {
											{ o.Number }
										} else {
											{ o.ID.String()[:8] }
										}
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@OrderStatusBadge(o.Status)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									<time datetime={ o.PlacedAt.Format("2006-01-02T15:04:05Z07:00") }>
										{ o.PlacedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
									</time>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-right text-sm text-rr-heading tabular-nums">
									{ formatCents(o.Total) }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// customerSubscriptionsSection answers "is this person on a standing order?" —
// a question the page could not answer at all before, short of searching the
// subscriptions list by hand.
templ customerSubscriptionsSection(props CustomerShowProps) {
	<div>
		<h2 class="text-sm font-semibold text-rr-heading">Subscriptions</h2>
		if len(props.Subscriptions) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No subscriptions.</p>
		} else {
			<div class="mt-2 overflow-hidden border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Subscription</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Next order</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, sub := range props.Subscriptions {
							<tr class="row-link">
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s", sub.ID)) } class="row-link-target font-medium text-rr-red hover:text-rr-red-lt">
										{ sub.ID.String()[:8] }
									</a>
									<span class="text-rr-muted">&nbsp;&times;{ fmt.Sprintf("%d", sub.Quantity) }</span>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@SubscriptionStatusBadge(sub.Status)
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">
									{ sub.NextOrderAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// customerContactCard holds identity: the sign-in address, the phone, and every
// "send them a link" action, gathered behind one Send menu rather than scattered
// as three buttons inside a card nominally about verification status.
templ customerContactCard(props CustomerShowProps) {
	<div class="border border-rr-border bg-rr-surface">
		<div class="flex items-center justify-between border-b border-rr-border px-4 py-3">
			<h2 class="text-sm font-semibold text-rr-heading">Contact</h2>
			@customerSendMenu(props)
		</div>
		<dl class="divide-y divide-rr-border">
			<div class="px-4 py-3">
				<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Email</dt>
				<dd class="mt-1">
					if props.CanEditEmail {
						<form
							method="post"
							action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/email", props.Customer.ID)) }
							class="flex flex-wrap items-center gap-2"
						>
							<input
								type="email"
								name="email"
								value={ props.Customer.Email }
								required
								maxlength="255"
								autocomplete="off"
								class="w-full min-w-0 flex-1 rounded-sm bg-rr-surface py-1.5 px-3 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
							/>
							@ActionWrap("hint-change-email", "Changes the address this customer signs in with. Send them a verification link afterwards.") {
								<button
									type="submit"
									class="btn-confirm"
									aria-describedby="hint-change-email"
									{ ConfirmAttrs(ActionConfirm{
										Title: "Change this customer's sign-in address?",
										Lead:  "They will use the new address to log in from now on.",
										Points: []string{
											"Orders, subscriptions and history stay with the customer.",
											"The new address is marked unverified — send a verification link afterwards to confirm it reaches them.",
											"They are not told about the change automatically.",
										},
										Confirm: "Change address",
									})... }
								>Save</button>
							}
						</form>
						<p class="mt-1 text-xs text-rr-muted">
							Orders, subscriptions and history stay with the customer. The address is marked unverified until they follow a verification link.
						</p>
					} else {
						<span class="text-sm text-rr-heading">{ props.Customer.Email }</span>
					}
				</dd>
			</div>
			<div class="px-4 py-3">
				<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Verified</dt>
				<dd class="mt-1">
					if props.Customer.EmailVerified {
						<span class="badge badge-green">yes</span>
					} else {
						<span class="badge badge-amber">no</span>
					}
					if props.Customer.PasswordHash == nil {
						<span class="badge badge-grey ml-1.5">no password set</span>
					}
				</dd>
			</div>
			if props.Customer.Phone != nil && *props.Customer.Phone != "" {
				<div class="px-4 py-3">
					<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Phone</dt>
					<dd class="mt-1 text-sm text-rr-heading">{ *props.Customer.Phone }</dd>
				</div>
			}
			<div class="px-4 py-3">
				<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Customer since</dt>
				<dd class="mt-1 text-sm text-rr-heading">{ props.Customer.CreatedAt.In(props.MerchantTZ).Format("January 2, 2006") }</dd>
			</div>
		</dl>
	</div>
}

// customerSendMenu gathers the outbound-email actions. They are all "send this
// person a link", they are all occasional, and each one used to occupy a button
// in a card that was supposed to be reporting verification status.
templ customerSendMenu(props CustomerShowProps) {
	<div x-data="{ open: false }" class="relative">
		<button
			type="button"
			x-on:click="open = !open"
			x-bind:aria-expanded="open"
			aria-haspopup="true"
			class="inline-flex items-center gap-1 rounded-sm border border-rr-border bg-rr-surface px-2.5 py-1 text-xs font-semibold text-rr-heading hover:bg-rr-raised"
		>
			Send
			<svg class="size-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
		<div
			x-show="open"
			x-cloak
			x-transition.opacity
			x-on:click.outside="open = false"
			x-on:keydown.escape.window="open = false"
			class="absolute right-0 z-30 mt-1 w-64 rounded-sm border border-rr-border bg-rr-surface py-1 text-left shadow-lg"
			role="menu"
		>
			if !props.Customer.EmailVerified {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/send-verification", props.Customer.ID)) }>
					<button
						type="submit"
						role="menuitem"
						class="block w-full px-3 py-2 text-left text-sm text-rr-heading hover:bg-rr-raised"
						{ ConfirmAttrs(ActionConfirm{
							Title: "Email a verification link?",
							Lead:  "Sends the customer a link that confirms this is really their address.",
							Points: []string{
								"Following the link signs them in. It does not change their password.",
								"The link goes to the address shown above — check it is right before sending.",
							},
							Confirm: "Send verification link",
						})... }
					>
						Verification link
					</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/send-password-setup", props.Customer.ID)) }>
				if props.Customer.PasswordHash == nil {
					<button
						type="submit"
						role="menuitem"
						class="block w-full px-3 py-2 text-left text-sm text-rr-heading hover:bg-rr-raised"
						{ ConfirmAttrs(ActionConfirm{
							Title: "Email a password setup link?",
							Lead:  "This customer has no password yet. The link lets them choose one.",
							Points: []string{
								"The link goes to the address shown above.",
							},
							Confirm: "Send setup link",
						})... }
					>
						Password setup link
					</button>
				} else {
					<button
						type="submit"
						role="menuitem"
						class="block w-full px-3 py-2 text-left text-sm text-rr-heading hover:bg-rr-raised"
						{ ConfirmAttrs(ActionConfirm{
							Title: "Email a password reset link?",
							Lead:  "Sends the customer a link to set a new password.",
							Points: []string{
								"Their current password keeps working until they actually use the link.",
								"The link goes to the address shown above.",
							},
							Confirm: "Send reset link",
						})... }
					>
						Password reset link
					</button>
				}
			</form>
			if props.IsWholesale() && props.Customer.WholesaleStatus != nil && *props.Customer.WholesaleStatus == domain.WholesaleStatusApproved {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/send-white-label-invite", props.Customer.ID)) }>
					<button
						type="submit"
						role="menuitem"
						class="block w-full px-3 py-2 text-left text-sm text-rr-heading hover:bg-rr-raised"
						{ ConfirmAttrs(ActionConfirm{
							Title: "Email a white-label onboarding invite?",
							Lead:  "Invites this wholesale account to set up their own private labels.",
							Points: []string{
								"The link goes to the address shown above.",
								"Only send this to accounts you have agreed white-label terms with.",
							},
							Confirm: "Send invite",
						})... }
					>
						White-label invite
					</button>
				</form>
			}
		</div>
	</div>
}

// customerSettingsCard is every switch on the account in one place. Retail
// accounts see the two that apply to them; wholesale accounts get the billing
// block here as well, rather than in its own slab further down the page.
templ customerSettingsCard(props CustomerShowProps) {
	<div class="border border-rr-border bg-rr-surface">
		<div class="border-b border-rr-border px-4 py-3">
			<h2 class="text-sm font-semibold text-rr-heading">Account settings</h2>
		</div>
		<dl class="divide-y divide-rr-border">
			<div class="px-4 py-3">
				<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Tax exempt</dt>
				<dd class="mt-1 text-sm text-rr-heading">
					if props.Customer.TaxExempt {
						Yes
						if props.Customer.TaxExemptReason != nil {
							<span class="text-rr-muted">— { *props.Customer.TaxExemptReason }</span>
						}
					} else {
						No
					}
				</dd>
			</div>
			<div class="px-4 py-3">
				<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Local fulfillment</dt>
				<dd class="mt-1">
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/local-fulfillment", props.Customer.ID)) }>
						@customerSelect("local_fulfillment") {
							<option value="" selected?={ props.Customer.PreferredLocalFulfillment == nil }>Ask each time</option>
							<option value="local_delivery" selected?={ props.Customer.PreferredLocalFulfillment != nil && *props.Customer.PreferredLocalFulfillment == domain.ShippingMethodLocalDelivery }>Local delivery</option>
							<option value="pickup" selected?={ props.Customer.PreferredLocalFulfillment != nil && *props.Customer.PreferredLocalFulfillment == domain.ShippingMethodPickup }>Pickup at the shop</option>
						}
					</form>
				</dd>
			</div>
			if props.IsWholesale() {
				<div class="px-4 py-3">
					<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Payment terms</dt>
					<dd class="mt-1">
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/payment-terms", props.Customer.ID)) }>
							@customerSelect("payment_terms_days") {
								<option value="" selected?={ props.Customer.PaymentTermsDays == nil }>Not set</option>
								if props.Customer.PaymentTermsDays != nil && domain.IsLegacyPaymentTerms(*props.Customer.PaymentTermsDays) {
									<!-- Terms that are no longer offered (Net 21, retired 2026-08-29) still
									     have to show as what they are. Without this the select falls back to
									     its first option and reads "Not set", and because it submits on change
									     the next nudge would quietly rewrite a real account's terms. -->
									<!-- disabled as well as selected: it has to show what the account is
									     actually on, but the handler rejects a retired value, so letting it be
									     chosen again would answer a click with a bare 400. Staff can move off
									     it; they cannot move back onto it. -->
									<option value={ strconv.Itoa(*props.Customer.PaymentTermsDays) } selected disabled>
										{ domain.PaymentTermsLabel(*props.Customer.PaymentTermsDays) } (no longer offered)
									</option>
								}
								for _, days := range domain.PaymentTermsOptions {
									<option value={ strconv.Itoa(days) } selected?={ props.Customer.PaymentTermsDays != nil && *props.Customer.PaymentTermsDays == days }>{ domain.PaymentTermsLabel(days) }</option>
								}
							}
						</form>
					</dd>
				</div>
				<div class="px-4 py-3">
					<dt class="flex items-center justify-between text-xs font-medium uppercase tracking-wide text-rr-muted">
						Price list
						if props.Customer.PriceListID != nil {
							<a href={ templ.SafeURL(fmt.Sprintf("/admin/price-lists/%s", *props.Customer.PriceListID)) } class="font-semibold normal-case tracking-normal text-rr-red hover:text-rr-red-lt">
								View prices
							</a>
						}
					</dt>
					<dd class="mt-1">
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/price-list", props.Customer.ID)) }>
							@customerSelect("price_list_id") {
								<option value="" selected?={ props.Customer.PriceListID == nil }>Base prices</option>
								for _, pl := range props.PriceLists {
									<option value={ pl.ID.String() } selected?={ props.Customer.PriceListID != nil && *props.Customer.PriceListID == pl.ID }>
										{ pl.Name }
										if pl.Status != domain.PriceListStatusActive {
											({ string(pl.Status) })
										}
									</option>
								}
							}
						</form>
					</dd>
				</div>
				<div class="px-4 py-3">
					<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Billing method</dt>
					<dd class="mt-1">
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/billing-method", props.Customer.ID)) }>
							@customerBillingMethodSelect(props.Customer) {
								<option value="manual" selected?={ props.Customer.BillingMethod == domain.BillingMethodManual }>Manual</option>
								<option value="ach" selected?={ props.Customer.BillingMethod == domain.BillingMethodACH }>ACH</option>
								<option value="credit_card" selected?={ props.Customer.BillingMethod == domain.BillingMethodCreditCard }>Credit Card</option>
							}
						</form>
						if !props.Customer.BillingMethod.AutoInvoiced() {
							<p class="mt-1 text-xs text-rr-muted">
								Not invoiced automatically. Switching to ACH or Credit Card starts billing
								them from their next order.
							</p>
						}
					</dd>
				</div>
				<div class="px-4 py-3">
					<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Weekly order reminder</dt>
					<dd class="mt-1">
						<form
							method="post"
							action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/order-reminders", props.Customer.ID)) }
							class="flex items-center gap-2"
						>
							<input type="hidden" name="enabled" value={ boolToggleValue(props.Customer.OrderRemindersEnabled) }/>
							if props.Customer.OrderRemindersEnabled {
								<span class="badge badge-green">On</span>
								<button type="submit" class="btn btn-secondary">Turn off</button>
							} else {
								<span class="badge badge-grey">Off</span>
								<button type="submit" class="btn btn-secondary">Turn on</button>
							}
						</form>
						<p class="mt-1 text-xs text-rr-muted">Sent Fridays to accounts that ordered in the last 3 weeks.</p>
					</dd>
				</div>
			}
			<div class="px-4 py-3">
				<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Shop announcements</dt>
				<dd class="mt-1">
					<form
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/announcements", props.Customer.ID)) }
						class="flex items-center gap-2"
					>
						<input type="hidden" name="enabled" value={ boolToggleValue(props.AnnouncementsEnabled) }/>
						if props.AnnouncementsEnabled {
							<span class="badge badge-green">On</span>
							<button type="submit" class="btn btn-secondary">Turn off</button>
						} else {
							<span class="badge badge-grey">Off</span>
							<button type="submit" class="btn btn-secondary">Turn on</button>
						}
					</form>
					<p class="mt-1 text-xs text-rr-muted">One-off notices &mdash; holiday schedules, closures. Separate from the weekly reminder.</p>
				</dd>
			</div>
		</dl>
	</div>
}

// customerBillingMethodSelect is customerSelect with a gate on the one
// direction that costs money.
//
// Billing method decides whether QuickBooks invoices this account without
// anybody asking, so moving it to ACH or Credit Card is the same class of act
// as Go live — and until now it was a single click on a menu that submitted
// itself, with no confirmation and nothing recorded but the click. The system
// has no way to know an agreement exists; the most it can do is make the
// person say they are sure, and say it against the customer's own name.
//
// Only that direction. Moving back to Manual stops billing, which is the safe
// side and needs no ceremony — the same asymmetry the billing-mode toggle uses.
//
// The dialog's cancel path restores the previous option: without it a declined
// change leaves the menu showing a value that was never saved, which is worse
// than no gate at all.
templ customerBillingMethodSelect(customer *domain.Customer) {
	<div
		class="grid grid-cols-1"
		x-data={ "{ previous: '" + string(customer.BillingMethod) + "' }" }
	>
		<select
			name="billing_method"
			@change="
				if ($el.value === 'manual') { $el.form.submit(); return }
				$dispatch('admin-confirm', {
					form: $el.form,
					cancelled: () => { $el.value = previous },
					copy: previous === 'manual' ? {
						title: 'Start invoicing ' + $el.dataset.customer + ' automatically?',
						lead: 'From their next order, QuickBooks will raise the invoice and email it to them.',
						points: [
							'Only do this once they have agreed to be invoiced and to pay this way — nothing here checks that.',
							'Their invoices will carry a ' + $el.options[$el.selectedIndex].text + ' pay button.',
							'Orders already placed are not billed retrospectively.',
							'Moving them back to Manual stops it again.'
						],
						confirm: 'Switch to ' + $el.options[$el.selectedIndex].text,
						danger: true
					} : {
						title: 'Change how ' + $el.dataset.customer + ' pays?',
						lead: 'This account is already invoiced automatically. Only the payment button on its invoices changes.',
						points: [
							'Their invoices will carry a ' + $el.options[$el.selectedIndex].text + ' pay button from the next one onwards.',
							'Invoices already sent are not changed.',
							'Only do this if they have agreed to pay this way.'
						],
						confirm: 'Switch to ' + $el.options[$el.selectedIndex].text,
						danger: true
					}
				})
			"
			data-customer={ customerBillingName(customer) }
			class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
		>
			{ children... }
		</select>
		<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
			<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
		</svg>
	</div>
}

// customerBillingName is what the confirmation calls this account. The company
// name if there is one, because that is what a wholesale account is known as.
func customerBillingName(customer *domain.Customer) string {
	// Trimmed, not merely non-empty: a company name of spaces would otherwise
	// title the dialog "Start invoicing  automatically?", which names nobody
	// at the moment the operator most needs to know who they are billing.
	if customer.CompanyName != nil && strings.TrimSpace(*customer.CompanyName) != "" {
		return strings.TrimSpace(*customer.CompanyName)
	}
	name := strings.TrimSpace(customer.FirstName + " " + customer.LastName)
	if name != "" {
		return name
	}
	return customer.Email
}

// customerSelect is the auto-submitting select these settings all share: change
// the value, the form posts, the page comes back with it applied.
templ customerSelect(name string) {
	<div class="grid grid-cols-1">
		<select
			name={ name }
			onchange="this.form.submit()"
			class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
		>
			{ children... }
		</select>
		<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
			<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
		</svg>
	</div>
}

templ customerAddressesCard(props CustomerShowProps) {
	<div class="border border-rr-border bg-rr-surface">
		<div class="border-b border-rr-border px-4 py-3">
			<h2 class="text-sm font-semibold text-rr-heading">Addresses</h2>
		</div>
		if len(props.Addresses) == 0 {
			<p class="px-4 py-3 text-sm text-rr-muted">No addresses on file.</p>
		} else {
			<ul class="divide-y divide-rr-border">
				for _, addr := range props.Addresses {
					<li class="px-4 py-3">
						<p class="text-sm font-medium text-rr-heading">
							{ addr.FirstName } { addr.LastName }
							if addr.IsDefault {
								<span class="badge badge-blue ml-1.5">default</span>
							}
						</p>
						if addr.Company != nil && *addr.Company != "" {
							<p class="text-sm text-rr-muted">{ *addr.Company }</p>
						}
						<p class="text-sm text-rr-muted">{ addr.Line1 }</p>
						if addr.Line2 != nil && *addr.Line2 != "" {
							<p class="text-sm text-rr-muted">{ *addr.Line2 }</p>
						}
						<p class="text-sm text-rr-muted">{ addr.City }, { addr.State } { addr.PostalCode }</p>
					</li>
				}
			</ul>
		}
	</div>
}

// customerPageTitle matches the h1: a wholesale account is known by its company
// name, a retail customer by their own.
func customerPageTitle(c *domain.Customer) string {
	if c.CompanyName != nil && *c.CompanyName != "" {
		return *c.CompanyName
	}
	return fmt.Sprintf("%s %s", c.FirstName, c.LastName)
}

templ CustomerShow(props CustomerShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      customerPageTitle(props.Customer),
		ActivePath: "/admin/customers",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@CustomerShowContent(props)
	}
}

// showServiceCost decides whether the rail card carries a money figure: as soon
// as either an hour has been priced or the shop has set a rate.
func (p CustomerShowProps) showServiceCost() bool {
	if p.ServiceLaborRates.Set() {
		return true
	}
	for _, w := range p.ServiceCost {
		if w.Summary.AnyCost() {
			return true
		}
	}
	return false
}

// customerEquipmentCard lists the machines this cafe has on the register.
//
// Rail, not main column: on a customer page the machines are configuration —
// what they have and where — rather than something that happened. The work
// done to them lives on the tickets.
//
// Rendered only when the equipment service module is on. Retired machines are
// left out; this answers "what is on their counter", and the full history is a
// click away on the register.
templ customerEquipmentCard(props CustomerShowProps) {
	<div class="border border-rr-border bg-rr-surface">
		<div class="px-4 py-4">
			<div class="flex items-center justify-between">
				<h2 class="text-sm font-semibold text-rr-heading">Equipment</h2>
				if props.CanWriteService {
					<a
						href={ templ.SafeURL("/admin/service/equipment/new?customer_id=" + props.Customer.ID.String()) }
						class="text-sm text-rr-muted underline"
					>Add</a>
				}
			</div>
			if len(props.Equipment) == 0 {
				<p class="mt-2 text-sm text-rr-muted">No machines on the register for this customer.</p>
			} else {
				<ul role="list" class="mt-2 space-y-2">
					for _, e := range props.Equipment {
						<li class="text-sm">
							<a href={ templ.SafeURL("/admin/service/equipment/" + e.ID.String()) } class="font-medium text-rr-heading underline">
								{ e.Description() }
							</a>
							<div class="flex flex-wrap items-center gap-1.5 text-rr-muted">
								<span>{ e.Category.Label() }</span>
								if e.Status != domain.EquipmentStatusActive {
									<span class={ equipmentStatusBadge(e.Status) }>{ e.Status.Label() }</span>
								}
								if badge := equipmentOwnershipBadge(e.Ownership); badge != "" {
									<span class={ badge }>{ e.Ownership.Label() }</span>
								}
							</div>
						</li>
					}
				</ul>
			}
		</div>
	</div>
}
