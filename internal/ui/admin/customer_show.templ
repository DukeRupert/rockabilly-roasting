package admin

import (
	"fmt"
	"time"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type CustomerShowProps struct {
	Customer     *domain.Customer
	Addresses    []domain.Address
	MemberGroups []domain.CustomerGroup
	AllGroups    []domain.CustomerGroup
	PriceLists   []domain.PriceList
	RecentOrders []domain.Order
	Activity     []domain.AuditEntry
	MerchantTZ   *time.Location
	StaffName    string
	StaffRole    string
}

// availableGroups returns groups the customer is NOT already a member of.
func (p CustomerShowProps) AvailableGroups() []domain.CustomerGroup {
	memberIDs := make(map[uuid.UUID]bool, len(p.MemberGroups))
	for _, g := range p.MemberGroups {
		memberIDs[g.ID] = true
	}
	var available []domain.CustomerGroup
	for _, g := range p.AllGroups {
		if !memberIDs[g.ID] {
			available = append(available, g)
		}
	}
	return available
}

templ CustomerShowContent(props CustomerShowProps) {
	<!-- Header -->
	<div class="sm:flex sm:items-center sm:justify-between">
		<div>
			<div class="flex items-center gap-3">
				<h1 class="admin-page-title">{ props.Customer.FirstName } { props.Customer.LastName }</h1>
				if props.Customer.AccountType == domain.AccountTypeWholesale {
					<span class="badge badge-indigo">B2B</span>
				} else {
					<span class="badge badge-neutral">B2C</span>
				}
			</div>
			<p class="mt-1 text-sm text-rr-muted">{ props.Customer.Email }</p>
			if props.Customer.CompanyName != nil && *props.Customer.CompanyName != "" {
				<p class="text-sm text-rr-muted">{ *props.Customer.CompanyName }</p>
			}
		</div>
		<div class="mt-4 sm:mt-0">
			<a href="/admin/customers" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">&larr; Back to customers</a>
		</div>
	</div>
	<!-- Wholesale status banner -->
	if props.Customer.AccountType == domain.AccountTypeWholesale && props.Customer.WholesaleStatus != nil {
		<div class="mt-4 border-2 border-rr-border bg-rr-surface p-4">
			<div class="sm:flex sm:items-center sm:justify-between">
				<div class="flex items-center gap-3">
					<h3 class="text-sm font-medium text-rr-heading">Wholesale application</h3>
					@WholesaleStatusBadge(*props.Customer.WholesaleStatus)
				</div>
				<div class="mt-3 sm:mt-0">
					if *props.Customer.WholesaleStatus == domain.WholesaleStatusPending {
						<div class="flex gap-2">
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/approve", props.Customer.ID)) }>
								<button type="submit" class="btn-confirm">Approve</button>
							</form>
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/decline", props.Customer.ID)) }>
								<button type="submit" class="btn-danger" onclick="return confirm('Decline this application?')">Decline</button>
							</form>
						</div>
					}
					if *props.Customer.WholesaleStatus == domain.WholesaleStatusApproved {
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/suspend", props.Customer.ID)) }>
							<button type="submit" class="btn-danger" onclick="return confirm('Suspend this wholesale account?')">Suspend</button>
						</form>
					}
				</div>
			</div>
		</div>
	}
	<!-- Info cards -->
	<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
		<div class="border-2 border-rr-border bg-rr-surface p-4">
			<dt class="text-sm font-medium text-rr-muted">Email verified</dt>
			<dd class="mt-1">
				if props.Customer.EmailVerified {
					<span class="badge badge-green">yes</span>
				} else {
					<span class="badge badge-amber">no</span>
				}
			</dd>
		</div>
		<div class="border-2 border-rr-border bg-rr-surface p-4">
			<dt class="text-sm font-medium text-rr-muted">Account type</dt>
			<dd class="mt-1 text-sm text-rr-heading capitalize">
				{ string(props.Customer.AccountType) }
			</dd>
		</div>
		<div class="border-2 border-rr-border bg-rr-surface p-4">
			<dt class="text-sm font-medium text-rr-muted">Tax exempt</dt>
			<dd class="mt-1 text-sm text-rr-heading">
				if props.Customer.TaxExempt {
					Yes
					if props.Customer.TaxExemptReason != nil {
						<span class="text-rr-muted"> — { *props.Customer.TaxExemptReason }</span>
					}
				} else {
					No
				}
			</dd>
		</div>
	</div>
	<!-- Recent Orders -->
	<div class="mt-8">
		<div class="sm:flex sm:items-center sm:justify-between">
			<h2 class="text-sm font-semibold text-rr-heading">Recent orders</h2>
			if len(props.RecentOrders) > 0 {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/admin/orders?q=%s", props.Customer.Email)) }
					class="text-sm font-semibold text-rr-red hover:text-rr-red-lt"
				>
					View all &rarr;
				</a>
			}
		</div>
		if len(props.RecentOrders) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No orders placed yet.</p>
		} else {
			<div class="mt-2 overflow-hidden border-2 border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">Placed</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Total</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, o := range props.RecentOrders {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID.String())) }
										class="font-medium text-rr-red hover:text-rr-red-lt"
									>
										if o.Number != "" {
											{ o.Number }
										} else {
											{ o.ID.String()[:8] }
										}
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@OrderStatusBadge(o.Status)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									<time datetime={ o.PlacedAt.Format("2006-01-02T15:04:05Z07:00") }>
										{ o.PlacedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
									</time>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-right text-sm text-rr-heading tabular-nums">
									{ formatCents(o.Total) }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
	<!-- Activity -->
	@CustomerActivity(props.Activity, props.MerchantTZ)
	<!-- Details -->
	<div class="mt-8 border-2 border-rr-border bg-rr-surface">
		<div class="px-4 py-5 sm:px-6">
			<h2 class="text-sm font-semibold text-rr-heading">Details</h2>
		</div>
		<div class="border-t border-rr-border">
			<dl class="divide-y divide-rr-border">
				if props.Customer.Phone != nil {
					<div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
						<dt class="text-sm font-medium text-rr-muted">Phone</dt>
						<dd class="mt-1 text-sm text-rr-heading sm:col-span-2 sm:mt-0">{ *props.Customer.Phone }</dd>
					</div>
				}
				<div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
					<dt class="text-sm font-medium text-rr-muted">Customer since</dt>
					<dd class="mt-1 text-sm text-rr-heading sm:col-span-2 sm:mt-0">{ props.Customer.CreatedAt.In(props.MerchantTZ).Format("January 2, 2006") }</dd>
				</div>
			</dl>
		</div>
	</div>
	<!-- Fulfillment preferences -->
	<div class="mt-8 border-2 border-rr-border bg-rr-surface">
		<div class="px-4 py-5 sm:px-6">
			<h2 class="text-sm font-semibold text-rr-heading">Fulfillment preferences</h2>
		</div>
		<div class="border-t border-rr-border">
			<dl class="divide-y divide-rr-border">
				<div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
					<dt class="text-sm font-medium text-rr-muted">Local fulfillment</dt>
					<dd class="mt-1 sm:col-span-2 sm:mt-0">
						<form
							method="post"
							action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/local-fulfillment", props.Customer.ID)) }
							class="flex items-center gap-2"
						>
							<div class="grid grid-cols-1">
								<select
									name="local_fulfillment"
									onchange="this.form.submit()"
									class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
								>
									<option value="" selected?={ props.Customer.PreferredLocalFulfillment == nil }>Ask each time</option>
									<option value="local_delivery" selected?={ props.Customer.PreferredLocalFulfillment != nil && *props.Customer.PreferredLocalFulfillment == domain.ShippingMethodLocalDelivery }>Local delivery</option>
									<option value="pickup" selected?={ props.Customer.PreferredLocalFulfillment != nil && *props.Customer.PreferredLocalFulfillment == domain.ShippingMethodPickup }>Pickup at the shop</option>
								</select>
								<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
									<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
								</svg>
							</div>
						</form>
					</dd>
				</div>
			</dl>
		</div>
	</div>
	<!-- Wholesale billing settings -->
	if props.Customer.AccountType == domain.AccountTypeWholesale {
		<div class="mt-8 border-2 border-rr-border bg-rr-surface">
			<div class="px-4 py-5 sm:px-6">
				<h2 class="text-sm font-semibold text-rr-heading">Billing Settings</h2>
			</div>
			<div class="border-t border-rr-border">
				<dl class="divide-y divide-rr-border">
					<div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
						<dt class="text-sm font-medium text-rr-muted">Payment terms</dt>
						<dd class="mt-1 sm:col-span-2 sm:mt-0">
							<form
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/payment-terms", props.Customer.ID)) }
								class="flex items-center gap-2"
							>
								<div class="grid grid-cols-1">
									<select
										name="payment_terms_days"
										onchange="this.form.submit()"
										class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
									>
										<option value="" selected?={ props.Customer.PaymentTermsDays == nil }>Not set</option>
										<option value="7" selected?={ props.Customer.PaymentTermsDays != nil && *props.Customer.PaymentTermsDays == 7 }>Net 7</option>
										<option value="15" selected?={ props.Customer.PaymentTermsDays != nil && *props.Customer.PaymentTermsDays == 15 }>Net 15</option>
										<option value="21" selected?={ props.Customer.PaymentTermsDays != nil && *props.Customer.PaymentTermsDays == 21 }>Net 21</option>
										<option value="30" selected?={ props.Customer.PaymentTermsDays != nil && *props.Customer.PaymentTermsDays == 30 }>Net 30</option>
									</select>
									<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
										<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
									</svg>
								</div>
							</form>
						</dd>
					</div>
					<div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
						<dt class="text-sm font-medium text-rr-muted">Price list</dt>
						<dd class="mt-1 sm:col-span-2 sm:mt-0">
							<form
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/price-list", props.Customer.ID)) }
								class="flex items-center gap-2"
							>
								<div class="grid grid-cols-1">
									<select
										name="price_list_id"
										onchange="this.form.submit()"
										class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
									>
										<option value="" selected?={ props.Customer.PriceListID == nil }>Base prices</option>
										for _, pl := range props.PriceLists {
											<option value={ pl.ID.String() } selected?={ props.Customer.PriceListID != nil && *props.Customer.PriceListID == pl.ID }>
												{ pl.Name }
												if pl.Status != domain.PriceListStatusActive {
													({ string(pl.Status) })
												}
											</option>
										}
									</select>
									<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
										<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
									</svg>
								</div>
							</form>
						</dd>
					</div>
					<div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
						<dt class="text-sm font-medium text-rr-muted">Billing method</dt>
						<dd class="mt-1 sm:col-span-2 sm:mt-0">
							<form
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/billing-method", props.Customer.ID)) }
								class="flex items-center gap-2"
							>
								<div class="grid grid-cols-1">
									<select
										name="billing_method"
										onchange="this.form.submit()"
										class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
									>
										<option value="manual" selected?={ props.Customer.BillingMethod == domain.BillingMethodManual }>Manual</option>
										<option value="ach" selected?={ props.Customer.BillingMethod == domain.BillingMethodACH }>ACH</option>
										<option value="credit_card" selected?={ props.Customer.BillingMethod == domain.BillingMethodCreditCard }>Credit Card</option>
									</select>
									<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
										<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
									</svg>
								</div>
							</form>
						</dd>
					</div>
				</dl>
			</div>
		</div>
	}
	<!-- Customer Groups -->
	<div class="mt-8">
		<div class="sm:flex sm:items-center sm:justify-between">
			<h2 class="text-sm font-semibold text-rr-heading">Customer Groups</h2>
		</div>
		<!-- Current memberships -->
		if len(props.MemberGroups) > 0 {
			<div class="mt-3 flex flex-wrap gap-2">
				for _, g := range props.MemberGroups {
					<span class="badge badge-indigo" style="padding:0.35rem 0.6rem;font-size:0.75rem;">
						{ g.Name }
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/groups/%s/remove", props.Customer.ID, g.ID)) } class="inline">
							<button type="submit" class="-mr-0.5 ml-1 inline-flex size-4 items-center justify-center rounded-sm hover:opacity-60" title="Remove from group">
								<svg class="size-3" viewBox="0 0 20 20" fill="currentColor">
									<path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"></path>
								</svg>
							</button>
						</form>
					</span>
				}
			</div>
		} else {
			<p class="mt-2 text-sm text-rr-muted">Not in any groups.</p>
		}
		<!-- Add to group -->
		if available := props.AvailableGroups(); len(available) > 0 {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/groups/add", props.Customer.ID)) } class="mt-3 flex items-end gap-3">
				<div class="flex-1 max-w-xs">
					<label for="group_id" class="block text-sm/6 font-medium text-rr-heading">Add to group</label>
					<div class="mt-2">
						<select name="group_id" id="group_id" required class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6">
							<option value="">Select a group...</option>
							for _, g := range available {
								<option value={ g.ID.String() }>{ g.Name }</option>
							}
						</select>
					</div>
				</div>
				<button type="submit" class="rounded-sm bg-rr-red px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red">
					Add
				</button>
			</form>
		}
		if len(props.AllGroups) == 0 {
			<p class="mt-2 text-sm text-rr-muted">
				No groups exist yet.
				<a href="/admin/groups" class="font-semibold text-rr-red hover:text-rr-red-lt">Create one</a>
			</p>
		}
	</div>
	<!-- Addresses -->
	<div class="mt-8">
		<h2 class="text-sm font-semibold text-rr-heading">Addresses</h2>
		if len(props.Addresses) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No addresses on file.</p>
		} else {
			<div class="mt-2 grid grid-cols-1 gap-4 sm:grid-cols-2">
				for _, addr := range props.Addresses {
					<div class="border-2 border-rr-border bg-rr-surface p-4">
						<p class="text-sm font-medium text-rr-heading">{ addr.FirstName } { addr.LastName }</p>
						if addr.Company != nil {
							<p class="text-sm text-rr-muted">{ *addr.Company }</p>
						}
						<p class="text-sm text-rr-muted">{ addr.Line1 }</p>
						if addr.Line2 != nil {
							<p class="text-sm text-rr-muted">{ *addr.Line2 }</p>
						}
						<p class="text-sm text-rr-muted">{ addr.City }, { addr.State } { addr.PostalCode }</p>
						<p class="text-sm text-rr-muted">{ addr.CountryCode }</p>
						if addr.IsDefault {
							<p class="mt-2">
								<span class="badge badge-blue">default</span>
							</p>
						}
					</div>
				}
			</div>
		}
	</div>
}

templ CustomerShow(props CustomerShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      fmt.Sprintf("%s %s", props.Customer.FirstName, props.Customer.LastName),
		ActivePath: "/admin/customers",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@CustomerShowContent(props)
	}
}
