package admin

import (
	"fmt"
	"github.com/google/uuid"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type CustomerShowProps struct {
	Customer     *domain.Customer
	Addresses    []domain.Address
	MemberGroups []domain.CustomerGroup
	AllGroups    []domain.CustomerGroup
	StaffName    string
	StaffRole    string
}

// availableGroups returns groups the customer is NOT already a member of.
func (p CustomerShowProps) AvailableGroups() []domain.CustomerGroup {
	memberIDs := make(map[uuid.UUID]bool, len(p.MemberGroups))
	for _, g := range p.MemberGroups {
		memberIDs[g.ID] = true
	}
	var available []domain.CustomerGroup
	for _, g := range p.AllGroups {
		if !memberIDs[g.ID] {
			available = append(available, g)
		}
	}
	return available
}

templ CustomerShowContent(props CustomerShowProps) {
	<!-- Header -->
	<div class="sm:flex sm:items-center sm:justify-between">
		<div>
			<div class="flex items-center gap-3">
				<h1 class="text-base/7 font-semibold text-stone-900">{ props.Customer.FirstName } { props.Customer.LastName }</h1>
				if props.Customer.AccountType == domain.AccountTypeWholesale {
					<span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-600/20">B2B</span>
				} else {
					<span class="inline-flex items-center rounded-md bg-stone-50 px-2 py-1 text-xs font-medium text-stone-600 ring-1 ring-inset ring-stone-500/10">B2C</span>
				}
			</div>
			<p class="mt-1 text-sm text-stone-500">{ props.Customer.Email }</p>
			if props.Customer.CompanyName != nil && *props.Customer.CompanyName != "" {
				<p class="text-sm text-stone-500">{ *props.Customer.CompanyName }</p>
			}
		</div>
		<div class="mt-4 sm:mt-0">
			<a href="/admin/customers" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">&larr; Back to customers</a>
		</div>
	</div>
	<!-- Wholesale status banner -->
	if props.Customer.AccountType == domain.AccountTypeWholesale && props.Customer.WholesaleStatus != nil {
		<div class="mt-4 rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
			<div class="sm:flex sm:items-center sm:justify-between">
				<div class="flex items-center gap-3">
					<h3 class="text-sm font-medium text-stone-900">Wholesale application</h3>
					@WholesaleStatusBadge(*props.Customer.WholesaleStatus)
				</div>
				<div class="mt-3 sm:mt-0">
					if *props.Customer.WholesaleStatus == domain.WholesaleStatusPending {
						<span class="isolate inline-flex rounded-md shadow-xs">
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/approve", props.Customer.ID)) }>
								<button type="submit" class="relative inline-flex items-center rounded-l-md bg-white px-3 py-2 text-sm font-semibold text-green-700 inset-ring-1 inset-ring-gray-300 hover:bg-green-50 focus:z-10">Approve</button>
							</form>
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/decline", props.Customer.ID)) }>
								<button type="submit" class="relative -ml-px inline-flex items-center rounded-r-md bg-white px-3 py-2 text-sm font-semibold text-red-700 inset-ring-1 inset-ring-gray-300 hover:bg-red-50 focus:z-10" onclick="return confirm('Decline this application?')">Decline</button>
							</form>
						</span>
					}
					if *props.Customer.WholesaleStatus == domain.WholesaleStatusApproved {
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/suspend", props.Customer.ID)) }>
							<button type="submit" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-red-700 inset-ring-1 inset-ring-gray-300 hover:bg-red-50 focus:z-10" onclick="return confirm('Suspend this wholesale account?')">Suspend</button>
						</form>
					}
				</div>
			</div>
		</div>
	}
	<!-- Info cards -->
	<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
		<div class="rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
			<dt class="text-sm font-medium text-stone-500">Email verified</dt>
			<dd class="mt-1">
				if props.Customer.EmailVerified {
					<span class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">yes</span>
				} else {
					<span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-1 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-600/20">no</span>
				}
			</dd>
		</div>
		<div class="rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
			<dt class="text-sm font-medium text-stone-500">Account type</dt>
			<dd class="mt-1 text-sm text-stone-900 capitalize">
				{ string(props.Customer.AccountType) }
			</dd>
		</div>
		<div class="rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
			<dt class="text-sm font-medium text-stone-500">Tax exempt</dt>
			<dd class="mt-1 text-sm text-stone-900">
				if props.Customer.TaxExempt {
					Yes
					if props.Customer.TaxExemptReason != nil {
						<span class="text-stone-500"> — { *props.Customer.TaxExemptReason }</span>
					}
				} else {
					No
				}
			</dd>
		</div>
	</div>
	<!-- Details -->
	<div class="mt-8 rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
		<div class="px-4 py-5 sm:px-6">
			<h2 class="text-sm font-semibold text-stone-900">Details</h2>
		</div>
		<div class="border-t border-stone-200">
			<dl class="divide-y divide-stone-200">
				if props.Customer.Phone != nil {
					<div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
						<dt class="text-sm font-medium text-stone-500">Phone</dt>
						<dd class="mt-1 text-sm text-stone-900 sm:col-span-2 sm:mt-0">{ *props.Customer.Phone }</dd>
					</div>
				}
				<div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
					<dt class="text-sm font-medium text-stone-500">Customer since</dt>
					<dd class="mt-1 text-sm text-stone-900 sm:col-span-2 sm:mt-0">{ props.Customer.CreatedAt.Format("January 2, 2006") }</dd>
				</div>
			</dl>
		</div>
	</div>
	<!-- Customer Groups -->
	<div class="mt-8">
		<div class="sm:flex sm:items-center sm:justify-between">
			<h2 class="text-sm font-semibold text-stone-900">Customer Groups</h2>
		</div>
		<!-- Current memberships -->
		if len(props.MemberGroups) > 0 {
			<div class="mt-3 flex flex-wrap gap-2">
				for _, g := range props.MemberGroups {
					<span class="inline-flex items-center gap-x-1.5 rounded-md bg-indigo-50 px-2.5 py-1.5 text-sm font-medium text-indigo-700 ring-1 ring-inset ring-indigo-600/20">
						{ g.Name }
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/groups/%s/remove", props.Customer.ID, g.ID)) } class="inline">
							<button type="submit" class="-mr-0.5 ml-1 inline-flex size-4 items-center justify-center rounded-md text-indigo-700 hover:bg-indigo-200 hover:text-indigo-900" title="Remove from group">
								<svg class="size-3" viewBox="0 0 20 20" fill="currentColor">
									<path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"></path>
								</svg>
							</button>
						</form>
					</span>
				}
			</div>
		} else {
			<p class="mt-2 text-sm text-stone-500">Not in any groups.</p>
		}
		<!-- Add to group -->
		if available := props.AvailableGroups(); len(available) > 0 {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s/groups/add", props.Customer.ID)) } class="mt-3 flex items-end gap-3">
				<div class="flex-1 max-w-xs">
					<label for="group_id" class="block text-sm/6 font-medium text-gray-900">Add to group</label>
					<div class="mt-2">
						<select name="group_id" id="group_id" required class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6">
							<option value="">Select a group...</option>
							for _, g := range available {
								<option value={ g.ID.String() }>{ g.Name }</option>
							}
						</select>
					</div>
				</div>
				<button type="submit" class="rounded-md bg-rr-red px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red">
					Add
				</button>
			</form>
		}
		if len(props.AllGroups) == 0 {
			<p class="mt-2 text-sm text-stone-500">
				No groups exist yet.
				<a href="/admin/groups" class="font-semibold text-rr-red hover:text-rr-red-lt">Create one</a>
			</p>
		}
	</div>
	<!-- Addresses -->
	<div class="mt-8">
		<h2 class="text-sm font-semibold text-stone-900">Addresses</h2>
		if len(props.Addresses) == 0 {
			<p class="mt-2 text-sm text-stone-500">No addresses on file.</p>
		} else {
			<div class="mt-2 grid grid-cols-1 gap-4 sm:grid-cols-2">
				for _, addr := range props.Addresses {
					<div class="rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
						<p class="text-sm font-medium text-stone-900">{ addr.FirstName } { addr.LastName }</p>
						if addr.Company != nil {
							<p class="text-sm text-stone-500">{ *addr.Company }</p>
						}
						<p class="text-sm text-stone-500">{ addr.Line1 }</p>
						if addr.Line2 != nil {
							<p class="text-sm text-stone-500">{ *addr.Line2 }</p>
						}
						<p class="text-sm text-stone-500">{ addr.City }, { addr.State } { addr.PostalCode }</p>
						<p class="text-sm text-stone-500">{ addr.CountryCode }</p>
						if addr.IsDefault {
							<p class="mt-2">
								<span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-600/20">default</span>
							</p>
						}
					</div>
				}
			</div>
		}
	</div>
}

templ CustomerShow(props CustomerShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      fmt.Sprintf("%s %s", props.Customer.FirstName, props.Customer.LastName),
		ActivePath: "/admin/customers",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@CustomerShowContent(props)
	}
}
