package admin

import (
	"fmt"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type DashboardProps struct {
	// Today stats
	TodayOrderCount int
	TodayRevenue    int

	// Queue depth
	ToFulfillCount int
	ToShipCount    int

	// Subscriptions
	ActiveSubCount  int
	PastDueSubCount int

	// Pending review
	PendingWholesale int

	// Urgent action queues
	OnHold             []domain.Order
	OnHoldCount        int
	FailedPayments     []domain.Order
	FailedPaymentCount int

	// Pipeline queues
	ToFulfill []domain.Order
	ToShip    []domain.Order

	// Recent orders
	RecentOrders []domain.Order

	StaffName string
	StaffRole string
}

func (p DashboardProps) urgentCount() int {
	return p.PastDueSubCount + p.OnHoldCount + p.FailedPaymentCount
}

func (p DashboardProps) reviewCount() int {
	return p.PendingWholesale
}

func (p DashboardProps) pipelineCount() int {
	return p.ToFulfillCount + p.ToShipCount
}

func (p DashboardProps) hasAnyAction() bool {
	return p.urgentCount() > 0 || p.reviewCount() > 0 || p.pipelineCount() > 0
}

// ageLabel returns a compact "Nm / Nh / Nd ago" string for a timestamp.
func ageLabel(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	case d < 7*24*time.Hour:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	default:
		return t.Format("Jan 2")
	}
}

// ageIsStale flags pipeline items that have lingered too long.
func ageIsStale(t time.Time) bool {
	return time.Since(t) > 48*time.Hour
}

templ DashboardContent(props DashboardProps) {
	<!-- Page title + Today strip -->
	<div class="flex items-baseline gap-3">
		<h1 class="admin-page-title">Dashboard</h1>
	</div>
	<div class="mt-6 border-2 border-rr-border bg-rr-surface px-6 py-5">
		<p class="label-font text-rr-muted">Today</p>
		<div class="mt-2 grid grid-cols-3 gap-x-6 gap-y-4">
			<div>
				<p class="text-2xl font-bold tabular-nums text-rr-heading">{ formatCents(props.TodayRevenue) }</p>
				<p class="label-font text-rr-muted mt-1">revenue</p>
			</div>
			<div>
				<p class="text-2xl font-bold tabular-nums text-rr-heading">{ fmt.Sprintf("%d", props.TodayOrderCount) }</p>
				<p class="label-font text-rr-muted mt-1">orders</p>
			</div>
			<div>
				<p class="text-2xl font-bold tabular-nums text-rr-heading">{ fmt.Sprintf("%d", props.ActiveSubCount) }</p>
				<p class="label-font text-rr-muted mt-1">active subs</p>
			</div>
		</div>
	</div>
	<div class="flame-stripe mt-8"></div>
	if !props.hasAnyAction() {
		<!-- All caught up -->
		<div class="mt-8">
			<div class="border-2 border-dashed border-rr-border py-10 text-center">
				<svg class="mx-auto size-10 text-rr-teal" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
				</svg>
				<p class="mt-3 text-sm font-semibold text-rr-heading">All caught up.</p>
				<p class="mt-1 text-sm text-rr-muted">Nothing needs your attention right now.</p>
			</div>
		</div>
	} else {
		<!-- Urgent band -->
		if props.urgentCount() > 0 {
			<div class="mt-8">
				@bandHeader("Urgent", props.urgentCount(), "text-rr-red")
				<div class="mt-3 space-y-3">
					if props.PastDueSubCount > 0 {
						@urgentCard(
							"/admin/subscriptions?status=past_due",
							fmt.Sprintf("%d past-due subscription%s", props.PastDueSubCount, pluralS(props.PastDueSubCount)),
							"Payments failing — customer may churn if not contacted.",
							"Review",
						)
					}
					if props.OnHoldCount > 0 {
						@urgentGroupLink(
							fmt.Sprintf("%d order%s on hold", props.OnHoldCount, pluralS(props.OnHoldCount)),
							"Manual review required before these move forward.",
							"/admin/orders?status=on_hold",
						)
						for _, o := range props.OnHold {
							@orderLinkRow(o, "On hold", "text-rr-red", true)
						}
					}
					if props.FailedPaymentCount > 0 {
						@urgentGroupLink(
							fmt.Sprintf("%d failed payment%s", props.FailedPaymentCount, pluralS(props.FailedPaymentCount)),
							"Charge did not go through — reach out or retry.",
							"/admin/orders",
						)
						for _, o := range props.FailedPayments {
							@orderLinkRow(o, "Payment failed", "text-rr-red", true)
						}
					}
				</div>
			</div>
		}
		<!-- Pending review band -->
		if props.reviewCount() > 0 {
			<div class={ bandSpacing(props.urgentCount()) }>
				@bandHeader("Pending review", props.reviewCount(), "text-rr-amber")
				<div class="mt-3 border-2 border-rr-border bg-rr-surface divide-y divide-rr-border">
					if props.PendingWholesale > 0 {
						<a href="/admin/wholesale" class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-rr-raised transition-colors">
							<div class="flex items-center gap-3 min-w-0">
								<span class="inline-block size-2 rounded-full bg-rr-amber shrink-0"></span>
								<div class="min-w-0">
									<p class="text-sm font-medium text-rr-heading">
										{ fmt.Sprintf("%d wholesale application", props.PendingWholesale) }{ pluralS(props.PendingWholesale) }
									</p>
									<p class="text-xs text-rr-muted mt-0.5">New accounts waiting on approval.</p>
								</div>
							</div>
							<div class="flex items-center gap-3 shrink-0">
								<span class="label-font text-rr-amber" style="font-size:0.6rem;">Review</span>
								@chevronRight()
							</div>
						</a>
					}
				</div>
			</div>
		}
		<!-- Pipeline band -->
		if props.pipelineCount() > 0 {
			<div class={ bandSpacing(props.urgentCount() + props.reviewCount()) }>
				@bandHeader("Pipeline", props.pipelineCount(), "text-rr-heading")
				<div class="mt-3 grid grid-cols-1 gap-4 lg:grid-cols-2">
					@pipelineGroup("Pack", props.ToFulfillCount, props.ToFulfill, "/admin/orders?fulfillment=unfulfilled", "text-rr-red", "bg-rr-red")
					@pipelineGroup("Ship", props.ToShipCount, props.ToShip, "/admin/orders?fulfillment=fulfilled", "text-rr-teal", "bg-rr-teal")
				</div>
			</div>
		}
	}
	<!-- Recent orders -->
	<div class="mt-10">
		<div class="flex items-baseline justify-between">
			<h2 class="label-font text-rr-muted">Recent orders</h2>
			<a href="/admin/orders" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">View all</a>
		</div>
		if len(props.RecentOrders) == 0 {
			<div class="mt-3 border-2 border-dashed border-rr-border py-8 text-center">
				<svg class="mx-auto size-10 text-rr-border" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
				</svg>
				<p class="mt-2 text-sm font-medium text-rr-heading">No orders yet</p>
				<p class="mt-1 text-sm text-rr-muted">Orders will appear here once customers start purchasing.</p>
				<a href="/" target="_blank" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-rr-red hover:text-rr-red-lt">
					View your storefront
					<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
					</svg>
				</a>
			</div>
		} else {
			<div class="mt-3 overflow-hidden border-2 border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3 text-left text-sm font-semibold text-rr-heading">Status</th>
							<th scope="col" class="px-3 py-3 text-left text-sm font-semibold text-rr-heading">Fulfillment</th>
							<th scope="col" class="px-3 py-3 text-right text-sm font-semibold text-rr-heading">Total</th>
							<th scope="col" class="hidden px-3 py-3 text-left text-sm font-semibold text-rr-heading sm:table-cell">Date</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, o := range props.RecentOrders {
							<tr class="row-link">
								<td class="whitespace-nowrap py-3 pl-4 pr-3 text-sm sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) } class="row-link-target font-medium text-rr-heading hover:text-rr-red">
										{ o.Number }
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-3 text-sm">
									@OrderStatusBadge(o.Status)
								</td>
								<td class="whitespace-nowrap px-3 py-3 text-sm">
									@FulfillmentStatusBadge(o.FulfillmentStatus)
								</td>
								<td class="whitespace-nowrap px-3 py-3 text-sm text-rr-heading text-right tabular-nums">
									{ formatCents(o.Total) }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-3 text-sm text-rr-muted sm:table-cell">
									{ o.PlacedAt.Format("Jan 2, 3:04 PM") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// bandHeader renders a labeled band title with a count chip.
templ bandHeader(label string, count int, accent string) {
	<div class="flex items-baseline gap-3">
		<h2 class={ "text-base font-bold tracking-wide uppercase", accent }>{ label }</h2>
		<span class="inline-block border-2 border-rr-border bg-rr-surface px-2 py-0.5 text-xs font-semibold tabular-nums text-rr-heading">
			{ fmt.Sprintf("%d", count) }
		</span>
	</div>
}

// urgentCard is a standalone red-stamp card for critical items without a per-item list.
templ urgentCard(href, title, detail, cta string) {
	<a
		href={ templ.SafeURL(href) }
		class="block border-2 border-rr-border bg-rr-surface p-4 hover:-translate-x-px hover:-translate-y-px transition-transform"
		style="box-shadow: 4px 4px 0 0 var(--color-rr-red);"
	>
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<p class="text-sm font-bold text-rr-red">{ title }</p>
				<p class="mt-1 text-xs text-rr-muted">{ detail }</p>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				<span class="label-font text-rr-red" style="font-size:0.65rem;">{ cta }</span>
				@chevronRight()
			</div>
		</div>
	</a>
}

// urgentGroupLink renders the header row above an urgent order group.
templ urgentGroupLink(title, detail, href string) {
	<a
		href={ templ.SafeURL(href) }
		class="block border-2 border-rr-border bg-rr-surface p-4 hover:-translate-x-px hover:-translate-y-px transition-transform"
		style="box-shadow: 4px 4px 0 0 var(--color-rr-red);"
	>
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<p class="text-sm font-bold text-rr-red">{ title }</p>
				<p class="mt-1 text-xs text-rr-muted">{ detail }</p>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				<span class="label-font text-rr-red" style="font-size:0.65rem;">Open list</span>
				@chevronRight()
			</div>
		</div>
	</a>
}

// orderLinkRow renders a single order row inside a band.
templ orderLinkRow(o domain.Order, label, labelClass string, urgent bool) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) }
		class={ "flex items-center justify-between gap-4 border-2 px-4 py-2.5 hover:bg-rr-raised transition-colors",
			templ.KV("border-rr-border bg-rr-surface", urgent),
			templ.KV("border-rr-border bg-rr-surface", !urgent),
		}
	>
		<div class="flex items-center gap-3 min-w-0">
			<span class="text-sm font-semibold text-rr-heading">{ o.Number }</span>
			<span class="hidden sm:inline text-sm text-rr-muted tabular-nums">{ formatCents(o.Total) }</span>
			if ageIsStale(o.PlacedAt) {
				<span class="label-font text-rr-red" style="font-size:0.6rem;">{ ageLabel(o.PlacedAt) }</span>
			} else {
				<span class="label-font text-rr-muted" style="font-size:0.6rem;">{ ageLabel(o.PlacedAt) }</span>
			}
		</div>
		<div class="flex items-center gap-3 shrink-0">
			<span class={ "label-font", labelClass }  style="font-size:0.6rem;">{ label }</span>
			@chevronRight()
		</div>
	</a>
}

// pipelineGroup renders a named queue (Pack / Ship) with a count header and row list.
templ pipelineGroup(label string, count int, orders []domain.Order, viewAllHref, labelClass, dotClass string) {
	<div class="border-2 border-rr-border bg-rr-surface">
		<div class="flex items-baseline justify-between px-4 py-2.5 border-b-2 border-rr-border bg-rr-raised">
			<div class="flex items-baseline gap-2">
				<span class={ "inline-block size-2 rounded-full", dotClass }></span>
				<h3 class="text-sm font-bold uppercase tracking-wide text-rr-heading">{ label } queue</h3>
				<span class="text-sm font-semibold tabular-nums text-rr-heading">{ fmt.Sprintf("%d", count) }</span>
			</div>
			if count > len(orders) {
				<a href={ templ.SafeURL(viewAllHref) } class="text-xs font-semibold text-rr-red hover:text-rr-red-lt">
					View all { fmt.Sprintf("%d", count) } &rarr;
				</a>
			} else {
				<a href={ templ.SafeURL(viewAllHref) } class="text-xs font-semibold text-rr-red hover:text-rr-red-lt">
					View all &rarr;
				</a>
			}
		</div>
		if len(orders) == 0 {
			<div class="px-4 py-6 text-center text-sm text-rr-muted">Nothing queued.</div>
		} else {
			<div class="divide-y divide-rr-border">
				for _, o := range orders {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) }
						class="flex items-center justify-between gap-4 px-4 py-2.5 hover:bg-rr-raised transition-colors"
					>
						<div class="flex items-center gap-3 min-w-0">
							<span class="text-sm font-semibold text-rr-heading">{ o.Number }</span>
							<span class="hidden sm:inline text-sm text-rr-muted tabular-nums">{ formatCents(o.Total) }</span>
						</div>
						<div class="flex items-center gap-2 shrink-0">
							if ageIsStale(o.PlacedAt) {
								<span class="label-font text-rr-red" style="font-size:0.6rem;">{ ageLabel(o.PlacedAt) }</span>
							} else {
								<span class="label-font text-rr-muted" style="font-size:0.6rem;">{ ageLabel(o.PlacedAt) }</span>
							}
							@chevronRight()
						</div>
					</a>
				}
			</div>
		}
	</div>
}

templ chevronRight() {
	<svg class="size-4 text-rr-border" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
	</svg>
}

// bandSpacing returns tight top spacing for the first band, and larger spacing for
// subsequent bands so they visually separate.
func bandSpacing(prevCount int) string {
	if prevCount == 0 {
		return "mt-8"
	}
	return "mt-10"
}

templ Dashboard(props DashboardProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Dashboard",
		ActivePath: "/admin",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@DashboardContent(props)
	}
}

func pluralS(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}
