package admin

import "github.com/dukerupert/hiri/internal/ui/layouts"

templ DashboardContent() {
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="text-base/7 font-semibold text-rr-heading">Dashboard</h1>
			<p class="mt-1 text-sm text-rr-muted">Welcome to the Hiri admin panel</p>
		</div>
	</div>
	<!-- Dev testing -->
	<div class="mt-8 rounded-sm border border-rr-amber/30 bg-rr-amber/5 p-4">
		<h2 class="text-sm font-semibold text-rr-amber-dark">Dev Testing</h2>
		<div class="mt-2 flex gap-3">
			<a href="/admin/dev/error" class="inline-flex items-center rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt">
				Trigger Server Error
			</a>
		</div>
	</div>
}

templ Dashboard(staffName, staffRole string) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Dashboard",
		ActivePath: "/admin",
		StaffName:  staffName,
		StaffRole:  staffRole,
	}) {
		@DashboardContent()
	}
}
