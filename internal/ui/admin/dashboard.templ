package admin

import (
	"fmt"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/admin/charts"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// RevenueProps holds the data backing the Revenue chart card. Trend is the
// combined (retail + wholesale) daily revenue that draws the sparkline. The
// current-window totals are split by sales channel so the subscription vs
// one-time mix is measured only against retail revenue — wholesale orders carry
// no subscription_id, so folding them in would inflate the "one-time" share.
type RevenueProps struct {
	Days      int                 // 7, 30, or 90
	Trend     []charts.ChartPoint // combined daily revenue, oldest → today
	Retail    ChannelRevenue
	Wholesale ChannelRevenue
}

// ChannelRevenue is one sales channel's revenue over the selected window, plus
// the prior window that drives the period-over-period delta. Subscription is the
// recurring subset of Current and is meaningful only when HasSubs is set (retail
// only). Prior == 0 hides the delta; Current == 0 hides the mix line.
type ChannelRevenue struct {
	Current      int
	Prior        int
	Subscription int  // recurring subset of Current; 0 for wholesale
	HasSubs      bool // render the subscription/one-time mix instead of "No subscriptions"
}

// SubscriptionsProps backs the active-subscriptions trend card. Trend holds one
// point per day (the live subscription count at end of day) over the selected
// 7/30/90-day window. CurrentActive is today's count; PriorActive is the count
// at the window's start, driving the period-over-period delta. PriorActive == 0
// hides the comparison.
type SubscriptionsProps struct {
	Days          int
	Mode          string // "delta" (per-day net change, default) or "total" (running base)
	Trend         []charts.ChartPoint
	CurrentActive int
	PriorActive   int
}

// ActiveCustomersProps backs the active-customers card: how many distinct
// customers actually placed an order over each of the three activity windows,
// scoped to a sales channel. All three windows render at once — "are we losing
// people" is a comparison across horizons, not a single number — and each
// carries the equivalent prior window so it reads as a trend, not a level.
// Channel is "all", "retail", or "wholesale" and drives the toggle's state.
type ActiveCustomersProps struct {
	Channel      string
	Week         int
	WeekPrior    int
	Month        int
	MonthPrior   int
	Quarter      int
	QuarterPrior int
}

// channelLabel renders the selected scope in the card's title.
func (p ActiveCustomersProps) channelLabel() string {
	switch p.Channel {
	case "retail":
		return "retail"
	case "wholesale":
		return "wholesale"
	default:
		return "all customers"
	}
}

type DashboardProps struct {
	// Today stats
	TodayOrderCount int
	TodayRevenue    int

	// Subscriptions
	ActiveSubCount  int
	PastDueSubCount int

	// Pending review
	PendingWholesale int
	// PendingWhiteLabel is white-label submissions still sitting in draft. Without
	// this the only notice staff get is the submission email — miss it and the
	// request is invisible.
	PendingWhiteLabel int

	// Urgent action queues
	OnHold              []domain.Order
	OnHoldCount         int
	FailedPayments      []domain.Order
	FailedPaymentCount  int
	PastDueSubs         []PastDueRow
	PastDueAccounts     []PastDueAccountRow
	PastDueAccountCount int

	// Order pipeline, split by sales channel. Each queue merges the Pack
	// (unfulfilled) and Ship (fulfilled) stages into one list; the Count is the
	// channel's full NeedsAction total, the Rows a display subset. Retail and
	// wholesale stay separate so neither channel's work hides in the other's.
	RetailCount    int
	RetailRows     []PipelineRow
	WholesaleCount int
	WholesaleRows  []PipelineRow

	// Charts
	ActiveCustomers ActiveCustomersProps // distinct customers ordering, by window and channel
	Revenue         RevenueProps
	Subscriptions   SubscriptionsProps    // active-subscriptions trend, 7/30/90-day window
	TopProducts     []charts.LabeledValue // top 5 by selected metric, last 30 days
	TopBy           string                // "units" (default) or "weight"

	// Merchant local timezone for date display.
	MerchantTZ *time.Location

	StaffName string
	StaffRole string
}

// PastDueRow bundles a past-due subscription with the summary fields its Urgent
// band row displays: who's behind on payment and what they subscribe to.
type PastDueRow struct {
	Subscription domain.Subscription
	CustomerName string // company name, customer "First Last", or "Guest"
	ProductTitle string // lead variant's product title (e.g., "Espresso Blend")
	Quantity     int
}

// PastDueAccountRow summarizes a wholesale account that is not current — one
// or more invoices past terms. Staff hold new fulfillment for these accounts
// until the balance clears.
type PastDueAccountRow struct {
	CustomerID     string // uuid string for the customer-page href
	CustomerName   string // company name, customer "First Last", or email
	OverdueOrders  int
	OverdueTotal   int // cents, sum of the overdue orders' invoiced totals (not net of partial payments)
	OldestPlacedAt time.Time
}

// PipelineRow bundles an order with the summary fields the channel queues need
// to read at a glance: what the customer ordered, how much, who from, and which
// fulfillment stage it sits at.
type PipelineRow struct {
	Order        domain.Order
	Stage        string // "Pack" (unfulfilled) or "Ship" (fulfilled, awaiting dispatch)
	ItemTitle    string // first product's title (e.g., "Espresso Blend")
	ExtraItems   int    // count of additional distinct line items beyond the first
	Quantity     int    // total quantity across all line items
	CustomerName string // wholesale company name, customer "First Last", or "Guest"
}

func (p DashboardProps) urgentCount() int {
	return p.PastDueAccountCount + p.PastDueSubCount + p.OnHoldCount + p.FailedPaymentCount
}

func (p DashboardProps) reviewCount() int {
	return p.PendingWholesale + p.PendingWhiteLabel
}

func (p DashboardProps) retailCount() int {
	return p.RetailCount
}

func (p DashboardProps) wholesaleCount() int {
	return p.WholesaleCount
}

func (p DashboardProps) hasAnyAction() bool {
	return p.urgentCount() > 0 || p.reviewCount() > 0 || p.retailCount() > 0 || p.wholesaleCount() > 0
}

// ageLabel returns a compact "Nm / Nh / Nd ago" string for a timestamp.
// loc is used only for the fallback "Jan 2" rendering on items older than 7 days.
func ageLabel(t time.Time, loc *time.Location) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	case d < 7*24*time.Hour:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	default:
		return t.In(loc).Format("Jan 2")
	}
}

// ageIsStale flags pipeline items that have lingered too long.
func ageIsStale(t time.Time) bool {
	return time.Since(t) > 48*time.Hour
}

templ DashboardContent(props DashboardProps) {
	<!-- Page title -->
	<div class="flex items-baseline gap-3">
		<h1 class="admin-page-title">Dashboard</h1>
	</div>
	@commandBar(props)
	<!-- Actions first: triage queues lead the page; analytics follow below. -->
	if !props.hasAnyAction() {
		<!-- All caught up -->
		<div class="mt-8">
			<div class="border border-dashed border-rr-border py-10 text-center">
				<svg class="mx-auto size-10 text-rr-teal" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
				</svg>
				<p class="mt-3 text-sm font-semibold text-rr-heading">All caught up.</p>
				<p class="mt-1 text-sm text-rr-muted">Nothing needs your attention right now.</p>
			</div>
		</div>
	} else {
		<!-- Urgent band -->
		if props.urgentCount() > 0 {
			<div id="band-urgent" class="mt-8 scroll-mt-6">
				@bandHeader("Urgent", props.urgentCount(), "text-rr-red")
				<div class="mt-3 space-y-3">
					if props.PastDueAccountCount > 0 {
						@urgentGroupLink(
							fmt.Sprintf("%d past-due wholesale account%s", props.PastDueAccountCount, pluralS(props.PastDueAccountCount)),
							"Invoices past terms — hold new fulfillment for these accounts until they're current.",
							"/admin/wholesale/fulfillment",
						)
						for _, row := range props.PastDueAccounts {
							@pastDueAccountRow(row, props.MerchantTZ)
						}
					}
					if props.PastDueSubCount > 0 {
						@urgentGroupLink(
							fmt.Sprintf("%d past-due subscription%s", props.PastDueSubCount, pluralS(props.PastDueSubCount)),
							"Payments failing — customer may churn if not contacted.",
							"/admin/subscriptions?status=past_due",
						)
						for _, row := range props.PastDueSubs {
							@pastDueSubRow(row, props.MerchantTZ)
						}
					}
					if props.OnHoldCount > 0 {
						@urgentGroupLink(
							fmt.Sprintf("%d order%s on hold", props.OnHoldCount, pluralS(props.OnHoldCount)),
							"Manual review required before these move forward.",
							"/admin/orders?status=on_hold",
						)
						for _, o := range props.OnHold {
							@orderLinkRow(o, "On hold", "text-rr-red", true, props.MerchantTZ)
						}
					}
					if props.FailedPaymentCount > 0 {
						@urgentGroupLink(
							fmt.Sprintf("%d failed payment%s", props.FailedPaymentCount, pluralS(props.FailedPaymentCount)),
							"Charge did not go through — reach out or retry.",
							"/admin/orders",
						)
						for _, o := range props.FailedPayments {
							@orderLinkRow(o, "Payment failed", "text-rr-red", true, props.MerchantTZ)
						}
					}
				</div>
			</div>
		}
		<!-- Pending review band -->
		if props.reviewCount() > 0 {
			<div id="band-review" class={ bandSpacing(props.urgentCount()), "scroll-mt-6" }>
				@bandHeader("Pending review", props.reviewCount(), "text-rr-amber")
				<div class="mt-3 border border-rr-border bg-rr-surface divide-y divide-rr-border">
					if props.PendingWholesale > 0 {
						<a href="/admin/wholesale" class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-rr-raised transition-colors">
							<div class="flex items-center gap-3 min-w-0">
								<span class="inline-block size-2 rounded-full bg-rr-amber shrink-0"></span>
								<div class="min-w-0">
									<p class="text-sm font-medium text-rr-heading">
										{ fmt.Sprintf("%d wholesale application", props.PendingWholesale) }{ pluralS(props.PendingWholesale) }
									</p>
									<p class="text-xs text-rr-muted mt-0.5">New accounts waiting on approval.</p>
								</div>
							</div>
							<div class="flex items-center gap-3 shrink-0">
								<span class="label-font text-rr-amber" style="font-size:0.6rem;">Review</span>
								@chevronRight()
							</div>
						</a>
					}
					if props.PendingWhiteLabel > 0 {
						<a href="/admin/catalog?white_label=pending" class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-rr-raised transition-colors">
							<div class="flex items-center gap-3 min-w-0">
								<span class="inline-block size-2 rounded-full bg-rr-amber shrink-0"></span>
								<div class="min-w-0">
									<p class="text-sm font-medium text-rr-heading">
										{ fmt.Sprintf("%d white-label submission", props.PendingWhiteLabel) }{ pluralS(props.PendingWhiteLabel) }
									</p>
									<p class="text-xs text-rr-muted mt-0.5">Wholesale custom labels waiting on review and pricing.</p>
								</div>
							</div>
							<div class="flex items-center gap-3 shrink-0">
								<span class="label-font text-rr-amber" style="font-size:0.6rem;">Review</span>
								@chevronRight()
							</div>
						</a>
					}
				</div>
			</div>
		}
		<!-- Retail orders band — Pack + Ship merged into one channel queue -->
		if props.retailCount() > 0 {
			<div id="band-retail" class={ bandSpacing(props.urgentCount() + props.reviewCount()), "scroll-mt-6" }>
				@bandHeader("Retail orders", props.retailCount(), "text-rr-heading")
				<div class="mt-3">
					@channelQueue(props.RetailCount, props.RetailRows, "/admin/fulfillment?view=needs_action", props.MerchantTZ)
				</div>
			</div>
		}
		<!-- Wholesale orders band — same treatment, scoped to the B2B channel -->
		if props.wholesaleCount() > 0 {
			<div id="band-wholesale" class={ bandSpacing(props.urgentCount() + props.reviewCount() + props.retailCount()), "scroll-mt-6" }>
				@bandHeader("Wholesale orders", props.wholesaleCount(), "text-rr-amber")
				<div class="mt-3">
					@channelQueue(props.WholesaleCount, props.WholesaleRows, "/admin/wholesale/fulfillment?view=needs_action", props.MerchantTZ)
				</div>
			</div>
		}
	}
	<!-- Analytics zone: trend reporting, demoted below the day's work. -->
	<div class="mt-12">
		<p class="label-font text-rr-muted">Analytics</p>
		<div class="mt-4">
			@RevenueCard(props.Revenue)
		</div>
		<div class="mt-6">
			@ActiveCustomersCard(props.ActiveCustomers)
		</div>
		<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
			@TopSellersCard(props.TopProducts, props.TopBy)
			@SubscriptionsCard(props.Subscriptions)
		</div>
	</div>
}

// commandBar is the dashboard's at-a-glance triage header: the day's pulse
// (today's revenue + order count) on the left, and clickable action-count chips
// on the right that jump straight to the relevant band below. It fuses "how are
// we doing right now" with "what needs my hands" so staff triage in one glance,
// without scrolling. Chips render only for non-zero counts; urgent is rendered
// loud (filled rust) so a payment failure can never hide.
templ commandBar(props DashboardProps) {
	<div class="mt-6 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border border-rr-border bg-rr-surface px-6 py-4">
		<!-- Day pulse -->
		<div class="flex items-center gap-6">
			<div>
				<p class="text-2xl font-bold tabular-nums text-rr-heading">{ formatCents(props.TodayRevenue) }</p>
				<p class="label-font text-rr-muted mt-0.5">today</p>
			</div>
			<div class="h-9 w-px bg-rr-border"></div>
			<div>
				<p class="text-2xl font-bold tabular-nums text-rr-heading">{ fmt.Sprintf("%d", props.TodayOrderCount) }</p>
				<p class="label-font text-rr-muted mt-0.5">{ fmt.Sprintf("order%s", pluralS(props.TodayOrderCount)) }</p>
			</div>
		</div>
		<!-- Action chips: present only when there's work; urgent rendered loud -->
		if props.hasAnyAction() {
			<div class="flex flex-wrap items-center gap-2">
				@actionChip("Urgent", props.urgentCount(), "#band-urgent", true)
				@actionChip("Review", props.reviewCount(), "#band-review", false)
				@actionChip("Retail", props.retailCount(), "#band-retail", false)
				@actionChip("Wholesale", props.wholesaleCount(), "#band-wholesale", false)
			</div>
		}
	</div>
}

// actionChip renders one count chip in the command bar. Hidden at zero — an
// empty chip is noise. `loud` flips the chip to a filled-rust stamp for urgent
// items so they read as a CTA, not a stat; the rest are quiet outlined chips.
templ actionChip(label string, count int, anchor string, loud bool) {
	if count > 0 {
		if loud {
			<a
				href={ templ.SafeURL(anchor) }
				class="inline-flex items-baseline gap-1.5 border border-rr-red bg-rr-red px-2.5 py-1 text-rr-bg hover:-translate-x-px hover:-translate-y-px transition-transform"
				style="box-shadow: 2px 2px 0 0 var(--color-rr-red);"
			>
				<span class="text-sm font-bold tabular-nums">{ fmt.Sprintf("%d", count) }</span>
				<span class="label-font" style="font-size:0.6rem;">{ label }</span>
			</a>
		} else {
			<a
				href={ templ.SafeURL(anchor) }
				class="inline-flex items-baseline gap-1.5 border border-rr-border bg-rr-surface px-2.5 py-1 text-rr-heading hover:bg-rr-raised transition-colors"
			>
				<span class="text-sm font-bold tabular-nums">{ fmt.Sprintf("%d", count) }</span>
				<span class="label-font text-rr-muted" style="font-size:0.6rem;">{ label }</span>
			</a>
		}
	}
}

// RevenueCard renders the revenue chart with a 7/30/90-day period selector
// and a delta vs the equivalent prior window. htmx swaps the whole card on
// toggle; the stable id makes #revenue-card the swap target.
templ RevenueCard(props RevenueProps) {
	<div id="revenue-card" class="border border-rr-border bg-rr-surface px-6 py-5">
		<div class="flex items-baseline justify-between gap-3">
			<p class="label-font text-rr-muted">{ fmt.Sprintf("Revenue · last %d days", props.Days) }</p>
			<div class="flex items-center gap-1 text-xs shrink-0">
				@revenuePeriodToggle(7, props.Days)
				@revenuePeriodToggle(30, props.Days)
				@revenuePeriodToggle(90, props.Days)
			</div>
		</div>
		<div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
			@revenueChannel("Retail", props.Retail, props.Days)
			@revenueChannel("Wholesale", props.Wholesale, props.Days)
		</div>
		<div class="mt-4">
			@charts.Trend("revenue-trend", "line", props.Trend)
		</div>
	</div>
}

// revenueChannel renders one channel's revenue block: total, period delta, and
// either the subscription/one-time mix (retail) or a "No subscriptions" note
// (wholesale). Subscriptions are retail-only, so the mix line never claims a
// wholesale split.
templ revenueChannel(label string, cr ChannelRevenue, days int) {
	<div class="min-w-0">
		<p class="label-font text-rr-muted">{ label }</p>
		<div class="mt-1 flex items-baseline gap-3 flex-wrap">
			<p class="text-xl font-bold tabular-nums text-rr-heading">{ formatCents(cr.Current) }</p>
			@revenueDelta(cr, days)
		</div>
		if cr.HasSubs {
			@revenueMix(cr)
		} else {
			<p class="mt-1 text-xs text-rr-muted">No subscriptions</p>
		}
	</div>
}

templ revenuePeriodToggle(value, current int) {
	if value == current {
		<span class="px-2 py-1 text-xs font-semibold uppercase tracking-wide bg-rr-heading text-rr-bg rounded-sm">{ fmt.Sprintf("%dd", value) }</span>
	} else {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/admin/dashboard/revenue?days=%d", value)) }
			hx-get={ fmt.Sprintf("/admin/dashboard/revenue?days=%d", value) }
			hx-target="#revenue-card"
			hx-swap="outerHTML"
			class="px-2 py-1 border border-rr-border bg-rr-surface text-rr-muted hover:text-rr-heading font-semibold uppercase tracking-wide"
			style="font-size:0.65rem;"
		>{ fmt.Sprintf("%dd", value) }</a>
	}
}

templ revenueDelta(cr ChannelRevenue, days int) {
	if cr.Prior > 0 {
		{{
			deltaPct := float64(cr.Current-cr.Prior) / float64(cr.Prior) * 100
		}}
		<span class="text-xs">
			if deltaPct >= 0.1 {
				<span class="text-rr-teal font-bold">{ fmt.Sprintf("↑ %.1f%%", deltaPct) }</span>
			} else if deltaPct <= -0.1 {
				<span class="text-rr-red font-bold">{ fmt.Sprintf("↓ %.1f%%", -deltaPct) }</span>
			} else {
				<span class="text-rr-muted font-bold">flat</span>
			}
			<span class="text-rr-muted ml-1">{ fmt.Sprintf("vs prior %dd", days) }</span>
		</span>
	}
}

// revenueMix shows the subscription vs one-time split for a channel as a small
// text line. Rendered only when there's revenue to break down — at $0 the
// percentages are meaningless. Subscription is the recurring component;
// everything else (one-time orders, draft sales, manual orders) falls into
// "one-time". Only called for channels where subscriptions apply (retail).
templ revenueMix(cr ChannelRevenue) {
	if cr.Current > 0 {
		{{
			subPct := float64(cr.Subscription) / float64(cr.Current) * 100
			oneTimePct := 100 - subPct
		}}
		<p class="mt-1 text-xs text-rr-muted">
			<span class="font-semibold text-rr-heading">{ fmt.Sprintf("%.0f%%", subPct) }</span> subscription
			<span class="mx-1">·</span>
			<span class="font-semibold text-rr-heading">{ fmt.Sprintf("%.0f%%", oneTimePct) }</span> one-time
		</p>
	}
}

// ActiveCustomersCard answers "how many customers are actually buying" —
// distinct customers with at least one real order in the window. All three
// horizons render side by side because the interesting signal is the shape
// across them: a healthy base has week ⊂ month ⊂ quarter with the gaps holding
// steady; week shrinking against a flat quarter means people are drifting.
// The channel toggle rescopes all three at once. htmx swaps the whole card, so
// #active-customers-card is the stable target.
templ ActiveCustomersCard(props ActiveCustomersProps) {
	<div id="active-customers-card" class="border border-rr-border bg-rr-surface px-6 py-5">
		<div class="flex items-baseline justify-between gap-3">
			<p class="label-font text-rr-muted">{ fmt.Sprintf("Active customers · %s", props.channelLabel()) }</p>
			<div class="flex items-center gap-1 text-xs shrink-0">
				@activeCustomersChannelToggle("all", "All", props.Channel)
				@activeCustomersChannelToggle("retail", "Retail", props.Channel)
				@activeCustomersChannelToggle("wholesale", "Wholesale", props.Channel)
			</div>
		</div>
		<div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-3">
			@activeCustomersWindow("Last week", props.Week, props.WeekPrior, "7d")
			@activeCustomersWindow("Last month", props.Month, props.MonthPrior, "30d")
			@activeCustomersWindow("Last quarter", props.Quarter, props.QuarterPrior, "90d")
		</div>
		<p class="mt-4 text-xs text-rr-muted">Distinct customers who placed an order. Cancelled, refunded and unpaid orders don't count.</p>
	</div>
}

// activeCustomersWindow renders one horizon's count with its change against the
// preceding window of the same length — last week vs the week before it, and so
// on. Growth here is people returning, so up is good and reads teal.
templ activeCustomersWindow(label string, count, prior int, priorLabel string) {
	<div class="min-w-0">
		<p class="label-font text-rr-muted">{ label }</p>
		<div class="mt-1 flex items-baseline gap-3 flex-wrap">
			<p class="text-xl font-bold tabular-nums text-rr-heading">{ fmt.Sprintf("%d", count) }</p>
			@activeCustomersDelta(count, prior, priorLabel)
		</div>
		<p class="mt-1 text-xs text-rr-muted">{ fmt.Sprintf("customer%s ordering", pluralS(count)) }</p>
	</div>
}

// activeCustomersDelta compares a window against the one before it. Hidden when
// the prior window is empty — a store with no history has no percentage to show
// (and dividing by zero would render an infinity).
templ activeCustomersDelta(count, prior int, priorLabel string) {
	if prior > 0 {
		{{
			deltaPct := float64(count-prior) / float64(prior) * 100
		}}
		<span class="text-xs">
			if deltaPct >= 0.1 {
				<span class="text-rr-teal font-bold">{ fmt.Sprintf("↑ %.1f%%", deltaPct) }</span>
			} else if deltaPct <= -0.1 {
				<span class="text-rr-red font-bold">{ fmt.Sprintf("↓ %.1f%%", -deltaPct) }</span>
			} else {
				<span class="text-rr-muted font-bold">flat</span>
			}
			<span class="text-rr-muted ml-1">{ fmt.Sprintf("vs prior %s", priorLabel) }</span>
		</span>
	}
}

templ activeCustomersChannelToggle(value, label, current string) {
	if value == current {
		<span class="px-2 py-1 text-xs font-semibold uppercase tracking-wide bg-rr-heading text-rr-bg rounded-sm">{ label }</span>
	} else {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/admin/dashboard/active-customers?channel=%s", value)) }
			hx-get={ fmt.Sprintf("/admin/dashboard/active-customers?channel=%s", value) }
			hx-target="#active-customers-card"
			hx-swap="outerHTML"
			class="px-2 py-1 border border-rr-border bg-rr-surface text-rr-muted hover:text-rr-heading font-semibold uppercase tracking-wide"
			style="font-size:0.65rem;"
		>{ label }</a>
	}
}

// SubscriptionsCard renders the active-subscriptions trend: each bar is the
// live subscription count at the end of that day, so the series reads as a
// growth curve. Mirrors RevenueCard — a 7/30/90-day selector swaps the whole
// card via htmx, and #subscriptions-card is the stable swap target.
templ SubscriptionsCard(props SubscriptionsProps) {
	<div id="subscriptions-card" class="border border-rr-border bg-rr-surface px-6 py-5">
		<div class="flex items-baseline justify-between gap-3">
			<div class="min-w-0">
				<p class="label-font text-rr-muted">{ fmt.Sprintf("Active subscriptions · last %d days", props.Days) }</p>
				<div class="mt-1 flex items-baseline gap-3 flex-wrap">
					<p class="text-xl font-bold tabular-nums text-rr-heading">{ fmt.Sprintf("%d", props.CurrentActive) }</p>
					@subscriptionsDelta(props)
				</div>
				if props.Mode == "delta" {
					<p class="mt-1 text-xs text-rr-muted">Net change per day — new &amp; reactivated minus cancelled.</p>
				} else {
					<p class="mt-1 text-xs text-rr-muted">Live base — active, paused &amp; past-due, until cancelled.</p>
				}
			</div>
			<div class="flex flex-col items-end gap-1.5 shrink-0">
				<div class="flex items-center gap-1 text-xs">
					@subscriptionsModeToggle("delta", "Net", props.Mode, props.Days)
					@subscriptionsModeToggle("total", "Total", props.Mode, props.Days)
				</div>
				<div class="flex items-center gap-1 text-xs">
					@subscriptionsPeriodToggle(7, props.Days, props.Mode)
					@subscriptionsPeriodToggle(30, props.Days, props.Mode)
					@subscriptionsPeriodToggle(90, props.Days, props.Mode)
				</div>
			</div>
		</div>
		<div class="mt-4">
			if props.Mode == "delta" {
				@charts.Trend("subscriptions-trend", "delta", props.Trend)
			} else {
				@charts.Trend("subscriptions-trend", "line", props.Trend)
			}
		</div>
	</div>
}

templ subscriptionsPeriodToggle(value, current int, mode string) {
	if value == current {
		<span class="px-2 py-1 text-xs font-semibold uppercase tracking-wide bg-rr-heading text-rr-bg rounded-sm">{ fmt.Sprintf("%dd", value) }</span>
	} else {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/admin/dashboard/subscriptions?days=%d&mode=%s", value, mode)) }
			hx-get={ fmt.Sprintf("/admin/dashboard/subscriptions?days=%d&mode=%s", value, mode) }
			hx-target="#subscriptions-card"
			hx-swap="outerHTML"
			class="px-2 py-1 border border-rr-border bg-rr-surface text-rr-muted hover:text-rr-heading font-semibold uppercase tracking-wide"
			style="font-size:0.65rem;"
		>{ fmt.Sprintf("%dd", value) }</a>
	}
}

// subscriptionsModeToggle switches the chart between per-day net change ("delta")
// and the running active base ("total"), preserving the selected day window.
templ subscriptionsModeToggle(value, label, current string, days int) {
	if value == current {
		<span class="px-2 py-1 text-xs font-semibold uppercase tracking-wide bg-rr-heading text-rr-bg rounded-sm">{ label }</span>
	} else {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/admin/dashboard/subscriptions?days=%d&mode=%s", days, value)) }
			hx-get={ fmt.Sprintf("/admin/dashboard/subscriptions?days=%d&mode=%s", days, value) }
			hx-target="#subscriptions-card"
			hx-swap="outerHTML"
			class="px-2 py-1 border border-rr-border bg-rr-surface text-rr-muted hover:text-rr-heading font-semibold uppercase tracking-wide"
			style="font-size:0.65rem;"
		>{ label }</a>
	}
}

// subscriptionsDelta shows growth of the active base vs its size at the window
// start. Hidden when PriorActive is 0 — with no starting base there's no
// meaningful percentage (and a brand-new store would divide by zero).
templ subscriptionsDelta(props SubscriptionsProps) {
	if props.PriorActive > 0 {
		{{
			deltaPct := float64(props.CurrentActive-props.PriorActive) / float64(props.PriorActive) * 100
		}}
		<span class="text-xs">
			if deltaPct >= 0.1 {
				<span class="text-rr-teal font-bold">{ fmt.Sprintf("↑ %.1f%%", deltaPct) }</span>
			} else if deltaPct <= -0.1 {
				<span class="text-rr-red font-bold">{ fmt.Sprintf("↓ %.1f%%", -deltaPct) }</span>
			} else {
				<span class="text-rr-muted font-bold">flat</span>
			}
			<span class="text-rr-muted ml-1">{ fmt.Sprintf("vs prior %dd", props.Days) }</span>
		</span>
	}
}

// TopSellersCard renders the top-sellers chart with a unit/weight toggle.
// htmx swaps the whole card on toggle, so the wrapping element carries the
// stable id used as the swap target.
templ TopSellersCard(data []charts.LabeledValue, by string) {
	{{
		if by != "weight" {
			by = "units"
		}
	}}
	<div id="top-sellers-card" class="border border-rr-border bg-rr-surface px-6 py-5">
		<div class="flex items-baseline justify-between gap-3">
			<p class="label-font text-rr-muted">Top sellers · last 30 days</p>
			<div class="flex items-center gap-1 text-xs">
				@topSellersToggle("units", "Per unit", by)
				@topSellersToggle("weight", "Per pound", by)
			</div>
		</div>
		<div class="mt-4">
			@charts.Bars("top-sellers-trend", data)
		</div>
	</div>
}

templ topSellersToggle(value, label, current string) {
	if value == current {
		<span class="px-2 py-1 text-xs font-semibold uppercase tracking-wide bg-rr-heading text-rr-bg rounded-sm">{ label }</span>
	} else {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/admin/dashboard/top-sellers?by=%s", value)) }
			hx-get={ fmt.Sprintf("/admin/dashboard/top-sellers?by=%s", value) }
			hx-target="#top-sellers-card"
			hx-swap="outerHTML"
			class="px-2 py-1 border border-rr-border bg-rr-surface text-rr-muted hover:text-rr-heading font-semibold uppercase tracking-wide"
			style="font-size:0.65rem;"
		>{ label }</a>
	}
}

// bandHeader renders a labeled band title with a count chip.
templ bandHeader(label string, count int, accent string) {
	<div class="flex items-baseline gap-3">
		<h2 class={ "text-base font-bold tracking-wide uppercase", accent }>{ label }</h2>
		<span class="inline-block border border-rr-border bg-rr-surface px-2 py-0.5 text-xs font-semibold tabular-nums text-rr-heading">
			{ fmt.Sprintf("%d", count) }
		</span>
	</div>
}

// urgentGroupLink renders the header row above an urgent order group.
templ urgentGroupLink(title, detail, href string) {
	<a
		href={ templ.SafeURL(href) }
		class="block border border-rr-border bg-rr-surface p-4 hover:-translate-x-px hover:-translate-y-px transition-transform"
		style="box-shadow: 4px 4px 0 0 var(--color-rr-red);"
	>
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<p class="text-sm font-bold text-rr-red">{ title }</p>
				<p class="mt-1 text-xs text-rr-muted">{ detail }</p>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				<span class="label-font text-rr-red" style="font-size:0.65rem;">Open list</span>
				@chevronRight()
			</div>
		</div>
	</a>
}

// orderLinkRow renders a single order row inside a band.
templ orderLinkRow(o domain.Order, label, labelClass string, urgent bool, loc *time.Location) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) }
		class={ "flex items-center justify-between gap-4 border px-4 py-2.5 hover:bg-rr-raised transition-colors",
			templ.KV("border-rr-border bg-rr-surface", urgent),
			templ.KV("border-rr-border bg-rr-surface", !urgent),
		}
	>
		<div class="flex items-center gap-3 min-w-0">
			<span class="text-sm font-semibold text-rr-heading">{ o.Number }</span>
			<span class="hidden sm:inline text-sm text-rr-muted tabular-nums">{ formatCents(o.Total) }</span>
			if ageIsStale(o.PlacedAt) {
				<span class="label-font text-rr-red" style="font-size:0.6rem;">{ ageLabel(o.PlacedAt, loc) }</span>
			} else {
				<span class="label-font text-rr-muted" style="font-size:0.6rem;">{ ageLabel(o.PlacedAt, loc) }</span>
			}
		</div>
		<div class="flex items-center gap-3 shrink-0">
			<span class={ "label-font", labelClass }  style="font-size:0.6rem;">{ label }</span>
			@chevronRight()
		</div>
	</a>
}

// pastDueSubRow renders one past-due subscription in the Urgent band. Unlike the
// order rows it is not a single full-row link: the left side links to the
// subscription, the right side carries an Acknowledge action, so the two stay
// separate interactive targets (no nested anchor/button). Acknowledging posts to
// the dunning-ack endpoint and drops the row off the dashboard until the next
// failed charge re-surfaces it.
templ pastDueSubRow(row PastDueRow, loc *time.Location) {
	<div class="flex items-center justify-between gap-4 border border-rr-border bg-rr-surface px-4 py-2.5">
		<a
			href={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s", row.Subscription.ID)) }
			class="flex min-w-0 items-center gap-3 hover:opacity-80 transition-opacity"
		>
			<div class="min-w-0">
				<p class="truncate text-sm font-semibold text-rr-heading">{ row.CustomerName }</p>
				<p class="mt-0.5 truncate text-xs text-rr-muted">{ pastDueItemLabel(row) }</p>
			</div>
		</a>
		<div class="flex items-center gap-3 shrink-0">
			<span class="label-font text-rr-red" style="font-size:0.6rem;">{ ageLabel(row.Subscription.NextOrderAt, loc) }</span>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/dunning-ack", row.Subscription.ID)) }>
				<button
					type="submit"
					title="Hide until the next failed charge"
					class="border border-rr-border bg-rr-surface px-2.5 py-1 label-font text-rr-muted hover:text-rr-heading hover:bg-rr-raised transition-colors"
					style="font-size:0.6rem;"
				>Acknowledge</button>
			</form>
		</div>
	</div>
}

// pastDueAccountRow renders one not-current wholesale account in the Urgent
// band: who owes, how many invoices and how much, and how old the oldest debt
// is. Links to the customer page where staff see every order and its status.
templ pastDueAccountRow(row PastDueAccountRow, loc *time.Location) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", row.CustomerID)) }
		class="flex items-center justify-between gap-4 border border-rr-border bg-rr-surface px-4 py-2.5 hover:bg-rr-raised transition-colors"
	>
		<div class="min-w-0">
			<p class="truncate text-sm font-semibold text-rr-heading">{ row.CustomerName }</p>
			<p class="mt-0.5 text-xs text-rr-muted">
				{ fmt.Sprintf("%d overdue invoice%s · %s invoiced", row.OverdueOrders, pluralS(row.OverdueOrders), formatCents(row.OverdueTotal)) }
			</p>
		</div>
		<div class="flex items-center gap-3 shrink-0">
			<span class="label-font text-rr-red" style="font-size:0.6rem;">{ "oldest " + ageLabel(row.OldestPlacedAt, loc) }</span>
			@chevronRight()
		</div>
	</a>
}

// pastDueItemLabel renders the subscription's product and quantity, falling back
// to "—" when the variant or product has been deleted from the catalog.
func pastDueItemLabel(row PastDueRow) string {
	title := row.ProductTitle
	if title == "" {
		title = "—"
	}
	return fmt.Sprintf("%s · ×%d", title, row.Quantity)
}

// channelQueue renders one channel's combined fulfillment queue: a header bar
// with a "view all" link into that channel's fulfillment list, then up to
// pipelineDisplayLimit rows. The owning band header already names the channel
// and shows the count, so this bar carries only the link.
templ channelQueue(count int, rows []PipelineRow, viewAllHref string, loc *time.Location) {
	<div class="border border-rr-border bg-rr-surface">
		<div class="flex items-baseline justify-end px-4 py-2 border-b border-rr-border bg-rr-raised">
			if count > len(rows) {
				<a href={ templ.SafeURL(viewAllHref) } class="text-xs font-semibold text-rr-red hover:text-rr-red-lt">
					View all { fmt.Sprintf("%d", count) } &rarr;
				</a>
			} else {
				<a href={ templ.SafeURL(viewAllHref) } class="text-xs font-semibold text-rr-red hover:text-rr-red-lt">
					View all &rarr;
				</a>
			}
		</div>
		if len(rows) == 0 {
			<div class="px-4 py-6 text-center text-sm text-rr-muted">Nothing queued.</div>
		} else {
			<div class="divide-y divide-rr-border">
				for _, row := range rows {
					@pipelineRow(row, loc)
				}
			</div>
		}
	</div>
}

// stageClass colors a row's stage tag: Ship is teal (packed, ready to move),
// everything else (Pack) is rust (still needs hands on it).
func stageClass(stage string) string {
	if stage == "Ship" {
		return "text-rr-teal"
	}
	return "text-rr-red"
}

// pipelineRow renders one queue row. Stacks on small screens; on lg+ it lays out
// item / qty / customer / price / stage / age as a compact grid.
templ pipelineRow(row PipelineRow, loc *time.Location) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", row.Order.ID)) }
		class="block px-4 py-2.5 hover:bg-rr-raised transition-colors"
	>
		<!-- Mobile / md: stacked summary -->
		<div class="flex items-center justify-between gap-3 lg:hidden">
			<div class="min-w-0">
				<p class="truncate text-sm font-semibold text-rr-heading">{ pipelineItemLabel(row) }</p>
				<p class="mt-0.5 truncate text-xs text-rr-muted">
					×{ fmt.Sprintf("%d", row.Quantity) } · { row.CustomerName } · { row.Order.Number }
				</p>
			</div>
			<div class="flex items-center gap-2 shrink-0">
				<span class={ "label-font", stageClass(row.Stage) } style="font-size:0.6rem;">{ row.Stage }</span>
				<span class="text-sm font-semibold tabular-nums text-rr-heading">{ formatCents(row.Order.Total) }</span>
				if ageIsStale(row.Order.PlacedAt) {
					<span class="label-font text-rr-red" style="font-size:0.6rem;">{ ageLabel(row.Order.PlacedAt, loc) }</span>
				} else {
					<span class="label-font text-rr-muted" style="font-size:0.6rem;">{ ageLabel(row.Order.PlacedAt, loc) }</span>
				}
				@chevronRight()
			</div>
		</div>
		<!-- lg+: tabular columns (item / qty / customer / price / stage / age) -->
		<div class="hidden lg:grid lg:grid-cols-[minmax(0,2fr)_auto_minmax(0,1.4fr)_auto_auto_auto_auto] lg:items-baseline lg:gap-3">
			<div class="min-w-0">
				<p class="truncate text-sm font-semibold text-rr-heading">{ pipelineItemLabel(row) }</p>
				<p class="text-xs text-rr-muted">{ row.Order.Number }</p>
			</div>
			<div class="text-sm tabular-nums text-rr-muted">×{ fmt.Sprintf("%d", row.Quantity) }</div>
			<div class="min-w-0 truncate text-sm text-rr-muted">{ row.CustomerName }</div>
			<div class="text-right text-sm font-semibold tabular-nums text-rr-heading">{ formatCents(row.Order.Total) }</div>
			<span class={ "label-font text-right", stageClass(row.Stage) } style="font-size:0.6rem;">{ row.Stage }</span>
			if ageIsStale(row.Order.PlacedAt) {
				<span class="label-font text-rr-red text-right" style="font-size:0.6rem;">{ ageLabel(row.Order.PlacedAt, loc) }</span>
			} else {
				<span class="label-font text-rr-muted text-right" style="font-size:0.6rem;">{ ageLabel(row.Order.PlacedAt, loc) }</span>
			}
			@chevronRight()
		</div>
	</a>
}

// pipelineItemLabel renders the item title with a "+N" suffix when there are
// additional distinct line items beyond the first.
func pipelineItemLabel(row PipelineRow) string {
	title := row.ItemTitle
	if title == "" {
		title = "—"
	}
	if row.ExtraItems > 0 {
		return fmt.Sprintf("%s · +%d more", title, row.ExtraItems)
	}
	return title
}

templ chevronRight() {
	<svg class="size-4 text-rr-border" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
	</svg>
}

// bandSpacing returns tight top spacing for the first band, and larger spacing for
// subsequent bands so they visually separate.
func bandSpacing(prevCount int) string {
	if prevCount == 0 {
		return "mt-8"
	}
	return "mt-10"
}

templ Dashboard(props DashboardProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Dashboard",
		ActivePath: "/admin",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@DashboardContent(props)
	}
}

func pluralS(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}
