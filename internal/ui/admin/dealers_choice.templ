package admin

import (
	"fmt"
	"strings"
	"time"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
)

// DealersChoiceLine is one dealer's choice pack on an order: the bags staff
// fill and the coffees they may fill them with.
type DealersChoiceLine struct {
	LineItemID   uuid.UUID
	ProductTitle string
	// OptionLabel is the line's variant label ("6 Bags / Drip / No Decaf"),
	// which tells the packer the grind.
	OptionLabel  string
	Quantity     int
	Required     int
	ExcludeDecaf bool
	// Bags has Required entries, in bag order.
	Bags    []DealersChoiceBag
	Options []domain.PickCandidate
	// Confirmed is true once staff saved a full set of picks.
	Confirmed bool
	// AvoidedPrevious is true when suggestions steered away from the
	// customer's last dealer's choice box.
	AvoidedPrevious bool
}

// DealersChoiceBag is one bag's dropdown: what is selected now (saved, or the
// suggestion) and what Hiri suggested.
type DealersChoiceBag struct {
	Selected  uuid.UUID
	Suggested uuid.UUID
}

// dealersChoicePending reports whether any pack on the order still needs its
// picks saved. The action rail uses it to explain a refused fulfill up front.
func dealersChoicePending(lines []DealersChoiceLine) bool {
	for _, l := range lines {
		if !l.Confirmed {
			return true
		}
	}
	return false
}

func pickOptionLabel(c domain.PickCandidate, suggested uuid.UUID, prev *domain.PreviousPicks) string {
	label := c.Title
	if label == "" {
		label = "Unknown coffee"
	}
	if c.IsDecaf {
		label += " (decaf)"
	}
	if inPreviousBox(prev, c.ProductID) {
		label += " · in last box"
	}
	if c.ProductID == suggested {
		label += " — suggested"
	}
	return label
}

func inPreviousBox(prev *domain.PreviousPicks, id uuid.UUID) bool {
	if prev == nil {
		return false
	}
	for _, p := range prev.ProductIDs {
		if p == id {
			return true
		}
	}
	return false
}

// previousBoxSummary lists last box's coffees with a count for repeats
// ("Cloud 9 ×2, Hot Rod"), in the order they were first packed.
func previousBoxSummary(prev *domain.PreviousPicks) string {
	counts := map[string]int{}
	var order []string
	for _, t := range prev.Titles {
		if counts[t] == 0 {
			order = append(order, t)
		}
		counts[t]++
	}
	parts := make([]string, len(order))
	for i, t := range order {
		parts[i] = t
		if counts[t] > 1 {
			parts[i] = fmt.Sprintf("%s ×%d", t, counts[t])
		}
	}
	return strings.Join(parts, ", ")
}

func pickSelectID(lineID uuid.UUID, i int) string {
	return fmt.Sprintf("pick-%s-%d", lineID.String()[:8], i)
}

func dealersChoiceSummary(l DealersChoiceLine) string {
	s := fmt.Sprintf("%d bags", l.Required)
	if l.Quantity > 1 {
		s = fmt.Sprintf("%d packs, %d bags", l.Quantity, l.Required)
	}
	if l.OptionLabel != "" {
		s += " · " + l.OptionLabel
	}
	return s
}

// orderDealersChoicePanel lets fulfillment staff record which coffees went in
// each dealer's choice pack. The dropdowns arrive preset with Hiri's
// suggestion; saving them unchanged is the common case, and any bag can be
// switched before saving. Until a pack is saved the order cannot be fulfilled,
// labelled, or handed off.
templ orderDealersChoicePanel(orderID uuid.UUID, lines []DealersChoiceLine, prev *domain.PreviousPicks, loc *time.Location) {
	<section id="dealers-choice" aria-labelledby="dealers-choice-heading">
		<h2 id="dealers-choice-heading" class="text-sm font-semibold text-rr-heading">Dealer's choice picks</h2>
		<p class="mt-1 text-sm text-rr-muted">Hiri suggests a coffee for each bag. Change any bag, then save what goes in the box.</p>
		<div class="mt-3 border border-rr-border bg-rr-raised px-4 py-3 text-sm">
			if prev != nil {
				<p class="text-xs font-semibold uppercase tracking-wide text-rr-muted">
					Last box ·
					<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", prev.OrderID)) } class="text-rr-red hover:text-rr-red-lt">Order { prev.OrderNumber }</a>
					· { prev.PlacedAt.In(loc).Format("Jan 2, 2006") }
				</p>
				<p class="mt-1 text-rr-heading">{ previousBoxSummary(prev) }</p>
				<p class="mt-1 text-xs text-rr-muted">Coffees from that box are marked "in last box" in the lists below.</p>
			} else {
				<p class="text-rr-muted">First dealer's choice order for this customer. Nothing to avoid repeating.</p>
			}
		</div>
		for _, l := range lines {
			<form
				method="post"
				action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/line-items/%s/picks", orderID, l.LineItemID)) }
				class="mt-3 border border-rr-border bg-rr-surface p-4"
			>
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div class="min-w-0">
						<p class="text-sm font-medium text-rr-heading">{ l.ProductTitle }</p>
						<p class="text-xs text-rr-muted">{ dealersChoiceSummary(l) }</p>
					</div>
					if l.Confirmed {
						<span class="badge badge-green">Picks saved</span>
					} else {
						<span class="badge badge-amber">Needs picks</span>
					}
				</div>
				if len(l.Options) == 0 {
					<p class="mt-3 text-sm text-rr-red">No coffees are available to pick. A coffee shows up here when it is active, public, and sold in a 12oz bag.</p>
				} else {
					<div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
						for i, bag := range l.Bags {
							<div>
								<label for={ pickSelectID(l.LineItemID, i) } class="block text-xs font-medium text-rr-muted">Bag { fmt.Sprintf("%d", i+1) }</label>
								<select
									id={ pickSelectID(l.LineItemID, i) }
									name="pick"
									required
									class="mt-1 block w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
								>
									if bag.Selected == uuid.Nil {
										<option value="" selected disabled>Choose a coffee</option>
									}
									for _, c := range l.Options {
										<option value={ c.ProductID.String() } selected?={ c.ProductID == bag.Selected }>{ pickOptionLabel(c, bag.Suggested, prev) }</option>
									}
								</select>
							</div>
						}
					</div>
					<div class="mt-3 flex flex-wrap items-center justify-between gap-2">
						<p class="text-xs text-rr-muted">
							if l.ExcludeDecaf {
								No decaf on this pack.
							}
							if l.AvoidedPrevious {
								Suggestions skip the last box where the shelf allows.
							}
						</p>
						<button
							type="submit"
							class="inline-flex items-center rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
						>
							if l.Confirmed {
								Update picks
							} else {
								Save picks
							}
						</button>
					</div>
				}
			</form>
		}
	</section>
}

func joinOptionValues(vals []string) string {
	return strings.Join(vals, " / ")
}

func pickCountValue(r domain.PickRule, ok bool) string {
	if !ok {
		return ""
	}
	return fmt.Sprintf("%d", r.PickCount)
}

// DealersChoiceSetupPanel turns variants into dealer's choice packs: each unit
// ordered ships the set number of 12oz bags, chosen by the crew at packing
// time. Collapsed unless the product already has a pack, since almost every
// product is an ordinary coffee.
templ DealersChoiceSetupPanel(productID uuid.UUID, variants []VariantWithOptions, rules map[uuid.UUID]domain.PickRule) {
	<details class="border-t border-rr-border pt-6" open?={ len(rules) > 0 }>
		<summary class="cursor-pointer text-sm font-medium text-rr-heading">Dealer's choice pack</summary>
		<p class="mt-1 text-sm text-rr-muted">
			Set how many 12oz bags each variant ships. Fulfillment picks the coffees for every order, and the order can't ship until they're saved. Leave bags blank for an ordinary variant.
		</p>
		if len(variants) == 0 {
			<p class="mt-3 text-sm text-rr-muted">Add variants first.</p>
		} else {
			<div class="mt-3 overflow-x-auto border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-2 pl-4 pr-3 text-left text-xs font-semibold text-rr-heading">Variant</th>
							<th scope="col" class="px-3 py-2 text-left text-xs font-semibold text-rr-heading">Bags</th>
							<th scope="col" class="px-3 py-2 text-left text-xs font-semibold text-rr-heading">No decaf</th>
							<th scope="col" class="px-3 py-2"><span class="sr-only">Save</span></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border">
						for _, vwo := range variants {
							if vwo.Variant.ArchivedAt == nil {
								{{ rule, ok := rules[vwo.Variant.ID] }}
								{{ formID := "pick-rule-" + vwo.Variant.ID.String() }}
								<tr>
									<td class="py-2 pl-4 pr-3 text-sm text-rr-heading">
										<form id={ formID } method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s/picks", productID, vwo.Variant.ID)) }></form>
										{ vwo.Variant.SKU }
										if len(vwo.OptionValues) > 0 {
											<span class="text-rr-muted">· { joinOptionValues(vwo.OptionValues) }</span>
										}
									</td>
									<td class="px-3 py-2">
										<label for={ formID + "-count" } class="sr-only">Bags per pack for { vwo.Variant.SKU }</label>
										<input
											id={ formID + "-count" }
											form={ formID }
											name="pick_count"
											type="number"
											min="0"
											max={ fmt.Sprintf("%d", domain.MaxPickCount) }
											inputmode="numeric"
											value={ pickCountValue(rule, ok) }
											placeholder="—"
											class="w-16 border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
										/>
									</td>
									<td class="px-3 py-2">
										<label class="inline-flex items-center gap-1.5 text-sm text-rr-body">
											<input type="checkbox" form={ formID } name="exclude_decaf" checked?={ ok && rule.ExcludeDecaf }/>
											<span class="sr-only">Leave decaf out of { vwo.Variant.SKU }</span>
										</label>
									</td>
									<td class="px-3 py-2 text-right">
										<button
											type="submit"
											form={ formID }
											class="border border-rr-border bg-rr-raised px-2 py-1 text-xs font-medium text-rr-heading hover:bg-rr-border"
										>Save</button>
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		}
	</details>
}
