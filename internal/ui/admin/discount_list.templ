package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type DiscountListProps struct {
	Discounts    []domain.Discount
	ActiveFilter string
	Page         int
	PerPage      int
	HasMore      bool
	StaffName    string
	StaffRole    string
}

func discountTypeLabel(t domain.DiscountType) string {
	switch t {
	case domain.DiscountTypePercentage:
		return "Percentage"
	case domain.DiscountTypeFixedAmount:
		return "Fixed Amount"
	case domain.DiscountTypeFreeShipping:
		return "Free Shipping"
	default:
		return string(t)
	}
}

func discountValueDisplay(d domain.Discount) string {
	switch d.Type {
	case domain.DiscountTypePercentage:
		return fmt.Sprintf("%d%%", d.Value)
	case domain.DiscountTypeFixedAmount:
		return formatCents(d.Value)
	case domain.DiscountTypeFreeShipping:
		return "Free"
	default:
		return fmt.Sprintf("%d", d.Value)
	}
}

templ DiscountListContent(props DiscountListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="text-base/7 font-semibold text-stone-900">Discounts</h1>
			<p class="mt-1 text-sm text-stone-500">Manage discounts and promotions</p>
		</div>
	</div>
	<!-- Filters -->
	<form method="get" action="/admin/discounts" class="mt-6 flex items-center gap-3">
		<div class="grid grid-cols-1">
			<select
				name="active"
				onchange="this.form.submit()"
				class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pl-3 pr-8 text-sm text-stone-900 outline-1 -outline-offset-1 outline-stone-300 focus:outline-2 focus:-outline-offset-2 focus:outline-hiri-teal"
			>
				<option value="">All discounts</option>
				<option value="true" selected?={ props.ActiveFilter == "true" }>Active</option>
				<option value="false" selected?={ props.ActiveFilter == "false" }>Inactive</option>
			</select>
			<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-stone-500 sm:size-4" viewBox="0 0 16 16" fill="currentColor">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</div>
	</form>
	<!-- Discount table -->
	<div class="mt-6">
		if len(props.Discounts) == 0 {
			<div class="rounded-lg border-2 border-dashed border-stone-300 p-12 text-center">
				<svg class="mx-auto size-12 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-stone-900">No discounts</h3>
				<p class="mt-1 text-sm text-stone-500">Create discounts to offer promotions to your customers.</p>
			</div>
		} else {
			<div class="overflow-hidden rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
				<table class="min-w-full divide-y divide-stone-300">
					<thead class="bg-stone-50">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-stone-900 sm:pl-6">Name</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Type</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Value</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Status</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-stone-900 sm:table-cell">Dates</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-stone-900 lg:table-cell">Created</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-200 bg-white">
						for _, d := range props.Discounts {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-stone-900 sm:pl-6">
									{ d.Name }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-stone-500">
									{ discountTypeLabel(d.Type) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-stone-900 tabular-nums">
									{ discountValueDisplay(d) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@DiscountActiveBadge(d.Active)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-stone-500 sm:table-cell">
									if d.StartsAt != nil || d.ExpiresAt != nil {
										if d.StartsAt != nil {
											{ d.StartsAt.Format("Jan 2") }
										} else {
											<span class="text-stone-400">—</span>
										}
										<span class="text-stone-400"> → </span>
										if d.ExpiresAt != nil {
											{ d.ExpiresAt.Format("Jan 2") }
										} else {
											<span class="text-stone-400">—</span>
										}
									} else {
										<span class="text-stone-400">No dates</span>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-stone-500 lg:table-cell">
									{ d.CreatedAt.Format("Jan 2, 2006") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-stone-200 px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/discounts?page=%d&active=%s", props.Page-1, props.ActiveFilter)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Previous
						</a>
					}
				</div>
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/discounts?page=%d&active=%s", props.Page+1, props.ActiveFilter)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

templ DiscountList(props DiscountListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Discounts",
		ActivePath: "/admin/discounts",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@DiscountListContent(props)
	}
}
