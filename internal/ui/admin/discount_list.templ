package admin

import (
	"fmt"
	"time"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type DiscountListProps struct {
	Discounts    []domain.Discount
	Codes        map[uuid.UUID][]domain.CouponCode
	ActiveFilter string
	Page         int
	PerPage      int
	HasMore      bool
	MerchantTZ   *time.Location
	StaffName    string
	StaffRole    string
}

func discountTypeLabel(t domain.DiscountType) string {
	switch t {
	case domain.DiscountTypePercentage:
		return "Percentage"
	case domain.DiscountTypeFixedAmount:
		return "Fixed Amount"
	case domain.DiscountTypeFreeShipping:
		return "Free Shipping"
	default:
		return string(t)
	}
}

// discountMinimumLabel is the order threshold a discount needs to apply,
// shown under its value. MinimumOrderCents was settable on the create form and
// enforced in checkout (see app/checkout.go) but rendered nowhere, so once set
// it could never be read back — and discounts have no edit page to check it on.
func discountMinimumLabel(d domain.Discount) string {
	if d.MinimumOrderCents == nil || *d.MinimumOrderCents <= 0 {
		return ""
	}
	return "min " + formatCents(*d.MinimumOrderCents)
}

func discountValueDisplay(d domain.Discount) string {
	switch d.Type {
	case domain.DiscountTypePercentage:
		return fmt.Sprintf("%d%%", d.Value)
	case domain.DiscountTypeFixedAmount:
		return formatCents(d.Value)
	case domain.DiscountTypeFreeShipping:
		return "Free"
	default:
		return fmt.Sprintf("%d", d.Value)
	}
}

templ DiscountListContent(props DiscountListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Discounts</h1>
			<p class="mt-1 text-sm text-rr-muted">Manage discounts and promotions</p>
		</div>
	</div>
	<!-- Create form -->
	<div class="mt-6 border border-rr-border bg-rr-surface p-6">
		<h2 class="text-sm font-semibold text-rr-heading">New Discount</h2>
		<p class="mt-1 text-sm text-rr-muted">Each discount carries one single-use coupon code. Codes are stored uppercase.</p>
		<form method="post" action="/admin/discounts" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-6">
			<div class="sm:col-span-2">
				<label for="discount-name" class="block text-sm font-medium text-rr-body">Name</label>
				<input
					id="discount-name"
					name="name"
					type="text"
					required
					placeholder="e.g. Spring promo"
					class="mt-1 block w-full rounded-sm border border-rr-border px-3 py-2 text-sm text-rr-heading placeholder:text-rr-muted focus:border-rr-red focus:ring-1 focus:ring-rr-red focus:outline-none"
				/>
			</div>
			<div class="sm:col-span-1">
				<label for="discount-code" class="block text-sm font-medium text-rr-body">Coupon code</label>
				<input
					id="discount-code"
					name="code"
					type="text"
					required
					placeholder="SPRING10"
					class="mt-1 block w-full rounded-sm border border-rr-border px-3 py-2 text-sm text-rr-heading uppercase placeholder:text-rr-muted focus:border-rr-red focus:ring-1 focus:ring-rr-red focus:outline-none"
				/>
			</div>
			<div class="sm:col-span-1">
				<label for="discount-type" class="block text-sm font-medium text-rr-body">Type</label>
				<div class="mt-1 grid grid-cols-1">
					<select
						id="discount-type"
						name="type"
						required
						class="col-start-1 row-start-1 w-full appearance-none rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm text-rr-heading focus:border-rr-red focus:ring-1 focus:ring-rr-red focus:outline-none"
					>
						<option value="percentage" selected>Percentage</option>
						<option value="fixed_amount">Fixed amount</option>
					</select>
					<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
						<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
					</svg>
				</div>
			</div>
			<div class="sm:col-span-1">
				<label for="discount-value" class="block text-sm font-medium text-rr-body">Value</label>
				<input
					id="discount-value"
					name="value"
					type="text"
					required
					placeholder="10 or 5.00"
					class="mt-1 block w-full rounded-sm border border-rr-border px-3 py-2 text-sm text-rr-heading placeholder:text-rr-muted focus:border-rr-red focus:ring-1 focus:ring-rr-red focus:outline-none"
				/>
				<p class="mt-1 text-xs text-rr-muted">Percent (10) or dollars (5.00)</p>
			</div>
			<div class="sm:col-span-1">
				<label for="discount-minimum" class="block text-sm font-medium text-rr-body">Min order $</label>
				<input
					id="discount-minimum"
					name="minimum_order"
					type="text"
					placeholder="Optional"
					class="mt-1 block w-full rounded-sm border border-rr-border px-3 py-2 text-sm text-rr-heading placeholder:text-rr-muted focus:border-rr-red focus:ring-1 focus:ring-rr-red focus:outline-none"
				/>
			</div>
			<div class="sm:col-span-1">
				<label for="discount-expires" class="block text-sm font-medium text-rr-body">Expires</label>
				<input
					id="discount-expires"
					name="expires_at"
					type="date"
					class="mt-1 block w-full rounded-sm border border-rr-border px-3 py-2 text-sm text-rr-heading focus:border-rr-red focus:ring-1 focus:ring-rr-red focus:outline-none"
				/>
				<p class="mt-1 text-xs text-rr-muted">Valid through end of day</p>
			</div>
			<div class="flex items-end">
				<button
					type="submit"
					class="inline-flex items-center rounded-sm bg-rr-red px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
				>
					Create Discount
				</button>
			</div>
		</form>
	</div>
	<!-- Filters -->
	<form method="get" action="/admin/discounts" class="mt-6 flex items-center gap-3">
		<div class="grid grid-cols-1">
			<select
				name="active"
				onchange="this.form.submit()"
				class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
			>
				<option value="">All discounts</option>
				<option value="true" selected?={ props.ActiveFilter == "true" }>Active</option>
				<option value="false" selected?={ props.ActiveFilter == "false" }>Inactive</option>
			</select>
			<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</div>
	</form>
	<!-- Discount table -->
	<div class="mt-6">
		if len(props.Discounts) == 0 {
			<div class="border border-dashed border-rr-border p-12 text-center">
				<svg class="mx-auto size-12 text-rr-border" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No discounts</h3>
				<p class="mt-1 text-sm text-rr-muted">Create your first discount above — customers redeem the code at checkout.</p>
			</div>
		} else {
			<div class="overflow-hidden border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Name</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Code</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Type</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Value</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">Dates</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">Created</th>
							<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
								<span class="sr-only">Actions</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, d := range props.Discounts {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/discounts/%s", d.ID.String())) } class="text-rr-red hover:text-rr-red-lt">{ d.Name }</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									for i, code := range props.Codes[d.ID] {
										if i > 0 {
											<span class="text-rr-border"> · </span>
										}
										if code.RedeemedAt != nil {
											<span class="font-mono text-rr-muted line-through" title={ "Redeemed " + code.RedeemedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }>{ code.Code }</span>
										} else {
											<span class="font-mono text-rr-heading">{ code.Code }</span>
										}
									}
									if len(props.Codes[d.ID]) == 0 {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">
									{ discountTypeLabel(d.Type) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-heading tabular-nums">
									{ discountValueDisplay(d) }
									if discountMinimumLabel(d) != "" {
										<span class="block text-xs font-normal text-rr-muted">{ discountMinimumLabel(d) }</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@DiscountActiveBadge(d.Active)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									if d.StartsAt != nil || d.ExpiresAt != nil {
										if d.StartsAt != nil {
											{ d.StartsAt.In(props.MerchantTZ).Format("Jan 2") }
										} else {
											<span class="text-rr-border">&mdash;</span>
										}
										<span class="text-rr-border"> &rarr; </span>
										if d.ExpiresAt != nil {
											{ d.ExpiresAt.In(props.MerchantTZ).Format("Jan 2") }
										} else {
											<span class="text-rr-border">&mdash;</span>
										}
									} else {
										<span class="text-rr-border">No dates</span>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted lg:table-cell">
									{ d.CreatedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
								</td>
								<td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
									if d.Active {
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/discounts/%s/deactivate", d.ID.String())) } class="inline">
											<button type="submit" class="text-rr-muted hover:text-rr-heading">Deactivate</button>
										</form>
									} else {
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/discounts/%s/activate", d.ID.String())) } class="inline">
											<button type="submit" class="text-rr-red hover:text-rr-red-lt">Activate</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/discounts?page=%d&active=%s", props.Page-1, props.ActiveFilter)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Previous
						</a>
					}
				</div>
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/discounts?page=%d&active=%s", props.Page+1, props.ActiveFilter)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

templ DiscountList(props DiscountListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Discounts",
		ActivePath: "/admin/discounts",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@DiscountListContent(props)
	}
}
