package admin

import (
	"fmt"
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// DiscountShowProps backs one discount's page — the view that answers "what
// does this code actually do, and has anyone used it?".
//
// Discounts had no detail page at all: they could be created and switched on or
// off from the list, and never inspected or corrected. A wrong minimum order
// meant deactivating the discount and issuing a new code.
type DiscountShowProps struct {
	Discount domain.Discount
	Codes    []domain.CouponCode
	// Redemptions are the most recent paid orders on a once-per-customer
	// discount, newest first; RedemptionCount is the full total. Both empty
	// for a single-use discount, whose codes carry their own redemption.
	Redemptions     []domain.CouponRedemption
	RedemptionCount int
	// Activity is the discount's audit history, newest first.
	Activity   []domain.AuditEntry
	Error      string
	MerchantTZ *time.Location
	StaffName  string
	StaffRole  string
}

// discountValueInput is the edit form's value field, pre-filled in whatever
// unit the discount's type is expressed in — whole percent, or dollars.
func discountValueInput(d domain.Discount) string {
	if d.Type == domain.DiscountTypeFixedAmount {
		return fmt.Sprintf("%.2f", float64(d.Value)/100)
	}
	return fmt.Sprintf("%d", d.Value)
}

// discountFormState seeds the edit form's Alpine state from the saved
// discount, so an existing 100%-off code shows its warning on load. Both
// values are generated here (an enum and a formatted number), never free text.
func discountFormState(d domain.Discount) string {
	return fmt.Sprintf("{ discountType: '%s', discountValue: '%s' }", d.Type, discountValueInput(d))
}

// discountDescriptionValue is the edit form's description contents, blank for
// nil. Kept as a Go expression on one line: templ would indent an if-block
// inside the element, and a textarea renders its leading whitespace verbatim.
func discountDescriptionValue(d domain.Discount) string {
	if d.Description == nil {
		return ""
	}
	return *d.Description
}

func discountDollarsInput(cents *int) string {
	if cents == nil || *cents <= 0 {
		return ""
	}
	return fmt.Sprintf("%.2f", float64(*cents)/100)
}

// discountDateInput formats a stored instant for a <input type="date">.
//
// ExpiresAt is stored as the start of the day *after* the last valid one (the
// code works through the end of the chosen day), so it is stepped back a day
// on the way into the field or the form would show tomorrow.
func discountDateInput(t *time.Time, loc *time.Location, isExclusiveEnd bool) string {
	if t == nil {
		return ""
	}
	v := t.In(loc)
	if isExclusiveEnd {
		v = v.AddDate(0, 0, -1)
	}
	return v.Format("2006-01-02")
}

// discountRedemptionSummary is the headline staff want: has this been used.
func discountRedemptionSummary(props DiscountShowProps) string {
	codes := props.Codes
	if props.Discount.UsageLimit == domain.CouponUsageOncePerCustomer {
		switch props.RedemptionCount {
		case 0:
			return "Not used yet. Each customer can use this code on one order."
		case 1:
			return "Used on 1 order. Each customer can use this code on one order."
		default:
			return fmt.Sprintf("Used on %d orders. Each customer can use this code on one order.", props.RedemptionCount)
		}
	}
	if len(codes) == 0 {
		return "No codes issued."
	}
	redeemed := 0
	for _, c := range codes {
		if c.RedeemedAt != nil {
			redeemed++
		}
	}
	switch {
	case redeemed == 0 && len(codes) == 1:
		return "Not yet redeemed."
	case redeemed == 0:
		return fmt.Sprintf("%d codes, none redeemed yet.", len(codes))
	case redeemed == len(codes):
		return fmt.Sprintf("All %d redeemed.", len(codes))
	default:
		return fmt.Sprintf("%d of %d redeemed.", redeemed, len(codes))
	}
}

templ DiscountShowContent(props DiscountShowProps) {
	@ConfirmDialogHost()
	<!-- Header -->
	<div class="sm:flex sm:items-start sm:justify-between sm:gap-6">
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-3">
				<h1 class="admin-page-title">{ props.Discount.Name }</h1>
				@DiscountActiveBadge(props.Discount.Active)
			</div>
			<p class="mt-2 text-sm text-rr-muted">
				{ discountTypeLabel(props.Discount.Type) }
				<span class="mx-1.5 text-rr-border">&middot;</span>
				<span class="text-rr-heading">{ discountValueDisplay(props.Discount) }</span>
				if discountMinimumLabel(props.Discount) != "" {
					<span class="mx-1.5 text-rr-border">&middot;</span>
					{ discountMinimumLabel(props.Discount) }
				}
				<span class="mx-1.5 text-rr-border">&middot;</span>
				{ discountUsageLabel(props.Discount.UsageLimit) }
				if discountEligibilityLabel(props.Discount.Eligibility) != "" {
					<span class="mx-1.5 text-rr-border">&middot;</span>
					{ discountEligibilityLabel(props.Discount.Eligibility) }
				}
				if discountAppliesToLabel(props.Discount.AppliesTo) != "" {
					<span class="mx-1.5 text-rr-border">&middot;</span>
					{ discountAppliesToLabel(props.Discount.AppliesTo) }
				}
				<span class="mx-1.5 text-rr-border">&middot;</span>
				Created { props.Discount.CreatedAt.In(props.MerchantTZ).Format("January 2, 2006") }
			</p>
		</div>
		<div class="mt-4 shrink-0 sm:mt-0">
			<a href="/admin/discounts" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">&larr; Back to discounts</a>
		</div>
	</div>
	if props.Error != "" {
		<div class="mt-6 border border-rr-border bg-rr-surface px-4 py-3">
			<p class="text-sm font-semibold text-rr-red">{ props.Error }</p>
		</div>
	}
	<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
		<div class="flex min-w-0 flex-col gap-6">
			@discountCodesTable(props)
			@DiscountActivity(props.Activity, props.MerchantTZ)
		</div>
		<aside class="flex flex-col gap-4 xl:sticky xl:top-6 xl:self-start">
			@discountEditCard(props)
			@discountStatusCard(props)
			@discountReferralCard(props)
			@discountBannerCard(props)
		</aside>
	</div>
}

templ discountCodesTable(props DiscountShowProps) {
	<div>
		<h2 class="text-sm font-semibold text-rr-heading">Coupon codes</h2>
		<p class="mt-1 text-sm text-rr-muted">{ discountRedemptionSummary(props) }</p>
		if props.Discount.UsageLimit == domain.CouponUsageOncePerCustomer {
			@discountSharedCodes(props)
		} else if len(props.Codes) > 0 {
			<div class="mt-2 overflow-x-auto border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Code</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Redeemed</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Order</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, c := range props.Codes {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 font-mono text-sm text-rr-heading sm:pl-6">{ c.Code }</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									if c.RedeemedAt != nil {
										<span class="badge badge-grey">redeemed</span>
									} else {
										<span class="badge badge-green">available</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">
									if c.RedeemedAt != nil {
										{ c.RedeemedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									if c.RedeemedByOrderID != nil {
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", c.RedeemedByOrderID.String())) } class="font-semibold text-rr-red hover:text-rr-red-lt">View order &rarr;</a>
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// discountSharedCodes lists a once-per-customer discount's codes and the
// orders that used it. Its codes are never spent, so the single-use table's
// status/redeemed/order columns would read "available" forever.
templ discountSharedCodes(props DiscountShowProps) {
	if props.Discount.IsReferral {
		<p class="mt-2 text-sm text-rr-heading">{ referralCodesSummary(props.Codes) }</p>
	} else {
		<p class="mt-2 text-sm text-rr-heading">
			for i, c := range props.Codes {
				if i > 0 {
					<span class="text-rr-border"> · </span>
				}
				<span class="font-mono">{ c.Code }</span>
			}
		</p>
	}
	if len(props.Redemptions) > 0 {
		<div class="mt-2 overflow-x-auto border border-rr-border bg-rr-surface">
			<table class="min-w-full divide-y divide-rr-border">
				<thead class="bg-rr-raised">
					<tr>
						<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Paid</th>
						<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Order</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-rr-border bg-rr-surface">
					for _, rd := range props.Redemptions {
						<tr>
							<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-rr-muted sm:pl-6">{ rd.RedeemedAt.In(props.MerchantTZ).Format("Jan 2, 2006 3:04 PM") }</td>
							<td class="whitespace-nowrap px-3 py-4 text-sm">
								<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", rd.OrderID.String())) } class="font-semibold text-rr-red hover:text-rr-red-lt">View order &rarr;</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if props.RedemptionCount > len(props.Redemptions) {
			<p class="mt-2 text-xs text-rr-muted">Showing the latest { fmt.Sprintf("%d", len(props.Redemptions)) } of { fmt.Sprintf("%d", props.RedemptionCount) }.</p>
		}
	}
}

// discountEditCard is the whole point of this page: every rule on a discount
// was write-once until now.
//
// The coupon code is not here. A code is the thing customers have already been
// handed, so changing it would silently break every link and card carrying it —
// a different code means a different discount.
templ discountEditCard(props DiscountShowProps) {
	@railCard("Edit") {
		<form
			method="post"
			action={ templ.SafeURL(fmt.Sprintf("/admin/discounts/%s", props.Discount.ID.String())) }
			class="flex flex-col gap-3"
			x-data={ discountFormState(props.Discount) }
		>
			<div>
				<label for="d-name" class="block text-xs text-rr-muted">Name</label>
				<input
					id="d-name"
					name="name"
					type="text"
					value={ props.Discount.Name }
					required
					class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
				/>
			</div>
			<div>
				<label for="d-description" class="block text-xs text-rr-muted">Description &mdash; staff note, not shown to customers</label>
				<textarea
					id="d-description"
					name="description"
					rows="2"
					placeholder="What this discount is for."
					class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
				>{ discountDescriptionValue(props.Discount) }</textarea>
			</div>
			<div>
				<label for="d-type" class="block text-xs text-rr-muted">Type</label>
				<select
					id="d-type"
					name="type"
					x-model="discountType"
					class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
				>
					<option value="percentage" selected?={ props.Discount.Type == domain.DiscountTypePercentage }>Percentage</option>
					<option value="fixed_amount" selected?={ props.Discount.Type == domain.DiscountTypeFixedAmount }>Fixed amount</option>
				</select>
			</div>
			<div>
				<label for="d-value" class="block text-xs text-rr-muted">Value &mdash; whole percent, or dollars</label>
				<input
					id="d-value"
					name="value"
					type="text"
					inputmode="decimal"
					value={ discountValueInput(props.Discount) }
					x-model="discountValue"
					required
					class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
				/>
			</div>
			@FullDiscountWarning("")
			<div>
				<label for="d-eligibility" class="block text-xs text-rr-muted">Who can use it</label>
				<select
					id="d-eligibility"
					name="eligibility"
					class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
				>
					<option value="anyone" selected?={ props.Discount.Eligibility == domain.DiscountEligibilityAnyone }>Anyone</option>
					<option value="subscribers" selected?={ props.Discount.Eligibility == domain.DiscountEligibilitySubscribers }>Daily Grind members only</option>
					<option value="new_subscribers" selected?={ props.Discount.Eligibility == domain.DiscountEligibilityNewSubscribers }>New subscribers only</option>
				</select>
			</div>
			if props.Discount.IsReferral {
				<!-- The referral offer's order type is fixed: members' cards promise
				     their friends a first subscription order. -->
				<div>
					<p class="block text-xs text-rr-muted">Order type</p>
					<p class="mt-1 text-sm text-rr-heading">First subscription order</p>
					<p class="text-xs text-rr-muted">Fixed while this is the referral offer.</p>
					<input type="hidden" name="applies_to" value="subscription_signup"/>
				</div>
			} else {
				<div>
					<label for="d-applies-to" class="block text-xs text-rr-muted">Order type</label>
					<select
						id="d-applies-to"
						name="applies_to"
						class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
					>
						<option value="one_time" selected?={ props.Discount.AppliesTo != domain.DiscountAppliesToSubscriptionSignup }>One-time orders</option>
						<option value="subscription_signup" selected?={ props.Discount.AppliesTo == domain.DiscountAppliesToSubscriptionSignup }>First subscription order</option>
					</select>
				</div>
			}
			<div>
				<label for="d-min" class="block text-xs text-rr-muted">Minimum order &mdash; blank for none</label>
				<input
					id="d-min"
					name="minimum_order"
					type="text"
					inputmode="decimal"
					value={ discountDollarsInput(props.Discount.MinimumOrderCents) }
					placeholder="No minimum"
					class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
				/>
			</div>
			<div>
				<label for="d-starts" class="block text-xs text-rr-muted">Starts</label>
				<input
					id="d-starts"
					name="starts_at"
					type="date"
					value={ discountDateInput(props.Discount.StartsAt, props.MerchantTZ, false) }
					class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
				/>
			</div>
			<div>
				<label for="d-expires" class="block text-xs text-rr-muted">Last valid day</label>
				<input
					id="d-expires"
					name="expires_at"
					type="date"
					value={ discountDateInput(props.Discount.ExpiresAt, props.MerchantTZ, true) }
					class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
				/>
			</div>
			@ActionWrap("hint-discount-save", "Changes what future customers get. Orders already placed keep the discount they were given.") {
				<button
					type="submit"
					aria-describedby="hint-discount-save"
					class="inline-flex w-full items-center justify-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
				>
					Save changes
				</button>
			}
		</form>
	}
}

templ discountStatusCard(props DiscountShowProps) {
	@railCard("Status") {
		<div class="flex flex-col gap-2">
			if props.Discount.Active {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/discounts/%s/deactivate", props.Discount.ID.String())) }>
					<input type="hidden" name="return_to" value="detail"/>
					@ActionWrap("hint-discount-deactivate", "Stops new customers applying any of this discount's codes. Codes already redeemed are unaffected.") {
						<button
							type="submit"
							aria-describedby="hint-discount-deactivate"
							class="btn-danger w-full justify-center"
							{ ConfirmAttrs(ActionConfirm{
							Title: "Deactivate this discount?",
							Lead:  "Stops new customers applying any of its coupon codes.",
							Points: []string{
								"Carts already holding the code lose the discount at payment.",
								"Orders already placed keep what they were given.",
								"You can reactivate it again from here.",
							},
							Confirm: "Deactivate",
							Danger:  true,
						})... }
						>Deactivate</button>
					}
				</form>
			} else {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/discounts/%s/activate", props.Discount.ID.String())) }>
					<input type="hidden" name="return_to" value="detail"/>
					@ActionWrap("hint-discount-activate", "Lets customers apply this discount's codes again.") {
						<button type="submit" aria-describedby="hint-discount-activate" class="btn-confirm w-full justify-center">Activate</button>
					}
				</form>
			}
		</div>
	}
}

templ DiscountShow(props DiscountShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      props.Discount.Name,
		ActivePath: "/admin/discounts",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@DiscountShowContent(props)
	}
}

// referralCodesSummary stands in for the code list on the referral offer,
// which carries one code per member — too many to print, and none of them the
// discount's own business to show.
func referralCodesSummary(codes []domain.CouponCode) string {
	members := 0
	for _, c := range codes {
		if c.CustomerID != nil {
			members++
		}
	}
	noun := "codes"
	if members == 1 {
		noun = "code"
	}
	return fmt.Sprintf("%d member %s. Each active member gets their own on their account page. The code typed when this discount was created can't be used on its own.", members, noun)
}

// discountReferralCard makes a discount the referral offer, or stops it being
// one. Only a once-per-customer discount qualifies: a member's code goes to
// many friends.
templ discountReferralCard(props DiscountShowProps) {
	@railCard("Referral offer") {
		<div class="flex flex-col gap-2">
			if props.Discount.IsReferral {
				<p class="text-sm text-rr-body">This is the referral offer. Members share their own codes on it, and each friend's paid first order earns the member a free bag. <a href="/admin/referrals" class="font-semibold text-rr-red hover:text-rr-red-lt">Bags owed &rarr;</a></p>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/discounts/%s/referral/clear", props.Discount.ID.String())) }>
					<button
						type="submit"
						class="btn-danger w-full justify-center"
						{ ConfirmAttrs(ActionConfirm{
							Title:   "Stop using this as the referral offer?",
							Lead:    "Members' codes stop working and their account pages stop showing a code.",
							Points:  []string{"Bags already earned stay on the Referrals page.", "You can make it the referral offer again from here."},
							Confirm: "Stop",
							Danger:  true,
						})... }
					>Stop using as referral offer</button>
				</form>
			} else if problems := referralOfferProblems(props.Discount); len(problems) > 0 {
				<p class="text-sm text-rr-muted">This discount can't be the referral offer. It needs to be:</p>
				<ul class="list-disc pl-5 text-sm text-rr-muted">
					for _, p := range problems {
						<li>{ p }</li>
					}
				</ul>
			} else {
				<p class="text-sm text-rr-muted">Gives every active member their own code on this discount to share with friends.</p>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/discounts/%s/referral", props.Discount.ID.String())) }>
					@ActionWrap("hint-discount-referral", "Replaces the current referral offer, if there is one.") {
						<button
							type="submit"
							aria-describedby="hint-discount-referral"
							class="btn-confirm w-full justify-center"
							{ ConfirmAttrs(ActionConfirm{
								Title:   "Make this the referral offer?",
								Lead:    "Every active member gets their own code on this discount.",
								Points:  referralOfferConfirmPoints(props.Codes),
								Confirm: "Make it the referral offer",
							})... }
						>Use as the referral offer</button>
					}
				</form>
			}
		</div>
	}
}

// referralOfferProblems lists what a discount lacks to be the referral offer,
// in the order DiscountService.SetReferralOffer checks it. Empty when it
// qualifies.
func referralOfferProblems(d domain.Discount) []string {
	var out []string
	if d.UsageLimit != domain.CouponUsageOncePerCustomer {
		out = append(out, "Once per customer (set when created)")
	}
	if d.AppliesTo != domain.DiscountAppliesToSubscriptionSignup {
		out = append(out, "For the first subscription order (Order type)")
	}
	if d.Type != domain.DiscountTypePercentage && d.Type != domain.DiscountTypeFixedAmount {
		out = append(out, "A percentage or a fixed amount off")
	}
	return out
}

// referralOfferConfirmPoints warns that the discount's own codes stop working:
// the referral offer only answers to members' codes. A public code already
// handed out (WELCOME50) is exactly what this would break, so it is named.
func referralOfferConfirmPoints(codes []domain.CouponCode) []string {
	var own []string
	for _, c := range codes {
		if c.CustomerID == nil {
			own = append(own, c.Code)
		}
	}
	points := []string{"Replaces the current referral offer, if there is one."}
	if len(own) > 0 {
		points = append(points, fmt.Sprintf("Its own code (%s) stops working. Only members' codes work on a referral offer. If you've shared %s publicly, use a separate discount instead.", strings.Join(own, ", "), own[0]))
	}
	return points
}

// discountBannerCard edits the line that promotes this discount in the
// storefront's offer strip, above the header on every page.
templ discountBannerCard(props DiscountShowProps) {
	@railCard("Site banner") {
		<form
			method="post"
			action={ templ.SafeURL(fmt.Sprintf("/admin/discounts/%s/banner", props.Discount.ID.String())) }
			class="flex flex-col gap-2"
		>
			<label for="d-banner" class="block text-xs text-rr-muted">Banner line &mdash; shown to customers</label>
			<input
				id="d-banner"
				name="banner_text"
				type="text"
				maxlength={ fmt.Sprint(domain.MaxBannerTextLen) }
				value={ props.Discount.BannerText }
				placeholder="Holiday gift: 20% off with code GIFT20"
				aria-describedby="hint-discount-banner"
				class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
			/>
			<p id="hint-discount-banner" class="text-xs text-rr-muted">
				{ discountBannerAudience(props.Discount) } Include the code in the line. It shows only while the discount is active and within its dates. Leave it empty to stop showing it.
			</p>
			<button type="submit" class="btn-confirm w-full justify-center">Save banner</button>
		</form>
	}
}

// discountBannerAudience says who sees the banner, by the same rules as
// DiscountService.StorefrontBanners, and where the line links.
func discountBannerAudience(d domain.Discount) string {
	switch {
	case d.IsReferral:
		return "Seen by signed-in Daily Grind members, linking to their subscriptions page where their own code is."
	case d.Eligibility == domain.DiscountEligibilitySubscribers:
		return "Seen by signed-in Daily Grind members only, linking to the shop."
	case d.Eligibility == domain.DiscountEligibilityNewSubscribers:
		return "Seen by everyone except signed-in customers who have subscribed before, linking to the Daily Grind page."
	case d.AppliesTo == domain.DiscountAppliesToSubscriptionSignup:
		return "Seen by everyone, linking to the Daily Grind page."
	default:
		return "Seen by everyone, linking to the shop."
	}
}
