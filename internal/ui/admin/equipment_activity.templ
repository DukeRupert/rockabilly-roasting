package admin

import (
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/audit"
)

func equipmentEventLabel(action string) string {
	switch action {
	case audit.AuditEquipmentCreated:
		return "Added to the register"
	case audit.AuditEquipmentUpdated:
		return "Details edited"
	case audit.AuditEquipmentSentToShop:
		return "Taken to the shop"
	case audit.AuditEquipmentReturnedToService:
		return "Back in service"
	case audit.AuditEquipmentRetired:
		return "Retired"
	}
	parts := strings.SplitN(action, ".", 2)
	if len(parts) == 2 {
		verb := strings.ReplaceAll(parts[1], "_", " ")
		return strings.ToUpper(verb[:1]) + verb[1:]
	}
	return action
}

func equipmentEventMarker(action string) string {
	switch action {
	case audit.AuditEquipmentRetired:
		return "bg-rr-red"
	case audit.AuditEquipmentSentToShop:
		return "bg-rr-amber"
	default:
		return "bg-rr-surface"
	}
}

// EquipmentActivity is the machine's history — added, edited, taken away, put
// back, retired.
//
// Edits are the entries that earn this: a serial corrected or an ownership
// flipped from loaner to customer-owned changes who pays for the next repair,
// and without the timeline there is nothing to attribute that to.
templ EquipmentActivity(entries []domain.AuditEntry, loc *time.Location) {
	@ActivityTimeline(entries, equipmentEventLabel, equipmentEventMarker, loc)
}
