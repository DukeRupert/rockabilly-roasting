package admin

// Flash is the one-shot message a page shows after a redirect.
//
// It carries whether it went wrong, because every admin page used to render
// every flash in the same green success panel — "Invalid flat rate" and
// "Settings saved" were visually identical, so a rejected save read as a
// successful one and staff walked away from an unsaved form.
type Flash struct {
	Message string
	Error   bool
}

func (f Flash) shown() bool { return f.Message != "" }

func (f Flash) classes() string {
	if f.Error {
		return "mt-4 rounded-sm badge-red p-4"
	}
	return "mt-4 rounded-sm badge-green p-4"
}

// role is alert for a rejection and status for a success. A screen reader has
// to interrupt for "nothing was saved" — the staffer is about to walk away from
// an unsaved form — and must not for "saved".
func (f Flash) role() string {
	if f.Error {
		return "alert"
	}
	return "status"
}

// adminFlash renders the message, with an icon that says which kind it is
// before the words are read — a tick for saved, a warning for rejected.
templ adminFlash(f Flash) {
	if f.shown() {
		<div class={ f.classes() } role={ f.role() }>
			<div class="flex">
				<div class="flex-shrink-0">
					if f.Error {
						<svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"></path>
						</svg>
					} else {
						<svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
						</svg>
					}
				</div>
				<div class="ml-3">
					<p class="text-sm font-medium">{ f.Message }</p>
				</div>
			</div>
		</div>
	}
}
