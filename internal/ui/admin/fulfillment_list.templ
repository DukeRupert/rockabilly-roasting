package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type FulfillmentListProps struct {
	Orders       []domain.Order
	StatusFilter string
	Page         int
	PerPage      int
	HasMore      bool
	StaffName    string
	StaffRole    string
}

templ FulfillmentListContent(props FulfillmentListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="text-base/7 font-semibold text-stone-900">Fulfillment</h1>
			<p class="mt-1 text-sm text-stone-500">Orders requiring fulfillment and shipping</p>
		</div>
	</div>
	<!-- Filters -->
	<form method="get" action="/admin/fulfillment" class="mt-6 flex items-center gap-3">
		<div class="grid grid-cols-1">
			<select
				name="status"
				onchange="this.form.submit()"
				class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pl-3 pr-8 text-sm text-stone-900 outline-1 -outline-offset-1 outline-stone-300 focus:outline-2 focus:-outline-offset-2 focus:outline-hiri-teal"
			>
				<option value="">All statuses</option>
				<option value="unfulfilled" selected?={ props.StatusFilter == "unfulfilled" }>Unfulfilled</option>
				<option value="partially_fulfilled" selected?={ props.StatusFilter == "partially_fulfilled" }>Partially Fulfilled</option>
				<option value="fulfilled" selected?={ props.StatusFilter == "fulfilled" }>Fulfilled</option>
				<option value="shipped" selected?={ props.StatusFilter == "shipped" }>Shipped</option>
				<option value="delivered" selected?={ props.StatusFilter == "delivered" }>Delivered</option>
			</select>
			<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-stone-500 sm:size-4" viewBox="0 0 16 16" fill="currentColor">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</div>
	</form>
	<!-- Order table -->
	<div class="mt-6">
		if len(props.Orders) == 0 {
			<div class="rounded-lg border-2 border-dashed border-stone-300 p-12 text-center">
				<svg class="mx-auto size-12 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25m-2.25 0h-2.25m0 0V6A2.25 2.25 0 0 1 12 3.75h4.5A2.25 2.25 0 0 1 18.75 6v3.75m-13.5 0h13.5"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-stone-900">No orders to fulfill</h3>
				<p class="mt-1 text-sm text-stone-500">Orders needing fulfillment will appear here.</p>
			</div>
		} else {
			<div class="overflow-hidden rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
				<table class="min-w-full divide-y divide-stone-300">
					<thead class="bg-stone-50">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-stone-900 sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Order Status</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Fulfillment</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-stone-900">Total</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-stone-900 lg:table-cell">Date</th>
							<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
								<span class="sr-only">View</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-200 bg-white">
						for _, o := range props.Orders {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) } class="font-medium text-stone-900 hover:text-hiri-teal">
										{ o.Number }
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@OrderStatusBadge(o.Status)
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@FulfillmentStatusBadge(o.FulfillmentStatus)
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-stone-900 text-right tabular-nums">
									{ formatCents(o.Total) }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-stone-500 lg:table-cell">
									{ o.PlacedAt.Format("Jan 2, 2006") }
								</td>
								<td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) } class="text-hiri-teal hover:text-hiri-teal-dark">
										View<span class="sr-only">, { o.Number }</span>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-stone-200 px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/fulfillment?page=%d&status=%s", props.Page-1, props.StatusFilter)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Previous
						</a>
					}
				</div>
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/fulfillment?page=%d&status=%s", props.Page+1, props.StatusFilter)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

templ FulfillmentList(props FulfillmentListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Fulfillment",
		ActivePath: "/admin/fulfillment",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@FulfillmentListContent(props)
	}
}
