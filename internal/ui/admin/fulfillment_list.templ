package admin

import (
	"fmt"
	"net/url"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type FulfillmentListProps struct {
	Orders     []domain.Order
	Filter     string
	TotalCount int
	Page       int
	PerPage    int
	HasMore    bool
	MerchantTZ *time.Location
	StaffName  string
	StaffRole  string
}

func (p FulfillmentListProps) showingStart() int {
	if p.TotalCount == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p FulfillmentListProps) showingEnd() int {
	end := p.Page * p.PerPage
	if end > p.TotalCount {
		return p.TotalCount
	}
	return end
}

func fulfillmentTabHref(filter string) string {
	if filter == "" || filter == "needs_action" {
		return "/admin/fulfillment"
	}
	return "/admin/fulfillment?filter=" + url.QueryEscape(filter)
}

func fulfillmentTabClass(current, tab string) string {
	active := current == tab || (tab == "needs_action" && (current == "" || current == "needs_action"))
	return orderTabClass(active)
}

templ FulfillmentListContent(props FulfillmentListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Fulfillment</h1>
			<p class="mt-1 text-sm text-rr-muted">Pack and ship orders</p>
		</div>
	</div>
	<!-- Tab filters -->
	<div class="mt-6">
		<nav class="flex gap-0 border-b-2 border-rr-border -mb-px overflow-x-auto">
			<a href={ templ.SafeURL(fulfillmentTabHref("needs_action")) } class={ fulfillmentTabClass(props.Filter, "needs_action") }>Needs Action</a>
			<a href={ templ.SafeURL(fulfillmentTabHref("unfulfilled")) } class={ fulfillmentTabClass(props.Filter, "unfulfilled") }>Unfulfilled</a>
			<a href={ templ.SafeURL(fulfillmentTabHref("ready_to_ship")) } class={ fulfillmentTabClass(props.Filter, "ready_to_ship") }>Ready to Ship</a>
			<a href={ templ.SafeURL(fulfillmentTabHref("shipped")) } class={ fulfillmentTabClass(props.Filter, "shipped") }>Shipped</a>
			<a href={ templ.SafeURL(fulfillmentTabHref("delivered")) } class={ fulfillmentTabClass(props.Filter, "delivered") }>Delivered</a>
			<a href={ templ.SafeURL(fulfillmentTabHref("all")) } class={ fulfillmentTabClass(props.Filter, "all") }>All</a>
		</nav>
	</div>
	<!-- Fulfillment table -->
	<div class="mt-4">
		if len(props.Orders) == 0 {
			<div class="border-2 border-dashed border-rr-border p-12 text-center">
				<svg class="mx-auto size-12 text-rr-teal" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">All caught up</h3>
				<p class="mt-1 text-sm text-rr-muted">No orders need fulfillment right now.</p>
			</div>
		} else {
			<div class="overflow-hidden border-2 border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Fulfillment</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">Placed</th>
							<th scope="col" class="hidden relative py-3.5 pl-3 pr-4 sm:table-cell sm:pr-6">
								<span class="sr-only">View</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, o := range props.Orders {
							<tr class="row-link">
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) } class="row-link-target font-medium text-rr-heading hover:text-rr-red">
										{ o.Number }
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@FulfillmentStatusBadge(o.FulfillmentStatus)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted lg:table-cell">
									{ o.PlacedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
								</td>
								<td class="hidden whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:table-cell sm:pr-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) } class="text-rr-red hover:text-rr-red-lt">
										View<span class="sr-only">, { o.Number }</span>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t-2 border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/fulfillment?page=%d&filter=%s", props.Page-1, props.Filter)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border-2 border-rr-border hover:bg-rr-raised"
						>
							Previous
						</a>
					}
				</div>
				if props.TotalCount > 0 {
					<p class="text-sm text-rr-muted">
						<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingStart()) }</span>–<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingEnd()) }</span> of <span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.TotalCount) }</span>
					</p>
				}
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/fulfillment?page=%d&filter=%s", props.Page+1, props.Filter)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border-2 border-rr-border hover:bg-rr-raised"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

templ FulfillmentList(props FulfillmentListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Fulfillment",
		ActivePath: "/admin/fulfillment",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@FulfillmentListContent(props)
	}
}
