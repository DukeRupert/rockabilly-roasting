package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type GroupListProps struct {
	Groups    []domain.CustomerGroup
	StaffName string
	StaffRole string
}

templ GroupListContent(props GroupListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="text-base/7 font-semibold text-rr-heading">Customer Groups</h1>
			<p class="mt-1 text-sm text-rr-muted">Manage pricing groups for customers. Assign group-specific prices to variants.</p>
		</div>
		<div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
			<a
				href="/admin/groups/prices"
				class="block rounded-sm bg-rr-red px-3 py-2 text-center text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
			>
				Manage prices
			</a>
		</div>
	</div>
	<!-- Create form -->
	<div class="mt-6">
		<form method="post" action="/admin/groups" class="flex items-end gap-3">
			<div class="flex-1 max-w-sm">
				<label for="name" class="block text-sm/6 font-medium text-rr-heading">New group</label>
				<div class="mt-2">
					<input
						type="text"
						name="name"
						id="name"
						required
						placeholder="e.g. Wholesale Tier 1"
						class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"
					/>
				</div>
			</div>
			<button
				type="submit"
				class="rounded-sm bg-rr-red px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
			>
				Create group
			</button>
		</form>
	</div>
	<!-- Groups table -->
	<div class="mt-8">
		if len(props.Groups) == 0 {
			<div class="rounded-sm border-2 border-dashed border-rr-border p-12 text-center">
				<svg class="mx-auto size-12 text-rr-border" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No customer groups</h3>
				<p class="mt-1 text-sm text-rr-muted">Create a group to start assigning customers and setting group-specific prices.</p>
			</div>
		} else {
			<div class="overflow-hidden rounded-sm bg-rr-surface shadow-xs ring-1 ring-rr-border">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Name</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">ID</th>
							<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
								<span class="sr-only">Actions</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, g := range props.Groups {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-rr-heading sm:pl-6">
									{ g.Name }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted font-mono">
									{ g.ID.String() }
								</td>
								<td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/groups/%s/delete", g.ID)) }>
										<button type="submit" class="text-rr-red hover:text-rr-red-lt" onclick="return confirm('Delete this group? Customers will be removed from it.')">Delete</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ GroupList(props GroupListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Customer Groups",
		ActivePath: "/admin/groups",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@GroupListContent(props)
	}
}
