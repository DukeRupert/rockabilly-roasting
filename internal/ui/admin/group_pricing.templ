package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
	"github.com/google/uuid"
)

type GroupPricingProps struct {
	Products  []ProductPricingGroup
	Groups    []domain.CustomerGroup
	StaffName string
	StaffRole string
}

type ProductPricingGroup struct {
	Product  domain.Product
	Variants []VariantPricing
}

type VariantPricing struct {
	Variant     domain.Variant
	PriceCents  *int
	GroupPrices map[uuid.UUID]int
}

templ GroupPricingContent(props GroupPricingProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Group Pricing</h1>
			<p class="mt-1 text-sm text-rr-muted">
				Edit base and group prices, then save each product in one go.
				if len(props.Groups) == 0 {
					<a href="/admin/groups" class="text-rr-red hover:text-rr-red-lt">Create customer groups</a> to enable group pricing.
				}
			</p>
		</div>
		<div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
			<a
				href="/admin/groups"
				class="block rounded-sm bg-rr-surface px-3 py-2 text-center text-sm font-semibold text-rr-heading shadow-xs border border-rr-border hover:bg-rr-raised"
			>
				Manage groups
			</a>
		</div>
	</div>
	if len(props.Products) == 0 {
		<div class="mt-8 border border-dashed border-rr-border p-12 text-center">
			<h3 class="mt-2 text-sm font-semibold text-rr-heading">No products with variants</h3>
			<p class="mt-1 text-sm text-rr-muted">Create products and add variants to start setting prices.</p>
		</div>
	} else {
		<div class="mt-8 space-y-10">
			for _, pg := range props.Products {
				if len(pg.Variants) > 0 {
					<!-- One form per product: base + all group prices save together -->
					<form
						method="post"
						action={ templ.SafeURL("/admin/groups/prices/bulk") }
						hx-post="/admin/groups/prices/bulk"
						hx-target="#pricing-content"
						hx-swap="innerHTML"
					>
						<!-- Product heading -->
						<div class="flex items-center justify-between mb-4">
							<h2 class="text-sm font-semibold text-rr-heading">{ pg.Product.Title }</h2>
							<div class="flex items-center gap-4">
								<a
									href={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s", pg.Product.ID)) }
									class="text-xs text-rr-red hover:text-rr-red-lt"
								>
									Edit product
								</a>
								<button
									type="submit"
									class="rounded-sm bg-rr-red px-3 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt"
								>
									Save changes
								</button>
							</div>
						</div>
						<!-- Stacked price tables: base + one per group -->
						<div class="space-y-4">
							<!-- Base Prices -->
							@pricingCard("Base Prices", pg, nil)
							<!-- Group Prices -->
							for _, g := range props.Groups {
								@pricingCard(g.Name+" Prices", pg, &g)
							}
						</div>
					</form>
				}
			}
		</div>
	}
}

templ pricingCard(title string, pg ProductPricingGroup, group *domain.CustomerGroup) {
	<div class="overflow-hidden border border-rr-border bg-rr-surface">
		<div class="border-b border-rr-border bg-rr-raised px-4 py-2.5 sm:px-6">
			if group != nil {
				<h3 class="text-sm font-medium text-rr-teal">{ title }</h3>
			} else {
				<h3 class="text-sm font-medium text-rr-body">{ title }</h3>
			}
		</div>
		<table class="min-w-full divide-y divide-rr-border">
			<thead class="bg-rr-raised">
				<tr>
					<th scope="col" class="py-2.5 pl-4 pr-3 text-left text-xs font-semibold text-rr-heading sm:pl-6">SKU</th>
					<th scope="col" class="px-3 py-2.5 text-left text-xs font-semibold text-rr-heading">Unit Price</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-rr-border bg-rr-surface">
				for _, vp := range pg.Variants {
					<tr>
						<td class="whitespace-nowrap py-2.5 pl-4 pr-3 text-sm sm:pl-6">
							<span class="font-mono font-medium text-rr-heading">{ vp.Variant.SKU }</span>
							if vp.Variant.IsDefault {
								<span class="badge badge-green ml-1.5">Default</span>
							}
						</td>
						<td class="whitespace-nowrap px-3 py-2.5 text-sm">
							<div class="flex items-center gap-1">
								<span class="text-rr-muted">$</span>
								if group == nil {
									<!-- Base price input -->
									<input
										type="number"
										name={ "base:" + vp.Variant.ID.String() }
										step="0.01"
										min="0"
										placeholder="0.00"
										if vp.PriceCents != nil {
											value={ priceToDollars(*vp.PriceCents) }
										}
										class="w-24 rounded-sm border-0 py-1 px-2 text-sm text-rr-heading border border-rr-border placeholder:text-rr-muted focus:ring-2 focus:ring-inset focus:ring-rr-red"
									/>
									<input type="hidden" name={ "base_prev:" + vp.Variant.ID.String() } value={ priceToDollarsPtr(vp.PriceCents) }/>
								} else {
									<!-- Group price input -->
									<input
										type="number"
										name={ "group:" + group.ID.String() + ":" + vp.Variant.ID.String() }
										step="0.01"
										min="0"
										placeholder="0.00"
										if cents, ok := vp.GroupPrices[group.ID]; ok {
											value={ priceToDollars(cents) }
										}
										class="w-24 rounded-sm border-0 py-1 px-2 text-sm text-rr-heading border border-rr-border placeholder:text-rr-muted focus:ring-2 focus:ring-inset focus:ring-rr-red"
									/>
									<input type="hidden" name={ "group_prev:" + group.ID.String() + ":" + vp.Variant.ID.String() } value={ groupPriceDollars(vp.GroupPrices, group.ID) }/>
								}
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ GroupPricing(props GroupPricingProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Group Pricing",
		ActivePath: "/admin/groups",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		<div id="pricing-content">
			@GroupPricingContent(props)
		</div>
	}
}

// priceToDollarsPtr renders a nil-able cents pointer as a dollar string, or "" when unset.
func priceToDollarsPtr(cents *int) string {
	if cents == nil {
		return ""
	}
	return priceToDollars(*cents)
}

// groupPriceDollars renders the group price for a group ID as a dollar string, or "" when unset.
func groupPriceDollars(prices map[uuid.UUID]int, groupID uuid.UUID) string {
	if cents, ok := prices[groupID]; ok {
		return priceToDollars(cents)
	}
	return ""
}
