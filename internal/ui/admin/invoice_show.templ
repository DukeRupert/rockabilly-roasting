package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type InvoiceShowProps struct {
	Invoice   *domain.Invoice
	Lines     []domain.InvoiceLine
	Payments  []domain.InvoicePayment
	StaffName string
	StaffRole string
}

func canSendInvoice(inv *domain.Invoice) bool {
	return inv.Status == domain.InvoiceStatusDraft
}

func canRecordPayment(inv *domain.Invoice) bool {
	return inv.Status == domain.InvoiceStatusSent || inv.Status == domain.InvoiceStatusPartiallyPaid
}

func canVoidInvoice(inv *domain.Invoice) bool {
	return inv.Status == domain.InvoiceStatusDraft || inv.Status == domain.InvoiceStatusSent
}

templ InvoiceShowContent(props InvoiceShowProps) {
	<!-- Header -->
	<div class="sm:flex sm:items-center sm:justify-between">
		<div>
			<div class="flex items-center gap-3">
				<h1 class="text-lg font-bold text-rr-heading">Invoice { props.Invoice.Number }</h1>
				@InvoiceStatusBadge(props.Invoice.Status)
			</div>
			<p class="mt-1 text-sm text-rr-muted">
				Created { props.Invoice.CreatedAt.Format("January 2, 2006") }
				if props.Invoice.DueDate != nil {
					 — Due { props.Invoice.DueDate.Format("January 2, 2006") }
				}
			</p>
		</div>
		<div class="mt-4 flex items-center gap-3 sm:mt-0">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", props.Invoice.OrderID.String())) }
				class="text-sm font-semibold text-rr-red hover:text-rr-red-lt"
			>
				&larr; Back to order
			</a>
		</div>
	</div>
	<!-- Actions -->
	<div class="mt-6 flex flex-wrap gap-3">
		if canSendInvoice(props.Invoice) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/invoices/%s/send", props.Invoice.ID.String())) }>
				<button
					type="submit"
					class="inline-flex items-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
				>
					Send Invoice
				</button>
			</form>
		}
		if canVoidInvoice(props.Invoice) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/invoices/%s/void", props.Invoice.ID.String())) }>
				<button
					type="submit"
					class="btn-danger"
					onclick="return confirm('Void this invoice? This cannot be undone.')"
				>
					Void Invoice
				</button>
			</form>
		}
	</div>
	<!-- Summary cards -->
	<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Subtotal</dt>
			<dd class="mt-1 text-lg font-semibold text-rr-heading tabular-nums">{ formatCents(props.Invoice.Subtotal) }</dd>
		</div>
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Total</dt>
			<dd class="mt-1 text-lg font-semibold text-rr-heading tabular-nums">{ formatCents(props.Invoice.Total) }</dd>
		</div>
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Paid</dt>
			<dd class="mt-1 text-lg font-semibold text-rr-teal tabular-nums">{ formatCents(props.Invoice.AmountPaid) }</dd>
		</div>
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Amount Due</dt>
			<dd class="mt-1 text-lg font-semibold text-rr-heading tabular-nums">{ formatCents(props.Invoice.AmountDue) }</dd>
		</div>
	</div>
	<!-- Notes -->
	if props.Invoice.Notes != nil && *props.Invoice.Notes != "" {
		<div class="mt-6 rounded-sm bg-rr-raised p-4 ring-1 ring-rr-border">
			<p class="text-sm text-rr-body">
				<span class="font-medium">Notes:</span> { *props.Invoice.Notes }
			</p>
		</div>
	}
	<!-- Line items -->
	<div class="mt-8">
		<h2 class="text-sm font-semibold text-rr-heading">Line items</h2>
		if len(props.Lines) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No line items.</p>
		} else {
			<div class="mt-2 overflow-hidden rounded-sm bg-rr-surface shadow-xs ring-1 ring-rr-border">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Description</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Qty</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Unit Price</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Total</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, line := range props.Lines {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-rr-heading sm:pl-6">
									{ line.Description }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted text-right tabular-nums">
									{ fmt.Sprintf("%d", line.Quantity) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted text-right tabular-nums">
									{ formatCents(line.UnitPrice) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-heading text-right tabular-nums font-medium">
									{ formatCents(line.Total) }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
	<!-- Payments -->
	<div class="mt-8">
		<h2 class="text-sm font-semibold text-rr-heading">Payments</h2>
		if len(props.Payments) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No payments recorded.</p>
		} else {
			<div class="mt-2 overflow-hidden rounded-sm bg-rr-surface shadow-xs ring-1 ring-rr-border">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Date</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Method</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">Reference</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Amount</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, p := range props.Payments {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-rr-muted sm:pl-6">
									{ p.PaidAt.Format("Jan 2, 2006") }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">
									{ string(p.Method) }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									if p.Reference != nil {
										{ *p.Reference }
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-heading text-right tabular-nums font-medium">
									{ formatCents(p.Amount) }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<!-- Record payment form -->
		if canRecordPayment(props.Invoice) {
			<div class="mt-4 rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
				<h3 class="text-sm font-semibold text-rr-heading">Record Payment</h3>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/invoices/%s/payment", props.Invoice.ID.String())) } class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-4">
					<div>
						<label for="amount" class="block text-sm font-medium text-rr-body">Amount (cents)</label>
						<input
							type="number"
							name="amount"
							id="amount"
							min="1"
							required
							class="mt-1 block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
							placeholder={ fmt.Sprintf("%d", props.Invoice.AmountDue) }
						/>
					</div>
					<div>
						<label for="method" class="block text-sm font-medium text-rr-body">Method</label>
						<select name="method" id="method" required class="mt-1 block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red">
							<option value="check">Check</option>
							<option value="ach">ACH</option>
							<option value="stripe">Stripe</option>
							<option value="cash">Cash</option>
							<option value="other">Other</option>
						</select>
					</div>
					<div>
						<label for="reference" class="block text-sm font-medium text-rr-body">Reference</label>
						<input type="text" name="reference" id="reference" class="mt-1 block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red" placeholder="Check #, transaction ID"/>
					</div>
					<div class="flex items-end">
						<button
							type="submit"
							class="inline-flex items-center rounded-sm bg-rr-red px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
						>
							Record
						</button>
					</div>
				</form>
			</div>
		}
	</div>
}

templ InvoiceShow(props InvoiceShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      fmt.Sprintf("Invoice %s", props.Invoice.Number),
		ActivePath: "/admin/orders",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@InvoiceShowContent(props)
	}
}
