package admin

import (
	"fmt"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
)

type OrderInvoiceProps struct {
	Order           *domain.Order
	LineItems       []EnrichedLineItem
	Customer        *domain.Customer
	ShippingAddress *domain.Address
	BillingAddress  *domain.Address
	MerchantTZ      *time.Location
}

type OrderInvoiceBatchProps struct {
	Items []OrderInvoiceProps
}

func invoicePaymentLabel(s domain.PaymentStatus) string {
	switch s {
	case domain.PaymentStatusCaptured:
		return "Paid in full"
	case domain.PaymentStatusPartial, domain.PaymentStatusPartiallyPaid:
		return "Partially paid"
	case domain.PaymentStatusRefunded:
		return "Refunded"
	case domain.PaymentStatusPendingInvoice:
		return "Invoice pending"
	case domain.PaymentStatusInvoiced:
		return "Awaiting payment"
	case domain.PaymentStatusOverdue:
		return "Past due"
	case domain.PaymentStatusAuthorized:
		return "Authorized"
	case domain.PaymentStatusFailed:
		return "Payment failed"
	case domain.PaymentStatusVoided:
		return "Voided"
	case domain.PaymentStatusAwaiting:
		return "Awaiting payment"
	}
	return string(s)
}

func invoiceAmountDue(order *domain.Order) int {
	if order.PaymentStatus == domain.PaymentStatusCaptured || order.PaymentStatus == domain.PaymentStatusRefunded {
		return 0
	}
	return order.Total
}

templ orderInvoiceStyles() {
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }
		:root {
			--paper: #F6EFE1;
			--ink: #0E0D0C;
			--amber: #F2A03D;
			--rust: #B4351D;
			--muted: #6B6258;
			--rule: #0E0D0C;
		}
		body {
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
			font-size: 12px;
			line-height: 1.55;
			color: var(--ink);
			background: var(--paper);
			padding: 32px 36px;
		}
		.sheet { max-width: 780px; margin: 0 auto; }
		.sheet + .sheet { margin-top: 48px; padding-top: 48px; border-top: 2px dashed var(--muted); page-break-before: always; }

		.masthead {
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			border-bottom: 3px solid var(--ink);
			padding-bottom: 16px;
			margin-bottom: 20px;
			gap: 24px;
		}
		.brand { display: flex; gap: 14px; align-items: flex-start; }
		.brand .badge-mark {
			width: 72px;
			height: 72px;
			object-fit: contain;
			flex-shrink: 0;
		}
		.brand .mark {
			font-weight: 900;
			font-size: 22px;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			line-height: 1;
		}
		.brand .mark .accent { color: var(--rust); }
		.brand .tagline {
			margin-top: 6px;
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: 0.14em;
			color: var(--muted);
		}
		.brand .contact {
			margin-top: 10px;
			font-size: 11px;
			color: var(--muted);
			line-height: 1.5;
		}

		.doc-meta { text-align: right; }
		.doc-meta .kind {
			display: inline-block;
			font-family: "Impact", "Helvetica Neue", Helvetica, Arial, sans-serif;
			font-weight: 900;
			font-size: 34px;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			padding: 4px 14px;
			background: var(--ink);
			color: var(--paper);
			line-height: 1;
		}
		.doc-meta .number {
			margin-top: 10px;
			font-size: 13px;
			font-weight: 700;
		}
		.doc-meta .date { margin-top: 2px; font-size: 11px; color: var(--muted); }
		.doc-meta .badge {
			display: inline-block;
			margin-top: 10px;
			padding: 3px 8px;
			border: 2px solid var(--ink);
			background: var(--amber);
			color: var(--ink);
			font-size: 10px;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		.status-strip {
			display: flex;
			justify-content: space-between;
			align-items: center;
			border: 2px solid var(--ink);
			padding: 10px 14px;
			margin-bottom: 20px;
			background: #FFFFFF;
		}
		.status-strip .label {
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--muted);
		}
		.status-strip .value {
			font-size: 13px;
			font-weight: 700;
			margin-top: 2px;
		}
		.status-strip .value.due { color: var(--rust); }
		.status-strip .value.paid { color: #2E7D32; }

		.addresses {
			display: flex;
			gap: 36px;
			margin-bottom: 22px;
		}
		.addr {
			flex: 1;
			border: 2px solid var(--ink);
			padding: 12px 14px;
			background: #FFFFFF;
		}
		.addr h3 {
			font-size: 10px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--muted);
			margin-bottom: 6px;
		}
		.addr p { line-height: 1.5; font-size: 12px; }
		.addr .name { font-weight: 700; }

		.detail-row {
			display: flex;
			gap: 24px;
			margin-bottom: 20px;
			font-size: 11px;
		}
		.detail-row .item {
			padding: 6px 10px;
			border: 2px solid var(--ink);
			background: #FFFFFF;
		}
		.detail-row .item .lbl {
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--muted);
			font-size: 10px;
		}
		.detail-row .item .val { font-weight: 700; }

		table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
		thead th {
			text-align: left;
			font-size: 10px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--paper);
			background: var(--ink);
			padding: 8px 10px;
		}
		thead th.right { text-align: right; }
		tbody td {
			padding: 10px;
			border-bottom: 1px solid var(--ink);
			vertical-align: top;
		}
		tbody td.right { text-align: right; font-variant-numeric: tabular-nums; }
		tbody td .variant { font-size: 11px; margin-top: 2px; }
		tbody td .sku { color: var(--muted); font-size: 10px; margin-top: 2px; }

		.totals-wrap { display: flex; justify-content: flex-end; }
		.totals {
			width: 280px;
			border: 2px solid var(--ink);
			background: #FFFFFF;
			padding: 10px 14px;
		}
		.totals .row {
			display: flex;
			justify-content: space-between;
			padding: 3px 0;
			font-size: 12px;
			font-variant-numeric: tabular-nums;
		}
		.totals .row.muted { color: var(--muted); }
		.totals .row.subtotal { border-top: 1px solid var(--ink); padding-top: 6px; margin-top: 4px; }
		.totals .row.grand {
			border-top: 2px solid var(--ink);
			padding-top: 8px;
			margin-top: 6px;
			font-weight: 700;
			font-size: 15px;
		}
		.totals .row.due {
			background: var(--amber);
			margin: 6px -14px -10px -14px;
			padding: 10px 14px;
			font-weight: 700;
			font-size: 14px;
			border-top: 2px solid var(--ink);
		}

		.notes {
			margin-top: 22px;
			padding: 12px 14px;
			border: 2px solid var(--ink);
			background: #FFFFFF;
		}
		.notes h4 {
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: var(--muted);
			margin-bottom: 4px;
		}

		.footer {
			margin-top: 28px;
			padding-top: 14px;
			border-top: 2px solid var(--ink);
			display: flex;
			justify-content: space-between;
			align-items: flex-end;
			font-size: 10px;
			color: var(--muted);
		}
		.footer .thanks {
			font-family: "Georgia", "Times New Roman", serif;
			font-style: italic;
			font-size: 14px;
			color: var(--ink);
		}

		@media print {
			body { background: #FFFFFF; padding: 0; }
			.sheet { max-width: none; }
			.sheet + .sheet { border-top: none; margin-top: 0; padding-top: 0; }
			@page { margin: 0.5in; }
		}
	</style>
}

// orderInvoiceSheet renders a single invoice as a self-contained <div class="sheet">.
// Used by both OrderInvoice (single) and OrderInvoiceBatch (multiple).
templ orderInvoiceSheet(props OrderInvoiceProps) {
	<div class="sheet">
		<div class="masthead">
			<div class="brand">
				<img src="/static/badge-black.png" alt="" class="badge-mark"/>
				<div>
					<div class="mark">Rockabilly <span class="accent">Roasting</span> Co.</div>
					<div class="tagline">Small&mdash;batch. Hand&mdash;packed. Kennewick, WA.</div>
					<div class="contact">
						101 W Kennewick Ave, Kennewick, WA 99336<br/>
						(509) 585&ndash;2320 &middot; info@rockabillyroasting.com
					</div>
				</div>
			</div>
			<div class="doc-meta">
				<div class="kind">Invoice</div>
				<div class="number">{ props.Order.Number }</div>
				<div class="date">{ props.Order.PlacedAt.In(props.MerchantTZ).Format("January 2, 2006") }</div>
				if props.Order.SubscriptionID != nil {
					<div class="badge">Subscription</div>
				}
			</div>
		</div>
		<div class="status-strip">
			<div>
				<div class="label">Status</div>
				if invoiceAmountDue(props.Order) == 0 {
					<div class="value paid">{ invoicePaymentLabel(props.Order.PaymentStatus) }</div>
				} else {
					<div class="value">{ invoicePaymentLabel(props.Order.PaymentStatus) }</div>
				}
			</div>
			<div style="text-align: right;">
				<div class="label">Amount Due</div>
				if invoiceAmountDue(props.Order) == 0 {
					<div class="value paid">{ formatCents(0) }</div>
				} else {
					<div class="value due">{ formatCents(invoiceAmountDue(props.Order)) }</div>
				}
			</div>
		</div>
		<div class="addresses">
			<div class="addr">
				<h3>Bill to</h3>
				if props.BillingAddress != nil {
					<p>
						<span class="name">{ props.BillingAddress.FirstName } { props.BillingAddress.LastName }</span>
						if props.BillingAddress.Company != nil && *props.BillingAddress.Company != "" {
							<br/>
							{ *props.BillingAddress.Company }
						}
						<br/>
						{ props.BillingAddress.Line1 }
						if props.BillingAddress.Line2 != nil && *props.BillingAddress.Line2 != "" {
							<br/>
							{ *props.BillingAddress.Line2 }
						}
						<br/>
						{ props.BillingAddress.City }, { props.BillingAddress.State } { props.BillingAddress.PostalCode }
						if props.Customer != nil {
							<br/>
							<span style="color: var(--muted);">{ props.Customer.Email }</span>
						}
					</p>
				} else if props.Customer != nil {
					<p>
						<span class="name">{ props.Customer.FirstName } { props.Customer.LastName }</span>
						<br/>
						<span style="color: var(--muted);">{ props.Customer.Email }</span>
					</p>
				} else {
					<p style="color: var(--muted);">Guest customer</p>
				}
			</div>
			if props.ShippingAddress != nil {
				<div class="addr">
					<h3>Ship to</h3>
					<p>
						<span class="name">{ props.ShippingAddress.FirstName } { props.ShippingAddress.LastName }</span>
						if props.ShippingAddress.Company != nil && *props.ShippingAddress.Company != "" {
							<br/>
							{ *props.ShippingAddress.Company }
						}
						<br/>
						{ props.ShippingAddress.Line1 }
						if props.ShippingAddress.Line2 != nil && *props.ShippingAddress.Line2 != "" {
							<br/>
							{ *props.ShippingAddress.Line2 }
						}
						<br/>
						{ props.ShippingAddress.City }, { props.ShippingAddress.State } { props.ShippingAddress.PostalCode }
					</p>
				</div>
			}
		</div>
		if props.Order.ShippingMethod != nil || props.Order.RequestedDeliveryDate != nil || (props.Order.CustomerPONumber != nil && *props.Order.CustomerPONumber != "") {
			<div class="detail-row">
				if props.Order.ShippingMethod != nil {
					<div class="item">
						<div class="lbl">Method</div>
						<div class="val">{ string(*props.Order.ShippingMethod) }</div>
					</div>
				}
				if props.Order.RequestedDeliveryDate != nil {
					<div class="item">
						<div class="lbl">Requested delivery</div>
						<div class="val">{ props.Order.RequestedDeliveryDate.In(props.MerchantTZ).Format("Jan 2, 2006") }</div>
					</div>
				}
				if props.Order.CustomerPONumber != nil && *props.Order.CustomerPONumber != "" {
					<div class="item">
						<div class="lbl">PO #</div>
						<div class="val">{ *props.Order.CustomerPONumber }</div>
					</div>
				}
			</div>
		}
		<table>
			<thead>
				<tr>
					<th>Item</th>
					<th class="right">Qty</th>
					<th class="right">Unit Price</th>
					<th class="right">Total</th>
				</tr>
			</thead>
			<tbody>
				for _, eli := range props.LineItems {
					<tr>
						<td>
							if eli.ProductTitle != "" {
								<div class="name" style="font-weight: 700;">{ eli.ProductTitle }</div>
							} else {
								<div class="name" style="font-weight: 700;">{ eli.LineItem.VariantID.String()[:8] }&hellip;</div>
							}
							if eli.CurrentLabel != "" {
								<div class="variant">{ eli.CurrentLabel }</div>
							}
							if eli.VariantSKU != "" {
								<div class="sku">SKU { eli.VariantSKU }</div>
							}
						</td>
						<td class="right">{ fmt.Sprintf("%d", eli.LineItem.Quantity) }</td>
						<td class="right">{ formatCents(eli.LineItem.UnitPrice) }</td>
						<td class="right">{ formatCents(eli.LineItem.Total) }</td>
					</tr>
				}
			</tbody>
		</table>
		<div class="totals-wrap">
			<div class="totals">
				<div class="row muted">
					<span>Subtotal</span>
					<span>{ formatCents(props.Order.Subtotal) }</span>
				</div>
				if props.Order.DiscountTotal > 0 {
					<div class="row muted">
						<span>Discounts</span>
						<span>&minus;{ formatCents(props.Order.DiscountTotal) }</span>
					</div>
				}
				<div class="row muted">
					<span>Shipping</span>
					<span>{ formatCents(props.Order.ShippingTotal) }</span>
				</div>
				<div class="row muted">
					<span>Tax</span>
					<span>{ formatCents(props.Order.TaxTotal) }</span>
				</div>
				<div class="row grand">
					<span>Total</span>
					<span>{ formatCents(props.Order.Total) }</span>
				</div>
				if invoiceAmountDue(props.Order) > 0 {
					<div class="row due">
						<span>Amount Due</span>
						<span>{ formatCents(invoiceAmountDue(props.Order)) }</span>
					</div>
				}
			</div>
		</div>
		if props.Order.Notes != nil && *props.Order.Notes != "" {
			<div class="notes">
				<h4>Notes</h4>
				<p>{ *props.Order.Notes }</p>
			</div>
		}
		<div class="footer">
			<div class="thanks">Thanks for drinking with us.</div>
			<div>
				Questions? info@rockabillyroasting.com &middot; (509) 585&ndash;2320
			</div>
		</div>
	</div>
}

templ OrderInvoice(props OrderInvoiceProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Invoice &mdash; { props.Order.Number }</title>
			@orderInvoiceStyles()
		</head>
		<body onload="window.print()">
			@orderInvoiceSheet(props)
		</body>
	</html>
}

templ OrderInvoiceBatch(props OrderInvoiceBatchProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Invoices &mdash; { fmt.Sprintf("%d order(s)", len(props.Items)) }</title>
			@orderInvoiceStyles()
		</head>
		<body onload="window.print()">
			for _, item := range props.Items {
				@orderInvoiceSheet(item)
			}
		</body>
	</html>
}
