package admin

import (
	"encoding/base64"
	"encoding/json"
	"fmt"

	"github.com/google/uuid"
)

// LabelRateView is one purchasable shipping rate, shaped for the admin UI.
// The web handler maps platform/shipping.Rate into this — ui/ may not import
// platform packages, so the view model is duplicated here deliberately.
//
// Short json tags keep the base64-encoded radio value (see EncodeRateOption)
// compact in the rendered HTML.
type LabelRateView struct {
	RateID          string `json:"r"`
	ShipmentID      string `json:"s"`
	CarrierName     string `json:"c"`
	ServiceName     string `json:"n"`
	ServiceToken    string `json:"t"`
	AmountCents     int    `json:"a"`
	Currency        string `json:"u"`
	EstDeliveryDays int    `json:"d"`
}

// LabelRatesProps drives the rate-selection panel swapped in under the order's
// "Get shipping rates" button.
type LabelRatesProps struct {
	OrderID uuid.UUID
	Rates   []LabelRateView // cheapest first; the first entry is pre-selected
	Notice  string          // amber info line (e.g. rates refreshed after expiry)
	Error   string          // red error line
}

// EncodeRateOption serializes a rate into the radio's value so the selected
// option's full snapshot (id + price + carrier + service) round-trips to the
// buy handler without a second rate fetch. base64(JSON) keeps it valid inside
// an HTML attribute. DecodeRateOption (called by the web handler) is the
// inverse.
func EncodeRateOption(r LabelRateView) string {
	b, _ := json.Marshal(r)
	return base64.RawURLEncoding.EncodeToString(b)
}

// DecodeRateOption reverses EncodeRateOption. Used by the web buy handler to
// recover the selected rate snapshot from the submitted form value.
func DecodeRateOption(s string) (LabelRateView, error) {
	var r LabelRateView
	b, err := base64.RawURLEncoding.DecodeString(s)
	if err != nil {
		return r, fmt.Errorf("decode rate option: %w", err)
	}
	if err := json.Unmarshal(b, &r); err != nil {
		return r, fmt.Errorf("unmarshal rate option: %w", err)
	}
	if r.RateID == "" {
		return r, fmt.Errorf("rate option missing id")
	}
	return r, nil
}

// rateDeliveryLabel renders the carrier's delivery estimate, or "" when none
// was returned.
func rateDeliveryLabel(days int) string {
	switch {
	case days <= 0:
		return ""
	case days == 1:
		return "1 day"
	default:
		return fmt.Sprintf("%d days", days)
	}
}

// LabelRatesPanel renders the shipping-rate chooser. It is swapped into the
// #label-rates-panel container: by the GET rates handler on first load, and by
// the POST buy handler on rate expiry (with a "rates refreshed" notice). On a
// successful purchase the buy handler returns an HX-Redirect instead, so this
// panel is never re-rendered after a buy succeeds.
templ LabelRatesPanel(props LabelRatesProps) {
	<div class="mt-4 border border-rr-border bg-rr-surface p-4">
		<h3 class="label-font text-rr-muted">Shipping rates</h3>
		if props.Error != "" {
			<p class="mt-2 text-sm text-rr-red">{ props.Error }</p>
		}
		if props.Notice != "" {
			<p class="mt-2 flex items-start gap-2 text-sm text-rr-body">
				<span class="badge badge-amber mt-0.5">Updated</span>
				<span>{ props.Notice }</span>
			</p>
		}
		if len(props.Rates) == 0 && props.Error == "" {
			<p class="mt-2 text-sm text-rr-muted">No shipping rates were returned for this parcel.</p>
		}
		if len(props.Rates) > 0 {
			<form
				method="post"
				action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/label", props.OrderID.String())) }
				hx-post={ fmt.Sprintf("/admin/orders/%s/label", props.OrderID.String()) }
				hx-target="#label-rates-panel"
				hx-swap="innerHTML"
				class="mt-3"
			>
				<fieldset class="space-y-2">
					<legend class="sr-only">Choose a shipping rate</legend>
					for i, rt := range props.Rates {
						<label class="flex cursor-pointer items-center gap-3 border border-rr-border px-3 py-2 text-sm hover:bg-rr-raised">
							<input
								type="radio"
								name="rate"
								value={ EncodeRateOption(rt) }
								required
								checked?={ i == 0 }
								class="text-rr-red focus:ring-rr-red"
							/>
							<span class="flex-1">
								<span class="font-medium text-rr-heading">{ rt.CarrierName } { rt.ServiceName }</span>
								if rateDeliveryLabel(rt.EstDeliveryDays) != "" {
									<span class="text-rr-muted"> · { rateDeliveryLabel(rt.EstDeliveryDays) }</span>
								}
								if i == 0 {
									<span class="badge badge-green ml-2">Cheapest</span>
								}
							</span>
							<span class="font-semibold tabular-nums text-rr-heading">{ formatCents(rt.AmountCents) }</span>
						</label>
					}
				</fieldset>
				<button
					type="submit"
					class="mt-3 inline-flex items-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
				>
					<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"></path>
					</svg>
					Buy selected label
				</button>
			</form>
		}
	</div>
}
