package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
	"net/url"
)

func formatCents(cents int) string {
	return fmt.Sprintf("$%d.%02d", cents/100, cents%100)
}

type OrderListProps struct {
	Orders       []domain.Order
	StatusFilter string
	Search       string
	TotalCount   int
	Page         int
	PerPage      int
	HasMore      bool
	StaffName    string
	StaffRole    string
}

func (p OrderListProps) showingStart() int {
	if p.TotalCount == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p OrderListProps) showingEnd() int {
	end := p.Page * p.PerPage
	if end > p.TotalCount {
		return p.TotalCount
	}
	return end
}

// orderTabHref builds a URL preserving the search query when switching tabs.
func orderTabHref(status, search string) string {
	v := url.Values{}
	if status != "" {
		v.Set("status", status)
	}
	if search != "" {
		v.Set("q", search)
	}
	if len(v) == 0 {
		return "/admin/orders"
	}
	return "/admin/orders?" + v.Encode()
}

func orderTabClass(active bool) string {
	if active {
		return "border-b-2 border-rr-red px-3 py-2 text-sm font-semibold text-rr-heading"
	}
	return "border-b-2 border-transparent px-3 py-2 text-sm font-medium text-rr-muted hover:text-rr-heading hover:border-rr-border transition-colors"
}

templ OrderListContent(props OrderListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="text-lg font-bold text-rr-heading">Orders</h1>
			<p class="mt-1 text-sm text-rr-muted">View and manage customer orders</p>
		</div>
	</div>
	<!-- Search + Filters -->
	<div class="mt-6 space-y-4">
		<!-- Search -->
		<div class="max-w-sm">
			<input
				type="search"
				name="q"
				value={ props.Search }
				placeholder="Search by order #, name, or email..."
				hx-get={ orderTabHref(props.StatusFilter, "") }
				hx-trigger="input changed delay:300ms, search"
				hx-target="#main-content"
				hx-push-url="true"
				hx-include="[name='status']"
				class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
			/>
			<input type="hidden" name="status" value={ props.StatusFilter }/>
		</div>
		<!-- Tab filters -->
		<nav class="flex gap-0 border-b border-rr-border -mb-px">
			<a href={ templ.SafeURL(orderTabHref("", props.Search)) } class={ orderTabClass(props.StatusFilter == "") }>All</a>
			<a href={ templ.SafeURL(orderTabHref("pending", props.Search)) } class={ orderTabClass(props.StatusFilter == "pending") }>Pending</a>
			<a href={ templ.SafeURL(orderTabHref("confirmed", props.Search)) } class={ orderTabClass(props.StatusFilter == "confirmed") }>Confirmed</a>
			<a href={ templ.SafeURL(orderTabHref("processing", props.Search)) } class={ orderTabClass(props.StatusFilter == "processing") }>Processing</a>
			<a href={ templ.SafeURL(orderTabHref("on_hold", props.Search)) } class={ orderTabClass(props.StatusFilter == "on_hold") }>On Hold</a>
			<a href={ templ.SafeURL(orderTabHref("complete", props.Search)) } class={ orderTabClass(props.StatusFilter == "complete") }>Complete</a>
			<a href={ templ.SafeURL(orderTabHref("cancelled", props.Search)) } class={ orderTabClass(props.StatusFilter == "cancelled") }>Cancelled</a>
			<a href={ templ.SafeURL(orderTabHref("refunded", props.Search)) } class={ orderTabClass(props.StatusFilter == "refunded") }>Refunded</a>
		</nav>
	</div>
	<!-- Order table -->
	<div class="mt-4">
		if len(props.Orders) == 0 {
			<div class="rounded-sm border-2 border-dashed border-rr-border p-12 text-center">
				<svg class="mx-auto size-12 text-rr-border" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No orders</h3>
				if props.Search != "" {
					<p class="mt-1 text-sm text-rr-muted">No orders match "{ props.Search }". Try a different search.</p>
				} else {
					<p class="mt-1 text-sm text-rr-muted">Orders will appear here once customers start purchasing.</p>
					<a href="/" target="_blank" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-rr-red hover:text-rr-red-lt">
						View your storefront
						<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
						</svg>
					</a>
				}
			</div>
		} else {
			<div class="overflow-hidden rounded-sm bg-rr-surface shadow-xs ring-1 ring-rr-border">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Order Status</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Fulfillment</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading md:table-cell">Shipping</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Total</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">Date</th>
							<th scope="col" class="hidden relative py-3.5 pl-3 pr-4 sm:table-cell sm:pr-6">
								<span class="sr-only">View</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, o := range props.Orders {
							<tr class="row-link">
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) } class="row-link-target font-medium text-rr-heading hover:text-rr-red">
										{ o.Number }
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@OrderStatusBadge(o.Status)
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@FulfillmentStatusBadge(o.FulfillmentStatus)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm md:table-cell">
									if o.ShippingMethod != nil {
										@ShippingMethodBadge(*o.ShippingMethod)
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-heading text-right tabular-nums">
									{ formatCents(o.Total) }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted lg:table-cell">
									{ o.PlacedAt.Format("Jan 2, 2006") }
								</td>
								<td class="hidden whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:table-cell sm:pr-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) } class="text-rr-red hover:text-rr-red-lt">
										View<span class="sr-only">, { o.Number }</span>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			@orderPagination(props)
		}
	</div>
}

templ orderPagination(props OrderListProps) {
	<nav class="flex items-center justify-between border-t border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
		<div class="-mt-px flex w-0 flex-1">
			if props.Page > 1 {
				<a
					href={ templ.SafeURL(orderPageHref(props.Page-1, props.StatusFilter, props.Search)) }
					class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading ring-1 ring-inset ring-rr-border hover:bg-rr-raised"
				>
					Previous
				</a>
			}
		</div>
		if props.TotalCount > 0 {
			<p class="text-sm text-rr-muted">
				<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingStart()) }</span>–<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingEnd()) }</span> of <span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.TotalCount) }</span>
			</p>
		}
		<div class="-mt-px flex w-0 flex-1 justify-end">
			if props.HasMore {
				<a
					href={ templ.SafeURL(orderPageHref(props.Page+1, props.StatusFilter, props.Search)) }
					class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading ring-1 ring-inset ring-rr-border hover:bg-rr-raised"
				>
					Next
				</a>
			}
		</div>
	</nav>
}

templ OrderList(props OrderListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Orders",
		ActivePath: "/admin/orders",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@OrderListContent(props)
	}
}

func orderPageHref(page int, status, search string) string {
	v := url.Values{}
	v.Set("page", fmt.Sprintf("%d", page))
	if status != "" {
		v.Set("status", status)
	}
	if search != "" {
		v.Set("q", search)
	}
	return "/admin/orders?" + v.Encode()
}
