package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type OrderListProps struct {
	Orders       []domain.Order
	StatusFilter string
	Page         int
	PerPage      int
	HasMore      bool
	StaffName    string
	StaffRole    string
}

func formatCents(cents int) string {
	return fmt.Sprintf("$%d.%02d", cents/100, cents%100)
}

func orderProgressLabel(o domain.Order) string {
	if o.Status == domain.OrderStatusCancelled {
		return "Cancelled"
	}
	if o.Status == domain.OrderStatusRefunded {
		return "Refunded"
	}
	if o.FulfillmentStatus == domain.FulfillmentStatusShipped ||
		o.FulfillmentStatus == domain.FulfillmentStatusDelivered {
		return "Shipped"
	}
	if o.FulfillmentStatus == domain.FulfillmentStatusFulfilled {
		return "Fulfilled"
	}
	if o.PaymentStatus == domain.PaymentStatusCaptured {
		return "Paid"
	}
	if o.PaymentStatus == domain.PaymentStatusFailed {
		return "Payment Failed"
	}
	return "Awaiting Payment"
}

templ OrderListContent(props OrderListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="text-base/7 font-semibold text-stone-900">Orders</h1>
			<p class="mt-1 text-sm text-stone-500">View and manage customer orders</p>
		</div>
	</div>
	<!-- Filters -->
	<form method="get" action="/admin/orders" class="mt-6 flex items-center gap-3">
		<div class="grid grid-cols-1">
			<select
				name="status"
				onchange="this.form.submit()"
				class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pl-3 pr-8 text-sm text-stone-900 outline-1 -outline-offset-1 outline-stone-300 focus:outline-2 focus:-outline-offset-2 focus:outline-hiri-teal"
			>
				<option value="">All statuses</option>
				<option value="pending" selected?={ props.StatusFilter == "pending" }>Pending</option>
				<option value="confirmed" selected?={ props.StatusFilter == "confirmed" }>Confirmed</option>
				<option value="processing" selected?={ props.StatusFilter == "processing" }>Processing</option>
				<option value="on_hold" selected?={ props.StatusFilter == "on_hold" }>On Hold</option>
				<option value="complete" selected?={ props.StatusFilter == "complete" }>Complete</option>
				<option value="cancelled" selected?={ props.StatusFilter == "cancelled" }>Cancelled</option>
				<option value="refunded" selected?={ props.StatusFilter == "refunded" }>Refunded</option>
			</select>
			<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-stone-500 sm:size-4" viewBox="0 0 16 16" fill="currentColor">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</div>
	</form>
	<!-- Order table -->
	<div class="mt-6">
		if len(props.Orders) == 0 {
			<div class="rounded-lg border-2 border-dashed border-stone-300 p-12 text-center">
				<svg class="mx-auto size-12 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-stone-900">No orders</h3>
				<p class="mt-1 text-sm text-stone-500">Orders will appear here once customers start purchasing.</p>
			</div>
		} else {
			<div class="overflow-hidden rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
				<table class="min-w-full divide-y divide-stone-300">
					<thead class="bg-stone-50">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-stone-900 sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Progress</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-stone-900">Total</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-stone-900 lg:table-cell">Date</th>
							<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
								<span class="sr-only">View</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-200 bg-white">
						for _, o := range props.Orders {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) } class="font-medium text-stone-900 hover:text-hiri-teal">
										{ o.Number }
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									if o.Status == domain.OrderStatusCancelled || o.Status == domain.OrderStatusRefunded {
										@OrderStatusBadge(o.Status)
									} else {
										<div class="flex items-center gap-2">
											@orderProgressDots(&o)
											<span class="text-xs text-stone-600">{ orderProgressLabel(o) }</span>
										</div>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-stone-900 text-right tabular-nums">
									{ formatCents(o.Total) }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-stone-500 lg:table-cell">
									{ o.PlacedAt.Format("Jan 2, 2006") }
								</td>
								<td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", o.ID)) } class="text-hiri-teal hover:text-hiri-teal-dark">
										View<span class="sr-only">, { o.Number }</span>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-stone-200 px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/orders?page=%d&status=%s", props.Page-1, props.StatusFilter)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Previous
						</a>
					}
				</div>
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/orders?page=%d&status=%s", props.Page+1, props.StatusFilter)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

templ orderProgressDots(o *domain.Order) {
	<div class="flex items-center gap-1" title={ fmt.Sprintf("Paid: %s / Fulfilled: %s / Shipped: %s", o.PaymentStatus, o.FulfillmentStatus, o.FulfillmentStatus) }>
		<!-- Paid -->
		if o.PaymentStatus == domain.PaymentStatusCaptured {
			<div class="size-2.5 rounded-full bg-hiri-teal"></div>
		} else if o.PaymentStatus == domain.PaymentStatusFailed {
			<div class="size-2.5 rounded-full bg-red-500"></div>
		} else {
			<div class="size-2.5 rounded-full bg-stone-300"></div>
		}
		<!-- Fulfilled -->
		if o.FulfillmentStatus == domain.FulfillmentStatusFulfilled || o.FulfillmentStatus == domain.FulfillmentStatusShipped || o.FulfillmentStatus == domain.FulfillmentStatusDelivered {
			<div class="size-2.5 rounded-full bg-hiri-teal"></div>
		} else {
			<div class="size-2.5 rounded-full bg-stone-300"></div>
		}
		<!-- Shipped -->
		if o.FulfillmentStatus == domain.FulfillmentStatusShipped || o.FulfillmentStatus == domain.FulfillmentStatusDelivered {
			<div class="size-2.5 rounded-full bg-hiri-teal"></div>
		} else {
			<div class="size-2.5 rounded-full bg-stone-300"></div>
		}
	</div>
}

templ OrderList(props OrderListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Orders",
		ActivePath: "/admin/orders",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@OrderListContent(props)
	}
}
