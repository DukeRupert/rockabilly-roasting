package admin

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// OrderRow bundles an order with the customer summary fields the list needs
// to render at a glance: display name, email, and account type. Built in the
// handler from per-order customer lookups (bounded by page size).
type OrderRow struct {
	Order         domain.Order
	CustomerName  string
	CustomerEmail string
	AccountType   domain.AccountType
}

// showOrderStatusOverFulfillment decides which badge to show in the single
// State column. Order status wins for non-active states (cancelled / refunded /
// on_hold / pending) since fulfillment is irrelevant or ambiguous in those
// cases. Otherwise fulfillment status — the actionable signal for staff —
// takes the slot.
func showOrderStatusOverFulfillment(s domain.OrderStatus) bool {
	switch s {
	case domain.OrderStatusCancelled,
		domain.OrderStatusRefunded,
		domain.OrderStatusOnHold,
		domain.OrderStatusPending:
		return true
	}
	return false
}

// orderListIDsJSON serializes the visible order IDs into a JS array literal so
// Alpine's "select all on this page" knows the full set. UUIDs contain no
// characters that need escaping, so simple string interpolation is safe.
func orderListIDsJSON(rows []OrderRow) string {
	if len(rows) == 0 {
		return "[]"
	}
	parts := make([]string, len(rows))
	for i, r := range rows {
		parts[i] = `"` + r.Order.ID.String() + `"`
	}
	return "[" + strings.Join(parts, ",") + "]"
}

func orderListAlpineState(rows []OrderRow) string {
	return "{ selected: [], allIds: " + orderListIDsJSON(rows) + " }"
}

func formatCents(cents int) string {
	return fmt.Sprintf("$%d.%02d", cents/100, cents%100)
}

type OrderListProps struct {
	Rows         []OrderRow
	StatusFilter string
	Search       string
	TotalCount   int
	Page         int
	PerPage      int
	HasMore      bool
	MerchantTZ   *time.Location
	StaffName    string
	StaffRole    string
}

func (p OrderListProps) showingStart() int {
	if p.TotalCount == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p OrderListProps) showingEnd() int {
	end := p.Page * p.PerPage
	if end > p.TotalCount {
		return p.TotalCount
	}
	return end
}

// orderTabHref builds a URL preserving the search query when switching tabs.
func orderTabHref(status, search string) string {
	v := url.Values{}
	if status != "" {
		v.Set("status", status)
	}
	if search != "" {
		v.Set("q", search)
	}
	if len(v) == 0 {
		return "/admin/orders"
	}
	return "/admin/orders?" + v.Encode()
}

func orderTabClass(active bool) string {
	if active {
		return "shrink-0 whitespace-nowrap border-b-2 border-rr-red px-3 py-2 text-sm font-semibold text-rr-heading"
	}
	return "shrink-0 whitespace-nowrap border-b-2 border-transparent px-3 py-2 text-sm font-medium text-rr-muted hover:text-rr-heading hover:border-rr-border transition-colors"
}

templ OrderListContent(props OrderListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-end sm:justify-between">
		<div>
			<h1 class="admin-page-title">Orders</h1>
			<p class="mt-2 label-font text-rr-amber" style="font-size:0.65rem;">✦ The daybook</p>
		</div>
		<div class="mt-4 sm:mt-0">
			<a href="/admin/orders/new" class="inline-flex items-center rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white hover:bg-rr-red/90">+ New manual order</a>
		</div>
	</div>
	<!-- Search + Filters -->
	<div class="mt-6 space-y-4">
		<!-- Search -->
		<div class="max-w-sm">
			<input
				type="search"
				name="q"
				value={ props.Search }
				placeholder="Search orders, names, emails"
				hx-get={ orderTabHref(props.StatusFilter, "") }
				hx-trigger="input changed delay:300ms, search"
				hx-target="#main-content"
				hx-push-url="true"
				hx-include="[name='status']"
				class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
			/>
			<input type="hidden" name="status" value={ props.StatusFilter }/>
		</div>
		<!-- Tab filters -->
		<nav class="flex gap-0 border-b-2 border-rr-border -mb-px overflow-x-auto">
			<a href={ templ.SafeURL(orderTabHref("", props.Search)) } class={ orderTabClass(props.StatusFilter == "") }>All</a>
			<a href={ templ.SafeURL(orderTabHref("pending", props.Search)) } class={ orderTabClass(props.StatusFilter == "pending") }>Pending</a>
			<a href={ templ.SafeURL(orderTabHref("confirmed", props.Search)) } class={ orderTabClass(props.StatusFilter == "confirmed") }>Confirmed</a>
			<a href={ templ.SafeURL(orderTabHref("processing", props.Search)) } class={ orderTabClass(props.StatusFilter == "processing") }>Processing</a>
			<a href={ templ.SafeURL(orderTabHref("on_hold", props.Search)) } class={ orderTabClass(props.StatusFilter == "on_hold") }>On Hold</a>
			<a href={ templ.SafeURL(orderTabHref("complete", props.Search)) } class={ orderTabClass(props.StatusFilter == "complete") }>Complete</a>
			<a href={ templ.SafeURL(orderTabHref("cancelled", props.Search)) } class={ orderTabClass(props.StatusFilter == "cancelled") }>Cancelled</a>
			<a href={ templ.SafeURL(orderTabHref("refunded", props.Search)) } class={ orderTabClass(props.StatusFilter == "refunded") }>Refunded</a>
		</nav>
	</div>
	<!-- Order table -->
	<div class="mt-4">
		if len(props.Rows) == 0 {
			if props.Search != "" {
				<!-- Empty: search returned no matches -->
				<div class="border-2 border-rr-border bg-rr-surface px-6 py-14 text-center">
					<h2 class="admin-page-title text-2xl">No match.</h2>
					<p class="mt-3 text-sm text-rr-body">Nothing for &ldquo;{ props.Search }&rdquo;. Try a different angle &mdash; name, email, or order number.</p>
				</div>
			} else {
				<!-- Empty: no orders ever — branded stamp -->
				<div class="border-2 border-rr-border bg-rr-surface px-6 py-16 sm:py-20 text-center">
					<div
						class="inline-block -rotate-2 border-2 border-rr-border bg-rr-raised px-8 py-3"
						style="box-shadow: 4px 4px 0 0 var(--color-rr-border);"
					>
						<h2 class="admin-page-title">Quiet shop</h2>
					</div>
					<div class="mt-8 text-rr-amber tracking-[0.6em] text-lg select-none" aria-hidden="true">✦ ✦ ✦</div>
					<p class="mt-4 text-base text-rr-body">No orders yet &mdash; they'll roll in when the first one lands.</p>
					<a href="/" target="_blank" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-rr-red hover:text-rr-red-lt">
						View your storefront
						<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
						</svg>
					</a>
				</div>
			}
		} else {
			<div x-data={ orderListAlpineState(props.Rows) }>
				<!-- Bulk action bar — stamps in below the admin top bar when rows are selected. -->
				<div
					x-show="selected.length > 0"
					x-cloak
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0 -translate-y-1"
					x-transition:enter-end="opacity-100 translate-y-0"
					x-transition:leave="transition ease-in duration-150"
					x-transition:leave-start="opacity-100"
					x-transition:leave-end="opacity-0"
					class="sticky top-16 z-20 mb-4 flex items-center justify-between gap-3 border-2 border-rr-border bg-rr-surface px-3 py-2 text-sm shadow-[4px_4px_0_0_#0E0D0C]"
				>
					<span class="text-rr-heading">
						<span class="font-semibold tabular-nums" x-text="selected.length"></span> selected
					</span>
					<div class="flex items-center gap-2">
						<button
							type="button"
							@click="window.open('/admin/orders/batch/invoices?ids=' + selected.join(','), '_blank')"
							class="inline-flex items-center rounded-sm bg-rr-red px-3 py-1.5 text-sm font-semibold text-white hover:bg-rr-red/90"
						>
							Print invoices
						</button>
						<button
							type="button"
							@click="selected = []"
							class="inline-flex items-center rounded-sm border-2 border-rr-border px-3 py-1.5 text-sm font-medium text-rr-heading hover:bg-rr-raised"
						>
							Clear
						</button>
					</div>
				</div>
				<div class="overflow-hidden border-2 border-rr-border bg-rr-surface">
					<table class="min-w-full divide-y divide-rr-border">
						<thead class="bg-rr-raised">
							<tr>
								<th scope="col" class="relative w-10 px-3 py-3.5 sm:pl-6">
									<input
										type="checkbox"
										aria-label="Select all orders on this page"
										class="size-4 cursor-pointer accent-rr-red"
										:checked="selected.length === allIds.length && allIds.length > 0"
										:indeterminate="selected.length > 0 && selected.length < allIds.length"
										@change="selected = $event.target.checked ? [...allIds] : []"
									/>
								</th>
								<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading">Order</th>
								<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">State</th>
								<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading md:table-cell">Shipping</th>
								<th scope="col" class="px-3 py-3.5 pr-4 sm:pr-6 text-right text-sm font-semibold text-rr-heading">Total</th>
								<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">Date</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-rr-border bg-rr-surface">
							for _, row := range props.Rows {
								<tr class="row-link">
									<td class="relative z-10 w-10 px-3 py-4 sm:pl-6" @click.stop>
										<input
											type="checkbox"
											aria-label={ fmt.Sprintf("Select order %s", row.Order.Number) }
											class="size-4 cursor-pointer accent-rr-red"
											value={ row.Order.ID.String() }
											x-model="selected"
											@click.stop
										/>
									</td>
									<td class="py-4 pl-4 pr-3 text-sm">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", row.Order.ID)) } class="row-link-target block">
											<div class="flex items-center gap-2 leading-none">
												<span class="label-font text-rr-muted">{ row.Order.Number }</span>
												if row.AccountType == domain.AccountTypeWholesale {
													<span class="label-font text-[#0A5E5C]" title="Wholesale customer">Wholesale</span>
												}
											</div>
											<div class="mt-1 font-semibold text-rr-heading hover:text-rr-red">{ row.CustomerName }</div>
											if row.CustomerEmail != "" {
												<div class="mt-0.5 text-xs text-rr-muted truncate max-w-[22ch] md:max-w-none">{ row.CustomerEmail }</div>
											}
										</a>
									</td>
									<td class="whitespace-nowrap px-3 py-4 text-sm">
										if showOrderStatusOverFulfillment(row.Order.Status) {
											@OrderStatusBadge(row.Order.Status)
										} else {
											@FulfillmentStatusBadge(row.Order.FulfillmentStatus)
										}
									</td>
									<td class="hidden whitespace-nowrap px-3 py-4 text-sm md:table-cell">
										if row.Order.ShippingMethod != nil {
											@ShippingMethodBadge(*row.Order.ShippingMethod)
										} else {
											<span class="text-rr-border">&mdash;</span>
										}
									</td>
									<td class="whitespace-nowrap px-3 py-4 pr-4 sm:pr-6 text-sm text-right">
										<div class="text-rr-heading tabular-nums">{ formatCents(row.Order.Total) }</div>
										<div class="mt-0.5">
											@PaymentChip(row.Order.PaymentStatus)
										</div>
									</td>
									<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted lg:table-cell">
										{ row.Order.PlacedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<!-- Pagination -->
			@orderPagination(props)
		}
	</div>
}

templ orderPagination(props OrderListProps) {
	<nav class="flex items-center justify-between border-t-2 border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
		<div class="-mt-px flex w-0 flex-1">
			if props.Page > 1 {
				<a
					href={ templ.SafeURL(orderPageHref(props.Page-1, props.StatusFilter, props.Search)) }
					class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border-2 border-rr-border hover:bg-rr-raised"
				>
					Previous
				</a>
			}
		</div>
		if props.TotalCount > 0 {
			<p class="text-sm text-rr-muted">
				<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingStart()) }</span>–<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingEnd()) }</span> of <span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.TotalCount) }</span>
			</p>
		}
		<div class="-mt-px flex w-0 flex-1 justify-end">
			if props.HasMore {
				<a
					href={ templ.SafeURL(orderPageHref(props.Page+1, props.StatusFilter, props.Search)) }
					class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border-2 border-rr-border hover:bg-rr-raised"
				>
					Next
				</a>
			}
		</div>
	</nav>
}

templ OrderList(props OrderListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Orders",
		ActivePath: "/admin/orders",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@OrderListContent(props)
	}
}

func orderPageHref(page int, status, search string) string {
	v := url.Values{}
	v.Set("page", fmt.Sprintf("%d", page))
	if status != "" {
		v.Set("status", status)
	}
	if search != "" {
		v.Set("q", search)
	}
	return "/admin/orders?" + v.Encode()
}
