package admin

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// OrderRow bundles an order with the customer summary fields the list needs
// to render at a glance: display name, email, and account type. Built in the
// handler from per-order customer lookups (bounded by page size).
//
// LabelFailed is true when the most recent BuyLabel job for this order ended
// in cancelled/discarded state — surfaced as an inline badge so staff can
// spot blocked orders without opening each row.
type OrderRow struct {
	Order         domain.Order
	CustomerName  string
	CustomerEmail string
	AccountType   domain.AccountType
	LabelFailed   bool
	// AccountPastDue flags an order whose customer has invoices past terms —
	// staff hold new fulfillment for that account until the balance clears.
	AccountPastDue bool
}

// showOrderStatusOverFulfillment decides which badge to show in the single
// State column. Order status wins for non-active states (cancelled / refunded /
// on_hold / pending) since fulfillment is irrelevant or ambiguous in those
// cases. Otherwise fulfillment status — the actionable signal for staff —
// takes the slot.
func showOrderStatusOverFulfillment(s domain.OrderStatus) bool {
	switch s {
	case domain.OrderStatusCancelled,
		domain.OrderStatusRefunded,
		domain.OrderStatusOnHold,
		domain.OrderStatusPending:
		return true
	}
	return false
}

// orderListIDsJSON serializes the visible order IDs into a JS array literal so
// Alpine's "select all on this page" knows the full set. UUIDs contain no
// characters that need escaping, so simple string interpolation is safe.
func orderListIDsJSON(rows []OrderRow) string {
	if len(rows) == 0 {
		return "[]"
	}
	parts := make([]string, len(rows))
	for i, r := range rows {
		parts[i] = `"` + r.Order.ID.String() + `"`
	}
	return "[" + strings.Join(parts, ",") + "]"
}

// orderListAlpineState builds the inline x-data for the bulk-action bar.
// Carries multi-select state: `selected` (currently checked row IDs) and
// `allIds` (the visible page's IDs, used by the select-all header checkbox).
func orderListAlpineState(rows []OrderRow) string {
	return `{
		selected: [],
		allIds: ` + orderListIDsJSON(rows) + `
	}`
}

func formatCents(cents int) string {
	return fmt.Sprintf("$%d.%02d", cents/100, cents%100)
}

// relativeOrderDate formats a placed-at date in merchant time relative to
// "now" so staff can scan freshness at a glance instead of doing date math.
// Returns "Today 3:04 PM", "Yesterday", "Nd ago" (2-6), "Jan 2" (this year),
// or "Jan 2, 2006" (prior years).
func relativeOrderDate(placedAt time.Time, tz *time.Location, now time.Time) string {
	placed := placedAt.In(tz)
	today := now.In(tz)
	startOfToday := time.Date(today.Year(), today.Month(), today.Day(), 0, 0, 0, 0, tz)
	startOfPlaced := time.Date(placed.Year(), placed.Month(), placed.Day(), 0, 0, 0, 0, tz)
	dayDiff := int(startOfToday.Sub(startOfPlaced).Hours() / 24)
	switch {
	case dayDiff <= 0:
		return "Today " + placed.Format("3:04 PM")
	case dayDiff == 1:
		return "Yesterday"
	case dayDiff < 7:
		return fmt.Sprintf("%dd ago", dayDiff)
	}
	if placed.Year() == today.Year() {
		return placed.Format("Jan 2")
	}
	return placed.Format("Jan 2, 2006")
}

// How long an order may sit before the row earns its rust flag.
//
// One threshold cannot serve both channels. Retail ships on demand, so two days
// in the queue means someone forgot. Wholesale runs a weekly cycle against a
// Friday-afternoon order cutoff — the shop roasts and delivers to that rhythm
// (see app.OrderReminderCutoffLabel) — so a wholesale order sitting three days
// is the process working, not a problem. Flagging it at 48h would paint the
// entire wholesale queue rust every week until staff learned the colour meant
// nothing, and it would stop working for retail too.
//
// The wholesale window is one full cycle: if the order is still unfulfilled by
// the time that customer is being asked to place their next one, it is late by
// any reading.
const (
	retailStaleAfter    = 48 * time.Hour
	wholesaleStaleAfter = 7 * 24 * time.Hour
)

// orderIsStale reports whether an order has waited long enough to deserve the
// rust leading-edge flag. Drives the row accent on the dashboard, the order
// list, and both fulfillment queues, so all four agree on what "overdue" means.
//
// now and loc are injected rather than read from the clock so staleness is
// deterministic in tests — the same shape relativeOrderDate takes.
func orderIsStale(o domain.Order, loc *time.Location, now time.Time) bool {
	if !orderNeedsHands(o) {
		return false
	}

	// A local-delivery order carries a real deadline — the run it was promised
	// to — so age is the wrong measure entirely. An order placed Thursday
	// morning for Monday's van is not late on Saturday, and one still sitting
	// after its van left is late no matter how recently it arrived.
	//
	// The comparison is on calendar days, not instants. ScheduledDeliveryDate
	// comes from a Postgres `date`, so its clock reads midnight UTC — treating
	// that as a moment would call an order stale in the middle of its own
	// delivery afternoon anywhere west of Greenwich.
	if d := o.ScheduledDeliveryDate; d != nil {
		if loc == nil {
			loc = time.UTC
		}
		today := now.In(loc)
		return dayNumber(today.Date()) > dayNumber(d.Date())
	}

	if o.Channel == domain.OrderChannelWholesale {
		return now.Sub(o.PlacedAt) >= wholesaleStaleAfter
	}
	return now.Sub(o.PlacedAt) >= retailStaleAfter
}

// dayNumber collapses a calendar date to a single comparable integer, so two
// dates can be ordered without constructing times in a zone either of them
// might not belong to.
func dayNumber(year int, month time.Month, day int) int {
	return year*10000 + int(month)*100 + day
}

// orderNeedsHands reports whether an order is waiting on staff at all. Nothing
// terminal can be overdue, and a pending intent is waiting on the customer to
// finish paying rather than on us — with one exception: once the charge has
// actually failed, chasing it is our job, so the clock starts.
func orderNeedsHands(o domain.Order) bool {
	switch o.Status {
	case domain.OrderStatusConfirmed, domain.OrderStatusProcessing, domain.OrderStatusOnHold:
		return true
	case domain.OrderStatusComplete, domain.OrderStatusCancelled, domain.OrderStatusRefunded:
		return false
	}
	return o.PaymentStatus == domain.PaymentStatusFailed
}

// OrderViewCounts holds tab counts for the orders list. Mirrors
// store.OrderViewCounts so the ui package stays free of store imports.
type OrderViewCounts struct {
	NeedsAction int
	OnHold      int
	Shipped     int
	Archive     int
	All         int
}

type OrderListProps struct {
	// BasePath is the list's own URL (/admin/orders for retail,
	// /admin/orders/wholesale for wholesale). Tabs, search, and pagination all
	// link relative to it so the same template drives both channel pages.
	BasePath   string
	Title      string
	Subtitle   string
	Rows       []OrderRow
	View   string // one of: needs_action | on_hold | shipped | archive | all
	Counts OrderViewCounts
	Search string
	// Suggestions holds fuzzy customer matches shown when a search finds no
	// orders — the near-miss is almost always a half-remembered name.
	Suggestions []domain.Customer
	Sort        string
	Payment     string // payment status filter, "" for any
	Fulfillment string // fulfillment status filter, "" for any
	Range       string // date preset key, "" for any, "custom" for From/To
	From        string // yyyy-mm-dd, only when Range == "custom"
	To          string // yyyy-mm-dd, only when Range == "custom"
	Min         string // raw dollar input, echoed back to the form
	Max         string
	TotalCount  int
	Page       int
	PerPage    int
	HasMore    bool
	MerchantTZ *time.Location
	Now        time.Time // injected so relative dates and staleness are deterministic in tests
	StaffName  string
	StaffRole  string
}

// orderViewTabs returns the tab definitions in display order. Centralizing
// here keeps labels/keys consistent and lets `range` drive the markup.
type orderViewTab struct {
	Key   string
	Label string
	Count int
	// Href overrides the derived "base path + ?view=" link. Set only by tabs
	// that point at a page of their own rather than another view of the same
	// list — the fulfillment queue's Load list is the one case.
	Href string
}

func (p OrderListProps) tabs() []orderViewTab {
	return []orderViewTab{
		{Key: "needs_action", Label: "Open", Count: p.Counts.NeedsAction},
		{Key: "on_hold", Label: "On hold", Count: p.Counts.OnHold},
		{Key: "shipped", Label: "Shipped", Count: p.Counts.Shipped},
		{Key: "archive", Label: "Archive", Count: p.Counts.Archive},
		{Key: "all", Label: "All", Count: p.Counts.All},
	}
}

func (p OrderListProps) showingStart() int {
	if p.TotalCount == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p OrderListProps) showingEnd() int {
	end := p.Page * p.PerPage
	if end > p.TotalCount {
		return p.TotalCount
	}
	return end
}

// orderViewHref builds a URL preserving the search query when switching tabs.
// "needs_action" is the canonical default and renders as a bare basePath.
func orderViewHref(basePath, view, search string) string {
	v := url.Values{}
	if view != "" && view != "needs_action" {
		v.Set("view", view)
	}
	if search != "" {
		v.Set("q", search)
	}
	if len(v) == 0 {
		return basePath
	}
	return basePath + "?" + v.Encode()
}

// orderSortHeader renders a clickable column header. Inactive columns keep a
// dimmed ↕ so they read as sortable before you hover them.
templ orderSortHeader(props OrderListProps, col, label string) {
	<a
		href={ templ.SafeURL(orderSortURL(props, col)) }
		class="inline-flex items-center gap-1 hover:text-rr-red"
		if orderSortIndicator(col, props.Sort) != "" {
			aria-current="true"
		}
	>
		{ label }
		if ind := orderSortIndicator(col, props.Sort); ind != "" {
			<span class="text-rr-red">{ ind }</span>
		} else {
			<span class="text-rr-border" aria-hidden="true">↕</span>
		}
	</a>
}

// orderPillRow renders one labelled row of filter pills.
templ orderPillRow(props OrderListProps, label, dimension, active string, pills []adminListPill) {
	<div class="flex flex-wrap items-center gap-2">
		<span class="label-font text-xs uppercase tracking-wide text-rr-muted">{ label }</span>
		for _, f := range pills {
			<a
				href={ templ.SafeURL(orderFilterURL(props, dimension, f.Value)) }
				class={ adminPillClasses(active == f.Value) }
				if active == f.Value {
					aria-current="page"
				}
			>
				{ f.Label }
			</a>
		}
	</div>
}

// orderHiddenState emits hidden inputs for the filter state a GET form must
// preserve. `except` names the fields that form owns as real inputs — emitting
// them twice would send both values and the stale one could win.
templ orderHiddenState(props OrderListProps, except ...string) {
	for _, f := range orderStateFields(props, except...) {
		<input type="hidden" name={ f.Value } value={ f.Label }/>
	}
}

// orderStateFields lists the current filter state as name/value pairs, minus
// the excluded names. Reuses adminListPill purely as a string pair.
func orderStateFields(props OrderListProps, except ...string) []adminListPill {
	all := []adminListPill{
		{"view", props.View},
		{"q", props.Search},
		{"sort", props.Sort},
		{"payment", props.Payment},
		{"fulfillment", props.Fulfillment},
		{"range", props.Range},
		{"from", props.From},
		{"to", props.To},
		{"min", props.Min},
		{"max", props.Max},
	}
	out := make([]adminListPill, 0, len(all))
	for _, f := range all {
		if f.Label == "" {
			continue
		}
		skip := false
		for _, e := range except {
			if f.Value == e {
				skip = true
				break
			}
		}
		if !skip {
			out = append(out, f)
		}
	}
	return out
}

// orderEmptyBucketCopy returns the body copy shown when a tab has 0 rows
// but other buckets have orders. Per-view phrasing reads more naturally
// than a generic "no orders" line.
func orderEmptyBucketCopy(view string) string {
	switch view {
	case "needs_action":
		return "Inbox zero — no orders waiting on you right now."
	case "on_hold":
		return "Nothing on hold. The line's moving."
	case "shipped":
		return "Nothing shipped yet."
	case "archive":
		return "Archive's empty — no cancelled or refunded orders."
	}
	return "No orders match this view."
}

templ OrderListContent(props OrderListProps) {
	@adminChannelToggle("/admin/orders", "/admin/orders/wholesale", props.BasePath)
	<!-- Page header -->
	<div class="sm:flex sm:items-end sm:justify-between">
		<div>
			<h1 class="admin-page-title">{ props.Title }</h1>
			<p class="mt-1 text-sm text-rr-muted">{ props.Subtitle }</p>
		</div>
		<div class="mt-4 sm:mt-0 flex flex-col items-stretch gap-2 sm:flex-row sm:items-center">
			<a href="/admin/orders/new" class="inline-flex items-center justify-center rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white hover:bg-rr-red/90">+ New manual order</a>
		</div>
	</div>
	<!-- Filter masthead — tabs + search. Sits under the page header as a lighter
	     control strip (no border rules) so it doesn't compete with the H1 band.
	     On desktop tabs live left, search lives right; on mobile they stack
	     with tabs on top (col-reverse). -->
	<section class="mt-4" aria-label="Filter orders">
		<div class="flex flex-col-reverse items-stretch gap-3 md:flex-row md:items-center md:justify-between md:gap-6">
			<!-- View tabs — workflow-led buckets with counts. Active tab is stamped
			     (ink border + hard offset shadow) so the current bucket is unmissable. -->
			<nav class="flex flex-wrap items-center gap-2 label-font" aria-label="Order views">
				for _, tab := range props.tabs() {
					<a href={ templ.SafeURL(orderListURL(props, 1, tab.Key, props.Sort, props.Payment, props.Fulfillment, props.Range, props.From, props.To, props.Min, props.Max, props.Search)) } class={ adminTabClass(props.View == tab.Key) }>
						<span>{ tab.Label }</span>
						<span class={ adminTabCountClass(props.View == tab.Key) }>{ fmt.Sprintf("%d", tab.Count) }</span>
					</a>
				}
			</nav>
			<!-- Search — sits to the right of the tabs on desktop, above on mobile.
			     Submits via htmx on type so the table refreshes inline. -->
			<div class="md:w-72 md:shrink-0">
				<label for="orders-search" class="sr-only">Search orders</label>
				<input
					id="orders-search"
					type="search"
					name="q"
					value={ props.Search }
					placeholder="Search orders, names, companies"
					hx-get={ props.BasePath }
					hx-trigger="input changed delay:300ms, search"
					hx-target="#main-content"
					hx-push-url="true"
					hx-include="[name='view'],[name='sort'],[name='payment'],[name='fulfillment'],[name='range'],[name='from'],[name='to'],[name='min'],[name='max']"
					class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
				/>
				<!-- Carried with the search request so typing never drops the
				     active filters. Every name here must appear in hx-include above. -->
				<input type="hidden" name="view" value={ props.View }/>
				<input type="hidden" name="sort" value={ props.Sort }/>
				<input type="hidden" name="payment" value={ props.Payment }/>
				<input type="hidden" name="fulfillment" value={ props.Fulfillment }/>
				<input type="hidden" name="range" value={ props.Range }/>
				<input type="hidden" name="from" value={ props.From }/>
				<input type="hidden" name="to" value={ props.To }/>
				<input type="hidden" name="min" value={ props.Min }/>
				<input type="hidden" name="max" value={ props.Max }/>
			</div>
		</div>
		<!-- Secondary filter rows. Kept visually quieter than the view tabs:
		     the tabs are the primary workflow split, these narrow within it. -->
		<div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2">
			@orderPillRow(props, "Payment", "payment", props.Payment, orderPaymentPills)
			@orderPillRow(props, "Fulfillment", "fulfillment", props.Fulfillment, orderFulfillmentPills)
			@orderPillRow(props, "Placed", "range", props.Range, orderRangePills)
		</div>
		if props.Range == "custom" {
			<!-- GET form: custom dates and the amount range submit together. -->
			<form method="get" action={ templ.SafeURL(props.BasePath) } class="mt-3 flex flex-wrap items-end gap-3">
				@orderHiddenState(props, "range", "from", "to", "min", "max")
				<input type="hidden" name="range" value="custom"/>
				<div>
					<label for="orders-from" class="label-font block text-xs uppercase tracking-wide text-rr-muted">From</label>
					<input id="orders-from" type="date" name="from" value={ props.From } class="mt-1 rounded-sm bg-rr-surface px-2 py-1 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"/>
				</div>
				<div>
					<label for="orders-to" class="label-font block text-xs uppercase tracking-wide text-rr-muted">To</label>
					<input id="orders-to" type="date" name="to" value={ props.To } class="mt-1 rounded-sm bg-rr-surface px-2 py-1 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"/>
				</div>
				<button type="submit" class="btn-secondary">Apply</button>
			</form>
		}
		<form method="get" action={ templ.SafeURL(props.BasePath) } class="mt-3 flex flex-wrap items-end gap-3">
			@orderHiddenState(props, "min", "max")
			<div>
				<label for="orders-min" class="label-font block text-xs uppercase tracking-wide text-rr-muted">Min total</label>
				<input id="orders-min" type="text" inputmode="decimal" name="min" value={ props.Min } placeholder="$0" class="mt-1 w-24 rounded-sm bg-rr-surface px-2 py-1 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"/>
			</div>
			<div>
				<label for="orders-max" class="label-font block text-xs uppercase tracking-wide text-rr-muted">Max total</label>
				<input id="orders-max" type="text" inputmode="decimal" name="max" value={ props.Max } placeholder="$∞" class="mt-1 w-24 rounded-sm bg-rr-surface px-2 py-1 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"/>
			</div>
			<button type="submit" class="btn-secondary">Apply</button>
			if anyOrderFilterActive(props) {
				<a href={ templ.SafeURL(props.BasePath) } class="pb-1 text-sm font-medium text-rr-red hover:text-rr-red-lt">Clear all</a>
			}
		</form>
	</section>
	<!-- Order table -->
	<div class="mt-4">
		if len(props.Rows) == 0 {
			if props.Search != "" {
				<!-- Empty: search returned no matches -->
				<div class="border border-rr-border bg-rr-surface px-6 py-14 text-center">
					<h2 class="admin-page-title text-2xl">No match.</h2>
					<p class="mt-3 text-sm text-rr-body">{ orderNoMatchMessage(props) }</p>
					<!-- Closest customers, ignoring the active filters — the operator
					     has already found nothing where they were looking. Each links
					     to that customer's orders. -->
					if len(props.Suggestions) > 0 {
						<div class="mx-auto mt-8 max-w-md border-t border-rr-border pt-6 text-left">
							<p class="label-font text-xs uppercase tracking-wide text-rr-muted">Did you mean</p>
							<ul class="mt-3 divide-y divide-rr-border border border-rr-border">
								for _, c := range props.Suggestions {
									<li>
										<a
											href={ templ.SafeURL(orderListURL(props, 1, "all", "", "", "", "", "", "", "", "", c.Email)) }
											class="flex items-center justify-between gap-3 px-3 py-2 text-sm hover:bg-rr-raised"
										>
											<span>
												<span class="font-medium text-rr-heading">{ c.FirstName } { c.LastName }</span>
												if c.CompanyName != nil && *c.CompanyName != "" {
													<span class="text-rr-muted">&nbsp;&middot; { *c.CompanyName }</span>
												}
												<span class="block text-xs text-rr-muted">{ c.Email }</span>
											</span>
											<span class="shrink-0 text-xs font-semibold text-rr-red">Orders &rarr;</span>
										</a>
									</li>
								}
							</ul>
						</div>
					}
					if anyOrderFilterActive(props) {
						<div class="mt-6">
							<a href={ templ.SafeURL(props.BasePath) } class="inline-flex items-center rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading hover:bg-rr-raised">
								Clear search and filters
							</a>
						</div>
					}
				</div>
			} else if orderFiltersBeyondSearchActive(props) {
				<!-- Empty: no search term, but the filters excluded everything. -->
				<div class="border border-rr-border bg-rr-surface px-6 py-14 text-center">
					<h2 class="admin-page-title text-2xl">Nothing matches.</h2>
					<p class="mt-3 text-sm text-rr-body">No orders match the current filters.</p>
					<div class="mt-6">
						<a href={ templ.SafeURL(props.BasePath) } class="inline-flex items-center rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading hover:bg-rr-raised">
							Clear all filters
						</a>
					</div>
				</div>
			} else if props.Counts.All > 0 {
				<!-- Empty: this bucket is empty but other tabs have orders. -->
				<div class="border border-rr-border bg-rr-surface px-6 py-14 text-center">
					<h2 class="admin-page-title text-2xl">Nothing here.</h2>
					<p class="mt-3 text-sm text-rr-body">{ orderEmptyBucketCopy(props.View) }</p>
					if props.View != "all" {
						<a href={ templ.SafeURL(orderViewHref(props.BasePath, "all", "")) } class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-rr-red hover:text-rr-red-lt">
							View all orders &rarr;
						</a>
					}
				</div>
			} else {
				<!-- Empty: no orders ever — branded stamp -->
				<div class="border border-rr-border bg-rr-surface px-6 py-16 sm:py-20 text-center">
					<div
						class="inline-block -rotate-2 border border-rr-border bg-rr-raised px-8 py-3"
						style="box-shadow: 4px 4px 0 0 var(--color-rr-border);"
					>
						<h2 class="admin-page-title">Quiet shop</h2>
					</div>
					<div class="mt-8 text-rr-amber tracking-[0.6em] text-lg select-none" aria-hidden="true">✦ ✦ ✦</div>
					<p class="mt-4 text-base text-rr-body">No orders yet &mdash; they'll roll in when the first one lands.</p>
					<a href="/" target="_blank" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-rr-red hover:text-rr-red-lt">
						View your storefront
						<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
						</svg>
					</a>
				</div>
			}
		} else {
			<div x-data={ orderListAlpineState(props.Rows) }>
				<!-- Affordance hint — surfaces what bulk actions exist for staff who
				     haven't tried the checkboxes yet. Disappears the moment any row
				     is selected; the action bar takes over the same vertical slot. -->
				<p
					x-show="selected.length === 0"
					class="mb-3 text-xs text-rr-muted"
				>
					Select orders to print invoices in bulk. Buying labels lives in Fulfillment.
				</p>
				<!-- Bulk action bar — slides in when rows are selected. -->
				<div
					x-show="selected.length > 0"
					x-cloak
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0 -translate-y-1"
					x-transition:enter-end="opacity-100 translate-y-0"
					x-transition:leave="transition ease-in duration-150"
					x-transition:leave-start="opacity-100"
					x-transition:leave-end="opacity-0"
					class="sticky top-16 z-20 mb-4"
				>
					<div class="flex items-center justify-between gap-3 border border-rr-border bg-rr-surface px-3 py-2 text-sm shadow-sm">
						<span class="text-rr-heading">
							<span class="font-semibold tabular-nums" x-text="selected.length"></span> selected
						</span>
						<div class="flex items-center gap-2">
							<button
								type="button"
								title="Open a print-ready invoice for each selected order in a new tab."
								@click="window.open('/admin/orders/batch/invoices?ids=' + selected.join(','), '_blank')"
								class="inline-flex items-center rounded-sm bg-rr-red px-3 py-1.5 text-sm font-semibold text-white hover:bg-rr-red/90"
							>
								Print invoices
							</button>
							<button
								type="button"
								title="Deselect all rows."
								@click="selected = []"
								class="inline-flex items-center rounded-sm border border-rr-border px-3 py-1.5 text-sm font-medium text-rr-heading hover:bg-rr-raised"
							>
								Clear
							</button>
						</div>
					</div>
				</div>
				<div class="overflow-hidden border border-rr-border bg-rr-surface">
					<table class="min-w-full divide-y divide-rr-border">
						<thead class="bg-rr-raised">
							<tr>
								<th scope="col" class="relative w-10 px-3 py-3.5 sm:pl-6">
									<input
										type="checkbox"
										aria-label="Select all orders on this page"
										class="size-4 cursor-pointer accent-rr-red"
										:checked="selected.length === allIds.length && allIds.length > 0"
										:indeterminate="selected.length > 0 && selected.length < allIds.length"
										@change="selected = $event.target.checked ? [...allIds] : []"
									/>
								</th>
								<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading">
									@orderSortHeader(props, "number", "Order")
								</th>
								<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">State</th>
								<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">Shipping</th>
								<th scope="col" class="px-3 py-3.5 pr-4 sm:pr-6 text-right text-sm font-semibold text-rr-heading">
									@orderSortHeader(props, "total", "Total")
								</th>
								<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading md:table-cell">
									@orderSortHeader(props, "placed", "Placed")
								</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-rr-border bg-rr-surface">
							for _, row := range props.Rows {
								{{ stale := orderIsStale(row.Order, props.MerchantTZ, props.Now) }}
								<tr class={ "row-link", templ.KV("row-link-stale", stale) }>
									<td class="relative z-10 w-10 px-3 py-4 sm:pl-6" @click.stop>
										<input
											type="checkbox"
											aria-label={ fmt.Sprintf("Select order %s", row.Order.Number) }
											class="size-4 cursor-pointer accent-rr-red"
											value={ row.Order.ID.String() }
											x-model="selected"
											@click.stop
										/>
									</td>
									<td class="py-4 pl-4 pr-3 text-sm">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", row.Order.ID)) } class="row-link-target block">
											<div class="flex items-baseline gap-2 leading-none">
												<span class="font-bold text-rr-heading tabular-nums tracking-wide uppercase" style="font-size:0.95rem;">{ row.Order.Number }</span>
												if row.AccountType == domain.AccountTypeWholesale {
													<span class="label-font text-[#0A5E5C]" title="Wholesale customer">Wholesale</span>
												}
											</div>
											<div class="mt-1.5 text-sm text-rr-body">{ row.CustomerName }</div>
											if row.CustomerEmail != "" {
												<div class="mt-0.5 text-xs text-rr-muted truncate max-w-[22ch] md:max-w-none">{ row.CustomerEmail }</div>
											}
										</a>
									</td>
									<td class="whitespace-nowrap px-3 py-4 text-sm">
										<div class="flex flex-wrap items-center gap-1.5">
											if showOrderStatusOverFulfillment(row.Order.Status) {
												@OrderStatusBadge(row.Order.Status)
											} else {
												@FulfillmentStatusBadge(row.Order.FulfillmentStatus)
											}
											if row.LabelFailed {
												<span class="badge badge-red" title="Most recent label purchase failed — open the order to retry.">Label failed</span>
											}
										</div>
									</td>
									<td class="hidden whitespace-nowrap px-3 py-4 text-sm lg:table-cell">
										if row.Order.ShippingMethod != nil {
											@ShippingMethodBadge(*row.Order.ShippingMethod)
										} else {
											<span class="text-rr-muted">&mdash;</span>
										}
									</td>
									<td class="whitespace-nowrap px-3 py-4 pr-4 sm:pr-6 text-sm text-right">
										<div class="inline-flex items-baseline gap-2">
											<span class="text-rr-heading font-semibold tabular-nums">{ formatCents(row.Order.Total) }</span>
											<span class="text-rr-muted" aria-hidden="true">·</span>
											@PaymentChip(row.Order.PaymentStatus)
										</div>
									</td>
									<td class={ "hidden whitespace-nowrap px-3 py-4 text-sm tabular-nums md:table-cell", templ.KV("text-rr-red font-semibold", stale), templ.KV("text-rr-muted", !stale) }>
										{ relativeOrderDate(row.Order.PlacedAt, props.MerchantTZ, props.Now) }
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<!-- Pagination -->
			@orderPagination(props)
		}
	</div>
}

templ orderPagination(props OrderListProps) {
	<nav class="flex items-center justify-between border-t border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
		<div class="-mt-px flex w-0 flex-1">
			if props.Page > 1 {
				<a
					href={ templ.SafeURL(orderPageHref(props, props.Page-1)) }
					class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
				>
					Previous
				</a>
			}
		</div>
		if props.TotalCount > 0 {
			<p class="text-sm text-rr-muted">
				<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingStart()) }</span>–<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingEnd()) }</span> of <span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.TotalCount) }</span>
			</p>
		}
		<div class="-mt-px flex w-0 flex-1 justify-end">
			if props.HasMore {
				<a
					href={ templ.SafeURL(orderPageHref(props, props.Page+1)) }
					class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
				>
					Next
				</a>
			}
		</div>
	</nav>
}

templ OrderList(props OrderListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      props.Title,
		ActivePath: props.BasePath,
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@OrderListContent(props)
	}
}

// orderListURL builds a list URL carrying the entire filter state. Every
// control on the page routes through here so none of them silently drops
// another's state — the bug that makes filter UIs feel broken.
func orderListURL(p OrderListProps, page int, view, sort, payment, fulfillment, rangeKey, from, to, min, max, search string) string {
	v := url.Values{}
	if page > 1 {
		v.Set("page", fmt.Sprintf("%d", page))
	}
	if view != "" && view != "needs_action" {
		v.Set("view", view)
	}
	if search != "" {
		v.Set("q", search)
	}
	if sort != "" && sort != "placed_desc" {
		v.Set("sort", sort)
	}
	if payment != "" {
		v.Set("payment", payment)
	}
	if fulfillment != "" {
		v.Set("fulfillment", fulfillment)
	}
	if rangeKey != "" {
		v.Set("range", rangeKey)
		if rangeKey == "custom" {
			if from != "" {
				v.Set("from", from)
			}
			if to != "" {
				v.Set("to", to)
			}
		}
	}
	if min != "" {
		v.Set("min", min)
	}
	if max != "" {
		v.Set("max", max)
	}
	if len(v) == 0 {
		return p.BasePath
	}
	return p.BasePath + "?" + v.Encode()
}

// orderStateURL is the everything-preserved URL for the current props.
func orderStateURL(p OrderListProps, page int) string {
	return orderListURL(p, page, p.View, p.Sort, p.Payment, p.Fulfillment, p.Range, p.From, p.To, p.Min, p.Max, p.Search)
}

// orderPageHref builds a pagination href, carrying every active filter.
func orderPageHref(p OrderListProps, page int) string {
	return orderStateURL(p, page)
}

// orderFilterURL changes one filter dimension and resets to page 1 — paging is
// only meaningful relative to a result set.
func orderFilterURL(p OrderListProps, dimension, value string) string {
	payment, fulfillment, rangeKey := p.Payment, p.Fulfillment, p.Range
	from, to := p.From, p.To
	switch dimension {
	case "payment":
		payment = value
	case "fulfillment":
		fulfillment = value
	case "range":
		rangeKey = value
		if value != "custom" {
			from, to = "", ""
		}
	}
	return orderListURL(p, 1, p.View, p.Sort, payment, fulfillment, rangeKey, from, to, p.Min, p.Max, p.Search)
}

// orderSortURL builds the href for a sortable column header.
func orderSortURL(p OrderListProps, col string) string {
	return orderListURL(p, 1, p.View, orderSortToggle(col, p.Sort), p.Payment, p.Fulfillment, p.Range, p.From, p.To, p.Min, p.Max, p.Search)
}

// orderSortToggle returns the next sort value when a header is clicked.
// Clicking the active column flips direction; an inactive column starts in the
// more useful direction (biggest money first, newest date first, A–Z numbers).
func orderSortToggle(col, current string) string {
	switch col {
	case "placed":
		if current == "placed_desc" || current == "" {
			return "placed_asc"
		}
		return "placed_desc"
	case "total":
		if current == "total_desc" {
			return "total_asc"
		}
		return "total_desc"
	case "number":
		if current == "number_asc" {
			return "number_desc"
		}
		return "number_asc"
	}
	return ""
}

// orderSortIndicator returns the arrow for a column, or "" if it isn't active.
func orderSortIndicator(col, current string) string {
	switch current {
	case "placed_asc":
		if col == "placed" {
			return "↑"
		}
	case "", "placed_desc":
		if col == "placed" {
			return "↓"
		}
	case "total_asc":
		if col == "total" {
			return "↑"
		}
	case "total_desc":
		if col == "total" {
			return "↓"
		}
	case "number_asc":
		if col == "number" {
			return "↑"
		}
	case "number_desc":
		if col == "number" {
			return "↓"
		}
	}
	return ""
}

// anyOrderFilterActive reports whether anything beyond the default view is
// narrowing the list — drives the "Clear all" escape hatch.
func anyOrderFilterActive(p OrderListProps) bool {
	return p.Search != "" || p.Payment != "" || p.Fulfillment != "" ||
		p.Range != "" || p.Min != "" || p.Max != "" || p.Sort != "" && p.Sort != "placed_desc"
}

// orderFiltersBeyondSearchActive reports whether a filter other than the search
// term is narrowing the list, so the empty state can say which is to blame.
func orderFiltersBeyondSearchActive(p OrderListProps) bool {
	return p.Payment != "" || p.Fulfillment != "" || p.Range != "" || p.Min != "" || p.Max != ""
}

// orderNoMatchMessage is built in Go so punctuation lands tight against the
// closing quote — templ inserts whitespace between adjacent expressions.
func orderNoMatchMessage(p OrderListProps) string {
	if orderFiltersBeyondSearchActive(p) {
		return fmt.Sprintf("Nothing for %q with the current filters.", p.Search)
	}
	return fmt.Sprintf("Nothing for %q. Try a different angle — name, email, company, or order number.", p.Search)
}

var orderPaymentPills = []adminListPill{
	{"", "Any"},
	{"captured", "Captured"},
	{"awaiting", "Awaiting"},
	{"pending_invoice", "Invoiced"},
	{"refunded", "Refunded"},
	{"failed", "Failed"},
}

var orderFulfillmentPills = []adminListPill{
	{"", "Any"},
	{"unfulfilled", "Unfulfilled"},
	{"fulfilled", "Fulfilled"},
	{"delivered", "Delivered"},
}

var orderRangePills = []adminListPill{
	{"", "All time"},
	{"today", "Today"},
	{"7d", "7 days"},
	{"30d", "30 days"},
	{"month", "This month"},
	{"custom", "Custom"},
}

