package admin

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// OrderRow bundles an order with the customer summary fields the list needs
// to render at a glance: display name, email, and account type. Built in the
// handler from per-order customer lookups (bounded by page size).
type OrderRow struct {
	Order         domain.Order
	CustomerName  string
	CustomerEmail string
	AccountType   domain.AccountType
}

// showOrderStatusOverFulfillment decides which badge to show in the single
// State column. Order status wins for non-active states (cancelled / refunded /
// on_hold / pending) since fulfillment is irrelevant or ambiguous in those
// cases. Otherwise fulfillment status — the actionable signal for staff —
// takes the slot.
func showOrderStatusOverFulfillment(s domain.OrderStatus) bool {
	switch s {
	case domain.OrderStatusCancelled,
		domain.OrderStatusRefunded,
		domain.OrderStatusOnHold,
		domain.OrderStatusPending:
		return true
	}
	return false
}

// orderListIDsJSON serializes the visible order IDs into a JS array literal so
// Alpine's "select all on this page" knows the full set. UUIDs contain no
// characters that need escaping, so simple string interpolation is safe.
func orderListIDsJSON(rows []OrderRow) string {
	if len(rows) == 0 {
		return "[]"
	}
	parts := make([]string, len(rows))
	for i, r := range rows {
		parts[i] = `"` + r.Order.ID.String() + `"`
	}
	return "[" + strings.Join(parts, ",") + "]"
}

func orderListAlpineState(rows []OrderRow) string {
	return "{ selected: [], allIds: " + orderListIDsJSON(rows) + " }"
}

func formatCents(cents int) string {
	return fmt.Sprintf("$%d.%02d", cents/100, cents%100)
}

// relativeOrderDate formats a placed-at date in merchant time relative to
// "now" so staff can scan freshness at a glance instead of doing date math.
// Returns "Today 3:04 PM", "Yesterday", "Nd ago" (2-6), "Jan 2" (this year),
// or "Jan 2, 2006" (prior years).
func relativeOrderDate(placedAt time.Time, tz *time.Location, now time.Time) string {
	placed := placedAt.In(tz)
	today := now.In(tz)
	startOfToday := time.Date(today.Year(), today.Month(), today.Day(), 0, 0, 0, 0, tz)
	startOfPlaced := time.Date(placed.Year(), placed.Month(), placed.Day(), 0, 0, 0, 0, tz)
	dayDiff := int(startOfToday.Sub(startOfPlaced).Hours() / 24)
	switch {
	case dayDiff <= 0:
		return "Today " + placed.Format("3:04 PM")
	case dayDiff == 1:
		return "Yesterday"
	case dayDiff < 7:
		return fmt.Sprintf("%dd ago", dayDiff)
	}
	if placed.Year() == today.Year() {
		return placed.Format("Jan 2")
	}
	return placed.Format("Jan 2, 2006")
}

// orderIsStale returns true when an order is in a non-terminal status and
// has been sitting for at least 48 hours. Drives the rust-flag accent on
// the row's leading edge — staff's visual cue that the order is overdue
// for attention. Pending intents are excluded since they're awaiting
// payment, not action.
func orderIsStale(o domain.Order, now time.Time) bool {
	switch o.Status {
	case domain.OrderStatusConfirmed, domain.OrderStatusProcessing, domain.OrderStatusOnHold:
		return now.Sub(o.PlacedAt) >= 48*time.Hour
	}
	return false
}

// OrderViewCounts holds tab counts for the orders list. Mirrors
// store.OrderViewCounts so the ui package stays free of store imports.
type OrderViewCounts struct {
	NeedsAction int
	OnHold      int
	Shipped     int
	Archive     int
	All         int
}

type OrderListProps struct {
	Rows       []OrderRow
	View       string // one of: needs_action | on_hold | shipped | archive | all
	Counts     OrderViewCounts
	Search     string
	TotalCount int
	Page       int
	PerPage    int
	HasMore    bool
	MerchantTZ *time.Location
	Now        time.Time // injected so relative dates and staleness are deterministic in tests
	StaffName  string
	StaffRole  string
}

// orderViewTabs returns the tab definitions in display order. Centralizing
// here keeps labels/keys consistent and lets `range` drive the markup.
type orderViewTab struct {
	Key   string
	Label string
	Count int
}

func (p OrderListProps) tabs() []orderViewTab {
	return []orderViewTab{
		{Key: "needs_action", Label: "Needs action", Count: p.Counts.NeedsAction},
		{Key: "on_hold", Label: "On hold", Count: p.Counts.OnHold},
		{Key: "shipped", Label: "Shipped", Count: p.Counts.Shipped},
		{Key: "archive", Label: "Archive", Count: p.Counts.Archive},
		{Key: "all", Label: "All", Count: p.Counts.All},
	}
}

func (p OrderListProps) showingStart() int {
	if p.TotalCount == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p OrderListProps) showingEnd() int {
	end := p.Page * p.PerPage
	if end > p.TotalCount {
		return p.TotalCount
	}
	return end
}

// orderViewHref builds a URL preserving the search query when switching tabs.
// "needs_action" is the canonical default and renders as a bare /admin/orders.
func orderViewHref(view, search string) string {
	v := url.Values{}
	if view != "" && view != "needs_action" {
		v.Set("view", view)
	}
	if search != "" {
		v.Set("q", search)
	}
	if len(v) == 0 {
		return "/admin/orders"
	}
	return "/admin/orders?" + v.Encode()
}

// orderTabClass returns the class for an order-view tab. The active tab gets
// the paper-and-ink stamp treatment: ink border, hard offset shadow, cream
// surface — visually pasted on top of the row of inactive labels.
func orderTabClass(active bool) string {
	if active {
		return "relative shrink-0 whitespace-nowrap inline-flex items-center gap-2 border-2 border-rr-border bg-rr-surface px-3.5 py-2 text-rr-heading shadow-[4px_4px_0_0_var(--color-rr-border)] z-10"
	}
	return "shrink-0 whitespace-nowrap inline-flex items-center gap-2 border-2 border-transparent px-3.5 py-2 text-rr-muted hover:text-rr-heading hover:bg-rr-raised transition-colors"
}

// orderEmptyBucketCopy returns the body copy shown when a tab has 0 rows
// but other buckets have orders. Per-view phrasing reads more naturally
// than a generic "no orders" line.
func orderEmptyBucketCopy(view string) string {
	switch view {
	case "needs_action":
		return "Inbox zero — no orders waiting on you right now."
	case "on_hold":
		return "Nothing on hold. The line's moving."
	case "shipped":
		return "Nothing shipped yet."
	case "archive":
		return "Archive's empty — no cancelled or refunded orders."
	}
	return "No orders match this view."
}

// orderTabCountClass returns the chip class beside each tab label. The active
// tab's count chip pops in rust to draw the eye to "you have N here";
// inactive chips sit quiet on raised paper.
func orderTabCountClass(active bool) string {
	if active {
		return "inline-flex items-center justify-center min-w-[1.25rem] px-1.5 py-px bg-rr-red text-white text-[0.65rem] font-bold tabular-nums tracking-wider"
	}
	return "inline-flex items-center justify-center min-w-[1.25rem] px-1.5 py-px bg-rr-raised text-rr-body text-[0.65rem] font-bold tabular-nums tracking-wider"
}

templ OrderListContent(props OrderListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-end sm:justify-between">
		<div>
			<h1 class="admin-page-title">Orders</h1>
			<p class="mt-2 label-font text-rr-amber" style="font-size:0.65rem;">✦ The daybook</p>
		</div>
		<div class="mt-4 sm:mt-0">
			<a href="/admin/orders/new" class="inline-flex items-center rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white hover:bg-rr-red/90">+ New manual order</a>
		</div>
	</div>
	<!-- Filter masthead — newspaper-style section break holding the view tabs
	     and search as one composable unit. Edge-to-edge ink rules top/bottom
	     bind them visually; on desktop tabs live left, search lives right;
	     on mobile they stack with tabs on top (col-reverse). -->
	<section class="mt-6 border-y-2 border-rr-border py-3" aria-label="Filter orders">
		<div class="flex flex-col-reverse items-stretch gap-3 md:flex-row md:items-center md:justify-between md:gap-6">
			<!-- View tabs — workflow-led buckets with counts. Active tab is stamped
			     (ink border + hard offset shadow) so the current bucket is unmissable. -->
			<nav class="flex flex-wrap items-center gap-2 label-font" aria-label="Order views">
				for _, tab := range props.tabs() {
					<a href={ templ.SafeURL(orderViewHref(tab.Key, props.Search)) } class={ orderTabClass(props.View == tab.Key) }>
						<span>{ tab.Label }</span>
						<span class={ orderTabCountClass(props.View == tab.Key) }>{ fmt.Sprintf("%d", tab.Count) }</span>
					</a>
				}
			</nav>
			<!-- Search — sits to the right of the tabs on desktop, above on mobile.
			     Submits via htmx on type so the table refreshes inline. -->
			<div class="md:w-72 md:shrink-0">
				<label for="orders-search" class="sr-only">Search orders</label>
				<input
					id="orders-search"
					type="search"
					name="q"
					value={ props.Search }
					placeholder="Search orders, names, emails"
					hx-get={ orderViewHref(props.View, "") }
					hx-trigger="input changed delay:300ms, search"
					hx-target="#main-content"
					hx-push-url="true"
					hx-include="[name='view']"
					class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
				/>
				<input type="hidden" name="view" value={ props.View }/>
			</div>
		</div>
	</section>
	<!-- Order table -->
	<div class="mt-4">
		if len(props.Rows) == 0 {
			if props.Search != "" {
				<!-- Empty: search returned no matches -->
				<div class="border-2 border-rr-border bg-rr-surface px-6 py-14 text-center">
					<h2 class="admin-page-title text-2xl">No match.</h2>
					<p class="mt-3 text-sm text-rr-body">Nothing for &ldquo;{ props.Search }&rdquo;. Try a different angle &mdash; name, email, or order number.</p>
				</div>
			} else if props.Counts.All > 0 {
				<!-- Empty: this bucket is empty but other tabs have orders. -->
				<div class="border-2 border-rr-border bg-rr-surface px-6 py-14 text-center">
					<h2 class="admin-page-title text-2xl">Nothing here.</h2>
					<p class="mt-3 text-sm text-rr-body">{ orderEmptyBucketCopy(props.View) }</p>
					if props.View != "all" {
						<a href={ templ.SafeURL(orderViewHref("all", "")) } class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-rr-red hover:text-rr-red-lt">
							View all orders &rarr;
						</a>
					}
				</div>
			} else {
				<!-- Empty: no orders ever — branded stamp -->
				<div class="border-2 border-rr-border bg-rr-surface px-6 py-16 sm:py-20 text-center">
					<div
						class="inline-block -rotate-2 border-2 border-rr-border bg-rr-raised px-8 py-3"
						style="box-shadow: 4px 4px 0 0 var(--color-rr-border);"
					>
						<h2 class="admin-page-title">Quiet shop</h2>
					</div>
					<div class="mt-8 text-rr-amber tracking-[0.6em] text-lg select-none" aria-hidden="true">✦ ✦ ✦</div>
					<p class="mt-4 text-base text-rr-body">No orders yet &mdash; they'll roll in when the first one lands.</p>
					<a href="/" target="_blank" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-rr-red hover:text-rr-red-lt">
						View your storefront
						<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
						</svg>
					</a>
				</div>
			}
		} else {
			<div x-data={ orderListAlpineState(props.Rows) }>
				<!-- Bulk action bar — stamps in below the admin top bar when rows are selected. -->
				<div
					x-show="selected.length > 0"
					x-cloak
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0 -translate-y-1"
					x-transition:enter-end="opacity-100 translate-y-0"
					x-transition:leave="transition ease-in duration-150"
					x-transition:leave-start="opacity-100"
					x-transition:leave-end="opacity-0"
					class="sticky top-16 z-20 mb-4 flex items-center justify-between gap-3 border-2 border-rr-border bg-rr-surface px-3 py-2 text-sm shadow-[4px_4px_0_0_#0E0D0C]"
				>
					<span class="text-rr-heading">
						<span class="font-semibold tabular-nums" x-text="selected.length"></span> selected
					</span>
					<div class="flex items-center gap-2">
						<button
							type="button"
							@click="window.open('/admin/orders/batch/invoices?ids=' + selected.join(','), '_blank')"
							class="inline-flex items-center rounded-sm bg-rr-red px-3 py-1.5 text-sm font-semibold text-white hover:bg-rr-red/90"
						>
							Print invoices
						</button>
						<button
							type="button"
							@click="selected = []"
							class="inline-flex items-center rounded-sm border-2 border-rr-border px-3 py-1.5 text-sm font-medium text-rr-heading hover:bg-rr-raised"
						>
							Clear
						</button>
					</div>
				</div>
				<div class="overflow-hidden border-2 border-rr-border bg-rr-surface">
					<table class="min-w-full divide-y divide-rr-border">
						<thead class="bg-rr-raised">
							<tr>
								<th scope="col" class="relative w-10 px-3 py-3.5 sm:pl-6">
									<input
										type="checkbox"
										aria-label="Select all orders on this page"
										class="size-4 cursor-pointer accent-rr-red"
										:checked="selected.length === allIds.length && allIds.length > 0"
										:indeterminate="selected.length > 0 && selected.length < allIds.length"
										@change="selected = $event.target.checked ? [...allIds] : []"
									/>
								</th>
								<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading">Order</th>
								<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
								<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">Shipping</th>
								<th scope="col" class="px-3 py-3.5 pr-4 sm:pr-6 text-right text-sm font-semibold text-rr-heading">Total</th>
								<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading md:table-cell">Placed</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-rr-border bg-rr-surface">
							for _, row := range props.Rows {
								{{ stale := orderIsStale(row.Order, props.Now) }}
								<tr class={ "row-link", templ.KV("row-link-stale", stale) }>
									<td class="relative z-10 w-10 px-3 py-4 sm:pl-6" @click.stop>
										<input
											type="checkbox"
											aria-label={ fmt.Sprintf("Select order %s", row.Order.Number) }
											class="size-4 cursor-pointer accent-rr-red"
											value={ row.Order.ID.String() }
											x-model="selected"
											@click.stop
										/>
									</td>
									<td class="py-4 pl-4 pr-3 text-sm">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", row.Order.ID)) } class="row-link-target block">
											<div class="flex items-baseline gap-2 leading-none">
												<span class="font-bold text-rr-heading tabular-nums tracking-wide uppercase" style="font-size:0.95rem;">{ row.Order.Number }</span>
												if row.AccountType == domain.AccountTypeWholesale {
													<span class="label-font text-[#0A5E5C]" title="Wholesale customer">Wholesale</span>
												}
											</div>
											<div class="mt-1.5 text-sm text-rr-body">{ row.CustomerName }</div>
											if row.CustomerEmail != "" {
												<div class="mt-0.5 text-xs text-rr-muted truncate max-w-[22ch] md:max-w-none">{ row.CustomerEmail }</div>
											}
										</a>
									</td>
									<td class="whitespace-nowrap px-3 py-4 text-sm">
										if showOrderStatusOverFulfillment(row.Order.Status) {
											@OrderStatusBadge(row.Order.Status)
										} else {
											@FulfillmentStatusBadge(row.Order.FulfillmentStatus)
										}
									</td>
									<td class="hidden whitespace-nowrap px-3 py-4 text-sm lg:table-cell">
										if row.Order.ShippingMethod != nil {
											@ShippingMethodBadge(*row.Order.ShippingMethod)
										} else {
											<span class="text-rr-muted">&mdash;</span>
										}
									</td>
									<td class="whitespace-nowrap px-3 py-4 pr-4 sm:pr-6 text-sm text-right">
										<div class="inline-flex items-baseline gap-2">
											<span class="text-rr-heading font-semibold tabular-nums">{ formatCents(row.Order.Total) }</span>
											<span class="text-rr-muted" aria-hidden="true">·</span>
											@PaymentChip(row.Order.PaymentStatus)
										</div>
									</td>
									<td class={ "hidden whitespace-nowrap px-3 py-4 text-sm tabular-nums md:table-cell", templ.KV("text-rr-red font-semibold", stale), templ.KV("text-rr-muted", !stale) }>
										{ relativeOrderDate(row.Order.PlacedAt, props.MerchantTZ, props.Now) }
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<!-- Pagination -->
			@orderPagination(props)
		}
	</div>
}

templ orderPagination(props OrderListProps) {
	<nav class="flex items-center justify-between border-t-2 border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
		<div class="-mt-px flex w-0 flex-1">
			if props.Page > 1 {
				<a
					href={ templ.SafeURL(orderPageHref(props.Page-1, props.View, props.Search)) }
					class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border-2 border-rr-border hover:bg-rr-raised"
				>
					Previous
				</a>
			}
		</div>
		if props.TotalCount > 0 {
			<p class="text-sm text-rr-muted">
				<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingStart()) }</span>–<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingEnd()) }</span> of <span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.TotalCount) }</span>
			</p>
		}
		<div class="-mt-px flex w-0 flex-1 justify-end">
			if props.HasMore {
				<a
					href={ templ.SafeURL(orderPageHref(props.Page+1, props.View, props.Search)) }
					class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border-2 border-rr-border hover:bg-rr-raised"
				>
					Next
				</a>
			}
		</div>
	</nav>
}

templ OrderList(props OrderListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Orders",
		ActivePath: "/admin/orders",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@OrderListContent(props)
	}
}

func orderPageHref(page int, view, search string) string {
	v := url.Values{}
	v.Set("page", fmt.Sprintf("%d", page))
	if view != "" && view != "needs_action" {
		v.Set("view", view)
	}
	if search != "" {
		v.Set("q", search)
	}
	return "/admin/orders?" + v.Encode()
}
