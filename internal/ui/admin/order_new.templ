package admin

import (
	"fmt"
	"strconv"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type OrderNewItemRow struct {
	SKU       string
	Quantity  string
	UnitPrice string // dollar string as entered, e.g. "18.00"
}

type OrderNewForm struct {
	CustomerEmail         string
	CustomerFirstName     string
	CustomerLastName      string
	ShippingFirstName     string
	ShippingLastName      string
	ShippingLine1         string
	ShippingLine2         string
	ShippingCity          string
	ShippingState         string
	ShippingPostalCode    string
	ShippingCountry       string
	Items                 []OrderNewItemRow
	Subtotal              string // dollar strings as entered, e.g. "18.00"
	Discount              string
	Shipping              string
	Tax                   string
	Total                 string
	StripePaymentIntentID string
	PaymentStatus         string
	OrderStatus           string
	Notes                 string
}

// Country returns the ISO country code, defaulting to "US" when blank.
func (f OrderNewForm) Country() string {
	if f.ShippingCountry == "" {
		return "US"
	}
	return f.ShippingCountry
}

type OrderNewProps struct {
	Form        OrderNewForm
	FieldErrors map[string]string
	Banner      string
	StaffName   string
	StaffRole   string
}

func selected(v, target string) bool {
	return v == target
}

templ OrderNewContent(props OrderNewProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">New manual order</h1>
			<p class="mt-1 text-sm text-rr-muted">For reconciliation, phone orders, or one-off entries. No tax or shipping is calculated — totals are accepted as entered.</p>
		</div>
		<div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
			<a
				href="/admin/orders"
				class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
			>Back to orders</a>
		</div>
	</div>
	if props.Banner != "" {
		<div class="mt-6 border border-red-300 bg-red-50 p-3 text-sm text-red-800">
			{ props.Banner }
		</div>
	}
	<form method="post" action="/admin/orders/new" class="mt-6">
		<div class="space-y-8" x-data={ orderNewItemsState(props.Form, props.FieldErrors) } x-init="recompute()">
			<!-- Customer -->
			<div class="border-b border-rr-border pb-8">
				<h2 class="text-base/7 font-semibold text-rr-heading">Customer</h2>
				<p class="mt-1 text-sm/6 text-rr-muted">Existing customers are matched by email. Provide a first and last name to create a new customer if no match.</p>
				<div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6">
					<div class="sm:col-span-3">
						<label class="block text-sm/6 font-medium text-rr-heading" for="customer_email">Email</label>
						<input id="customer_email" name="customer_email" type="email" required value={ props.Form.CustomerEmail } class={ inputClasses(hasError(props.FieldErrors, "customer_email")) }/>
						if msg := getError(props.FieldErrors, "customer_email"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<div class="sm:col-span-3"></div>
					<div class="sm:col-span-3">
						<label class="block text-sm/6 font-medium text-rr-heading" for="customer_first_name">First name <span class="text-rr-muted">(only if creating)</span></label>
						<input id="customer_first_name" name="customer_first_name" type="text" value={ props.Form.CustomerFirstName } class={ inputClasses(false) }/>
					</div>
					<div class="sm:col-span-3">
						<label class="block text-sm/6 font-medium text-rr-heading" for="customer_last_name">Last name</label>
						<input id="customer_last_name" name="customer_last_name" type="text" value={ props.Form.CustomerLastName } class={ inputClasses(false) }/>
					</div>
				</div>
			</div>
			<!-- Shipping address -->
			<div class="border-b border-rr-border pb-8">
				<h2 class="text-base/7 font-semibold text-rr-heading">Shipping address</h2>
				<p class="mt-1 text-sm/6 text-rr-muted">A new address is created and used for both shipping and billing.</p>
				<div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6">
					<div class="sm:col-span-3">
						<label class="block text-sm/6 font-medium text-rr-heading" for="shipping_first_name">First name</label>
						<input id="shipping_first_name" name="shipping_first_name" type="text" required value={ props.Form.ShippingFirstName } class={ inputClasses(hasError(props.FieldErrors, "shipping_first_name")) }/>
						if msg := getError(props.FieldErrors, "shipping_first_name"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<div class="sm:col-span-3">
						<label class="block text-sm/6 font-medium text-rr-heading" for="shipping_last_name">Last name</label>
						<input id="shipping_last_name" name="shipping_last_name" type="text" required value={ props.Form.ShippingLastName } class={ inputClasses(hasError(props.FieldErrors, "shipping_last_name")) }/>
						if msg := getError(props.FieldErrors, "shipping_last_name"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<div class="col-span-full">
						<label class="block text-sm/6 font-medium text-rr-heading" for="shipping_line1">Address line 1</label>
						<input id="shipping_line1" name="shipping_line1" type="text" required value={ props.Form.ShippingLine1 } class={ inputClasses(hasError(props.FieldErrors, "shipping_line1")) }/>
						if msg := getError(props.FieldErrors, "shipping_line1"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<div class="col-span-full">
						<label class="block text-sm/6 font-medium text-rr-heading" for="shipping_line2">Address line 2</label>
						<input id="shipping_line2" name="shipping_line2" type="text" value={ props.Form.ShippingLine2 } class={ inputClasses(false) }/>
					</div>
					<div class="sm:col-span-2">
						<label class="block text-sm/6 font-medium text-rr-heading" for="shipping_city">City</label>
						<input id="shipping_city" name="shipping_city" type="text" required value={ props.Form.ShippingCity } class={ inputClasses(hasError(props.FieldErrors, "shipping_city")) }/>
						if msg := getError(props.FieldErrors, "shipping_city"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<div class="sm:col-span-2">
						<label class="block text-sm/6 font-medium text-rr-heading" for="shipping_state">State</label>
						<input id="shipping_state" name="shipping_state" type="text" required maxlength="2" placeholder="WA" value={ props.Form.ShippingState } class={ inputClasses(hasError(props.FieldErrors, "shipping_state")) }/>
						if msg := getError(props.FieldErrors, "shipping_state"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<div class="sm:col-span-1">
						<label class="block text-sm/6 font-medium text-rr-heading" for="shipping_postal_code">ZIP</label>
						<input id="shipping_postal_code" name="shipping_postal_code" type="text" required value={ props.Form.ShippingPostalCode } class={ inputClasses(hasError(props.FieldErrors, "shipping_postal_code")) }/>
						if msg := getError(props.FieldErrors, "shipping_postal_code"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<div class="sm:col-span-1">
						<label class="block text-sm/6 font-medium text-rr-heading" for="shipping_country">Country</label>
						<input id="shipping_country" name="shipping_country" type="text" maxlength="2" value={ props.Form.Country() } class={ inputClasses(false) }/>
					</div>
				</div>
			</div>
			<!-- Line items -->
			<div class="border-b border-rr-border pb-8">
				<div class="flex items-center justify-between">
					<div>
						<h2 class="text-base/7 font-semibold text-rr-heading">Line items</h2>
						<p class="mt-1 text-sm/6 text-rr-muted">Search the catalog to add a product, or type a SKU by hand. Prices are in dollars.</p>
					</div>
					<button type="button" @click="add()" class="inline-flex items-center rounded-sm px-3 py-1.5 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised">+ Add line</button>
				</div>
				if msg := getError(props.FieldErrors, "items"); msg != "" {
					<p class="mt-2 text-sm text-red-600">{ msg }</p>
				}
				<!-- Product search: typeahead that fills a line on pick -->
				<div class="mt-4 relative" @click.outside="$refs.results.innerHTML = ''">
					<input
						type="search"
						name="q"
						x-model="query"
						placeholder="Search products by name or SKU…"
						autocomplete="off"
						hx-boost="false"
						hx-get="/admin/orders/variant-search"
						hx-trigger="input changed delay:250ms"
						hx-target="#variant-search-results"
						hx-swap="innerHTML"
						hx-sync="this:replace"
						hx-push-url="false"
						class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
					/>
					<div
						id="variant-search-results"
						x-ref="results"
						@click="onPick($event)"
						class="absolute z-10 mt-1 w-full overflow-hidden rounded-sm border border-rr-border bg-rr-surface shadow-sm empty:hidden"
					></div>
				</div>
				<div class="mt-4 space-y-3">
					<template x-for="(row, i) in rows" :key="i">
						<div class="grid grid-cols-1 gap-x-3 gap-y-2 sm:grid-cols-12 items-start border-b border-rr-border/50 pb-3">
							<div class="sm:col-span-5">
								<label class="block text-xs/5 font-medium text-rr-muted" :for="'sku-' + i">
									SKU
									<span x-show="row.label" class="ml-1 font-normal text-rr-body" x-text="row.label"></span>
								</label>
								<input :id="'sku-' + i" name="item_sku" type="text" x-model="row.sku" placeholder="e.g. CFE-001-12OZ" class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 focus:outline-2 focus:-outline-offset-2" :class="row.skuErr ? 'outline-red-300 focus:outline-red-500' : 'outline-rr-border focus:outline-rr-red'"/>
								<p x-show="row.skuErr" x-text="row.skuErr" class="mt-1 text-xs text-red-600"></p>
							</div>
							<div class="sm:col-span-2">
								<label class="block text-xs/5 font-medium text-rr-muted" :for="'qty-' + i">Qty</label>
								<input :id="'qty-' + i" name="item_quantity" type="number" min="1" x-model="row.quantity" @input="recompute()" class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 focus:outline-2 focus:-outline-offset-2" :class="row.qtyErr ? 'outline-red-300 focus:outline-red-500' : 'outline-rr-border focus:outline-rr-red'"/>
								<p x-show="row.qtyErr" x-text="row.qtyErr" class="mt-1 text-xs text-red-600"></p>
							</div>
							<div class="sm:col-span-3">
								<label class="block text-xs/5 font-medium text-rr-muted" :for="'price-' + i">Unit price</label>
								<div class="relative">
									<span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-sm text-rr-muted">$</span>
									<input :id="'price-' + i" name="item_unit_price" type="text" inputmode="decimal" x-model="row.price" @input="recompute()" placeholder="18.00" class="block w-full rounded-sm bg-rr-surface pl-7 pr-3 py-1.5 text-sm tabular-nums text-rr-heading outline-1 -outline-offset-1 focus:outline-2 focus:-outline-offset-2" :class="row.priceErr ? 'outline-red-300 focus:outline-red-500' : 'outline-rr-border focus:outline-rr-red'"/>
								</div>
								<p x-show="row.priceErr" x-text="row.priceErr" class="mt-1 text-xs text-red-600"></p>
							</div>
							<div class="sm:col-span-2 flex justify-end pt-6">
								<button type="button" @click="remove(i)" class="text-sm text-red-700 hover:underline">Remove</button>
							</div>
						</div>
					</template>
				</div>
				<p class="mt-3 text-sm text-rr-muted">
					Line items total
					<span class="font-medium tabular-nums text-rr-body">$<span x-text="money(lineSubtotal())"></span></span>
				</p>
			</div>
			<!-- Totals -->
			<div class="border-b border-rr-border pb-8">
				<h2 class="text-base/7 font-semibold text-rr-heading">Totals</h2>
				<p class="mt-1 text-sm/6 text-rr-muted">Subtotal and total fill in from the line items — edit any field to override. Dollars, e.g. <code>18.00</code>.</p>
				<div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-5">
					<div>
						<label class="block text-sm/6 font-medium text-rr-heading" for="subtotal">Subtotal</label>
						@dollarInput("subtotal", "subtotal", "subtotalDirty = true; recompute()", false, hasError(props.FieldErrors, "subtotal"))
						<p x-show="subtotalMismatch()" x-cloak class="mt-2 text-xs text-rr-body">
							Lines total $<span x-text="money(lineSubtotal())" class="tabular-nums"></span>.
							<button type="button" @click="applySubtotal()" class="font-semibold text-rr-red underline">Use that</button>
						</p>
						if msg := getError(props.FieldErrors, "subtotal"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<div>
						<label class="block text-sm/6 font-medium text-rr-heading" for="discount">Discount</label>
						@dollarInput("discount", "discount", "recompute()", false, hasError(props.FieldErrors, "discount"))
					</div>
					<div>
						<label class="block text-sm/6 font-medium text-rr-heading" for="shipping">Shipping</label>
						@dollarInput("shipping", "shipping", "recompute()", false, hasError(props.FieldErrors, "shipping"))
					</div>
					<div>
						<label class="block text-sm/6 font-medium text-rr-heading" for="tax">Tax</label>
						@dollarInput("tax", "tax", "recompute()", false, hasError(props.FieldErrors, "tax"))
					</div>
					<div>
						<label class="block text-sm/6 font-medium text-rr-heading" for="total">Total</label>
						@dollarInput("total", "total", "totalDirty = true", true, hasError(props.FieldErrors, "total"))
						<p x-show="totalMismatch()" x-cloak class="mt-2 text-xs text-rr-body">
							Subtotal − discount + shipping + tax = $<span x-text="money(expectedTotal())" class="tabular-nums"></span>.
							<button type="button" @click="applyTotal()" class="font-semibold text-rr-red underline">Use that</button>
						</p>
						if msg := getError(props.FieldErrors, "total"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
				</div>
			</div>
			<!-- Payment & status -->
			<div class="border-b border-rr-border pb-8">
				<h2 class="text-base/7 font-semibold text-rr-heading">Payment & status</h2>
				<div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6">
					<div class="sm:col-span-3">
						<label class="block text-sm/6 font-medium text-rr-heading" for="stripe_payment_intent_id">Stripe payment intent ID <span class="text-rr-muted">(optional)</span></label>
						<input id="stripe_payment_intent_id" name="stripe_payment_intent_id" type="text" placeholder="pi_..." value={ props.Form.StripePaymentIntentID } class={ inputClasses(false) }/>
						<p class="mt-2 text-xs text-rr-muted">Stored as opaque text — not validated against Stripe.</p>
					</div>
					<div class="sm:col-span-3"></div>
					<div class="sm:col-span-2">
						<label class="block text-sm/6 font-medium text-rr-heading" for="payment_status">Payment status</label>
						<select id="payment_status" name="payment_status" class={ inputClasses(hasError(props.FieldErrors, "payment_status")) }>
							@paymentStatusOption("captured", "Captured (paid)", props.Form.PaymentStatus)
							@paymentStatusOption("awaiting", "Awaiting", props.Form.PaymentStatus)
							@paymentStatusOption("authorized", "Authorized", props.Form.PaymentStatus)
							@paymentStatusOption("failed", "Failed", props.Form.PaymentStatus)
							@paymentStatusOption("refunded", "Refunded", props.Form.PaymentStatus)
						</select>
						if msg := getError(props.FieldErrors, "payment_status"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<div class="sm:col-span-2">
						<label class="block text-sm/6 font-medium text-rr-heading" for="order_status">Order status</label>
						<select id="order_status" name="order_status" class={ inputClasses(hasError(props.FieldErrors, "order_status")) }>
							@orderStatusOption("confirmed", "Confirmed", props.Form.OrderStatus)
							@orderStatusOption("pending", "Pending", props.Form.OrderStatus)
							@orderStatusOption("processing", "Processing", props.Form.OrderStatus)
							@orderStatusOption("complete", "Complete", props.Form.OrderStatus)
							@orderStatusOption("cancelled", "Cancelled", props.Form.OrderStatus)
						</select>
						if msg := getError(props.FieldErrors, "order_status"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
				</div>
			</div>
			<!-- Notes -->
			<div class="pb-2">
				<label class="block text-sm/6 font-medium text-rr-heading" for="notes">Internal notes</label>
				<textarea id="notes" name="notes" rows="3" placeholder="Reason for manual entry, reference to upstream order, etc." class={ inputClasses(false) }>{ props.Form.Notes }</textarea>
			</div>
		</div>
		<div class="mt-8 flex items-center justify-end gap-3">
			<a href="/admin/orders" class="text-sm font-semibold text-rr-heading hover:underline">Cancel</a>
			<button type="submit" class="rounded-sm bg-rr-red px-4 py-2 text-sm font-semibold text-white hover:bg-rr-red/90">Create order</button>
		</div>
	</form>
}

templ paymentStatusOption(value, label, current string) {
	if selected(value, current) || (current == "" && value == "captured") {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ orderStatusOption(value, label, current string) {
	if selected(value, current) || (current == "" && value == "confirmed") {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

// orderNewItemsState builds the initial Alpine state for the line items *and*
// the totals block (they share one scope so the totals can fill in from the
// lines). On a fresh form it seeds three empty rows; on validation re-render it
// keeps whatever the admin already filled in so they don't retype. Each row
// carries a `label` (product title) populated when the line was added via the
// search picker, plus per-field error strings (skuErr/qtyErr/priceErr) so the
// server-side line validation surfaces inline on the right row.
//
// Money is dollars in the UI (cents on the wire). Subtotal and total auto-fill
// from the lines via recompute() until the staffer overrides a field — the
// *Dirty flags track that. On re-render a non-empty seeded value is treated as
// dirty so we never clobber what was submitted. addItem converts the picker's
// cents price to a dollar string; onPick is the click-delegation handler for the
// htmx-swapped results dropdown.
func orderNewItemsState(f OrderNewForm, errs map[string]string) string {
	blankRow := "{ sku: '', quantity: '', price: '', label: '', skuErr: '', qtyErr: '', priceErr: '' }"
	var rows string
	if len(f.Items) == 0 {
		rows = blankRow + "," + blankRow + "," + blankRow
	} else {
		for i, row := range f.Items {
			if i > 0 {
				rows += ","
			}
			rows += "{ sku: " + jsString(row.SKU) +
				", quantity: " + jsString(row.Quantity) +
				", price: " + jsString(row.UnitPrice) +
				", label: '', skuErr: " + jsString(getError(errs, fmt.Sprintf("item_%d_sku", i))) +
				", qtyErr: " + jsString(getError(errs, fmt.Sprintf("item_%d_quantity", i))) +
				", priceErr: " + jsString(getError(errs, fmt.Sprintf("item_%d_unit_price", i))) + " }"
		}
	}
	return `{
		query: '',
		rows: [` + rows + `],
		subtotal: ` + jsString(f.Subtotal) + `, discount: ` + jsString(f.Discount) + `, shipping: ` + jsString(f.Shipping) + `, tax: ` + jsString(f.Tax) + `, total: ` + jsString(f.Total) + `,
		subtotalDirty: ` + jsBool(f.Subtotal != "") + `, totalDirty: ` + jsBool(f.Total != "") + `,
		num(v) { const n = parseFloat(v); return isNaN(n) ? 0 : n; },
		money(n) { return n.toFixed(2); },
		lineSubtotal() { return this.rows.reduce((s, r) => s + this.num(r.quantity) * this.num(r.price), 0); },
		expectedTotal() { return this.num(this.subtotal) - this.num(this.discount) + this.num(this.shipping) + this.num(this.tax); },
		subtotalMismatch() { return this.rows.some(r => r.sku || r.price) && Math.abs(this.lineSubtotal() - this.num(this.subtotal)) >= 0.005; },
		totalMismatch() { return Math.abs(this.expectedTotal() - this.num(this.total)) >= 0.005; },
		recompute() {
			if (!this.subtotalDirty) this.subtotal = this.money(this.lineSubtotal());
			if (!this.totalDirty) this.total = this.money(this.expectedTotal());
		},
		applySubtotal() { this.subtotal = this.money(this.lineSubtotal()); this.subtotalDirty = false; this.recompute(); },
		applyTotal() { this.total = this.money(this.expectedTotal()); this.totalDirty = false; },
		add() { this.rows.push(` + blankRow + `) },
		remove(i) { if (this.rows.length > 1) this.rows.splice(i, 1); this.recompute(); },
		addItem(sku, priceCents, label) {
			const price = priceCents ? (parseInt(priceCents, 10) / 100).toFixed(2) : '';
			const empty = this.rows.find(r => !r.sku && !r.quantity && !r.price);
			if (empty) { empty.sku = sku; empty.price = price; empty.quantity = '1'; empty.label = label; }
			else { this.rows.push({ sku: sku, quantity: '1', price: price, label: label, skuErr: '', qtyErr: '', priceErr: '' }); }
			this.recompute();
		},
		onPick(e) {
			const btn = e.target.closest('[data-sku]');
			if (!btn) return;
			this.addItem(btn.dataset.sku, btn.dataset.price, btn.dataset.label);
			this.query = '';
			if (this.$refs.results) this.$refs.results.innerHTML = '';
		}
	}`
}

// jsBool renders a Go bool as a JS boolean literal for the x-data block.
func jsBool(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

// dollarInputClasses mirrors inputClasses but leaves room for a leading "$"
// adornment (pl-7) and right-aligns digits (tabular-nums).
func dollarInputClasses(hasErr bool) string {
	base := "block w-full rounded-sm bg-rr-surface pl-7 pr-3 py-1.5 text-base tabular-nums text-rr-heading outline-1 -outline-offset-1 placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 sm:text-sm/6 "
	if hasErr {
		return base + "outline-red-300 focus:outline-red-500"
	}
	return base + "outline-rr-border focus:outline-rr-red"
}

// dollarInput is a "$"-prefixed money field bound to Alpine via x-model. The
// value is a dollar string; the server parses it to cents. oninput is the Alpine
// expression run on input (dirty tracking / recompute).
templ dollarInput(id, model, oninput string, required, hasErr bool) {
	<div class="relative">
		<span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-sm text-rr-muted">$</span>
		if required {
			<input id={ id } name={ id } type="text" inputmode="decimal" required x-model={ model } x-on:input={ oninput } placeholder="0.00" class={ dollarInputClasses(hasErr) }/>
		} else {
			<input id={ id } name={ id } type="text" inputmode="decimal" x-model={ model } x-on:input={ oninput } placeholder="0.00" class={ dollarInputClasses(hasErr) }/>
		}
	</div>
}

// jsString returns a JS-string literal for embedding admin-supplied text into
// the Alpine x-data block. Only used inside admin (staff-only) — not customer-
// facing — but still escapes the few characters that would break the literal.
func jsString(s string) string {
	out := []rune{'\''}
	for _, r := range s {
		switch r {
		case '\\', '\'':
			out = append(out, '\\', r)
		case '\n':
			out = append(out, '\\', 'n')
		case '\r':
			out = append(out, '\\', 'r')
		case '<':
			out = append(out, '\\', 'u', '0', '0', '3', 'c')
		default:
			out = append(out, r)
		}
	}
	out = append(out, '\'')
	return string(out)
}

templ OrderNew(props OrderNewProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "New manual order",
		ActivePath: "/admin/orders",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@OrderNewContent(props)
	}
}

// priceData renders the cents value for a result button's data-price attribute,
// or "" when the variant has no base price so the staffer prices it by hand.
func priceData(cents *int) string {
	if cents == nil {
		return ""
	}
	return strconv.Itoa(*cents)
}

// VariantSearchResults renders the manual-order typeahead dropdown. Each result
// is a button carrying data-sku/data-price/data-label, picked up by the line-item
// component's onPick click-delegation handler.
templ VariantSearchResults(results []domain.VariantSearchResult, query string) {
	if len(results) == 0 {
		if query != "" {
			<div class="px-3 py-2 text-sm text-rr-muted">No products match “{ query }”.</div>
		}
	} else {
		<ul class="max-h-72 divide-y divide-rr-border overflow-auto">
			for _, r := range results {
				<li>
					<button
						type="button"
						data-sku={ r.SKU }
						data-price={ priceData(r.BasePriceCents) }
						data-label={ r.ProductTitle }
						class="flex w-full items-center justify-between gap-3 px-3 py-2 text-left text-sm hover:bg-rr-raised"
					>
						<span class="min-w-0">
							<span class="block truncate font-medium text-rr-heading">{ r.ProductTitle }</span>
							<span class="block truncate text-xs text-rr-muted">{ r.SKU }</span>
						</span>
						<span class="shrink-0 tabular-nums text-rr-body">
							if r.BasePriceCents != nil {
								{ formatCents(*r.BasePriceCents) }
							} else {
								—
							}
						</span>
					</button>
				</li>
			}
		</ul>
	}
}
