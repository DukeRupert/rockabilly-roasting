package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type EnrichedLineItem struct {
	LineItem     domain.LineItem
	ProductTitle string
	ProductSlug  string
	VariantSKU   string
}

type OrderShowProps struct {
	Order           *domain.Order
	LineItems       []EnrichedLineItem
	Adjustments     []domain.Adjustment
	Customer        *domain.Customer
	ShippingAddress *domain.Address
	StaffName       string
	StaffRole       string
}

func canCancelOrder(status domain.OrderStatus) bool {
	return status == domain.OrderStatusPending || status == domain.OrderStatusConfirmed
}

func canRefundOrder(status domain.OrderStatus, paymentStatus domain.PaymentStatus) bool {
	return (status == domain.OrderStatusComplete || status == domain.OrderStatusConfirmed) &&
		paymentStatus == domain.PaymentStatusCaptured
}

func canFulfillOrder(order *domain.Order) bool {
	return order.PaymentStatus == domain.PaymentStatusCaptured &&
		order.FulfillmentStatus == domain.FulfillmentStatusUnfulfilled &&
		order.Status != domain.OrderStatusCancelled &&
		order.Status != domain.OrderStatusRefunded
}

func canShipOrder(order *domain.Order) bool {
	return order.FulfillmentStatus == domain.FulfillmentStatusFulfilled &&
		order.Status != domain.OrderStatusCancelled &&
		order.Status != domain.OrderStatusRefunded
}

// orderPipelineStep returns 0-3 for the progress bar position.
// cancelled/refunded orders get a special -1 value.
func orderPipelineStep(order *domain.Order) int {
	if order.Status == domain.OrderStatusCancelled || order.Status == domain.OrderStatusRefunded {
		return -1
	}
	if order.FulfillmentStatus == domain.FulfillmentStatusShipped ||
		order.FulfillmentStatus == domain.FulfillmentStatusDelivered {
		return 3
	}
	if order.FulfillmentStatus == domain.FulfillmentStatusFulfilled {
		return 2
	}
	if order.PaymentStatus == domain.PaymentStatusCaptured {
		return 1
	}
	return 0
}

func stepClasses(current int, step int) string {
	if current >= step {
		return "flex items-center justify-center size-8 rounded-full bg-rr-red text-white"
	}
	return "flex items-center justify-center size-8 rounded-full bg-rr-raised text-rr-muted"
}

func connectorClasses(current int, step int) string {
	if current >= step {
		return "h-0.5 flex-1 bg-rr-red"
	}
	return "h-0.5 flex-1 bg-rr-raised"
}

func stepLabelClasses(current int, step int) string {
	if current >= step {
		return "text-xs font-medium text-rr-red"
	}
	return "text-xs text-rr-border"
}

templ OrderShowContent(props OrderShowProps) {
	<!-- Header -->
	<div class="sm:flex sm:items-center sm:justify-between">
		<div>
			<div class="flex items-center gap-3">
				<h1 class="text-base/7 font-semibold text-rr-heading">Order { props.Order.Number }</h1>
				if props.Order.Status == domain.OrderStatusCancelled {
					@OrderStatusBadge(props.Order.Status)
				}
				if props.Order.Status == domain.OrderStatusRefunded {
					@OrderStatusBadge(props.Order.Status)
				}
			</div>
			<p class="mt-1 text-sm text-rr-muted">Placed { props.Order.PlacedAt.Format("January 2, 2006 at 3:04 PM") }</p>
		</div>
		<div class="mt-4 flex items-center gap-3 sm:mt-0">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/packing-slip", props.Order.ID.String())) }
				target="_blank"
				class="inline-flex items-center gap-1.5 rounded-sm bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading ring-1 ring-inset ring-rr-border hover:bg-rr-raised"
			>
				<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18.75 12h.008v.008h-.008V12Zm-2.25 0h.008v.008H16.5V12Z"></path>
				</svg>
				Packing Slip
			</a>
			<a href="/admin/orders" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">&larr; Back to orders</a>
		</div>
	</div>
	<!-- Order progress bar -->
	if orderPipelineStep(props.Order) >= 0 {
		<div class="mt-6 rounded-sm bg-rr-surface p-6 shadow-xs ring-1 ring-rr-border">
			<div class="flex items-center">
				<!-- Step 1: Paid -->
				<div class="flex flex-col items-center">
					<div class={ stepClasses(orderPipelineStep(props.Order), 1) }>
						if orderPipelineStep(props.Order) >= 1 {
							<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
							</svg>
						} else {
							<span class="text-xs font-bold">1</span>
						}
					</div>
					<span class={ "mt-2", stepLabelClasses(orderPipelineStep(props.Order), 1) }>Paid</span>
				</div>
				<!-- Connector -->
				<div class={ "mx-2", connectorClasses(orderPipelineStep(props.Order), 2) }></div>
				<!-- Step 2: Fulfilled -->
				<div class="flex flex-col items-center">
					<div class={ stepClasses(orderPipelineStep(props.Order), 2) }>
						if orderPipelineStep(props.Order) >= 2 {
							<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
							</svg>
						} else {
							<span class="text-xs font-bold">2</span>
						}
					</div>
					<span class={ "mt-2", stepLabelClasses(orderPipelineStep(props.Order), 2) }>Fulfilled</span>
				</div>
				<!-- Connector -->
				<div class={ "mx-2", connectorClasses(orderPipelineStep(props.Order), 3) }></div>
				<!-- Step 3: Shipped -->
				<div class="flex flex-col items-center">
					<div class={ stepClasses(orderPipelineStep(props.Order), 3) }>
						if orderPipelineStep(props.Order) >= 3 {
							<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
							</svg>
						} else {
							<span class="text-xs font-bold">3</span>
						}
					</div>
					<span class={ "mt-2", stepLabelClasses(orderPipelineStep(props.Order), 3) }>Shipped</span>
				</div>
			</div>
		</div>
	}
	<!-- Guided actions -->
	<div class="mt-6 flex flex-wrap gap-3">
		if canFulfillOrder(props.Order) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/fulfill", props.Order.ID.String())) }>
				<button
					type="submit"
					class="inline-flex items-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
				>
					<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0-3-3m3 3 3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"></path>
					</svg>
					Fulfill Order
				</button>
			</form>
		}
		if canShipOrder(props.Order) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/ship", props.Order.ID.String())) }>
				<button
					type="submit"
					class="inline-flex items-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
				>
					<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"></path>
					</svg>
					Mark Shipped
				</button>
			</form>
		}
		if canCancelOrder(props.Order.Status) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/cancel", props.Order.ID.String())) }>
				<button
					type="submit"
					class="btn-danger"
					onclick="return confirm('Are you sure you want to cancel this order?')"
				>
					Cancel Order
				</button>
			</form>
		}
		if canRefundOrder(props.Order.Status, props.Order.PaymentStatus) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/refund", props.Order.ID.String())) }>
				<button
					type="submit"
					class="btn-danger"
					onclick="return confirm('Are you sure you want to refund this order?')"
				>
					Refund Order
				</button>
			</form>
		}
	</div>
	<!-- Info cards: total, customer, shipping -->
	<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Total</dt>
			<dd class="mt-1 text-lg font-semibold text-rr-heading tabular-nums">{ formatCents(props.Order.Total) }</dd>
		</div>
		if props.Customer != nil {
			<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
				<dt class="text-sm font-medium text-rr-muted">Customer</dt>
				<dd class="mt-1 text-sm font-semibold text-rr-heading">
					<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", props.Customer.ID.String())) } class="text-rr-red hover:text-rr-red-lt">
						{ props.Customer.FirstName } { props.Customer.LastName }
					</a>
				</dd>
				<dd class="text-xs text-rr-muted">{ props.Customer.Email }</dd>
			</div>
		}
		if props.ShippingAddress != nil {
			<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
				<dt class="text-sm font-medium text-rr-muted">Ship to</dt>
				<dd class="mt-1">
					<address class="text-sm text-rr-heading not-italic">
						<p>{ props.ShippingAddress.FirstName } { props.ShippingAddress.LastName }</p>
						if props.ShippingAddress.Company != nil && *props.ShippingAddress.Company != "" {
							<p>{ *props.ShippingAddress.Company }</p>
						}
						<p>{ props.ShippingAddress.Line1 }</p>
						if props.ShippingAddress.Line2 != nil && *props.ShippingAddress.Line2 != "" {
							<p>{ *props.ShippingAddress.Line2 }</p>
						}
						<p>{ props.ShippingAddress.City }, { props.ShippingAddress.State } { props.ShippingAddress.PostalCode }</p>
					</address>
				</dd>
			</div>
		}
	</div>
	<!-- Shipping method & delivery date -->
	if props.Order.ShippingMethod != nil || props.Order.RequestedDeliveryDate != nil || (props.Order.CustomerPONumber != nil && *props.Order.CustomerPONumber != "") {
		<div class="mt-4 rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<div class="flex flex-wrap items-center gap-4">
				if props.Order.ShippingMethod != nil {
					<div class="flex items-center gap-2">
						<span class="text-sm font-medium text-rr-muted">Shipping:</span>
						@ShippingMethodBadge(*props.Order.ShippingMethod)
					</div>
				}
				if props.Order.RequestedDeliveryDate != nil {
					<div class="flex items-center gap-2">
						<span class="text-sm font-medium text-rr-muted">Delivery date:</span>
						<span class="text-sm text-rr-heading">{ props.Order.RequestedDeliveryDate.Format("January 2, 2006") }</span>
					</div>
				}
				if props.Order.CustomerPONumber != nil && *props.Order.CustomerPONumber != "" {
					<div class="flex items-center gap-2">
						<span class="text-sm font-medium text-rr-muted">PO #:</span>
						<span class="text-sm text-rr-heading">{ *props.Order.CustomerPONumber }</span>
					</div>
				}
			</div>
		</div>
	}
	<!-- Stripe info -->
	if props.Order.StripePaymentIntentID != nil && *props.Order.StripePaymentIntentID != "" {
		<div class="mt-4 rounded-sm bg-rr-raised p-4 ring-1 ring-rr-border">
			<p class="text-sm text-rr-muted">
				<span class="font-medium">Stripe Payment Intent:</span>
				<code class="ml-1 text-xs">{ *props.Order.StripePaymentIntentID }</code>
			</p>
		</div>
	}
	<!-- Line items -->
	<div class="mt-8">
		<h2 class="text-sm font-semibold text-rr-heading">Line items</h2>
		if len(props.LineItems) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No line items.</p>
		} else {
			<div class="mt-2 overflow-hidden rounded-sm bg-rr-surface shadow-xs ring-1 ring-rr-border">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Product</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">SKU</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Qty</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Unit Price</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Total</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, eli := range props.LineItems {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									if eli.ProductTitle != "" {
										<span class="font-medium text-rr-heading">{ eli.ProductTitle }</span>
									} else {
										<span class="font-medium text-rr-heading">{ eli.LineItem.VariantID.String()[:8] }...</span>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									if eli.VariantSKU != "" {
										{ eli.VariantSKU }
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted text-right tabular-nums">
									{ fmt.Sprintf("%d", eli.LineItem.Quantity) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted text-right tabular-nums">
									{ formatCents(eli.LineItem.UnitPrice) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-heading text-right tabular-nums font-medium">
									{ formatCents(eli.LineItem.Total) }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
	<!-- Order totals -->
	<div class="mt-6 rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
		<dl class="space-y-2">
			<div class="flex justify-between text-sm">
				<dt class="text-rr-muted">Subtotal</dt>
				<dd class="text-rr-heading tabular-nums">{ formatCents(props.Order.Subtotal) }</dd>
			</div>
			if props.Order.DiscountTotal > 0 {
				<div class="flex justify-between text-sm">
					<dt class="text-rr-muted">Discounts</dt>
					<dd class="text-rr-heading tabular-nums">-{ formatCents(props.Order.DiscountTotal) }</dd>
				</div>
			}
			<div class="flex justify-between text-sm">
				<dt class="text-rr-muted">Shipping</dt>
				<dd class="text-rr-heading tabular-nums">{ formatCents(props.Order.ShippingTotal) }</dd>
			</div>
			<div class="flex justify-between text-sm">
				<dt class="text-rr-muted">Tax</dt>
				<dd class="text-rr-heading tabular-nums">{ formatCents(props.Order.TaxTotal) }</dd>
			</div>
			<div class="flex justify-between border-t border-rr-border pt-2 text-sm font-semibold">
				<dt class="text-rr-heading">Total</dt>
				<dd class="text-rr-heading tabular-nums">{ formatCents(props.Order.Total) }</dd>
			</div>
		</dl>
	</div>
	<!-- Adjustments -->
	if len(props.Adjustments) > 0 {
		<div class="mt-8">
			<h2 class="text-sm font-semibold text-rr-heading">Adjustments</h2>
			<div class="mt-2 overflow-hidden rounded-sm bg-rr-surface shadow-xs ring-1 ring-rr-border">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Label</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Type</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Amount</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, adj := range props.Adjustments {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-rr-heading sm:pl-6">{ adj.Label }</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">{ adj.SourceType }</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-heading text-right tabular-nums">{ formatCents(adj.Amount) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
	<!-- Notes -->
	if props.Order.Notes != nil && *props.Order.Notes != "" {
		<div class="mt-8">
			<h2 class="text-sm font-semibold text-rr-heading">Notes</h2>
			<p class="mt-2 text-sm text-rr-muted">{ *props.Order.Notes }</p>
		</div>
	}
}

templ OrderShow(props OrderShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      fmt.Sprintf("Order %s", props.Order.Number),
		ActivePath: "/admin/orders",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@OrderShowContent(props)
	}
}
