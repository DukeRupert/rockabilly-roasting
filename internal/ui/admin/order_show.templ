package admin

import (
	"fmt"
	"strings"
	"time"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type EnrichedLineItem struct {
	LineItem        domain.LineItem
	ProductTitle    string
	ProductSlug     string
	VariantSKU      string
	CurrentLabel    string
	SiblingVariants []SiblingVariant
}

// SiblingVariant is one selectable option in the line-item grind/variant
// picker. On the order page these are same-priced siblings only (the handler
// filters out differently-priced variants). On the subscription page all
// non-archived siblings are offered and Price (USD cents) is set so each option
// can show its price; the order page leaves Price at 0 and does not render it.
type SiblingVariant struct {
	ID    uuid.UUID
	Label string
	Price int
}

type OrderShowProps struct {
	Order              *domain.Order
	LineItems          []EnrichedLineItem
	Adjustments        []domain.Adjustment
	Customer           *domain.Customer
	ShippingAddress    *domain.Address
	Shipments          []domain.Shipment
	LatestLabelAttempt *domain.LabelAttempt
	Flash              string
	MerchantTZ         *time.Location
	StaffName          string
	StaffRole          string
	CanEditLineItems   bool
	// AccountPastDue flags a customer with invoices past terms — staff hold
	// new fulfillment for the account until the balance clears.
	AccountPastDue bool
	// BillingAddress is what the order was billed to. Rendered only when it
	// differs from the shipping address — most retail orders share one.
	BillingAddress *domain.Address
	// CustomerOrderCount is how many non-cancelled orders this customer has
	// placed, all time, including this one. Zero when there is no customer.
	CustomerOrderCount int
	// Activity is the order's audit history — entries against the order itself
	// merged with those against its shipments, newest first.
	Activity []domain.AuditEntry
	// PaymentDueAt is when a terms-billed (wholesale) order is due, counted from
	// the customer's NET terms by app.InvoiceDueDate. Nil for card-paid retail
	// orders.
	//
	// A calendar date, carried as midnight UTC — the shop's day was already
	// resolved when it was computed. Render it with a bare .Format: re-zoning it
	// westward prints the day before, and this row sits beside the QuickBooks
	// invoice number, which staff read as one answer.
	PaymentDueAt *time.Time
	// CouponCode is the code redeemed against this order, if any. The
	// adjustments table shows the discount's *name*; support calls are about
	// the code the customer typed.
	CouponCode string
	// PollCount is the auto-refresh tick number for the label poller — 0 on a
	// normal load, incremented by each self-refresh while a BuyLabel attempt is
	// queued. Caps the loop at maxLabelPolls. See shouldPollLabel.
	PollCount int
}

// maxLabelPolls bounds the auto-refresh that runs after a label is queued: the
// order page re-fetches itself every ~2s while the BuyLabel worker runs, then
// gives up so a stuck or slow job can't poll forever. ~10 ticks ≈ 20s, well
// past the typical 1–3s purchase; after that staff refresh manually.
const maxLabelPolls = 10

// shouldPollLabel reports whether to emit the self-refresh poller: only while
// the latest attempt is still queued and we're under the poll ceiling.
func shouldPollLabel(props OrderShowProps) bool {
	return props.LatestLabelAttempt != nil &&
		props.LatestLabelAttempt.Status == domain.LabelAttemptStatusQueued &&
		props.PollCount < maxLabelPolls
}

// nextLabelPollURL is the order-page URL for the next poll tick, carrying an
// incremented counter so the server can enforce maxLabelPolls. Deliberately
// omits the flash param so the "Label queued" toast doesn't re-fire each tick.
func nextLabelPollURL(props OrderShowProps) string {
	return fmt.Sprintf("/admin/orders/%s?poll=%d", props.Order.ID.String(), props.PollCount+1)
}

// LabelAttemptMessage maps a LabelAttempt to short staff-facing copy.
// Returns ("", "") when there's nothing to show (nil attempt). For
// "queued" attempts the second value is empty.
//
// The error mapper handles the common deterministic failures with specific
// copy; everything else falls back to "Label failed" plus the first ~80
// chars of the underlying error for triage.
func LabelAttemptMessage(a *domain.LabelAttempt) (headline string, detail string) {
	if a == nil {
		return "", ""
	}
	if a.Status == domain.LabelAttemptStatusQueued {
		if a.Attempt > 1 {
			return fmt.Sprintf("Label retrying (attempt %d of %d)", a.Attempt, a.MaxAttempts), ""
		}
		return "Label queued", ""
	}
	return "Label failed", labelFailureDetail(a.LastError)
}

// labelFailureDetail returns a one-line plain-English summary of a buy_label
// worker error. Matches on substrings of the raw error string from River's
// errors column; falls back to a truncated raw error when no pattern matches.
func labelFailureDetail(raw string) string {
	if raw == "" {
		return "No error detail recorded."
	}
	low := strings.ToLower(raw)
	switch {
	case strings.Contains(low, "no box preset"):
		return "No box preset configured. Add one in Settings → Box presets."
	case strings.Contains(low, "no physical items"), strings.Contains(low, "shippable items"):
		return "Order has no shippable items."
	case strings.Contains(low, "weight"):
		return "A variant in this order is missing its weight."
	case strings.Contains(low, "no rate for service"):
		return "Selected service unavailable for this parcel. Try Priority or Priority Express."
	case strings.Contains(low, "no rates returned"):
		return "Shippo returned no rates for this address."
	case strings.Contains(low, "address"):
		return "Address rejected by USPS. Verify the ship-to address and try again."
	case strings.Contains(low, "seller info missing"), strings.Contains(low, "email or phone"):
		return "Origin email/phone missing — fill them in under Settings → Shipping."
	}
	const max = 160
	if len(raw) > max {
		return raw[:max] + "…"
	}
	return raw
}

// ShippoServiceOption is one selectable carrier service in the bulk-label
// toolbar. Token must match a Shippo servicelevel.token — see
// internal/platform/shipping/shippo.go. (Single-order purchases now use the
// interactive rate chooser — see LabelRatesPanel — not this static menu.)
type ShippoServiceOption struct {
	Token string
	Label string
}

// ShippoServiceOptions is the menu shown in the bulk-label dropdown
// (fulfillment_list.templ). Order is significant: the first entry is the
// default selection (cheapest USPS ground service for retail orders).
var ShippoServiceOptions = []ShippoServiceOption{
	{Token: "usps_ground_advantage", Label: "USPS Ground Advantage"},
	{Token: "usps_priority", Label: "USPS Priority"},
	{Token: "usps_priority_express", Label: "USPS Priority Express"},
}

// canBuyLabel reports whether the "Get shipping rates" button should be shown.
// Eligible when: order is paid, shipping out via the standard "shipped"
// channel (not pickup/local delivery), not cancelled/refunded, no shipment
// row already exists, and no buy attempt is currently in flight. A failed
// previous attempt (e.g. from a bulk buy) does NOT suppress the button — the
// operator can fetch rates and buy again, so it doubles as a Retry.
func canBuyLabel(order *domain.Order, shipments []domain.Shipment, attempt *domain.LabelAttempt) bool {
	if attempt != nil && attempt.Status == domain.LabelAttemptStatusQueued {
		return false
	}
	if order.PaymentStatus != domain.PaymentStatusCaptured {
		return false
	}
	if order.Status == domain.OrderStatusCancelled || order.Status == domain.OrderStatusRefunded {
		return false
	}
	if order.ShippingMethod != nil &&
		(*order.ShippingMethod == domain.ShippingMethodPickup ||
			*order.ShippingMethod == domain.ShippingMethodLocalDelivery) {
		return false
	}
	// Blocked only by a live label. A refunded (or refund-requested) shipment no
	// longer counts, so a corrected label can be bought after requesting a
	// refund on one purchased in error. BlocksRebuy is the shared source of
	// truth — the server-side buy guard enforces the same rule.
	for _, sh := range shipments {
		if sh.BlocksRebuy() {
			return false
		}
	}
	return true
}

func canCancelOrder(status domain.OrderStatus) bool {
	return status == domain.OrderStatusPending || status == domain.OrderStatusConfirmed
}

func canRefundOrder(status domain.OrderStatus, paymentStatus domain.PaymentStatus) bool {
	return (status == domain.OrderStatusComplete || status == domain.OrderStatusConfirmed) &&
		paymentStatus == domain.PaymentStatusCaptured
}

// canMarkOrderPaid gates the manual "mark as paid" override. Mirrors
// app.orderManuallyPayable: QB-owned orders in a live, unsettled invoice state,
// plus non-QB wholesale orders (invoiced externally until the QuickBooks
// integration is wired up) which sit in pending_invoice from placement.
func canMarkOrderPaid(o *domain.Order) bool {
	if o.Status == domain.OrderStatusCancelled || o.Status == domain.OrderStatusRefunded {
		return false
	}
	if o.QBInvoiceID != nil {
		switch o.PaymentStatus {
		case domain.PaymentStatusInvoiced, domain.PaymentStatusOverdue, domain.PaymentStatusPartiallyPaid:
			return true
		default:
			return false
		}
	}
	if o.Channel != domain.OrderChannelWholesale {
		return false
	}
	switch o.PaymentStatus {
	case domain.PaymentStatusPendingInvoice, domain.PaymentStatusInvoiced,
		domain.PaymentStatusOverdue, domain.PaymentStatusPartiallyPaid:
		return true
	default:
		return false
	}
}

func canFulfillOrder(order *domain.Order) bool {
	return order.PaymentStatus == domain.PaymentStatusCaptured &&
		order.FulfillmentStatus == domain.FulfillmentStatusUnfulfilled &&
		order.Status != domain.OrderStatusCancelled &&
		order.Status != domain.OrderStatusRefunded
}

func canShipOrder(order *domain.Order) bool {
	if order.FulfillmentStatus != domain.FulfillmentStatusFulfilled ||
		order.Status == domain.OrderStatusCancelled ||
		order.Status == domain.OrderStatusRefunded {
		return false
	}
	// Hide the generic Mark Shipped button for orders routed through a local
	// fulfillment channel — those have their own action buttons.
	if order.ShippingMethod != nil &&
		(*order.ShippingMethod == domain.ShippingMethodPickup ||
			*order.ShippingMethod == domain.ShippingMethodLocalDelivery) {
		return false
	}
	return true
}

func canMarkReadyForPickup(order *domain.Order) bool {
	if order.ShippingMethod == nil || *order.ShippingMethod != domain.ShippingMethodPickup {
		return false
	}
	if order.Status == domain.OrderStatusCancelled || order.Status == domain.OrderStatusRefunded {
		return false
	}
	return order.FulfillmentStatus == domain.FulfillmentStatusUnfulfilled ||
		order.FulfillmentStatus == domain.FulfillmentStatusFulfilled
}

func canMarkPickedUp(order *domain.Order) bool {
	return order.FulfillmentStatus == domain.FulfillmentStatusReadyForPickup &&
		order.Status != domain.OrderStatusCancelled &&
		order.Status != domain.OrderStatusRefunded
}

// markShippedHint spells out whether the customer actually hears about it.
// ShipOrder emails their tracking number, but only when a label was bought —
// canShipOrder deliberately allows marking an order shipped without one, and
// the shipped email is built entirely around carrier and tracking.
func markShippedHint(shipments []domain.Shipment) string {
	for _, sh := range shipments {
		if sh.TrackingNumber != "" {
			return "Marks the order shipped and closes it as complete, and emails the customer their tracking number."
		}
	}
	return "Marks the order shipped and closes it as complete. No email goes out — there is no label on this order, so there is no tracking to send."
}

// revertShipmentPoints tells staff what reverting cannot take back. Marking
// shipped emails the customer their tracking when a label exists, and that
// mail is already gone by the time anyone reaches for this button.
func revertShipmentPoints(shipments []domain.Shipment) []string {
	points := []string{
		"Any shipping label already bought stays bought — void or refund it separately from the shipment above.",
	}
	for _, sh := range shipments {
		if sh.TrackingNumber != "" {
			return append(points, "The customer has already been emailed their tracking number. That cannot be undone — tell them yourself if the parcel is not on its way.")
		}
	}
	return append(points, "No shipped email went out, so there is nothing to correct with the customer.")
}

// shipmentHintID scopes an action-hint element id to one shipment. The
// shipments block renders inside a loop, so a bare id would repeat — and every
// button's aria-describedby would resolve to the first shipment's hint.
func shipmentHintID(prefix string, shipmentID uuid.UUID) string {
	return prefix + "-" + shipmentID.String()
}

// hasLabeledShipment reports whether any shipment on the order has a bought
// label to show. Guards the shipments block so it does not render an empty
// container for orders whose shipments never got one.
func hasLabeledShipment(shipments []domain.Shipment) bool {
	for _, sh := range shipments {
		if sh.LabelURL != nil && *sh.LabelURL != "" {
			return true
		}
	}
	return false
}

func canRevertFulfillment(order *domain.Order) bool {
	return order.FulfillmentStatus == domain.FulfillmentStatusFulfilled &&
		order.Status != domain.OrderStatusCancelled &&
		order.Status != domain.OrderStatusRefunded
}

func canRevertShipment(order *domain.Order) bool {
	return order.FulfillmentStatus == domain.FulfillmentStatusShipped &&
		order.Status != domain.OrderStatusCancelled &&
		order.Status != domain.OrderStatusRefunded
}

func canMarkOutForDelivery(order *domain.Order) bool {
	if order.ShippingMethod == nil || *order.ShippingMethod != domain.ShippingMethodLocalDelivery {
		return false
	}
	if order.Status == domain.OrderStatusCancelled || order.Status == domain.OrderStatusRefunded {
		return false
	}
	return order.FulfillmentStatus == domain.FulfillmentStatusUnfulfilled ||
		order.FulfillmentStatus == domain.FulfillmentStatusFulfilled
}

// canSwapShippingMethod gates the pickup↔local-delivery swap button: only
// while the bag is still in the shop (unfulfilled or fulfilled) and the
// order isn't terminated.
func canSwapShippingMethod(order *domain.Order) bool {
	if order.ShippingMethod == nil {
		return false
	}
	if *order.ShippingMethod != domain.ShippingMethodPickup &&
		*order.ShippingMethod != domain.ShippingMethodLocalDelivery {
		return false
	}
	if order.Status == domain.OrderStatusCancelled || order.Status == domain.OrderStatusRefunded {
		return false
	}
	return order.FulfillmentStatus == domain.FulfillmentStatusUnfulfilled ||
		order.FulfillmentStatus == domain.FulfillmentStatusFulfilled
}

// swapShippingTarget returns the "other" local method — what the swap button
// will switch the order to.
func swapShippingTarget(current domain.ShippingMethod) (domain.ShippingMethod, string) {
	if current == domain.ShippingMethodLocalDelivery {
		return domain.ShippingMethodPickup, "Switch to local pickup"
	}
	return domain.ShippingMethodLocalDelivery, "Switch to local delivery"
}

templ shippingMethodSwap(orderID uuid.UUID, current domain.ShippingMethod) {
	{{ target, label := swapShippingTarget(current) }}
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/shipping-method", orderID.String())) } class="inline">
		<input type="hidden" name="method" value={ string(target) }/>
		<button type="submit" class="btn-secondary text-xs">{ label }</button>
	</form>
}

// convertToShippedForm flips a local order onto the carrier "shipped" channel
// so staff can buy a label. One-way and comped — the dialog spells that out.
templ convertToShippedForm(orderID uuid.UUID) {
	<form
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/shipping-method", orderID.String())) }
		class="inline"
	>
		<input type="hidden" name="method" value="shipped"/>
		@ActionWrap("hint-convert-mailout", "Moves this order onto the carrier channel so you can buy a label. Shipping stays comped and the customer is not notified.") {
			<button
				type="submit"
				class="btn-secondary text-xs"
				aria-describedby="hint-convert-mailout"
				{ ConfirmAttrs(ActionConfirm{
					Title: "Convert this order to a mail-out?",
					Lead:  "Moves the order off local delivery or pickup and onto the carrier channel so you can buy a shipping label.",
					Points: []string{
						"Shipping stays comped — the customer is not charged extra.",
						"The customer is not notified of the change.",
						"Switch it back from the shipping method controls if you change your mind.",
					},
					Confirm: "Convert to mail-out",
				})... }
			>Convert to mail-out</button>
		}
	</form>
}

templ grindCell(orderID uuid.UUID, eli EnrichedLineItem, canEdit bool) {
	if canEdit && len(eli.SiblingVariants) > 1 {
		<form
			method="POST"
			action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/line-items/%s/variant", orderID.String(), eli.LineItem.ID.String())) }
			class="flex items-center gap-2"
		>
			<select
				name="variant_id"
				class="border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading"
			>
				for _, sv := range eli.SiblingVariants {
					if sv.ID == eli.LineItem.VariantID {
						<option value={ sv.ID.String() } selected>{ sv.Label }</option>
					} else {
						<option value={ sv.ID.String() }>{ sv.Label }</option>
					}
				}
			</select>
			<button
				type="submit"
				class="border border-rr-border bg-rr-raised px-2 py-1 text-xs font-medium text-rr-heading hover:bg-rr-border"
			>Save</button>
		</form>
	} else {
		if eli.CurrentLabel != "" {
			{ eli.CurrentLabel }
		} else {
			<span class="text-rr-border">&mdash;</span>
		}
	}
}

// orderShowActivePath returns the sidebar nav path that should highlight for
// this order. The detail page is served at the same /admin/orders/{id} URL for
// both channels, so we key off the order's frozen channel rather than the URL.
func orderShowActivePath(o *domain.Order) string {
	if o.Channel == domain.OrderChannelWholesale {
		return "/admin/orders/wholesale"
	}
	return "/admin/orders"
}

// hasForwardAction reports whether any pipeline-advancing action is currently
// available. Drives the rail's "Next action" card: when nothing is actionable
// the card explains why instead of rendering empty, so a missing button is
// never mistaken for a missing feature.
func hasForwardAction(props OrderShowProps) bool {
	return canFulfillOrder(props.Order) ||
		canShipOrder(props.Order) ||
		canMarkReadyForPickup(props.Order) ||
		canMarkPickedUp(props.Order) ||
		canMarkOutForDelivery(props.Order) ||
		canMarkOrderPaid(props.Order) ||
		canBuyLabel(props.Order, props.Shipments, props.LatestLabelAttempt)
}

// nextActionReason is the plain-English stand-in shown when no forward action
// is available. The can*() predicates encode a lot of rules; without this the
// page just renders nothing and staff cannot tell a closed order from a bug.
func nextActionReason(props OrderShowProps) string {
	o := props.Order
	switch {
	case o.Status == domain.OrderStatusCancelled:
		return "This order is cancelled. Nothing left to do here."
	case o.Status == domain.OrderStatusRefunded:
		return "This order is refunded. Nothing left to do here."
	case props.LatestLabelAttempt != nil && props.LatestLabelAttempt.Status == domain.LabelAttemptStatusQueued:
		return "Waiting on the label worker. Actions come back once it finishes."
	case o.FulfillmentStatus == domain.FulfillmentStatusDelivered:
		return "Delivered. This order is closed."
	case o.FulfillmentStatus == domain.FulfillmentStatusShipped:
		return "Shipped and closed. Use the corrections below if that was a mistake."
	case o.PaymentStatus != domain.PaymentStatusCaptured:
		return "Waiting on payment. Fulfillment unlocks once it clears."
	default:
		return "No further action available from here."
	}
}

// hasCorrection reports whether either revert button is available — the rail
// only draws the "Correct a mistake" divider when something sits under it.
func hasCorrection(order *domain.Order) bool {
	return canRevertFulfillment(order) || canRevertShipment(order)
}

// railCard is the standard right-rail panel: hairline card, small tracked
// label, content below. Keeps the rail reading as one stack of like things
// rather than the assortment of ad-hoc bands this page grew.
templ railCard(title string) {
	<section class="border border-rr-border bg-rr-surface p-4">
		<h2 class="label-font text-xs uppercase tracking-wide text-rr-muted">{ title }</h2>
		<div class="mt-3">
			{ children... }
		</div>
	</section>
}

// railRow is one label/value line inside a rail card.
templ railRow(label string) {
	<div class="flex items-baseline justify-between gap-3 text-sm">
		<span class="shrink-0 text-rr-muted">{ label }</span>
		<span class="min-w-0 text-right text-rr-heading">{ children... }</span>
	</div>
}

// orderStatusHeader carries the three status axes that used to be spread
// between a progress bar, a conditional badge, and inference. All three always
// render — including on cancelled orders, where the old progress bar vanished
// exactly when staff most wanted to know how far the order had got.
templ orderStatusHeader(props OrderShowProps) {
	<div class="mt-2 flex flex-wrap items-center gap-2">
		@OrderChannelBadge(props.Order.Channel)
		@OrderStatusBadge(props.Order.Status)
		@PaymentStatusBadge(props.Order.PaymentStatus)
		@FulfillmentStatusBadge(props.Order.FulfillmentStatus)
	</div>
}

// orderShipmentsBlock is status, not an action: each parcel's label and
// tracking, with the two buttons that hang off them.
templ orderShipmentsBlock(props OrderShowProps) {
	<div class="flex flex-col gap-3 border border-rr-border bg-rr-surface p-4">
		<h2 class="label-font text-xs uppercase tracking-wide text-rr-muted">Shipment</h2>
		for _, sh := range props.Shipments {
			if sh.LabelURL != nil && *sh.LabelURL != "" {
				{{ track := domain.TrackingURL(sh.CarrierName, sh.TrackingNumber) }}
				<div class="flex flex-col items-start gap-1.5">
					<div class="flex items-center gap-2">
						@ShipmentStatusBadge(sh.Status)
						@RefundStatusBadge(sh.RefundStatus)
						if sh.Status == domain.ShipmentStatusDelivered && sh.DeliveredAt != nil {
							<span class="text-xs text-rr-muted">Delivered { sh.DeliveredAt.In(props.MerchantTZ).Format("January 2, 2006 at 3:04 PM") }</span>
						}
					</div>
					if sh.TrackingNumber != "" {
						<p class="font-mono text-xs text-rr-muted">
							{ sh.CarrierName }
							if track != "" {
								<a href={ templ.SafeURL(track) } target="_blank" rel="noopener" class="underline decoration-rr-border underline-offset-2 hover:text-rr-red hover:decoration-rr-red">{ sh.TrackingNumber }</a>
							} else {
								{ sh.TrackingNumber }
							}
						</p>
					}
					<div class="flex flex-wrap items-center gap-2">
						@ActionWrap(shipmentHintID("hint-download-label", sh.ID), "Opens the purchased label PDF in a new tab for printing.") {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/admin/shipments/%s/label", sh.ID.String())) }
								target="_blank"
								aria-describedby={ shipmentHintID("hint-download-label", sh.ID) }
								class="inline-flex items-center gap-1.5 rounded-sm bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
							>
								<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
								</svg>
								Download label
							</a>
						}
						if sh.CanRequestRefund() {
							<form
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/admin/shipments/%s/refund", sh.ID.String())) }
							>
								@ActionWrap(shipmentHintID("hint-label-refund", sh.ID), "Asks the carrier to refund the postage for this label. Unused labels only — it does not refund the customer's order.") {
									<button
										{ ConfirmAttrs(ActionConfirm{
										Title: "Request a carrier refund for this label?",
										Lead:  "Asks the carrier to refund what you paid for this label. This refunds the postage only — it does not refund the customer's order.",
										Points: []string{
											"Only unused labels are eligible. A label that has been used or scanned will be rejected.",
											"The carrier decides, and can take several days to answer.",
											"The shipment stays on the order either way.",
										},
										Confirm: "Request refund",
									})... }
										type="submit"
										aria-describedby={ shipmentHintID("hint-label-refund", sh.ID) }
										class="inline-flex items-center gap-1.5 rounded-sm bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
									>
										<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"></path>
										</svg>
										Request refund
									</button>
								}
							</form>
						}
					</div>
				</div>
			}
		}
	</div>
}

// orderActionRail is the single home for pipeline-advancing actions. They used
// to be scattered across five places on the page; a staff member should only
// have to look here to know what to do next.
templ orderActionRail(props OrderShowProps) {
	@railCard("Next action") {
		<div class="flex flex-col gap-2">
			if canMarkOrderPaid(props.Order) {
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/mark-paid", props.Order.ID.String())) }
					class="flex flex-col gap-2"
				>
					@ActionWrap("hint-mark-paid", "Records payment received outside Stripe. No money moves — do this only after the payment has cleared.") {
						<button
							{ ConfirmAttrs(ActionConfirm{
							Title: "Mark this order as paid?",
							Lead:  fmt.Sprintf("Records %s as received. Do this only after you have confirmed the payment actually cleared.", formatCents(props.Order.Total)),
							Points: []string{
								"No money moves — this records a payment taken outside Stripe.",
								"The customer is emailed a confirmation only if you ticked the box.",
							},
							Confirm: "Mark as paid",
						})... }
							type="submit"
							aria-describedby="hint-mark-paid"
							class="inline-flex w-full items-center justify-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
						>
							<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
							</svg>
							Mark as Paid
						</button>
					}
					@ActionWrap("hint-mark-paid-email", "Leave unticked to record the payment quietly, without mailing the customer.") {
						<label class="inline-flex items-center gap-1.5 text-xs text-rr-body" aria-describedby="hint-mark-paid-email">
							<input type="checkbox" name="send_email" class="size-4 rounded-sm border-rr-border text-rr-red focus:ring-rr-red"/>
							Email a payment confirmation
						</label>
					}
				</form>
			}
			if canFulfillOrder(props.Order) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/fulfill", props.Order.ID.String())) }>
					@ActionWrap("hint-fulfill", "Records the order as picked and packed and moves it to processing. No email is sent to the customer.") {
						<button
							type="submit"
							aria-describedby="hint-fulfill"
							class="inline-flex w-full items-center justify-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
						>
							<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0-3-3m3 3 3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"></path>
							</svg>
							Fulfill Order
						</button>
					}
				</form>
			}
			if canBuyLabel(props.Order, props.Shipments, props.LatestLabelAttempt) {
				<!-- Fetches rates into #label-rates-panel, which lives in the main
				     column: a list of carrier services needs the width. -->
				@ActionWrap("hint-rates", "Asks Shippo for live rates for this order's box and address. Nothing is bought until you pick a rate.") {
					<button
						type="button"
						aria-describedby="hint-rates"
						hx-get={ fmt.Sprintf("/admin/orders/%s/rates", props.Order.ID.String()) }
						hx-target="#label-rates-panel"
						hx-swap="innerHTML"
						hx-disabled-elt="this"
						class="async-btn inline-flex w-full items-center justify-center gap-1.5 rounded-sm bg-rr-surface px-4 py-2.5 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised disabled:opacity-70 disabled:cursor-wait"
					>
						<svg class="async-btn-icon size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"></path>
						</svg>
						<svg class="async-btn-spinner size-4" fill="none" viewBox="0 0 24 24" aria-hidden="true">
							<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
							<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
						</svg>
						if props.LatestLabelAttempt != nil && props.LatestLabelAttempt.Status == domain.LabelAttemptStatusFailed {
							Get shipping rates (retry)
						} else {
							Get shipping rates
						}
					</button>
				}
			}
			if canShipOrder(props.Order) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/ship", props.Order.ID.String())) }>
					@ActionWrap("hint-ship", markShippedHint(props.Shipments)) {
						<button
							type="submit"
							aria-describedby="hint-ship"
							class="inline-flex w-full items-center justify-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
						>
							<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"></path>
							</svg>
							Mark Shipped
						</button>
					}
				</form>
			}
			if canMarkReadyForPickup(props.Order) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/ready-for-pickup", props.Order.ID.String())) }>
					@ActionWrap("hint-ready-pickup", "Emails the customer that their order is ready to collect at the shop.") {
						<button
							type="submit"
							aria-describedby="hint-ready-pickup"
							class="inline-flex w-full items-center justify-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
						>
							Mark Ready for Pickup
						</button>
					}
				</form>
			}
			if canMarkPickedUp(props.Order) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/picked-up", props.Order.ID.String())) }>
					@ActionWrap("hint-picked-up", "Closes the order as collected. No email is sent to the customer.") {
						<button
							type="submit"
							aria-describedby="hint-picked-up"
							class="inline-flex w-full items-center justify-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
						>
							Mark Picked Up
						</button>
					}
				</form>
			}
			if canMarkOutForDelivery(props.Order) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/out-for-delivery", props.Order.ID.String())) }>
					@ActionWrap("hint-out-for-delivery", "Emails the customer that their order is on the van today.") {
						<button
							type="submit"
							aria-describedby="hint-out-for-delivery"
							class="inline-flex w-full items-center justify-center gap-1.5 rounded-sm bg-rr-red px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
						>
							Out for Local Delivery
						</button>
					}
				</form>
			}
			if !hasForwardAction(props) {
				<p class="text-sm text-rr-muted">{ nextActionReason(props) }</p>
			}
		</div>
		if hasCorrection(props.Order) {
			<div class="mt-4 border-t border-rr-border pt-3">
				<p class="label-font text-xs uppercase tracking-wide text-rr-muted">Correct a mistake</p>
				<div class="mt-2 flex flex-col gap-2">
					if canRevertFulfillment(props.Order) {
						<form
							method="post"
							action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/revert-fulfillment", props.Order.ID.String())) }
						>
							@ActionWrap("hint-revert-fulfillment", "Puts the order back in the fulfillment queue. Use only if it was marked fulfilled by mistake.") {
								<button
									{ ConfirmAttrs(ActionConfirm{
									Title: "Revert this order to unfulfilled?",
									Lead:  "Puts the order back in the fulfillment queue. Use this only if it was marked fulfilled by mistake.",
									Points: []string{
										"The order moves from processing back to confirmed.",
										"Payment status is left untouched.",
										"The customer is not emailed.",
									},
									Confirm: "Revert fulfillment",
								})... }
									type="submit"
									aria-describedby="hint-revert-fulfillment"
									class="btn-secondary w-full justify-center text-xs"
								>
									Revert Fulfillment
								</button>
							}
						</form>
					}
					if canRevertShipment(props.Order) {
						<form
							method="post"
							action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/revert-shipment", props.Order.ID.String())) }
						>
							@ActionWrap("hint-revert-shipment", "Moves the order back to fulfilled. Any label already bought stays bought — handle that separately.") {
								<button
									{ ConfirmAttrs(ActionConfirm{
									Title: "Revert shipped status back to fulfilled?",
									Lead:  "Moves the order out of shipped and back into fulfilled.",
									Points: revertShipmentPoints(props.Shipments),
									Confirm: "Revert shipment",
								})... }
									type="submit"
									aria-describedby="hint-revert-shipment"
									class="btn-secondary w-full justify-center text-xs"
								>
									Revert Shipment
								</button>
							}
						</form>
					}
				</div>
			</div>
		}
	}
}

// orderDangerZone holds the two actions that cannot be walked back. Kept in
// its own card at the bottom of the rail, well away from the buttons staff
// click through quickly.
templ orderDangerZone(props OrderShowProps) {
	@railCard("Danger zone") {
		<div class="flex flex-col gap-2">
			if canCancelOrder(props.Order.Status) {
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/cancel", props.Order.ID.String())) }
				>
					@ActionWrap("hint-cancel", "Closes the order as cancelled. It does not refund any payment and does not email the customer.") {
						<button
							type="submit"
							class="btn-danger w-full justify-center"
							aria-describedby="hint-cancel"
							{ ConfirmAttrs(ActionConfirm{
							Title: "Cancel this order?",
							Lead:  "Closes the order as cancelled so it drops out of the fulfillment queue.",
							Points: []string{
								"No money is refunded. If the order was paid, refund it separately.",
								"The customer is not emailed.",
								"Any coupon used on the order is released so the code can be used again.",
							},
							Confirm: "Cancel order",
							Danger:  true,
						})... }
						>
							Cancel Order
						</button>
					}
				</form>
			}
			if canRefundOrder(props.Order.Status, props.Order.PaymentStatus) {
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/refund", props.Order.ID.String())) }
				>
					@ActionWrap("hint-refund", fmt.Sprintf("Refunds the full %s to the customer's card through Stripe. Cannot be undone from Hiri.", formatCents(props.Order.Total))) {
						<button
							type="submit"
							class="btn-danger w-full justify-center"
							aria-describedby="hint-refund"
							{ ConfirmAttrs(ActionConfirm{
							Title: fmt.Sprintf("Refund %s to the customer?", formatCents(props.Order.Total)),
							Lead:  fmt.Sprintf("Sends the full %s back to the card through Stripe, then marks the order refunded.", formatCents(props.Order.Total)),
							Points: []string{
								"The whole order total is refunded. There is no partial refund here — issue those in Stripe.",
								"This cannot be undone from Hiri.",
								"Stripe may email the customer its own receipt; Hiri does not.",
								"Refunding does not cancel the order or stop fulfillment — cancel it separately if the coffee has not gone out.",
							},
							Confirm: fmt.Sprintf("Refund %s", formatCents(props.Order.Total)),
							Danger:  true,
						})... }
						>
							Refund Order
						</button>
					}
				</form>
			}
		</div>
	}
}

templ orderLineItemsTable(props OrderShowProps) {
	<div>
		<h2 class="text-sm font-semibold text-rr-heading">Line items</h2>
		if len(props.LineItems) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No line items.</p>
		} else {
			<div class="mt-2 overflow-x-auto border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Product</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Grind / option</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">SKU</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Qty</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Unit Price</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Total</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, eli := range props.LineItems {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									if eli.ProductTitle != "" {
										<span class="font-medium text-rr-heading">{ eli.ProductTitle }</span>
									} else {
										<span class="font-medium text-rr-heading">{ eli.LineItem.VariantID.String()[:8] }...</span>
									}
								</td>
								<td class="px-3 py-4 text-sm text-rr-muted">
									@grindCell(props.Order.ID, eli, props.CanEditLineItems)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									if eli.VariantSKU != "" {
										{ eli.VariantSKU }
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted text-right tabular-nums">
									{ fmt.Sprintf("%d", eli.LineItem.Quantity) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted text-right tabular-nums">
									{ formatCents(eli.LineItem.UnitPrice) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-heading text-right tabular-nums font-medium">
									{ formatCents(eli.LineItem.Total) }
								</td>
							</tr>
						}
					</tbody>
					<tfoot class="border-t border-rr-border bg-rr-raised">
						<tr>
							@totalsSpacerCell()
							<td colspan="4" class="py-2 pr-3 text-right text-sm text-rr-muted">Subtotal</td>
							<td class="whitespace-nowrap px-3 py-2 text-right text-sm text-rr-heading tabular-nums">{ formatCents(props.Order.Subtotal) }</td>
						</tr>
						if props.Order.DiscountTotal > 0 {
							<tr>
								@totalsSpacerCell()
								<td colspan="4" class="py-2 pr-3 text-right text-sm text-rr-muted">Discounts</td>
								<td class="whitespace-nowrap px-3 py-2 text-right text-sm text-rr-heading tabular-nums">-{ formatCents(props.Order.DiscountTotal) }</td>
							</tr>
						}
						<tr>
							@totalsSpacerCell()
							<td colspan="4" class="py-2 pr-3 text-right text-sm text-rr-muted">Shipping</td>
							<td class="whitespace-nowrap px-3 py-2 text-right text-sm text-rr-heading tabular-nums">{ formatCents(props.Order.ShippingTotal) }</td>
						</tr>
						<tr>
							@totalsSpacerCell()
							<td colspan="4" class="py-2 pr-3 text-right text-sm text-rr-muted">
								Tax
								if props.Order.TaxExempt {
									<span class="badge badge-slate ml-1.5">Exempt</span>
								}
							</td>
							<td class="whitespace-nowrap px-3 py-2 text-right text-sm text-rr-heading tabular-nums">{ formatCents(props.Order.TaxTotal) }</td>
						</tr>
						<tr class="border-t border-rr-border">
							@totalsSpacerCell()
							<td colspan="4" class="py-3 pr-3 text-right text-sm font-semibold text-rr-heading">Total</td>
							<td class="whitespace-nowrap px-3 py-3 text-right text-sm font-semibold text-rr-heading tabular-nums">{ formatCents(props.Order.Total) }</td>
						</tr>
					</tfoot>
				</table>
			</div>
			if props.Order.TaxExempt && props.Order.TaxExemptReason != nil && *props.Order.TaxExemptReason != "" {
				<p class="mt-2 text-xs text-rr-muted">Tax exempt — { *props.Order.TaxExemptReason }</p>
			}
		}
	</div>
}

// totalsSpacerCell keeps the totals footer's column count matching the rows
// above it. The SKU column is hidden below sm:, so the body has five cells
// there and six at wider widths; a fixed colspan on the label would span a
// phantom column at one width or the other and shove the amounts out of line
// with the Total column. The label spans four, and this cell disappears with
// the column it stands in for.
templ totalsSpacerCell() {
	<td class="hidden sm:table-cell"></td>
}

templ orderAdjustmentsTable(props OrderShowProps) {
	<div>
		<h2 class="text-sm font-semibold text-rr-heading">Adjustments</h2>
		<div class="mt-2 overflow-x-auto border border-rr-border bg-rr-surface">
			<table class="min-w-full divide-y divide-rr-border">
				<thead class="bg-rr-raised">
					<tr>
						<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Label</th>
						<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Type</th>
						<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Amount</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-rr-border bg-rr-surface">
					for _, adj := range props.Adjustments {
						<tr>
							<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-rr-heading sm:pl-6">{ adj.Label }</td>
							<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">{ adj.SourceType }</td>
							<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-heading text-right tabular-nums">{ formatCents(adj.Amount) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ OrderShowContent(props OrderShowProps) {
	// Marker the sidebar's updateActiveNav() reads after an htmx swap to pick the
	// right nav item — the URL alone can't distinguish retail from wholesale here.
	<div data-active-path={ orderShowActivePath(props.Order) } class="hidden"></div>
	if props.Flash != "" {
		@flashToast(props.Flash)
	}
	@ConfirmDialogHost()
	if props.AccountPastDue && props.Order.Status != domain.OrderStatusCancelled && props.Order.Status != domain.OrderStatusRefunded {
		<!-- Not-current account: warn before staff fulfill more of this customer's orders. -->
		<div class="mb-5 flex items-start justify-between gap-4 border border-rr-border bg-rr-surface px-4 py-3">
			<div class="min-w-0">
				<p class="text-sm font-semibold text-rr-red">Account past due</p>
				<p class="mt-0.5 text-sm text-rr-body">This customer has invoices past terms. Hold new fulfillment until the account is current — check their order history before shipping.</p>
			</div>
			if props.Customer != nil {
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", props.Customer.ID)) } class="shrink-0 text-sm font-semibold text-rr-red hover:text-rr-red-lt">View account &rarr;</a>
			}
		</div>
	}
	<!-- Header: identity and the three status axes up top, printing demoted to
	     secondary so the rail's Next action is the only primary CTA on screen. -->
	<div class="sm:flex sm:items-start sm:justify-between sm:gap-6">
		<div class="min-w-0">
			<h1 class="admin-page-title">Order { props.Order.Number }</h1>
			@orderStatusHeader(props)
			<p class="mt-2 text-sm text-rr-muted">Placed { props.Order.PlacedAt.In(props.MerchantTZ).Format("January 2, 2006 at 3:04 PM") }</p>
		</div>
		<div class="mt-4 flex shrink-0 flex-wrap items-center gap-3 sm:mt-0">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/invoice", props.Order.ID.String())) }
				target="_blank"
				class="inline-flex items-center gap-1.5 rounded-sm bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
			>
				<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18.75 12h.008v.008h-.008V12Zm-2.25 0h.008v.008H16.5V12Z"></path>
				</svg>
				Print Invoice
			</a>
			<a
				href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/packing-slip", props.Order.ID.String())) }
				target="_blank"
				class="inline-flex items-center gap-1.5 rounded-sm bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
			>
				<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18.75 12h.008v.008h-.008V12Zm-2.25 0h.008v.008H16.5V12Z"></path>
				</svg>
				Packing Slip
			</a>
			<a href={ templ.SafeURL(orderShowActivePath(props.Order)) } class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">&larr; Back to orders</a>
		</div>
	</div>
	if props.LatestLabelAttempt != nil {
		{{ headline, detail := LabelAttemptMessage(props.LatestLabelAttempt) }}
		if headline != "" {
			<div class="mt-6">
				if props.LatestLabelAttempt.Status == domain.LabelAttemptStatusFailed {
					<div class="flex items-start gap-2 border border-rr-border bg-rr-surface px-3 py-2 text-sm">
						<span class="badge badge-red mt-0.5">{ headline }</span>
						<span class="text-rr-body">{ detail }</span>
					</div>
				} else {
					<div class="flex items-center gap-2 text-sm">
						<span class="badge badge-amber">{ headline }</span>
						if shouldPollLabel(props) {
							<span class="text-rr-muted">Worker is buying this label — this page updates on its own.</span>
						} else {
							<span class="text-rr-muted">Worker is processing this label — refresh in a moment.</span>
						}
					</div>
				}
			</div>
		}
	}
	if shouldPollLabel(props) {
		<!-- Label auto-refresh. While the BuyLabel worker runs, this element
		     re-fetches the order content into #main-content every ~2s. Each
		     swapped-in response carries the next poll counter, so the loop
		     chains itself until the shipment/label appears (poller no longer
		     rendered) or maxLabelPolls is hit. innerHTML swap (no show:) keeps
		     the scroll position steady across ticks instead of jumping to top. -->
		<div
			hx-get={ nextLabelPollURL(props) }
			hx-trigger="load delay:2s"
			hx-target="#main-content"
			hx-swap="innerHTML"
			class="hidden"
			aria-hidden="true"
		></div>
	}
	<!-- Two columns: what the order IS on the left, what you can DO about it
	     and who it belongs to on the right. The page used to stack eighteen
	     full-width bands with every action above every fact. -->
	<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
		<div class="flex min-w-0 flex-col gap-6">
			<!-- Rate chooser lands here, not in the rail: a list of carrier
			     services with prices needs the width. -->
			<div id="label-rates-panel"></div>
			if hasLabeledShipment(props.Shipments) {
				@orderShipmentsBlock(props)
			}
			@orderLineItemsTable(props)
			if len(props.Adjustments) > 0 {
				@orderAdjustmentsTable(props)
			}
			@OrderActivity(props.Activity, props.MerchantTZ)
		</div>
		<aside class="flex flex-col gap-4 xl:sticky xl:top-6 xl:self-start">
			@orderActionRail(props)
			@orderPaymentCard(props)
			if props.Customer != nil {
				@orderCustomerCard(props)
			}
			@orderAddressCard(props)
			if hasShippingDetails(props.Order) {
				@orderShippingCard(props)
			}
			@orderNotesCard(props)
			if canCancelOrder(props.Order.Status) || canRefundOrder(props.Order.Status, props.Order.PaymentStatus) {
				@orderDangerZone(props)
			}
		</aside>
	</div>
}

// internalNoteValue is the textarea's current contents. Kept as a Go
// expression on one line: templ would otherwise indent an if-block inside the
// element, and a textarea renders its leading whitespace verbatim.
func internalNoteValue(o *domain.Order) string {
	if o.InternalNote == nil {
		return ""
	}
	return *o.InternalNote
}

// ordinalOrderCount turns a customer's lifetime order count into the phrase
// staff actually care about: is this a regular or a first-timer.
func ordinalOrderCount(n int) string {
	switch {
	case n <= 0:
		return ""
	case n == 1:
		return "First order"
	case n == 2:
		return "2nd order"
	case n == 3:
		return "3rd order"
	default:
		return fmt.Sprintf("%d orders placed", n)
	}
}

// sameAddress reports whether billing and shipping are the same place, in
// which case the rail shows one address instead of two identical ones.
func sameAddress(a *domain.Address, b *domain.Address) bool {
	if a == nil || b == nil {
		return a == b
	}
	return a.ID == b.ID ||
		(a.Line1 == b.Line1 && a.City == b.City &&
			a.State == b.State && a.PostalCode == b.PostalCode)
}

templ addressLines(addr *domain.Address) {
	<address class="text-sm text-rr-heading not-italic">
		<p>{ addr.FirstName } { addr.LastName }</p>
		if addr.Company != nil && *addr.Company != "" {
			<p>{ *addr.Company }</p>
		}
		<p>{ addr.Line1 }</p>
		if addr.Line2 != nil && *addr.Line2 != "" {
			<p>{ *addr.Line2 }</p>
		}
		<p>{ addr.City }, { addr.State } { addr.PostalCode }</p>
	</address>
}

// orderPaymentCard gathers everything about the money in one place: the total,
// what discounted it, when it's due, and the external ids (Stripe, QuickBooks)
// support needs to chase a payment. The Stripe id used to get its own
// full-width band for a single line of mono text; QuickBooks was invisible
// even though the mark-paid gate branches on it.
templ orderPaymentCard(props OrderShowProps) {
	@railCard("Payment") {
		<div class="flex flex-col gap-1.5">
			@railRow("Total") {
				<span class="text-base font-semibold tabular-nums">{ formatCents(props.Order.Total) }</span>
			}
			if props.Order.DiscountTotal > 0 {
				@railRow("Discount") {
					<span class="tabular-nums">-{ formatCents(props.Order.DiscountTotal) }</span>
					if props.CouponCode != "" {
						<span class="ml-1.5 font-mono text-xs text-rr-muted">{ props.CouponCode }</span>
					}
				}
			}
			if props.Order.TaxExempt {
				@railRow("Tax") {
					<span class="badge badge-slate">Exempt</span>
				}
			}
			if props.PaymentDueAt != nil {
				@railRow("Due") {
					<!-- No .In(MerchantTZ): PaymentDueAt is a calendar date, already
					     resolved in the shop's zone by app.InvoiceDueDate and carried
					     as midnight UTC — the same shape the date column and QuickBooks
					     use. Re-zoning it westward would print the day before. -->
					if props.AccountPastDue {
						<span class="font-semibold text-rr-red">{ props.PaymentDueAt.Format("January 2, 2006") }</span>
					} else {
						{ props.PaymentDueAt.Format("January 2, 2006") }
					}
				}
			}
			if props.Order.QBInvoiceNo != nil && *props.Order.QBInvoiceNo != "" {
				@railRow("QB invoice") {
					<span class="font-mono text-xs">{ *props.Order.QBInvoiceNo }</span>
				}
			}
			if props.Order.QBSyncedAt != nil {
				@railRow("QB synced") {
					<span class="text-xs">{ props.Order.QBSyncedAt.In(props.MerchantTZ).Format("Jan 2, 3:04 PM") }</span>
				}
			}
			if props.Order.StripePaymentIntentID != nil && *props.Order.StripePaymentIntentID != "" {
				<div class="mt-1 border-t border-rr-border pt-2">
					<p class="text-xs text-rr-muted">Stripe payment intent</p>
					<p class="break-all font-mono text-xs text-rr-heading">{ *props.Order.StripePaymentIntentID }</p>
				</div>
			}
		</div>
	}
}

templ orderCustomerCard(props OrderShowProps) {
	@railCard("Customer") {
		<div class="flex flex-col gap-1">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", props.Customer.ID.String())) }
				class="text-sm font-semibold text-rr-red hover:text-rr-red-lt"
			>
				{ props.Customer.FirstName } { props.Customer.LastName }
			</a>
			if props.Customer.CompanyName != nil && *props.Customer.CompanyName != "" {
				<p class="text-sm text-rr-heading">{ *props.Customer.CompanyName }</p>
			}
			<a href={ templ.SafeURL("mailto:" + props.Customer.Email) } class="break-all text-xs text-rr-muted hover:text-rr-red">{ props.Customer.Email }</a>
			if props.Customer.Phone != nil && *props.Customer.Phone != "" {
				<a href={ templ.SafeURL("tel:" + *props.Customer.Phone) } class="text-xs text-rr-muted hover:text-rr-red">{ *props.Customer.Phone }</a>
			}
			if ordinalOrderCount(props.CustomerOrderCount) != "" {
				<p class="mt-1 text-xs text-rr-muted">{ ordinalOrderCount(props.CustomerOrderCount) }</p>
			}
		</div>
	}
}

templ orderAddressCard(props OrderShowProps) {
	@railCard("Ship to") {
		if props.ShippingAddress != nil {
			@addressLines(props.ShippingAddress)
		} else {
			<p class="text-sm text-rr-muted">No shipping address on this order.</p>
		}
		if props.BillingAddress != nil && !sameAddress(props.ShippingAddress, props.BillingAddress) {
			<div class="mt-3 border-t border-rr-border pt-3">
				<p class="label-font text-xs uppercase tracking-wide text-rr-muted">Bill to</p>
				<div class="mt-1.5">
					@addressLines(props.BillingAddress)
				</div>
			</div>
		} else {
			if props.BillingAddress != nil {
				<p class="mt-2 text-xs text-rr-muted">Billed to the same address.</p>
			}
		}
	}
}

// hasShippingDetails reports whether the Shipping rail card has anything to
// say. A card-paid retail order can carry no method, no dates, no PO and no
// subscription — without this guard the rail rendered an empty titled box.
func hasShippingDetails(order *domain.Order) bool {
	return order.ShippingMethod != nil ||
		order.ScheduledDeliveryDate != nil ||
		order.RequestedDeliveryDate != nil ||
		(order.CustomerPONumber != nil && *order.CustomerPONumber != "") ||
		order.SubscriptionID != nil
}

// orderShippingCard is where the method lives together with the controls that
// change it. Those two buttons used to sit inside a read-only-looking metadata
// strip halfway down the page, which is a poor home for a state change.
templ orderShippingCard(props OrderShowProps) {
	@railCard("Shipping") {
		<div class="flex flex-col gap-2">
			if props.Order.ShippingMethod != nil {
				<div class="flex flex-wrap items-center gap-2">
					@ShippingMethodBadge(*props.Order.ShippingMethod)
				</div>
			}
			if props.Order.ScheduledDeliveryDate != nil {
				<!-- The run this order was promised at checkout, distinct from the
					imported "requested" date. Shown so staff can honour the date the
					customer was actually told. -->
				@railRow("Promised") {
					<span class="font-medium">{ props.Order.ScheduledDeliveryDate.Format("Monday, January 2") }</span>
				}
			}
			if props.Order.RequestedDeliveryDate != nil {
				@railRow("Requested") {
					{ props.Order.RequestedDeliveryDate.In(props.MerchantTZ).Format("January 2, 2006") }
				}
			}
			if props.Order.CustomerPONumber != nil && *props.Order.CustomerPONumber != "" {
				@railRow("PO #") {
					{ *props.Order.CustomerPONumber }
				}
			}
			if props.Order.SubscriptionID != nil {
				@railRow("Subscription") {
					<a
						href={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s", props.Order.SubscriptionID.String())) }
						class="font-semibold text-rr-red hover:text-rr-red-lt"
					>View plan &rarr;</a>
				}
			}
			if canSwapShippingMethod(props.Order) {
				<div class="mt-1 flex flex-col gap-2 border-t border-rr-border pt-3">
					@shippingMethodSwap(props.Order.ID, *props.Order.ShippingMethod)
					@convertToShippedForm(props.Order.ID)
				</div>
			}
		</div>
	}
}

// orderNotesCard holds both notes: the customer's, read-only from checkout,
// and the staff one. InternalNote existed on the order for the whole life of
// the app and was rendered nowhere — there was no way to read or write it.
templ orderNotesCard(props OrderShowProps) {
	@railCard("Notes") {
		if props.Order.Notes != nil && *props.Order.Notes != "" {
			<div class="mb-3">
				<p class="text-xs text-rr-muted">From the customer</p>
				<p class="mt-0.5 whitespace-pre-line text-sm text-rr-heading">{ *props.Order.Notes }</p>
			</div>
		}
		<form
			method="post"
			action={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/internal-note", props.Order.ID.String())) }
			class="flex flex-col gap-2"
		>
			<label for="internal-note" class="text-xs text-rr-muted">Staff note &mdash; not shown to the customer</label>
			<textarea
				id="internal-note"
				name="internal_note"
				rows="3"
				class="w-full border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
				placeholder="Anything the next person should know."
			>{ internalNoteValue(props.Order) }</textarea>
			<button type="submit" class="btn-secondary self-start text-xs">Save note</button>
		</form>
	}
}

templ OrderShow(props OrderShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      fmt.Sprintf("Order %s", props.Order.Number),
		ActivePath: orderShowActivePath(props.Order),
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@OrderShowContent(props)
	}
}
