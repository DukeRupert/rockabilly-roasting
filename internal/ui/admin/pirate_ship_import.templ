package admin

import (
	"fmt"

	"github.com/dukerupert/hiri/internal/app"
)

// PirateShipImportButton renders the "Import tracking from Pirate Ship"
// upload control as a popover-style form: clicking the trigger reveals a
// file input and submit button. Submit posts via htmx so the response
// summary table swaps inline beneath the button without a page reload.
templ PirateShipImportButton() {
	<div x-data="{ open: false }" class="relative">
		<button
			type="button"
			x-on:click="open = !open"
			class="inline-flex items-center justify-center gap-2 rounded-sm border border-rr-ink bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-ink hover:bg-rr-raised"
		>
			<svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path d="M9.25 13.25V4.56l-2.47 2.47a.75.75 0 1 1-1.06-1.06l3.75-3.75a.75.75 0 0 1 1.06 0l3.75 3.75a.75.75 0 0 1-1.06 1.06L10.75 4.56v8.69a.75.75 0 0 1-1.5 0Z"></path>
				<path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z"></path>
			</svg>
			<span>Import tracking</span>
		</button>
		<div
			x-show="open"
			x-cloak
			x-transition.opacity
			x-on:click.outside="open = false"
			class="absolute right-0 top-full z-20 mt-2 w-80 max-w-[90vw] border border-rr-ink bg-rr-paper p-4"
			style="box-shadow: 4px 4px 0 0 var(--color-rr-ink, #0E0D0C);"
		>
			<form
				hx-post="/admin/orders/import-tracking"
				hx-encoding="multipart/form-data"
				hx-target="#pirate-ship-import-summary"
				hx-swap="innerHTML"
				hx-on::after-request="if (event.detail.successful) { this.reset(); }"
				class="space-y-3"
			>
				<div>
					<label for="pirate-ship-tracking-file" class="block text-sm font-semibold text-rr-ink">Tracking export (.csv)</label>
					<p class="mt-1 text-xs text-rr-body">Upload the CSV from Pirate Ship after labels print. Each row marks the matching order shipped and emails tracking to the customer.</p>
				</div>
				<input
					id="pirate-ship-tracking-file"
					type="file"
					name="file"
					accept=".csv,text/csv"
					required
					class="block w-full text-sm text-rr-body file:mr-3 file:rounded-sm file:border file:border-rr-ink file:bg-rr-surface file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-rr-ink hover:file:bg-rr-raised"
				/>
				<div class="flex items-center justify-end gap-2">
					<button type="button" x-on:click="open = false" class="rounded-sm px-3 py-1.5 text-sm text-rr-body hover:text-rr-ink">Cancel</button>
					<button type="submit" class="inline-flex items-center justify-center rounded-sm bg-rr-red px-3 py-1.5 text-sm font-semibold text-white hover:bg-rr-red/90">
						Upload
					</button>
				</div>
			</form>
		</div>
	</div>
}

// PirateShipImportSummaryProps drives the summary table that renders below
// the orders page after an import POST returns.
type PirateShipImportSummaryProps struct {
	Recorded []app.ImportResult
	Skipped  []app.ImportResult
	Errored  []app.ImportResult
}

// PirateShipImportSummary renders inline below the orders page after an
// import POST returns. Three buckets — recorded, skipped, errored — each
// with a per-row line so the operator can spot problems immediately.
templ PirateShipImportSummary(props PirateShipImportSummaryProps) {
	<div class="mt-4 border border-rr-ink bg-rr-surface p-4" style="box-shadow: 4px 4px 0 0 var(--color-rr-ink, #0E0D0C);">
		<div class="flex items-baseline justify-between gap-3">
			<h2 class="admin-page-title text-xl">Import results</h2>
			<div class="flex items-center gap-3 text-sm tabular-nums text-rr-body">
				<span><strong class="text-rr-ink">{ fmt.Sprintf("%d", len(props.Recorded)) }</strong> recorded</span>
				<span><strong class="text-rr-ink">{ fmt.Sprintf("%d", len(props.Skipped)) }</strong> skipped</span>
				<span><strong class="text-rr-ink">{ fmt.Sprintf("%d", len(props.Errored)) }</strong> errors</span>
			</div>
		</div>
		if len(props.Recorded) == 0 && len(props.Skipped) == 0 && len(props.Errored) == 0 {
			<p class="mt-3 text-sm text-rr-body">The file was empty &mdash; nothing to do.</p>
		} else {
			<div class="mt-4 space-y-4">
				if len(props.Recorded) > 0 {
					@importBucket("Recorded", props.Recorded, "ok")
				}
				if len(props.Skipped) > 0 {
					@importBucket("Skipped", props.Skipped, "warn")
				}
				if len(props.Errored) > 0 {
					@importBucket("Errors", props.Errored, "bad")
				}
			</div>
		}
	</div>
}

// importBucket renders one of the three sections of the summary. Tone is
// keyed off the badge so all three buckets share visuals but stay
// distinguishable at a glance.
templ importBucket(title string, rows []app.ImportResult, tone string) {
	<div>
		<div class="flex items-center gap-2 border-b border-rr-border pb-1.5">
			<span class={ importBucketBadge(tone) }>{ title }</span>
			<span class="text-xs tabular-nums text-rr-muted">{ fmt.Sprintf("%d row(s)", len(rows)) }</span>
		</div>
		<ul class="mt-2 divide-y divide-rr-border">
			for _, r := range rows {
				<li class="flex items-baseline justify-between gap-3 py-1.5 text-sm">
					<div class="min-w-0">
						<span class="font-mono text-rr-muted">#{ fmt.Sprintf("%d", r.LineNumber) }</span>
						<span class="ml-2 font-semibold text-rr-ink">{ orImportFallback(r.OrderNumber) }</span>
					</div>
					if r.Reason != "" {
						<span class="truncate text-rr-body">{ r.Reason }</span>
					}
				</li>
			}
		</ul>
	</div>
}

// importBucketBadge picks the badge styling for one of the three import
// outcome buckets. Inline so the table reads top-to-bottom without a
// helper-class jump.
func importBucketBadge(tone string) string {
	switch tone {
	case "ok":
		return "inline-flex items-center px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.18em] bg-rr-amber text-rr-ink"
	case "bad":
		return "inline-flex items-center px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.18em] bg-rr-red text-white"
	default: // "warn" + fallback
		return "inline-flex items-center px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.18em] bg-rr-raised text-rr-ink border border-rr-ink"
	}
}

// orImportFallback shows a placeholder when an import row didn't even have
// an order number — typically because the row was blank or the column was
// missing. Keeps the table aligned without rendering a literal empty cell.
func orImportFallback(s string) string {
	if s == "" {
		return "(no order id)"
	}
	return s
}
