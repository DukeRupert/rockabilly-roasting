package admin

import (
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/audit"
)

// priceListEventLabel turns a price_list.* audit action into staff-facing copy.
func priceListEventLabel(action string) string {
	switch action {
	case audit.AuditPriceListCreated:
		return "Price list created"
	case audit.AuditPriceListUpdated:
		return "Price list updated"
	case audit.AuditPriceListDeleted:
		return "Price list deleted"
	}
	parts := strings.SplitN(action, ".", 2)
	if len(parts) == 2 {
		verb := strings.ReplaceAll(parts[1], "_", " ")
		return strings.ToUpper(verb[:1]) + verb[1:]
	}
	return action
}

func priceListEventMarker(action string) string {
	switch action {
	case audit.AuditPriceListDeleted:
		return "bg-rr-red"
	case audit.AuditPriceListCreated:
		return "bg-rr-amber"
	default:
		return "bg-rr-surface"
	}
}

// PriceListActivity is the list's history. What staff want from it is
// attribution on a rename or a status flip: a price list going inactive changes
// what a whole set of wholesale accounts pays.
templ PriceListActivity(entries []domain.AuditEntry, loc *time.Location) {
	@ActivityTimeline(entries, priceListEventLabel, priceListEventMarker, loc)
}
