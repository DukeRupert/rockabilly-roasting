package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
	"github.com/google/uuid"
)

type PriceListListProps struct {
	Lists          []domain.PriceList
	CustomerCounts map[uuid.UUID]int
	StaffName      string
	StaffRole      string
}

templ PriceListListContent(props PriceListListProps) {
	@adminSectionTabs(catalogTabs(), "/admin/price-lists")
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Pricing</h1>
			<p class="mt-1 text-sm text-rr-muted">A price list is a set of overrides on the base price. Open one to edit its prices and see who is on it; variants with no entry charge base.</p>
		</div>
		<div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
			<a
				href="/admin/price-lists/prices"
				class="block rounded-sm bg-rr-red px-3 py-2 text-center text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
			>
				Compare all lists
			</a>
		</div>
	</div>
	<!-- Create form -->
	<div class="mt-6">
		<form method="post" action="/admin/price-lists" class="flex items-end gap-3">
			<div class="flex-1 max-w-sm">
				<label for="name" class="block text-sm/6 font-medium text-rr-heading">New price list</label>
				<div class="mt-2">
					<input
						type="text"
						name="name"
						id="name"
						required
						placeholder="e.g. Wholesale Tier 1"
						class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"
					/>
				</div>
			</div>
			<div>
				<label for="status" class="block text-sm/6 font-medium text-rr-heading">Status</label>
				<select
					name="status"
					id="status"
					class="mt-2 block rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"
				>
					<option value="active" selected>Active</option>
					<option value="draft">Draft</option>
					<option value="expired">Expired</option>
				</select>
			</div>
			<button
				type="submit"
				class="rounded-sm bg-rr-red px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
			>
				Create list
			</button>
		</form>
	</div>
	<!-- Lists table -->
	<div class="mt-8">
		if len(props.Lists) == 0 {
			<div class="border border-dashed border-rr-border p-12 text-center">
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No price lists</h3>
				<p class="mt-1 text-sm text-rr-muted">Create a price list to start assigning customers and overriding base prices.</p>
			</div>
		} else {
			<div class="overflow-hidden border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Name</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Customers</th>
							<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
								<span class="sr-only">Open</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, pl := range props.Lists {
							<tr class="row-link">
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/price-lists/%s", pl.ID)) } class="row-link-target font-medium text-rr-heading hover:text-rr-red">
										{ pl.Name }
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@PriceListStatusBadge(pl.Status)
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-body tabular-nums">
									{ fmt.Sprintf("%d", props.CustomerCounts[pl.ID]) }
								</td>
								<td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/price-lists/%s", pl.ID)) } class="text-rr-red hover:text-rr-red-lt">
										Open<span class="sr-only">, { pl.Name }</span>
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ PriceListList(props PriceListListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Pricing",
		ActivePath: "/admin/price-lists",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@PriceListListContent(props)
	}
}
