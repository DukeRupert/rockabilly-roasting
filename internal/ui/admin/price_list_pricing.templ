package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
	"github.com/google/uuid"
)

type PriceListPricingProps struct {
	Products  []ProductPriceListPricing
	Lists     []domain.PriceList
	StaffName string
	StaffRole string
}

type ProductPriceListPricing struct {
	Product  domain.Product
	Variants []VariantPriceListPricing
}

type VariantPriceListPricing struct {
	Variant    domain.Variant
	PriceCents *int
	ListPrices map[uuid.UUID]int
}

// priceListDollars renders the price for a given list ID as a dollar string, or
// "" when unset. Used to seed the hidden "previous value" inputs.
func priceListDollars(prices map[uuid.UUID]int, listID uuid.UUID) string {
	if cents, ok := prices[listID]; ok {
		return priceToDollars(cents)
	}
	return ""
}

templ PriceListPricingContent(props PriceListPricingProps) {
	<!-- One page-wide form: a single Save button writes every product's changed cells in one transaction -->
	<form
		method="post"
		action={ templ.SafeURL("/admin/price-lists/prices/bulk") }
		hx-post="/admin/price-lists/prices/bulk"
		hx-target="#price-list-pricing-content"
		hx-swap="innerHTML"
	>
		<!-- Page header -->
		<div class="sm:flex sm:items-center">
			<div class="sm:flex-auto">
				<h1 class="admin-page-title">Price List Pricing</h1>
				<p class="mt-1 text-sm text-rr-muted">
					Set per-list overrides for any variant. Empty cells fall back to the base price.
					if len(props.Lists) == 0 {
						<a href="/admin/price-lists" class="text-rr-red hover:text-rr-red-lt">Create a price list</a> to enable list pricing.
					}
				</p>
			</div>
			<div class="mt-4 flex items-center gap-3 sm:ml-16 sm:mt-0 sm:flex-none">
				<a
					href="/admin/price-lists"
					class="block rounded-sm bg-rr-surface px-3 py-2 text-center text-sm font-semibold text-rr-heading shadow-xs border border-rr-border hover:bg-rr-raised"
				>
					Manage lists
				</a>
				if len(props.Products) > 0 && len(props.Lists) > 0 {
					<button
						type="submit"
						class="rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt"
					>
						Save changes
					</button>
				}
			</div>
		</div>
		if len(props.Products) == 0 {
			<div class="mt-8 border border-dashed border-rr-border p-12 text-center">
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No products with variants</h3>
				<p class="mt-1 text-sm text-rr-muted">Create products and add variants to start setting prices.</p>
			</div>
		} else if len(props.Lists) == 0 {
			<div class="mt-8 border border-dashed border-rr-border p-12 text-center">
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No price lists</h3>
				<p class="mt-1 text-sm text-rr-muted">Create a price list before setting overrides.</p>
			</div>
		} else {
			<div class="mt-8 space-y-10">
				for _, pp := range props.Products {
					if len(pp.Variants) > 0 {
						@priceListProductBlock(props.Lists, pp)
					}
				}
			</div>
		}
	</form>
}

// priceListProductBlock renders one product as a single table: one row per
// variant, with a read-only Base column followed by one editable column per
// price list. This keeps every override comparable at a glance and sits next to
// the base it falls back to. It carries no form or Save button of its own — the
// single Save button in the header submits every product's changed cells together.
//
// The input name/id scheme (list:<list>:<variant>, list_prev:<list>:<variant>,
// id plprev-<list>-<variant>) is unchanged, so the bulk-save handler and its
// success OOB updates keep working without modification.
templ priceListProductBlock(lists []domain.PriceList, pp ProductPriceListPricing) {
	<div>
		<!-- Product heading -->
		<div class="flex items-center justify-between mb-3">
			<h2 class="text-sm font-semibold text-rr-heading">{ pp.Product.Title }</h2>
			<a
				href={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s", pp.Product.ID)) }
				class="text-xs text-rr-red hover:text-rr-red-lt"
			>
				Edit product
			</a>
		</div>
		<!-- One table: SKU | Base (read-only) | one editable column per price list -->
		<div class="overflow-x-auto border border-rr-border bg-rr-surface">
			<table class="min-w-full divide-y divide-rr-border">
				<thead class="bg-rr-raised">
					<tr>
						<th scope="col" class="sticky left-0 z-10 bg-rr-raised py-2.5 pl-4 pr-3 text-left text-xs font-semibold text-rr-heading sm:pl-6">SKU</th>
						<th scope="col" class="px-3 py-2.5 text-left text-xs font-semibold text-rr-heading">Base</th>
						for _, list := range lists {
							<th scope="col" class="whitespace-nowrap px-3 py-2.5 text-left text-xs font-semibold text-rr-teal">
								{ list.Name }
								if list.Status != domain.PriceListStatusActive {
									<span class="ml-1 font-normal text-rr-muted">({ string(list.Status) })</span>
								}
							</th>
						}
					</tr>
				</thead>
				<tbody class="divide-y divide-rr-border bg-rr-surface">
					for _, vp := range pp.Variants {
						<tr>
							<td class="sticky left-0 z-10 whitespace-nowrap bg-rr-surface py-2.5 pl-4 pr-3 text-sm sm:pl-6">
								<span class="font-mono font-medium text-rr-heading">{ vp.Variant.SKU }</span>
								if vp.Variant.IsDefault {
									<span class="badge badge-green ml-1.5">Default</span>
								}
							</td>
							<!-- Base price (read-only — edit via the product page) -->
							<td class="whitespace-nowrap px-3 py-2.5 text-sm text-rr-muted">
								if vp.PriceCents != nil {
									<span class="font-mono">${ priceToDollars(*vp.PriceCents) }</span>
								} else {
									<span class="italic">&mdash;</span>
								}
							</td>
							<!-- One editable override per price list -->
							for _, list := range lists {
								<td class="whitespace-nowrap px-3 py-2.5 text-sm">
									<div class="flex items-center gap-1">
										<span class="text-rr-muted">$</span>
										<input
											type="number"
											name={ "list:" + list.ID.String() + ":" + vp.Variant.ID.String() }
											step="0.01"
											min="0"
											placeholder="base"
											if cents, ok := vp.ListPrices[list.ID]; ok {
												value={ priceToDollars(cents) }
											}
											class="w-24 rounded-sm border-0 py-1 px-2 text-sm text-rr-heading border border-rr-border placeholder:text-rr-muted focus:ring-2 focus:ring-inset focus:ring-rr-red"
										/>
										<input type="hidden" id={ "plprev-" + list.ID.String() + "-" + vp.Variant.ID.String() } name={ "list_prev:" + list.ID.String() + ":" + vp.Variant.ID.String() } value={ priceListDollars(vp.ListPrices, list.ID) }/>
									</div>
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ PriceListPricing(props PriceListPricingProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Price List Pricing",
		ActivePath: "/admin/price-lists",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		<div id="price-list-pricing-content">
			@PriceListPricingContent(props)
		</div>
	}
}

// PriceListPrevOOB updates a single cell's hidden "previous value" input after a
// successful save, via an out-of-band swap. This keeps the on-page diff accurate
// without re-rendering the whole table: the next save compares the user's input
// against the value we just persisted (empty string when the override was cleared).
templ PriceListPrevOOB(listID, variantID uuid.UUID, value string) {
	<input
		type="hidden"
		id={ "plprev-" + listID.String() + "-" + variantID.String() }
		name={ "list_prev:" + listID.String() + ":" + variantID.String() }
		value={ value }
		hx-swap-oob="true"
	/>
}
