package admin

import (
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/audit"
)

// productEventLabel turns a product.* or variant.* audit action into
// staff-facing copy.
//
// Variant events are keyed to the variant, not the product, so they arrive in
// this feed from a separate query — the labels say "Variant" out loud, because
// otherwise a price change on one SKU reads as a change to the whole product.
func productEventLabel(action string) string {
	switch action {
	case audit.AuditProductCreated:
		return "Product created"
	case audit.AuditProductCloned:
		return "Product cloned"
	case audit.AuditProductUpdated:
		return "Product updated"
	case audit.AuditProductArchived:
		return "Product archived"
	case audit.AuditProductDeleted:
		return "Product deleted"
	case audit.AuditProductVisibilityUpdated:
		return "Storefront visibility changed"
	case audit.AuditProductCustomerAccessUpdated:
		return "White-label access changed"
	case audit.AuditProductAttributesUpdated:
		return "Attributes updated"
	case audit.AuditVariantCreated:
		return "Variant added"
	case audit.AuditVariantUpdated:
		return "Variant updated"
	case audit.AuditVariantArchived:
		return "Variant archived"
	case audit.AuditVariantUnarchived:
		return "Variant unarchived"
	case audit.AuditVariantDeleted:
		return "Variant deleted"
	case audit.AuditVariantPriceUpdated:
		return "Variant price changed"
	}
	parts := strings.SplitN(action, ".", 2)
	if len(parts) == 2 {
		verb := strings.ReplaceAll(parts[1], "_", " ")
		return strings.ToUpper(verb[:1]) + verb[1:]
	}
	return action
}

func productEventMarker(action string) string {
	switch action {
	case audit.AuditProductDeleted, audit.AuditVariantDeleted,
		audit.AuditProductArchived, audit.AuditVariantArchived:
		return "bg-rr-red"
	case audit.AuditProductCreated, audit.AuditProductCloned, audit.AuditVariantCreated:
		return "bg-rr-amber"
	default:
		return "bg-rr-surface"
	}
}

// ProductActivity is the catalog record's history — the product's own entries
// merged with its variants'. The question it answers is who changed a price or
// pulled a SKU, which until now was only answerable from the global audit log.
templ ProductActivity(entries []domain.AuditEntry, loc *time.Location) {
	@ActivityTimeline(entries, productEventLabel, productEventMarker, loc)
}
