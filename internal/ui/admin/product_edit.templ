package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/media"
	switchcomp "github.com/dukerupert/hiri/internal/ui/components/switch"
	"github.com/dukerupert/hiri/internal/ui/layouts"
	"github.com/google/uuid"
	"math"
	"time"
)

// gramsToOz converts grams to ounces for display.
func gramsToOz(g int) string {
	oz := float64(g) / 28.3495
	// Show one decimal place, trim trailing zero
	s := fmt.Sprintf("%.1f", math.Round(oz*10)/10)
	return s
}

// whiteLabelCustomerLabel renders a customer for the private-product picker: company
// name when present (wholesale accounts), otherwise the full name, with the email for
// disambiguation.
func whiteLabelCustomerLabel(c domain.Customer) string {
	name := c.FirstName + " " + c.LastName
	if c.CompanyName != nil && *c.CompanyName != "" {
		name = *c.CompanyName
	}
	return fmt.Sprintf("%s (%s)", name, c.Email)
}

type OptionWithValues struct {
	Option domain.ProductOption
	Values []domain.ProductOptionValue
}

type ProductEditProps struct {
	Product            *domain.Product
	Taxons             []domain.Taxon
	Variants           []VariantWithOptions
	Options            []OptionWithValues
	WholesaleCustomers []domain.Customer // candidates for a private (white-label) product
	CustomerAccessIDs  []uuid.UUID       // customers granted access to a private product
	Media              []domain.ProductMedia
	MediaConfig        *media.Config
	TaxonName          string
	Errors             map[string]string
	Flash              string
	StaffName          string
	StaffRole          string
	AssignedSets       []domain.AttributeSet
	AllSets            []domain.AttributeSet
	AttributeValues    []domain.ProductAttributeValue
	ActiveTab          string // "details", "attributes", "media", "variants", "pricing", "activity"
	// Activity is the product's audit history merged with its variants', newest
	// first. Only loaded for the Activity tab.
	Activity   []domain.AuditEntry
	MerchantTZ *time.Location
	// PriceLists and Pricing back the Pricing tab, which shows this product's
	// base price and every price-list override side by side. Prices are catalog
	// data, so they are edited here — on the product — rather than only in the
	// all-products matrix under Price lists.
	PriceLists []domain.PriceList
	Pricing    ProductPriceListPricing
}

func tabClasses(active bool) string {
	if active {
		return "border-b border-rr-red px-1 py-4 text-sm font-medium whitespace-nowrap text-rr-red"
	}
	return "border-b border-transparent px-1 py-4 text-sm font-medium whitespace-nowrap text-rr-muted hover:border-rr-border hover:text-rr-body"
}

templ ProductEditContent(props ProductEditProps) {
	@ConfirmDialogHost()
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">{ props.Product.Title }</h1>
			if domain.IsWhiteLabelSubmission(props.Product.Metadata) {
				<span class="badge badge-indigo mt-1 inline-block">White-label submission — review &amp; publish</span>
			}
		</div>
		<div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none flex gap-2">
			if props.Product.Slug != "" {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/catalog/%s", props.Product.Slug)) }
					target="_blank"
					class="inline-flex items-center gap-1 rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
				>
					View on storefront
					<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path>
					</svg>
				</a>
			}
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/clone", props.Product.ID)) }>
				<button
					type="submit"
					class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
				>
					Clone
				</button>
			</form>
			<a
				href="/admin/catalog"
				class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
			>
				Back to products
			</a>
		</div>
	</div>
	if props.Flash != "" {
		<div class="mt-4 rounded-sm badge-green p-4">
			<div class="flex">
				<div class="flex-shrink-0">
					<svg class="size-5" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
					</svg>
				</div>
				<div class="ml-3">
					<p class="text-sm font-medium">{ props.Flash }</p>
				</div>
			</div>
		</div>
	}
	<!-- Tabs -->
	<div class="mt-6">
		<!-- Mobile dropdown -->
		<div class="grid grid-cols-1 sm:hidden">
			<select
				aria-label="Select a tab"
				x-data
				@change={ fmt.Sprintf("window.location.href = '/admin/catalog/%s?tab=' + $event.target.value", props.Product.ID) }
				class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-2 pr-8 pl-3 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
			>
				<option value="details" selected?={ props.ActiveTab == "" || props.ActiveTab == "details" }>Details</option>
				<option value="attributes" selected?={ props.ActiveTab == "attributes" }>Attributes</option>
				<option value="media" selected?={ props.ActiveTab == "media" }>Media</option>
				<option value="variants" selected?={ props.ActiveTab == "variants" }>Variants</option>
				<option value="pricing" selected?={ props.ActiveTab == "pricing" }>Pricing</option>
				<option value="activity" selected?={ props.ActiveTab == "activity" }>Activity</option>
			</select>
			<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end fill-rr-muted">
				<path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd"></path>
			</svg>
		</div>
		<!-- Desktop tabs -->
		<div class="hidden sm:block">
			<div class="border-b border-rr-border">
				<nav aria-label="Tabs" class="-mb-px flex space-x-8">
					for _, tab := range []struct{ Name, Label string }{
						{"details", "Details"},
						{"attributes", "Attributes"},
						{"media", "Media"},
						{"variants", "Variants"},
						{"pricing", "Pricing"},
						{"activity", "Activity"},
					} {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s?tab=%s", props.Product.ID, tab.Name)) }
							class={ tabClasses(props.ActiveTab == tab.Name || (props.ActiveTab == "" && tab.Name == "details")) }
						>
							{ tab.Label }
						</a>
					}
				</nav>
			</div>
		</div>
	</div>
	<!-- Active tab content -->
	<div class="mt-6">
		switch props.ActiveTab {
			case "attributes":
				@productAttributesTab(props)
			case "media":
				@productMediaTab(props)
			case "variants":
				@productVariantsTab(props)
			case "pricing":
				@productPricingTab(props)
			case "activity":
				@productActivityTab(props)
			default:
				@productDetailsTab(props)
		}
	</div>
}

// --- Activity Tab ---

// productActivityTab is the catalog page's answer to "who changed this, and
// when". It is a tab rather than a section at the foot of Details so the audit
// query only runs when someone asks for it — the other four tabs are hit far
// more often.
templ productActivityTab(props ProductEditProps) {
	@ProductActivity(props.Activity, props.MerchantTZ)
}

// --- Details Tab ---
templ productDetailsTab(props ProductEditProps) {
	<div class="space-y-8">
		@ProductForm(ProductFormProps{
			Product: props.Product,
			Taxons:  props.Taxons,
			IsNew:   false,
			Errors:  props.Errors,
			Action:  fmt.Sprintf("/admin/catalog/%s", props.Product.ID),
		})
		<!-- Settings panel -->
		<div class="border border-rr-border bg-rr-surface">
			<div class="px-4 py-5 sm:px-6">
				<h3 class="text-base/7 font-semibold text-rr-heading">Settings</h3>
			</div>
			<div class="border-t border-rr-border px-4 py-5 sm:px-6 space-y-6">
				@StatusToggle(props.Product)
				@SubscribableToggle(props.Product)
				@FeaturedToggle(props.Product)
				@VisibilityPanel(props)
				<!-- Destructive actions -->
				<div class="flex items-center justify-between border-t border-rr-border pt-6">
					<div>
						<p class="text-sm font-medium text-rr-heading">
							if props.Product.Status == domain.ProductStatusArchived {
								Archived
							} else {
								Archive or delete
							}
						</p>
						<p class="text-sm text-rr-muted">
							if props.Product.Status == domain.ProductStatusArchived {
								This product is archived and hidden from the storefront.
							} else {
								Remove this product from the storefront.
							}
						</p>
					</div>
					<div class="flex items-center gap-2">
						if props.Product.Status == domain.ProductStatusArchived {
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/status", props.Product.ID)) }>
								<input type="hidden" name="status" value="draft"/>
								<button type="submit" class="rounded-sm bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading shadow-xs border border-rr-border hover:bg-rr-raised">
									Unarchive
								</button>
							</form>
						} else {
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/status", props.Product.ID)) }>
								<input type="hidden" name="status" value="archived"/>
								<button type="submit" class="rounded-sm bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading shadow-xs border border-rr-border hover:bg-rr-raised">
									Archive
								</button>
							</form>
						}
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/delete", props.Product.ID)) }>
							@ActionWrap("hint-product-delete", "Removes the product outright. Archive it instead to keep the history and hide it from the shop.") {
								<button
									type="submit"
									class="btn-danger"
									aria-describedby="hint-product-delete"
									{ ConfirmAttrs(ActionConfirm{
										Title: "Delete this product?",
										Lead:  "Removes the product and its variants from the catalog.",
										Points: []string{
											"This cannot be undone.",
											"If you only want it off the storefront, Archive keeps the product and its order history intact.",
										},
										Confirm: "Delete product",
										Danger:  true,
									})... }
								>
									Delete
								</button>
							}
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// --- Media Tab ---
templ productMediaTab(props ProductEditProps) {
	@MediaGallery(MediaGalleryProps{
		ProductID:   props.Product.ID,
		Media:       props.Media,
		MediaConfig: props.MediaConfig,
	})
}

// --- Attributes Tab ---
templ productAttributesTab(props ProductEditProps) {
	@AttributesPanel(AttributesPanelProps{
		Product:      props.Product,
		AssignedSets: props.AssignedSets,
		AllSets:      props.AllSets,
		Values:       props.AttributeValues,
	})
}

// --- Variants Tab ---
templ productVariantsTab(props ProductEditProps) {
	<div class="space-y-8">
		@OptionsPanel(props.Product, props.Options)
		@VariantsPanel(props.Product, props.Variants, props.Options, props.TaxonName, nil)
	</div>
}

// --- Pricing Tab ---
templ productPricingTab(props ProductEditProps) {
	@ProductPricingPanel(props)
}

// ProductPricingPanel renders every price this product carries — the base price
// and one column per price list — as a single editable grid. Pricing lives on
// the product because that is where staff are standing when they decide what a
// coffee costs; the all-products matrix under Price lists remains for comparing
// a whole list at once. Both write through the same form keys, so the two views
// stay interchangeable.
//
// It is also the htmx swap target after variant changes (renderVariantsPanel),
// hence the stable #pricing-panel id on the wrapper rather than on the form.
templ ProductPricingPanel(props ProductEditProps) {
	<div id="pricing-panel" class="space-y-4">
		if len(props.Pricing.Variants) == 0 {
			<div class="border border-dashed border-rr-border p-12 text-center">
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No variants</h3>
				<p class="mt-1 text-sm text-rr-muted">Add variants on the Variants tab first.</p>
			</div>
		} else {
			<form
				id="product-pricing-form"
				method="post"
				action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/pricing", props.Product.ID)) }
				hx-post={ fmt.Sprintf("/admin/catalog/%s/pricing", props.Product.ID) }
				hx-target="#pricing-panel"
				hx-swap="innerHTML"
				class="space-y-4"
			>
				<div class="sm:flex sm:items-start sm:justify-between sm:gap-6">
					<p class="max-w-2xl text-sm text-rr-muted">
						Base is what retail pays. Each list column overrides it for the customers on that list &mdash; leave a cell empty and that list falls back to base.
						if len(props.PriceLists) == 0 {
							<a href="/admin/price-lists" class="text-rr-red hover:text-rr-red-lt">Create a price list</a> to set wholesale prices.
						} else {
							<a href="/admin/price-lists" class="text-rr-red hover:text-rr-red-lt">Manage lists</a>
						}
					</p>
					<div class="mt-4 shrink-0 sm:mt-0">
						<button
							type="submit"
							class="rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt"
						>
							Save changes
						</button>
					</div>
				</div>
				@productPricingCard(props)
			</form>
		}
	</div>
}

templ productPricingCard(props ProductEditProps) {
	<div class="overflow-x-auto border border-rr-border bg-rr-surface">
		<table class="min-w-full divide-y divide-rr-border">
			<thead class="bg-rr-raised">
				<tr>
					<th scope="col" class="sticky left-0 z-10 bg-rr-raised py-2.5 pl-4 pr-3 text-left text-xs font-semibold text-rr-heading sm:pl-6">SKU</th>
					<th scope="col" class="px-3 py-2.5 text-left text-xs font-semibold text-rr-heading">Base</th>
					for _, list := range props.PriceLists {
						<th scope="col" class="whitespace-nowrap px-3 py-2.5 text-left text-xs font-semibold text-rr-teal">
							{ list.Name }
							if list.Status != domain.PriceListStatusActive {
								<span class="ml-1 font-normal text-rr-muted">({ string(list.Status) })</span>
							}
							<a
								href={ templ.SafeURL(fmt.Sprintf("/admin/price-lists/%s/products/%s/tiers", list.ID, props.Product.ID)) }
								class="ml-2 font-normal text-rr-red hover:text-rr-red-lt"
							>Breaks</a>
						</th>
					}
				</tr>
			</thead>
			<tbody class="divide-y divide-rr-border bg-rr-surface">
				for _, vp := range props.Pricing.Variants {
					<tr>
						<td class="sticky left-0 z-10 whitespace-nowrap bg-rr-surface py-2.5 pl-4 pr-3 text-sm sm:pl-6">
							<span class="font-mono font-medium text-rr-heading">{ vp.Variant.SKU }</span>
							if vp.Variant.IsDefault {
								<span class="badge badge-green ml-1.5">Default</span>
							}
						</td>
						<!-- Base price — editable here, same as the Variants tab -->
						<td class="whitespace-nowrap px-3 py-2.5 text-sm">
							<div class="flex items-center gap-1">
								<span class="text-rr-muted">$</span>
								<input
									type="number"
									name={ "base:" + vp.Variant.ID.String() }
									step="0.01"
									min="0"
									placeholder="0.00"
									if vp.PriceCents != nil {
										value={ priceToDollars(*vp.PriceCents) }
									}
									class="w-24 rounded-sm border-0 py-1 px-2 text-sm text-rr-heading border border-rr-border placeholder:text-rr-muted focus:ring-2 focus:ring-inset focus:ring-rr-red"
								/>
								<input type="hidden" id={ "bprev-" + vp.Variant.ID.String() } name={ "base_prev:" + vp.Variant.ID.String() } value={ basePriceDollars(vp.PriceCents) }/>
							</div>
						</td>
						<!-- One editable override per price list -->
						for _, list := range props.PriceLists {
							<td class="whitespace-nowrap px-3 py-2.5 text-sm">
								<div class="flex items-center gap-1">
									<span class="text-rr-muted">$</span>
									<input
										type="number"
										name={ "list:" + list.ID.String() + ":" + vp.Variant.ID.String() }
										step="0.01"
										min="0"
										placeholder="base"
										if cents, ok := vp.ListPrices[list.ID]; ok {
											value={ priceToDollars(cents) }
										}
										class="w-24 rounded-sm border-0 py-1 px-2 text-sm text-rr-heading border border-rr-border placeholder:text-rr-muted focus:ring-2 focus:ring-inset focus:ring-rr-red"
									/>
									<input type="hidden" id={ "plprev-" + list.ID.String() + "-" + vp.Variant.ID.String() } name={ "list_prev:" + list.ID.String() + ":" + vp.Variant.ID.String() } value={ priceListDollars(vp.ListPrices, list.ID) }/>
									@TierSummary(vp.ListBreaks[list.ID])
								</div>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// basePriceDollars renders a base price for the hidden "previous value" input,
// or "" when the variant has no base price yet.
func basePriceDollars(cents *int) string {
	if cents == nil {
		return ""
	}
	return priceToDollars(*cents)
}

// BasePrevOOB updates one base-price cell's hidden "previous value" after a
// successful save, mirroring PriceListPrevOOB — the table is left as the user
// typed it, so change detection has to be corrected in place.
templ BasePrevOOB(variantID uuid.UUID, value string) {
	<input
		type="hidden"
		id={ "bprev-" + variantID.String() }
		name={ "base_prev:" + variantID.String() }
		value={ value }
		hx-swap-oob="true"
	/>
}

// OptionsPanel renders the options section as a standalone partial for htmx swaps.
templ OptionsPanel(product *domain.Product, options []OptionWithValues) {
	<div id="options-panel" class="border border-rr-border bg-rr-surface">
		<div class="px-4 py-5 sm:px-6">
			<h3 class="text-base/7 font-semibold text-rr-heading">Options</h3>
			<p class="mt-1 text-sm text-rr-muted">Define options (e.g. Size, Color) before creating variants.</p>
		</div>
		<div class="border-t border-rr-border">
			if len(options) > 0 {
				<div class="divide-y divide-rr-border">
					for _, opt := range options {
						<div class="px-4 py-5 sm:px-6">
							<div class="flex items-center justify-between mb-3">
								<h4 class="text-sm font-medium text-rr-heading">{ opt.Option.Name }</h4>
								<form
									method="post"
									action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options/%s/delete", product.ID, opt.Option.ID)) }
									hx-post={ fmt.Sprintf("/admin/catalog/%s/options/%s/delete", product.ID, opt.Option.ID) }
									hx-target="#options-panel"
									hx-swap="outerHTML"
									hx-confirm="Delete this option and all its values?"
									{ ConfirmDataAttrs(ActionConfirm{
										Title: "Delete this option and all its values?",
										Lead:  "Removes the option from the product along with every value defined under it.",
										Points: []string{
											"Variants built from this option are affected — check the variant list afterwards.",
											"This cannot be undone.",
										},
										Confirm: "Delete option",
										Danger:  true,
									})... }
									class="inline"
								>
									<button type="submit" class="text-sm text-rr-red hover:text-rr-red-lt">Delete option</button>
								</form>
							</div>
							<div class="flex flex-wrap gap-2 mb-4">
								for _, val := range opt.Values {
									<span class="inline-flex items-center gap-x-1 rounded-sm bg-rr-raised px-2 py-1 text-xs font-medium text-rr-body">
										{ val.Value }
										<form
											method="post"
											action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options/%s/values/%s/delete", product.ID, opt.Option.ID, val.ID)) }
											hx-post={ fmt.Sprintf("/admin/catalog/%s/options/%s/values/%s/delete", product.ID, opt.Option.ID, val.ID) }
											hx-target="#options-panel"
											hx-swap="outerHTML"
											class="inline"
										>
											<button type="submit" class="text-rr-border hover:text-rr-red">&times;</button>
										</form>
									</span>
								}
							</div>
							<!-- Add value form -->
							<form
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options/%s/values", product.ID, opt.Option.ID)) }
								hx-post={ fmt.Sprintf("/admin/catalog/%s/options/%s/values", product.ID, opt.Option.ID) }
								hx-target="#options-panel"
								hx-swap="outerHTML"
								class="flex items-end gap-2"
							>
								<div class="flex-1">
									<input type="text" name="value" placeholder="New value" required class={ inputClasses(false) }/>
								</div>
								<button type="submit" class="rounded-sm bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading shadow-xs border border-rr-border hover:bg-rr-raised">
									Add value
								</button>
							</form>
						</div>
					}
				</div>
			} else {
				<div class="px-4 py-5 sm:px-6">
					<p class="text-sm text-rr-muted mb-4">No options defined.</p>
				</div>
			}
			<!-- Add option form -->
			<div class="border-t border-rr-border px-4 py-5 sm:px-6">
				<h4 class="text-sm font-medium text-rr-heading mb-4">Add option</h4>
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options", product.ID)) }
					hx-post={ fmt.Sprintf("/admin/catalog/%s/options", product.ID) }
					hx-target="#options-panel"
					hx-swap="outerHTML"
					class="flex items-end gap-3"
				>
					<div class="flex-1">
						<label for="option_name" class="block text-sm/6 font-medium text-rr-heading">Name</label>
						<div class="mt-2">
							<input type="text" id="option_name" name="name" placeholder="e.g. Roast Level" required class={ inputClasses(false) }/>
						</div>
					</div>
					<button type="submit" class="rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt">
						Add option
					</button>
				</form>
			</div>
		</div>
	</div>
}

// VariantWithOptionValues pairs a variant with its selected option value names for display.
type VariantWithOptions struct {
	Variant      domain.Variant
	OptionValues []string // e.g. ["Medium", "Dark Roast"]
	PriceCents   *int     // base price in cents, nil = not set
}

// formatPrice formats cents as dollars (e.g. 1299 -> "$12.99").
func formatPrice(cents int) string {
	return fmt.Sprintf("$%d.%02d", cents/100, cents%100)
}

// priceToDollars converts cents to a dollar string for form inputs (e.g. 1299 -> "12.99").
func priceToDollars(cents int) string {
	return fmt.Sprintf("%d.%02d", cents/100, cents%100)
}

// VariantsPanel renders the variants section as a standalone partial for htmx swaps.
templ VariantsPanel(product *domain.Product, variants []VariantWithOptions, options []OptionWithValues, taxonName string, attrs templ.Attributes) {
	<div id="variants-panel" { attrs... } class="border border-rr-border bg-rr-surface">
		<div class="px-4 py-5 sm:px-6">
			<h3 class="text-base/7 font-semibold text-rr-heading">Variants</h3>
		</div>
		<div class="border-t border-rr-border">
			if len(variants) > 0 {
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">SKU</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Options</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Base Price</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">Weight (oz)</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Channels</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">
								Wholesale order rules
								<span class="block text-xs font-normal text-rr-muted">Min / multiple</span>
							</th>
							<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
								<span class="sr-only">Actions</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, vwo := range variants {
							<tr class={ templ.KV("opacity-60", vwo.Variant.ArchivedAt != nil) }>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<div>
										<span class="font-mono font-medium text-rr-heading">{ vwo.Variant.SKU }</span>
										if vwo.Variant.IsDefault {
											<div class="mt-0.5">
												<span class="badge badge-green">Default</span>
											</div>
										}
										if vwo.Variant.ArchivedAt != nil {
											<div class="mt-0.5">
												<span class="badge badge-neutral">Archived</span>
											</div>
										}
									</div>
								</td>
								<td class="px-3 py-4 text-sm text-rr-muted">
									if len(vwo.OptionValues) > 0 {
										<div class="flex flex-wrap gap-1">
											for _, ov := range vwo.OptionValues {
												<span class="inline-flex items-center rounded-sm bg-rr-raised px-2 py-0.5 text-xs font-medium text-rr-body">
													{ ov }
												</span>
											}
										</div>
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">
									if vwo.PriceCents != nil {
										<span class="font-medium text-rr-heading">{ formatPrice(*vwo.PriceCents) }</span>
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted lg:table-cell">
									if vwo.Variant.WeightGrams != nil {
										{ gramsToOz(*vwo.Variant.WeightGrams) }
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">
									@VariantChannelToggles(product.ID, vwo.Variant)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted lg:table-cell">
									@VariantMOQFields(product.ID, vwo.Variant)
								</td>
								<td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6 space-x-3">
									if !vwo.Variant.IsDefault && vwo.Variant.ArchivedAt == nil {
										<form
											method="post"
											action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s", product.ID, vwo.Variant.ID)) }
											hx-post={ fmt.Sprintf("/admin/catalog/%s/variants/%s", product.ID, vwo.Variant.ID) }
											hx-target="#variants-panel"
											hx-swap="outerHTML"
											class="inline"
										>
											<input type="hidden" name="sku" value={ vwo.Variant.SKU }/>
											<input type="hidden" name="is_default" value="true"/>
											if vwo.Variant.RetailAvailable {
												<input type="hidden" name="retail_available" value="true"/>
											}
											if vwo.Variant.WholesaleAvailable {
												<input type="hidden" name="wholesale_available" value="true"/>
											}
											<button type="submit" class="text-rr-muted hover:text-rr-heading">Set default</button>
										</form>
									}
									if vwo.Variant.ArchivedAt == nil {
										<form
											method="post"
											action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s/archive", product.ID, vwo.Variant.ID)) }
											hx-post={ fmt.Sprintf("/admin/catalog/%s/variants/%s/archive", product.ID, vwo.Variant.ID) }
											hx-target="#variants-panel"
											hx-swap="outerHTML"
											hx-confirm="Archive this variant?"
											{ ConfirmDataAttrs(ActionConfirm{
												Title: "Archive this variant?",
												Lead:  "Takes the variant off the storefront without deleting it.",
												Points: []string{
													"It is hidden from the shop and refused at checkout.",
													"Existing subscriptions on this variant keep renewing — move those to another variant first if you want them off it.",
													"You can unarchive it again at any time.",
												},
												Confirm: "Archive variant",
											})... }
											class="inline"
										>
											<button type="submit" class="text-rr-red hover:text-rr-red-lt">Archive</button>
										</form>
									} else {
										<form
											method="post"
											action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s/unarchive", product.ID, vwo.Variant.ID)) }
											hx-post={ fmt.Sprintf("/admin/catalog/%s/variants/%s/unarchive", product.ID, vwo.Variant.ID) }
											hx-target="#variants-panel"
											hx-swap="outerHTML"
											class="inline"
										>
											<button type="submit" class="text-rr-muted hover:text-rr-heading">Unarchive</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			} else {
				<div class="px-4 py-5 sm:px-6">
					<p class="text-sm text-rr-muted">No variants yet. Define options above first, then add variants.</p>
				</div>
			}
			<!-- Add variant form -->
			<div class="border-t border-rr-border px-4 py-5 sm:px-6">
				<h4 class="text-sm font-medium text-rr-heading mb-4">Add variant</h4>
				<form
					id="variant-form"
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants", product.ID)) }
					hx-post={ fmt.Sprintf("/admin/catalog/%s/variants", product.ID) }
					hx-target="#variants-panel"
					hx-swap="outerHTML"
					class="flex items-end gap-3 flex-wrap"
					data-product-title={ product.Title }
				>
					for _, opt := range options {
						<div class="flex-1 min-w-[120px]">
							<label class="block text-sm/6 font-medium text-rr-heading">{ opt.Option.Name }</label>
							<div class="mt-2">
								<select name={ fmt.Sprintf("option_%s", opt.Option.ID) } required class={ inputClasses(false) + " js-option-select" }>
									<option value="">Select { opt.Option.Name }</option>
									for _, val := range opt.Values {
										<option value={ val.ID.String() }>{ val.Value }</option>
									}
								</select>
							</div>
						</div>
					}
					<div class="flex-1 min-w-[120px]">
						<label for="variant_sku" class="block text-sm/6 font-medium text-rr-heading">SKU</label>
						<div class="mt-2">
							<input
								type="text"
								id="variant_sku"
								name="sku"
								placeholder="AUTO-GEN"
								required
								oninput="this.dataset.edited='true'"
								class={ inputClasses(false) }
							/>
						</div>
					</div>
					<div class="flex-1 min-w-[120px]">
						<label for="variant_barcode" class="block text-sm/6 font-medium text-rr-heading">Barcode</label>
						<div class="mt-2">
							<input type="text" id="variant_barcode" name="barcode" placeholder="Optional" class={ inputClasses(false) }/>
						</div>
					</div>
					<div class="w-24">
						<!-- TODO: unit should come from a global weight-unit setting in the admin settings panel -->
						<label for="variant_weight" class="block text-sm/6 font-medium text-rr-heading">Weight (oz)</label>
						<div class="mt-2">
							<input type="number" id="variant_weight" name="weight_oz" step="0.1" placeholder="0" class={ inputClasses(false) }/>
						</div>
					</div>
					<div class="flex items-center gap-2 pb-1.5">
						<input type="checkbox" id="variant_default" name="is_default" value="true" class="size-4 rounded border-rr-border text-rr-red focus:ring-rr-red"/>
						<label for="variant_default" class="text-sm font-medium text-rr-heading">Default</label>
					</div>
					<div class="flex flex-col gap-1 pb-1">
						<label class="inline-flex items-center gap-1.5 text-sm font-medium text-rr-heading">
							<input type="checkbox" name="retail_available" value="true" checked class="size-4 rounded border-rr-border text-rr-red focus:ring-rr-red"/>
							Retail
						</label>
						<label class="inline-flex items-center gap-1.5 text-sm font-medium text-rr-heading">
							<input type="checkbox" name="wholesale_available" value="true" checked class="size-4 rounded border-rr-border text-rr-red focus:ring-rr-red"/>
							Wholesale
						</label>
					</div>
					<button type="submit" class="rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt">
						Add
					</button>
				</form>
				<script>
					(function() {
						function abbrev(s) {
							s = s.trim().toUpperCase();
							if (!s) return '';
							var words = s.split(/\s+/);
							if (words.length > 1) {
								return words.map(function(w) { return w[0]; }).join('').slice(0, 4);
							}
							return s.replace(/[^A-Z0-9]/g, '').slice(0, 3);
						}

						function updateSKU(form) {
							var sku = form.querySelector('#variant_sku');
							if (sku.dataset.edited) return;
							var parts = [];
							parts.push(abbrev(form.dataset.productTitle));
							form.querySelectorAll('.js-option-select').forEach(function(sel) {
								if (sel.selectedIndex > 0) {
									parts.push(abbrev(sel.options[sel.selectedIndex].text));
								}
							});
							sku.value = parts.join('-');
						}

						function init() {
							var form = document.getElementById('variant-form');
							if (!form) return;
							form.querySelectorAll('.js-option-select').forEach(function(sel) {
								sel.addEventListener('change', function() { updateSKU(form); });
							});
						}

						init();
						document.addEventListener('htmx:afterSwap', init);
					})();
				</script>
			</div>
		</div>
	</div>
}

// containsUUID reports whether id is present in ids.
func containsUUID(ids []uuid.UUID, id uuid.UUID) bool {
	for _, x := range ids {
		if x == id {
			return true
		}
	}
	return false
}

// VariantChannelToggles renders the per-channel availability switches (retail/wholesale)
// for a single variant. Both switches live in one form so a change posts both states
// atomically; the form targets itself (hx-target="this"), so toggling swaps only this
// fragment and never re-renders or reflows the rest of the variant table.
templ VariantChannelToggles(productID uuid.UUID, variant domain.Variant) {
	<form
		id={ "variant-channels-" + variant.ID.String() }
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s/channels", productID, variant.ID)) }
		hx-post={ fmt.Sprintf("/admin/catalog/%s/variants/%s/channels", productID, variant.ID) }
		hx-trigger="change"
		hx-target="this"
		hx-swap="outerHTML"
		class="flex flex-col gap-2"
	>
		<div class="flex items-center gap-2">
			@switchcomp.Switch(switchcomp.Props{
				ID:      "retail-" + variant.ID.String(),
				Name:    "retail_available",
				Value:   "true",
				Checked: variant.RetailAvailable,
			})
			<span class="text-xs text-rr-muted">Retail</span>
		</div>
		<div class="flex items-center gap-2">
			@switchcomp.Switch(switchcomp.Props{
				ID:      "wholesale-" + variant.ID.String(),
				Name:    "wholesale_available",
				Value:   "true",
				Checked: variant.WholesaleAvailable,
			})
			<span class="text-xs text-rr-muted">Wholesale</span>
		</div>
	</form>
}

// moqFieldValue renders an *int as a form value, blank for nil. Kept as a Go
// expression so the input's value attribute has no stray whitespace.
func moqFieldValue(v *int) string {
	if v == nil {
		return ""
	}
	return fmt.Sprintf("%d", *v)
}

// moqSummary is the plain-English version of a variant's order rules, shown
// under the inputs so staff can see the effect without doing the arithmetic.
func moqSummary(v domain.Variant) string {
	switch {
	case v.WholesaleMinQty == nil && v.WholesaleMultiple == nil:
		return "Any quantity"
	case v.WholesaleMultiple == nil:
		return fmt.Sprintf("At least %d", *v.WholesaleMinQty)
	case v.WholesaleMinQty == nil:
		return fmt.Sprintf("In multiples of %d", *v.WholesaleMultiple)
	default:
		return fmt.Sprintf("At least %d, in multiples of %d", *v.WholesaleMinQty, *v.WholesaleMultiple)
	}
}

// VariantMOQFields edits the wholesale minimum order quantity and order
// multiple enforced by domain.ValidateWholesaleCart at wholesale checkout.
//
// Submits on change like the channel toggles, and swaps itself so the summary
// line updates without reflowing the variant table. Blank clears a constraint.
templ VariantMOQFields(productID uuid.UUID, variant domain.Variant) {
	<form
		id={ "variant-moq-" + variant.ID.String() }
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s/wholesale-moq", productID, variant.ID)) }
		hx-post={ fmt.Sprintf("/admin/catalog/%s/variants/%s/wholesale-moq", productID, variant.ID) }
		hx-trigger="change"
		hx-target="this"
		hx-swap="outerHTML"
		class="flex flex-col gap-1"
	>
		<div class="flex items-center gap-1.5">
			<label for={ "moq-min-" + variant.ID.String() } class="sr-only">Minimum order quantity</label>
			<input
				id={ "moq-min-" + variant.ID.String() }
				name="wholesale_min_qty"
				type="number"
				min="1"
				inputmode="numeric"
				value={ moqFieldValue(variant.WholesaleMinQty) }
				placeholder="—"
				class="w-16 border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
			/>
			<span class="text-xs text-rr-muted">/</span>
			<label for={ "moq-mult-" + variant.ID.String() } class="sr-only">Order multiple</label>
			<input
				id={ "moq-mult-" + variant.ID.String() }
				name="wholesale_multiple"
				type="number"
				min="1"
				inputmode="numeric"
				value={ moqFieldValue(variant.WholesaleMultiple) }
				placeholder="—"
				class="w-16 border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading focus:border-rr-red focus:outline-none"
			/>
		</div>
		<span class="text-xs text-rr-muted">{ moqSummary(variant) }</span>
	</form>
}

// VisibilityPanel controls a product's storefront visibility tier and, when private,
// which customers may access it. Tier and grants submit together in one POST.
templ VisibilityPanel(props ProductEditProps) {
	<div x-data={ "{ vis: '" + string(props.Product.Visibility) + "' }" } class="border-t border-rr-border pt-6">
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/visibility", props.Product.ID)) } class="space-y-4">
			<div>
				<p class="text-sm font-medium text-rr-heading">Storefront visibility</p>
				<p class="text-sm text-rr-muted">Who can see and buy this product.</p>
				<select
					name="visibility"
					x-model="vis"
					class="mt-2 block w-full max-w-sm rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm text-rr-heading focus:ring-2 focus:ring-inset focus:ring-rr-red"
				>
					<option value="public" selected?={ props.Product.Visibility == domain.ProductVisibilityPublic }>Public — everyone</option>
					<option value="wholesale" selected?={ props.Product.Visibility == domain.ProductVisibilityWholesale }>Wholesale — all approved wholesale customers</option>
					<option value="private" selected?={ props.Product.Visibility == domain.ProductVisibilityPrivate }>Private — only selected customers (white-label)</option>
				</select>
			</div>
			<div x-show="vis === 'private'" x-cloak class="space-y-2">
				<p class="text-sm font-medium text-rr-heading">Customers with access</p>
				if len(props.WholesaleCustomers) == 0 {
					<p class="text-sm text-rr-muted">No approved wholesale customers yet.</p>
				} else {
					<div class="max-h-64 overflow-y-auto space-y-1 border border-rr-border rounded-sm p-2 max-w-sm">
						for _, c := range props.WholesaleCustomers {
							<label class="flex items-center gap-2 text-sm text-rr-body">
								<input
									type="checkbox"
									name="customer_ids"
									value={ c.ID.String() }
									checked?={ containsUUID(props.CustomerAccessIDs, c.ID) }
									class="rounded-sm border-rr-border text-rr-red focus:ring-rr-red"
								/>
								{ whiteLabelCustomerLabel(c) }
							</label>
						}
					</div>
				}
			</div>
			<button type="submit" class="rounded-sm bg-rr-red px-3 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt">
				Save visibility
			</button>
		</form>
	</div>
}

// StatusToggle renders the active/inactive toggle as a standalone partial for htmx swaps.
templ StatusToggle(product *domain.Product) {
	<div id="status-panel">
		<div class="flex items-center justify-between">
			<div>
				<p class="text-sm font-medium text-rr-heading">Active</p>
				<p class="text-sm text-rr-muted">Product is visible on the storefront.</p>
			</div>
			if product.Status == domain.ProductStatusArchived {
				@switchcomp.Switch(switchcomp.Props{
					ID:       fmt.Sprintf("status-%s", product.ID),
					Name:     "status",
					Value:    "active",
					Checked:  false,
					Disabled: true,
				})
			} else {
				@switchcomp.Switch(switchcomp.Props{
					ID:      fmt.Sprintf("status-%s", product.ID),
					Name:    "status",
					Value:   "active",
					Checked: product.Status == domain.ProductStatusActive,
					Attributes: templ.Attributes{
						"hx-post":    fmt.Sprintf("/admin/catalog/%s/status", product.ID),
						"hx-target":  "#status-panel",
						"hx-swap":    "outerHTML",
						"hx-trigger": "change",
					},
				})
			}
		</div>
	</div>
}

// SubscribableToggle renders the subscription toggle row for embedding inside another panel.
templ SubscribableToggle(product *domain.Product) {
	<div id="subscribable-panel">
		<div class="flex items-center justify-between">
			<div>
				<p class="text-sm font-medium text-rr-heading">Allow subscriptions</p>
				<p class="text-sm text-rr-muted">Customers can subscribe for recurring delivery.</p>
			</div>
			@switchcomp.Switch(switchcomp.Props{
				ID:      fmt.Sprintf("subscribable-%s", product.ID),
				Name:    "subscribable",
				Value:   "true",
				Checked: product.Subscribable,
				Attributes: templ.Attributes{
					"hx-post":    fmt.Sprintf("/admin/catalog/%s/subscribable", product.ID),
					"hx-target":  "#subscribable-panel",
					"hx-swap":    "outerHTML",
					"hx-trigger": "change",
				},
			})
		</div>
	</div>
}

// SubscribablePanel renders the subscription toggle as a standalone partial for htmx swaps.
templ SubscribablePanel(product *domain.Product) {
	@SubscribableToggle(product)
}

// FeaturedToggle renders the home-page-feature toggle row.
templ FeaturedToggle(product *domain.Product) {
	<div id="featured-panel">
		<div class="flex items-center justify-between">
			<div>
				<p class="text-sm font-medium text-rr-heading">Feature on home page</p>
				<p class="text-sm text-rr-muted">Show this product as the hero on the storefront landing page. Only one product is featured at a time — turning this on will replace the current pick.</p>
			</div>
			@switchcomp.Switch(switchcomp.Props{
				ID:      fmt.Sprintf("featured-%s", product.ID),
				Name:    "featured",
				Value:   "true",
				Checked: product.IsFeatured,
				Attributes: templ.Attributes{
					"hx-post":    fmt.Sprintf("/admin/catalog/%s/featured", product.ID),
					"hx-target":  "#featured-panel",
					"hx-swap":    "outerHTML",
					"hx-trigger": "change",
				},
			})
		</div>
	</div>
}

// FeaturedPanel renders the featured toggle as a standalone partial for htmx swaps.
templ FeaturedPanel(product *domain.Product) {
	@FeaturedToggle(product)
}

templ ProductEdit(props ProductEditProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      props.Product.Title + " - Edit",
		ActivePath: "/admin/catalog",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@ProductEditContent(props)
	}
}
