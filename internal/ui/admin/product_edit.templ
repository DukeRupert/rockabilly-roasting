package admin

import (
	"fmt"
	"strconv"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/components/button"
	"github.com/dukerupert/hiri/internal/ui/components/card"
	"github.com/dukerupert/hiri/internal/ui/components/input"
	"github.com/dukerupert/hiri/internal/ui/components/label"
	"github.com/dukerupert/hiri/internal/ui/components/badge"
	"github.com/dukerupert/hiri/internal/ui/components/table"
	"github.com/dukerupert/hiri/internal/ui/layouts"
	"github.com/dukerupert/hiri/internal/ui/components"
)

type OptionWithValues struct {
	Option domain.ProductOption
	Values []domain.ProductOptionValue
}

type ProductEditProps struct {
	Product  *domain.Product
	Taxons   []domain.Taxon
	Variants []domain.Variant
	Options  []OptionWithValues
	Errors   map[string]string
	Flash    string
}

templ ProductEdit(props ProductEditProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      props.Product.Title + " - Edit",
		ActivePath: "/admin/catalog",
		StaffName:  "Dev User",
		StaffRole:  "admin",
	}) {
		@components.PageHeader(components.PageHeaderProps{
			Title: props.Product.Title,
		}) {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Href:    "/admin/catalog",
			}) {
				Back to products
			}
		}
		if props.Flash != "" {
			<div class="mt-4 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
				{ props.Flash }
			</div>
		}
		<div class="mt-6 space-y-6">
			<!-- General info form -->
			@ProductForm(ProductFormProps{
				Product: props.Product,
				Taxons:  props.Taxons,
				IsNew:   false,
				Errors:  props.Errors,
				Action:  fmt.Sprintf("/admin/catalog/%s", props.Product.ID),
			})
			<!-- Status card -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Status
					}
				}
				@card.Content() {
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-3">
							<span class="text-sm text-muted-foreground">Current status:</span>
							@StatusBadge(props.Product.Status)
						</div>
						<div class="flex items-center gap-2">
							if props.Product.Status == domain.ProductStatusDraft {
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/status", props.Product.ID)) }>
									<input type="hidden" name="status" value="active"/>
									@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
										Activate
									}
								</form>
							}
							if props.Product.Status == domain.ProductStatusActive {
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/status", props.Product.ID)) }>
									<input type="hidden" name="status" value="archived"/>
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary, Size: button.SizeSm}) {
										Archive
									}
								</form>
							}
							if props.Product.Status == domain.ProductStatusArchived {
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/status", props.Product.ID)) }>
									<input type="hidden" name="status" value="draft"/>
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
										Move to draft
									}
								</form>
							}
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/delete", props.Product.ID)) } onsubmit="return confirm('Are you sure you want to delete this product?')">
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Size: button.SizeSm}) {
									Delete
								}
							</form>
						</div>
					</div>
				}
			}
			<!-- Variants card -->
			@card.Card() {
				@card.Header(card.HeaderProps{Class: "flex-row items-center justify-between"}) {
					@card.Title() {
						Variants
					}
				}
				@card.Content() {
					if len(props.Variants) > 0 {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() { SKU }
									@table.Head() { Barcode }
									@table.Head() { Default }
									@table.Head() { Weight (g) }
									@table.Head(table.HeadProps{Class: "text-right"}) { Actions }
								}
							}
							@table.Body() {
								for _, v := range props.Variants {
									@table.Row() {
										@table.Cell() {
											<span class="font-mono text-sm">{ v.SKU }</span>
										}
										@table.Cell() {
											if v.Barcode != nil {
												<span class="font-mono text-sm">{ *v.Barcode }</span>
											} else {
												<span class="text-muted-foreground">—</span>
											}
										}
										@table.Cell() {
											if v.IsDefault {
												@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "bg-emerald-100 text-emerald-800 border-emerald-200"}) {
													Default
												}
											}
										}
										@table.Cell() {
											if v.WeightGrams != nil {
												{ strconv.Itoa(*v.WeightGrams) }
											} else {
												<span class="text-muted-foreground">—</span>
											}
										}
										@table.Cell(table.CellProps{Class: "text-right"}) {
											<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s/delete", props.Product.ID, v.ID)) } class="inline" onsubmit="return confirm('Delete this variant?')">
												@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
													Delete
												}
											</form>
										}
									}
								}
							}
						}
					} else {
						<p class="text-sm text-muted-foreground">No variants yet.</p>
					}
					<!-- Add variant form -->
					<div class="mt-4 rounded-md border p-4">
						<h4 class="text-sm font-medium mb-3">Add variant</h4>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants", props.Product.ID)) } class="flex items-end gap-3">
							<div class="space-y-1 flex-1">
								@label.Label(label.Props{For: "variant_sku"}) { SKU }
								@input.Input(input.Props{ID: "variant_sku", Name: "sku", Placeholder: "SKU-001", Required: true})
							</div>
							<div class="space-y-1 flex-1">
								@label.Label(label.Props{For: "variant_barcode"}) { Barcode }
								@input.Input(input.Props{ID: "variant_barcode", Name: "barcode", Placeholder: "Optional"})
							</div>
							<div class="space-y-1 w-24">
								@label.Label(label.Props{For: "variant_weight"}) { Weight }
								@input.Input(input.Props{ID: "variant_weight", Name: "weight_grams", Type: input.TypeNumber, Placeholder: "0"})
							</div>
							<div class="flex items-center gap-2 h-9">
								<input type="checkbox" id="variant_default" name="is_default" value="true" class="rounded"/>
								@label.Label(label.Props{For: "variant_default"}) { Default }
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								Add
							}
						</form>
					</div>
				}
			}
			<!-- Options card -->
			@card.Card() {
				@card.Header(card.HeaderProps{Class: "flex-row items-center justify-between"}) {
					@card.Title() {
						Options
					}
				}
				@card.Content() {
					if len(props.Options) > 0 {
						<div class="space-y-4">
							for _, opt := range props.Options {
								<div class="rounded-md border p-4">
									<div class="flex items-center justify-between mb-2">
										<h4 class="text-sm font-medium">{ opt.Option.Name }</h4>
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options/%s/delete", props.Product.ID, opt.Option.ID)) } class="inline" onsubmit="return confirm('Delete this option and all its values?')">
											@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
												Delete option
											}
										</form>
									</div>
									<div class="flex flex-wrap gap-2 mb-3">
										for _, val := range opt.Values {
											<div class="flex items-center gap-1">
												@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
													{ val.Value }
												}
												<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options/%s/values/%s/delete", props.Product.ID, opt.Option.ID, val.ID)) } class="inline">
													<button type="submit" class="text-muted-foreground hover:text-destructive text-xs ml-1">&times;</button>
												</form>
											</div>
										}
									</div>
									<!-- Add value form -->
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options/%s/values", props.Product.ID, opt.Option.ID)) } class="flex items-end gap-2">
										<div class="space-y-1 flex-1">
											@input.Input(input.Props{Name: "value", Placeholder: "New value", Required: true})
										</div>
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
											Add value
										}
									</form>
								</div>
							}
						</div>
					} else {
						<p class="text-sm text-muted-foreground mb-4">No options defined.</p>
					}
					<!-- Add option form -->
					<div class="mt-4 rounded-md border p-4">
						<h4 class="text-sm font-medium mb-3">Add option</h4>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options", props.Product.ID)) } class="flex items-end gap-3">
							<div class="space-y-1 flex-1">
								@label.Label(label.Props{For: "option_name"}) { Name }
								@input.Input(input.Props{ID: "option_name", Name: "name", Placeholder: "e.g. Roast Level", Required: true})
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								Add option
							}
						</form>
					</div>
				}
			}
		</div>
	}
}
