package admin

import (
	"fmt"
	"math"
	"github.com/google/uuid"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/media"
	"github.com/dukerupert/hiri/internal/ui/layouts"
	switchcomp "github.com/dukerupert/hiri/internal/ui/components/switch"
)

// gramsToOz converts grams to ounces for display.
func gramsToOz(g int) string {
	oz := float64(g) / 28.3495
	// Show one decimal place, trim trailing zero
	s := fmt.Sprintf("%.1f", math.Round(oz*10)/10)
	return s
}

type OptionWithValues struct {
	Option domain.ProductOption
	Values []domain.ProductOptionValue
}

type ProductEditProps struct {
	Product     *domain.Product
	Taxons      []domain.Taxon
	Variants    []VariantWithOptions
	Options     []OptionWithValues
	Groups      []domain.CustomerGroup
	Media       []domain.ProductMedia
	MediaConfig *media.Config
	TaxonName   string
	Errors      map[string]string
	Flash       string
	StaffName   string
	StaffRole   string
}

templ ProductEditContent(props ProductEditProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="text-base/7 font-semibold text-stone-900">{ props.Product.Title }</h1>
		</div>
		<div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
			<a
				href="/admin/catalog"
				class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
			>
				Back to products
			</a>
		</div>
	</div>
	if props.Flash != "" {
		<div class="mt-4 rounded-md bg-green-50 p-4">
			<div class="flex">
				<div class="flex-shrink-0">
					<svg class="size-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
					</svg>
				</div>
				<div class="ml-3">
					<p class="text-sm font-medium text-green-800">{ props.Flash }</p>
				</div>
			</div>
		</div>
	}
	<!-- Tabs -->
	<div class="mt-6" id="product-tabs">
		<!-- Mobile dropdown -->
		<div class="grid grid-cols-1 sm:hidden">
			<select aria-label="Select a tab" data-tab-select class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-2 pr-8 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-hiri-teal">
				<option value="details" selected>Details</option>
				<option value="media">Media</option>
				<option value="variants">Variants</option>
				<option value="pricing">Pricing</option>
			</select>
			<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end fill-gray-500">
				<path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd"></path>
			</svg>
		</div>
		<!-- Desktop tabs -->
		<div class="hidden sm:block">
			<div class="border-b border-stone-200">
				<nav aria-label="Tabs" class="-mb-px flex space-x-8">
					<button type="button" data-tab="details" class="border-b-2 border-hiri-teal px-1 py-4 text-sm font-medium whitespace-nowrap text-hiri-teal">Details</button>
					<button type="button" data-tab="media" class="border-b-2 border-transparent px-1 py-4 text-sm font-medium whitespace-nowrap text-stone-500 hover:border-stone-300 hover:text-stone-700">Media</button>
					<button type="button" data-tab="variants" class="border-b-2 border-transparent px-1 py-4 text-sm font-medium whitespace-nowrap text-stone-500 hover:border-stone-300 hover:text-stone-700">Variants</button>
					<button type="button" data-tab="pricing" class="border-b-2 border-transparent px-1 py-4 text-sm font-medium whitespace-nowrap text-stone-500 hover:border-stone-300 hover:text-stone-700">Pricing</button>
				</nav>
			</div>
		</div>
	</div>
	<!-- Tab panels -->
	<div class="mt-6">
		<div data-tab-panel="details">
			@productDetailsTab(props)
		</div>
		<div data-tab-panel="media" class="hidden">
			@productMediaTab(props)
		</div>
		<div data-tab-panel="variants" class="hidden">
			@productVariantsTab(props)
		</div>
		<div data-tab-panel="pricing" class="hidden">
			@productPricingTab(props)
		</div>
	</div>
	<script>
		(function() {
			var activeClass = 'border-hiri-teal text-hiri-teal';
			var inactiveClass = 'border-transparent text-stone-500 hover:border-stone-300 hover:text-stone-700';

			function switchTab(name) {
				document.querySelectorAll('[data-tab-panel]').forEach(function(p) {
					p.classList.toggle('hidden', p.dataset.tabPanel !== name);
				});
				document.querySelectorAll('[data-tab]').forEach(function(b) {
					var active = b.dataset.tab === name;
					b.className = 'border-b-2 px-1 py-4 text-sm font-medium whitespace-nowrap ' + (active ? activeClass : inactiveClass);
				});
				var sel = document.querySelector('[data-tab-select]');
				if (sel) sel.value = name;
			}

			document.querySelectorAll('[data-tab]').forEach(function(b) {
				b.addEventListener('click', function() { switchTab(this.dataset.tab); });
			});
			var sel = document.querySelector('[data-tab-select]');
			if (sel) sel.addEventListener('change', function() { switchTab(this.value); });
		})();
	</script>
	@ImageUploaderScript()
}

// --- Details Tab ---

templ productDetailsTab(props ProductEditProps) {
	<div class="space-y-8">
		@ProductForm(ProductFormProps{
			Product: props.Product,
			Taxons:  props.Taxons,
			IsNew:   false,
			Errors:  props.Errors,
			Action:  fmt.Sprintf("/admin/catalog/%s", props.Product.ID),
		})
		<!-- Settings panel -->
		<div class="rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
			<div class="px-4 py-5 sm:px-6">
				<h3 class="text-base/7 font-semibold text-stone-900">Settings</h3>
			</div>
			<div class="border-t border-stone-200 px-4 py-5 sm:px-6 space-y-6">
				@StatusToggle(props.Product)
				@SubscribableToggle(props.Product)
				<!-- Destructive actions -->
				<div class="flex items-center justify-between border-t border-stone-200 pt-6">
					<div>
						<p class="text-sm font-medium text-stone-900">
							if props.Product.Status == domain.ProductStatusArchived {
								Archived
							} else {
								Archive or delete
							}
						</p>
						<p class="text-sm text-stone-500">
							if props.Product.Status == domain.ProductStatusArchived {
								This product is archived and hidden from the storefront.
							} else {
								Remove this product from the storefront.
							}
						</p>
					</div>
					<div class="flex items-center gap-2">
						if props.Product.Status == domain.ProductStatusArchived {
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/status", props.Product.ID)) }>
								<input type="hidden" name="status" value="draft"/>
								<button type="submit" class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-stone-900 shadow-xs ring-1 ring-inset ring-stone-300 hover:bg-stone-50">
									Unarchive
								</button>
							</form>
						} else {
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/status", props.Product.ID)) }>
								<input type="hidden" name="status" value="archived"/>
								<button type="submit" class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-stone-900 shadow-xs ring-1 ring-inset ring-stone-300 hover:bg-stone-50">
									Archive
								</button>
							</form>
						}
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/delete", props.Product.ID)) } onsubmit="return confirm('Are you sure you want to delete this product?')">
							<button type="submit" class="rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-red-500">
								Delete
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// --- Media Tab ---

templ productMediaTab(props ProductEditProps) {
	@MediaGallery(MediaGalleryProps{
		ProductID:   props.Product.ID,
		Media:       props.Media,
		MediaConfig: props.MediaConfig,
	})
}

// --- Variants Tab ---

templ productVariantsTab(props ProductEditProps) {
	<div class="space-y-8">
		@OptionsPanel(props.Product, props.Options)
		@VariantsPanel(props.Product, props.Variants, props.Options, props.TaxonName, props.Groups, nil)
	</div>
}

// --- Pricing Tab ---

templ productPricingTab(props ProductEditProps) {
	<div class="space-y-4">
		<p class="text-sm text-stone-500">
			Set base and group-specific prices for this product's variants.
			if len(props.Groups) == 0 {
				<a href="/admin/groups" class="text-hiri-teal hover:text-hiri-teal-dark">Create customer groups</a> to enable group pricing.
			}
		</p>
		if len(props.Variants) == 0 {
			<div class="rounded-lg border-2 border-dashed border-stone-300 p-12 text-center">
				<h3 class="mt-2 text-sm font-semibold text-stone-900">No variants</h3>
				<p class="mt-1 text-sm text-stone-500">Add variants on the Variants tab first.</p>
			</div>
		} else {
			<!-- Base Prices -->
			@productPricingCard("Base Prices", nil, props)
			<!-- Group Prices -->
			for _, g := range props.Groups {
				@productPricingCard(g.Name+" Prices", &g, props)
			}
		}
	</div>
}

templ productPricingCard(title string, group *domain.CustomerGroup, props ProductEditProps) {
	<div class="overflow-hidden rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
		<div class="border-b border-stone-200 bg-stone-50 px-4 py-2.5 sm:px-6">
			if group != nil {
				<h3 class="text-sm font-medium text-indigo-600">{ title }</h3>
			} else {
				<h3 class="text-sm font-medium text-stone-700">{ title }</h3>
			}
		</div>
		<table class="min-w-full divide-y divide-stone-300">
			<thead class="bg-stone-50">
				<tr>
					<th scope="col" class="py-2.5 pl-4 pr-3 text-left text-xs font-semibold text-stone-900 sm:pl-6">SKU</th>
					<th scope="col" class="px-3 py-2.5 text-left text-xs font-semibold text-stone-900">Unit Price</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-stone-200 bg-white">
				for _, vwo := range props.Variants {
					<tr>
						<td class="whitespace-nowrap py-2.5 pl-4 pr-3 text-sm sm:pl-6">
							<span class="font-mono font-medium text-stone-900">{ vwo.Variant.SKU }</span>
							if vwo.Variant.IsDefault {
								<span class="ml-1.5 inline-flex items-center rounded-md bg-green-50 px-1.5 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
									Default
								</span>
							}
						</td>
						<td class="whitespace-nowrap px-3 py-2.5 text-sm">
							if group == nil {
								<form
									method="post"
									action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s/price", props.Product.ID, vwo.Variant.ID)) }
									hx-post={ fmt.Sprintf("/admin/catalog/%s/variants/%s/price", props.Product.ID, vwo.Variant.ID) }
									hx-target="#variants-panel"
									hx-swap="outerHTML"
									class="flex items-center gap-1"
								>
									<span class="text-stone-400">$</span>
									<input
										type="number"
										name="price"
										step="0.01"
										min="0"
										placeholder="0.00"
										if vwo.PriceCents != nil {
											value={ priceToDollars(*vwo.PriceCents) }
										}
										class="w-24 rounded-md border-0 py-1 px-2 text-sm text-stone-900 ring-1 ring-inset ring-stone-300 placeholder:text-stone-400 focus:ring-2 focus:ring-inset focus:ring-hiri-teal"
									/>
									<button type="submit" class="rounded px-1.5 py-1 text-xs font-medium text-hiri-teal hover:text-hiri-teal-dark">
										Save
									</button>
								</form>
							} else {
								<form
									method="post"
									action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s/group-price", props.Product.ID, vwo.Variant.ID)) }
									hx-post={ fmt.Sprintf("/admin/catalog/%s/variants/%s/group-price", props.Product.ID, vwo.Variant.ID) }
									hx-target="#variants-panel"
									hx-swap="outerHTML"
									class="flex items-center gap-1"
								>
									<input type="hidden" name="group_id" value={ group.ID.String() }/>
									<span class="text-stone-400">$</span>
									<input
										type="number"
										name="price"
										step="0.01"
										min="0"
										placeholder="0.00"
										if cents, ok := vwo.GroupPrices[group.ID]; ok {
											value={ priceToDollars(cents) }
										}
										class="w-24 rounded-md border-0 py-1 px-2 text-sm text-stone-900 ring-1 ring-inset ring-stone-300 placeholder:text-stone-400 focus:ring-2 focus:ring-inset focus:ring-hiri-teal"
									/>
									<button type="submit" class="rounded px-1.5 py-1 text-xs font-medium text-hiri-teal hover:text-hiri-teal-dark">
										Save
									</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// OptionsPanel renders the options section as a standalone partial for htmx swaps.
templ OptionsPanel(product *domain.Product, options []OptionWithValues) {
	<div id="options-panel" class="rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
		<div class="px-4 py-5 sm:px-6">
			<h3 class="text-base/7 font-semibold text-stone-900">Options</h3>
			<p class="mt-1 text-sm text-stone-500">Define options (e.g. Size, Color) before creating variants.</p>
		</div>
		<div class="border-t border-stone-200">
			if len(options) > 0 {
				<div class="divide-y divide-stone-200">
					for _, opt := range options {
						<div class="px-4 py-5 sm:px-6">
							<div class="flex items-center justify-between mb-3">
								<h4 class="text-sm font-medium text-stone-900">{ opt.Option.Name }</h4>
								<form
									method="post"
									action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options/%s/delete", product.ID, opt.Option.ID)) }
									hx-post={ fmt.Sprintf("/admin/catalog/%s/options/%s/delete", product.ID, opt.Option.ID) }
									hx-target="#options-panel"
									hx-swap="outerHTML"
									hx-confirm="Delete this option and all its values?"
									class="inline"
								>
									<button type="submit" class="text-sm text-red-600 hover:text-red-900">Delete option</button>
								</form>
							</div>
							<div class="flex flex-wrap gap-2 mb-4">
								for _, val := range opt.Values {
									<span class="inline-flex items-center gap-x-1 rounded-md bg-stone-100 px-2 py-1 text-xs font-medium text-stone-600">
										{ val.Value }
										<form
											method="post"
											action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options/%s/values/%s/delete", product.ID, opt.Option.ID, val.ID)) }
											hx-post={ fmt.Sprintf("/admin/catalog/%s/options/%s/values/%s/delete", product.ID, opt.Option.ID, val.ID) }
											hx-target="#options-panel"
											hx-swap="outerHTML"
											class="inline"
										>
											<button type="submit" class="text-stone-400 hover:text-red-500">&times;</button>
										</form>
									</span>
								}
							</div>
							<!-- Add value form -->
							<form
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options/%s/values", product.ID, opt.Option.ID)) }
								hx-post={ fmt.Sprintf("/admin/catalog/%s/options/%s/values", product.ID, opt.Option.ID) }
								hx-target="#options-panel"
								hx-swap="outerHTML"
								class="flex items-end gap-2"
							>
								<div class="flex-1">
									<input type="text" name="value" placeholder="New value" required class={ inputClasses(false) }/>
								</div>
								<button type="submit" class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-stone-900 shadow-xs ring-1 ring-inset ring-stone-300 hover:bg-stone-50">
									Add value
								</button>
							</form>
						</div>
					}
				</div>
			} else {
				<div class="px-4 py-5 sm:px-6">
					<p class="text-sm text-stone-500 mb-4">No options defined.</p>
				</div>
			}
			<!-- Add option form -->
			<div class="border-t border-stone-200 px-4 py-5 sm:px-6">
				<h4 class="text-sm font-medium text-stone-900 mb-4">Add option</h4>
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/options", product.ID)) }
					hx-post={ fmt.Sprintf("/admin/catalog/%s/options", product.ID) }
					hx-target="#options-panel"
					hx-swap="outerHTML"
					class="flex items-end gap-3"
				>
					<div class="flex-1">
						<label for="option_name" class="block text-sm/6 font-medium text-stone-900">Name</label>
						<div class="mt-2">
							<input type="text" id="option_name" name="name" placeholder="e.g. Roast Level" required class={ inputClasses(false) }/>
						</div>
					</div>
					<button type="submit" class="rounded-md bg-hiri-teal px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-hiri-teal-dark">
						Add option
					</button>
				</form>
			</div>
		</div>
	</div>
}

// VariantWithOptionValues pairs a variant with its selected option value names for display.
type VariantWithOptions struct {
	Variant      domain.Variant
	OptionValues []string          // e.g. ["Medium", "Dark Roast"]
	PriceCents   *int              // base price in cents, nil = not set
	GroupPrices  map[uuid.UUID]int // customerGroupID -> cents
}

// formatPrice formats cents as dollars (e.g. 1299 -> "$12.99").
func formatPrice(cents int) string {
	return fmt.Sprintf("$%d.%02d", cents/100, cents%100)
}

// priceToDollars converts cents to a dollar string for form inputs (e.g. 1299 -> "12.99").
func priceToDollars(cents int) string {
	return fmt.Sprintf("%d.%02d", cents/100, cents%100)
}

// VariantsPanel renders the variants section as a standalone partial for htmx swaps.
templ VariantsPanel(product *domain.Product, variants []VariantWithOptions, options []OptionWithValues, taxonName string, groups []domain.CustomerGroup, attrs templ.Attributes) {
	<div id="variants-panel" { attrs... } class="rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
		<div class="px-4 py-5 sm:px-6">
			<h3 class="text-base/7 font-semibold text-stone-900">Variants</h3>
		</div>
		<div class="border-t border-stone-200">
			if len(variants) > 0 {
				<table class="min-w-full divide-y divide-stone-300">
					<thead class="bg-stone-50">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-stone-900 sm:pl-6">SKU</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Options</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Base Price</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-stone-900 lg:table-cell">Weight (oz)</th>
							<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
								<span class="sr-only">Actions</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-200 bg-white">
						for _, vwo := range variants {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<div>
										<span class="font-mono font-medium text-stone-900">{ vwo.Variant.SKU }</span>
										if vwo.Variant.IsDefault {
											<div class="mt-0.5">
												<span class="inline-flex items-center rounded-md bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
													Default
												</span>
											</div>
										}
									</div>
								</td>
								<td class="px-3 py-4 text-sm text-stone-500">
									if len(vwo.OptionValues) > 0 {
										<div class="flex flex-wrap gap-1">
											for _, ov := range vwo.OptionValues {
												<span class="inline-flex items-center rounded-md bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-600">
													{ ov }
												</span>
											}
										</div>
									} else {
										<span class="text-stone-400">—</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-stone-500">
									if vwo.PriceCents != nil {
										<span class="font-medium text-stone-900">{ formatPrice(*vwo.PriceCents) }</span>
									} else {
										<span class="text-stone-400">—</span>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-stone-500 lg:table-cell">
									if vwo.Variant.WeightGrams != nil {
										{ gramsToOz(*vwo.Variant.WeightGrams) }
									} else {
										<span class="text-stone-400">—</span>
									}
								</td>
								<td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
									<form
										method="post"
										action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants/%s/delete", product.ID, vwo.Variant.ID)) }
										hx-post={ fmt.Sprintf("/admin/catalog/%s/variants/%s/delete", product.ID, vwo.Variant.ID) }
										hx-target="#variants-panel"
										hx-swap="outerHTML"
										hx-confirm="Delete this variant?"
										class="inline"
									>
										<button type="submit" class="text-red-600 hover:text-red-900">Delete</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			} else {
				<div class="px-4 py-5 sm:px-6">
					<p class="text-sm text-stone-500">No variants yet. Define options above first, then add variants.</p>
				</div>
			}
			<!-- Add variant form -->
			<div class="border-t border-stone-200 px-4 py-5 sm:px-6">
				<h4 class="text-sm font-medium text-stone-900 mb-4">Add variant</h4>
				<form
					id="variant-form"
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/variants", product.ID)) }
					hx-post={ fmt.Sprintf("/admin/catalog/%s/variants", product.ID) }
					hx-target="#variants-panel"
					hx-swap="outerHTML"
					class="flex items-end gap-3 flex-wrap"
					data-taxon-name={ taxonName }
					data-product-title={ product.Title }
				>
					for _, opt := range options {
						<div class="flex-1 min-w-[120px]">
							<label class="block text-sm/6 font-medium text-stone-900">{ opt.Option.Name }</label>
							<div class="mt-2">
								<select name={ fmt.Sprintf("option_%s", opt.Option.ID) } required class={ inputClasses(false) + " js-option-select" }>
									<option value="">Select { opt.Option.Name }</option>
									for _, val := range opt.Values {
										<option value={ val.ID.String() }>{ val.Value }</option>
									}
								</select>
							</div>
						</div>
					}
					<div class="flex-1 min-w-[120px]">
						<label for="variant_sku" class="block text-sm/6 font-medium text-stone-900">SKU</label>
						<div class="mt-2">
							<input
								type="text"
								id="variant_sku"
								name="sku"
								placeholder="AUTO-GEN"
								required
								oninput="this.dataset.edited='true'"
								class={ inputClasses(false) }
							/>
						</div>
					</div>
					<div class="flex-1 min-w-[120px]">
						<label for="variant_barcode" class="block text-sm/6 font-medium text-stone-900">Barcode</label>
						<div class="mt-2">
							<input type="text" id="variant_barcode" name="barcode" placeholder="Optional" class={ inputClasses(false) }/>
						</div>
					</div>
					<div class="w-24">
						<!-- TODO: unit should come from a global weight-unit setting in the admin settings panel -->
						<label for="variant_weight" class="block text-sm/6 font-medium text-stone-900">Weight (oz)</label>
						<div class="mt-2">
							<input type="number" id="variant_weight" name="weight_oz" step="0.1" placeholder="0" class={ inputClasses(false) }/>
						</div>
					</div>
					<div class="flex items-center gap-2 pb-1.5">
						<input type="checkbox" id="variant_default" name="is_default" value="true" class="size-4 rounded border-stone-300 text-hiri-teal focus:ring-hiri-teal"/>
						<label for="variant_default" class="text-sm font-medium text-stone-900">Default</label>
					</div>
					<button type="submit" class="rounded-md bg-hiri-teal px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-hiri-teal-dark">
						Add
					</button>
				</form>
				<script>
					(function() {
						function abbrev(s) {
							s = s.trim().toUpperCase();
							if (!s) return '';
							var words = s.split(/\s+/);
							if (words.length > 1) {
								return words.map(function(w) { return w[0]; }).join('').slice(0, 4);
							}
							return s.replace(/[^A-Z0-9]/g, '').slice(0, 3);
						}

						function updateSKU(form) {
							var sku = form.querySelector('#variant_sku');
							if (sku.dataset.edited) return;
							var parts = [];
							var taxon = form.dataset.taxonName;
							if (taxon) parts.push(abbrev(taxon));
							parts.push(abbrev(form.dataset.productTitle));
							form.querySelectorAll('.js-option-select').forEach(function(sel) {
								if (sel.selectedIndex > 0) {
									parts.push(abbrev(sel.options[sel.selectedIndex].text));
								}
							});
							sku.value = parts.join('-');
						}

						function init() {
							var form = document.getElementById('variant-form');
							if (!form) return;
							form.querySelectorAll('.js-option-select').forEach(function(sel) {
								sel.addEventListener('change', function() { updateSKU(form); });
							});
						}

						init();
						document.addEventListener('htmx:afterSwap', init);
					})();
				</script>
			</div>
		</div>
	</div>
}

// StatusToggle renders the active/inactive toggle as a standalone partial for htmx swaps.
templ StatusToggle(product *domain.Product) {
	<div id="status-panel">
		<div class="flex items-center justify-between">
			<div>
				<p class="text-sm font-medium text-stone-900">Active</p>
				<p class="text-sm text-stone-500">Product is visible on the storefront.</p>
			</div>
			if product.Status == domain.ProductStatusArchived {
				@switchcomp.Switch(switchcomp.Props{
					ID:       fmt.Sprintf("status-%s", product.ID),
					Name:     "status",
					Value:    "active",
					Checked:  false,
					Disabled: true,
				})
			} else {
				@switchcomp.Switch(switchcomp.Props{
					ID:      fmt.Sprintf("status-%s", product.ID),
					Name:    "status",
					Value:   "active",
					Checked: product.Status == domain.ProductStatusActive,
					Attributes: templ.Attributes{
						"hx-post":    fmt.Sprintf("/admin/catalog/%s/status", product.ID),
						"hx-target":  "#status-panel",
						"hx-swap":    "outerHTML",
						"hx-trigger": "change",
					},
				})
			}
		</div>
	</div>
}

// SubscribableToggle renders the subscription toggle row for embedding inside another panel.
templ SubscribableToggle(product *domain.Product) {
	<div id="subscribable-panel">
		<div class="flex items-center justify-between">
			<div>
				<p class="text-sm font-medium text-stone-900">Allow subscriptions</p>
				<p class="text-sm text-stone-500">Customers can subscribe for recurring delivery.</p>
			</div>
			@switchcomp.Switch(switchcomp.Props{
				ID:      fmt.Sprintf("subscribable-%s", product.ID),
				Name:    "subscribable",
				Value:   "true",
				Checked: product.Subscribable,
				Attributes: templ.Attributes{
					"hx-post":    fmt.Sprintf("/admin/catalog/%s/subscribable", product.ID),
					"hx-target":  "#subscribable-panel",
					"hx-swap":    "outerHTML",
					"hx-trigger": "change",
				},
			})
		</div>
	</div>
}

// SubscribablePanel renders the subscription toggle as a standalone partial for htmx swaps.
templ SubscribablePanel(product *domain.Product) {
	@SubscribableToggle(product)
}

templ ProductEdit(props ProductEditProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      props.Product.Title + " - Edit",
		ActivePath: "/admin/catalog",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@ProductEditContent(props)
	}
}
