package admin

import "github.com/dukerupert/hiri/internal/domain"

type ProductFormProps struct {
	Product *domain.Product
	Taxons  []domain.Taxon
	IsNew   bool
	Errors  map[string]string
	Action  string
}

func productVal(p *domain.Product, field string) string {
	if p == nil {
		return ""
	}
	switch field {
	case "title":
		return p.Title
	case "slug":
		return p.Slug
	case "description":
		return p.Description
	default:
		return ""
	}
}

func productDateVal(p *domain.Product, field string) string {
	if p == nil {
		return ""
	}
	switch field {
	case "available_on":
		if p.AvailableOn != nil {
			return p.AvailableOn.Format("2006-01-02")
		}
	case "discontinue_on":
		if p.DiscontinueOn != nil {
			return p.DiscontinueOn.Format("2006-01-02")
		}
	}
	return ""
}

func hasError(errors map[string]string, field string) bool {
	if errors == nil {
		return false
	}
	_, ok := errors[field]
	return ok
}

func getError(errors map[string]string, field string) string {
	if errors == nil {
		return ""
	}
	return errors[field]
}

func inputClasses(hasErr bool) string {
	if hasErr {
		return "block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-red-300 placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-red-500 sm:text-sm/6"
	}
	return "block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"
}

templ ProductForm(props ProductFormProps) {
	<form method="post" action={ templ.SafeURL(props.Action) }>
		<div class="space-y-12">
			<!-- General section -->
			<div class="border-b border-rr-border pb-12">
				<h2 class="text-base/7 font-semibold text-rr-heading">General</h2>
				<p class="mt-1 text-sm/6 text-rr-muted">Basic product information.</p>
				<div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
					<!-- Title -->
					<div class="sm:col-span-4">
						<label for="title" class="block text-sm/6 font-medium text-rr-heading">Title</label>
						<div class="mt-2">
							<input
								type="text"
								id="title"
								name="title"
								value={ productVal(props.Product, "title") }
								placeholder="Product title"
								required
								oninput="var s=document.getElementById('slug');if(!s.dataset.edited){s.value=this.value.toLowerCase().trim().replace(/[^\w\s-]/g,'').replace(/[\s_]+/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'')}"
								class={ inputClasses(hasError(props.Errors, "title")) }
							/>
						</div>
						if msg := getError(props.Errors, "title"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<!-- Slug -->
					<div class="sm:col-span-4">
						<label for="slug" class="block text-sm/6 font-medium text-rr-heading">Slug</label>
						<div class="mt-2">
							<input
								type="text"
								id="slug"
								name="slug"
								value={ productVal(props.Product, "slug") }
								placeholder="product-slug"
								required
								oninput="this.dataset.edited='true'"
								class={ inputClasses(hasError(props.Errors, "slug")) }
							/>
						</div>
						if msg := getError(props.Errors, "slug"); msg != "" {
							<p class="mt-2 text-sm text-red-600">{ msg }</p>
						}
					</div>
					<!-- Description -->
					<div class="col-span-full">
						<label for="description" class="block text-sm/6 font-medium text-rr-heading">Description</label>
						<div class="mt-2">
							<textarea
								id="description"
								name="description"
								rows="4"
								placeholder="Product description"
								class={ inputClasses(false) }
							>{ productVal(props.Product, "description") }</textarea>
						</div>
					</div>
					<!-- Category -->
					<div class="sm:col-span-3">
						<label for="taxon_id" class="block text-sm/6 font-medium text-rr-heading">Category</label>
						<div class="mt-2 grid grid-cols-1">
							<select
								id="taxon_id"
								name="taxon_id"
								class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"
							>
								<option value="">No category</option>
								for _, t := range props.Taxons {
									if props.Product != nil && props.Product.TaxonID == t.ID {
										<option value={ t.ID.String() } selected>{ t.Name }</option>
									} else {
										<option value={ t.ID.String() }>{ t.Name }</option>
									}
								}
							</select>
							<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
								<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
							</svg>
						</div>
					</div>
				</div>
			</div>
			<!-- Availability section -->
			<div class="border-b border-rr-border pb-12">
				<h2 class="text-base/7 font-semibold text-rr-heading">Availability</h2>
				<p class="mt-1 text-sm/6 text-rr-muted">Control when this product is available for purchase.</p>
				<div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
					<div class="sm:col-span-3">
						<label for="available_on" class="block text-sm/6 font-medium text-rr-heading">Available on</label>
						<div class="mt-2">
							<input
								type="date"
								id="available_on"
								name="available_on"
								value={ productDateVal(props.Product, "available_on") }
								class={ inputClasses(false) }
							/>
						</div>
						<p class="mt-2 text-sm text-rr-muted">Leave blank to make available immediately.</p>
					</div>
					<div class="sm:col-span-3">
						<label for="discontinue_on" class="block text-sm/6 font-medium text-rr-heading">Discontinue on</label>
						<div class="mt-2">
							<input
								type="date"
								id="discontinue_on"
								name="discontinue_on"
								value={ productDateVal(props.Product, "discontinue_on") }
								class={ inputClasses(false) }
							/>
						</div>
						<p class="mt-2 text-sm text-rr-muted">Leave blank to keep available indefinitely.</p>
					</div>
				</div>
			</div>
		</div>
		<!-- Footer -->
		<div class="mt-6 flex items-center justify-end gap-x-6">
			<a href="/admin/catalog" class="text-sm/6 font-semibold text-rr-heading">Cancel</a>
			<button
				type="submit"
				class="rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
			>
				if props.IsNew {
					Create product
				} else {
					Save changes
				}
			</button>
		</div>
	</form>
}
