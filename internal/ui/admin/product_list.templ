package admin

import (
	"fmt"
	"net/url"
	"time"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type ProductListProps struct {
	Products     []domain.Product
	Taxons       []domain.Taxon
	TaxonMap     map[uuid.UUID]string
	StatusFilter string
	TaxonFilter  string
	// WhiteLabel is set when the list is showing the white-label review queue
	// (?white_label=pending): submissions still in draft. WhiteLabelPending is the
	// unfiltered queue depth, shown on the tab so the work is visible from any tab.
	WhiteLabel        bool
	WhiteLabelPending int
	Search       string
	TotalCount   int
	Page         int
	PerPage      int
	MerchantTZ   *time.Location
	StaffName    string
	StaffRole    string
	HasMore      bool
}

func (p ProductListProps) showingStart() int {
	if p.TotalCount == 0 {
		return 0
	}
	return (p.Page-1)*p.PerPage + 1
}

func (p ProductListProps) showingEnd() int {
	end := p.Page * p.PerPage
	if end > p.TotalCount {
		return p.TotalCount
	}
	return end
}

func productTabHref(status, taxon, search string) string {
	v := url.Values{}
	if status != "" {
		v.Set("status", status)
	}
	if taxon != "" {
		v.Set("taxon", taxon)
	}
	if search != "" {
		v.Set("q", search)
	}
	if len(v) == 0 {
		return "/admin/catalog"
	}
	return "/admin/catalog?" + v.Encode()
}

// whiteLabelQueueHref links to the white-label review queue — draft submissions
// from the wholesale onboarding flow. The query value must match
// web.whiteLabelPending.
func whiteLabelQueueHref(taxon, search string) string {
	v := url.Values{}
	v.Set("white_label", "pending")
	if taxon != "" {
		v.Set("taxon", taxon)
	}
	if search != "" {
		v.Set("q", search)
	}
	return "/admin/catalog?" + v.Encode()
}

func productPageHref(page int, status, taxon, search string, whiteLabel bool) string {
	v := url.Values{}
	v.Set("page", fmt.Sprintf("%d", page))
	if whiteLabel {
		v.Set("white_label", "pending")
	} else if status != "" {
		v.Set("status", status)
	}
	if taxon != "" {
		v.Set("taxon", taxon)
	}
	if search != "" {
		v.Set("q", search)
	}
	return "/admin/catalog?" + v.Encode()
}

templ ProductListContent(props ProductListProps) {
		@adminSectionTabs(catalogTabs(), "/admin/catalog")
		<!-- Page header -->
		<div class="sm:flex sm:items-center">
			<div class="sm:flex-auto">
				<h1 class="admin-page-title">Products</h1>
				if props.WhiteLabel {
					<p class="mt-1 text-sm text-rr-muted">White-label submissions from wholesale clients, waiting on review. Open one to check the name, label art, and pricing, then set it to Active to publish it to that client.</p>
				} else {
					<p class="mt-1 text-sm text-rr-muted">Manage your product catalog</p>
				}
			</div>
			<div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
				<a
					href="/admin/catalog/new"
					class="block rounded-sm bg-rr-red px-3 py-2 text-center text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
				>
					Add product
				</a>
			</div>
		</div>
		<!-- Search + Filters -->
		<div class="mt-6 space-y-4">
			<form method="get" action="/admin/catalog" class="flex items-start gap-3">
				if props.WhiteLabel {
					// Keep searching/filtering inside the review queue instead of
					// silently dropping back to the full catalog.
					<input type="hidden" name="white_label" value="pending"/>
				} else {
					<input type="hidden" name="status" value={ props.StatusFilter }/>
				}
				<!-- Search -->
				<div class="max-w-sm flex-1">
					<input
						type="search"
						name="q"
						value={ props.Search }
						placeholder="Search products..."
						hx-get="/admin/catalog"
						hx-trigger="input changed delay:300ms, search"
						hx-target="#main-content"
						hx-push-url="true"
						hx-include="closest form"
						class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
					/>
				</div>
				<!-- Category dropdown (kept since categories are dynamic) -->
				<div class="grid grid-cols-1">
					<select
						name="taxon"
						onchange="this.form.submit()"
						class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
					>
						<option value="">All categories</option>
						for _, t := range props.Taxons {
							<option value={ t.ID.String() } selected?={ props.TaxonFilter == t.ID.String() }>{ t.Name }</option>
						}
					</select>
					<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
						<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
					</svg>
				</div>
			</form>
			<!-- Status tabs -->
			<nav class="flex gap-0 border-b border-rr-border -mb-px">
				<a href={ templ.SafeURL(productTabHref("", props.TaxonFilter, props.Search)) } class={ orderTabClass(!props.WhiteLabel && props.StatusFilter == "") }>All</a>
				<a href={ templ.SafeURL(productTabHref("draft", props.TaxonFilter, props.Search)) } class={ orderTabClass(!props.WhiteLabel && props.StatusFilter == "draft") }>Draft</a>
				<a href={ templ.SafeURL(productTabHref("active", props.TaxonFilter, props.Search)) } class={ orderTabClass(!props.WhiteLabel && props.StatusFilter == "active") }>Active</a>
				<a href={ templ.SafeURL(productTabHref("archived", props.TaxonFilter, props.Search)) } class={ orderTabClass(!props.WhiteLabel && props.StatusFilter == "archived") }>Archived</a>
				<a href={ templ.SafeURL(whiteLabelQueueHref(props.TaxonFilter, props.Search)) } class={ orderTabClass(props.WhiteLabel) }>
					White-label review
					if props.WhiteLabelPending > 0 {
						<span class="badge badge-indigo ml-1.5">{ fmt.Sprintf("%d", props.WhiteLabelPending) }</span>
					}
				</a>
			</nav>
		</div>
		<!-- Product table -->
		<div class="mt-4">
			if len(props.Products) == 0 {
				<div class="border border-dashed border-rr-border p-12 text-center">
					<svg class="mx-auto size-12 text-rr-border" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
						<path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0-3-3m3 3 3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"></path>
					</svg>
					if props.WhiteLabel {
						<h3 class="mt-2 text-sm font-semibold text-rr-heading">Nothing waiting on review</h3>
						<p class="mt-1 text-sm text-rr-muted">Every white-label submission has been published or archived.</p>
					} else if props.Search != "" {
						<h3 class="mt-2 text-sm font-semibold text-rr-heading">No products</h3>
						<p class="mt-1 text-sm text-rr-muted">No products match "{ props.Search }". Try a different search.</p>
					} else {
						<h3 class="mt-2 text-sm font-semibold text-rr-heading">No products</h3>
						<p class="mt-1 text-sm text-rr-muted">Get started by creating a new product.</p>
						<div class="mt-6">
							<a href="/admin/catalog/new" class="inline-flex items-center rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt">
								Add product
							</a>
						</div>
					}
				</div>
			} else {
				<div class="overflow-hidden border border-rr-border bg-rr-surface">
					<table class="min-w-full divide-y divide-rr-border">
						<thead class="bg-rr-raised">
							<tr>
								<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Title</th>
								<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
								<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">Category</th>
								<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">Created</th>
								<th scope="col" class="hidden relative py-3.5 pl-3 pr-4 sm:table-cell sm:pr-6">
									<span class="sr-only">Edit</span>
								</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-rr-border bg-rr-surface">
							for _, p := range props.Products {
								<tr class="row-link">
									<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
										<div class="flex items-center gap-2">
											<a href={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s", p.ID)) } class="row-link-target font-medium text-rr-heading hover:text-rr-red">
												{ p.Title }
											</a>
											if p.IsFeatured {
												<span class="badge badge-amber" title="Featured on the home page">Featured</span>
											}
											if domain.IsWhiteLabelSubmission(p.Metadata) {
												<span class="badge badge-indigo" title="Submitted through wholesale white-label onboarding">White-label</span>
											}
										</div>
									</td>
									<td class="whitespace-nowrap px-3 py-4 text-sm">
										@StatusBadge(p.Status)
									</td>
									<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
										if name, ok := props.TaxonMap[p.TaxonID]; ok {
											{ name }
										} else {
											<span class="text-rr-border">—</span>
										}
									</td>
									<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted lg:table-cell">
										{ p.CreatedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
									</td>
									<td class="hidden whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:table-cell sm:pr-6">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s", p.ID)) } class="text-rr-red hover:text-rr-red-lt">
											Edit<span class="sr-only">, { p.Title }</span>
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<!-- Pagination -->
				<nav class="flex items-center justify-between border-t border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
					<div class="-mt-px flex w-0 flex-1">
						if props.Page > 1 {
							<a
								href={ templ.SafeURL(productPageHref(props.Page-1, props.StatusFilter, props.TaxonFilter, props.Search, props.WhiteLabel)) }
								class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
							>
								Previous
							</a>
						}
					</div>
					if props.TotalCount > 0 {
						<p class="text-sm text-rr-muted">
							<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingStart()) }</span>–<span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.showingEnd()) }</span> of <span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.TotalCount) }</span>
						</p>
					}
					<div class="-mt-px flex w-0 flex-1 justify-end">
						if props.HasMore {
							<a
								href={ templ.SafeURL(productPageHref(props.Page+1, props.StatusFilter, props.TaxonFilter, props.Search, props.WhiteLabel)) }
								class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
							>
								Next
							</a>
						}
					</div>
				</nav>
			}
		</div>
}

templ ProductList(props ProductListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Products",
		ActivePath: "/admin/catalog",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@ProductListContent(props)
	}
}
