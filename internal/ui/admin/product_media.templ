package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/media"
	"github.com/google/uuid"
)

type MediaGalleryProps struct {
	ProductID   uuid.UUID
	Media       []domain.ProductMedia
	MediaConfig *media.Config
}

// mediaURL resolves a product media item to a renderable URL.
func mediaURL(m domain.ProductMedia, cfg *media.Config) string {
	if cfg != nil && m.R2Key != "" {
		return cfg.ProductImageURL(m.R2Key, media.VariantCard)
	}
	if cfg != nil {
		return cfg.PlaceholderURL()
	}
	return "/static/placeholder-product.png"
}

// MediaGallery renders the product image gallery with upload and delete controls.
// This is the htmx-swappable partial — used by both the initial page render and
// after image add/delete operations.
templ MediaGallery(props MediaGalleryProps) {
	<div id="media-gallery" class="border border-rr-border bg-rr-surface">
		<div class="px-4 py-5 sm:px-6">
			<h3 class="text-base/7 font-semibold text-rr-heading">Images</h3>
			<p class="mt-1 text-sm text-rr-muted">Product photos displayed on the storefront. First image is the primary.</p>
		</div>
		<div class="border-t border-rr-border px-4 py-5 sm:px-6">
			if len(props.Media) > 0 {
				<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
					for i, m := range props.Media {
						<div class="group relative">
							<div class="aspect-square overflow-hidden rounded-sm bg-rr-raised">
								<img
									src={ mediaURL(m, props.MediaConfig) }
									alt={ m.AltText }
									class="h-full w-full object-cover object-center"
								/>
							</div>
							if i == 0 {
								<span class="absolute top-2 left-2 inline-flex items-center rounded-sm bg-rr-red px-1.5 py-0.5 text-xs font-medium text-white">
									Primary
								</span>
							}
							<!-- Action buttons overlay -->
							<div class="absolute top-2 right-2 hidden group-hover:flex gap-1">
								if i != 0 {
									<!-- Set as primary -->
									<form
										method="post"
										action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/images/%s/primary", props.ProductID, m.ID)) }
										hx-post={ fmt.Sprintf("/admin/catalog/%s/images/%s/primary", props.ProductID, m.ID) }
										hx-target="#media-gallery"
										hx-swap="outerHTML"
									>
										<button
											type="submit"
											class="rounded-full bg-rr-amber p-1 text-white shadow-sm hover:bg-rr-amber/80"
											title="Set as primary"
										>
											<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"></path>
											</svg>
										</button>
									</form>
								}
								<!-- Delete -->
								<form
									method="post"
									action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/images/%s/delete", props.ProductID, m.ID)) }
									hx-post={ fmt.Sprintf("/admin/catalog/%s/images/%s/delete", props.ProductID, m.ID) }
									hx-target="#media-gallery"
									hx-swap="outerHTML"
									hx-confirm="Delete this image?"
									{ ConfirmDataAttrs(ActionConfirm{
										Title: "Delete this image?",
										Lead:  "Removes the image from this product.",
										Points: []string{
											"This cannot be undone — you would have to upload the file again.",
											"If it is the primary image, the next one takes its place on the storefront.",
										},
										Confirm: "Delete image",
										Danger:  true,
									})... }
								>
									<button
										type="submit"
										class="rounded-full bg-red-600 p-1 text-white shadow-sm hover:bg-red-500"
										title="Delete"
									>
										<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
										</svg>
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			}
			<!-- Upload drop zone -->
			<div
				x-data={ fmt.Sprintf("imageUploader('%s')", props.ProductID) }
				class={ templ.KV("mt-4", len(props.Media) > 0) }
			>
				<div
					@click="$refs.fileInput.click()"
					@dragover.prevent="dragging = true"
					@dragleave.prevent="dragging = false"
					@drop.prevent="dragging = false; handleDrop($event)"
					:class="dragging ? 'border-rr-red bg-rr-red/5' : 'border-rr-border'"
					class="flex cursor-pointer justify-center rounded-sm border border-dashed px-6 py-10 transition-colors"
				>
					<div class="text-center">
						<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="mx-auto size-12 text-rr-border">
							<path
								fill-rule="evenodd"
								clip-rule="evenodd"
								d="M1.5 6a2.25 2.25 0 0 1 2.25-2.25h16.5A2.25 2.25 0 0 1 22.5 6v12a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 18V6ZM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0 0 21 18v-1.94l-2.69-2.689a1.5 1.5 0 0 0-2.12 0l-.88.879.97.97a.75.75 0 1 1-1.06 1.06l-5.16-5.159a1.5 1.5 0 0 0-2.12 0L3 16.061Zm10.125-7.81a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Z"
							></path>
						</svg>
						<div class="mt-4 flex text-sm/6 text-rr-muted">
							<span class="font-semibold text-rr-red hover:text-rr-red-lt" x-show="!uploading">Upload a file</span>
							<span class="font-semibold text-rr-muted" x-show="uploading" x-cloak>
								Uploading <span x-text="progress"></span>...
							</span>
							<p class="pl-1" x-show="!uploading">or drag and drop</p>
						</div>
						<p class="text-xs/5 text-rr-muted">PNG, JPG, GIF up to 10MB</p>
						<!-- Error display -->
						<template x-if="error">
							<p class="mt-2 text-sm text-red-600" x-text="error"></p>
						</template>
					</div>
				</div>
				<input
					type="file"
					accept="image/png,image/jpeg,image/gif"
					multiple
					x-ref="fileInput"
					@change="handleFiles($event)"
					class="sr-only"
				/>
			</div>
		</div>
	</div>
}
