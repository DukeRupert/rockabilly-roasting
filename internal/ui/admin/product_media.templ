package admin

import (
	"fmt"
	"github.com/google/uuid"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/media"
)

type MediaGalleryProps struct {
	ProductID   uuid.UUID
	Media       []domain.ProductMedia
	MediaConfig *media.Config
}

// mediaURL resolves a product media item to a renderable URL.
func mediaURL(m domain.ProductMedia, cfg *media.Config) string {
	if cfg != nil && m.R2Key != "" {
		return cfg.ProductImageURL(m.R2Key, media.VariantCard)
	}
	if cfg != nil {
		return cfg.PlaceholderURL()
	}
	return "/static/placeholder-product.png"
}

// MediaGallery renders the product image gallery with upload and delete controls.
// This is the htmx-swappable partial — used by both the initial page render and
// after image add/delete operations.
templ MediaGallery(props MediaGalleryProps) {
	<div id="media-gallery" class="rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
		<div class="px-4 py-5 sm:px-6">
			<h3 class="text-base/7 font-semibold text-stone-900">Images</h3>
			<p class="mt-1 text-sm text-stone-500">Product photos displayed on the storefront. First image is the primary.</p>
		</div>
		<div class="border-t border-stone-200 px-4 py-5 sm:px-6">
			if len(props.Media) > 0 {
				<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
					for i, m := range props.Media {
						<div class="group relative">
							<div class="aspect-square overflow-hidden rounded-lg bg-stone-100">
								<img
									src={ mediaURL(m, props.MediaConfig) }
									alt={ m.AltText }
									class="h-full w-full object-cover object-center"
								/>
							</div>
							if i == 0 {
								<span class="absolute top-2 left-2 inline-flex items-center rounded-md bg-rr-red px-1.5 py-0.5 text-xs font-medium text-white">
									Primary
								</span>
							}
							<!-- Delete button overlay -->
							<form
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s/images/%s/delete", props.ProductID, m.ID)) }
								hx-post={ fmt.Sprintf("/admin/catalog/%s/images/%s/delete", props.ProductID, m.ID) }
								hx-target="#media-gallery"
								hx-swap="outerHTML"
								hx-confirm="Delete this image?"
								class="absolute top-2 right-2 hidden group-hover:block"
							>
								<button
									type="submit"
									class="rounded-full bg-red-600 p-1 text-white shadow-sm hover:bg-red-500"
								>
									<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
									</svg>
								</button>
							</form>
						</div>
					}
				</div>
			}
			<!-- Upload drop zone -->
			<div
				x-data={ fmt.Sprintf("imageUploader('%s')", props.ProductID) }
				class={ templ.KV("mt-4", len(props.Media) > 0) }
			>
				<div
					@click="$refs.fileInput.click()"
					@dragover.prevent="dragging = true"
					@dragleave.prevent="dragging = false"
					@drop.prevent="dragging = false; handleDrop($event)"
					:class="dragging ? 'border-rr-red bg-rr-red/5' : 'border-stone-900/25'"
					class="flex cursor-pointer justify-center rounded-lg border border-dashed px-6 py-10 transition-colors"
				>
					<div class="text-center">
						<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="mx-auto size-12 text-stone-300">
							<path
								fill-rule="evenodd"
								clip-rule="evenodd"
								d="M1.5 6a2.25 2.25 0 0 1 2.25-2.25h16.5A2.25 2.25 0 0 1 22.5 6v12a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 18V6ZM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0 0 21 18v-1.94l-2.69-2.689a1.5 1.5 0 0 0-2.12 0l-.88.879.97.97a.75.75 0 1 1-1.06 1.06l-5.16-5.159a1.5 1.5 0 0 0-2.12 0L3 16.061Zm10.125-7.81a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Z"
							></path>
						</svg>
						<div class="mt-4 flex text-sm/6 text-stone-600">
							<span class="font-semibold text-rr-red hover:text-rr-red-lt" x-show="!uploading">Upload a file</span>
							<span class="font-semibold text-stone-500" x-show="uploading" x-cloak>
								Uploading <span x-text="progress"></span>...
							</span>
							<p class="pl-1" x-show="!uploading">or drag and drop</p>
						</div>
						<p class="text-xs/5 text-stone-600">PNG, JPG, GIF up to 10MB</p>
						<!-- Error display -->
						<template x-if="error">
							<p class="mt-2 text-sm text-red-600" x-text="error"></p>
						</template>
					</div>
				</div>
				<input
					type="file"
					accept="image/png,image/jpeg,image/gif"
					multiple
					x-ref="fileInput"
					@change="handleFiles($event)"
					class="sr-only"
				/>
			</div>
		</div>
	</div>
}

// imageUploaderScript outputs the Alpine.js component for direct-to-R2 upload.
templ ImageUploaderScript() {
	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('imageUploader', (productId) => ({
				uploading: false,
				dragging: false,
				progress: '',
				error: '',

				handleDrop(event) {
					const files = event.dataTransfer.files;
					if (files.length) {
						this.$refs.fileInput.files = files;
						this.handleFiles({ target: { files, value: '' } });
					}
				},

				async handleFiles(event) {
					const files = event.target.files;
					if (!files.length) return;

					this.uploading = true;
					this.error = '';

					for (let i = 0; i < files.length; i++) {
						this.progress = (i + 1) + ' of ' + files.length;
						try {
							await this.uploadFile(files[i], i);
						} catch (err) {
							this.error = 'Upload failed: ' + err.message;
							break;
						}
					}

					this.uploading = false;
					this.progress = '';
					if (event.target.value !== undefined) {
						event.target.value = '';
					}
				},

				async uploadFile(file, position) {
					// Step 1: Get presigned R2 upload URL from our server.
					const urlForm = new FormData();
					urlForm.append('content_type', file.type || 'image/jpeg');
					const urlResp = await fetch('/admin/images/upload-url', {
						method: 'POST',
						headers: { 'X-Requested-With': 'XMLHttpRequest' },
						body: urlForm,
					});
					if (!urlResp.ok) throw new Error('Failed to get upload URL');
					const { upload_url, r2_key } = await urlResp.json();

					// Step 2: Upload directly to R2 via presigned PUT.
					const r2Resp = await fetch(upload_url, {
						method: 'PUT',
						headers: { 'Content-Type': file.type || 'image/jpeg' },
						body: file,
					});
					if (!r2Resp.ok) throw new Error('Failed to upload to R2');

					// Step 3: Persist the R2 key in our database.
					const persistForm = new FormData();
					persistForm.append('r2_key', r2_key);
					persistForm.append('alt_text', file.name.replace(/\.[^.]+$/, ''));
					persistForm.append('position', position.toString());

					const persistResp = await fetch('/admin/catalog/' + productId + '/images', {
						method: 'POST',
						headers: {
							'HX-Request': 'true',
						},
						body: persistForm,
					});
					if (!persistResp.ok) throw new Error('Failed to save image');

					// Step 4: Swap in the updated gallery.
					const html = await persistResp.text();
					const gallery = document.getElementById('media-gallery');
					if (gallery) {
						gallery.outerHTML = html;
						htmx.process(document.getElementById('media-gallery'));
					}
				},
			}));
		});
	</script>
}
