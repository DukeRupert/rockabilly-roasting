package admin

import (
	"strconv"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// QBPreviewProps backs the shadow-billing review page: everything QuickBooks
// billing would have done, had it been live.
type QBPreviewProps struct {
	Nav        SettingsNav
	Rows       []QBPreviewRow
	Mode       domain.QBBillingMode
	Attention  int
	TotalCents int
	Flash      Flash
	StaffName  string
	StaffRole  string
}

// QBPreviewRow is one would-be invoice as this page needs it. The handler maps
// the store row onto this: ui may only see domain, so the joined order number
// and customer name arrive as plain strings rather than by reaching into the
// store package.
type QBPreviewRow struct {
	domain.QBInvoicePreview
	OrderNumber  string
	CustomerName string
}

templ QBPreview(props QBPreviewProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "QuickBooks test mode",
		ActivePath: "/admin/settings",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@QBPreviewContent(props)
	}
}

templ QBPreviewContent(props QBPreviewProps) {
	@settingsSection(props.Nav, settingsTabIntegrations)
	<h1 class="admin-page-title">QuickBooks test mode</h1>
	@adminFlash(props.Flash)

	<div class="mt-2 max-w-3xl">
		if props.Mode.IsLive() {
			<p class="text-sm text-rr-body">
				Billing is <span class="badge badge-green">Live</span> — these are what test mode
				recorded before you switched over. They were never billed, and going live did not
				bill them retrospectively.
			</p>
		} else {
			<p class="text-sm text-rr-body">
				Billing is in <span class="badge badge-amber">Test mode</span>. Every wholesale
				order below was costed exactly as it would have been billed, but nothing reached
				QuickBooks and no customer was emailed.
			</p>
		}
	</div>

	if len(props.Rows) == 0 {
		<div class="mt-6 rounded border border-rr-border bg-rr-surface px-4 py-6">
			<p class="text-sm text-rr-muted">
				Nothing recorded yet. Wholesale orders appear here as they are placed.
			</p>
		</div>
	} else {
		<div class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sm">
			<div>
				<span class="label-font text-rr-muted">Would be billed</span>
				<span class="ml-2 text-rr-heading">{ formatCents(props.TotalCents) }</span>
			</div>
			<div>
				<span class="label-font text-rr-muted">Orders</span>
				<span class="ml-2 text-rr-heading">{ strconv.Itoa(len(props.Rows)) }</span>
			</div>
			<div>
				<span class="label-font text-rr-muted">Need attention</span>
				if props.Attention > 0 {
					<span class="badge badge-amber ml-2">{ strconv.Itoa(props.Attention) }</span>
				} else {
					<span class="ml-2 text-rr-muted">None</span>
				}
			</div>
		</div>

		<div class="mt-4 overflow-hidden rounded border border-rr-border bg-rr-surface">
			<table class="min-w-full divide-y divide-rr-border">
				<thead>
					<tr>
						<th class="label-font px-4 py-2 text-left text-rr-muted">Order</th>
						<th class="label-font px-4 py-2 text-left text-rr-muted">Customer</th>
						<th class="label-font px-4 py-2 text-left text-rr-muted">Terms</th>
						<th class="label-font px-4 py-2 text-left text-rr-muted">Due</th>
						<th class="label-font px-4 py-2 text-right text-rr-muted">Total</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-rr-border">
					for _, row := range props.Rows {
						// Rows needing a human before go-live carry the same
						// persistent rust flag the order lists use for stuck work.
						<tr class={ "row-link", templ.KV("row-link-stale", row.Problem() != "") }>
							<td class="px-4 py-3 text-sm">
								<a href={ templ.SafeURL("/admin/orders/" + row.OrderID.String()) } class="row-link-target text-rr-heading">
									{ row.OrderNumber }
								</a>
								if row.Problem() != "" {
									<p class="mt-1 text-xs text-rr-muted">{ row.Problem() }</p>
								}
							</td>
							<td class="px-4 py-3 text-sm text-rr-body">
								{ row.CustomerName }
								if row.BillEmail != "" {
									<p class="text-xs text-rr-muted">{ row.BillEmail }</p>
								}
							</td>
							<td class="px-4 py-3 text-sm text-rr-body">
								{ domain.PaymentTermsLabel(row.TermsDays) }
							</td>
							<td class="px-4 py-3 text-sm text-rr-body">
								{ row.DueDate.Format("Jan 2, 2006") }
							</td>
							<td class="px-4 py-3 text-right text-sm text-rr-heading">
								{ formatCents(row.TotalCents) }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
