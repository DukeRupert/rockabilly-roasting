package admin

import (
	"strconv"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// QBPreviewProps backs the review page: every order invoicing did not bill.
// In test mode that is all of them; once live it is the accounts on manual
// billing, which is why the page keeps earning its place after go-live.
type QBPreviewProps struct {
	Nav        SettingsNav
	Rows       []QBPreviewRow
	Mode       domain.QBBillingMode
	Attention  int
	TotalCents int
	// AwaitingManual is how many rows are on manual billing and will not be
	// invoiced by anything unless a person does it.
	AwaitingManual int
	// Truncated is set when the list shows fewer rows than the totals count,
	// so the page can say so rather than letting the two disagree in silence.
	Truncated bool
	// Count is every preview, which is what the totals describe. len(Rows) may
	// be smaller.
	Count int
	Flash      Flash
	StaffName  string
	StaffRole  string
}

// QBPreviewRow is one would-be invoice as this page needs it. The handler maps
// the store row onto this: ui may only see domain, so the joined order number
// and customer name arrive as plain strings rather than by reaching into the
// store package.
type QBPreviewRow struct {
	domain.QBInvoicePreview
	OrderNumber  string
	CustomerName string
}

// qbRowState is what a row is, in one word, for the status column.
func qbRowState(row QBPreviewRow) string {
	switch {
	case row.AwaitingManualInvoice():
		return "Manual"
	case row.Problem() != "":
		return "Check"
	}
	return "Ready"
}

// qbPreviewTitle names the page for the mode it is being read in. A live shop
// was previously told, in its browser tab and its heading, that it was looking
// at test mode.
func qbPreviewTitle(mode domain.QBBillingMode) string {
	if mode.IsLive() {
		return "Orders not invoiced"
	}
	return "QuickBooks test mode"
}

templ QBPreview(props QBPreviewProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      qbPreviewTitle(props.Mode),
		ActivePath: "/admin/settings",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@QBPreviewContent(props)
	}
}

templ QBPreviewContent(props QBPreviewProps) {
	// Required by the Bill now buttons below. ConfirmAttrs cancels the click
	// and dispatches admin-confirm, which only this host listens for — without
	// it the button is inert and nothing is ever billed.
	@ConfirmDialogHost()
	@settingsSection(props.Nav, settingsTabIntegrations)
	<h1 class="admin-page-title">{ qbPreviewTitle(props.Mode) }</h1>
	@adminFlash(props.Flash)

	<div class="mt-2 max-w-3xl">
		if props.Mode.IsLive() {
			<p class="text-sm text-rr-body">
				Billing is <span class="badge badge-green">Live</span>. Everything below was costed
				but not billed — orders recorded before you switched over, which going live did not
				bill retrospectively, and orders on accounts with no invoicing agreement, which
				nothing bills automatically. Hiri has invoiced none of them; a row will say so if
				QuickBooks already holds an invoice somebody raised by hand.
			</p>
		} else {
			<p class="text-sm text-rr-body">
				Billing is in <span class="badge badge-amber">Test mode</span>. Every wholesale
				order below was costed exactly as it would have been billed, but nothing reached
				QuickBooks and no customer was emailed.
			</p>
		}
	</div>

	if props.AwaitingManual > 0 {
		<p class="mt-2 max-w-3xl text-sm text-rr-muted">
			Orders marked <span class="badge badge-slate">Manual</span> are on accounts with no
			invoicing agreement, so nothing bills them automatically — in test mode or live.
			Invoice those by hand, or use Bill now once you have agreed it with the customer.
		</p>
	}
	if len(props.Rows) == 0 {
		<div class="mt-6 rounded border border-rr-border bg-rr-surface px-4 py-6">
			<p class="text-sm text-rr-muted">
				Nothing recorded yet. Wholesale orders appear here as they are placed.
			</p>
		</div>
	} else {
		<div class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-sm">
			<div>
				<span class="label-font text-rr-muted">Would be billed</span>
				<span class="ml-2 text-rr-heading">{ formatCents(props.TotalCents) }</span>
			</div>
			<div>
				<span class="label-font text-rr-muted">Orders</span>
				<span class="ml-2 text-rr-heading">{ strconv.Itoa(props.Count) }</span>
			</div>
			if props.AwaitingManual > 0 {
				<div>
					<span class="label-font text-rr-muted">Invoice by hand</span>
					<span class="badge badge-slate ml-2">{ strconv.Itoa(props.AwaitingManual) }</span>
				</div>
			}
			<div>
				<span class="label-font text-rr-muted">Need attention</span>
				if props.Attention > 0 {
					<span class="badge badge-amber ml-2">{ strconv.Itoa(props.Attention) }</span>
				} else {
					<span class="ml-2 text-rr-muted">None</span>
				}
			</div>
		</div>

		<div class="mt-4 overflow-hidden rounded border border-rr-border bg-rr-surface">
			<table class="min-w-full divide-y divide-rr-border">
				<thead>
					<tr>
						<th class="label-font px-4 py-2 text-left text-rr-muted">Order</th>
						<th class="label-font px-4 py-2 text-left text-rr-muted">Billing</th>
						<th class="label-font px-4 py-2 text-left text-rr-muted">Customer</th>
						<th class="label-font px-4 py-2 text-left text-rr-muted">Terms</th>
						<th class="label-font px-4 py-2 text-left text-rr-muted">Due</th>
						<th class="label-font px-4 py-2 text-right text-rr-muted">Total</th>
						if props.Mode.IsLive() {
							<th class="label-font px-4 py-2 text-right text-rr-muted">Bill</th>
						}
					</tr>
				</thead>
				<tbody class="divide-y divide-rr-border">
					for _, row := range props.Rows {
						// Rows needing a human before go-live carry the same
						// persistent rust flag the order lists use for stuck work.
						<tr class={ "row-link", templ.KV("row-link-stale", row.Problem() != "") }>
							<td class="px-4 py-3 text-sm">
								<a href={ templ.SafeURL("/admin/orders/" + row.OrderID.String()) } class="row-link-target text-rr-heading">
									{ row.OrderNumber }
								</a>
								if row.Problem() != "" {
									<p class="mt-1 text-xs text-rr-muted">{ row.Problem() }</p>
								} else if props.Mode.IsLive() && row.BillingObstacle() != "" {
									// Not a problem with leaving the row alone, which is why it
									// carries no Check badge — but the operator reaching for Bill
									// now should see it before they reach, not after. Only where
									// that button exists: in test mode there is nothing to act on
									// and this would be a line of warning about a hypothetical.
									<p class="mt-1 text-xs text-rr-muted">If billed: { row.BillingObstacle() }</p>
								}
							</td>
							<td class="px-4 py-3 text-sm">
								if qbRowState(row) == "Manual" {
									<span class="badge badge-slate">Manual</span>
								} else if qbRowState(row) == "Check" {
									<span class="badge badge-amber">Check</span>
								} else {
									<span class="badge badge-green">Ready</span>
								}
							</td>
							<td class="px-4 py-3 text-sm text-rr-body">
								{ row.CustomerName }
								if row.BillEmail != "" {
									<p class="text-xs text-rr-muted">{ row.BillEmail }</p>
								}
							</td>
							<td class="px-4 py-3 text-sm text-rr-body">
								{ domain.PaymentTermsLabel(row.TermsDays) }
							</td>
							<td class="px-4 py-3 text-sm text-rr-body">
								{ row.DueDate.Format("Jan 2, 2006") }
							</td>
							<td class="px-4 py-3 text-right text-sm text-rr-heading">
								{ formatCents(row.TotalCents) }
							</td>
							if props.Mode.IsLive() {
								<td class="px-4 py-3 text-right">
									@qbBillNowButton(row)
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
		if props.Truncated {
			<p class="mt-2 text-xs text-rr-muted">
				Showing the { strconv.Itoa(len(props.Rows)) } most recent of { strconv.Itoa(props.Count + props.AwaitingManual) }.
				The totals above cover all of them.
			</p>
		}
	}
}

// qbBillNowReason says why this order is sitting here unbilled, which is not
// always the same answer: an account on manual billing is never invoiced
// automatically, while everything else here simply predates going live.
func qbBillNowReason(row QBPreviewRow) string {
	if row.AwaitingManualInvoice() {
		return "This account is on manual billing, so nothing invoices it automatically. Only do this if the customer expects a QuickBooks invoice."
	}
	return "This order was recorded in test mode and has not been billed yet."
}

// qbBillNowPoints is what the operator is told before they commit.
//
// The obstacle comes first when there is one. A manual row is not flagged on
// the page — correctly, since leaving it alone is fine — but this button is
// how it stops being left alone, so anything that would go wrong has to be
// said here or it is said nowhere. Without it, billing an account with no
// bill-to address created the invoice and then failed the send, with the page
// having shown a clean row throughout.
func qbBillNowPoints(row QBPreviewRow) []string {
	// Obstacles first, all of them. They are the reason to stop, and a reader
	// who has already decided will skim past whatever precedes them.
	points := append([]string{}, row.BillingObstacles()...)
	points = append(points,
		"The customer receives an invoice for "+formatCents(row.TotalCents)+
			", due "+row.DueDate.Format("Jan 2, 2006")+".",
		qbBillNowReason(row),
		"If you have already invoiced it by hand, do not do this — it would bill them twice.",
	)
	return points
}

// qbBillNowButton offers to bill an order nothing has invoiced — one recorded
// before going live, or one on an account nothing bills automatically.
//
// Only rendered once billing is live, and only for an order that has no
// invoice yet: going live deliberately does not bill the backlog, so this is
// how a human decides, order by order, which of it to charge for.
templ qbBillNowButton(row QBPreviewRow) {
	if row.ExistingQBInvoiceID != nil {
		<span class="text-xs text-rr-muted">Already in QuickBooks</span>
	} else {
		<form method="post" action={ templ.SafeURL("/admin/settings/integrations/quickbooks/preview/" + row.OrderID.String() + "/bill") }>
			<button
				type="submit"
				class="btn-secondary"
				{ ConfirmAttrs(ActionConfirm{
					Title: "Bill " + row.OrderNumber + " now?",
					Lead:  "Creates a real invoice in QuickBooks and emails it to " + row.CustomerName + ".",
					Points: qbBillNowPoints(row),
					Confirm: "Bill this order",
					Danger:  true,
				})... }
			>Bill now</button>
		</form>
	}
}
