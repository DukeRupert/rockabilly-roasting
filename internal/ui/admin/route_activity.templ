package admin

import (
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/audit"
)

// routeEventLabel turns a delivery_route.* audit action into staff-facing copy.
func routeEventLabel(action string) string {
	switch action {
	case audit.AuditRoutePlanned:
		return "Route planned"
	case audit.AuditRouteActivated:
		return "Route started"
	case audit.AuditRouteCompleted:
		return "Route completed"
	case audit.AuditRouteStopRemoved:
		return "Stop removed"
	case audit.AuditRouteStopSkipped:
		return "Stop skipped"
	}
	parts := strings.SplitN(action, ".", 2)
	if len(parts) == 2 {
		verb := strings.ReplaceAll(parts[1], "_", " ")
		return strings.ToUpper(verb[:1]) + verb[1:]
	}
	return action
}

// routeEventMarker colours the dot: forward progress amber, anything that took
// a stop off the run rust.
func routeEventMarker(action string) string {
	switch action {
	case audit.AuditRouteStopRemoved, audit.AuditRouteStopSkipped:
		return "bg-rr-red"
	case audit.AuditRoutePlanned, audit.AuditRouteActivated, audit.AuditRouteCompleted:
		return "bg-rr-amber"
	default:
		return "bg-rr-surface"
	}
}

// RouteActivity is the run's history. It matters more here than on most pages:
// a skipped stop is a customer who did not get their coffee, and until now the
// only record of one was a row in the global audit log.
templ RouteActivity(entries []domain.AuditEntry, loc *time.Location) {
	@ActivityTimeline(entries, routeEventLabel, routeEventMarker, loc)
}
