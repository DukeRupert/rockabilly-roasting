package admin

import (
	"fmt"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// RouteShowProps drives one delivery route's review page — the screen staff
// look at between planning a run and handing it to a driver.
type RouteShowProps struct {
	Route    domain.DeliveryRoute
	Stops    []domain.RouteStop
	Progress domain.RouteProgress
	// DriverURL is the token link the driver scans. Empty until activation —
	// a draft deliberately has no working URL.
	DriverURL string
	// Unroutable counts orders that were in the queue but could not be placed
	// on the map. They are not stops, so the page has to say so explicitly or
	// the route silently looks shorter than staff expected.
	Unroutable int
	// Activity is the run's audit history — planned, started, stops removed
	// or skipped, completed. Newest first.
	Activity   []domain.AuditEntry
	MerchantTZ *time.Location
	StaffName  string
	StaffRole  string
}

// routeStatusBadge maps route status onto the admin badge palette.
func routeStatusBadge(s domain.RouteStatus) string {
	switch s {
	case domain.RouteStatusActive:
		return "badge badge-green"
	case domain.RouteStatusCompleted:
		return "badge badge-grey"
	default:
		return "badge badge-amber"
	}
}

func routeStopStatusBadge(s domain.RouteStopStatus) string {
	switch s {
	case domain.RouteStopDelivered:
		return "badge badge-green"
	case domain.RouteStopSkipped:
		return "badge badge-slate"
	default:
		return "badge badge-neutral"
	}
}

// formatRouteDuration renders seconds as the driver would think about it:
// "1 hr 12 min", not 4320.
func formatRouteDuration(seconds int) string {
	if seconds <= 0 {
		return "—"
	}
	mins := (seconds + 30) / 60
	if mins < 60 {
		return fmt.Sprintf("%d min", mins)
	}
	h := mins / 60
	m := mins % 60
	if m == 0 {
		return fmt.Sprintf("%d hr", h)
	}
	return fmt.Sprintf("%d hr %d min", h, m)
}

// formatRouteDistance renders metres as miles — the unit on the van's dash.
func formatRouteDistance(meters int) string {
	if meters <= 0 {
		return "—"
	}
	miles := float64(meters) / 1609.344
	if miles < 10 {
		return fmt.Sprintf("%.1f mi", miles)
	}
	return fmt.Sprintf("%.0f mi", miles)
}

func formatRouteDate(t time.Time) string {
	return t.Format("Mon Jan 2, 2006")
}

// RouteShow is the full page.
templ RouteShow(props RouteShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Delivery route",
		ActivePath: "/admin/fulfillment",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@RouteShowContent(props)
	}
}

// RouteShowContent is the htmx-swappable body.
templ RouteShowContent(props RouteShowProps) {
	<div class="space-y-4">
		<header class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h1 class="admin-page-title text-rr-heading">Delivery route</h1>
				<p class="mt-1 text-sm text-rr-muted">
					{ formatRouteDate(props.Route.RouteDate) }
					<span class="mx-2 text-rr-border">|</span>
					<span class={ routeStatusBadge(props.Route.Status) }>{ string(props.Route.Status) }</span>
				</p>
				<!-- When the run actually started and finished. Both columns were
				     written from the day routes shipped and shown nowhere. -->
				if props.Route.ActivatedAt != nil || props.Route.CompletedAt != nil {
					<p class="mt-1 text-xs text-rr-muted">
						if props.Route.ActivatedAt != nil {
							Started { props.Route.ActivatedAt.In(props.MerchantTZ).Format("Jan 2, 3:04 PM") }
						}
						if props.Route.ActivatedAt != nil && props.Route.CompletedAt != nil {
							<span class="mx-1.5 text-rr-border">&middot;</span>
						}
						if props.Route.CompletedAt != nil {
							Finished { props.Route.CompletedAt.In(props.MerchantTZ).Format("Jan 2, 3:04 PM") }
						}
					</p>
				}
				<!-- Where the run finishes changes the stop order, so it is
				     stated on the page rather than left implicit: a route
				     planned to end at the driver's house looks wrong to anyone
				     who assumes it comes back to the shop. -->
				<p class="mt-1 text-xs text-rr-muted">
					if props.Route.EndsElsewhere() {
						Ends at <span class="text-rr-body">{ props.Route.EndAddress }</span> — the van does not return to the roastery.
					} else {
						Ends back at the roastery.
					}
				</p>
			</div>
			<div class="flex items-center gap-2">
				if props.Route.Status == domain.RouteStatusDraft {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/routes/%s/activate", props.Route.ID)) }>
						<button type="submit" class="inline-flex items-center rounded-sm bg-rr-red px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90">
							Activate &amp; get driver link
						</button>
					</form>
				}
				if props.Route.Status == domain.RouteStatusActive {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/routes/%s/complete", props.Route.ID)) }>
						<button type="submit" class="btn-secondary">End route</button>
					</form>
				}
			</div>
		</header>
		<!-- Summary strip: the three numbers staff check before committing a
		     run — how long it takes, how far it goes, how many stops. -->
		<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
			@routeStat("Stops", fmt.Sprintf("%d", len(props.Stops)))
			@routeStat("Drive time", formatRouteDuration(props.Route.TotalDurationSecs))
			@routeStat("Distance", formatRouteDistance(props.Route.TotalDistanceMeters))
			@routeStat("Delivered", fmt.Sprintf("%d of %d", props.Progress.Delivered, props.Progress.Total))
		</div>
		if props.Unroutable > 0 {
			<div class="border border-rr-border bg-rr-surface px-4 py-3">
				<p class="text-sm font-semibold text-rr-red">
					{ fmt.Sprintf("%d delivery order(s) could not be placed on the map", props.Unroutable) }
				</p>
				<p class="mt-1 text-xs text-rr-muted">
					They are not on this route and will not be delivered. Check the addresses on those
					orders, then plan again.
				</p>
			</div>
		}
		if props.DriverURL != "" {
			<!-- The QR is the handoff: the driver scans it off this screen (or a
			     printout) with their camera and the stop list is on their phone.
			     No typing a token, no app, no account. -->
			<div class="border border-rr-border bg-rr-surface px-4 py-3">
				<h2 class="text-xs uppercase tracking-wide text-rr-muted label-font">Driver handoff</h2>
				<div class="mt-2 flex flex-wrap items-start gap-4">
					<!-- Pure white is intentional here and is NOT a paper-purity bug: the
					     quiet zone around a QR code wants maximum contrast so a phone
					     camera locks on. Every other admin surface uses bg-rr-surface. -->
					<img
						src={ fmt.Sprintf("/admin/routes/%s/qr.png", props.Route.ID) }
						alt="QR code linking to the driver's stop list"
						width="180"
						height="180"
						class="border border-rr-border bg-white p-2"
					/>
					<div class="min-w-0 flex-1">
						<p class="text-sm text-rr-body">
							Have the driver scan this with their phone camera. It opens the stop
							list — no login needed.
						</p>
						<p class="mt-2 text-xs text-rr-muted break-all">{ props.DriverURL }</p>
						<p class="mt-2 text-xs text-rr-muted">
							The link stops working as soon as the route ends.
						</p>
						<button
							type="button"
							onclick="window.print()"
							class="btn-secondary mt-3"
						>
							Print
						</button>
					</div>
				</div>
			</div>
		}
		@routeStopsTable(props)
		@RouteActivity(props.Activity, props.MerchantTZ)
	</div>
}

// routeStat is one number in the summary strip.
templ routeStat(label, value string) {
	<div class="border border-rr-border bg-rr-surface px-3 py-2">
		<div class="text-xs uppercase tracking-wide text-rr-muted label-font">{ label }</div>
		<div class="mt-0.5 text-lg font-semibold text-rr-heading tabular-nums">{ value }</div>
	</div>
}

templ routeStopsTable(props RouteShowProps) {
	if len(props.Stops) == 0 {
		<div class="border border-rr-border bg-rr-surface px-6 py-10 text-center">
			<p class="text-sm text-rr-body">This route has no stops.</p>
			<p class="mt-1 text-xs text-rr-muted">Plan a route from the Load list tab of the fulfillment queue.</p>
		</div>
	} else {
		<div class="overflow-hidden border border-rr-border bg-rr-surface">
			<table class="min-w-full divide-y divide-rr-border">
				<thead>
					<tr class="bg-rr-raised">
						<th class="px-3 py-2 text-left text-xs uppercase tracking-wide text-rr-muted label-font">#</th>
						<th class="px-3 py-2 text-left text-xs uppercase tracking-wide text-rr-muted label-font">Stop</th>
						<th class="px-3 py-2 text-left text-xs uppercase tracking-wide text-rr-muted label-font">Channel</th>
						<th class="px-3 py-2 text-left text-xs uppercase tracking-wide text-rr-muted label-font">Status</th>
						if props.Route.Status == domain.RouteStatusDraft {
							<th class="px-3 py-2 text-right text-xs uppercase tracking-wide text-rr-muted label-font">Adjust</th>
						}
					</tr>
				</thead>
				<tbody class="divide-y divide-rr-border">
					for _, stop := range props.Stops {
						<tr>
							<td class="px-3 py-2 text-sm font-semibold text-rr-heading tabular-nums">{ fmt.Sprintf("%d", stop.Position) }</td>
							<td class="px-3 py-2 text-sm text-rr-body">
								<div class="font-semibold text-rr-heading">{ stop.CustomerName }</div>
								<div class="text-xs text-rr-muted">{ stop.Address }</div>
								if stop.Notes != "" {
									<div class="mt-1 text-xs text-rr-body">{ stop.Notes }</div>
								}
								if stop.SkipReason != "" {
									<div class="mt-1 text-xs text-rr-red">Skipped: { stop.SkipReason }</div>
								}
							</td>
							<td class="px-3 py-2 text-sm">
								if stop.Channel == domain.OrderChannelWholesale {
									<span class="badge badge-teal">wholesale</span>
								} else {
									<span class="badge badge-neutral">retail</span>
								}
							</td>
							<td class="px-3 py-2 text-sm">
								<span class={ routeStopStatusBadge(stop.Status) }>{ string(stop.Status) }</span>
							</td>
							if props.Route.Status == domain.RouteStatusDraft {
								<td class="px-3 py-2 text-right">
									<!-- Removing re-plans the remaining stops rather than
									     just deleting a row: dropping the middle of a route
									     changes the optimal order of what's left. -->
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/routes/%s/stops/%s/remove", props.Route.ID, stop.ID)) }>
										<button type="submit" class="btn-secondary">Remove &amp; re-plan</button>
									</form>
								</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// RouteListProps drives the recent-routes index.
type RouteListProps struct {
	Routes     []domain.DeliveryRoute
	MerchantTZ *time.Location
	StaffName  string
	StaffRole  string
}

templ RouteList(props RouteListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Delivery routes",
		ActivePath: "/admin/fulfillment",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@RouteListContent(props)
	}
}

templ RouteListContent(props RouteListProps) {
	<div class="space-y-4">
		<header>
			<h1 class="admin-page-title text-rr-heading">Delivery routes</h1>
			<p class="mt-1 text-sm text-rr-muted">Planned delivery runs, newest first.</p>
		</header>
		if len(props.Routes) == 0 {
			<div class="border border-rr-border bg-rr-surface px-6 py-10 text-center">
				<p class="text-sm text-rr-body">No routes planned yet.</p>
				<p class="mt-1 text-xs text-rr-muted">Plan one from the Load list tab of the fulfillment queue.</p>
			</div>
		} else {
			<div class="overflow-hidden border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead>
						<tr class="bg-rr-raised">
							<th class="px-3 py-2 text-left text-xs uppercase tracking-wide text-rr-muted label-font">Date</th>
							<th class="px-3 py-2 text-left text-xs uppercase tracking-wide text-rr-muted label-font">Status</th>
							<th class="px-3 py-2 text-left text-xs uppercase tracking-wide text-rr-muted label-font">Drive time</th>
							<th class="px-3 py-2 text-left text-xs uppercase tracking-wide text-rr-muted label-font">Distance</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border">
						for _, route := range props.Routes {
							<tr class="row-link cursor-pointer" hx-get={ fmt.Sprintf("/admin/routes/%s", route.ID) } hx-target="#main-content" hx-push-url="true">
								<td class="px-3 py-2 text-sm font-semibold text-rr-heading">{ formatRouteDate(route.RouteDate) }</td>
								<td class="px-3 py-2 text-sm"><span class={ routeStatusBadge(route.Status) }>{ string(route.Status) }</span></td>
								<td class="px-3 py-2 text-sm text-rr-body tabular-nums">{ formatRouteDuration(route.TotalDurationSecs) }</td>
								<td class="px-3 py-2 text-sm text-rr-body tabular-nums">{ formatRouteDistance(route.TotalDistanceMeters) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
