package admin

import "fmt"

// Section-level navigation that lives at the top of a content area, one step
// below the sidebar. The sidebar was flattened to seven primary destinations;
// the pages that used to be their own sidebar rows (categories, attributes,
// price lists, plans, wholesale orders/fulfillment) are now reached through
// these in-page strips. Two flavours:
//
//   adminSectionTabs  — underline tab bar for sibling *pages* in a section
//                       (Catalog: Products | Categories | Attributes | Pricing).
//   adminChannelToggle — segmented control for the *same* list scoped by sales
//                       channel (Orders, Fulfillment, Customers: Retail |
//                       Wholesale).
//
// Both render plain links (hx-boost on <body> upgrades them) so the active row
// is driven by the page's own URL, not client state — a hard refresh lands in
// the right place.

type sectionTab struct {
	Label string
	Href  string
	// Count marks a tab with work waiting behind it — misconfigured settings,
	// pending applications. Zero renders no badge: a "0" reads as a number to
	// check rather than as nothing to do (same rule as adminChannelToggleCount).
	Count int
}

// --- Tab data. One function per section so call sites stay a single line. ---

func catalogTabs() []sectionTab {
	return []sectionTab{
		{Label: "Products", Href: "/admin/catalog"},
		{Label: "Categories", Href: "/admin/categories"},
		{Label: "Attributes", Href: "/admin/attributes"},
		// Prices are catalog data. Price lists sat under Customers because they
		// are *assigned* to customers, but that is the rare action — staff edit
		// prices constantly and assign a list once, at onboarding.
		{Label: "Pricing", Href: "/admin/price-lists"},
	}
}

func customersTabs() []sectionTab {
	return []sectionTab{
		{Label: "Customers", Href: "/admin/customers"},
		// Two send consoles, not customer views. Reminders is the recurring
		// weekly wholesale nudge; Announcements is the one-off notice to any
		// audience. The labels say which is which because the difference is
		// what staff pick between.
		{Label: "Announcements", Href: "/admin/announcements"},
		{Label: "Order reminders", Href: "/admin/wholesale/reminders"},
	}
}

func subscriptionsTabs() []sectionTab {
	return []sectionTab{
		{Label: "Subscriptions", Href: "/admin/subscriptions"},
		{Label: "Plans", Href: "/admin/plans"},
	}
}

// 1px ink underline for the active tab — the active border overlaps the
// container's hairline (-mb-px) so it reads as one continuous indicator. Quiet
// by design: admin underlines in ink, not rust (rust stays for CTAs).
func sectionTabClass(active bool) string {
	if active {
		return "-mb-px border-b border-rr-heading px-1 pb-3 text-sm font-semibold text-rr-heading"
	}
	return "-mb-px border-b border-transparent px-1 pb-3 text-sm font-medium text-rr-muted hover:text-rr-heading"
}

// adminSectionTabs renders the underline tab bar. activeHref is the current
// page's own base path (e.g. "/admin/categories"); the matching tab is stamped.
templ adminSectionTabs(tabs []sectionTab, activeHref string) {
	@adminSectionTabsLabelled(tabs, activeHref, "Section")
}

// adminSectionTabsLabelled is the same strip under a caller-chosen landmark
// name. A page that draws two of these — the Service section strip and the due
// list's own scope strip — would otherwise stack two navs called "Section",
// which is two landmarks a screen-reader user cannot tell apart.
templ adminSectionTabsLabelled(tabs []sectionTab, activeHref, label string) {
	<nav class="mb-6 flex items-center gap-5 border-b border-rr-border" aria-label={ label }>
		for _, t := range tabs {
			<a href={ templ.SafeURL(t.Href) } aria-current={ ariaCurrent(t.Href == activeHref) } class={ sectionTabClass(t.Href == activeHref) }>
				{ t.Label }
				if t.Count > 0 {
					<span class="badge badge-amber ml-1.5">{ fmt.Sprintf("%d", t.Count) }</span>
				}
			</a>
		}
	</nav>
}

// Segmented control — the active channel is STAMPED IN INK (paper text on ink
// fill) so a view-wide context switch reads as obviously selected, not as the
// near-white-on-grey pill it used to be. Still no rust fill: a channel scope
// switch is chrome, not a CTA — rust stays reserved for actions. Inactive
// segments use body ink (not muted) so the unselected option is clearly the
// other half of a real switch.
func channelSegClass(active bool) string {
	if active {
		return "rounded-sm bg-rr-heading px-4 py-1.5 text-sm font-semibold text-rr-bg shadow-sm"
	}
	return "rounded-sm px-4 py-1.5 text-sm font-medium text-rr-body hover:bg-rr-surface hover:text-rr-heading"
}

// adminChannelToggle renders a two-up segmented control for retail/wholesale.
// activeHref is the current list's BasePath. The track carries a hairline ring
// so the control reads as a deliberate object on the paper, not a stray strip.
templ adminChannelToggle(retailHref, wholesaleHref, activeHref string) {
	<div class="mb-6 inline-flex items-center gap-1 rounded-sm bg-rr-raised p-1 ring-1 ring-rr-border" role="tablist" aria-label="Sales channel">
		<a href={ templ.SafeURL(retailHref) } role="tab" aria-selected={ boolAttr(retailHref == activeHref) } class={ channelSegClass(retailHref == activeHref) }>Retail</a>
		<a href={ templ.SafeURL(wholesaleHref) } role="tab" aria-selected={ boolAttr(wholesaleHref == activeHref) } class={ channelSegClass(wholesaleHref == activeHref) }>Wholesale</a>
	</div>
}

// adminChannelToggleCount is the two-up control with a count on the wholesale
// segment — used by the customers list, where pending applications are work
// waiting even when the staffer is looking at the retail side. Zero renders no
// badge: a "0" reads as a number to check rather than nothing to do.
templ adminChannelToggleCount(retailHref, wholesaleHref, activeHref string, wholesaleCount int) {
	<div class="mb-6 inline-flex items-center gap-1 rounded-sm bg-rr-raised p-1 ring-1 ring-rr-border" role="tablist" aria-label="Sales channel">
		<a href={ templ.SafeURL(retailHref) } role="tab" aria-selected={ boolAttr(retailHref == activeHref) } class={ channelSegClass(retailHref == activeHref) }>Retail</a>
		<a href={ templ.SafeURL(wholesaleHref) } role="tab" aria-selected={ boolAttr(wholesaleHref == activeHref) } class={ channelSegClass(wholesaleHref == activeHref) }>
			Wholesale
			if wholesaleCount > 0 {
				<span class="badge badge-amber ml-2">{ fmt.Sprintf("%d", wholesaleCount) }</span>
			}
		</a>
	</div>
}

// ariaCurrent marks the tab for the page being shown. "page" is specifically a
// claim about navigation, so it belongs on links that go somewhere else — the
// section tabs, and nothing that merely re-filters the page you are on.
func ariaCurrent(b bool) string {
	if b {
		return "page"
	}
	return "false"
}

// ariaCurrentOption marks the selected one of a set of filter controls.
//
// The generic "true" rather than "page": a cost window or a sort order is not a
// page, and telling a screen reader that switching from "90 days" to "12
// months" is a navigation event describes the wrong thing happening. Same
// visual treatment, different claim.
func ariaCurrentOption(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func boolAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
