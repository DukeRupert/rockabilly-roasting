package admin

import (
	"sort"
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/audit"
)

// The ticket timeline: what was said, merged with what happened.
//
// A ticket's story is half human — calls, emails, visits, working notes — and
// half machine: status moves and assignments out of the audit log. Rendering
// them as two lists would make staff interleave them by eye, which is the one
// thing the page exists to do for them.
//
// So notes are lifted into domain.AuditEntry and merged with the real entries
// before rendering, and the whole lot goes through the shared ActivityTimeline
// (docs/admin-detail-pages.md, rule 5). AuditEntry is doing duty here as the
// timeline's row type, not as an audit record: these synthesised values are
// built for display and never written anywhere. The fit is exact — timelineRow
// already renders Reason as the body paragraph under the label, which is what a
// note's text is.

// noteActionPrefix marks the synthesised entries. It is not a real audit action
// and must never be recorded as one; the ticket's genuine note event is
// audit.AuditServiceTicketNoteAdded, written by the service.
const noteActionPrefix = "service_note."

// ServiceTimelineEntries merges a ticket's notes with its audit history,
// newest first.
func ServiceTimelineEntries(notes []domain.ServiceTicketNote, entries []domain.AuditEntry, authorName func(domain.ServiceTicketNote) string) []domain.AuditEntry {
	merged := make([]domain.AuditEntry, 0, len(notes)+len(entries))

	for _, n := range notes {
		body := n.Body
		entry := domain.AuditEntry{
			ID:           n.ID,
			Action:       noteActionPrefix + string(n.Kind),
			ResourceType: "service_ticket",
			ResourceID:   n.TicketID,
			Reason:       &body,
			// OccurredAt, not CreatedAt: a call logged on Thursday belongs on
			// the timeline where it happened, on Tuesday.
			CreatedAt: n.OccurredAt,
			ActorName: authorName(n),
			ActorType: domain.AuditActorTypeStaff,
		}
		if n.CustomerUserID != nil {
			entry.ActorType = domain.AuditActorTypeCustomer
		} else if n.StaffID == nil {
			entry.ActorType = domain.AuditActorTypeSystem
		}
		merged = append(merged, entry)
	}

	merged = append(merged, entries...)

	sort.SliceStable(merged, func(i, j int) bool {
		return merged[i].CreatedAt.After(merged[j].CreatedAt)
	})
	return merged
}

func serviceTicketEventLabel(action string) string {
	if kind, ok := strings.CutPrefix(action, noteActionPrefix); ok {
		label := domain.ServiceNoteKind(kind).Label()
		// A customer-visible note and an internal one read identically here,
		// which is deliberate: the timeline is staff-facing, and the label says
		// what kind of contact it was, not who may see it.
		return label
	}
	switch action {
	case audit.AuditServiceTicketOpened:
		return "Ticket opened"
	case audit.AuditServiceTicketAssigned:
		return "Assigned"
	case audit.AuditServiceTicketStatus:
		return "Status changed"
	case audit.AuditServiceTicketResolved:
		return "Resolved"
	case audit.AuditServiceTicketReopened:
		return "Reopened"
	case audit.AuditServiceTicketCancelled:
		return "Cancelled"
	case audit.AuditServiceTicketNoteAdded:
		// The note itself is already on the timeline as its own entry; showing
		// the audit record of it too would double every line.
		return ""
	}
	parts := strings.SplitN(action, ".", 2)
	if len(parts) == 2 {
		verb := strings.ReplaceAll(parts[1], "_", " ")
		return strings.ToUpper(verb[:1]) + verb[1:]
	}
	return action
}

func serviceTicketEventMarker(action string) string {
	switch action {
	case noteActionPrefix + string(domain.ServiceNoteKindCustomerReport):
		return "bg-rr-red"
	case audit.AuditServiceTicketResolved:
		// Filled but neutral. Admin's marker vocabulary is red / amber /
		// raised / surface — there is no green token, and resolving is not an
		// event that should shout anyway.
		return "bg-rr-raised"
	case audit.AuditServiceTicketCancelled, audit.AuditServiceTicketReopened:
		return "bg-rr-amber"
	}
	if strings.HasPrefix(action, noteActionPrefix) {
		return "bg-rr-amber"
	}
	return "bg-rr-surface"
}

// dropDoubledNoteEvents removes the audit record that shadows a note already on
// the timeline. Without it every note appears twice — once as itself and once
// as "note added".
func dropDoubledNoteEvents(entries []domain.AuditEntry) []domain.AuditEntry {
	out := make([]domain.AuditEntry, 0, len(entries))
	for _, e := range entries {
		if e.Action == audit.AuditServiceTicketNoteAdded {
			continue
		}
		out = append(out, e)
	}
	return out
}

// ServiceTicketActivity is the merged timeline.
templ ServiceTicketActivity(entries []domain.AuditEntry, loc *time.Location) {
	@ActivityTimeline(dropDoubledNoteEvents(entries), serviceTicketEventLabel, serviceTicketEventMarker, loc)
}
