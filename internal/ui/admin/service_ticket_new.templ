package admin

import (
	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// Opening a ticket by hand — the phone rang, or a tech noticed something on a
// delivery. The customer's own route into this is the portal form in step 7.

// ServiceTicketFormValues is the raw form state, echoed back on rejection.
type ServiceTicketFormValues struct {
	CustomerID  string
	EquipmentID string
	Title       string
	Description string
	Severity    string
	AssignedTo  string
	Billable    string
}

// ServiceTicketNewProps is the state of the open-a-ticket form.
type ServiceTicketNewProps struct {
	Customers []EquipmentOption
	// Machines are the chosen customer's, and only theirs. Filing a ticket
	// against another cafe's machine is refused by the service; not offering it
	// is how the form avoids the argument.
	Machines  []EquipmentOption
	Staff     []StaffOption
	Values    ServiceTicketFormValues
	Error     string
	Nav       ServiceNav
	StaffName string
	StaffRole string
}

func (v ServiceTicketFormValues) billableChecked() bool { return v.Billable == "1" }

// severityOrDefault keeps the form on "routine" until told otherwise. Guessing
// that a hand-opened ticket is an emergency would train staff to ignore the
// severity badge.
func (v ServiceTicketFormValues) severityOrDefault() string {
	if v.Severity == "" {
		return string(domain.ServiceSeverityRoutine)
	}
	return v.Severity
}

templ ServiceTicketNewContent(props ServiceTicketNewProps) {
	@serviceSection(props.Nav, serviceTabTickets)
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Open a ticket</h1>
			<p class="mt-1 text-sm text-rr-muted">
				For the call that just came in, or something a tech spotted on a delivery.
			</p>
		</div>
	</div>
	if props.Error != "" {
		<div class="mt-4 border border-rr-border bg-rr-surface px-4 py-3">
			<p class="text-sm font-medium text-rr-red">{ props.Error }</p>
		</div>
	}
	<form method="post" action="/admin/service/tickets" class="mt-6 border border-rr-border bg-rr-surface p-6">
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-6">
			<div class="sm:col-span-3">
				<label for="customer_id" class="block text-sm font-medium text-rr-heading">Customer</label>
				<select
					id="customer_id"
					name="customer_id"
					required
					class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
					hx-get="/admin/service/tickets/machines"
					hx-target="#equipment-picker"
					hx-swap="outerHTML"
					hx-trigger="change"
				>
					<option value="">Choose a customer</option>
					for _, c := range props.Customers {
						<option value={ c.ID.String() } selected?={ props.Values.CustomerID == c.ID.String() }>{ c.Label }</option>
					}
				</select>
			</div>
			@ServiceTicketMachinePicker(props.Machines, props.Values.EquipmentID)
			<div class="sm:col-span-6">
				<label for="title" class="block text-sm font-medium text-rr-heading">What is wrong?</label>
				<input
					type="text"
					id="title"
					name="title"
					required
					value={ props.Values.Title }
					placeholder="Group head leaking between shots"
					class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
				/>
				<p class="mt-1 text-xs text-rr-muted">One line. This is the whole ticket as far as the queue is concerned.</p>
			</div>
			<div class="sm:col-span-6">
				<label for="description" class="block text-sm font-medium text-rr-heading">What did they say?</label>
				<textarea
					id="description"
					name="description"
					rows="3"
					class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
				>{ props.Values.Description }</textarea>
			</div>
			<div class="sm:col-span-2">
				<label for="severity" class="block text-sm font-medium text-rr-heading">How bad is it?</label>
				<select id="severity" name="severity" class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm">
					for _, sv := range domain.ServiceSeverities() {
						<option value={ string(sv) } selected?={ props.Values.severityOrDefault() == string(sv) }>{ sv.Label() }</option>
					}
				</select>
			</div>
			<div class="sm:col-span-2">
				<label for="assigned_staff_id" class="block text-sm font-medium text-rr-heading">Assign to</label>
				<select id="assigned_staff_id" name="assigned_staff_id" class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm">
					<option value="">Nobody yet</option>
					for _, st := range props.Staff {
						<option value={ st.ID.String() } selected?={ props.Values.AssignedTo == st.ID.String() }>{ st.Name }</option>
					}
				</select>
			</div>
			<div class="sm:col-span-2 flex items-end">
				<label class="flex items-center gap-2 text-sm text-rr-body">
					<input type="checkbox" name="billable" value="1" checked?={ props.Values.billableChecked() } class="rounded-sm border-rr-border"/>
					Billable
				</label>
			</div>
		</div>
		<div class="mt-6 flex items-center gap-3">
			<button type="submit" class="btn-confirm">Open ticket</button>
			<a href="/admin/service" class="text-sm text-rr-muted underline">Cancel</a>
		</div>
	</form>
}

// ServiceTicketMachinePicker is swapped in by htmx when the customer changes,
// so the machine list can never offer somebody else's equipment. Exported
// because the handler serves it as a standalone fragment.
templ ServiceTicketMachinePicker(machines []EquipmentOption, selected string) {
	<div class="sm:col-span-3" id="equipment-picker">
		<label for="equipment_id" class="block text-sm font-medium text-rr-heading">Which machine?</label>
		<select id="equipment_id" name="equipment_id" class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm">
			<option value="">Not about a specific machine</option>
			for _, m := range machines {
				<option value={ m.ID.String() } selected?={ selected == m.ID.String() }>{ m.Label }</option>
			}
		</select>
		if len(machines) == 0 {
			<p class="mt-1 text-xs text-rr-muted">No machines on the register for this customer yet.</p>
		}
	</div>
}

// MachineOptionsFrom turns a customer's register into picker options.
func MachineOptionsFrom(equipment []domain.Equipment) []EquipmentOption {
	out := make([]EquipmentOption, 0, len(equipment))
	for _, e := range equipment {
		out = append(out, EquipmentOption{ID: e.ID, Label: e.Description()})
	}
	return out
}

// StaffOptionsFrom turns the staff roster into assign options.
func StaffOptionsFrom(ids []uuid.UUID, names map[uuid.UUID]string) []StaffOption {
	out := make([]StaffOption, 0, len(ids))
	for _, id := range ids {
		out = append(out, StaffOption{ID: id, Name: names[id]})
	}
	return out
}

templ ServiceTicketNew(props ServiceTicketNewProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Open a ticket",
		ActivePath: "/admin/service",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@ServiceTicketNewContent(props)
	}
}
