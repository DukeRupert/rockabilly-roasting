package admin

import (
	"fmt"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
)

// Parts and hours on a ticket.
//
// Main column, not rail — docs/admin-detail-pages.md rule 2: a control that
// acts on a sub-record belongs next to that sub-record. These are tables with
// their own add forms and per-row buttons, and a 22rem rail cannot hold them
// without wrapping every line. The rail keeps the roll-up ("Cost so far"),
// which is the summary, and the summary is what a rail is for.
//
// The design doc guessed rail for both; this is the deviation and this is why.

// PartRow is one part line with its next move worked out.
type PartRow struct {
	Part domain.ServicePart
	// NextStatus is the single obvious advance — needed becomes ordered,
	// ordered becomes received, received becomes installed. One button per row
	// beats a four-option dropdown on a list that is usually two lines long.
	NextStatus domain.ServicePartStatus
}

// PartRowsFrom works out each line's next move.
func PartRowsFrom(parts []domain.ServicePart) []PartRow {
	rows := make([]PartRow, 0, len(parts))
	for _, p := range parts {
		rows = append(rows, PartRow{Part: p, NextStatus: nextPartStatus(p.Status)})
	}
	return rows
}

// nextPartStatus returns the status after this one, or empty at the end of the
// line. Installed is terminal: a part that is in the machine has nowhere to go.
func nextPartStatus(s domain.ServicePartStatus) domain.ServicePartStatus {
	switch s {
	case domain.ServicePartStatusNeeded:
		return domain.ServicePartStatusOrdered
	case domain.ServicePartStatusOrdered:
		return domain.ServicePartStatusReceived
	case domain.ServicePartStatusReceived:
		return domain.ServicePartStatusInstalled
	}
	return ""
}

func partStatusBadge(s domain.ServicePartStatus) string {
	switch s {
	case domain.ServicePartStatusNeeded:
		return "badge badge-amber"
	case domain.ServicePartStatusOrdered:
		return "badge badge-blue"
	case domain.ServicePartStatusReceived:
		return "badge badge-teal"
	case domain.ServicePartStatusInstalled:
		return "badge badge-green"
	}
	return "badge badge-neutral"
}

// partAdvanceLabel is the verb on the row's button — what you are recording,
// not what state it will land in.
func partAdvanceLabel(s domain.ServicePartStatus) string {
	switch s {
	case domain.ServicePartStatusOrdered:
		return "Ordered it"
	case domain.ServicePartStatusReceived:
		return "It arrived"
	case domain.ServicePartStatusInstalled:
		return "Fitted it"
	}
	return ""
}

// partDatesLine is the ordered → received → fitted trail. This is the "what was
// ordered and replaced, and when" the whole feature was asked for, so the dates
// are shown even when only one of them is filled in.
// loc is unused — these are calendar dates, see dayLabel. Kept for symmetry
// with the other line builders on this page.
func partDatesLine(p domain.ServicePart, _ *time.Location) string {
	var out string
	add := func(label string, t *time.Time) {
		if t == nil {
			return
		}
		if out != "" {
			out += " · "
		}
		out += label + " " + dayLabel(t)
	}
	add("ordered", p.OrderedOn)
	add("arrived", p.ReceivedOn)
	add("fitted", p.InstalledOn)
	return out
}

func partSourceLine(p domain.ServicePart) string {
	switch {
	case p.PartNumber != "" && p.Supplier != "":
		return p.PartNumber + " · " + p.Supplier
	case p.PartNumber != "":
		return p.PartNumber
	case p.Supplier != "":
		return p.Supplier
	}
	return ""
}

func partRemoveConfirm(p domain.ServicePart) ActionConfirm {
	return ActionConfirm{
		Title: "Remove " + p.Name + " from this ticket?",
		Lead:  "For a line that was typed in by mistake.",
		Points: []string{
			"A part that really was ordered and then cancelled is worth keeping — leave it and say so in a note instead.",
			"Removing it changes what this repair appears to have cost.",
		},
		Confirm: "Remove the line",
		Danger:  true,
	}
}

templ serviceTicketParts(props ServiceTicketShowProps) {
	<div class="mt-4 border border-rr-border bg-rr-surface">
		<div class="px-4 py-4">
			<div class="flex items-center justify-between">
				<h2 class="text-sm font-semibold text-rr-heading">Parts</h2>
				if props.Totals.PartsCostCents > 0 {
					<span class="text-sm text-rr-muted">{ formatCents(props.Totals.PartsCostCents) }</span>
				}
			</div>
			if len(props.Parts) == 0 {
				<p class="mt-2 text-sm text-rr-muted">No parts on this ticket.</p>
			} else {
				<ul role="list" class="mt-3 divide-y divide-rr-border">
					for _, row := range props.Parts {
						<li class="py-3 first:pt-0">
							<div class="flex flex-wrap items-start justify-between gap-2">
								<div class="min-w-0">
									<div class="flex flex-wrap items-center gap-1.5">
										<span class="text-sm font-medium text-rr-heading">
											{ fmt.Sprintf("%d × %s", row.Part.Quantity, row.Part.Name) }
										</span>
										<span class={ partStatusBadge(row.Part.Status) }>{ row.Part.Status.Label() }</span>
									</div>
									if line := partSourceLine(row.Part); line != "" {
										<div class="font-mono text-xs text-rr-muted">{ line }</div>
									}
									if dates := partDatesLine(row.Part, props.MerchantTZ); dates != "" {
										<div class="text-xs text-rr-muted">{ dates }</div>
									}
								</div>
								<div class="flex shrink-0 items-center gap-2">
									<span class="text-sm text-rr-body">{ formatCents(row.Part.TotalCostCents()) }</span>
									if props.CanWrite {
										if row.NextStatus != "" {
											<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/parts/" + row.Part.ID.String() + "/status") }>
												<input type="hidden" name="status" value={ string(row.NextStatus) }/>
												<button type="submit" class="btn-secondary whitespace-nowrap">{ partAdvanceLabel(row.NextStatus) }</button>
											</form>
										}
										<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/parts/" + row.Part.ID.String() + "/delete") }>
											<button type="submit" class="btn-danger" { ConfirmAttrs(partRemoveConfirm(row.Part))... }>Remove</button>
										</form>
									}
								</div>
							</div>
						</li>
					}
				</ul>
			}
			if props.CanWrite {
				<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/parts") } class="mt-4 border-t border-rr-border pt-4">
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-6">
						<div class="sm:col-span-3">
							<label for="part-name" class="label-font block text-rr-muted">Part</label>
							<input
								type="text"
								id="part-name"
								name="name"
								required
								placeholder="Group head gasket"
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							/>
						</div>
						<div class="sm:col-span-3">
							<label for="part-number" class="label-font block text-rr-muted">Part number</label>
							<input
								type="text"
								id="part-number"
								name="part_number"
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							/>
						</div>
						<div class="sm:col-span-2">
							<label for="part-supplier" class="label-font block text-rr-muted">Supplier</label>
							<input
								type="text"
								id="part-supplier"
								name="supplier"
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							/>
						</div>
						<div class="sm:col-span-1">
							<label for="part-quantity" class="label-font block text-rr-muted">Qty</label>
							<input
								type="number"
								id="part-quantity"
								name="quantity"
								min="1"
								value="1"
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							/>
						</div>
						<div class="sm:col-span-2">
							<label for="part-cost" class="label-font block text-rr-muted">Each</label>
							<input
								type="text"
								id="part-cost"
								name="unit_cost"
								inputmode="decimal"
								placeholder="4.25"
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							/>
						</div>
						<div class="sm:col-span-1 flex items-end">
							<button type="submit" class="btn-confirm w-full">Add</button>
						</div>
					</div>
				</form>
			}
		</div>
	</div>
}

func timeEntryRemoveConfirm(e domain.ServiceTimeEntry) ActionConfirm {
	return ActionConfirm{
		Title:   "Remove " + formatMinutes(e.Minutes) + " from this ticket?",
		Lead:    "For a mistyped entry. There is no edit — retype it after removing.",
		Confirm: "Remove it",
		Danger:  true,
	}
}

// TimeEntryRow is one logged stint with the name of whoever did it.
type TimeEntryRow struct {
	Entry     domain.ServiceTimeEntry
	StaffName string
}

// timeEntryCostLine says what the hour was booked at, and what it therefore
// cost. An unpriced hour says so plainly rather than showing $0.00, which would
// read as free rather than as undecided.
func timeEntryCostLine(e domain.ServiceTimeEntry) string {
	if !e.Costed() {
		return "not priced"
	}
	return formatCents(*e.RateCents) + "/h · " + formatCents(e.CostCents())
}

// timeEntryRepriceForm is the deliberate counterpart to the rate snapshot.
//
// Rates no longer cascade backwards, so an hour logged before the shop had a
// rate — or at one since decided wrong — needs a way to be corrected. One row
// at a time, by hand, and audited: that is the difference between a correction
// and a settings change quietly rewriting history. Blank returns it to
// unpriced, which takes it out of the money without touching the hours.
templ timeEntryRepriceForm(props ServiceTicketShowProps, e domain.ServiceTimeEntry) {
	<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/time/" + e.ID.String() + "/rate") } class="flex items-end gap-1.5">
		<div>
			<label for={ "rate-" + e.ID.String() } class="label-font block text-rr-muted">Rate/h</label>
			<div class="mt-1 flex items-center gap-1">
				<span class="text-sm text-rr-muted">$</span>
				<input
					type="text"
					id={ "rate-" + e.ID.String() }
					name="rate"
					value={ timeEntryRateInput(e) }
					inputmode="decimal"
					placeholder="65.00"
					class="w-20 rounded-sm border border-rr-border bg-rr-surface px-2 py-1.5 text-sm"
				/>
			</div>
		</div>
		<button type="submit" class="btn-secondary">Price it</button>
	</form>
}

// timeEntryRateInput renders the stored rate for the form, blank when unpriced.
// Blank and "0.00" stay distinct: one is undecided, the other is a decision to
// charge nothing for the hour.
func timeEntryRateInput(e domain.ServiceTimeEntry) string {
	if !e.Costed() {
		return ""
	}
	return fmt.Sprintf("%d.%02d", *e.RateCents/100, *e.RateCents%100)
}

templ serviceTicketTime(props ServiceTicketShowProps) {
	<div class="mt-4 border border-rr-border bg-rr-surface">
		<div class="px-4 py-4">
			<div class="flex items-center justify-between">
				<h2 class="text-sm font-semibold text-rr-heading">Hours</h2>
				if props.Totals.TotalMinutes() > 0 {
					<span class="text-sm text-rr-muted">{ props.hoursLine() }</span>
				}
			</div>
			if len(props.TimeEntries) == 0 {
				<p class="mt-2 text-sm text-rr-muted">No time logged on this ticket.</p>
			} else {
				<ul role="list" class="mt-3 divide-y divide-rr-border">
					for _, row := range props.TimeEntries {
						<li class="flex flex-wrap items-start justify-between gap-2 py-3 first:pt-0">
							<div class="min-w-0">
								<div class="flex flex-wrap items-center gap-1.5">
									<span class="text-sm font-medium text-rr-heading">{ formatMinutes(row.Entry.Minutes) }</span>
									<span class="text-sm text-rr-muted">{ row.Entry.Kind.Label() }</span>
									if row.Entry.Billable {
										<span class="badge badge-teal">Billable</span>
									}
								</div>
								<div class="text-xs text-rr-muted">
									{ row.StaffName } · { dayLabel(&row.Entry.PerformedOn) } · { timeEntryCostLine(row.Entry) }
								</div>
								if row.Entry.Note != "" {
									<p class="mt-0.5 text-sm text-rr-body">{ row.Entry.Note }</p>
								}
							</div>
							if props.CanWrite {
								<div class="flex shrink-0 flex-wrap items-end gap-2">
									@timeEntryRepriceForm(props, row.Entry)
									<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/time/" + row.Entry.ID.String() + "/delete") }>
										<button type="submit" class="btn-danger" { ConfirmAttrs(timeEntryRemoveConfirm(row.Entry))... }>Remove</button>
									</form>
								</div>
							}
						</li>
					}
				</ul>
			}
			if props.CanWrite {
				<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/time") } class="mt-4 border-t border-rr-border pt-4">
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-6">
						<div class="sm:col-span-1">
							<label for="time-minutes" class="label-font block text-rr-muted">Minutes</label>
							<input
								type="number"
								id="time-minutes"
								name="minutes"
								min="1"
								required
								placeholder="90"
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							/>
						</div>
						<div class="sm:col-span-1">
							<label for="time-kind" class="label-font block text-rr-muted">Kind</label>
							<select id="time-kind" name="kind" class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm">
								<option value="labor">Labour</option>
								<option value="travel">Travel</option>
							</select>
						</div>
						<div class="sm:col-span-2">
							<label for="time-staff" class="label-font block text-rr-muted">Who</label>
							<select id="time-staff" name="staff_id" class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm">
								for _, st := range props.Staff {
									<option value={ st.ID.String() } selected?={ props.CurrentStaffID != nil && *props.CurrentStaffID == st.ID }>{ st.Name }</option>
								}
							</select>
						</div>
						<div class="sm:col-span-2">
							<label for="time-on" class="label-font block text-rr-muted">Day</label>
							<input
								type="date"
								id="time-on"
								name="performed_on"
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							/>
						</div>
						<div class="sm:col-span-4">
							<label for="time-note" class="label-font block text-rr-muted">What was done</label>
							<input
								type="text"
								id="time-note"
								name="note"
								placeholder="Stripped and reseated the group"
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							/>
						</div>
						<div class="sm:col-span-1 flex items-end">
							<label class="flex items-center gap-2 pb-2 text-sm text-rr-body">
								<input type="checkbox" name="billable" value="1" class="rounded-sm border-rr-border"/>
								Bill it
							</label>
						</div>
						<div class="sm:col-span-1 flex items-end">
							<button type="submit" class="btn-confirm w-full">Log</button>
						</div>
					</div>
				</form>
			}
		</div>
	</div>
}
