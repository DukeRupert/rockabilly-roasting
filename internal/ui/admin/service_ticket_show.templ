package admin

import (
	"fmt"
	"time"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// One ticket. Structure per docs/admin-detail-pages.md: every status axis in
// the header, the conversation in the main column, the things you can do about
// it in the rail.
//
// The note composer sits at the top of the timeline rather than the bottom,
// because the most common reason to open a ticket is to record that you just
// rang somebody — and it is the control that moves the last-contact clock, so
// it should be the first thing in reach.

// StaffOption is a staff member the assign control can point at.
type StaffOption struct {
	ID   uuid.UUID
	Name string
}

// ServiceTicketShowProps is the detail page's state.
type ServiceTicketShowProps struct {
	Ticket       domain.ServiceTicket
	CustomerName string
	MachineName  string
	MachineID    *uuid.UUID
	SiteLabel    string
	AssigneeName string
	Staff        []StaffOption
	// Timeline is notes and audit entries already merged — see
	// ServiceTimelineEntries.
	Timeline []domain.AuditEntry
	// Parts and TimeEntries are the sub-records; Totals is their roll-up,
	// summed in the database rather than over these lists.
	Parts       []PartRow
	TimeEntries []TimeEntryRow
	Totals      domain.ServiceTotals
	// CurrentStaffID preselects whoever is logged in on the "who did the work"
	// picker. A manager writing up the van crew can change it; the tech logging
	// their own stint should not have to.
	CurrentStaffID *uuid.UUID
	Stale      bool
	MerchantTZ *time.Location
	StaffName  string
	StaffRole  string
	CanWrite   bool
	Flash      Flash
}

func (p ServiceTicketShowProps) machineLabel() string {
	if p.MachineName == "" {
		return "No machine named"
	}
	return p.MachineName
}

func (p ServiceTicketShowProps) siteLine() string {
	if p.SiteLabel == "" {
		return "No site recorded"
	}
	return p.SiteLabel
}

func (p ServiceTicketShowProps) assigneeLabel() string {
	if p.AssigneeName == "" {
		return "Nobody"
	}
	return p.AssigneeName
}

// contactSentence is the banner line. It is written as a fact about the
// customer, not about the record — "nobody has told them anything for nine
// days" is what makes somebody pick up the phone.
func (p ServiceTicketShowProps) contactSentence() string {
	return fmt.Sprintf("Last spoke to %s %s.", p.CustomerName, timelineRelative(p.Ticket.LastContactAt))
}

func (p ServiceTicketShowProps) hoursLine() string {
	if p.Totals.TotalMinutes() == 0 {
		return "No time logged yet."
	}
	return fmt.Sprintf("%s logged · %s billable",
		formatMinutes(p.Totals.TotalMinutes()), formatMinutes(p.Totals.BillableMinutes))
}

// formatMinutes renders a duration the way a tech would say it.
func formatMinutes(m int) string {
	if m < 60 {
		return fmt.Sprintf("%dm", m)
	}
	if m%60 == 0 {
		return fmt.Sprintf("%dh", m/60)
	}
	return fmt.Sprintf("%dh %dm", m/60, m%60)
}

// nextStatuses are the moves offered from where the ticket is now.
//
// Resolved and cancelled are not here — they live in their own cards below, so
// a terminal move is never one click away from a routine one.
func nextStatuses(current domain.ServiceTicketStatus) []domain.ServiceTicketStatus {
	var out []domain.ServiceTicketStatus
	for _, s := range domain.ServiceTicketStatuses() {
		if s == current || !s.Open() {
			continue
		}
		out = append(out, s)
	}
	return out
}

// ticketActionReason explains an empty action area — rule 4 in
// docs/admin-detail-pages.md.
func (p ServiceTicketShowProps) ticketActionReason() string {
	if !p.CanWrite {
		return "You have read-only access to service records."
	}
	if !p.Ticket.Status.Open() {
		return "This ticket is " + p.Ticket.Status.Label() + ". Reopen it to carry on working."
	}
	return ""
}

func ticketResolveConfirm(t domain.ServiceTicket) ActionConfirm {
	return ActionConfirm{
		Title:   "Mark " + t.Number + " resolved?",
		Lead:    "It leaves the open queue and stops being counted as gone quiet.",
		Points:  []string{"You can reopen it if the fault comes back."},
		Confirm: "Mark resolved",
	}
}

func ticketCancelConfirm(t domain.ServiceTicket) ActionConfirm {
	return ActionConfirm{
		Title: "Cancel " + t.Number + "?",
		Lead:  "For a ticket that should never have been opened — a duplicate, or a fault that turned out to be nothing.",
		Points: []string{
			"Nothing is deleted; the ticket and its history stay readable.",
			"If the work was actually done, mark it resolved instead — that is what the reports count.",
		},
		Confirm: "Cancel the ticket",
		Danger:  true,
	}
}

templ ServiceTicketShowContent(props ServiceTicketShowProps) {
	@ConfirmDialogHost()
	<!-- Header -->
	<div class="sm:flex sm:items-start sm:justify-between">
		<div class="min-w-0">
			<a href="/admin/service" class="text-sm text-rr-muted underline">&larr; Service</a>
			<h1 class="admin-page-title mt-1">{ props.Ticket.Title }</h1>
			<div class="mt-2 flex flex-wrap items-center gap-2">
				<span class="font-mono text-xs text-rr-muted">{ props.Ticket.Number }</span>
				<span class={ serviceStatusBadge(props.Ticket.Status) }>{ props.Ticket.Status.Label() }</span>
				<span class={ templ.KV("badge badge-red", props.Ticket.Severity == domain.ServiceSeverityDown), templ.KV("badge badge-amber", props.Ticket.Severity == domain.ServiceSeverityDegraded), templ.KV("badge badge-neutral", props.Ticket.Severity == domain.ServiceSeverityRoutine) }>
					{ props.Ticket.Severity.Label() }
				</span>
				if props.Ticket.Billable {
					<span class="badge badge-teal">Billable</span>
				}
			</div>
		</div>
	</div>
	@adminFlash(props.Flash)
	<!-- Banner: the one thing worth interrupting for -->
	if props.Stale {
		<div class="mt-4 border border-rr-border bg-rr-surface px-4 py-3 row-link-stale">
			<p class="text-sm font-medium text-rr-red">This ticket has gone quiet.</p>
			<p class="mt-0.5 text-sm text-rr-body">{ props.contactSentence() } Log a call or send them an update.</p>
		</div>
	}
	<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
		<!-- Main column: what is wrong, and the conversation about it -->
		<div class="min-w-0">
			if props.Ticket.Description != "" {
				<div class="border border-rr-border bg-rr-surface">
					<div class="px-4 py-4">
						<h2 class="text-sm font-semibold text-rr-heading">What was reported</h2>
						<p class="mt-2 text-sm whitespace-pre-line text-rr-body">{ props.Ticket.Description }</p>
					</div>
				</div>
			}
			if props.Ticket.Resolution != "" {
				<div class="mt-4 border border-rr-border bg-rr-surface">
					<div class="px-4 py-4">
						<h2 class="text-sm font-semibold text-rr-heading">How it was fixed</h2>
						<p class="mt-2 text-sm whitespace-pre-line text-rr-body">{ props.Ticket.Resolution }</p>
					</div>
				</div>
			}
			@serviceTicketParts(props)
			@serviceTicketTime(props)
			if props.CanWrite {
				@serviceNoteComposer(props)
			}
			@ServiceTicketActivity(props.Timeline, props.MerchantTZ)
		</div>
		<!-- Rail -->
		<div class="space-y-4 lg:sticky lg:top-6 lg:self-start">
			<div class="border border-rr-border bg-rr-surface">
				<div class="px-4 py-4">
					<h2 class="text-sm font-semibold text-rr-heading">Next action</h2>
					if reason := props.ticketActionReason(); reason != "" {
						<p class="mt-2 text-sm text-rr-muted">{ reason }</p>
						if props.CanWrite && !props.Ticket.Status.Open() {
							<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/status") } class="mt-3">
								<input type="hidden" name="status" value="in_progress"/>
								<button type="submit" class="btn-secondary w-full">Reopen</button>
							</form>
						}
					} else {
						<div class="mt-2 space-y-2">
							for _, st := range nextStatuses(props.Ticket.Status) {
								<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/status") }>
									<input type="hidden" name="status" value={ string(st) }/>
									<button type="submit" class="btn-secondary w-full">{ st.Label() }</button>
								</form>
							}
						</div>
					}
				</div>
			</div>
			<div class="border border-rr-border bg-rr-surface">
				<div class="px-4 py-4">
					<h2 class="text-sm font-semibold text-rr-heading">Assigned to</h2>
					if props.CanWrite {
						<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/assign") } class="mt-2 flex items-center gap-2">
							<select name="staff_id" class="w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm">
								<option value="">Nobody</option>
								for _, st := range props.Staff {
									<option
										value={ st.ID.String() }
										selected?={ props.Ticket.AssignedStaffID != nil && *props.Ticket.AssignedStaffID == st.ID }
									>{ st.Name }</option>
								}
							</select>
							<button type="submit" class="btn-secondary whitespace-nowrap">Set</button>
						</form>
					} else {
						<p class="mt-2 text-sm text-rr-body">{ props.assigneeLabel() }</p>
					}
				</div>
			</div>
			<div class="border border-rr-border bg-rr-surface">
				<div class="px-4 py-4">
					<h2 class="text-sm font-semibold text-rr-heading">The machine</h2>
					if props.MachineID != nil {
						<a href={ templ.SafeURL("/admin/service/equipment/" + props.MachineID.String()) } class="mt-2 inline-block text-sm font-medium text-rr-heading underline">
							{ props.machineLabel() }
						</a>
					} else {
						<p class="mt-2 text-sm text-rr-muted">{ props.machineLabel() }</p>
					}
					<p class="mt-2 text-sm text-rr-body">{ props.CustomerName }</p>
					<p class="mt-0.5 text-sm text-rr-muted">{ props.siteLine() }</p>
					<a href={ templ.SafeURL("/admin/customers/" + props.Ticket.CustomerID.String()) } class="mt-2 inline-block text-sm font-medium text-rr-heading underline">
						Open the customer
					</a>
				</div>
			</div>
			<div class="border border-rr-border bg-rr-surface">
				<div class="px-4 py-4">
					<h2 class="text-sm font-semibold text-rr-heading">Cost so far</h2>
					<p class="mt-2 text-sm text-rr-body">{ props.hoursLine() }</p>
					<p class="mt-0.5 text-sm text-rr-muted">Parts: { formatCents(props.Totals.PartsCostCents) }</p>
				</div>
			</div>
			if props.CanWrite && props.Ticket.Status.Open() {
				<div class="border border-rr-border bg-rr-surface">
					<div class="px-4 py-4">
						<h2 class="text-sm font-semibold text-rr-heading">Finish it</h2>
						<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/status") } class="mt-2">
							<input type="hidden" name="status" value="resolved"/>
							<label for="resolution" class="label-font block text-rr-muted">What fixed it?</label>
							<textarea
								id="resolution"
								name="resolution"
								rows="2"
								placeholder="New group head gasket"
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							></textarea>
							<button type="submit" class="btn-confirm mt-2 w-full" { ConfirmAttrs(ticketResolveConfirm(props.Ticket))... }>
								Mark resolved
							</button>
						</form>
					</div>
				</div>
				<div class="border border-rr-border bg-rr-surface">
					<div class="px-4 py-4">
						<h2 class="text-sm font-semibold text-rr-red">Danger zone</h2>
						<p class="mt-1 text-sm text-rr-muted">Cancelling is for a ticket that should never have existed. Work that actually happened should be resolved instead.</p>
						<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/status") } class="mt-3">
							<input type="hidden" name="status" value="cancelled"/>
							<button type="submit" class="btn-danger w-full" { ConfirmAttrs(ticketCancelConfirm(props.Ticket))... }>
								Cancel this ticket
							</button>
						</form>
					</div>
				</div>
			}
		</div>
	</div>
}

// serviceNoteComposer is the control that moves the last-contact clock.
//
// The kind picker is not decoration: a call, an email or a visit counts as
// having spoken to the customer and resets the staleness flag; an internal note
// deliberately does not. The helper text says so, because a staffer who logs
// everything as "Note" would silently keep the ticket looking neglected.
templ serviceNoteComposer(props ServiceTicketShowProps) {
	<div class="mt-4 border border-rr-border bg-rr-surface">
		<form method="post" action={ templ.SafeURL("/admin/service/tickets/" + props.Ticket.ID.String() + "/notes") } class="px-4 py-4">
			<h2 class="text-sm font-semibold text-rr-heading">Add to the timeline</h2>
			<textarea
				id="note-body"
				name="body"
				rows="3"
				required
				placeholder="Rang Dana — part ships Thursday, fitting it Friday morning."
				class="mt-2 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
			></textarea>
			<div class="mt-2 flex flex-wrap items-end gap-3">
				<div>
					<label for="note-kind" class="label-font block text-rr-muted">What was it?</label>
					<select id="note-kind" name="kind" class="mt-1 rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm">
						<option value="call">Call</option>
						<option value="email">Email</option>
						<option value="visit">Visit</option>
						<option value="note">Internal note</option>
					</select>
				</div>
				<div>
					<label for="note-occurred" class="label-font block text-rr-muted">When</label>
					<input
						type="date"
						id="note-occurred"
						name="occurred_on"
						class="mt-1 rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
					/>
				</div>
				<label class="flex items-center gap-2 text-sm text-rr-body">
					<input type="checkbox" name="customer_visible" value="1" class="rounded-sm border-rr-border"/>
					Show to the customer
				</label>
				<button type="submit" class="btn-confirm">Save</button>
			</div>
			<p class="mt-2 text-xs text-rr-muted">
				A call, email or visit counts as having spoken to them and clears the quiet flag. An internal note does not — it is a note to yourself.
			</p>
		</form>
	</div>
}

templ ServiceTicketShow(props ServiceTicketShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      props.Ticket.Number,
		ActivePath: "/admin/service",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@ServiceTicketShowContent(props)
	}
}
