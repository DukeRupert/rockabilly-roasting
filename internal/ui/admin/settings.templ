package admin

import (
	"fmt"
	"strconv"
	"strings"
	"time"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// The Settings section, one page per concern — see settings_nav.templ for the
// tab strip and the attention list that tie them together.

// QBConnectionStatus holds the QuickBooks connection state for the settings page.
type QBConnectionStatus struct {
	Connected        bool
	CompanyName      string // realm display name (if known)
	RealmID          string
	RefreshExpiresAt *time.Time
	LastSyncedAt     *time.Time
	// Unavailable means the status read itself failed — not that QuickBooks is
	// disconnected. The two are indistinguishable in a zero value, and telling
	// staff their invoicing integration is down because one query timed out is
	// worse than saying nothing: they go and reconnect a connection that was
	// fine, which costs a real Intuit round trip and a new token.
	Unavailable bool
}

// ShippingSettings holds the editable shipping configuration shown on the
// Settings page.
type ShippingSettings struct {
	FlatRateCents           int
	FreeShippingThreshold   *int
	Currency                string
	LocalZipCodes           []string
	LocalDeliveryEnabled    bool
	LocalPickupEnabled      bool
	LocalPickupInstructions string
	// LocalDeliveryWeekdays are the days the van runs, and LocalDeliveryCutoff
	// the order-by time as an <input type="time"> value ("09:00"). Together
	// they drive the delivery date quoted at checkout and in the confirmation
	// email — this is a live scheduling rule, not display copy.
	LocalDeliveryWeekdays []time.Weekday
	LocalDeliveryCutoff   string
	OriginName            string
	OriginStreet1         string
	OriginStreet2         string
	OriginCity            string
	OriginState           string
	OriginZip             string
	OriginCountry         string
	OriginEmail           string
	OriginPhone           string
	TareWeightOz          float64
	// Draft marks these values as coming back from a rejected save, and the
	// raw *Input strings below as the ones to render.
	//
	// It exists because "" is two different answers. Without the flag the
	// helpers infer "no draft" from an empty input string, which makes a field
	// the staffer deliberately *cleared* indistinguishable from one that was
	// never submitted — so clearing the threshold to turn it off, then tripping
	// validation elsewhere, silently put the old number back in the box. The
	// flag says which question is being asked.
	Draft bool
	// FlatRateInput, ThresholdInput and TareInput are the raw strings the
	// staffer typed, kept verbatim so the form can hand back exactly what was
	// submitted rather than a coerced version of it — losing twenty other
	// edited fields because one number was mistyped is the worst thing a
	// settings form can do. Meaningful only when Draft is set.
	FlatRateInput  string
	ThresholdInput string
	TareInput      string
}

// flatRateValue and friends render the rejected input when there is one and the
// stored value otherwise. On a draft the input is returned verbatim, empty
// included: a field the staffer cleared has to come back cleared, or the form
// argues with them about an edit they just made.
func (s ShippingSettings) flatRateValue() string {
	if s.Draft {
		return s.FlatRateInput
	}
	return centsToDollars(s.FlatRateCents)
}

func (s ShippingSettings) thresholdValue() string {
	if s.Draft {
		return s.ThresholdInput
	}
	return centsPtrToDollars(s.FreeShippingThreshold)
}

func (s ShippingSettings) tareValue() string {
	if s.Draft {
		return s.TareInput
	}
	return formatTareOz(s.TareWeightOz)
}

// formatTareOz renders the tare weight as a number input value. Trailing
// zeros are kept (so 0 → "0.00") for consistency with the dollar inputs.
func formatTareOz(oz float64) string {
	return fmt.Sprintf("%.2f", oz)
}

// weekdayOrder lists the week Sunday-first for the delivery-day checkboxes, so
// the row reads in calendar order however the days were stored.
func weekdayOrder() []time.Weekday {
	return []time.Weekday{
		time.Sunday, time.Monday, time.Tuesday, time.Wednesday,
		time.Thursday, time.Friday, time.Saturday,
	}
}

// weekdayValue renders a weekday as its Go numeric form for the checkbox value.
// The handler parses it back with the same numbering.
func weekdayValue(d time.Weekday) string {
	return strconv.Itoa(int(d))
}

// hasWeekday reports whether a day is in the configured delivery schedule.
func hasWeekday(days []time.Weekday, day time.Weekday) bool {
	for _, d := range days {
		if d == day {
			return true
		}
	}
	return false
}

// deliveryScheduleSummary echoes the saved schedule back in the exact wording
// customers see, so staff can confirm the rule reads the way they meant without
// opening a storefront tab. Takes the saved config — never the draft from a
// rejected save, which describes a schedule nobody is being offered.
func deliveryScheduleSummary(s ShippingSettings) string {
	cfg := domain.ShippingConfig{LocalDeliveryWeekdays: s.LocalDeliveryWeekdays}
	label := cfg.DeliveryDaysLabel()
	if label == "" {
		return ""
	}
	if s.LocalDeliveryCutoff == "" {
		return "Out for delivery on " + label + "."
	}
	return "Out for delivery on " + label + ", order by " + s.LocalDeliveryCutoff + "."
}

// shippingRuleSummary states the saved rate rule as a customer meets it at
// checkout. Two numbers in two boxes do not add up to a policy in anyone's
// head; the sentence they combine into does, and reading it back is how a
// staffer catches a threshold typed in cents. Takes the saved config — never
// the draft from a rejected save, which states a policy that is not in force.
func shippingRuleSummary(s ShippingSettings) string {
	rate := centsToDollars(s.FlatRateCents)
	var out string
	if s.FreeShippingThreshold != nil {
		free := centsToDollars(*s.FreeShippingThreshold)
		out = fmt.Sprintf("Orders under $%s pay $%s shipping; $%s and over ship free.", free, rate, free)
	} else {
		out = fmt.Sprintf("Every non-local order pays $%s shipping — no free-shipping threshold is set.", rate)
	}
	if n := len(s.LocalZipCodes); n > 0 {
		out += fmt.Sprintf(" Orders to the %d local zip%s ship free either way.", n, pluralS(n))
	}
	return out
}

// SettingsProps backs the Shipping tab — the section's landing page.
type SettingsProps struct {
	Nav SettingsNav
	// Shipping is what the form fields render: the stored config normally, the
	// rejected draft after a failed save.
	Shipping ShippingSettings
	// Saved is what is actually on disk, always — the two diverge only on a
	// rejected save. The echo sentences read from this rather than from the
	// draft, because they are labelled "Customers currently see" and a customer
	// meets the saved rule, not the one that was just refused. Rendering the
	// draft there meant a mistyped rate announced "$0.00 shipping" directly
	// under a banner saying nothing had been saved. Same rule the nav's issue
	// list follows. renderShippingSettings stamps this, so no call site can
	// forget it.
	Saved ShippingSettings
	// Postponements are the delivery runs moved off their scheduled day. Kept
	// apart from ShippingSettings because they are per-date exceptions edited
	// one at a time, not fields of the big shipping form — a mistyped rate must
	// not discard a holiday somebody marked, and vice versa.
	Postponements []PostponementRow
	// FieldErrors maps a form field name to what is wrong with it. Populated
	// only on a rejected save; the page re-renders with the submitted values
	// rather than redirecting, so nothing typed is thrown away.
	FieldErrors map[string]string
	Flash       Flash
	MerchantTZ  *time.Location
	StaffName   string
	StaffRole   string
}

// SettingsWholesaleProps backs the Wholesale tab.
type SettingsWholesaleProps struct {
	Nav                SettingsNav
	PriceLists         []domain.PriceList // all price lists, for the default-wholesale selector
	DefaultPriceListID *uuid.UUID         // current store-wide default wholesale list, nil = base prices
	Flash              Flash
	StaffName          string
	StaffRole          string
}

// SettingsIntegrationsProps backs the Integrations tab.
type SettingsIntegrationsProps struct {
	Nav        SettingsNav
	QB         QBConnectionStatus
	// QBBillingMode is shadow or live. Shadow is the default and means the
	// invoice chain runs and records what it would have billed without
	// writing to QuickBooks or emailing anyone.
	QBBillingMode domain.QBBillingMode
	// QBPreviewCount is how many would-be invoices are waiting to be reviewed.
	QBPreviewCount int
	// QBItems is which QuickBooks items invoices bill against, and what they
	// could be changed to.
	QBItems QBItemPanel
	QBEnabled  bool // true if QB_CLIENT_ID is configured
	Flash      Flash
	MerchantTZ *time.Location
	StaffName  string
	StaffRole  string
}

// centsToDollars formats integer cents as a dollar string with no symbol, e.g.
// 600 → "6.00". Used to pre-fill number inputs.
func centsToDollars(cents int) string {
	return fmt.Sprintf("%.2f", float64(cents)/100)
}

// centsPtrToDollars formats an optional integer cents pointer. Returns "" when
// nil so empty-input handling stays natural in the form.
func centsPtrToDollars(cents *int) string {
	if cents == nil {
		return ""
	}
	return centsToDollars(*cents)
}

// zipCodesLine joins a zip list into a comma-separated string for textarea
// round-tripping.
func zipCodesLine(zips []string) string {
	return strings.Join(zips, ", ")
}

// fieldInput builds an input's class list, outlining it in rust when that field
// is the one that was rejected. extra carries per-field additions ("font-mono").
func fieldInput(errs map[string]string, name, extra string) string {
	border := "border-rr-border"
	if _, bad := errs[name]; bad {
		border = "border-rr-red"
	}
	return strings.TrimSpace("w-full rounded-sm border " + border + " bg-rr-surface px-3 py-2 text-sm " + extra)
}

func qbConnectionBadgeClasses(qb QBConnectionStatus) string {
	switch {
	case qb.Unavailable:
		return "badge badge-slate"
	case qb.Connected:
		return "badge badge-green"
	}
	return "badge badge-grey"
}

func refreshTokenDaysRemaining(expiresAt *time.Time) int {
	if expiresAt == nil {
		return 0
	}
	return int(time.Until(*expiresAt).Hours() / 24)
}

// refreshTokenRemainingLabel words the countdown, including the case the raw
// number cannot: a token that already lapsed. "-3 days" reads as a rendering
// bug at the exact moment the page is describing an outage.
func refreshTokenRemainingLabel(expiresAt *time.Time) string {
	days := refreshTokenDaysRemaining(expiresAt)
	switch {
	case days < 0:
		return "Expired"
	case days == 0:
		return "Expires today"
	case days == 1:
		return "1 day"
	}
	return fmt.Sprintf("%d days", days)
}

func refreshTokenUrgencyClasses(days int) string {
	if days <= 14 {
		return "text-rr-red font-semibold"
	}
	if days <= 30 {
		return "text-rr-amber-dark font-medium"
	}
	return "text-rr-muted"
}

// fieldNote renders the field's error if it has one, otherwise its help text.
// One line under the input either way: the error replaces the hint rather than
// pushing it down the page, so the layout does not jump on a rejected save.
templ fieldNote(errs map[string]string, name, help string) {
	if msg, bad := errs[name]; bad {
		<p class="mt-1 text-xs font-medium text-rr-red">{ msg }</p>
	} else if help != "" {
		<p class="mt-1 text-xs text-rr-muted">{ help }</p>
	}
}

templ SettingsContent(props SettingsProps) {
	@ConfirmDialogHost()
	@settingsSection(props.Nav, settingsTabShipping)
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Shipping</h1>
			<p class="mt-1 text-sm text-rr-muted">What customers are charged, where the van goes, and the address labels are bought against.</p>
		</div>
	</div>
	@adminFlash(props.Flash)
	@settingsAttention(props.Nav.Issues)
	<div class="mt-6 border border-rr-border bg-rr-surface">
		<form
			method="post"
			action="/admin/settings"
			class="divide-y divide-rr-border"
			x-data="{ dirty: false }"
			@input="dirty = true"
			@change="dirty = true"
		>
			<div class="px-4 py-5 sm:px-6">
				<h2 class="text-sm font-semibold text-rr-heading">Rates</h2>
				<div class="mt-3 grid gap-5 sm:grid-cols-2">
					<div>
						<label for="shipping-flat-rate" class="block text-sm font-medium text-rr-heading">
							Flat rate (USD)
						</label>
						<div class="mt-1 flex items-center">
							<span class="text-rr-muted pr-2">$</span>
							<input
								id="shipping-flat-rate"
								type="number"
								name="flat_rate"
								step="0.01"
								min="0"
								value={ props.Shipping.flatRateValue() }
								required
								class={ fieldInput(props.FieldErrors, "flat_rate", "font-mono") }
							/>
						</div>
						@fieldNote(props.FieldErrors, "flat_rate", "Charged on non-local orders that don't meet the free-shipping threshold.")
					</div>
					<div>
						<label for="shipping-threshold" class="block text-sm font-medium text-rr-heading">
							Free-shipping threshold (USD)
						</label>
						<div class="mt-1 flex items-center">
							<span class="text-rr-muted pr-2">$</span>
							<input
								id="shipping-threshold"
								type="number"
								name="free_threshold"
								step="0.01"
								min="0"
								value={ props.Shipping.thresholdValue() }
								placeholder="leave blank to disable"
								class={ fieldInput(props.FieldErrors, "free_threshold", "font-mono") }
							/>
						</div>
						@fieldNote(props.FieldErrors, "free_threshold", "Orders at or above this subtotal ship free. Blank = no threshold.")
					</div>
				</div>
				<!-- The saved rule, in the words a customer meets it in. -->
				<p class="mt-4 border-l border-rr-border pl-3 text-xs text-rr-body">
					Customers currently see: <span class="font-medium text-rr-heading">{ shippingRuleSummary(props.Saved) }</span>
				</p>
			</div>
			<div class="px-4 py-5 sm:px-6">
				<label for="shipping-zips" class="block text-sm font-medium text-rr-heading">
					Local zip codes
				</label>
				<textarea
					id="shipping-zips"
					name="local_zip_codes"
					rows="3"
					class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm font-mono"
					placeholder="99336, 99337, 99338, …"
				>{ zipCodesLine(props.Shipping.LocalZipCodes) }</textarea>
				<p class="mt-1 text-xs text-rr-muted">
					Comma- or whitespace-separated 5-digit zips. Orders shipping to any of these zips ship free regardless of subtotal.
				</p>
			</div>
			<div id="local-fulfillment" class="px-4 py-5 sm:px-6 scroll-mt-6">
				<h2 class="text-sm font-semibold text-rr-heading">Local fulfillment options</h2>
				<p class="mt-1 text-xs text-rr-muted">
					Channels offered to customers shipping to a local zip. Disable both to fall back to the standard shipped flow even for local zips.
				</p>
				<div class="mt-3 space-y-4">
					<label class="flex items-start gap-3">
						<input
							type="checkbox"
							name="local_delivery_enabled"
							value="1"
							checked?={ props.Shipping.LocalDeliveryEnabled }
							class="mt-1 size-4 rounded-sm border border-rr-border"
						/>
						<span>
							<span class="block text-sm font-medium text-rr-heading">Free local delivery</span>
							<span class="block text-xs text-rr-muted">Customer's order is hand-delivered on the configured days.</span>
						</span>
					</label>
					<div class="ml-7 space-y-3">
						<div>
							<span class="block text-sm font-medium text-rr-heading">Delivery days</span>
							<div class="mt-1.5 flex flex-wrap gap-x-4 gap-y-2">
								for _, day := range weekdayOrder() {
									<label class="flex items-center gap-2">
										<input
											type="checkbox"
											name="local_delivery_weekdays"
											value={ weekdayValue(day) }
											checked?={ hasWeekday(props.Shipping.LocalDeliveryWeekdays, day) }
											class="size-4 rounded-sm border border-rr-border"
										/>
										<span class="text-sm text-rr-heading">{ day.String() }</span>
									</label>
								}
							</div>
							@fieldNote(props.FieldErrors, "local_delivery_weekdays", "The days the van actually runs. Used to work out each order's delivery date — not just display copy.")
						</div>
						<div class="sm:max-w-xs">
							<label for="local-delivery-cutoff" class="block text-sm font-medium text-rr-heading">Order-by cutoff</label>
							<input
								id="local-delivery-cutoff"
								type="time"
								name="local_delivery_cutoff"
								value={ props.Shipping.LocalDeliveryCutoff }
								class={ fieldInput(props.FieldErrors, "local_delivery_cutoff", "mt-1") }
							/>
							if _, bad := props.FieldErrors["local_delivery_cutoff"]; bad {
								@fieldNote(props.FieldErrors, "local_delivery_cutoff", "")
							} else {
								<p class="mt-1 text-xs text-rr-muted">
									Orders placed before this time on a delivery day go out that day. At or after it, they wait for the next one.
									if props.MerchantTZ != nil {
										{ " Times are " + props.MerchantTZ.String() + "." }
									}
								</p>
							}
						</div>
						if len(props.Saved.LocalDeliveryWeekdays) > 0 {
							<p class="text-xs text-rr-muted">
								Customers currently see: <span class="font-medium text-rr-heading">{ deliveryScheduleSummary(props.Saved) }</span>
							</p>
						}
					</div>
					<label class="flex items-start gap-3">
						<input
							type="checkbox"
							name="local_pickup_enabled"
							value="1"
							checked?={ props.Shipping.LocalPickupEnabled }
							class="mt-1 size-4 rounded-sm border border-rr-border"
						/>
						<span>
							<span class="block text-sm font-medium text-rr-heading">Free pickup at the shop</span>
							<span class="block text-xs text-rr-muted">Customer is notified by email when the order is ready and picks it up at the shop.</span>
						</span>
					</label>
					<div class="ml-7">
						<label for="local-pickup-instructions" class="block text-sm font-medium text-rr-heading">Pickup instructions</label>
						<textarea
							id="local-pickup-instructions"
							name="local_pickup_instructions"
							rows="3"
							class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
							placeholder="101 W Kennewick Ave, Tue–Sat 8a–4p"
						>{ props.Shipping.LocalPickupInstructions }</textarea>
						<p class="mt-1 text-xs text-rr-muted">Shown at checkout when pickup is selected and in the "ready for pickup" email.</p>
					</div>
				</div>
			</div>
			<div id="origin" class="px-4 py-5 sm:px-6 scroll-mt-6">
				<h2 class="text-sm font-semibold text-rr-heading">Pickup origin</h2>
				<p class="mt-1 text-xs text-rr-muted">
					Where shipments leave from. Email and phone are required by USPS when buying labels through Shippo — purchases fail without them.
				</p>
				<div class="mt-3 grid gap-4 sm:grid-cols-2">
					<div class="sm:col-span-2">
						<label for="origin-name" class="block text-sm font-medium text-rr-heading">Sender name</label>
						<input
							id="origin-name"
							type="text"
							name="origin_name"
							value={ props.Shipping.OriginName }
							class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
						/>
					</div>
					<div>
						<label for="origin-street1" class="block text-sm font-medium text-rr-heading">Street</label>
						<input
							id="origin-street1"
							type="text"
							name="origin_street1"
							value={ props.Shipping.OriginStreet1 }
							class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
						/>
					</div>
					<div>
						<label for="origin-street2" class="block text-sm font-medium text-rr-heading">Street (line 2)</label>
						<input
							id="origin-street2"
							type="text"
							name="origin_street2"
							value={ props.Shipping.OriginStreet2 }
							class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
						/>
					</div>
					<div>
						<label for="origin-city" class="block text-sm font-medium text-rr-heading">City</label>
						<input
							id="origin-city"
							type="text"
							name="origin_city"
							value={ props.Shipping.OriginCity }
							class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
						/>
					</div>
					<div class="grid grid-cols-3 gap-3">
						<div>
							<label for="origin-state" class="block text-sm font-medium text-rr-heading">State</label>
							<input
								id="origin-state"
								type="text"
								name="origin_state"
								maxlength="2"
								value={ props.Shipping.OriginState }
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm uppercase font-mono"
							/>
						</div>
						<div>
							<label for="origin-zip" class="block text-sm font-medium text-rr-heading">ZIP</label>
							<input
								id="origin-zip"
								type="text"
								name="origin_zip"
								value={ props.Shipping.OriginZip }
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm font-mono"
							/>
						</div>
						<div>
							<label for="origin-country" class="block text-sm font-medium text-rr-heading">Country</label>
							<input
								id="origin-country"
								type="text"
								name="origin_country"
								maxlength="2"
								value={ props.Shipping.OriginCountry }
								class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm uppercase font-mono"
							/>
						</div>
					</div>
					<div>
						<label for="origin-email" class="block text-sm font-medium text-rr-heading">Email</label>
						<input
							id="origin-email"
							type="email"
							name="origin_email"
							value={ props.Shipping.OriginEmail }
							class={ fieldInput(props.FieldErrors, "origin_email", "mt-1") }
						/>
						@fieldNote(props.FieldErrors, "origin_email", "")
					</div>
					<div>
						<label for="origin-phone" class="block text-sm font-medium text-rr-heading">Phone</label>
						<input
							id="origin-phone"
							type="tel"
							name="origin_phone"
							value={ props.Shipping.OriginPhone }
							placeholder="5095852320"
							class={ fieldInput(props.FieldErrors, "origin_phone", "mt-1 font-mono") }
						/>
						@fieldNote(props.FieldErrors, "origin_phone", "")
					</div>
				</div>
			</div>
			<div class="px-4 py-5 sm:px-6">
				<h2 class="text-sm font-semibold text-rr-heading">Packaging tare weight</h2>
				<p class="mt-1 text-xs text-rr-muted">
					Weight of an empty box plus dunnage (in ounces). Added to every shipment on top of the product weights.
				</p>
				<div class="mt-3 sm:max-w-xs">
					<label for="shipping-tare" class="sr-only">Tare weight (oz)</label>
					<div class="flex items-center">
						<input
							id="shipping-tare"
							type="number"
							name="tare_weight_oz"
							step="0.01"
							min="0"
							value={ props.Shipping.tareValue() }
							class={ fieldInput(props.FieldErrors, "tare_weight_oz", "font-mono") }
						/>
						<span class="text-rr-muted pl-2">oz</span>
					</div>
					@fieldNote(props.FieldErrors, "tare_weight_oz", "")
				</div>
			</div>
			<!-- Save bar. Not sticky: the admin layout sets overflow-x-hidden on
			     the content wrapper, which computes overflow-y to auto and makes
			     that wrapper the scrollport for any position:sticky inside it —
			     the bar would silently never pin. The "unsaved changes" note is
			     what tells a staffer who scrolled past it that the trip back up
			     is still owed. -->
			<div class="flex items-center justify-end gap-3 border-t border-rr-border bg-rr-raised px-4 py-3 sm:px-6">
				<span x-show="dirty" x-cloak class="text-xs font-medium text-rr-body">Unsaved changes</span>
				<button type="submit" class="rounded-sm bg-rr-red px-4 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt">
					Save shipping settings
				</button>
			</div>
		</form>
	</div>
	<!-- Gated on the saved config, not the draft. On a rejected save
	     props.Shipping is what was typed, so unticking local delivery alongside
	     a mistyped rate would make the whole panel vanish from the re-render
	     while the postponements sat untouched on disk. Same rule the echo
	     sentences follow. -->
	if props.Saved.LocalDeliveryEnabled && len(props.Saved.LocalDeliveryWeekdays) > 0 {
		@postponementsPanel(props)
	}
}

// postponementsPanel edits the runs that have been moved off their scheduled
// day. Its own card and its own form, not fields on the shipping form above:
// these are per-date exceptions added one at a time, and folding them into a
// twenty-field form would mean a mistyped flat rate discards a holiday somebody
// just marked.
//
// Only rendered when a delivery schedule exists, because there is no run to
// move without one.
templ postponementsPanel(props SettingsProps) {
	<div class="mt-6 border border-rr-border bg-rr-surface">
		<div class="border-b border-rr-border px-4 py-4 sm:px-6">
			<h2 class="text-sm font-semibold text-rr-heading">Moved delivery runs</h2>
			<p class="mt-1 text-xs text-rr-muted">
				For a holiday or a closure &mdash; the run still happens, just on a different day. Customers are quoted the moved date from the moment you save it, and orders already promised the old day move with it. Nobody is emailed automatically; send an announcement if you want to explain it.
			</p>
		</div>
		if len(props.Postponements) > 0 {
			<ul class="divide-y divide-rr-border">
				for _, row := range props.Postponements {
					<li class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
						<div class="min-w-0">
							<p class="text-sm text-rr-heading">
								<span class="font-medium">{ row.OriginalLabel }</span>
								<span class="text-rr-muted">&rarr;</span>
								<span class="font-medium">{ row.MovedToLabel }</span>
							</p>
							if row.Note != "" {
								<p class="mt-0.5 text-xs text-rr-muted">{ row.Note }</p>
							}
							if row.StatusNote != "" {
								<p class="mt-0.5 text-xs text-rr-muted">{ row.StatusNote }</p>
							}
						</div>
						if row.Restorable {
							<form method="post" action="/admin/settings/delivery-postponements/delete">
								<input type="hidden" name="original_date" value={ row.OriginalValue }/>
								@ActionWrap("hint-restore-"+row.OriginalValue, "Puts this run back on its scheduled day, and moves any orders promised the new day back with it.") {
									<button
										type="submit"
										class="border border-rr-border bg-rr-surface px-2.5 py-1 label-font text-rr-muted hover:text-rr-heading hover:bg-rr-raised transition-colors"
										style="font-size:0.6rem;"
										aria-describedby={ "hint-restore-" + row.OriginalValue }
										{ ConfirmAttrs(ActionConfirm{
											Title: "Put this run back on its scheduled day?",
											Lead:  "The run returns to the day it was scheduled for, and the orders that moved with it come back too.",
											Points: []string{
												"Customers are not emailed — anyone already told the moved date will not hear about this.",
												"Orders on other runs are untouched.",
											},
											Confirm: "Restore run",
										})... }
									>Restore</button>
								}
							</form>
						}
					</li>
				}
			</ul>
		} else {
			<p class="px-4 py-4 text-sm text-rr-muted sm:px-6">No runs have been moved.</p>
		}
		<form method="post" action="/admin/settings/delivery-postponements" class="border-t border-rr-border px-4 py-4 sm:px-6">
			<div class="flex flex-wrap items-end gap-3">
				<div>
					<label for="postpone-original" class="block text-xs font-medium text-rr-heading">Run scheduled for</label>
					<input
						type="date"
						id="postpone-original"
						name="original_date"
						required
						class="mt-1 border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading"
					/>
				</div>
				<div>
					<label for="postpone-moved" class="block text-xs font-medium text-rr-heading">Happens instead on</label>
					<input
						type="date"
						id="postpone-moved"
						name="moved_to_date"
						required
						class="mt-1 border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading"
					/>
				</div>
				<div class="min-w-[12rem] flex-1">
					<label for="postpone-note" class="block text-xs font-medium text-rr-heading">Why (staff only)</label>
					<input
						type="text"
						id="postpone-note"
						name="note"
						maxlength="200"
						placeholder="Labor Day"
						class="mt-1 w-full border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading"
					/>
				</div>
				<button type="submit" class="rounded-sm bg-rr-red px-3 py-1.5 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt">
					Move run
				</button>
			</div>
			<p class="mt-2 text-xs text-rr-muted">
				The scheduled day has to be one the van already runs, and the new day has to be later &mdash; up to two weeks out.
			</p>
		</form>
	</div>
}

templ Settings(props SettingsProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Shipping settings",
		ActivePath: "/admin/settings",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@SettingsContent(props)
	}
}

templ SettingsWholesaleContent(props SettingsWholesaleProps) {
	@ConfirmDialogHost()
	@settingsSection(props.Nav, settingsTabWholesale)
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Wholesale</h1>
			<p class="mt-1 text-sm text-rr-muted">Store-wide defaults for approved wholesale accounts.</p>
		</div>
	</div>
	@adminFlash(props.Flash)
	@settingsAttention(props.Nav.Issues)
	<div class="mt-6 overflow-hidden border border-rr-border bg-rr-surface">
		<form method="post" action="/admin/settings/default-price-list" class="px-4 py-5 sm:px-6">
			<label for="default-price-list" class="block text-sm font-medium text-rr-heading">
				Default wholesale price list
			</label>
			<div class="mt-1 flex items-center gap-3">
				<select
					id="default-price-list"
					name="default_price_list_id"
					class="w-full max-w-md rounded-sm border border-rr-border bg-rr-surface px-3 py-2 text-sm"
				>
					<option value="" selected?={ props.DefaultPriceListID == nil }>Base prices (no default)</option>
					for _, pl := range props.PriceLists {
						<option
							value={ pl.ID.String() }
							selected?={ props.DefaultPriceListID != nil && *props.DefaultPriceListID == pl.ID }
						>
							{ pl.Name }
							if pl.Status != domain.PriceListStatusActive {
								({ string(pl.Status) })
							}
						</option>
					}
				</select>
				<button type="submit" class="btn-secondary whitespace-nowrap">Save</button>
			</div>
			<p class="mt-2 text-xs text-rr-muted">
				Applies only to wholesale accounts with no list set on their own profile. Change it here and every unassigned wholesale account updates immediately. Retail customers are unaffected.
			</p>
			<p class="mt-3 text-xs text-rr-muted">
				Editing the prices themselves lives with the catalog — <a href="/admin/price-lists" class="font-medium text-rr-heading underline">Catalog → Pricing</a>.
			</p>
		</form>
	</div>
}

templ SettingsWholesale(props SettingsWholesaleProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Wholesale settings",
		ActivePath: "/admin/settings",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@SettingsWholesaleContent(props)
	}
}

templ SettingsIntegrationsContent(props SettingsIntegrationsProps) {
	@ConfirmDialogHost()
	@settingsSection(props.Nav, settingsTabIntegrations)
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Integrations</h1>
			<p class="mt-1 text-sm text-rr-muted">External services this shop is connected to.</p>
		</div>
	</div>
	@adminFlash(props.Flash)
	@settingsAttention(props.Nav.Issues)
	<div class="mt-6 space-y-4">
		<!-- QuickBooks Online -->
		<div class="overflow-hidden border border-rr-border bg-rr-surface">
			<div class="px-4 py-5 sm:px-6">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-3">
						<div class="flex size-10 items-center justify-center rounded-sm bg-rr-raised ring-1 ring-rr-border">
							<svg class="size-6 text-rr-heading" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-sm font-semibold text-rr-heading">QuickBooks Online</h2>
							<p class="text-sm text-rr-muted">B2B wholesale invoicing and ACH payment collection</p>
						</div>
					</div>
					<span class={ qbConnectionBadgeClasses(props.QB) }>
						if props.QB.Unavailable {
							Status unknown
						} else if props.QB.Connected {
							Connected
						} else {
							Not connected
						}
					</span>
				</div>
			</div>
			if props.QB.Unavailable {
				<div class="border-t border-rr-border px-4 py-4 sm:px-6">
					<p class="text-sm text-rr-muted">
						Couldn't read the connection status just now. Reload in a moment — this says nothing about whether QuickBooks is connected.
					</p>
					<!-- The way out stays on the page: not knowing the status is
					     exactly when someone may need to re-authorise, and the
					     route starts the same flow either way. The destructive
					     action is withheld, because we cannot say what it would
					     be acting on. -->
					<div class="mt-3">
						<a href="/admin/settings/integrations/quickbooks/connect" hx-boost="false" class="btn-secondary">Reconnect anyway</a>
					</div>
				</div>
			} else if !props.QBEnabled {
				<!-- QB not configured in env -->
				<div class="border-t border-rr-border px-4 py-4 sm:px-6">
					<p class="text-sm text-rr-muted">
						QuickBooks integration is not configured. Set <code class="rounded bg-rr-raised px-1 py-0.5 text-xs font-mono">QB_CLIENT_ID</code> and related environment variables to enable.
					</p>
				</div>
			} else if props.QB.Connected {
				<!-- Connected state -->
				<div class="border-t border-rr-border">
					<dl class="divide-y divide-rr-border">
						if props.QB.RealmID != "" {
							<div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
								<dt class="text-sm font-medium text-rr-muted">Company ID (Realm)</dt>
								<dd class="mt-1 text-sm text-rr-heading sm:col-span-2 sm:mt-0 font-mono">{ props.QB.RealmID }</dd>
							</div>
						}
						if props.QB.RefreshExpiresAt != nil {
							<div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
								<dt class="text-sm font-medium text-rr-muted">Access expires</dt>
								<dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
									<span class={ refreshTokenUrgencyClasses(refreshTokenDaysRemaining(props.QB.RefreshExpiresAt)) }>
										{ refreshTokenRemainingLabel(props.QB.RefreshExpiresAt) }
									</span>
									<span class="text-rr-muted ml-1">
										({ props.QB.RefreshExpiresAt.In(props.MerchantTZ).Format("Jan 2, 2006") })
									</span>
									<p class="mt-1 text-xs text-rr-muted">
										Nothing renews this on its own. When it lapses, wholesale invoicing stops without an error.
									</p>
								</dd>
							</div>
						}
					</dl>
				</div>
				@qbItemPanel(props.QBItems)
				<div class="border-t border-rr-border px-4 py-4 sm:px-6">
					<div class="sm:flex sm:items-start sm:justify-between sm:gap-4">
						<div>
							<p class="text-sm font-medium text-rr-heading">
								Billing mode
								if props.QBBillingMode.IsLive() {
									<span class="badge badge-green ml-2">Live</span>
								} else {
									<span class="badge badge-amber ml-2">Test mode</span>
								}
							</p>
							if props.QBBillingMode.IsLive() {
								<p class="mt-1 text-sm text-rr-muted">
									Wholesale orders are invoiced in QuickBooks and emailed to the customer.
								</p>
							} else {
								<p class="mt-1 text-sm text-rr-muted">
									Nothing is billed. Wholesale orders are costed and recorded so you can
									check them, but no invoice reaches QuickBooks and no customer is emailed.
								</p>
							}
						</div>
						<div class="mt-3 flex items-center gap-3 sm:mt-0 sm:shrink-0">
							<a href="/admin/settings/integrations/quickbooks/preview" class="btn-secondary">
								Review
								if props.QBPreviewCount > 0 {
									<span class="ml-1 text-rr-muted">({ strconv.Itoa(props.QBPreviewCount) })</span>
								}
							</a>
							@qbBillingModeForm(props.QBBillingMode)
						</div>
					</div>
				</div>
				<div class="border-t border-rr-border px-4 py-4 sm:px-6">
					<div class="flex items-center gap-3">
						<!-- hx-boost="false" on both OAuth entry points: the route 302s to
						     intuit.com, and a boosted link fetches it by XHR, where a
						     cross-origin redirect cannot become a navigation. The handoff
						     has to be a real browser trip. -->
						<a href="/admin/settings/integrations/quickbooks/connect" hx-boost="false" class="btn-secondary">Reconnect</a>
						<form method="post" action="/admin/settings/integrations/quickbooks/disconnect">
							<button
								type="submit"
								class="btn-danger"
								{ ConfirmAttrs(ActionConfirm{
									Title: "Disconnect QuickBooks?",
									Lead:  "Drops the connection between Hiri and your QuickBooks company.",
									Points: []string{
										"All automated B2B invoicing stops until you reconnect.",
										"Invoices already in QuickBooks stay there — nothing is deleted on their side.",
										"Reconnecting means going through the QuickBooks authorisation again.",
									},
									Confirm: "Disconnect",
									Danger:  true,
								})... }
							>
								Disconnect
							</button>
						</form>
					</div>
				</div>
			} else {
				<!-- Disconnected state -->
				<div class="border-t border-rr-border px-4 py-4 sm:px-6">
					<a
						href="/admin/settings/integrations/quickbooks/connect"
						hx-boost="false"
						class="inline-flex items-center rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt"
					>
						Connect to QuickBooks
					</a>
				</div>
			}
		</div>
	</div>
}

templ SettingsIntegrations(props SettingsIntegrationsProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Integrations",
		ActivePath: "/admin/settings",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@SettingsIntegrationsContent(props)
	}
}

// PostponementRow is one moved delivery run, formatted for display. Dates are
// rendered by the handler in the merchant's zone rather than here, so the whole
// page shows one clock — see the delivery cutoff strip on the dashboard, which
// makes the same choice.
type PostponementRow struct {
	// OriginalValue is the yyyy-mm-dd the Restore form posts back.
	OriginalValue string
	// OriginalLabel and MovedToLabel are the human dates ("Monday, September 7").
	OriginalLabel string
	MovedToLabel  string
	Note          string
	// StatusNote explains a row that carries no action — either the run has been
	// and gone, or its scheduled day has passed while the run itself is still
	// ahead. Empty for a row whose Restore button is live, where the button is
	// the explanation.
	StatusNote string
	// Restorable is whether the run can still be put back on its scheduled day
	// — that is, whether that day is still ahead. False rows render without the
	// Restore button, because restoring into the past would rewrite the promised
	// date on orders that have already been delivered.
	Restorable bool
}

// qbBillingModeForm renders the one control that decides whether real
// customers get billed.
//
// Going live is the consequential direction, so it is the one that has to be
// confirmed and the one whose button carries the weight. Going back to test
// mode is the safe direction and stays a plain secondary action — a mistake
// there costs a proof period, not an invoice sent to a customer.
templ qbBillingModeForm(mode domain.QBBillingMode) {
	if mode.IsLive() {
		<form method="post" action="/admin/settings/integrations/quickbooks/billing-mode">
			<input type="hidden" name="mode" value="shadow"/>
			<button
				type="submit"
				class="btn-secondary"
				{ ConfirmAttrs(ActionConfirm{
					Title: "Switch billing back to test mode?",
					Lead:  "Stops Hiri billing wholesale customers through QuickBooks.",
					Points: []string{
						"New wholesale orders will be recorded for review instead of invoiced.",
						"Invoices already in QuickBooks are untouched — nothing is voided or recalled.",
						"Reconciliation of existing invoices carries on as normal.",
					},
					Confirm: "Switch to test mode",
				})... }
			>Switch to test mode</button>
		</form>
	} else {
		<form method="post" action="/admin/settings/integrations/quickbooks/billing-mode">
			<input type="hidden" name="mode" value="live"/>
			<button
				type="submit"
				class="rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
				{ ConfirmAttrs(ActionConfirm{
					Title: "Start billing customers for real?",
					Lead:  "From now on, wholesale orders are invoiced in QuickBooks and emailed to the customer.",
					Points: []string{
						"Real invoices appear in your QuickBooks company and count as money owed.",
						"Customers receive them by email from QuickBooks, with payment terms and a due date.",
						"Orders already recorded in test mode are not billed automatically — bill any of them you want charged from the review page.",
						"Review what test mode recorded before you do this.",
					},
					Confirm: "Start billing",
					Danger:  true,
				})... }
			>Go live</button>
		</form>
	}
}

// QBItemChoice is one selectable QuickBooks item.
type QBItemChoice struct {
	ID            string
	Name          string
	IncomeAccount string
}

// QBItemPanel backs the invoice-items picker.
//
// Unavailable and Choices being empty are different facts and are shown
// differently: a company genuinely without items is a data problem the shop
// can fix, while a failed listing says nothing about the company at all.
type QBItemPanel struct {
	SalesItemID    string
	SalesItemName  string
	ShippingItemID string
	Choices        []QBItemChoice
	// Unavailable is set when the items could not be listed from QuickBooks.
	Unavailable bool
	// ConfigUnreadable is set when the stored choice itself could not be read.
	// Distinct from Unavailable: one means we cannot offer alternatives, the
	// other means we cannot say what is billing right now — and only the
	// second warrants telling staff that invoicing may be unconfigured.
	ConfigUnreadable bool
	// EnvFallback is an item id still coming from the environment. Shown only
	// when nothing has been chosen here, to explain what is billing meanwhile.
	EnvFallback string
}

// Configured reports whether invoices have an item to bill against, from
// either source.
func (p QBItemPanel) Configured() bool {
	return p.SalesItemID != "" || p.EnvFallback != ""
}

templ qbItemPanel(panel QBItemPanel) {
	<div class="border-t border-rr-border px-4 py-4 sm:px-6">
		<div class="sm:flex sm:items-start sm:justify-between sm:gap-4">
			<div>
				<p class="text-sm font-medium text-rr-heading">
					Invoice items
					if panel.ConfigUnreadable {
						<span class="badge badge-slate ml-2">Unknown</span>
					} else if !panel.Configured() {
						<span class="badge badge-amber ml-2">Not set</span>
					}
				</p>
				<p class="mt-1 text-sm text-rr-muted">
					Which QuickBooks product or service wholesale invoices bill against. This
					decides the income account the money lands in, so it is worth checking with
					whoever keeps the books.
				</p>
				if panel.ConfigUnreadable {
					<p class="mt-1 text-sm text-rr-muted">
						Couldn't read the current setting just now. Reload in a moment — this says
						nothing about whether an item is chosen.
					</p>
				} else if !panel.Configured() {
					<p class="mt-1 text-sm text-rr-red">
						Until one is chosen, wholesale invoices cannot be created.
					</p>
				} else if panel.SalesItemID == "" && panel.EnvFallback != "" {
					<p class="mt-1 text-xs text-rr-muted">
						Currently billing against the item set in the server environment
						(<code class="rounded bg-rr-raised px-1 py-0.5 font-mono">{ panel.EnvFallback }</code>).
						Choosing one here replaces it.
					</p>
				}
			</div>
		</div>

		if panel.Unavailable {
			<p class="mt-3 text-sm text-rr-muted">
				Couldn't read the item list from QuickBooks just now. Reload in a moment — this
				says nothing about which items exist, and whatever is already chosen is still
				billing.
			</p>
			if panel.SalesItemName != "" {
				<p class="mt-1 text-sm text-rr-heading">Currently: { panel.SalesItemName }</p>
			}
		} else if len(panel.Choices) == 0 {
			<p class="mt-3 text-sm text-rr-muted">
				This QuickBooks company has no active products or services to bill against. Add
				one in QuickBooks, then reload.
			</p>
		} else {
			<form method="post" action="/admin/settings/integrations/quickbooks/items" class="mt-3 grid gap-3 sm:grid-cols-2">
				<div>
					<label for="qb_sales_item_id" class="label-font text-rr-muted">Product lines</label>
					<select id="qb_sales_item_id" name="qb_sales_item_id" class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading">
						<option value="" disabled?={ panel.SalesItemID != "" } selected?={ panel.SalesItemID == "" }>Choose an item…</option>
						for _, choice := range panel.Choices {
							<option value={ choice.ID } selected?={ choice.ID == panel.SalesItemID }>
								{ qbItemLabel(choice) }
							</option>
						}
					</select>
				</div>
				<div>
					<label for="qb_shipping_item_id" class="label-font text-rr-muted">Shipping line (optional)</label>
					<select id="qb_shipping_item_id" name="qb_shipping_item_id" class="mt-1 w-full rounded-sm border border-rr-border bg-rr-surface px-2 py-1.5 text-sm text-rr-heading">
						<option value="" selected?={ panel.ShippingItemID == "" }>Same as product lines</option>
						for _, choice := range panel.Choices {
							<option value={ choice.ID } selected?={ choice.ID == panel.ShippingItemID }>
								{ qbItemLabel(choice) }
							</option>
						}
					</select>
				</div>
				<div class="sm:col-span-2">
					<button type="submit" class="btn-confirm">Save items</button>
				</div>
			</form>
		}
	</div>
}

// qbItemLabel names an item the way a bookkeeper would recognise it: the item
// first, then the account it posts to, because the account is the thing the
// choice actually decides.
func qbItemLabel(choice QBItemChoice) string {
	if choice.IncomeAccount == "" {
		return choice.Name
	}
	return choice.Name + " → " + choice.IncomeAccount
}
