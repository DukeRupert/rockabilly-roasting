package admin

templ StaffLoginPage(errMsg string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Staff Login — Rockabilly Roasting</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<style>
				/* Login uses the brand dark palette — no overrides */
				.login-brand {
					background:
						/* Halftone dot texture */
						radial-gradient(circle, rgba(232, 146, 26, 0.08) 1px, transparent 1px),
						/* Edison-bulb radial glow */
						radial-gradient(ellipse at 50% 55%, rgba(232, 146, 26, 0.14) 0%, rgba(232, 146, 26, 0.04) 45%, transparent 70%),
						/* Base */
						#0E0F10;
					background-size: 18px 18px, 100% 100%, 100% 100%;
				}
				.login-form-panel {
					background:
						/* Subtle crosshatch */
						repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(168, 184, 192, 0.03) 4px, rgba(168, 184, 192, 0.03) 5px),
						repeating-linear-gradient(-45deg, transparent, transparent 4px, rgba(168, 184, 192, 0.03) 4px, rgba(168, 184, 192, 0.03) 5px),
						#161A1E;
				}
				/* Flame stripe */
				.flame-stripe-login {
					height: 3px;
					background: linear-gradient(90deg, #7A1210, #B82018, #E8921A, #B82018, #7A1210);
				}
				/* Input focus glow */
				.login-input:focus {
					outline: none;
					border-color: #E8921A;
					box-shadow: 0 0 0 3px rgba(232, 146, 26, 0.2), 0 0 16px rgba(232, 146, 26, 0.08);
				}
				/* Button glow on hover */
				.login-btn:hover {
					box-shadow: 0 0 24px rgba(184, 32, 24, 0.5), 0 4px 12px rgba(0, 0, 0, 0.4);
				}
				.login-btn:active {
					transform: translateY(2px);
					box-shadow: none;
				}
				/* Logo entrance */
				@keyframes logo-settle {
					from { opacity: 0; transform: translateY(-12px); }
					to { opacity: 1; transform: translateY(0); }
				}
				@keyframes form-rise {
					from { opacity: 0; transform: translateY(16px); }
					to { opacity: 1; transform: translateY(0); }
				}
				.animate-logo { animation: logo-settle 0.6s ease-out both; }
				.animate-form { animation: form-rise 0.5s ease-out 0.2s both; }
				@media (prefers-reduced-motion: reduce) {
					.animate-logo, .animate-form { animation: none; opacity: 1; }
				}
			</style>
		</head>
		<body class="h-full bg-rr-void">
			<div class="flex min-h-full">
				<!-- Brand Panel (hidden on small screens, visible lg+) -->
				<div class="login-brand hidden lg:flex lg:w-1/2 flex-col items-center justify-center relative overflow-hidden">
					<!-- Decorative flame stripe at top -->
					<div class="flame-stripe-login absolute top-0 left-0 right-0"></div>

					<div class="animate-logo flex flex-col items-center gap-8 px-12">
						<img
							src="/static/logo-white.svg"
							alt="Rockabilly Roasting Co."
							class="w-56 h-auto drop-shadow-[0_0_40px_rgba(232,146,26,0.2)]"
						/>
						<div class="text-center">
							<p
								class="text-rr-amber tracking-[0.35em] text-xs font-semibold uppercase"
								style="font-family: 'Barlow', sans-serif;"
							>
								Staff Portal
							</p>
						</div>
					</div>

					<!-- Decorative flame stripe at bottom -->
					<div class="flame-stripe-login absolute bottom-0 left-0 right-0"></div>
				</div>

				<!-- Form Panel -->
				<div class="login-form-panel flex w-full lg:w-1/2 flex-col justify-center px-6 py-12 sm:px-12">
					<div class="animate-form mx-auto w-full max-w-sm">
						<!-- Mobile logo (hidden lg+) -->
						<div class="lg:hidden flex flex-col items-center mb-10">
							<img
								src="/static/logo-white.svg"
								alt="Rockabilly Roasting Co."
								class="w-40 h-auto mb-4 drop-shadow-[0_0_24px_rgba(232,146,26,0.15)]"
							/>
							<div class="flame-stripe-login w-full mt-4"></div>
						</div>

						<div class="mb-8">
							<h1
								class="text-3xl tracking-wide text-rr-heading"
								style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.08em;"
							>
								Sign In
							</h1>
							<p class="mt-1 text-sm text-rr-muted" style="font-family: 'Barlow', sans-serif;">
								Enter your credentials to continue.
							</p>
						</div>

						if errMsg != "" {
							<div class="mb-5 rounded-sm border border-rr-red/30 bg-rr-red/10 px-4 py-3">
								<p class="text-sm text-red-400" style="font-family: 'Barlow', sans-serif;">{ errMsg }</p>
							</div>
						}

						<form method="post" action="/auth/staff/login" class="space-y-5">
							<div>
								<label
									for="email"
									class="block text-xs font-bold uppercase tracking-[0.18em] text-rr-muted mb-2"
									style="font-family: 'Barlow', sans-serif;"
								>
									Email
								</label>
								<input
									id="email"
									name="email"
									type="email"
									autocomplete="email"
									required
									placeholder="you@rockabillyroasting.com"
									class="login-input block w-full rounded-sm border border-rr-border bg-rr-surface px-4 py-3 text-sm text-rr-heading placeholder:text-rr-faint transition-colors duration-150"
									style="font-family: 'Barlow', sans-serif;"
								/>
							</div>
							<div>
								<label
									for="password"
									class="block text-xs font-bold uppercase tracking-[0.18em] text-rr-muted mb-2"
									style="font-family: 'Barlow', sans-serif;"
								>
									Password
								</label>
								<input
									id="password"
									name="password"
									type="password"
									autocomplete="current-password"
									required
									class="login-input block w-full rounded-sm border border-rr-border bg-rr-surface px-4 py-3 text-sm text-rr-heading placeholder:text-rr-faint transition-colors duration-150"
									style="font-family: 'Barlow', sans-serif;"
								/>
							</div>
							<div class="pt-2">
								<button
									type="submit"
									class="login-btn flex w-full justify-center rounded-sm bg-rr-red px-4 py-3 text-sm font-bold uppercase tracking-[0.12em] text-white shadow-lg transition-all duration-150 hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-amber"
									style="font-family: 'Barlow', sans-serif;"
								>
									Sign In
								</button>
							</div>
						</form>

						<p class="mt-8 text-center text-xs text-rr-faint" style="font-family: 'Barlow', sans-serif;">
							Rockabilly Roasting Co. — Kennewick, WA
						</p>
					</div>
				</div>
			</div>
		</body>
	</html>
}
