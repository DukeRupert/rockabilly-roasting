package admin

// StaffLoginForm renders just the form with error message and preserved email.
// Used as an htmx partial on failed login attempts.
templ StaffLoginForm(errMsg string, email string) {
	<div id="login-form">
		if errMsg != "" {
			<div class="mb-5 border-2 border-rust bg-paper p-3 text-center">
				<p class="font-oswald font-bold text-rust text-sm" style="letter-spacing:0.04em;">{ errMsg }</p>
			</div>
		}
		<form
			method="post"
			action="/auth/staff/login"
			hx-post="/auth/staff/login"
			hx-target="#login-form"
			hx-swap="outerHTML"
			class="space-y-5"
		>
			<div>
				<label
					for="email"
					class="font-oswald font-bold text-ink text-[11px] mb-2 block"
					style="letter-spacing:0.2em; text-transform:uppercase;"
				>
					Email
				</label>
				<input
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					required
					value={ email }
					placeholder="you@rockabillyroasting.com"
					class="paper-input w-full border-2 border-ink bg-paper px-3.5 py-2.5 font-oswald text-base text-ink placeholder:text-chrome-deep focus:outline-none"
					style="letter-spacing:0.04em;"
				/>
			</div>
			<div>
				<label
					for="password"
					class="font-oswald font-bold text-ink text-[11px] mb-2 block"
					style="letter-spacing:0.2em; text-transform:uppercase;"
				>
					Password
				</label>
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="current-password"
					required
					class="paper-input w-full border-2 border-ink bg-paper px-3.5 py-2.5 font-oswald text-base text-ink placeholder:text-chrome-deep focus:outline-none"
					style="letter-spacing:0.04em;"
				/>
			</div>
			<div class="pt-2">
				<button
					type="submit"
					class="btn-stamp w-full inline-flex items-center justify-center gap-2 bg-rust text-paper border-2 border-ink px-6 py-3.5 font-oswald font-bold text-sm"
					style="letter-spacing:0.16em; text-transform:uppercase;"
				>
					Sign Me In
					<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
					</svg>
				</button>
			</div>
		</form>
	</div>
}

templ StaffLoginPage(errMsg string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Staff Login — Rockabilly Roasting</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Oswald:wght@400;500;600;700&family=Special+Elite&family=Yellowtail&display=swap" rel="stylesheet"/>
			<script src="/static/js/htmx.min.js"></script>
			<style>
				/* Ink poster panel: candle-amber radial glow on deep ink */
				.login-brand {
					background:
						radial-gradient(ellipse at 50% 55%, rgba(242, 160, 61, 0.22) 0%, rgba(242, 160, 61, 0.04) 45%, transparent 72%),
						#0E0D0C;
				}
				/* Paper panel: subtle halftone grain */
				.login-form-panel {
					background-color: #F6EFE1;
					background-image: radial-gradient(circle, rgba(14, 13, 12, 0.06) 1px, transparent 1px);
					background-size: 4px 4px;
				}
				/* Flame-stripe divider (rust → amber → rust) */
				.flame-stripe-login {
					height: 3px;
					background: linear-gradient(90deg, #8A240F, #B4351D, #F2A03D, #B4351D, #8A240F);
				}
				/* Entrance animations */
				@keyframes logo-settle {
					from { opacity: 0; transform: translateY(-10px); }
					to { opacity: 1; transform: translateY(0); }
				}
				@keyframes form-rise {
					from { opacity: 0; transform: translateY(12px); }
					to { opacity: 1; transform: translateY(0); }
				}
				.animate-logo { animation: logo-settle 0.5s ease-out both; }
				.animate-form { animation: form-rise 0.45s ease-out 0.15s both; }
				@media (prefers-reduced-motion: reduce) {
					.animate-logo, .animate-form { animation: none; opacity: 1; }
				}
			</style>
		</head>
		<body class="h-full" style="background:#F6EFE1; color:#0E0D0C;">
			<div class="flex min-h-full">
				<!-- Brand panel (lg+ only) -->
				<div class="login-brand hidden lg:flex lg:w-1/2 flex-col items-center justify-center relative overflow-hidden">
					<div class="flame-stripe-login absolute top-0 left-0 right-0"></div>
					<div class="animate-logo flex flex-col items-center gap-4 px-12">
						<img
							src="/static/double-candle.png"
							alt="Rockabilly Roasting Co."
							width="3300"
							height="4200"
							decoding="async"
							class="w-72 h-auto"
						/>
						<div class="text-center">
							<p
								class="font-oswald text-candle text-[11px] font-semibold"
								style="letter-spacing:0.32em; text-transform:uppercase;"
							>
								Staff Portal
							</p>
							<p
								class="font-script text-paper text-2xl mt-2"
								style="line-height:1;"
							>
								back of house.
							</p>
						</div>
					</div>
					<div class="flame-stripe-login absolute bottom-0 left-0 right-0"></div>
				</div>
				<!-- Form panel -->
				<div class="login-form-panel flex w-full lg:w-1/2 flex-col justify-center px-6 py-12 sm:px-12 relative">
					<div class="animate-form mx-auto w-full max-w-sm">
						<!-- Mobile ink badge (hidden lg+) -->
						<div class="lg:hidden mb-8 -mx-6 sm:-mx-12 px-6 sm:px-12 py-6 text-center relative" style="background:#0E0D0C;">
							<div class="flame-stripe-login absolute top-0 left-0 right-0"></div>
							<img
								src="/static/logo-white.svg"
								alt="Rockabilly Roasting Co."
								class="w-28 h-auto mx-auto mb-2"
							/>
							<p
								class="font-oswald text-candle text-[10px] font-semibold"
								style="letter-spacing:0.28em; text-transform:uppercase;"
							>
								Staff Portal
							</p>
							<div class="flame-stripe-login absolute bottom-0 left-0 right-0"></div>
						</div>
						<!-- Heading -->
						<div class="text-center mb-8">
							<p
								class="font-oswald text-chrome-deep text-xs font-semibold"
								style="letter-spacing:0.24em; text-transform:uppercase;"
							>
								Clock in
							</p>
							<h1
								class="font-slab text-ink uppercase leading-[0.92] mt-2"
								style="font-size: clamp(1.75rem, 4.5vw, 2.75rem); letter-spacing:-0.005em;"
							>
								Sign
								<span
									class="font-script text-rust normal-case inline-block align-baseline"
									style="font-size:1.1em; letter-spacing:0;"
								>
									in.
								</span>
							</h1>
							<p class="font-oswald text-ink-soft text-sm mt-3 max-w-xs mx-auto leading-relaxed">
								Crew only. Enter your credentials to continue.
							</p>
						</div>
						<!-- Form card -->
						<div class="border-2 border-ink bg-cream-hi shadow-stamp p-6 sm:p-8">
							@StaffLoginForm(errMsg, "")
						</div>
						<p
							class="mt-8 text-center font-special text-chrome-deep text-xs"
							style="letter-spacing:0.04em;"
						>
							Rockabilly Roasting Co. &middot; Kennewick, WA
						</p>
					</div>
				</div>
			</div>
		</body>
	</html>
}
