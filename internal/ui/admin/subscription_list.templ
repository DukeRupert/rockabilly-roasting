package admin

import (
	"fmt"
	"net/url"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

func subscriptionListURL(page int, status, q, sort string) string {
	v := url.Values{}
	if page > 1 {
		v.Set("page", fmt.Sprintf("%d", page))
	}
	if status != "" {
		v.Set("status", status)
	}
	if q != "" {
		v.Set("q", q)
	}
	if sort != "" && sort != "created_desc" {
		v.Set("sort", sort)
	}
	if len(v) == 0 {
		return "/admin/subscriptions"
	}
	return "/admin/subscriptions?" + v.Encode()
}

// subscriptionSortToggle returns the next sort value when a user clicks the
// header for `col` (one of "next_order", "created"). Clicking the active
// column flips direction; clicking an inactive column picks the most useful
// default (ASC for next_order so soonest is on top, DESC for created so
// newest is on top).
func subscriptionSortToggle(col, current string) string {
	switch col {
	case "next_order":
		if current == "next_order_asc" {
			return "next_order_desc"
		}
		return "next_order_asc"
	case "created":
		if current == "created_desc" || current == "" {
			return "created_asc"
		}
		return "created_desc"
	}
	return ""
}

func subscriptionSortIndicator(col, current string) string {
	switch col {
	case "next_order":
		if current == "next_order_asc" {
			return "↑"
		}
		if current == "next_order_desc" {
			return "↓"
		}
	case "created":
		if current == "created_asc" {
			return "↑"
		}
		if current == "created_desc" || current == "" {
			return "↓"
		}
	}
	return ""
}

type EnrichedSubscription struct {
	domain.Subscription
	CustomerName  string
	CustomerEmail string
	PlanName      string
}

type SubscriptionListProps struct {
	Subscriptions []EnrichedSubscription
	StatusFilter  string
	SearchQuery   string
	Sort          string
	Page          int
	PerPage       int
	HasMore       bool
	MerchantTZ    *time.Location
	StaffName     string
	StaffRole     string
}

templ SubscriptionListContent(props SubscriptionListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Subscriptions</h1>
			<p class="mt-1 text-sm text-rr-muted">Manage recurring delivery subscriptions</p>
		</div>
	</div>
	<!-- Filters -->
	<form method="get" action="/admin/subscriptions" class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
		if props.Sort != "" && props.Sort != "created_desc" {
			<input type="hidden" name="sort" value={ props.Sort }/>
		}
		<div class="relative flex-1 sm:max-w-sm">
			<input
				type="search"
				name="q"
				value={ props.SearchQuery }
				placeholder="Search by name, email, or company"
				class="w-full rounded-sm bg-rr-surface py-1.5 pl-9 pr-3 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
			/>
			<svg class="pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-rr-muted" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 3.4 9.8l3.65 3.65a.75.75 0 1 0 1.06-1.06l-3.65-3.65A5.5 5.5 0 0 0 9 3.5ZM5 9a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" clip-rule="evenodd"></path>
			</svg>
		</div>
		<div class="grid grid-cols-1 sm:w-48">
			<select
				name="status"
				onchange="this.form.submit()"
				class="col-start-1 row-start-1 w-full appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
			>
				<option value="">All statuses</option>
				<option value="active" selected?={ props.StatusFilter == "active" }>Active</option>
				<option value="paused" selected?={ props.StatusFilter == "paused" }>Paused</option>
				<option value="past_due" selected?={ props.StatusFilter == "past_due" }>Past Due</option>
				<option value="cancelled" selected?={ props.StatusFilter == "cancelled" }>Cancelled</option>
				<option value="expired" selected?={ props.StatusFilter == "expired" }>Expired</option>
			</select>
			<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</div>
		<button type="submit" class="btn-secondary sm:w-auto">Search</button>
		if props.SearchQuery != "" || props.StatusFilter != "" {
			<a href="/admin/subscriptions" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">Clear</a>
		}
	</form>
	<!-- Subscription table -->
	<div class="mt-6">
		if len(props.Subscriptions) == 0 {
			<div class="border border-dashed border-rr-border p-12 text-center">
				<svg class="mx-auto size-12 text-rr-border" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.678 48.678 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3-3 3"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No subscriptions</h3>
				<p class="mt-1 text-sm text-rr-muted">Subscriptions will appear here once customers subscribe to plans.</p>
			</div>
		} else {
			<div class="overflow-hidden border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Customer</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading md:table-cell">Plan</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">
								<a
									href={ templ.SafeURL(subscriptionListURL(1, props.StatusFilter, props.SearchQuery, subscriptionSortToggle("next_order", props.Sort))) }
									class="inline-flex items-center gap-1 hover:text-rr-red"
								>
									Next Order
									if ind := subscriptionSortIndicator("next_order", props.Sort); ind != "" {
										<span class="text-rr-red">{ ind }</span>
									} else {
										<span class="text-rr-border">↕</span>
									}
								</a>
							</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">
								<a
									href={ templ.SafeURL(subscriptionListURL(1, props.StatusFilter, props.SearchQuery, subscriptionSortToggle("created", props.Sort))) }
									class="inline-flex items-center gap-1 hover:text-rr-red"
								>
									Created
									if ind := subscriptionSortIndicator("created", props.Sort); ind != "" {
										<span class="text-rr-red">{ ind }</span>
									} else {
										<span class="text-rr-border">↕</span>
									}
								</a>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, sub := range props.Subscriptions {
							<tr class="row-link">
								<td class="py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s", sub.ID.String())) } class="row-link-target font-medium text-rr-red hover:text-rr-red-lt">
										if sub.CustomerName != "" {
											{ sub.CustomerName }
										} else {
											{ sub.CustomerEmail }
										}
									</a>
									if sub.CustomerName != "" && sub.CustomerEmail != "" {
										<div class="text-xs text-rr-muted">{ sub.CustomerEmail }</div>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-heading md:table-cell">
									{ sub.PlanName }
									if sub.Quantity > 1 {
										<span class="text-rr-muted">&times;{ fmt.Sprintf("%d", sub.Quantity) }</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@SubscriptionStatusBadge(sub.Status)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									{ sub.NextOrderAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted lg:table-cell">
									{ sub.CreatedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(subscriptionListURL(props.Page-1, props.StatusFilter, props.SearchQuery, props.Sort)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Previous
						</a>
					}
				</div>
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(subscriptionListURL(props.Page+1, props.StatusFilter, props.SearchQuery, props.Sort)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

templ SubscriptionList(props SubscriptionListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Subscriptions",
		ActivePath: "/admin/subscriptions",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@SubscriptionListContent(props)
	}
}
