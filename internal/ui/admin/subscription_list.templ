package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type SubscriptionListProps struct {
	Subscriptions []domain.Subscription
	StatusFilter  string
	Page          int
	PerPage       int
	HasMore       bool
	StaffName     string
	StaffRole     string
}

templ SubscriptionListContent(props SubscriptionListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="text-base/7 font-semibold text-stone-900">Subscriptions</h1>
			<p class="mt-1 text-sm text-stone-500">Manage recurring delivery subscriptions</p>
		</div>
	</div>
	<!-- Filters -->
	<form method="get" action="/admin/subscriptions" class="mt-6 flex items-center gap-3">
		<div class="grid grid-cols-1">
			<select
				name="status"
				onchange="this.form.submit()"
				class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pl-3 pr-8 text-sm text-stone-900 outline-1 -outline-offset-1 outline-stone-300 focus:outline-2 focus:-outline-offset-2 focus:outline-hiri-teal"
			>
				<option value="">All statuses</option>
				<option value="active" selected?={ props.StatusFilter == "active" }>Active</option>
				<option value="paused" selected?={ props.StatusFilter == "paused" }>Paused</option>
				<option value="past_due" selected?={ props.StatusFilter == "past_due" }>Past Due</option>
				<option value="cancelled" selected?={ props.StatusFilter == "cancelled" }>Cancelled</option>
				<option value="expired" selected?={ props.StatusFilter == "expired" }>Expired</option>
			</select>
			<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-stone-500 sm:size-4" viewBox="0 0 16 16" fill="currentColor">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</div>
	</form>
	<!-- Subscription table -->
	<div class="mt-6">
		if len(props.Subscriptions) == 0 {
			<div class="rounded-lg border-2 border-dashed border-stone-300 p-12 text-center">
				<svg class="mx-auto size-12 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.678 48.678 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3-3 3"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-stone-900">No subscriptions</h3>
				<p class="mt-1 text-sm text-stone-500">Subscriptions will appear here once customers subscribe to plans.</p>
			</div>
		} else {
			<div class="overflow-hidden rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
				<table class="min-w-full divide-y divide-stone-300">
					<thead class="bg-stone-50">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-stone-900 sm:pl-6">ID</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Status</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-stone-900 sm:table-cell">Next Order</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-stone-900 lg:table-cell">Created</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-200 bg-white">
						for _, sub := range props.Subscriptions {
							<tr class="hover:bg-stone-50">
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium sm:pl-6">
									<a href={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s", sub.ID.String())) } class="text-hiri-teal hover:text-hiri-teal-dark">
										{ sub.ID.String()[:8] }...
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@SubscriptionStatusBadge(sub.Status)
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-stone-500 sm:table-cell">
									{ sub.NextOrderAt.Format("Jan 2, 2006") }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-stone-500 lg:table-cell">
									{ sub.CreatedAt.Format("Jan 2, 2006") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-stone-200 px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions?page=%d&status=%s", props.Page-1, props.StatusFilter)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Previous
						</a>
					}
				</div>
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions?page=%d&status=%s", props.Page+1, props.StatusFilter)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

templ SubscriptionList(props SubscriptionListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Subscriptions",
		ActivePath: "/admin/subscriptions",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@SubscriptionListContent(props)
	}
}
