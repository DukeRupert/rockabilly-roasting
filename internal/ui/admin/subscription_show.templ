package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type SubscriptionShowProps struct {
	Subscription *domain.Subscription
	Plan         *domain.SubscriptionPlan
	Customer     *domain.Customer
	Orders       []domain.SubscriptionOrder
}

func canPause(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusActive
}

func canResume(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusPaused
}

func canCancel(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusActive ||
		status == domain.SubscriptionStatusPaused ||
		status == domain.SubscriptionStatusPastDue
}

templ SubscriptionShowContent(props SubscriptionShowProps) {
	<!-- Header -->
	<div class="sm:flex sm:items-center sm:justify-between">
		<div>
			<div class="flex items-center gap-3">
				<h1 class="text-base/7 font-semibold text-stone-900">Subscription { props.Subscription.ID.String()[:8] }...</h1>
				@SubscriptionStatusBadge(props.Subscription.Status)
			</div>
			<p class="mt-1 text-sm text-stone-500">Created { props.Subscription.CreatedAt.Format("January 2, 2006 at 3:04 PM") }</p>
		</div>
		<div class="mt-4 sm:mt-0">
			<a href="/admin/subscriptions" class="text-sm font-semibold text-hiri-teal hover:text-hiri-teal-dark">&larr; Back to subscriptions</a>
		</div>
	</div>
	<!-- Actions -->
	<div class="mt-6 flex gap-3">
		if canPause(props.Subscription.Status) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/pause", props.Subscription.ID.String())) }>
				<button
					type="submit"
					class="inline-flex items-center rounded-md bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-800 ring-1 ring-inset ring-amber-600/20 hover:bg-amber-100"
				>
					Pause
				</button>
			</form>
		}
		if canResume(props.Subscription.Status) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/resume", props.Subscription.ID.String())) }>
				<button
					type="submit"
					class="inline-flex items-center rounded-md bg-green-50 px-3 py-2 text-sm font-semibold text-green-700 ring-1 ring-inset ring-green-600/20 hover:bg-green-100"
				>
					Resume
				</button>
			</form>
		}
		if canCancel(props.Subscription.Status) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/cancel", props.Subscription.ID.String())) }>
				<button
					type="submit"
					class="inline-flex items-center rounded-md bg-red-50 px-3 py-2 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-600/20 hover:bg-red-100"
					onclick="return confirm('Are you sure you want to cancel this subscription?')"
				>
					Cancel Subscription
				</button>
			</form>
		}
	</div>
	<!-- Details grid -->
	<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
		<div class="rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
			<dt class="text-sm font-medium text-stone-500">Plan</dt>
			<dd class="mt-1 text-sm font-semibold text-stone-900">{ props.Plan.Name }</dd>
			<dd class="text-xs text-stone-500">{ string(props.Plan.Interval) } (×{ fmt.Sprintf("%d", props.Plan.IntervalCount) })</dd>
		</div>
		<div class="rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
			<dt class="text-sm font-medium text-stone-500">Quantity</dt>
			<dd class="mt-1 text-sm font-semibold text-stone-900">{ fmt.Sprintf("%d", props.Subscription.Quantity) }</dd>
		</div>
		<div class="rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
			<dt class="text-sm font-medium text-stone-500">Customer</dt>
			<dd class="mt-1 text-sm font-semibold text-stone-900">
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", props.Customer.ID.String())) } class="text-hiri-teal hover:text-hiri-teal-dark">
					{ props.Customer.FirstName } { props.Customer.LastName }
				</a>
			</dd>
			<dd class="text-xs text-stone-500">{ props.Customer.Email }</dd>
		</div>
		<div class="rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
			<dt class="text-sm font-medium text-stone-500">Current Period</dt>
			<dd class="mt-1 text-sm text-stone-900">
				{ props.Subscription.CurrentPeriodStart.Format("Jan 2") } — { props.Subscription.CurrentPeriodEnd.Format("Jan 2, 2006") }
			</dd>
		</div>
		<div class="rounded-lg bg-white p-4 shadow-xs ring-1 ring-stone-900/5">
			<dt class="text-sm font-medium text-stone-500">Next Order</dt>
			<dd class="mt-1 text-sm font-semibold text-stone-900">{ props.Subscription.NextOrderAt.Format("January 2, 2006") }</dd>
		</div>
	</div>
	<!-- Extra status info -->
	if props.Subscription.CancelledAt != nil {
		<div class="mt-4 rounded-lg bg-stone-50 p-4 ring-1 ring-stone-900/5">
			<p class="text-sm text-stone-600">
				<span class="font-medium">Cancelled:</span> { props.Subscription.CancelledAt.Format("January 2, 2006 at 3:04 PM") }
			</p>
		</div>
	}
	if props.Subscription.PauseUntil != nil {
		<div class="mt-4 rounded-lg bg-amber-50 p-4 ring-1 ring-amber-600/10">
			<p class="text-sm text-amber-800">
				<span class="font-medium">Paused until:</span> { props.Subscription.PauseUntil.Format("January 2, 2006") }
			</p>
		</div>
	}
	<!-- Renewal orders -->
	<div class="mt-8">
		<h2 class="text-sm font-semibold text-stone-900">Renewal Orders</h2>
		if len(props.Orders) == 0 {
			<p class="mt-2 text-sm text-stone-500">No renewal orders yet.</p>
		} else {
			<div class="mt-2 overflow-hidden rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
				<table class="min-w-full divide-y divide-stone-300">
					<thead class="bg-stone-50">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-stone-900 sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Period Start</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Period End</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-200 bg-white">
						for _, so := range props.Orders {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", so.OrderID.String())) }
										class="font-medium text-hiri-teal hover:text-hiri-teal-dark"
									>
										{ so.OrderID.String()[:8] }...
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-stone-500">
									{ so.PeriodStart.Format("Jan 2, 2006") }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-stone-500">
									{ so.PeriodEnd.Format("Jan 2, 2006") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ SubscriptionShow(props SubscriptionShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      fmt.Sprintf("Subscription %s", props.Subscription.ID.String()[:8]),
		ActivePath: "/admin/subscriptions",
		StaffName:  "Dev User",
		StaffRole:  "admin",
	}) {
		@SubscriptionShowContent(props)
	}
}
