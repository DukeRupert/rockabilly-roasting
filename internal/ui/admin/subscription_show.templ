package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type EnrichedSubOrder struct {
	domain.SubscriptionOrder
	OrderNumber string
}

type SubscriptionShowProps struct {
	Subscription *domain.Subscription
	Plan         *domain.SubscriptionPlan
	Customer     *domain.Customer
	Orders       []EnrichedSubOrder
	Flash        string
	StaffName    string
	StaffRole    string
}

func canPause(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusActive
}

func canResume(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusPaused
}

func canCancel(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusActive ||
		status == domain.SubscriptionStatusPaused ||
		status == domain.SubscriptionStatusPastDue
}

templ SubscriptionShowContent(props SubscriptionShowProps) {
	if props.Flash != "" {
		@flashToast(props.Flash)
	}
	<!-- Header -->
	<div class="sm:flex sm:items-center sm:justify-between">
		<div>
			<div class="flex items-center gap-3">
				<h1 class="text-base/7 font-semibold text-rr-heading">{ props.Plan.Name } — { props.Customer.FirstName } { props.Customer.LastName }</h1>
				@SubscriptionStatusBadge(props.Subscription.Status)
			</div>
			<p class="mt-1 text-sm text-rr-muted">Created { props.Subscription.CreatedAt.Format("January 2, 2006 at 3:04 PM") }</p>
		</div>
		<div class="mt-4 sm:mt-0">
			<a href="/admin/subscriptions" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">&larr; Back to subscriptions</a>
		</div>
	</div>
	<!-- Actions -->
	<div class="mt-6 flex gap-3">
		if canPause(props.Subscription.Status) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/pause", props.Subscription.ID.String())) }>
				<button type="submit" class="btn-secondary">
					Pause
				</button>
			</form>
		}
		if canResume(props.Subscription.Status) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/resume", props.Subscription.ID.String())) }>
				<button type="submit" class="btn-confirm">
					Resume
				</button>
			</form>
		}
		if canCancel(props.Subscription.Status) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/cancel", props.Subscription.ID.String())) }>
				<button
					type="submit"
					class="btn-danger"
					onclick="return confirm('Are you sure you want to cancel this subscription?')"
				>
					Cancel Subscription
				</button>
			</form>
		}
	</div>
	<!-- Details grid -->
	<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Plan</dt>
			<dd class="mt-1 text-sm font-semibold text-rr-heading">{ props.Plan.Name }</dd>
			<dd class="text-xs text-rr-muted">{ string(props.Plan.Interval) } (&times;{ fmt.Sprintf("%d", props.Plan.IntervalCount) })</dd>
		</div>
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Quantity</dt>
			<dd class="mt-1 text-sm font-semibold text-rr-heading">{ fmt.Sprintf("%d", props.Subscription.Quantity) }</dd>
		</div>
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Customer</dt>
			<dd class="mt-1 text-sm font-semibold text-rr-heading">
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", props.Customer.ID.String())) } class="text-rr-red hover:text-rr-red-lt">
					{ props.Customer.FirstName } { props.Customer.LastName }
				</a>
			</dd>
			<dd class="text-xs text-rr-muted">{ props.Customer.Email }</dd>
		</div>
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Current Period</dt>
			<dd class="mt-1 text-sm text-rr-heading">
				{ props.Subscription.CurrentPeriodStart.Format("Jan 2") } — { props.Subscription.CurrentPeriodEnd.Format("Jan 2, 2006") }
			</dd>
		</div>
		<div class="rounded-sm bg-rr-surface p-4 shadow-xs ring-1 ring-rr-border">
			<dt class="text-sm font-medium text-rr-muted">Next Order</dt>
			<dd class="mt-1 text-sm font-semibold text-rr-heading">{ props.Subscription.NextOrderAt.Format("January 2, 2006") }</dd>
		</div>
	</div>
	<!-- Extra status info -->
	if props.Subscription.CancelledAt != nil {
		<div class="mt-4 rounded-sm bg-rr-raised p-4 ring-1 ring-rr-border">
			<p class="text-sm text-rr-muted">
				<span class="font-medium">Cancelled:</span> { props.Subscription.CancelledAt.Format("January 2, 2006 at 3:04 PM") }
			</p>
		</div>
	}
	if props.Subscription.PauseUntil != nil {
		<div class="mt-4 badge-amber rounded-sm p-4">
			<p class="text-sm">
				<span class="font-medium">Paused until:</span> { props.Subscription.PauseUntil.Format("January 2, 2006") }
			</p>
		</div>
	}
	<!-- Renewal orders -->
	<div class="mt-8">
		<h2 class="text-sm font-semibold text-rr-heading">Renewal Orders</h2>
		if len(props.Orders) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No renewal orders yet.</p>
		} else {
			<div class="mt-2 overflow-hidden rounded-sm bg-rr-surface shadow-xs ring-1 ring-rr-border">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Period Start</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Period End</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, so := range props.Orders {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", so.OrderID.String())) }
										class="font-medium text-rr-red hover:text-rr-red-lt"
									>
										if so.OrderNumber != "" {
											{ so.OrderNumber }
										} else {
											{ so.OrderID.String()[:8] }...
										}
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">
									{ so.PeriodStart.Format("Jan 2, 2006") }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">
									{ so.PeriodEnd.Format("Jan 2, 2006") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ SubscriptionShow(props SubscriptionShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      fmt.Sprintf("%s — %s %s", props.Plan.Name, props.Customer.FirstName, props.Customer.LastName),
		ActivePath: "/admin/subscriptions",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@SubscriptionShowContent(props)
	}
}
