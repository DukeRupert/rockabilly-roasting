package admin

import (
	"fmt"
	"strings"
	"time"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type EnrichedSubOrder struct {
	domain.SubscriptionOrder
	OrderNumber string
	OrderTotal  int
	OrderStatus domain.OrderStatus
}

type SubscriptionShowProps struct {
	Subscription    *domain.Subscription
	Plan            *domain.SubscriptionPlan
	AvailablePlans  []domain.SubscriptionPlan
	Customer        *domain.Customer
	Product         *domain.Product
	Variant         *domain.Variant
	VariantLabel    string
	SiblingVariants []SiblingVariant
	ThumbnailURL    string
	UnitPrice       int
	HasUnitPrice    bool
	ShippingAddress *domain.Address
	Orders          []EnrichedSubOrder
	Activity        []domain.AuditEntry
	Flash           string
	MerchantTZ      *time.Location
	StaffName       string
	StaffRole       string
}

func canChangeSubscriptionVariant(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusActive ||
		status == domain.SubscriptionStatusPaused ||
		status == domain.SubscriptionStatusPastDue
}

func canPause(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusActive
}

func canResume(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusPaused
}

func canCancel(status domain.SubscriptionStatus) bool {
	return status == domain.SubscriptionStatusActive ||
		status == domain.SubscriptionStatusPaused ||
		status == domain.SubscriptionStatusPastDue
}

// skipDateBounds returns the first and last day (yyyy-mm-dd, merchant time) a
// staff member may pick as a subscription's restart date. Bounded on both sides
// by what the service accepts: it opens the day after the shipment already
// scheduled (an earlier date would pull the charge forward rather than push it
// back) and closes at the 60-day ceiling. ok is false when the next shipment is
// already beyond that ceiling — no day would be accepted, so the caller hides
// the date form instead of offering a picker that always bounces.
func skipDateBounds(sub *domain.Subscription, tz *time.Location) (string, string, bool) {
	if tz == nil {
		tz = time.Local
	}
	now := time.Now().In(tz)
	earliest := now.AddDate(0, 0, 1)
	if afterNext := sub.NextOrderAt.In(tz).AddDate(0, 0, 1); afterNext.After(earliest) {
		earliest = afterNext
	}
	latest := now.AddDate(0, 0, domain.SubscriptionMaxSkipDays)
	if earliest.After(latest) {
		return "", "", false
	}
	return earliest.Format("2006-01-02"), latest.Format("2006-01-02"), true
}

// skipUndoOffer reports whether a skip on this subscription can still be taken
// back, and the date doing so restores. Mirrors the service's guards so the
// button only shows when pressing it would work.
func skipUndoOffer(sub *domain.Subscription) (time.Time, bool) {
	undo, ok := sub.SkipUndo()
	if !ok || !undo.AppliedNextOrderAt.Equal(sub.NextOrderAt) || !undo.NextOrderAt.After(time.Now()) {
		return time.Time{}, false
	}
	return undo.NextOrderAt, true
}

// skipCounts lists the selectable shipment counts for the skip form.
func skipCounts() []int {
	counts := make([]int, 0, domain.SubscriptionMaxSkipIntervals)
	for n := 1; n <= domain.SubscriptionMaxSkipIntervals; n++ {
		counts = append(counts, n)
	}
	return counts
}

func skipCountLabel(n int) string {
	if n == 1 {
		return "1 shipment"
	}
	return fmt.Sprintf("%d shipments", n)
}

func planCadence(p *domain.SubscriptionPlan) string {
	if p == nil {
		return ""
	}
	raw := strings.TrimPrefix(string(p.Interval), "every_")
	raw = strings.ReplaceAll(raw, "_", " ")
	return "every " + raw
}

// planOptionLabel renders a single plan as it appears in the change-plan
// dropdown, e.g. "Bi-Weekly — every 14 days · 10% off".
func planOptionLabel(p domain.SubscriptionPlan) string {
	label := p.Name + " — " + planCadence(&p)
	if p.DiscountPct > 0 {
		label += " · " + fmt.Sprintf("%d", p.DiscountPct) + "% off"
	}
	return label
}

templ SubscriptionShowContent(props SubscriptionShowProps) {
	if props.Flash != "" {
		@flashToast(props.Flash)
	}
	<!-- Header -->
	<div class="sm:flex sm:items-start sm:justify-between">
		<div>
			<div class="flex flex-wrap items-center gap-3">
				<h1 class="admin-page-title">Subscription</h1>
				@SubscriptionStatusBadge(props.Subscription.Status)
			</div>
			<p class="mt-1 text-sm text-rr-muted">
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", props.Customer.ID.String())) } class="font-medium text-rr-heading hover:text-rr-red">
					{ props.Customer.FirstName } { props.Customer.LastName }
				</a>
				<span class="mx-1.5">·</span>
				<span>{ props.Customer.Email }</span>
				<span class="mx-1.5">·</span>
				<span>Created { props.Subscription.CreatedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }</span>
				<span class="mx-1.5">·</span>
				<code class="text-xs">{ props.Subscription.ID.String()[:8] }</code>
			</p>
		</div>
		<div class="mt-4 sm:mt-0">
			<a href="/admin/subscriptions" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">&larr; Back to subscriptions</a>
		</div>
	</div>
	<!-- State banners -->
	if props.Subscription.CancelledAt != nil {
		<div class="mt-6 border border-rr-border bg-rr-raised p-4">
			<p class="text-sm text-rr-heading">
				<span class="font-semibold">Cancelled</span>
				<span class="text-rr-muted"> on { props.Subscription.CancelledAt.In(props.MerchantTZ).Format("January 2, 2006 at 3:04 PM") }</span>
			</p>
		</div>
	}
	if props.Subscription.PauseUntil != nil {
		<div class="mt-6 badge-amber rounded-sm p-4">
			<p class="text-sm">
				<span class="font-semibold">Paused until</span> { props.Subscription.PauseUntil.In(props.MerchantTZ).Format("January 2, 2006") }
			</p>
		</div>
	}
	<!-- Actions -->
	if canPause(props.Subscription.Status) || canResume(props.Subscription.Status) || canCancel(props.Subscription.Status) {
		<div class="mt-6 flex flex-wrap gap-3">
			if canPause(props.Subscription.Status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/pause", props.Subscription.ID.String())) }>
					<button type="submit" class="btn-secondary">Pause</button>
				</form>
			}
			if canResume(props.Subscription.Status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/resume", props.Subscription.ID.String())) }>
					<button type="submit" class="btn-confirm">Resume</button>
				</form>
			}
			if props.Subscription.Status == domain.SubscriptionStatusPastDue {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/retry", props.Subscription.ID.String())) }>
					<button type="submit" class="btn-confirm">Retry payment now</button>
				</form>
			}
			if canCancel(props.Subscription.Status) {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/cancel", props.Subscription.ID.String())) }>
					<button
						type="submit"
						class="btn-danger"
						onclick="return confirm('Cancel this subscription? This cannot be undone.')"
					>
						Cancel Subscription
					</button>
				</form>
			}
		</div>
	}
	<!-- Skip upcoming shipments -->
	if props.Subscription.Status == domain.SubscriptionStatusActive {
		{{ minDate, maxDate, canPickRestart := skipDateBounds(props.Subscription, props.MerchantTZ) }}
		<div class="mt-6 border border-rr-border bg-rr-surface p-4">
			<p class="text-sm font-semibold text-rr-heading">Skip shipments</p>
			<p class="mt-0.5 text-sm text-rr-muted">
				Pushes the next order out without pausing or cancelling. Nothing is charged for the skipped window, and the cadence picks back up from the new date.
			</p>
			{{ restoreTo, canUndo := skipUndoOffer(props.Subscription) }}
			if canUndo {
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/undo-skip", props.Subscription.ID.String())) }
					class="mt-3 flex flex-wrap items-center justify-between gap-3 border border-rr-border bg-rr-raised p-3"
				>
					<p class="text-sm text-rr-heading">
						Skipped to { props.Subscription.NextOrderAt.In(props.MerchantTZ).Format("Jan 2, 2006") }.
						<span class="text-rr-muted">Undo puts the next order back to { restoreTo.In(props.MerchantTZ).Format("Jan 2, 2006") }.</span>
					</p>
					<button type="submit" class="btn-secondary">Undo skip</button>
				</form>
			}
			<!-- Two separate forms, not one with two submit buttons: pressing
			     Enter in the date field would otherwise submit the first button
			     in the form and skip a shipment count nobody chose. -->
			<div class="mt-3 flex flex-wrap items-end gap-x-6 gap-y-3">
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/skip", props.Subscription.ID.String())) }
					class="flex items-end gap-2"
				>
					<input type="hidden" name="skip_mode" value="intervals"/>
					<div>
						<label for="skip-intervals" class="block text-xs font-medium uppercase tracking-wide text-rr-muted">Skip the next</label>
						<select
							id="skip-intervals"
							name="intervals"
							class="mt-1 border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading"
						>
							for _, n := range skipCounts() {
								<option value={ fmt.Sprintf("%d", n) }>{ skipCountLabel(n) }</option>
							}
						</select>
					</div>
					<button type="submit" class="btn-secondary">Skip</button>
				</form>
				if canPickRestart {
					<form
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/skip", props.Subscription.ID.String())) }
						class="flex items-end gap-2"
					>
						<input type="hidden" name="skip_mode" value="date"/>
						<div>
							<label for="skip-resume-on" class="block text-xs font-medium uppercase tracking-wide text-rr-muted">Or restart on</label>
							<input
								id="skip-resume-on"
								type="date"
								name="resume_on"
								required
								min={ minDate }
								max={ maxDate }
								class="mt-1 border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading"
							/>
						</div>
						<button type="submit" class="btn-secondary">Set date</button>
					</form>
					<p class="text-xs text-rr-muted">
						Restart dates run from { minDate } to { maxDate } — after the order already scheduled, and no more than { fmt.Sprintf("%d", domain.SubscriptionMaxSkipDays) } days out.
					</p>
				} else {
					<p class="text-xs text-rr-muted">
						The next order is already more than { fmt.Sprintf("%d", domain.SubscriptionMaxSkipDays) } days out, so there's no restart date to pick — skip by shipment count instead.
					</p>
				}
			</div>
		</div>
	}
	<!-- Renewal shipping exception (grandfather toggle) -->
	if canCancel(props.Subscription.Status) {
		{{ grandfathered := props.Subscription.ShippingGrandfathered() }}
		<div class="mt-6 border border-rr-border bg-rr-surface p-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<p class="text-sm font-semibold text-rr-heading">Renewal shipping</p>
					if grandfathered {
						<p class="mt-0.5 text-sm text-rr-muted">Exempt — renewals ship free for this subscription.</p>
					} else {
						<p class="mt-0.5 text-sm text-rr-muted">Charged on renewal like a retail order (free over the threshold or for local zips).</p>
					}
				</div>
				<div class="flex items-center gap-3">
					if grandfathered {
						<span class="badge-green">Free shipping</span>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/grandfather-shipping", props.Subscription.ID.String())) }>
							<input type="hidden" name="enabled" value="false"/>
							<button type="submit" class="btn-secondary">Remove exception</button>
						</form>
					} else {
						<span class="badge-slate">Standard</span>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/grandfather-shipping", props.Subscription.ID.String())) }>
							<input type="hidden" name="enabled" value="true"/>
							<button type="submit" class="btn-secondary">Grant free shipping</button>
						</form>
					}
				</div>
			</div>
		</div>
	}
	<!-- Product line -->
	if props.Product != nil && props.Variant != nil {
		<div class="mt-6 border border-rr-border bg-rr-surface p-4">
			<div class="flex items-start gap-4">
				if props.ThumbnailURL != "" {
					<a href={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s", props.Product.ID.String())) } class="block shrink-0">
						<img src={ props.ThumbnailURL } alt={ props.Product.Title } class="size-20 rounded-sm border border-rr-border object-cover"/>
					</a>
				} else {
					<div class="size-20 shrink-0 rounded-sm border border-rr-border bg-rr-raised"></div>
				}
				<div class="flex-1">
					<a href={ templ.SafeURL(fmt.Sprintf("/admin/catalog/%s", props.Product.ID.String())) } class="text-base font-semibold text-rr-heading hover:text-rr-red">
						{ props.Product.Title }
					</a>
					if props.Variant.SKU != "" {
						<p class="mt-0.5 text-xs text-rr-muted">SKU { props.Variant.SKU }</p>
					}
					<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
						<span class="text-rr-muted">Quantity: <span class="font-medium text-rr-heading">{ fmt.Sprintf("%d", props.Subscription.Quantity) }</span></span>
						if props.HasUnitPrice {
							<span class="text-rr-muted">Unit: <span class="font-medium text-rr-heading tabular-nums">{ formatCents(props.UnitPrice) }</span></span>
							<span class="text-rr-muted">Per period: <span class="font-semibold text-rr-heading tabular-nums">{ formatCents(props.UnitPrice * props.Subscription.Quantity) }</span></span>
						}
					</div>
					<!-- Grind / variant selector -->
					<div class="mt-3">
						if canChangeSubscriptionVariant(props.Subscription.Status) && len(props.SiblingVariants) > 1 {
							<form
								method="POST"
								action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/variant", props.Subscription.ID.String())) }
								class="flex flex-wrap items-center gap-2"
							>
								<input type="hidden" name="allow_price_change" value="true"/>
								<label class="text-xs font-medium uppercase tracking-wide text-rr-muted">Size / Grind</label>
								<select
									name="variant_id"
									class="border border-rr-border bg-rr-surface px-2 py-1 text-sm text-rr-heading"
								>
									for _, sv := range props.SiblingVariants {
										if sv.ID == props.Variant.ID {
											<option value={ sv.ID.String() } selected>{ sv.Label } — { formatCents(sv.Price) }</option>
										} else {
											<option value={ sv.ID.String() }>{ sv.Label } — { formatCents(sv.Price) }</option>
										}
									}
								</select>
								<button
									type="submit"
									class="border border-rr-border bg-rr-raised px-2 py-1 text-xs font-medium text-rr-heading hover:bg-rr-border"
									onclick="return confirm('Change the size/grind on this subscription? If the new variant is a different price, the per-period charge will change — future renewals use the new variant and its current price. The current pending order (if any) is not updated by this action.')"
								>Save</button>
								<span class="text-xs text-rr-muted">Applies to future renewals only.</span>
							</form>
						} else {
							if props.VariantLabel != "" {
								<p class="text-xs text-rr-muted">Grind: <span class="font-medium text-rr-heading">{ props.VariantLabel }</span></p>
							}
						}
					</div>
				</div>
			</div>
		</div>
	}
	<!-- Schedule + plan stats -->
	<div class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
		<div class="border border-rr-border bg-rr-surface p-4">
			<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Plan</dt>
			<dd class="mt-1 text-sm font-semibold text-rr-heading">{ props.Plan.Name }</dd>
			<dd class="text-xs text-rr-muted">
				{ planCadence(props.Plan) }
				if props.Plan.DiscountPct > 0 {
					<span class="ml-1">· { fmt.Sprintf("%d", props.Plan.DiscountPct) }% off</span>
				}
			</dd>
			if canChangeSubscriptionVariant(props.Subscription.Status) && len(props.AvailablePlans) > 1 {
				<form
					method="POST"
					action={ templ.SafeURL(fmt.Sprintf("/admin/subscriptions/%s/plan", props.Subscription.ID.String())) }
					class="mt-3 flex flex-wrap items-center gap-2"
				>
					<label class="sr-only">Change plan</label>
					<select
						name="plan_id"
						class="w-full border border-rr-border bg-rr-surface px-2 py-1 text-xs text-rr-heading"
					>
						for _, ap := range props.AvailablePlans {
							if ap.ID == props.Plan.ID {
								<option value={ ap.ID.String() } selected>{ planOptionLabel(ap) }</option>
							} else {
								<option value={ ap.ID.String() }>{ planOptionLabel(ap) }</option>
							}
						}
					</select>
					<button
						type="submit"
						class="border border-rr-border bg-rr-raised px-2 py-1 text-xs font-medium text-rr-heading hover:bg-rr-border"
						onclick="return confirm('Change this subscription to the selected plan? The current period and next order date will be recalculated to match the new cadence.')"
					>Save</button>
				</form>
			}
		</div>
		<div class="border border-rr-border bg-rr-surface p-4">
			<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Next Order</dt>
			<dd class="mt-1 text-sm font-semibold text-rr-heading">{ props.Subscription.NextOrderAt.In(props.MerchantTZ).Format("Jan 2, 2006") }</dd>
			<dd class="text-xs text-rr-muted">{ props.Subscription.NextOrderAt.In(props.MerchantTZ).Format("Monday") }</dd>
		</div>
		<div class="border border-rr-border bg-rr-surface p-4">
			<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Current Period</dt>
			<dd class="mt-1 text-sm font-semibold text-rr-heading">
				{ props.Subscription.CurrentPeriodStart.In(props.MerchantTZ).Format("Jan 2") } &ndash; { props.Subscription.CurrentPeriodEnd.In(props.MerchantTZ).Format("Jan 2, 2006") }
			</dd>
		</div>
		<div class="border border-rr-border bg-rr-surface p-4">
			<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Payment</dt>
			if props.Subscription.StripePaymentMethodID != nil && *props.Subscription.StripePaymentMethodID != "" {
				<dd class="mt-1 text-sm font-semibold text-rr-heading">Card on file</dd>
				<dd class="text-xs text-rr-muted"><code>{ *props.Subscription.StripePaymentMethodID }</code></dd>
			} else {
				<dd class="mt-1 text-sm font-semibold text-rr-heading">&mdash;</dd>
				<dd class="text-xs text-rr-muted">No payment method</dd>
			}
		</div>
	</div>
	<!-- Customer + shipping -->
	<div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
		<div class="border border-rr-border bg-rr-surface p-4">
			<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Customer</dt>
			<dd class="mt-1 text-sm font-semibold text-rr-heading">
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", props.Customer.ID.String())) } class="text-rr-red hover:text-rr-red-lt">
					{ props.Customer.FirstName } { props.Customer.LastName }
				</a>
			</dd>
			<dd class="text-xs text-rr-muted">{ props.Customer.Email }</dd>
			if props.Customer.Phone != nil && *props.Customer.Phone != "" {
				<dd class="text-xs text-rr-muted">{ *props.Customer.Phone }</dd>
			}
		</div>
		<div class="border border-rr-border bg-rr-surface p-4">
			<dt class="text-xs font-medium uppercase tracking-wide text-rr-muted">Ship to</dt>
			if props.ShippingAddress != nil {
				<address class="mt-1 text-sm text-rr-heading not-italic">
					<p class="font-medium">{ props.ShippingAddress.FirstName } { props.ShippingAddress.LastName }</p>
					if props.ShippingAddress.Company != nil && *props.ShippingAddress.Company != "" {
						<p class="text-rr-muted">{ *props.ShippingAddress.Company }</p>
					}
					<p class="text-rr-muted">{ props.ShippingAddress.Line1 }</p>
					if props.ShippingAddress.Line2 != nil && *props.ShippingAddress.Line2 != "" {
						<p class="text-rr-muted">{ *props.ShippingAddress.Line2 }</p>
					}
					<p class="text-rr-muted">{ props.ShippingAddress.City }, { props.ShippingAddress.State } { props.ShippingAddress.PostalCode }</p>
				</address>
			} else {
				<dd class="mt-1 text-sm text-rr-muted">No shipping address on file</dd>
			}
		</div>
	</div>
	<!-- Renewal orders -->
	<div class="mt-8">
		<h2 class="text-sm font-semibold text-rr-heading">Renewal orders</h2>
		if len(props.Orders) == 0 {
			<p class="mt-2 text-sm text-rr-muted">No renewal orders yet.</p>
		} else {
			<div class="mt-2 overflow-hidden border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Order</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">Period</th>
							<th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-rr-heading">Total</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, so := range props.Orders {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
									<a
										href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s", so.OrderID.String())) }
										class="font-medium text-rr-red hover:text-rr-red-lt"
									>
										if so.OrderNumber != "" {
											{ so.OrderNumber }
										} else {
											{ so.OrderID.String()[:8] }
										}
									</a>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									if string(so.OrderStatus) != "" {
										@OrderStatusBadge(so.OrderStatus)
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									{ so.PeriodStart.In(props.MerchantTZ).Format("Jan 2") } &ndash; { so.PeriodEnd.In(props.MerchantTZ).Format("Jan 2, 2006") }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-right text-sm text-rr-heading tabular-nums">
									if so.OrderTotal > 0 {
										{ formatCents(so.OrderTotal) }
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
	@SubscriptionTimeline(props.Activity, props.MerchantTZ)
}

templ SubscriptionShow(props SubscriptionShowProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      fmt.Sprintf("%s — %s %s", props.Plan.Name, props.Customer.FirstName, props.Customer.LastName),
		ActivePath: "/admin/subscriptions",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@SubscriptionShowContent(props)
	}
}
