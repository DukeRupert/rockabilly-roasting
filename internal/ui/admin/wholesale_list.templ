package admin

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type WholesaleListProps struct {
	Customers    []domain.Customer
	StatusFilter string
	Page         int
	HasMore      bool
	StaffName    string
	StaffRole    string
}

func wholesaleFilterClasses(current, filter string) string {
	if current == filter {
		return "inline-flex items-center rounded-md bg-hiri-teal px-3 py-2 text-sm font-semibold text-white shadow-sm"
	}
	return "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
}

templ WholesaleListContent(props WholesaleListProps) {
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="text-base/7 font-semibold text-stone-900">Wholesale</h1>
			<p class="mt-1 text-sm text-stone-500">Manage wholesale applications and accounts</p>
		</div>
	</div>
	<!-- Status filters -->
	<div class="mt-4 flex gap-2">
		<a href="/admin/wholesale?status=pending" class={ wholesaleFilterClasses(props.StatusFilter, "pending") }>
			Pending
		</a>
		<a href="/admin/wholesale?status=approved" class={ wholesaleFilterClasses(props.StatusFilter, "approved") }>
			Approved
		</a>
		<a href="/admin/wholesale?status=suspended" class={ wholesaleFilterClasses(props.StatusFilter, "suspended") }>
			Suspended
		</a>
	</div>
	<!-- Applications table -->
	<div class="mt-6">
		if len(props.Customers) == 0 {
			<div class="rounded-lg border-2 border-dashed border-stone-300 p-12 text-center">
				<svg class="mx-auto size-12 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"></path>
				</svg>
				<h3 class="mt-2 text-sm font-semibold text-stone-900">No { props.StatusFilter } applications</h3>
				<p class="mt-1 text-sm text-stone-500">
					if props.StatusFilter == "pending" {
						New wholesale applications will appear here.
					} else {
						No wholesale accounts with this status.
					}
				</p>
			</div>
		} else {
			<div class="overflow-hidden rounded-lg bg-white shadow-xs ring-1 ring-stone-900/5">
				<table class="min-w-full divide-y divide-stone-300">
					<thead class="bg-stone-50">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-stone-900 sm:pl-6">Company</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Contact</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-stone-900 sm:table-cell">Email</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-stone-900 lg:table-cell">Applied</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-stone-900">Status</th>
							<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
								<span class="sr-only">Actions</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-200 bg-white">
						for _, c := range props.Customers {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-stone-900 sm:pl-6">
									if c.CompanyName != nil {
										{ *c.CompanyName }
									} else {
										<span class="text-stone-400">&mdash;</span>
									}
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-stone-500">
									{ c.FirstName } { c.LastName }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-stone-500 sm:table-cell">
									{ c.Email }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-stone-500 lg:table-cell">
									{ c.CreatedAt.Format("Jan 2, 2006") }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									if c.WholesaleStatus != nil {
										@WholesaleStatusBadge(*c.WholesaleStatus)
									}
								</td>
								<td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
									<div class="flex items-center justify-end gap-2">
										if c.WholesaleStatus != nil && *c.WholesaleStatus == domain.WholesaleStatusPending {
											<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/approve", c.ID)) }>
												<button type="submit" class="text-green-600 hover:text-green-900">Approve</button>
											</form>
											<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/decline", c.ID)) }>
												<button type="submit" class="text-red-600 hover:text-red-900" onclick="return confirm('Decline this application?')">Decline</button>
											</form>
										}
										if c.WholesaleStatus != nil && *c.WholesaleStatus == domain.WholesaleStatusApproved {
											<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/suspend", c.ID)) }>
												<button type="submit" class="text-red-600 hover:text-red-900" onclick="return confirm('Suspend this wholesale account?')">Suspend</button>
											</form>
										}
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", c.ID)) } class="text-hiri-teal hover:text-hiri-teal-dark">
											View
										</a>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-stone-200 px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/wholesale?status=%s&page=%d", props.StatusFilter, props.Page-1)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Previous
						</a>
					}
				</div>
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/wholesale?status=%s&page=%d", props.StatusFilter, props.Page+1)) }
							class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-stone-900 ring-1 ring-inset ring-stone-300 hover:bg-stone-50"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

templ WholesaleList(props WholesaleListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Wholesale",
		ActivePath: "/admin/wholesale",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@WholesaleListContent(props)
	}
}
