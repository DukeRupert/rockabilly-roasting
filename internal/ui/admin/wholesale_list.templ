package admin

import (
	"fmt"
	"time"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// priceListLabel resolves a customer's assigned price list to a display name,
// falling back to "Base prices" when none is set (or a dash if the referenced
// list is no longer in the supplied set).
func priceListLabel(id *uuid.UUID, lists []domain.PriceList) string {
	if id == nil {
		return "Base prices"
	}
	for _, pl := range lists {
		if pl.ID == *id {
			return pl.Name
		}
	}
	return "—"
}

type WholesaleListProps struct {
	Customers    []domain.Customer
	PriceLists   []domain.PriceList // available lists for the per-applicant pricing selector
	StatusFilter string
	Counts       map[string]int // per-status counts for the filter-bar badges, keyed by status (plus "all")
	Page         int
	HasMore      bool
	MerchantTZ   *time.Location
	StaffName    string
	StaffRole    string
}

// wholesaleFilter is one entry in the status filter bar.
type wholesaleFilter struct {
	Value string
	Label string
}

// wholesaleFilters lists the filter pills in display order. "all" leads as the
// default overview; the rest narrow to a single wholesale status.
var wholesaleFilters = []wholesaleFilter{
	{"all", "All"},
	{"pending", "Pending"},
	{"approved", "Approved"},
	{"suspended", "Suspended"},
	{"declined", "Declined"},
}

// wholesaleFilterClasses styles a filter pill. The active pill echoes the admin
// active-nav convention (raised paper + rust text) rather than a solid red fill
// — red is reserved for actions (Approve/Decline/Suspend), not "which tab am I on".
func wholesaleFilterClasses(current, filter string) string {
	if current == filter {
		return "inline-flex items-center gap-1.5 rounded-sm bg-rr-raised px-3 py-2 text-sm font-semibold text-rr-red border border-rr-border"
	}
	return "inline-flex items-center gap-1.5 rounded-sm bg-rr-surface px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
}

templ WholesaleListContent(props WholesaleListProps) {
	@adminSectionTabs(customersTabs(), "/admin/wholesale")
	<!-- Page header -->
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Wholesale</h1>
			<p class="mt-1 text-sm text-rr-muted">Manage wholesale applications and accounts</p>
		</div>
	</div>
	<!-- Status filters -->
	<div class="mt-4 flex flex-wrap gap-2">
		for _, f := range wholesaleFilters {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/admin/wholesale?status=%s", f.Value)) }
				class={ wholesaleFilterClasses(props.StatusFilter, f.Value) }
				if props.StatusFilter == f.Value {
					aria-current="page"
				}
			>
				{ f.Label }
				<span class="text-xs font-normal text-rr-muted tabular-nums">{ fmt.Sprintf("%d", props.Counts[f.Value]) }</span>
			</a>
		}
	</div>
	<!-- Applications table -->
	<div class="mt-6">
		if len(props.Customers) == 0 {
			<div class="border border-dashed border-rr-border p-12 text-center">
				<svg class="mx-auto size-12 text-rr-border" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"></path>
				</svg>
				switch props.StatusFilter {
					case "all":
						<h3 class="mt-2 text-sm font-semibold text-rr-heading">No wholesale accounts yet</h3>
						<p class="mt-1 text-sm text-rr-muted">Applications will appear here as cafes and offices apply.</p>
					case "pending":
						<h3 class="mt-2 text-sm font-semibold text-rr-heading">No applications waiting</h3>
						<p class="mt-1 text-sm text-rr-muted">Inbox zero. New wholesale applications land here for review.</p>
						if props.Counts["all"] > 0 {
							<a href="/admin/wholesale?status=all" class="mt-3 inline-block text-sm font-semibold text-rr-red hover:text-rr-red-lt">
								{ fmt.Sprintf("View all %d wholesale accounts", props.Counts["all"]) } &rarr;
							</a>
						}
					default:
						<h3 class="mt-2 text-sm font-semibold text-rr-heading">No { props.StatusFilter } accounts</h3>
						<a href="/admin/wholesale?status=all" class="mt-3 inline-block text-sm font-semibold text-rr-red hover:text-rr-red-lt">
							{ fmt.Sprintf("View all %d wholesale accounts", props.Counts["all"]) } &rarr;
						</a>
				}
			</div>
		} else {
			<div class="overflow-visible border border-rr-border bg-rr-surface">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-raised">
						<tr>
							<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Company</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading sm:table-cell">Contact</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading md:table-cell">Email</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading lg:table-cell">Terms</th>
							<th scope="col" class="hidden px-3 py-3.5 text-left text-sm font-semibold text-rr-heading 2xl:table-cell">Applied</th>
							<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Price list</th>
							if props.StatusFilter == "all" {
								<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Status</th>
							}
							<th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
								<span class="sr-only">Actions</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border bg-rr-surface">
						for _, c := range props.Customers {
							<tr>
								<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-rr-heading sm:pl-6">
									if c.CompanyName != nil {
										{ *c.CompanyName }
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted sm:table-cell">
									{ c.FirstName } { c.LastName }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted md:table-cell">
									{ c.Email }
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted lg:table-cell">
									if c.PaymentTermsDays != nil {
										{ fmt.Sprintf("Net %d", *c.PaymentTermsDays) }
									} else {
										<span class="text-rr-border">&mdash;</span>
									}
								</td>
								<td class="hidden whitespace-nowrap px-3 py-4 text-sm text-rr-muted 2xl:table-cell">
									{ c.CreatedAt.In(props.MerchantTZ).Format("Jan 2, 2006") }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									@wholesalePriceListCell(c, props.PriceLists, props.StatusFilter)
								</td>
								if props.StatusFilter == "all" {
									<td class="whitespace-nowrap px-3 py-4 text-sm">
										if c.WholesaleStatus != nil {
											@WholesaleStatusBadge(*c.WholesaleStatus)
										}
									</td>
								}
								<td class="whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
									@wholesaleRowActions(c)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Pagination -->
			<nav class="flex items-center justify-between border-t border-rr-border px-4 pt-4 sm:px-0" aria-label="Pagination">
				<div class="-mt-px flex w-0 flex-1">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/wholesale?status=%s&page=%d", props.StatusFilter, props.Page-1)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Previous
						</a>
					}
				</div>
				<div class="-mt-px flex w-0 flex-1 justify-end">
					if props.HasMore {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/admin/wholesale?status=%s&page=%d", props.StatusFilter, props.Page+1)) }
							class="inline-flex items-center rounded-sm px-3 py-2 text-sm font-semibold text-rr-heading border border-rr-border hover:bg-rr-raised"
						>
							Next
						</a>
					}
				</div>
			</nav>
		}
	</div>
}

// wholesalePriceListCell renders the per-applicant pricing control. Pending
// applications get an inline auto-submitting selector so staff can assign a price
// list before approving; other statuses show the assigned list read-only (it
// stays editable on the customer profile). The hidden status field lets the
// handler redirect back to the current filter view.
templ wholesalePriceListCell(c domain.Customer, priceLists []domain.PriceList, statusFilter string) {
	if c.WholesaleStatus != nil && *c.WholesaleStatus == domain.WholesaleStatusPending {
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/price-list", c.ID)) }>
			<input type="hidden" name="status" value={ statusFilter }/>
			<label class="sr-only" for={ fmt.Sprintf("pl-%s", c.ID) }>Price list</label>
			<div class="grid grid-cols-1">
				<select
					id={ fmt.Sprintf("pl-%s", c.ID) }
					name="price_list_id"
					onchange="this.form.submit()"
					class="col-start-1 row-start-1 w-full min-w-36 appearance-none rounded-sm bg-rr-surface py-1.5 pl-3 pr-8 text-sm text-rr-heading outline-1 -outline-offset-1 outline-rr-border focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red"
				>
					<option value="" selected?={ c.PriceListID == nil }>Base prices</option>
					for _, pl := range priceLists {
						<option value={ pl.ID.String() } selected?={ c.PriceListID != nil && *c.PriceListID == pl.ID }>
							{ pl.Name }
							if pl.Status != domain.PriceListStatusActive {
								({ string(pl.Status) })
							}
						</option>
					}
				</select>
				<svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-rr-muted sm:size-4" viewBox="0 0 16 16" fill="currentColor">
					<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
				</svg>
			</div>
		</form>
	} else {
		<span class="text-rr-muted">{ priceListLabel(c.PriceListID, priceLists) }</span>
	}
}

// wholesaleRowActions renders the per-row action controls. xl+ shows the
// full inline button stack (Approve/Decline, Suspend, Reactivate, View);
// below xl falls back to a kebab menu so the actions stay reachable on
// narrow viewports where the table would otherwise clip them.
templ wholesaleRowActions(c domain.Customer) {
	<!-- Inline buttons: xl+ (~1280px). Hidden below to avoid horizontal overflow. -->
	<div class="hidden xl:flex items-center justify-end gap-3">
		if c.WholesaleStatus != nil && *c.WholesaleStatus == domain.WholesaleStatusPending {
			<div class="inline-flex gap-2">
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/approve", c.ID)) }>
					<button type="submit" class="btn-confirm">Approve</button>
				</form>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/decline", c.ID)) }>
					<button type="submit" class="btn-danger" onclick="return confirm('Decline this application?')">Decline</button>
				</form>
			</div>
		}
		if c.WholesaleStatus != nil && *c.WholesaleStatus == domain.WholesaleStatusApproved {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/suspend", c.ID)) }>
				<button type="submit" class="btn-danger" onclick="return confirm('Suspend this wholesale account?')">Suspend</button>
			</form>
		}
		if c.WholesaleStatus != nil && *c.WholesaleStatus == domain.WholesaleStatusSuspended {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/reactivate", c.ID)) }>
				<button type="submit" class="btn-confirm" onclick="return confirm('Reactivate this wholesale account? A new setup email will be sent.')">Reactivate</button>
			</form>
		}
		<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", c.ID)) } class="text-rr-red hover:text-rr-red-lt">
			View
		</a>
	</div>
	<!-- Kebab dropdown: visible below xl. Same actions, packed into a popover. -->
	<div class="xl:hidden flex justify-end relative" x-data="{ open: false }">
		<button
			type="button"
			x-on:click="open = !open"
			x-bind:aria-expanded="open"
			aria-haspopup="true"
			aria-label="Actions"
			class="inline-flex items-center justify-center rounded-sm border border-rr-border bg-rr-surface p-1.5 text-rr-heading hover:bg-rr-raised"
		>
			<svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
				<path d="M10 3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm0 5.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm0 5.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Z"></path>
			</svg>
		</button>
		<div
			x-show="open"
			x-cloak
			x-transition.opacity
			x-on:click.outside="open = false"
			x-on:keydown.escape.window="open = false"
			class="absolute right-0 top-full z-30 mt-1 w-48 border border-rr-border bg-rr-surface py-1 text-left"
			style="box-shadow: 4px 4px 0 0 var(--color-rr-border);"
			role="menu"
		>
			if c.WholesaleStatus != nil && *c.WholesaleStatus == domain.WholesaleStatusPending {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/approve", c.ID)) }>
					<button type="submit" role="menuitem" class="block w-full px-3 py-2 text-left text-sm text-rr-heading hover:bg-rr-raised">Approve</button>
				</form>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/decline", c.ID)) }>
					<button type="submit" role="menuitem" onclick="return confirm('Decline this application?')" class="block w-full px-3 py-2 text-left text-sm text-rr-red hover:bg-rr-raised">Decline</button>
				</form>
			}
			if c.WholesaleStatus != nil && *c.WholesaleStatus == domain.WholesaleStatusApproved {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/suspend", c.ID)) }>
					<button type="submit" role="menuitem" onclick="return confirm('Suspend this wholesale account?')" class="block w-full px-3 py-2 text-left text-sm text-rr-red hover:bg-rr-raised">Suspend</button>
				</form>
			}
			if c.WholesaleStatus != nil && *c.WholesaleStatus == domain.WholesaleStatusSuspended {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/wholesale/%s/reactivate", c.ID)) }>
					<button type="submit" role="menuitem" onclick="return confirm('Reactivate this wholesale account? A new setup email will be sent.')" class="block w-full px-3 py-2 text-left text-sm text-rr-heading hover:bg-rr-raised">Reactivate</button>
				</form>
			}
			<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", c.ID)) } role="menuitem" class="block px-3 py-2 text-sm text-rr-heading hover:bg-rr-raised">
				View customer
			</a>
		</div>
	</div>
}

templ WholesaleList(props WholesaleListProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Wholesale",
		ActivePath: "/admin/wholesale",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@WholesaleListContent(props)
	}
}
