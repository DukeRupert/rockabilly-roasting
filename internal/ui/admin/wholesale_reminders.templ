package admin

import (
	"fmt"
	"strconv"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type WholesaleRemindersProps struct {
	// Recipients is exactly who the next scheduled run would email — the same
	// query the scheduler uses, so this page is a true dry run.
	Recipients  []domain.OrderReminderRecipient
	WindowDays  int
	CutoffLabel string
	ScheduleNote string
	// Sent is set after a notice send, so staff get confirmation of the count.
	Sent      int
	StaffName string
	StaffRole string
}

templ WholesaleRemindersContent(props WholesaleRemindersProps) {
	@adminSectionTabs(customersTabs(), "/admin/wholesale/reminders")
	<div class="sm:flex sm:items-center">
		<div class="sm:flex-auto">
			<h1 class="admin-page-title">Order Reminders</h1>
			<p class="mt-1 text-sm text-rr-muted">
				{ props.ScheduleNote } Accounts qualify when they placed a wholesale order in the last { strconv.Itoa(props.WindowDays) } days and have reminders switched on.
			</p>
		</div>
	</div>
	if props.Sent > 0 {
		<div class="mt-6 border border-rr-border bg-rr-raised p-4">
			<p class="text-sm text-rr-heading">Queued { strconv.Itoa(props.Sent) } messages. They send in the background — check the audit log for per-recipient results.</p>
		</div>
	}
	<!-- Preview: who is on this week's list -->
	<div class="mt-8">
		<h2 class="text-sm font-semibold text-rr-heading">
			Next send &mdash; { strconv.Itoa(len(props.Recipients)) } recipients
		</h2>
		<p class="mt-1 text-sm text-rr-muted">Cutoff wording in the email: &ldquo;{ props.CutoffLabel }&rdquo;.</p>
		<div class="mt-3">
			if len(props.Recipients) == 0 {
				<div class="border border-dashed border-rr-border p-12 text-center">
					<h3 class="text-sm font-semibold text-rr-heading">Nobody is on the list</h3>
					<p class="mt-1 text-sm text-rr-muted">No approved wholesale account has ordered inside the window. Nothing will send.</p>
				</div>
			} else {
				<div class="overflow-hidden border border-rr-border bg-rr-surface">
					<table class="min-w-full divide-y divide-rr-border">
						<thead class="bg-rr-raised">
							<tr>
								<th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-rr-heading sm:pl-6">Company</th>
								<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Email</th>
								<th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-rr-heading">Last order</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-rr-border bg-rr-surface">
							for _, r := range props.Recipients {
								<tr class="row-link">
									<td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
										<a href={ templ.SafeURL(fmt.Sprintf("/admin/customers/%s", r.CustomerID)) } class="row-link-target font-medium text-rr-heading hover:text-rr-red">
											{ r.DisplayName() }
										</a>
									</td>
									<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">{ r.Email }</td>
									<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-muted">{ r.LastOrderAt.Format("Jan 2, 2006") }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
	<!-- One-off notice to the same audience -->
	<div class="mt-10 border-t border-rr-border pt-8">
		<h2 class="text-sm font-semibold text-rr-heading">Send a one-off notice</h2>
		<p class="mt-1 text-sm text-rr-muted">
			Goes to every approved wholesale account listed above &mdash; use it for a corrected cutoff or a holiday schedule, not marketing. Plain text only; blank lines start a new paragraph. Every send is recorded in the audit log.
		</p>
		<form method="post" action="/admin/wholesale/reminders/notice" class="mt-4 max-w-2xl space-y-4">
			<div>
				<label for="subject" class="block text-sm/6 font-medium text-rr-heading">Subject</label>
				<div class="mt-2">
					<input
						type="text"
						name="subject"
						id="subject"
						required
						maxlength="120"
						placeholder="e.g. Holiday cutoff: order by Wednesday this week"
						class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"
					/>
				</div>
			</div>
			<div>
				<label for="body" class="block text-sm/6 font-medium text-rr-heading">Message</label>
				<div class="mt-2">
					<textarea
						name="body"
						id="body"
						rows="8"
						required
						class="block w-full rounded-sm bg-rr-surface px-3 py-1.5 text-base text-rr-heading outline-1 -outline-offset-1 outline-rr-border placeholder:text-rr-muted focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"
					></textarea>
				</div>
			</div>
			<button
				type="submit"
				class="rounded-sm bg-rr-red px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
				onclick="return confirm('Send this notice to every wholesale account listed above? This cannot be undone.')"
			>
				Send to { strconv.Itoa(len(props.Recipients)) } accounts
			</button>
		</form>
	</div>
}

templ WholesaleReminders(props WholesaleRemindersProps) {
	@layouts.Admin(layouts.AdminProps{
		Title:      "Order Reminders",
		ActivePath: "/admin/customers",
		StaffName:  props.StaffName,
		StaffRole:  props.StaffRole,
	}) {
		@WholesaleRemindersContent(props)
	}
}
