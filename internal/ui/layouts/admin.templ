package layouts

import (
	"fmt"
	"strings"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/components/icon"
	"github.com/dukerupert/hiri/internal/ui/utils"
)

// pluralSuffix returns "s" for any count but one. Local to layouts — admin has its
// own twin (pluralS) and neither package imports the other.
func pluralSuffix(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}

type AdminProps struct {
	Title      string
	ActivePath string
	StaffName  string
	StaffRole  string
}

type navItem struct {
	Label  string
	Href   string
	IconFn func(...icon.Props) templ.Component
}

// adminNavItems is the flat primary sidebar — seven daily-use destinations.
// Second-level pages (categories, attributes, groups, price lists, plans,
// wholesale orders/fulfillment) no longer get their own row; they live behind
// the in-page section tabs / channel toggles of these parents. Settings, the
// audit log, and help moved to the user menu — they're occasional, not daily.
func adminNavItems() []navItem {
	return []navItem{
		{Label: "Dashboard", Href: "/admin", IconFn: icon.LayoutDashboard},
		{Label: "Orders", Href: "/admin/orders", IconFn: icon.ShoppingCart},
		{Label: "Fulfillment", Href: "/admin/fulfillment", IconFn: icon.Truck},
		{Label: "Catalog", Href: "/admin/catalog", IconFn: icon.Package},
		{Label: "Customers", Href: "/admin/customers", IconFn: icon.Users},
		{Label: "Subscriptions", Href: "/admin/subscriptions", IconFn: icon.Repeat},
		{Label: "Discounts", Href: "/admin/discounts", IconFn: icon.Tag},
	}
}

// resolveActiveNav maps any admin path to the sidebar row that should be lit.
// Sub-pages reached through section tabs (e.g. /admin/categories) or the
// wholesale channel (/admin/orders/wholesale, /admin/wholesale/fulfillment)
// resolve to their parent. Keep this in sync with the JS twin in the page
// script — both must agree so server render and post-htmx highlight match.
// Order matters: the wholesale-fulfillment case is checked before the generic
// /admin/wholesale → Customers case so it doesn't get mis-bucketed.
func resolveActiveNav(path string) string {
	switch {
	case path == "/admin":
		return "/admin"
	case strings.HasPrefix(path, "/admin/orders"):
		return "/admin/orders"
	case path == "/admin/fulfillment" || strings.HasPrefix(path, "/admin/fulfillment/") ||
		strings.HasPrefix(path, "/admin/wholesale/fulfillment"):
		return "/admin/fulfillment"
	case strings.HasPrefix(path, "/admin/catalog") ||
		strings.HasPrefix(path, "/admin/categories") ||
		strings.HasPrefix(path, "/admin/attributes") ||
		strings.HasPrefix(path, "/admin/price-lists"):
		return "/admin/catalog"
	case strings.HasPrefix(path, "/admin/customers") ||
		strings.HasPrefix(path, "/admin/groups") ||
		strings.HasPrefix(path, "/admin/wholesale"):
		return "/admin/customers"
	case strings.HasPrefix(path, "/admin/subscriptions") ||
		strings.HasPrefix(path, "/admin/plans"):
		return "/admin/subscriptions"
	case strings.HasPrefix(path, "/admin/discounts"):
		return "/admin/discounts"
	}
	return path
}

func staffInitials(name string) string {
	parts := strings.Fields(name)
	if len(parts) == 0 {
		return "?"
	}
	if len(parts) == 1 {
		return strings.ToUpper(string([]rune(parts[0])[0:1]))
	}
	return strings.ToUpper(string([]rune(parts[0])[0:1]) + string([]rune(parts[len(parts)-1])[0:1]))
}

func navItemClasses(active bool) string {
	if active {
		return "group flex items-center gap-x-3 rounded-sm bg-rr-raised p-1.5 text-sm font-semibold text-rr-heading"
	}
	return "group flex items-center gap-x-3 rounded-sm p-1.5 text-sm font-medium text-rr-body hover:bg-rr-raised hover:text-rr-heading"
}

func navIconColor(active bool) string {
	if active {
		return "size-5 shrink-0 text-rr-heading"
	}
	return "size-5 shrink-0 text-rr-muted group-hover:text-rr-heading"
}

// adminNav is the single source of truth for the sidebar link list, shared by
// the mobile drawer and the desktop rail so they can't drift. The
// data-sidebar-label spans let the desktop collapse toggle fade the text to an
// icon-only rail; the mobile drawer never collapses, so they simply stay shown.
// CatalogNavBadge is the white-label review count painted on the Catalog sidebar
// row. It polls itself rather than relying on the page render: admin navigation is
// htmx with hx-target="#main-content", so the sidebar is only rebuilt on a full
// page load. Without the poll a submission arriving mid-session would stay
// invisible until the staff member happened to hard-refresh — the exact failure
// the badge exists to prevent.
//
// It always renders, count or not, so there is something for htmx to swap.
//
// hx-target="this" is load-bearing: <body> carries hx-target="#main-content"
// for hx-boost, and hx-target inherits. Without the explicit override the poll
// swapped its own tiny fragment over the entire main-content div, blanking the
// page (and destroying the boost target) after the first tick.
// Exported because web serves it as a standalone fragment at /admin/nav-badges.
//
// data-sidebar-badge is the hook the collapsed rail uses to drop ml-auto. An
// auto margin absorbs all free space and outranks justify-content, so without
// that override this wrapper — which renders even at count 0 — shoves the
// Catalog icon to the left edge while every other icon stays centred.
templ CatalogNavBadge(count int) {
	<span
		id="nav-badge-white-label"
		data-sidebar-badge
		hx-get="/admin/nav-badges"
		hx-trigger="every 60s"
		hx-target="this"
		hx-swap="outerHTML"
		class="ml-auto"
	>
		if count > 0 {
			<span
				data-sidebar-label
				class="badge badge-indigo transition-opacity duration-200"
				title={ fmt.Sprintf("%d white-label submission%s awaiting review", count, pluralSuffix(count)) }
			>
				{ fmt.Sprintf("%d", count) }
			</span>
		}
	</span>
}

templ adminNav(activePath string) {
	{{ badges := domain.AdminBadgesFrom(ctx) }}
	<nav data-admin-sidebar-nav class="flex flex-1 flex-col">
		<ul role="list" class="-mx-2 flex flex-1 flex-col gap-y-1">
			for _, item := range adminNavItems() {
				<li>
					<a href={ templ.SafeURL(item.Href) } title={ item.Label } class={ navItemClasses(resolveActiveNav(activePath) == item.Href) }>
						@item.IconFn(icon.Props{Class: navIconColor(resolveActiveNav(activePath) == item.Href)})
						<span data-sidebar-label class="transition-opacity duration-200">{ item.Label }</span>
						if item.Href == "/admin/catalog" {
							@CatalogNavBadge(badges.WhiteLabelPending)
						}
					</a>
				</li>
			}
		</ul>
	</nav>
}

templ Admin(props AdminProps) {
	<!DOCTYPE html>
	<html lang="en" class="h-full" style="background:#F6EFE1;">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title } - Rockabilly Roasting Admin</title>
			<link rel="icon" type="image/svg+xml" href="/static/rockabilly-logo.svg"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png"/>
			<link rel="manifest" href="/static/site.webmanifest"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Inter:wght@400;500;600;700&family=Special+Elite&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<!-- First-party admin scripts go through ScriptURL so a deploy busts
			     the browser cache. /static is served with max-age=3600 and these
			     filenames are not content-hashed, so without the ?v= stamp a JS
			     change can take an hour to reach staff — and admin-confirm.js is
			     what makes the confirmation dialogs work. -->
			<script defer src={ utils.ScriptURL("/static/js/image-uploader.js") }></script>
			<script defer src="/static/js/chart.min.js"></script>
			<script defer src={ utils.ScriptURL("/static/js/admin-charts.js") }></script>
			<!-- Registers Alpine.data('adminConfirm'); must load BEFORE alpine.min.js
			     so its alpine:init listener is attached in time. -->
			<script defer src={ utils.ScriptURL("/static/js/admin-confirm.js") }></script>
			<script defer src="/static/js/alpine.min.js"></script>
			<script src="/static/js/htmx.min.js"></script>
			<style>[x-cloak] { display: none !important; }</style>
			<style>
				/* Admin — warm professional. A working tool, not a brand showcase.
				   Overrides the rr-* tokens so existing utility classes (bg-rr-surface,
				   text-rr-heading, etc.) pick up the quieter palette without per-page
				   rewrites. Rust/amber are kept as accent vars but reserved for
				   primary CTAs and row affordances — never chrome. */
				:root {
					/* Surfaces are warm, and each step must be visible against the
					   NEXT one out. The page is kraft paper (#F6EFE1, set inline on
					   <html> above) — nothing in the content area paints bg-rr-bg, so
					   paper is what every "raised" element actually sits on. The old
					   cool-grey raised (#F0EEE8) was picked against a #FAFAF6 page
					   that never renders; on paper it was a ~2% step and vanished. */
					--color-rr-bg: #F6EFE1 !important;       /* kraft paper — matches <html> */
					--color-rr-surface: #FFFBF1 !important;  /* cream-hi — elevated, still paper */
					--color-rr-raised: #ECE0C6 !important;   /* paper-warm recess */
					--color-rr-border: #DCD1B8 !important;   /* hairline rule */
					--color-rr-muted: #6B6862 !important;    /* muted text */
					--color-rr-body: #1A1A1A !important;     /* soft ink body */
					--color-rr-heading: #0E0D0C !important;  /* ink */
					--color-rr-red: #B4351D !important;      /* rust — primary CTA only */
					--color-rr-red-lt: #D4492D !important;   /* rust hover */
					--color-rr-red-dark: #8A240F !important; /* rust pressed */
					--color-rr-amber: #F2A03D !important;    /* candle — row affordances */
					--color-rr-brick: #8A4A30 !important;    /* unused in chrome */
					/* Redirect the Oswald token to Inter inside admin — any existing
					   `font-oswald` utility on an admin page renders as Inter without
					   per-file rewrites. Storefront keeps the real Oswald. */
					--font-oswald: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif !important;
				}
				body { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif; -webkit-font-smoothing: antialiased; }
				/* label-font uses a hardcoded family in input.css; override inside admin. */
				.label-font {
					font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
					font-weight: 600 !important;
					letter-spacing: 0.06em !important;
					font-size: 0.6875rem !important;
				}
				/* ── Desktop sidebar collapse ──
				   One attribute (`.is-collapsed`) drives the whole transition on a
				   single 200ms timeline so width, padding, labels and icon centering
				   never desync. Each label collapses its OWN max-width in lock-step
				   (and never wraps), so the icon column is never shoved by reflowing
				   text — the layout-shift that made the old fade look janky. Scoped to
				   lg+ since collapse is desktop-only; the [data-dropdown-trigger] match
				   is the user-menu avatar, kept inside #desktop-sidebar so the
				   always-expanded mobile drawer is untouched. */
				@media (min-width: 1024px) {
					#desktop-sidebar { transition: width 200ms ease; }
					#desktop-sidebar-inner { transition: padding 200ms ease; }
					#main-content-wrapper { transition: padding 200ms ease; }

					#desktop-sidebar [data-sidebar-label] {
						white-space: nowrap;
						overflow: hidden;
						max-width: 12rem;
						opacity: 1;
						transition: max-width 200ms ease, opacity 200ms ease;
					}
					#desktop-sidebar.is-collapsed [data-sidebar-label] {
						max-width: 0;
						opacity: 0;
					}

					/* Collapsed rail: center the icon column, the header chevron and the
					   user avatar so the 64px rail reads as a tidy stack, not a
					   left-ragged one. */
					#desktop-sidebar.is-collapsed nav[data-admin-sidebar-nav] a,
					#desktop-sidebar.is-collapsed [data-sidebar-header],
					#desktop-sidebar.is-collapsed [data-sidebar-toggle],
					#desktop-sidebar.is-collapsed [data-dropdown-trigger] {
						justify-content: center;
						gap: 0;
					}
					/* The Catalog row carries a badge wrapper pinned right with
					   ml-auto. An auto margin absorbs all free space and outranks
					   justify-content, so the rule above can't centre that row until
					   the margin is gone. The wrapper renders at any count (htmx needs
					   a swap target), so this is not conditional on a pending review.

					   display:none rather than margin-left:0 alone: when a review IS
					   pending the inner pill is a data-sidebar-label, and that only
					   collapses max-width — its horizontal padding survives and still
					   contributes ~20px, pushing the icon back off-centre. Taking the
					   wrapper out of layout entirely is the only width-proof answer.
					   Polling is unaffected; hx-trigger timers run on hidden elements,
					   so the count is current the moment the rail is expanded. */
					#desktop-sidebar.is-collapsed [data-sidebar-badge] {
						display: none;
					}

					/* The chevron points "<" to collapse; flip it to ">" once collapsed
					   so it always reads as "this opens/closes the rail." */
					#desktop-sidebar.is-collapsed [data-sidebar-chevron] {
						transform: rotate(180deg);
					}
				}

				/* Suppress the transition while restoring a collapsed rail on hard
				   load — otherwise the sidebar visibly slams shut on every refresh. */
				.sidebar-no-anim #desktop-sidebar,
				.sidebar-no-anim #desktop-sidebar *,
				.sidebar-no-anim #main-content-wrapper {
					transition: none !important;
				}

				@media (prefers-reduced-motion: reduce) {
					#desktop-sidebar,
					#desktop-sidebar-inner,
					#main-content-wrapper,
					#desktop-sidebar [data-sidebar-label],
					#desktop-sidebar [data-sidebar-chevron] {
						transition: none;
					}
				}
				/* Page title utility — Alfa Slab display, matches storefront headlines */
				.admin-page-title {
					font-family: 'Alfa Slab One', 'Rockwell', Georgia, serif;
					font-weight: 400;
					font-size: 1.75rem;
					line-height: 0.95;
					text-transform: uppercase;
					letter-spacing: 0.01em;
					color: var(--color-rr-heading);
				}

				/* ── Admin status badges ── */
				.badge {
					display: inline-flex;
					align-items: center;
					gap: 0.35rem;
					padding: 0.2rem 0.6rem;
					border-radius: 2px;
					border: 1px solid transparent;
					font-family: 'Barlow', sans-serif;
					font-weight: 700;
					letter-spacing: 0.14em;
					text-transform: uppercase;
					font-size: 0.65rem;
					line-height: 1.6;
					white-space: nowrap;
				}
				.badge-dot::before {
					content: '';
					display: block;
					width: 5px;
					height: 5px;
					border-radius: 50%;
					background: currentColor;
					flex-shrink: 0;
				}
				.badge-green      { background:#DFF0E4; color:#2A6644; border-color:#A8D4B8; }
				.badge-green-solid { background:#2A6644; color:#F0FAF4; border-color:#1E4E32; }
				.badge-amber      { background:#FBF0D8; color:#7A4E08; border-color:#E8C070; }
				.badge-slate      { background:#E4EAF0; color:#2E4A60; border-color:#A8BED0; }
				.badge-teal       { background:#D8F0EE; color:#0A5E5C; border-color:#7ACCC8; }
				.badge-teal-solid { background:#0A7870; color:#F0FAFA; border-color:#065858; }
				.badge-red        { background:#FAE4E4; color:#7A1210; border-color:#E0A8A8; }
				.badge-grey       { background:#E8E0D8; color:#5A5048; border-color:#B8ACA0; }
				.badge-pastdue    { background:#FCE8D8; color:#7A3010; border-color:#E8B090; }
				.badge-partial    { background:#EEF0D8; color:#4A5218; border-color:#C0C888; }
				.badge-blue       { background:#DBEAFE; color:#1E40AF; border-color:#93C5FD; }
				.badge-indigo     { background:#E0E7FF; color:#3730A3; border-color:#A5B4FC; }
				.badge-neutral    { background:#E4DAC8; color:#5A5048; border-color:#B8ACA0; }

				/* ── Admin action buttons ── */
				.btn-secondary {
					display: inline-flex;
					align-items: center;
					gap: 0.375rem;
					border-radius: 2px;
					padding: 0.5rem 0.75rem;
					font-size: 0.875rem;
					font-weight: 600;
					background: var(--color-rr-surface);
					color: var(--color-rr-heading);
					box-shadow: 0 1px 2px rgba(0,0,0,0.05);
					outline: 1px solid var(--color-rr-border);
					outline-offset: -1px;
				}
				.btn-secondary:hover { background: var(--color-rr-raised); }

				.btn-danger {
					display: inline-flex;
					align-items: center;
					gap: 0.375rem;
					border-radius: 2px;
					padding: 0.5rem 0.75rem;
					font-size: 0.875rem;
					font-weight: 600;
					background: var(--color-rr-surface);
					color: #7A1210;
					box-shadow: 0 1px 2px rgba(0,0,0,0.05);
					outline: 1px solid var(--color-rr-border);
					outline-offset: -1px;
				}
				.btn-danger:hover { background: #FAE4E4; }

				.btn-confirm {
					display: inline-flex;
					align-items: center;
					gap: 0.375rem;
					border-radius: 2px;
					padding: 0.5rem 0.75rem;
					font-size: 0.875rem;
					font-weight: 600;
					background: var(--color-rr-surface);
					color: #2A6644;
					box-shadow: 0 1px 2px rgba(0,0,0,0.05);
					outline: 1px solid var(--color-rr-border);
					outline-offset: -1px;
				}
				.btn-confirm:hover { background: #DFF0E4; }

				/* ── Clickable table rows ── */
				.row-link {
					position: relative;
					/* Safari/WebKit ignores `position: relative` on <tr>, so the
					   .row-link-target::after overlay below is NOT clipped to its row
					   there — it escapes to the viewport and stacks across the whole
					   page, swallowing clicks on the tabs/filters above the table and
					   routing them to a random order's detail page. A transform DOES
					   establish a containing block on <tr> in WebKit, which clips the
					   overlay back to its row. See WebKit bug 240961. */
					transform: translate(0);
					cursor: pointer;
					transition: background-color 150ms linear, box-shadow 150ms linear;
				}
				.row-link:hover {
					background: var(--color-rr-raised);
					box-shadow: inset 4px 0 0 var(--color-rr-amber);
				}
				/* Stale rows keep a persistent rust flag on the leading edge —
				   the paper-and-ink equivalent of a sticky note "this is waiting." */
				.row-link.row-link-stale {
					box-shadow: inset 4px 0 0 var(--color-rr-red);
				}
				.row-link.row-link-stale:hover {
					box-shadow: inset 4px 0 0 var(--color-rr-red);
				}
				@media (prefers-reduced-motion: reduce) {
					.row-link { transition: none; }
				}
				.row-link .row-link-target::after {
					content: '';
					position: absolute;
					inset: 0;
				}
				/* Keep other interactive elements above the overlay */
				.row-link a:not(.row-link-target),
				.row-link button,
				.row-link form { position: relative; z-index: 1; }

				/* ── Action hints ──
				   A one-line explanation of what a button does, shown before the
				   click rather than after it. Hover AND focus-within, so keyboard
				   users get the same affordance; the button carries
				   aria-describedby pointing at the hint, so it is announced too.
				   CSS-only — nothing here needs JS to be correct. */
				.action-wrap {
					position: relative;
					display: inline-flex;
				}
				.action-hint {
					position: absolute;
					/* Below the trigger, not above it. Action rows sit near the top
					   of the content, #main-content-wrapper is a scroll container
					   (overflow-x:hidden computes overflow-y to auto, which clips),
					   and the mobile top bar is z-40 — so anything opening upward
					   got cut off or painted over. There is always room below. */
					top: calc(100% + 6px);
					left: 0;
					/* Above the sticky mobile top bar (z-40). */
					z-index: 50;
					width: max-content;
					max-width: 18rem;
					padding: 0.35rem 0.55rem;
					border-radius: 2px;
					background: var(--color-rr-heading);
					color: var(--color-rr-bg);
					font-size: 0.75rem;
					line-height: 1.45;
					font-weight: 400;
					text-align: left;
					white-space: normal;
					pointer-events: none;
					/* Toggled with display, not an opacity fade. A fade from a
					   visibility:hidden element does not reliably advance in Chrome
					   when the reveal comes from :focus-within rather than the
					   pointer, and admin motion is utility anyway — see
					   docs/admin-ui.md. */
					display: none;
				}
				/* A left-anchored hint on a button that hugs the right edge would
				   run off the viewport, so the trailing group anchors its hints to
				   the right instead. Marked explicitly rather than counted by
				   position: an nth-last-child rule also caught left-hand buttons
				   whenever the row happened to be short. */
				.action-row-end .action-hint {
					left: auto;
					right: 0;
				}
				.action-wrap:hover > .action-hint,
				.action-wrap:focus-within > .action-hint {
					display: block;
				}
			</style>
		</head>
		<body class="h-full overflow-x-hidden" hx-boost="true" hx-target="#main-content" hx-swap="innerHTML show:window:top">
			<!-- Mobile sidebar overlay -->
			<div id="mobile-sidebar" class="relative z-50 lg:hidden hidden" role="dialog" aria-modal="true">
				<!-- Backdrop -->
				<div id="mobile-sidebar-backdrop" class="fixed inset-0 bg-rr-heading/80 transition-opacity"></div>
				<div class="fixed inset-0 flex">
					<div id="mobile-sidebar-panel" class="relative mr-16 flex w-full max-w-xs flex-1">
						<!-- Close button -->
						<div class="absolute left-full top-0 flex w-16 justify-center pt-5">
							<button type="button" id="mobile-sidebar-close" class="-m-2.5 p-2.5">
								<span class="sr-only">Close sidebar</span>
								<svg class="size-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
						<!-- Mobile sidebar content -->
						<div class="flex grow flex-col gap-y-5 overflow-y-auto bg-rr-surface px-6 pb-4 border-r border-rr-border">
							<div class="flex h-16 shrink-0 items-center">
								@adminLogo()
							</div>
							<div class="flex flex-1 flex-col">
								@adminNav(props.ActivePath)
								<div class="mt-auto">
									@adminUserFooter(props)
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- Desktop sidebar (expanded by default for desktop-first use) -->
			<div id="desktop-sidebar" class="hidden lg:fixed lg:inset-y-0 lg:z-50 lg:flex lg:w-72 lg:flex-col">
				<div id="desktop-sidebar-inner" class="flex grow flex-col gap-y-5 bg-rr-surface border-r border-rr-border px-6 pb-4">
					<div data-sidebar-header class="flex h-16 shrink-0 items-center justify-between gap-x-2">
						@adminSidebarBrand()
						@adminSidebarToggle()
					</div>
					<!-- Nav (flex-1) fills the column and pins the user menu to the
					     bottom. No overflow container here: the seven-item nav never
					     needs to scroll, and an overflow context would both clip the
					     menu's upward dropdown and turn the nav's -mx-2 gutter bleed
					     into a stray horizontal scrollbar. -->
					@adminNav(props.ActivePath)
					<div class="shrink-0 border-t border-rr-border pt-2">
						@adminUserFooter(props)
					</div>
				</div>
			</div>
			<!-- Main content area -->
			<div id="main-content-wrapper" class="lg:pl-72 overflow-x-hidden">
				<!-- Mobile top bar — drawer trigger + brand. Hidden on desktop, where
				     the sidebar is always visible and carries the user menu itself,
				     so the whole bar disappears and the content reclaims the height. -->
				<div class="sticky top-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b border-rr-border bg-rr-surface px-4 lg:hidden">
					<button type="button" id="mobile-menu-btn" class="-m-2.5 p-2.5 text-rr-body">
						<span class="sr-only">Open sidebar</span>
						<svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
						</svg>
					</button>
					<div class="h-6 w-px bg-rr-border" aria-hidden="true"></div>
					@adminLogo()
				</div>
			<main class="py-10 lg:py-8">
					<div id="main-content" class="px-4 sm:px-6 lg:px-8">
						{ children... }
					</div>
				</main>
				<!-- Toast live region -->
				<div id="toast-container" aria-live="assertive"></div>
			</div>
			<script>
				// Desktop sidebar toggle. The CSS (keyed on .is-collapsed) owns the
				// labels, icon centering and chevron flip on a single timeline; JS
				// just flips the state class, the width/padding utilities it animates,
				// the a11y attributes, and the persisted preference.
				function toggleSidebar() {
					var sb = document.getElementById('desktop-sidebar');
					var inner = document.getElementById('desktop-sidebar-inner');
					var wrapper = document.getElementById('main-content-wrapper');
					var toggle = sb.querySelector('[data-sidebar-toggle]');
					var collapsed = sb.classList.toggle('is-collapsed');

					sb.classList.toggle('lg:w-72', !collapsed);
					sb.classList.toggle('lg:w-16', collapsed);
					inner.classList.toggle('px-6', !collapsed);
					inner.classList.toggle('px-2', collapsed);
					wrapper.classList.toggle('lg:pl-72', !collapsed);
					wrapper.classList.toggle('lg:pl-16', collapsed);

					if (toggle) {
						toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
						toggle.setAttribute('title', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
					}
					localStorage.setItem('sidebar-collapsed', collapsed ? 'true' : 'false');
				}

				(function() {
					// Restore sidebar state from localStorage (default: expanded).
					// Suppress the transition for the restore so a collapsed rail
					// doesn't visibly slam shut on every hard page load.
					if (localStorage.getItem('sidebar-collapsed') === 'true') {
						document.body.classList.add('sidebar-no-anim');
						toggleSidebar();
						requestAnimationFrame(function() {
							requestAnimationFrame(function() {
								document.body.classList.remove('sidebar-no-anim');
							});
						});
					}

					// Mobile sidebar
					var sidebar = document.getElementById('mobile-sidebar');
					var openBtn = document.getElementById('mobile-menu-btn');
					var closeBtn = document.getElementById('mobile-sidebar-close');
					var backdrop = document.getElementById('mobile-sidebar-backdrop');

					function openSidebar() {
						sidebar.classList.remove('hidden');
					}
					function closeSidebar() {
						sidebar.classList.add('hidden');
					}

					if (openBtn) openBtn.addEventListener('click', openSidebar);
					if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
					if (backdrop) backdrop.addEventListener('click', closeSidebar);

					document.addEventListener('keydown', function(e) {
						if (e.key === 'Escape') closeSidebar();
					});

					// Dropdown menus
					document.querySelectorAll('[data-dropdown]').forEach(function(dropdown) {
						var trigger = dropdown.querySelector('[data-dropdown-trigger]');
						var menu = dropdown.querySelector('[data-dropdown-menu]');

						if (trigger && menu) {
							trigger.addEventListener('click', function(e) {
								e.stopPropagation();
								var isOpen = !menu.classList.contains('hidden');
								// Close all other dropdowns
								document.querySelectorAll('[data-dropdown-menu]').forEach(function(m) {
									m.classList.add('hidden');
								});
								if (!isOpen) {
									menu.classList.remove('hidden');
								}
							});
						}
					});

					document.addEventListener('click', function() {
						document.querySelectorAll('[data-dropdown-menu]').forEach(function(m) {
							m.classList.add('hidden');
						});
					});
				// Active nav highlighting after htmx navigation
				var activeLink = 'group flex items-center gap-x-3 rounded-sm bg-rr-raised p-1.5 text-sm font-semibold text-rr-heading';
				var inactiveLink = 'group flex items-center gap-x-3 rounded-sm p-1.5 text-sm font-medium text-rr-body hover:bg-rr-raised hover:text-rr-heading';
				var activeIcon = 'size-5 shrink-0 text-rr-heading';
				var inactiveIcon = 'size-5 shrink-0 text-rr-muted group-hover:text-rr-heading';

				// Twin of resolveActiveNav in admin.templ — maps any admin path to the
				// flat sidebar row that owns it (section-tab and wholesale sub-pages
				// resolve to their parent). Keep the two in sync.
				function resolveActiveNav(path) {
					if (path === '/admin') return '/admin';
					if (path.indexOf('/admin/orders') === 0) return '/admin/orders';
					if (path === '/admin/fulfillment' || path.indexOf('/admin/fulfillment/') === 0 ||
						path.indexOf('/admin/wholesale/fulfillment') === 0) return '/admin/fulfillment';
					if (path.indexOf('/admin/catalog') === 0 || path.indexOf('/admin/categories') === 0 ||
						path.indexOf('/admin/attributes') === 0 || path.indexOf('/admin/price-lists') === 0) return '/admin/catalog';
					if (path.indexOf('/admin/customers') === 0 || path.indexOf('/admin/groups') === 0 ||
						path.indexOf('/admin/wholesale') === 0) return '/admin/customers';
					if (path.indexOf('/admin/subscriptions') === 0 || path.indexOf('/admin/plans') === 0) return '/admin/subscriptions';
					if (path.indexOf('/admin/discounts') === 0) return '/admin/discounts';
					return path;
				}

				function updateActiveNav() {
					// Prefer an explicit marker the swapped content may carry. The order
					// detail page lives at the same /admin/orders/{id} URL for both
					// channels, so the path alone can't say which nav item is right — the
					// marker disambiguates (e.g. "/admin/orders/wholesale").
					var marker = document.querySelector('#main-content [data-active-path]');
					var path = marker ? marker.getAttribute('data-active-path') : window.location.pathname;
					var resolved = resolveActiveNav(path);
					// Scoped to the sidebar so we don't trample page-level tab navs
					// (e.g. orders/fulfillment view tabs) that also link to /admin/*.
					var links = document.querySelectorAll('nav[data-admin-sidebar-nav] a[href^="/admin"]');
					links.forEach(function(a) {
						var isActive = a.getAttribute('href') === resolved;
						a.className = isActive ? activeLink : inactiveLink;
						var icon = a.querySelector('svg');
						if (icon) icon.className = isActive ? activeIcon : inactiveIcon;
					});
				}

				document.addEventListener('htmx:afterSettle', updateActiveNav);

				// Toast slide-in/out and auto-dismiss
				function dismissToast(el) {
					if (!el || el.dataset.dismissing) return;
					el.dataset.dismissing = 'true';
					el.style.opacity = '0';
					el.style.transform = 'translateX(100%)';
					el.addEventListener('transitionend', function() { el.remove(); }, { once: true });
				}

				document.addEventListener('htmx:oobAfterSwap', function(evt) {
					var toast = evt.detail.target.querySelector('[data-toast]');
					if (!toast) return;
					// Force initial off-screen state, then slide in on next frame
					toast.style.transform = 'translateX(100%)';
					toast.style.opacity = '0';
					requestAnimationFrame(function() {
						toast.style.transform = 'translateX(0)';
						toast.style.opacity = '1';
					});
					setTimeout(function() { dismissToast(toast); }, 5000);
					var btn = toast.querySelector('[data-toast-close]');
					if (btn) btn.addEventListener('click', function() { dismissToast(toast); });
				});
				})();
			</script>
		</body>
	</html>
}

templ adminLogo() {
	<a href="/admin" class="flex items-center gap-2">
		<img src="/static/rockabilly-logo.svg" alt="Rockabilly Roasting Co." class="h-7 w-auto flex-shrink-0"/>
		<span class="text-lg tracking-wide text-rr-heading uppercase" style="font-family: 'Alfa Slab One', Rockwell, Georgia, serif; letter-spacing: 0.02em;">Rockabilly</span>
	</a>
}

// adminSidebarBrand is the wordmark/home link. It collapses to nothing on the
// rail (data-sidebar-label) so the dedicated chevron toggle is the sole header
// control when collapsed.
templ adminSidebarBrand() {
	<a href="/admin" data-sidebar-label class="flex items-center gap-2 overflow-hidden">
		<img src="/static/rockabilly-logo.svg" alt="Rockabilly Roasting Co." class="h-7 w-auto shrink-0"/>
		<span class="text-lg tracking-wide text-rr-heading uppercase" style="font-family: 'Alfa Slab One', Rockwell, Georgia, serif; letter-spacing: 0.02em;">Rockabilly</span>
	</a>
}

// adminSidebarToggle is the persistent collapse affordance — a chevron that is
// visible in BOTH states and flips direction (CSS, on .is-collapsed) so the
// control always reads as "open/close the rail." Replaces the old logo-that-
// secretly-toggled, which had no discoverable affordance.
templ adminSidebarToggle() {
	<button type="button" onclick="toggleSidebar()" data-sidebar-toggle aria-expanded="true" aria-controls="desktop-sidebar" title="Collapse sidebar" class="group flex shrink-0 items-center justify-center rounded-sm p-2 text-rr-muted hover:bg-rr-raised hover:text-rr-red transition-colors">
		<span class="sr-only">Toggle sidebar</span>
		<svg data-sidebar-chevron class="size-5 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"></path>
		</svg>
	</button>
}

templ adminUserFooter(props AdminProps) {
	<div class="relative" data-dropdown>
		<button type="button" data-dropdown-trigger class="flex w-full items-center gap-x-4 rounded-sm px-2 py-3 text-sm/6 font-semibold text-rr-heading hover:bg-rr-raised">
			<span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-rr-red">
				<span class="text-sm font-medium text-white">{ staffInitials(props.StaffName) }</span>
			</span>
			<span data-sidebar-label class="flex-1 text-left transition-opacity duration-200">
				<span class="block text-sm font-semibold text-rr-heading">{ props.StaffName }</span>
				<span class="block text-xs text-rr-muted">{ props.StaffRole }</span>
			</span>
			<svg data-sidebar-label class="size-5 text-rr-muted transition-opacity duration-200" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.02l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z" clip-rule="evenodd"></path>
			</svg>
		</button>
		<div data-dropdown-menu class="hidden absolute bottom-full left-0 z-10 mb-2 w-48 rounded-sm bg-rr-surface py-2 shadow-lg ring-1 ring-rr-border">
			<a href="/admin/settings" class="block px-3 py-1 text-sm/6 text-rr-heading hover:bg-rr-raised">Settings</a>
			if domain.StaffRole(props.StaffRole).CanManageStaff() {
				<a href="/admin/staff" class="block px-3 py-1 text-sm/6 text-rr-heading hover:bg-rr-raised">Team</a>
			}
			<a href="/admin/audit" class="block px-3 py-1 text-sm/6 text-rr-heading hover:bg-rr-raised">Audit log</a>
			<a href="/admin/help" class="block px-3 py-1 text-sm/6 text-rr-heading hover:bg-rr-raised">Help</a>
			<div class="my-1 border-t border-rr-border"></div>
			<form method="post" action="/auth/staff/logout"><button type="submit" class="block w-full text-left px-3 py-1 text-sm/6 text-rr-heading hover:bg-rr-raised">Sign out</button></form>
		</div>
	</div>
}
