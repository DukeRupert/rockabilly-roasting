package layouts

import "fmt"

type StorefrontProps struct {
	Title        string
	Description  string
	CartCount    int
	CartURL      string // defaults to "/cart" if empty
	CanonicalURL string // full URL, e.g. "https://rockabillyroasting.com/about"
	OGImage      string // full URL to share image; falls back to logo
	OGType       string // "website", "product", etc.; defaults to "website"
	PreloadImage string // <link rel=preload as=image> — set for LCP asset on above-the-fold images
}

func (p StorefrontProps) cartURL() string {
	if p.CartURL != "" {
		return p.CartURL
	}
	return "/cart"
}

func (p StorefrontProps) ogType() string {
	if p.OGType != "" {
		return p.OGType
	}
	return "website"
}

func (p StorefrontProps) fullTitle() string {
	return p.Title + " - Rockabilly Roasting Co."
}

templ Storefront(props StorefrontProps) {
	<!DOCTYPE html>
	<html lang="en" class="bg-paper">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title } - Rockabilly Roasting Co.</title>
			if props.Description != "" {
				<meta name="description" content={ props.Description }/>
			}
			<!-- Open Graph -->
			<meta property="og:type" content={ props.ogType() }/>
			<meta property="og:title" content={ props.fullTitle() }/>
			if props.Description != "" {
				<meta property="og:description" content={ props.Description }/>
			}
			if props.CanonicalURL != "" {
				<meta property="og:url" content={ props.CanonicalURL }/>
				<link rel="canonical" href={ props.CanonicalURL }/>
			}
			if props.OGImage != "" {
				<meta property="og:image" content={ props.OGImage }/>
			} else {
				<meta property="og:image" content="/static/rockabilly-logo.png"/>
			}
			<meta property="og:site_name" content="Rockabilly Roasting Co."/>
			<!-- Twitter Card -->
			if props.OGImage != "" {
				<meta name="twitter:card" content="summary_large_image"/>
			} else {
				<meta name="twitter:card" content="summary"/>
			}
			<meta name="twitter:title" content={ props.fullTitle() }/>
			if props.Description != "" {
				<meta name="twitter:description" content={ props.Description }/>
			}
			if props.OGImage != "" {
				<meta name="twitter:image" content={ props.OGImage }/>
			} else {
				<meta name="twitter:image" content="/static/rockabilly-logo.png"/>
			}
			<!-- JSON-LD: Organization -->
			<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "CafeOrCoffeeShop",
				"name": "Rockabilly Roasting Co.",
				"url": "https://rockabillyroasting.com",
				"logo": "https://rockabillyroasting.com/static/rockabilly-logo.png",
				"image": "https://rockabillyroasting.com/static/rockabilly-logo.png",
				"telephone": "+1-509-585-2320",
				"email": "info@rockabillyroasting.com",
				"priceRange": "$",
				"servesCuisine": "Coffee",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "101 W. Kennewick Ave.",
					"addressLocality": "Kennewick",
					"addressRegion": "WA",
					"postalCode": "99336",
					"addressCountry": "US"
				},
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": 46.2112,
					"longitude": -119.1372
				},
				"openingHoursSpecification": [
					{"@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday"], "opens": "07:00", "closes": "14:00"},
					{"@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "07:00", "closes": "16:00"},
					{"@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "08:00", "closes": "16:00"}
				],
				"sameAs": [
					"https://www.facebook.com/rockabillyroasting/",
					"https://www.instagram.com/rockabillyroasting/"
				]
			}
			</script>
			if props.PreloadImage != "" {
				<link rel="preload" as="image" href={ props.PreloadImage } fetchpriority="high"/>
			}
			<link rel="icon" type="image/svg+xml" href="/static/rockabilly-logo.svg"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png"/>
			<link rel="manifest" href="/static/site.webmanifest"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="preconnect" href="https://cdn.rockabillyroasting.shop" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Bebas+Neue&family=Boogaloo&family=DM+Serif+Display:ital@0;1&family=Oswald:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400;1,700&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Special+Elite&family=Yellowtail&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script defer src="/static/js/htmx.min.js"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			<style>[x-cloak] { display: none !important; }</style>
		</head>
		<body class="min-h-screen font-oswald text-ink bg-paper" hx-boost="true" hx-target="#main-content" hx-swap="innerHTML show:window:top">
			<!-- Skip navigation -->
			<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:bg-rust focus:text-paper focus:border-2 focus:border-ink focus:px-4 focus:py-2 focus:font-oswald focus:font-bold focus:text-sm" style="letter-spacing:0.14em; text-transform:uppercase;">
				Skip to main content
			</a>
			<!-- Header -->
			<header class="sticky top-0 z-40 bg-ink border-b-2 border-ink-soft">
				<nav class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
					<div class="flex h-16 items-center justify-between">
						<!-- Logo -->
						<div class="flex items-center">
							<a href="/" class="flex items-center gap-3">
								<img src="/static/badge-white.png" alt="Rockabilly Roasting Co." class="h-10 w-auto flex-shrink-0"/>
								<div class="hidden sm:block">
									<p class="font-slab text-paper text-[11px] uppercase leading-none whitespace-nowrap" style="letter-spacing:0.02em;">
										ROCKABILLY ROASTING <span class="text-candle">CO.</span>
									</p>
								</div>
							</a>
						</div>
						<!-- Desktop nav -->
						<div class="hidden sm:flex sm:items-center sm:gap-x-8">
							<a href="/catalog" class="nav-link font-oswald text-sm font-semibold text-paper hover:text-candle transition-colors" style="letter-spacing:0.18em; text-transform:uppercase;">Coffee</a>
							<a href="/subscriptions" class="nav-link font-oswald text-sm font-semibold text-paper hover:text-candle transition-colors" style="letter-spacing:0.18em; text-transform:uppercase;">Daily Grind</a>
							<a href="/about" class="nav-link font-oswald text-sm font-semibold text-paper hover:text-candle transition-colors" style="letter-spacing:0.18em; text-transform:uppercase;">Story</a>
						</div>
						<!-- Cart + Account + mobile menu -->
						<div class="flex items-center gap-x-3">
							<!-- Account link (desktop only) -->
							<a href="/account/login" class="hidden sm:inline-block font-oswald text-xs font-bold text-paper hover:text-candle transition-colors" style="letter-spacing:0.18em; text-transform:uppercase;">
								Log In
							</a>
							<!-- Cart — amber chip with paper double-rule on ink -->
							<a
								href={ templ.SafeURL(props.cartURL()) }
								class="btn inline-flex items-center gap-2 bg-candle text-ink border-2 border-paper px-3 py-1.5 font-oswald font-bold text-xs hover:bg-candle-deep hover:text-paper transition-colors"
								style="letter-spacing:0.14em; text-transform:uppercase;"
							>
								<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
								</svg>
								<span>
									Cart
									if props.CartCount > 0 {
										<span id="cart-badge">· { fmt.Sprintf("%d", props.CartCount) }</span>
									} else {
										<span id="cart-badge" class="sr-only">empty</span>
									}
								</span>
							</a>
							<!-- Mobile menu button -->
							<button type="button" id="sf-mobile-menu-btn" class="sm:hidden -m-2.5 p-2.5 text-paper" aria-expanded="false" aria-controls="sf-mobile-menu">
								<span class="sr-only">Open menu</span>
								<svg id="sf-menu-icon-open" class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
								</svg>
								<svg id="sf-menu-icon-close" class="size-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
					</div>
				</nav>
				<!-- Mobile menu -->
				<div id="sf-mobile-menu" class="hidden sm:hidden border-t border-ink-soft">
					<div class="space-y-1 px-4 py-3 bg-ink">
						<a href="/catalog" class="block px-3 py-2 font-oswald font-bold text-sm text-paper hover:bg-ink-soft hover:text-candle" style="letter-spacing:0.14em; text-transform:uppercase;">Coffee</a>
						<a href="/subscriptions" class="block px-3 py-2 font-oswald font-bold text-sm text-paper hover:bg-ink-soft hover:text-candle" style="letter-spacing:0.14em; text-transform:uppercase;">Daily Grind</a>
						<a href="/about" class="block px-3 py-2 font-oswald font-bold text-sm text-paper hover:bg-ink-soft hover:text-candle" style="letter-spacing:0.14em; text-transform:uppercase;">Story</a>
						<div class="border-t border-ink-soft mt-2 pt-2">
							<a href="/account/login" class="block px-3 py-2 font-oswald font-bold text-sm text-paper hover:bg-ink-soft hover:text-candle" style="letter-spacing:0.14em; text-transform:uppercase;">Log In</a>
						</div>
					</div>
				</div>
			</header>
			<!-- Main content -->
			<main>
				<div id="main-content" class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
					{ children... }
				</div>
			</main>
			<!-- Toast live region -->
			<div id="toast-container" aria-live="polite"></div>
			<!-- Footer -->
			<div class="flame-stripe"></div>
			<footer class="relative bg-ink">
				<!-- Paper grain overlay (dim, on ink) -->
				<div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(circle, rgba(246,239,225,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
				<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
					<div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
						<!-- Logo column -->
						<div>
							<div class="flex items-center gap-3 mb-4">
								<img src="/static/badge-white.png" alt="Rockabilly Roasting Co." class="h-12 w-auto flex-shrink-0"/>
								<div>
									<p class="font-slab text-paper text-[13px] uppercase leading-[1.05] whitespace-nowrap" style="letter-spacing:0.02em;">
										ROCKABILLY ROASTING <span class="text-candle">CO.</span>
									</p>
									<p class="font-oswald text-chrome-deep text-[10px] mt-1" style="letter-spacing:0.24em; text-transform:uppercase;">Est. 2014 &middot; Kennewick WA</p>
								</div>
							</div>
							<p class="font-oswald text-paper-warm text-sm leading-relaxed">
								101 W. Kennewick Ave.<br/>
								Kennewick, WA &middot; 509-585-2320
							</p>
						</div>
						<!-- Shop links -->
						<div>
							<p class="font-oswald font-bold text-candle text-[11px] mb-4 pb-2 border-b-2 border-ink-soft" style="letter-spacing:0.24em; text-transform:uppercase;">Shop</p>
							<ul class="space-y-2">
								<li><a href="/catalog" class="font-oswald text-paper text-sm hover:text-candle transition-colors">Coffee</a></li>
								<li><a href="/subscriptions" class="font-oswald text-paper text-sm hover:text-candle transition-colors">The Daily Grind</a></li>
								<li><a href="/wholesale" class="font-oswald text-paper text-sm hover:text-candle transition-colors">Wholesale</a></li>
								<li><a href="/account/login" class="font-oswald text-paper text-sm hover:text-candle transition-colors">My Account</a></li>
							</ul>
						</div>
						<!-- Cafe hours -->
						<div>
							<p class="font-oswald font-bold text-candle text-[11px] mb-4 pb-2 border-b-2 border-ink-soft" style="letter-spacing:0.24em; text-transform:uppercase;">Cafe Hours</p>
							<dl class="space-y-1.5">
								<div class="flex justify-between gap-3">
									<dt class="font-oswald text-paper text-sm" style="letter-spacing:0.04em;">Mon &ndash; Thu</dt>
									<dd class="font-special text-paper-warm text-sm">7a &ndash; 2p</dd>
								</div>
								<div class="flex justify-between gap-3">
									<dt class="font-oswald text-paper text-sm" style="letter-spacing:0.04em;">Friday</dt>
									<dd class="font-special text-paper-warm text-sm">7a &ndash; 4p</dd>
								</div>
								<div class="flex justify-between gap-3">
									<dt class="font-oswald text-paper text-sm" style="letter-spacing:0.04em;">Saturday</dt>
									<dd class="font-special text-paper-warm text-sm">8a &ndash; 4p</dd>
								</div>
								<div class="flex justify-between gap-3">
									<dt class="font-oswald text-chrome-deep text-sm" style="letter-spacing:0.04em;">Sunday</dt>
									<dd class="font-special text-chrome-deep text-sm">Closed</dd>
								</div>
							</dl>
							<div class="flex gap-4 mt-5 pt-4 border-t border-ink-soft">
								<a href="https://www.facebook.com/rockabillyroasting/" class="font-oswald font-bold text-paper text-[11px] hover:text-candle transition-colors" style="letter-spacing:0.2em; text-transform:uppercase;" rel="noopener noreferrer">Facebook</a>
								<a href="https://www.instagram.com/rockabillyroasting/" class="font-oswald font-bold text-paper text-[11px] hover:text-candle transition-colors" style="letter-spacing:0.2em; text-transform:uppercase;" rel="noopener noreferrer">Instagram</a>
							</div>
						</div>
						<!-- Newsletter -->
						<div>
							<p class="font-oswald font-bold text-candle text-[11px] mb-4 pb-2 border-b-2 border-ink-soft" style="letter-spacing:0.24em; text-transform:uppercase;">Stay In The Loop</p>
							<p class="font-oswald text-paper-warm text-sm mb-4 leading-relaxed">
								Roast drops, fresh deals, nothing else. No spam — just the good stuff.
							</p>
							<form method="post" action="/newsletter/subscribe" class="flex flex-col gap-2">
								<label for="newsletter-email" class="sr-only">Email address</label>
								<input
									type="email"
									id="newsletter-email"
									name="email"
									required
									placeholder="name@example.com"
									class="paper-input w-full border-2 border-paper bg-cream-hi px-3 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
									style="letter-spacing:0.04em;"
								/>
								<button
									type="submit"
									class="btn-stamp-paper w-full bg-rust text-paper border-2 border-paper px-4 py-2.5 font-oswald font-bold text-sm"
									style="letter-spacing:0.16em; text-transform:uppercase;"
								>
									Join the list
								</button>
							</form>
						</div>
					</div>
					<!-- Copyright bar -->
					<div class="mt-14 pt-6 border-t-2 border-ink-soft flex flex-col sm:flex-row justify-between gap-3">
						<p class="font-oswald text-chrome-deep text-xs" style="letter-spacing:0.08em;">
							&copy; 2026 Rockabilly Roasting Co. &middot; Roasted in Kennewick.
						</p>
						<div class="flex flex-wrap gap-x-5 gap-y-1">
							<a href="/shipping" class="font-oswald text-chrome-deep text-xs hover:text-candle transition-colors" style="letter-spacing:0.14em; text-transform:uppercase;">Shipping &amp; Returns</a>
							<a href="/privacy" class="font-oswald text-chrome-deep text-xs hover:text-candle transition-colors" style="letter-spacing:0.14em; text-transform:uppercase;">Privacy</a>
							<a href="/terms" class="font-oswald text-chrome-deep text-xs hover:text-candle transition-colors" style="letter-spacing:0.14em; text-transform:uppercase;">Terms</a>
							<a href="/help" class="font-oswald text-chrome-deep text-xs hover:text-candle transition-colors" style="letter-spacing:0.14em; text-transform:uppercase;">Help</a>
							<span class="font-special text-chrome-deep text-xs">Powered by Hiri</span>
						</div>
					</div>
				</div>
			</footer>
			<!-- Back to top — paper stamp on ink -->
			<button
				id="back-to-top"
				type="button"
				aria-label="Back to top"
				class="fixed bottom-6 right-6 z-40 hidden size-11 items-center justify-center bg-paper border-2 border-ink text-ink hover:bg-candle transition-colors"
				style="box-shadow: var(--shadow-stamp-sm);"
			>
				<svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
				</svg>
			</button>
			<script>
				(function() {
					// Back to top button
					var btt = document.getElementById('back-to-top');
					if (btt) {
						var shown = false;
						window.addEventListener('scroll', function() {
							if (window.scrollY > 400 && !shown) {
								btt.classList.remove('hidden');
								btt.classList.add('flex');
								shown = true;
							} else if (window.scrollY <= 400 && shown) {
								btt.classList.add('hidden');
								btt.classList.remove('flex');
								shown = false;
							}
						}, { passive: true });
						btt.addEventListener('click', function() {
							window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
						});
					}

					// Mobile menu toggle
					var btn = document.getElementById('sf-mobile-menu-btn');
					var menu = document.getElementById('sf-mobile-menu');
					var iconOpen = document.getElementById('sf-menu-icon-open');
					var iconClose = document.getElementById('sf-menu-icon-close');
					if (btn && menu) {
						btn.addEventListener('click', function() {
							var expanded = menu.classList.toggle('hidden') === false;
							btn.setAttribute('aria-expanded', String(expanded));
							if (iconOpen && iconClose) {
								iconOpen.classList.toggle('hidden', expanded);
								iconClose.classList.toggle('hidden', !expanded);
							}
						});
					}

					// Toast slide-in/out and auto-dismiss
					function dismissToast(el) {
						if (!el || el.dataset.dismissing) return;
						el.dataset.dismissing = 'true';
						el.style.opacity = '0';
						el.style.transform = 'translateX(100%)';
						el.addEventListener('transitionend', function() { el.remove(); }, { once: true });
					}

					document.addEventListener('htmx:oobAfterSwap', function(evt) {
						var toast = evt.detail.target.querySelector('[data-toast]');
						if (!toast) return;
						toast.style.transform = 'translateX(100%)';
						toast.style.opacity = '0';
						requestAnimationFrame(function() {
							toast.style.transform = 'translateX(0)';
							toast.style.opacity = '1';
						});
						setTimeout(function() { dismissToast(toast); }, 5000);
						var closeBtn = toast.querySelector('[data-toast-close]');
						if (closeBtn) closeBtn.addEventListener('click', function() { dismissToast(toast); });
					});
				})();
			</script>
		</body>
	</html>
}
