package layouts

type StorefrontProps struct {
	Title       string
	Description string
}

templ Storefront(props StorefrontProps) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-hiri-bg">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title } - Hiri</title>
			if props.Description != "" {
				<meta name="description" content={ props.Description }/>
			}
			<link rel="icon" type="image/svg+xml" href="/static/hiri-favicon.svg"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js"></script>
		</head>
		<body class="h-full" hx-boost="true" hx-target="#main-content" hx-swap="innerHTML">
			<!-- Announcement bar -->
			<div class="bg-hiri-teal text-white text-center text-sm py-2 px-4">
				Free shipping on orders over $75
			</div>
			<!-- Header -->
			<header class="bg-white border-b border-hiri-border">
				<nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
					<div class="flex h-16 items-center justify-between">
						<!-- Logo -->
						<div class="flex items-center">
							<a href="/" class="flex items-center gap-2">
								<svg width="32" height="25" viewBox="0 0 56 44" fill="none">
									<path d="M 6 4 C 14 14, 10 26, -2 36 C 10 42, 26 44, 38 38 C 34 14, 6 4, 6 4 Z" fill="#2D7A7A" opacity="0.35"></path>
									<path d="M 20 4 C 28 14, 24 26, 12 36 C 24 42, 42 44, 56 38 C 52 14, 20 4, 20 4 Z" fill="#2D7A7A"></path>
								</svg>
								<span class="text-xl font-semibold tracking-tight text-hiri-text">hiri</span>
							</a>
						</div>
						<!-- Desktop nav -->
						<div class="hidden sm:flex sm:items-center sm:gap-x-8">
							<a href="/catalog" class="text-sm font-medium text-hiri-text hover:text-hiri-teal">Shop</a>
						</div>
						<!-- Cart + mobile menu -->
						<div class="flex items-center gap-x-4">
							<!-- Cart icon -->
							<a href="/cart" class="relative p-2 text-stone-400 hover:text-hiri-teal">
								<span class="sr-only">Cart</span>
								<svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"></path>
								</svg>
							</a>
							<!-- Mobile menu button -->
							<button type="button" id="sf-mobile-menu-btn" class="sm:hidden -m-2.5 p-2.5 text-stone-700">
								<span class="sr-only">Open menu</span>
								<svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
								</svg>
							</button>
						</div>
					</div>
				</nav>
				<!-- Mobile menu -->
				<div id="sf-mobile-menu" class="hidden sm:hidden border-t border-hiri-border">
					<div class="space-y-1 px-4 py-3">
						<a href="/catalog" class="block rounded-md px-3 py-2 text-base font-medium text-hiri-text hover:bg-stone-100 hover:text-hiri-teal">Shop</a>
					</div>
				</div>
			</header>
			<!-- Main content -->
			<main>
				<div id="main-content" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
					{ children... }
				</div>
			</main>
			<!-- Toast live region -->
			<div id="toast-container" aria-live="assertive"></div>
			<!-- Footer -->
			<footer class="bg-hiri-lakatoi">
				<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
					<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
						<!-- Logo column -->
						<div>
							<a href="/" class="flex items-center gap-2">
								<svg width="32" height="25" viewBox="0 0 56 44" fill="none">
									<path d="M 6 4 C 14 14, 10 26, -2 36 C 10 42, 26 44, 38 38 C 34 14, 6 4, 6 4 Z" fill="#D4C4A8" opacity="0.35"></path>
									<path d="M 20 4 C 28 14, 24 26, 12 36 C 24 42, 42 44, 56 38 C 52 14, 20 4, 20 4 Z" fill="#D4C4A8"></path>
								</svg>
								<span class="text-xl font-semibold tracking-tight text-hiri-sail">hiri</span>
							</a>
							<p class="mt-4 text-sm text-hiri-sail/70">
								Crafted goods inspired by the sea and shore.
							</p>
						</div>
						<!-- Shop links -->
						<div>
							<h3 class="text-sm font-semibold text-hiri-sail">Shop</h3>
							<ul class="mt-4 space-y-2">
								<li><a href="/catalog" class="text-sm text-hiri-sail/70 hover:text-hiri-sail">All Products</a></li>
							</ul>
						</div>
						<!-- Customer service -->
						<div>
							<h3 class="text-sm font-semibold text-hiri-sail">Customer Service</h3>
							<ul class="mt-4 space-y-2">
								<li><a href="/contact" class="text-sm text-hiri-sail/70 hover:text-hiri-sail">Contact Us</a></li>
								<li><a href="/shipping" class="text-sm text-hiri-sail/70 hover:text-hiri-sail">Shipping & Returns</a></li>
								<li><a href="/faq" class="text-sm text-hiri-sail/70 hover:text-hiri-sail">FAQ</a></li>
							</ul>
						</div>
						<!-- Newsletter -->
						<div>
							<h3 class="text-sm font-semibold text-hiri-sail">Stay in the loop</h3>
							<p class="mt-4 text-sm text-hiri-sail/70">Sign up for our newsletter.</p>
							<form class="mt-4 flex gap-x-2">
								<input type="email" placeholder="Enter your email" class="min-w-0 flex-auto rounded-md border-0 bg-white/10 px-3.5 py-2 text-sm text-hiri-sail shadow-sm ring-1 ring-inset ring-white/10 placeholder:text-hiri-sail/50 focus:ring-2 focus:ring-inset focus:ring-hiri-teal"/>
								<button type="submit" class="flex-none rounded-md bg-hiri-teal px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-hiri-teal-dark">
									Subscribe
								</button>
							</form>
						</div>
					</div>
					<!-- Copyright bar -->
					<div class="mt-12 border-t border-hiri-sail/10 pt-8">
						<p class="text-xs text-hiri-sail/50">&copy; 2026 Hiri. All rights reserved.</p>
					</div>
				</div>
			</footer>
			<script>
				(function() {
					// Mobile menu toggle
					var btn = document.getElementById('sf-mobile-menu-btn');
					var menu = document.getElementById('sf-mobile-menu');
					if (btn && menu) {
						btn.addEventListener('click', function() {
							menu.classList.toggle('hidden');
						});
					}

					// Toast slide-in/out and auto-dismiss
					function dismissToast(el) {
						if (!el || el.dataset.dismissing) return;
						el.dataset.dismissing = 'true';
						el.style.opacity = '0';
						el.style.transform = 'translateX(100%)';
						el.addEventListener('transitionend', function() { el.remove(); }, { once: true });
					}

					document.addEventListener('htmx:oobAfterSwap', function(evt) {
						var toast = evt.detail.target.querySelector('[data-toast]');
						if (!toast) return;
						toast.style.transform = 'translateX(100%)';
						toast.style.opacity = '0';
						requestAnimationFrame(function() {
							toast.style.transform = 'translateX(0)';
							toast.style.opacity = '1';
						});
						setTimeout(function() { dismissToast(toast); }, 5000);
						var closeBtn = toast.querySelector('[data-toast-close]');
						if (closeBtn) closeBtn.addEventListener('click', function() { dismissToast(toast); });
					});
				})();
			</script>
		</body>
	</html>
}
