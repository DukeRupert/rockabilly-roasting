package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type AboutProps struct {
	CartCount      int
	ContactSuccess bool
	ContactError   string
}

templ AboutContent(props AboutProps) {
	<!-- Hero: cafe photo under ink wash, stamp-pressed headline -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 -mt-8 relative bg-ink overflow-hidden">
		<img
			src="/static/rockabilly_cafe.webp"
			alt=""
			class="absolute inset-0 h-full w-full object-cover object-center opacity-35"
			aria-hidden="true"
		/>
		<!-- Ink vignette overlay -->
		<div class="absolute inset-0 bg-gradient-to-b from-ink/70 via-ink/55 to-ink/85 pointer-events-none"></div>
		<!-- Paper halftone for texture -->
		<div class="absolute inset-0 texture-halftone-paper pointer-events-none" style="mask-image: linear-gradient(180deg, transparent, black 20%, black 80%, transparent); -webkit-mask-image: linear-gradient(180deg, transparent, black 20%, black 80%, transparent);"></div>
		<div class="relative mx-auto max-w-5xl px-6 sm:px-10 lg:px-14 py-20 sm:py-28 text-center">
			<p class="font-oswald font-semibold text-candle text-xs sm:text-sm" style="letter-spacing:0.3em; text-transform:uppercase;">
				Kennewick, WA · Est. 2014
			</p>
			<h1 class="font-slab text-paper uppercase leading-[0.9] mt-5" style="font-size: clamp(2.5rem, 8vw, 5.5rem); letter-spacing:-0.005em;">
				Small batch,
				<br class="hidden sm:inline"/>
				big
				<span class="font-script text-candle normal-case inline-block align-baseline" style="font-size:1.05em; letter-spacing:0;">swagger.</span>
			</h1>
			<p class="mt-6 font-oswald text-paper-warm text-base sm:text-lg leading-relaxed max-w-xl mx-auto">
				Specialty-grade beans from all over, roasted on the drum right here in Kennewick. Honest coffee, straight-up — no pretense, no middleman, nothing older than a week.
			</p>
		</div>
		<div class="flame-stripe"></div>
	</section>
	<!-- Body: paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-3xl px-6 sm:px-10 lg:px-14 py-16 sm:py-20">
			<!-- Shop story + Visit card -->
			<div class="text-center">
				<p class="font-oswald text-ink-soft text-base sm:text-lg leading-relaxed max-w-xl mx-auto">
					More of the story's coming here soon. In the meantime, swing by the shop on West Kennewick Ave, pick up a bag, or drop us a line below.
				</p>
				<!-- Visit card -->
				<div class="mt-10 inline-block border-2 border-ink bg-cream-hi shadow-stamp px-8 py-7 text-left">
					<p class="font-oswald font-bold text-candle text-[11px] mb-4 pb-2 border-b-2 border-ink" style="letter-spacing:0.24em; text-transform:uppercase;">Visit us</p>
					<p class="font-oswald text-ink text-base" style="letter-spacing:0.04em;">101 W. Kennewick Ave.</p>
					<p class="font-oswald text-ink text-base" style="letter-spacing:0.04em;">Kennewick, WA</p>
					<p class="font-special text-ink-soft text-sm mt-3">509-585-2320</p>
					<p class="font-special text-ink-soft text-sm">info@rockabillyroasting.com</p>
				</div>
			</div>
			<!-- Contact form -->
			<div class="mt-16 pt-12 border-t-2 border-ink">
				<div class="text-center mb-10">
					<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
						Say hello
					</p>
					<h2 class="font-slab text-ink uppercase leading-[0.95] mt-2" style="font-size: clamp(1.75rem, 4vw, 2.75rem); letter-spacing:-0.005em;">
						Get in
						<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">touch.</span>
					</h2>
					<p class="font-oswald text-ink-soft text-sm mt-4 max-w-md mx-auto">
						Questions, feedback, wholesale inquiries — we'll read it and write back.
					</p>
				</div>
				if props.ContactSuccess {
					<div class="border-2 border-ink bg-candle/20 p-6 text-center shadow-stamp">
						<p class="font-slab text-ink text-xl uppercase mb-1" style="letter-spacing:0.02em;">Message sent!</p>
						<p class="font-oswald text-ink-soft text-sm">We'll get back to you as soon as we can.</p>
					</div>
				} else {
					if props.ContactError != "" {
						<div class="border-2 border-rust bg-cream-hi p-4 mb-6 text-center">
							<p class="font-oswald font-bold text-rust text-sm" style="letter-spacing:0.04em;">{ props.ContactError }</p>
						</div>
					}
					<form method="POST" action="/about/contact" class="space-y-5">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
							<div>
								<label for="contact-name" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Name</label>
								<input
									type="text"
									id="contact-name"
									name="name"
									required
									class="paper-input w-full border-2 border-ink bg-cream-hi px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
									style="letter-spacing:0.04em;"
									placeholder="Your name"
								/>
							</div>
							<div>
								<label for="contact-email" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Email</label>
								<input
									type="email"
									id="contact-email"
									name="email"
									required
									class="paper-input w-full border-2 border-ink bg-cream-hi px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
									style="letter-spacing:0.04em;"
									placeholder="you@example.com"
								/>
							</div>
						</div>
						<div>
							<label for="contact-subject" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Subject</label>
							<input
								type="text"
								id="contact-subject"
								name="subject"
								required
								class="paper-input w-full border-2 border-ink bg-cream-hi px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
								style="letter-spacing:0.04em;"
								placeholder="What's this about?"
							/>
						</div>
						<div>
							<label for="contact-message" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Message</label>
							<textarea
								id="contact-message"
								name="message"
								required
								rows="5"
								class="paper-input w-full border-2 border-ink bg-cream-hi px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none resize-y"
								style="letter-spacing:0.04em;"
								placeholder="Tell us what's on your mind…"
							></textarea>
						</div>
						<!-- Honeypot field — hidden from real users, catches bots -->
						<div class="hidden" aria-hidden="true">
							<input type="text" name="website" tabindex="-1" autocomplete="off"/>
						</div>
						<div class="text-center pt-2">
							<button
								type="submit"
								class="btn-stamp inline-flex items-center gap-2 bg-rust text-paper border-2 border-ink px-8 py-3.5 font-oswald font-bold text-sm"
								style="letter-spacing:0.14em; text-transform:uppercase;"
							>
								Send message
								<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"/>
								</svg>
							</button>
						</div>
					</form>
				}
			</div>
		</div>
	</section>
}

templ AboutPage(props AboutProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "About",
		Description: "About Rockabilly Roasting Co. — small-batch specialty coffee in Kennewick, WA",
		CartCount:   props.CartCount,
	}) {
		@AboutContent(props)
	}
}
