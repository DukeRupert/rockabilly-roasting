package storefront

import (
	"fmt"
	"time"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// --- Shared account layout ---

func accountNavClass(path, active string) string {
	base := "flex items-center gap-3 rounded-sm px-3 py-2 text-sm font-medium transition-colors"
	if path == active {
		return base + " bg-rr-red/10 text-rr-red"
	}
	return base + " text-rr-body hover:bg-rr-bg hover:text-rr-heading"
}

templ accountNav(activePath string) {
	<nav class="w-44 shrink-0 space-y-1">
		<a href="/account/settings" class={ accountNavClass("/account/settings", activePath) }>
			<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
			Settings
		</a>
		<a href="/account/orders" class={ accountNavClass("/account/orders", activePath) }>
			<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"></path></svg>
			Orders
		</a>
		<a href="/account/subscriptions" class={ accountNavClass("/account/subscriptions", activePath) }>
			<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182M2.985 19.644l3.181-3.182"></path></svg>
			Subscriptions
		</a>
		<a href="/account/addresses" class={ accountNavClass("/account/addresses", activePath) }>
			<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path></svg>
			Addresses
		</a>
		<div class="pt-4 mt-4 border-t border-rr-border">
			<form method="POST" action="/account/logout">
				<button type="submit" class="flex w-full items-center gap-3 rounded-sm px-3 py-2 text-sm font-medium text-rr-body hover:bg-rr-bg hover:text-rr-heading transition-colors">
					<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"></path></svg>
					Sign Out
				</button>
			</form>
		</div>
	</nav>
}

templ accountLayout(activePath string) {
	<div>
		<!-- Mobile nav (horizontal pills) -->
		<div class="sm:hidden">
			<div class="flex gap-2 overflow-x-auto border-b border-rr-border pb-2 mb-6">
				<a href="/account/settings" class={ mobileNavClass("/account/settings", activePath) }>Settings</a>
				<a href="/account/orders" class={ mobileNavClass("/account/orders", activePath) }>Orders</a>
				<a href="/account/subscriptions" class={ mobileNavClass("/account/subscriptions", activePath) }>Subscriptions</a>
				<a href="/account/addresses" class={ mobileNavClass("/account/addresses", activePath) }>Addresses</a>
			</div>
		</div>
		<!-- Desktop: sidebar + content; Mobile: content only -->
		<div class="sm:flex sm:gap-8">
			<div class="hidden sm:block">
				@accountNav(activePath)
			</div>
			<div class="flex-1 min-w-0">
				{ children... }
			</div>
		</div>
	</div>
}

func mobileNavClass(path, active string) string {
	base := "whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-medium"
	if path == active {
		return base + " bg-rr-red text-white"
	}
	return base + " text-rr-body hover:bg-rr-bg"
}

func formatDate(t time.Time) string {
	return t.Format("Jan 2, 2006")
}

// --- Account Settings ---

type AccountSettingsProps struct {
	Customer  *domain.Customer
	CartCount int
	Success   string
	Error     string
}

templ AccountSettingsContent(props AccountSettingsProps) {
	@accountLayout("/account/settings") {
		<div class="max-w-lg">
			<h1 class="font-display text-2xl tracking-widest text-rr-heading mb-6">Account Settings</h1>
			if props.Success != "" {
				<div class="mb-6 rounded-sm bg-rr-teal/10 border border-rr-teal/20 px-4 py-3 text-sm font-body text-rr-teal-lt">
					{ props.Success }
				</div>
			}
			if props.Error != "" {
				<div class="mb-6 rounded-sm bg-rr-red/10 border border-rr-red/20 px-4 py-3 text-sm font-body text-rr-red-lt">
					{ props.Error }
				</div>
			}
			<form method="POST" action="/account/settings" class="space-y-4">
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label for="first_name" class="block text-sm font-medium text-rr-body mb-1">First name</label>
						<input type="text" id="first_name" name="first_name" value={ props.Customer.FirstName }
							class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-sm text-rr-heading focus:outline-none" required/>
					</div>
					<div>
						<label for="last_name" class="block text-sm font-medium text-rr-body mb-1">Last name</label>
						<input type="text" id="last_name" name="last_name" value={ props.Customer.LastName }
							class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-sm text-rr-heading focus:outline-none" required/>
					</div>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-rr-body mb-1">Email</label>
					<input type="email" id="email" name="email" value={ props.Customer.Email }
						class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-sm text-rr-heading focus:outline-none" required/>
					<p class="mt-1 text-xs text-rr-muted">Your sign-in link will be sent to this address.</p>
				</div>
				<div class="pt-2">
					<button type="submit" class="btn rounded-sm bg-rr-red px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt">
						Save changes
					</button>
				</div>
			</form>
		</div>
	}
}

templ AccountSettingsPage(props AccountSettingsProps) {
	@layouts.Storefront(layouts.StorefrontProps{Title: "Account Settings", CartCount: props.CartCount}) {
		@AccountSettingsContent(props)
	}
}

// --- Order List ---

type AccountOrdersProps struct {
	Orders    []domain.Order
	CartCount int
}

templ AccountOrdersContent(props AccountOrdersProps) {
	@accountLayout("/account/orders") {
		<h1 class="font-display text-2xl tracking-widest text-rr-heading mb-6">Orders</h1>
		if len(props.Orders) == 0 {
			<div class="text-center py-12">
				<svg class="mx-auto size-12 text-rr-faint" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"></path></svg>
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No orders yet</h3>
				<p class="mt-1 text-sm text-rr-muted">Time to change that.</p>
				<div class="mt-6">
					<a href="/catalog" class="btn inline-block rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt">
						Browse products
					</a>
				</div>
			</div>
		} else {
			<div class="space-y-3">
				for _, order := range props.Orders {
					<a href={ templ.SafeURL("/account/orders/" + order.ID.String()) }
						class="block rounded-sm border border-rr-border p-4 hover:border-rr-red/50 hover:bg-rr-bg transition-colors">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-4">
								<span class="font-medium text-rr-heading">{ order.Number }</span>
								<span class="text-sm text-rr-muted">{ formatDate(order.PlacedAt) }</span>
							</div>
							<div class="flex items-center gap-4">
								<span class="text-sm font-medium text-rr-heading">{ formatCents(order.Total) }</span>
								@orderStatusBadge(order.Status, order.FulfillmentStatus)
							</div>
						</div>
					</a>
				}
			</div>
		}
	}
}

templ AccountOrdersPage(props AccountOrdersProps) {
	@layouts.Storefront(layouts.StorefrontProps{Title: "Orders", CartCount: props.CartCount}) {
		@AccountOrdersContent(props)
	}
}

func orderStatusLabel(status domain.OrderStatus, fulfillment domain.FulfillmentStatus) string {
	if fulfillment == domain.FulfillmentStatusShipped {
		return "Shipped"
	}
	if fulfillment == domain.FulfillmentStatusDelivered {
		return "Delivered"
	}
	switch status {
	case domain.OrderStatusPending:
		return "Processing"
	case domain.OrderStatusConfirmed:
		return "Confirmed"
	case domain.OrderStatusComplete:
		return "Complete"
	case domain.OrderStatusCancelled:
		return "Cancelled"
	case domain.OrderStatusRefunded:
		return "Refunded"
	default:
		return string(status)
	}
}

templ orderStatusBadge(status domain.OrderStatus, fulfillment domain.FulfillmentStatus) {
	if fulfillment == domain.FulfillmentStatusDelivered {
		<span class="inline-flex items-center rounded-sm px-2 py-1 text-xs font-medium text-rr-teal-lt bg-rr-teal/10 ring-1 ring-inset ring-rr-teal/20">
			{ orderStatusLabel(status, fulfillment) }
		</span>
	} else if fulfillment == domain.FulfillmentStatusShipped {
		<span class="inline-flex items-center rounded-sm px-2 py-1 text-xs font-medium text-rr-amber bg-rr-amber/10 ring-1 ring-inset ring-rr-amber/20">
			{ orderStatusLabel(status, fulfillment) }
		</span>
	} else if status == domain.OrderStatusCancelled || status == domain.OrderStatusRefunded {
		<span class="inline-flex items-center rounded-sm px-2 py-1 text-xs font-medium text-rr-muted bg-rr-surface ring-1 ring-inset ring-rr-border">
			{ orderStatusLabel(status, fulfillment) }
		</span>
	} else {
		<span class="inline-flex items-center rounded-sm px-2 py-1 text-xs font-medium text-rr-amber bg-rr-amber/10 ring-1 ring-inset ring-rr-amber/20">
			{ orderStatusLabel(status, fulfillment) }
		</span>
	}
}

// --- Order Detail ---

type AccountOrderShowProps struct {
	Order     *domain.Order
	LineItems []domain.LineItem
	Shipments []domain.Shipment
	Address   *domain.Address
	CartCount int
}

templ AccountOrderShowContent(props AccountOrderShowProps) {
	@accountLayout("/account/orders") {
		<div>
			<div class="mb-6">
				<a href="/account/orders" class="text-sm text-rr-red hover:underline">&larr; Back to orders</a>
			</div>
			<div class="flex items-center gap-4 mb-6">
				<h1 class="font-display text-2xl tracking-widest text-rr-heading">{ props.Order.Number }</h1>
				<span class="text-sm text-rr-muted">{ formatDate(props.Order.PlacedAt) }</span>
				@orderStatusBadge(props.Order.Status, props.Order.FulfillmentStatus)
			</div>
			<!-- Line items -->
			<div class="rounded-sm border border-rr-border overflow-hidden mb-6">
				<table class="min-w-full divide-y divide-rr-border">
					<thead class="bg-rr-bg">
						<tr>
							<th class="px-4 py-3 text-left text-xs font-medium text-rr-muted uppercase">Item</th>
							<th class="px-4 py-3 text-right text-xs font-medium text-rr-muted uppercase">Qty</th>
							<th class="px-4 py-3 text-right text-xs font-medium text-rr-muted uppercase">Price</th>
							<th class="px-4 py-3 text-right text-xs font-medium text-rr-muted uppercase">Total</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border">
						for _, item := range props.LineItems {
							<tr>
								<td class="px-4 py-3 text-sm text-rr-heading">{ item.VariantID.String()[:8] }...</td>
								<td class="px-4 py-3 text-sm text-rr-heading text-right">{ fmt.Sprintf("%d", item.Quantity) }</td>
								<td class="px-4 py-3 text-sm text-rr-heading text-right">{ formatCents(item.UnitPrice) }</td>
								<td class="px-4 py-3 text-sm text-rr-heading text-right">{ formatCents(item.Total) }</td>
							</tr>
						}
					</tbody>
					<tfoot class="bg-rr-bg">
						<tr>
							<td colspan="3" class="px-4 py-2 text-sm text-rr-body text-right">Subtotal</td>
							<td class="px-4 py-2 text-sm text-rr-heading text-right">{ formatCents(props.Order.Subtotal) }</td>
						</tr>
						if props.Order.ShippingTotal > 0 {
							<tr>
								<td colspan="3" class="px-4 py-2 text-sm text-rr-body text-right">Shipping</td>
								<td class="px-4 py-2 text-sm text-rr-heading text-right">{ formatCents(props.Order.ShippingTotal) }</td>
							</tr>
						}
						if props.Order.TaxTotal > 0 {
							<tr>
								<td colspan="3" class="px-4 py-2 text-sm text-rr-body text-right">Tax</td>
								<td class="px-4 py-2 text-sm text-rr-heading text-right">{ formatCents(props.Order.TaxTotal) }</td>
							</tr>
						}
						<tr class="border-t border-rr-border">
							<td colspan="3" class="px-4 py-3 text-sm font-semibold text-rr-heading text-right">Total</td>
							<td class="px-4 py-3 text-sm font-semibold text-rr-heading text-right">{ formatCents(props.Order.Total) }</td>
						</tr>
					</tfoot>
				</table>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				<!-- Shipping address -->
				if props.Address != nil {
					<div class="rounded-sm border border-rr-border p-4">
						<h3 class="text-sm font-semibold text-rr-heading mb-2">Shipped to</h3>
						<p class="text-sm text-rr-body">
							{ props.Address.FirstName } { props.Address.LastName }<br/>
							{ props.Address.Line1 }<br/>
							if props.Address.Line2 != nil {
								{ *props.Address.Line2 }<br/>
							}
							{ props.Address.City }, { props.Address.State } { props.Address.PostalCode }
						</p>
					</div>
				}
				<!-- Tracking -->
				if len(props.Shipments) > 0 {
					<div class="rounded-sm border border-rr-border p-4">
						<h3 class="text-sm font-semibold text-rr-heading mb-2">Tracking</h3>
						for _, s := range props.Shipments {
							<div class="text-sm text-rr-body">
								<span class="font-medium">{ s.CarrierName }</span>
								<span class="mx-1">&middot;</span>
								<span class="font-mono text-xs">{ s.TrackingNumber }</span>
							</div>
						}
					</div>
				}
			</div>
		</div>
	}
}

templ AccountOrderShowPage(props AccountOrderShowProps) {
	@layouts.Storefront(layouts.StorefrontProps{Title: "Order " + props.Order.Number, CartCount: props.CartCount}) {
		@AccountOrderShowContent(props)
	}
}

// --- Subscriptions ---

type AccountSubscriptionsProps struct {
	Subscriptions []domain.Subscription
	Plans         map[uuid.UUID]*domain.SubscriptionPlan
	CartCount     int
}

func subscriptionStatusBadgeClass(status domain.SubscriptionStatus) string {
	switch status {
	case domain.SubscriptionStatusActive:
		return "bg-rr-teal/10 text-rr-teal-lt ring-rr-teal/20"
	case domain.SubscriptionStatusPaused:
		return "bg-rr-amber/10 text-rr-amber ring-rr-amber/20"
	case domain.SubscriptionStatusCancelled:
		return "bg-rr-surface text-rr-muted ring-rr-border"
	case domain.SubscriptionStatusPastDue:
		return "bg-rr-red/10 text-rr-red-lt ring-rr-red/20"
	default:
		return "bg-rr-surface text-rr-muted ring-rr-border"
	}
}

func intervalLabel(interval domain.SubscriptionInterval) string {
	switch interval {
	case domain.SubscriptionIntervalEvery7Days:
		return "Weekly"
	case domain.SubscriptionIntervalEvery14Days:
		return "Every 2 weeks"
	case domain.SubscriptionIntervalEvery21Days:
		return "Every 3 weeks"
	case domain.SubscriptionIntervalEvery30Days:
		return "Monthly"
	case domain.SubscriptionIntervalEvery60Days:
		return "Every 2 months"
	case domain.SubscriptionIntervalEvery90Days:
		return "Every 3 months"
	default:
		return string(interval)
	}
}

templ AccountSubscriptionsContent(props AccountSubscriptionsProps) {
	@accountLayout("/account/subscriptions") {
		<h1 class="font-display text-2xl tracking-widest text-rr-heading mb-6">Subscriptions</h1>
		if len(props.Subscriptions) == 0 {
			<div class="text-center py-12">
				<svg class="mx-auto size-12 text-rr-faint" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182M2.985 19.644l3.181-3.182"></path></svg>
				<h3 class="mt-2 text-sm font-semibold text-rr-heading">No subscriptions</h3>
				<p class="mt-1 text-sm text-rr-muted">Subscribe to your favorites and never run out.</p>
				<div class="mt-6">
					<a href="/subscriptions" class="btn inline-block rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt">
						View subscription plans
					</a>
				</div>
			</div>
		} else {
			<div class="space-y-4">
				for _, sub := range props.Subscriptions {
					<div class="rounded-sm border border-rr-border p-5">
						<div class="flex items-start justify-between mb-3">
							<div>
								if plan, ok := props.Plans[sub.PlanID]; ok {
									<h3 class="font-medium text-rr-heading">{ plan.Name }</h3>
									<p class="text-sm text-rr-muted">{ intervalLabel(plan.Interval) } &middot; Qty { fmt.Sprintf("%d", sub.Quantity) }</p>
								}
							</div>
							<span class={ "inline-flex items-center rounded-sm px-2 py-1 text-xs font-medium ring-1 ring-inset " + subscriptionStatusBadgeClass(sub.Status) }>
								{ string(sub.Status) }
							</span>
						</div>
						if sub.Status == domain.SubscriptionStatusActive {
							<p class="text-sm text-rr-body mb-4">
								Next order: <span class="font-medium">{ formatDate(sub.NextOrderAt) }</span>
							</p>
							<div class="flex gap-2" x-data="{ confirming: '' }">
								<button x-show="confirming !== 'pause'" x-on:click="confirming = 'pause'" class="rounded-sm border border-rr-border px-3 py-1.5 text-sm font-medium text-rr-body hover:bg-rr-bg">
									Pause
								</button>
								<div x-show="confirming === 'pause'" x-cloak class="flex items-center gap-2">
									<span class="text-sm text-rr-body">Pause this subscription?</span>
									<form method="POST" action={ templ.SafeURL("/account/subscriptions/" + sub.ID.String() + "/pause") }>
										<button type="submit" class="btn rounded-sm bg-rr-amber px-3 py-1.5 text-sm font-medium text-white hover:bg-rr-amber-lt">Yes, pause</button>
									</form>
									<button x-on:click="confirming = ''" class="text-sm text-rr-muted hover:text-rr-body">Cancel</button>
								</div>
								<button x-show="confirming !== 'cancel'" x-on:click="confirming = 'cancel'" class="btn rounded-sm border border-rr-red px-3 py-1.5 text-sm font-medium text-rr-red hover:bg-rr-red/10">
									Cancel
								</button>
								<div x-show="confirming === 'cancel'" x-cloak class="flex items-center gap-2">
									<span class="text-sm text-rr-body">Cancel this subscription?</span>
									<form method="POST" action={ templ.SafeURL("/account/subscriptions/" + sub.ID.String() + "/cancel") }>
										<button type="submit" class="btn rounded-sm bg-rr-red px-3 py-1.5 text-sm font-medium text-white hover:bg-rr-red-lt">Yes, cancel</button>
									</form>
									<button x-on:click="confirming = ''" class="text-sm text-rr-muted hover:text-rr-body">Never mind</button>
								</div>
							</div>
						}
						if sub.Status == domain.SubscriptionStatusPaused {
							<p class="text-sm text-rr-body mb-4">Paused &mdash; no upcoming orders.</p>
							<form method="POST" action={ templ.SafeURL("/account/subscriptions/" + sub.ID.String() + "/resume") }>
								<button type="submit" class="btn rounded-sm bg-rr-red px-3 py-1.5 text-sm font-medium text-white hover:bg-rr-red-lt">
									Resume
								</button>
							</form>
						}
						if sub.Status == domain.SubscriptionStatusCancelled {
							<p class="text-sm text-rr-muted">
								Cancelled
								if sub.CancelledAt != nil {
									on { formatDate(*sub.CancelledAt) }
								}
							</p>
						}
					</div>
				}
			</div>
		}
	}
}

templ AccountSubscriptionsPage(props AccountSubscriptionsProps) {
	@layouts.Storefront(layouts.StorefrontProps{Title: "Subscriptions", CartCount: props.CartCount}) {
		@AccountSubscriptionsContent(props)
	}
}

// --- Addresses ---

type AccountAddressesProps struct {
	Addresses []domain.Address
	CartCount int
}

templ AccountAddressesContent(props AccountAddressesProps) {
	@accountLayout("/account/addresses") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="font-display text-2xl tracking-widest text-rr-heading">Addresses</h1>
			<button type="button" x-data x-on:click="$dispatch('toggle-add-address')"
				class="btn rounded-sm bg-rr-red px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt">
				+ Add address
			</button>
		</div>
		<!-- Add address form (hidden by default) -->
		<div x-data="{ open: false }" x-on:toggle-add-address.window="open = !open">
			<div x-show="open" x-cloak class="mb-6 rounded-sm border border-rr-border p-4">
				<h3 class="text-sm font-semibold text-rr-heading mb-3">New address</h3>
				@addressForm("/account/addresses", nil)
			</div>
		</div>
		if len(props.Addresses) == 0 {
			<p class="text-sm text-rr-muted">No saved addresses yet.</p>
		} else {
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				for _, addr := range props.Addresses {
					<div class="rounded-sm border border-rr-border p-4" x-data="{ editing: false }">
						<div x-show="!editing">
							<div class="flex items-start justify-between mb-2">
								<div>
									<span class="font-medium text-rr-heading">{ addr.FirstName } { addr.LastName }</span>
									if addr.IsDefault {
										<span class="ml-2 inline-flex items-center rounded-sm bg-rr-red/10 px-2 py-0.5 text-xs font-medium text-rr-red">Default</span>
									}
								</div>
							</div>
							<p class="text-sm text-rr-body">
								{ addr.Line1 }<br/>
								if addr.Line2 != nil {
									{ *addr.Line2 }<br/>
								}
								{ addr.City }, { addr.State } { addr.PostalCode }
							</p>
							<div class="mt-3 flex gap-2">
								<button x-on:click="editing = true" class="text-sm text-rr-red hover:underline">Edit</button>
								if !addr.IsDefault {
									<form method="POST" action={ templ.SafeURL("/account/addresses/" + addr.ID.String() + "/default") }>
										<button type="submit" class="text-sm text-rr-body hover:underline">Set default</button>
									</form>
									<form method="POST" action={ templ.SafeURL("/account/addresses/" + addr.ID.String() + "/delete") }
										x-data x-on:submit="if (!confirm('Delete this address?')) $event.preventDefault()">
										<button type="submit" class="text-sm text-rr-red hover:text-rr-red-lt">Delete</button>
									</form>
								}
							</div>
						</div>
						<div x-show="editing" x-cloak>
							<h3 class="text-sm font-semibold text-rr-heading mb-3">Edit address</h3>
							@addressForm("/account/addresses/"+addr.ID.String(), &addr)
							<button x-on:click="editing = false" class="mt-2 text-sm text-rr-muted hover:underline">Cancel</button>
						</div>
					</div>
				}
			</div>
		}
	}
}

templ addressForm(action string, addr *domain.Address) {
	<form method="POST" action={ templ.SafeURL(action) } class="space-y-3">
		<div class="grid grid-cols-2 gap-3">
			<div>
				<label for={ addrInputID(addr, "first_name") } class="block text-xs font-medium text-rr-body mb-1">First name</label>
				<input type="text" id={ addrInputID(addr, "first_name") } name="first_name" value={ addrField(addr, "first_name") } required
					class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-sm text-rr-heading focus:outline-none"/>
			</div>
			<div>
				<label for={ addrInputID(addr, "last_name") } class="block text-xs font-medium text-rr-body mb-1">Last name</label>
				<input type="text" id={ addrInputID(addr, "last_name") } name="last_name" value={ addrField(addr, "last_name") } required
					class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-sm text-rr-heading focus:outline-none"/>
			</div>
		</div>
		<div>
			<label for={ addrInputID(addr, "company") } class="block text-xs font-medium text-rr-body mb-1">Company (optional)</label>
			<input type="text" id={ addrInputID(addr, "company") } name="company" value={ addrField(addr, "company") }
				class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-sm text-rr-heading focus:outline-none"/>
		</div>
		<div>
			<label for={ addrInputID(addr, "line1") } class="block text-xs font-medium text-rr-body mb-1">Address</label>
			<input type="text" id={ addrInputID(addr, "line1") } name="line1" value={ addrField(addr, "line1") } required
				class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-sm text-rr-heading focus:outline-none"/>
		</div>
		<div>
			<label for={ addrInputID(addr, "line2") } class="block text-xs font-medium text-rr-body mb-1">Apartment, suite, etc. (optional)</label>
			<input type="text" id={ addrInputID(addr, "line2") } name="line2" value={ addrField(addr, "line2") }
				class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-sm text-rr-heading focus:outline-none"/>
		</div>
		<div class="grid grid-cols-3 gap-3">
			<div>
				<label for={ addrInputID(addr, "city") } class="block text-xs font-medium text-rr-body mb-1">City</label>
				<input type="text" id={ addrInputID(addr, "city") } name="city" value={ addrField(addr, "city") } required
					class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-sm text-rr-heading focus:outline-none"/>
			</div>
			<div>
				<label for={ addrInputID(addr, "state") } class="block text-xs font-medium text-rr-body mb-1">State</label>
				<input type="text" id={ addrInputID(addr, "state") } name="state" value={ addrField(addr, "state") } required
					class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-sm text-rr-heading focus:outline-none"/>
			</div>
			<div>
				<label for={ addrInputID(addr, "postal_code") } class="block text-xs font-medium text-rr-body mb-1">ZIP</label>
				<input type="text" id={ addrInputID(addr, "postal_code") } name="postal_code" value={ addrField(addr, "postal_code") } required
					class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-sm text-rr-heading focus:outline-none"/>
			</div>
		</div>
		<button type="submit" class="btn rounded-sm bg-rr-red px-3 py-1.5 text-sm font-semibold text-white hover:bg-rr-red-lt">
			Save
		</button>
	</form>
}

// addrInputID returns a unique ID for an address form input.
// Uses the address ID to avoid collisions when multiple forms appear on the same page (add + edit).
func addrInputID(addr *domain.Address, field string) string {
	if addr == nil {
		return "addr-new-" + field
	}
	return "addr-" + addr.ID.String()[:8] + "-" + field
}

func addrField(addr *domain.Address, field string) string {
	if addr == nil {
		return ""
	}
	switch field {
	case "first_name":
		return addr.FirstName
	case "last_name":
		return addr.LastName
	case "company":
		if addr.Company != nil {
			return *addr.Company
		}
		return ""
	case "line1":
		return addr.Line1
	case "line2":
		if addr.Line2 != nil {
			return *addr.Line2
		}
		return ""
	case "city":
		return addr.City
	case "state":
		return addr.State
	case "postal_code":
		return addr.PostalCode
	default:
		return ""
	}
}

templ AccountAddressesPage(props AccountAddressesProps) {
	@layouts.Storefront(layouts.StorefrontProps{Title: "Addresses", CartCount: props.CartCount}) {
		@AccountAddressesContent(props)
	}
}
