package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type AccountForgotPasswordProps struct {
	Error   string
	Success string
	Email   string
}

templ AccountForgotPasswordContent(props AccountForgotPasswordProps) {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)] flex items-center">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-md lg:max-w-xl w-full px-6 sm:px-10 lg:px-14 py-14 sm:py-20">
			<!-- Page heading -->
			<div class="text-center mb-8">
				<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
					Account access
				</p>
				<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(1.75rem, 4.5vw, 2.75rem); letter-spacing:-0.005em;">
					Password
					<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">reset.</span>
				</h1>
				<p class="font-oswald text-ink-soft text-sm mt-3 max-w-xs mx-auto leading-relaxed">
					Enter your email and we'll send you a link to set a new password.
				</p>
			</div>
			<!-- Card -->
			<div class="border-2 border-ink bg-cream-hi shadow-stamp p-6 sm:p-8">
				if props.Error != "" {
					<div class="mb-5 border-2 border-rust bg-paper p-3 text-center">
						<p class="font-oswald font-bold text-rust text-sm" style="letter-spacing:0.04em;">{ props.Error }</p>
					</div>
				}
				if props.Success != "" {
					<div class="border-2 border-ink bg-candle/20 p-5 text-center">
						<svg class="mx-auto size-8 text-ink mb-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"></path>
						</svg>
						<p class="font-slab text-ink text-lg uppercase mb-1" style="letter-spacing:0.02em;">Check your inbox</p>
						<p class="font-oswald text-ink-soft text-sm" style="letter-spacing:0.04em;">{ props.Success }</p>
						<a href="/account/login" class="inline-block mt-4 font-oswald font-bold text-rust text-xs underline" style="letter-spacing:0.14em; text-transform:uppercase;">Back to sign in</a>
					</div>
				} else {
					<form method="post" action="/account/forgot-password" class="space-y-5">
						<div>
							<label for="email" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Email address</label>
							<input
								type="email"
								name="email"
								id="email"
								required
								autocomplete="email"
								value={ props.Email }
								placeholder="you@example.com"
								class="paper-input w-full border-2 border-ink bg-paper px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
								style="letter-spacing:0.04em;"
							/>
						</div>
						<button
							type="submit"
							class="btn-stamp w-full inline-flex items-center justify-center gap-2 bg-rust text-paper border-2 border-ink px-6 py-3.5 font-oswald font-bold text-sm"
							style="letter-spacing:0.16em; text-transform:uppercase;"
						>
							Send reset link
							<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
							</svg>
						</button>
						<p class="text-center">
							<a href="/account/login" class="font-oswald font-bold text-rust text-xs underline" style="letter-spacing:0.14em; text-transform:uppercase;">Back to sign in</a>
						</p>
					</form>
				}
			</div>
		</div>
	</section>
}

templ AccountForgotPasswordPage(props AccountForgotPasswordProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Reset Password",
		Description: "Reset your Rockabilly Roasting Co. account password.",
	}) {
		@AccountForgotPasswordContent(props)
	}
}
