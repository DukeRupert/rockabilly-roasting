package storefront

import (
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// AccountSecurityProps holds view state for the account security page.
// Step 5 will flesh out the styled implementation; this stub is enough to
// compile step 4's web handlers.
type AccountSecurityProps struct {
	Customer     *domain.Customer
	HasPassword  bool
	InitialSetup bool
	Error        string
	Success      string
}

templ AccountSecurityContent(props AccountSecurityProps) {
	@accountLayout("/account/security") {
		<div class="max-w-lg">
			@accountPageHeading("Security", "Password")
			if props.Error != "" {
				<div class="mb-6 border-2 border-rust bg-cream-hi px-4 py-3">
					<p class="font-oswald font-bold text-rust text-sm" style="letter-spacing:0.04em;">{ props.Error }</p>
				</div>
			}
			if props.Success != "" {
				<div class="mb-6 border-2 border-ink bg-candle/20 px-4 py-3">
					<p class="font-oswald text-ink text-sm" style="letter-spacing:0.04em;">{ props.Success }</p>
				</div>
			}
			if !props.HasPassword {
				<!-- Set password for the first time -->
				<p class="mb-6 font-oswald text-ink-soft text-sm" style="letter-spacing:0.04em;">
					Add a password to your account so you can sign in without a magic link.
				</p>
				<form method="POST" action="/account/security/set" class="space-y-5">
					<div>
						<label for="new_password" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">New password</label>
						<input
							type="password"
							id="new_password"
							name="new_password"
							required
							minlength="10"
							autocomplete="new-password"
							class="paper-input w-full border-2 border-ink bg-cream-hi px-3.5 py-2.5 font-oswald text-sm text-ink focus:outline-none"
							style="letter-spacing:0.04em;"
						/>
						<p class="mt-2 font-oswald text-chrome-deep text-xs" style="letter-spacing:0.04em;">Minimum 10 characters.</p>
					</div>
					<div class="pt-2">
						<button type="submit" class="btn-stamp inline-flex items-center gap-2 bg-rust text-paper border-2 border-ink px-6 py-3 font-oswald font-bold text-sm" style="letter-spacing:0.16em; text-transform:uppercase;">
							Set password
						</button>
					</div>
				</form>
			} else {
				<!-- Change existing password -->
				<p class="mb-6 font-oswald text-ink-soft text-sm" style="letter-spacing:0.04em;">
					Update your password below. You'll still be able to sign in with a magic link at any time.
				</p>
				<form method="POST" action="/account/security/change" class="space-y-5">
					<div>
						<label for="current_password" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Current password</label>
						<input
							type="password"
							id="current_password"
							name="current_password"
							required
							autocomplete="current-password"
							class="paper-input w-full border-2 border-ink bg-cream-hi px-3.5 py-2.5 font-oswald text-sm text-ink focus:outline-none"
							style="letter-spacing:0.04em;"
						/>
					</div>
					<div>
						<label for="new_password" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">New password</label>
						<input
							type="password"
							id="new_password"
							name="new_password"
							required
							minlength="10"
							autocomplete="new-password"
							class="paper-input w-full border-2 border-ink bg-cream-hi px-3.5 py-2.5 font-oswald text-sm text-ink focus:outline-none"
							style="letter-spacing:0.04em;"
						/>
						<p class="mt-2 font-oswald text-chrome-deep text-xs" style="letter-spacing:0.04em;">Minimum 10 characters.</p>
					</div>
					<div class="pt-2">
						<button type="submit" class="btn-stamp inline-flex items-center gap-2 bg-rust text-paper border-2 border-ink px-6 py-3 font-oswald font-bold text-sm" style="letter-spacing:0.16em; text-transform:uppercase;">
							Update password
						</button>
					</div>
				</form>
			}
		</div>
	}
}

templ AccountSecurityPage(props AccountSecurityProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Password & Security",
		Description: "Manage your Rockabilly Roasting Co. account password.",
	}) {
		@AccountSecurityContent(props)
	}
}
