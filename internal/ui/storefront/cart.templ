package storefront

import (
	"fmt"
	"github.com/google/uuid"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type CartItemDisplay struct {
	ItemID       uuid.UUID
	VariantID    uuid.UUID
	ProductTitle string
	SKU          string
	Quantity     int
	UnitPrice    int
	LineTotal    int
}

type CartPageProps struct {
	Items     []CartItemDisplay
	Subtotal  int
	CartCount int
}

templ CartContent(props CartPageProps) {
	<div>
		<h1 class="font-display text-4xl tracking-widest text-rr-heading mb-8">YOUR CART</h1>
		if len(props.Items) == 0 {
			<div class="text-center py-12">
				<p class="text-rr-muted mb-4">Your cart is empty.</p>
				<a href="/catalog" class="text-rr-red hover:text-rr-red-lt font-medium">Continue shopping</a>
			</div>
		} else {
			<div id="cart-items">
				<table class="min-w-full divide-y divide-rr-border">
					<thead>
						<tr>
							<th scope="col" class="py-3.5 pl-0 pr-3 text-left label-font text-rr-muted">Product</th>
							<th scope="col" class="px-3 py-3.5 text-left label-font text-rr-muted">Price</th>
							<th scope="col" class="px-3 py-3.5 text-left label-font text-rr-muted">Quantity</th>
							<th scope="col" class="px-3 py-3.5 text-right label-font text-rr-muted">Total</th>
							<th scope="col" class="relative py-3.5 pl-3 pr-0">
								<span class="sr-only">Remove</span>
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border">
						for _, item := range props.Items {
							<tr>
								<td class="py-4 pl-0 pr-3">
									<div>
										<p class="text-sm font-medium text-rr-heading">{ item.ProductTitle }</p>
										<p class="text-sm text-rr-muted font-mono">{ item.SKU }</p>
									</div>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-rr-body">
									{ formatCents(item.UnitPrice) }
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm">
									<form
										method="post"
										action="/cart/update"
										hx-post="/cart/update"
										hx-target="#main-content"
										hx-swap="innerHTML"
										class="flex items-center gap-2"
									>
										<input type="hidden" name="item_id" value={ item.ItemID.String() }/>
										<input
											type="number"
											name="quantity"
											value={ fmt.Sprintf("%d", item.Quantity) }
											min="1"
											class="w-16 rounded-sm border border-rr-border bg-rr-bg py-1 px-2 text-sm font-body text-rr-heading focus:border-rr-amber focus:ring-1 focus:ring-rr-amber"
										/>
										<button type="submit" class="text-xs font-medium text-rr-red hover:text-rr-red-lt">
											Update
										</button>
									</form>
								</td>
								<td class="whitespace-nowrap px-3 py-4 text-sm text-right font-medium text-rr-heading">
									{ formatCents(item.LineTotal) }
								</td>
								<td class="whitespace-nowrap py-4 pl-3 pr-0 text-right text-sm">
									<form
										method="post"
										action="/cart/remove"
										hx-post="/cart/remove"
										hx-target="#main-content"
										hx-swap="innerHTML"
									>
										<input type="hidden" name="item_id" value={ item.ItemID.String() }/>
										<button type="submit" class="text-rr-red hover:text-rr-red-lt text-sm font-medium">
											Remove
										</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
				<!-- Subtotal -->
				<div class="mt-8 border-t border-rr-border pt-6">
					<div class="flex justify-between text-base font-medium text-rr-heading">
						<p>Subtotal</p>
						<p>{ formatCents(props.Subtotal) }</p>
					</div>
					<p class="mt-1 text-sm text-rr-muted">Shipping and taxes calculated at checkout.</p>
					<div class="mt-6">
						<a
							href="/checkout"
							hx-boost="false"
							class="btn block w-full rounded-sm bg-rr-red px-6 py-4 text-center label-font text-sm text-white glow-red hover:bg-rr-red-lt"
						>
							Checkout
						</a>
					</div>
					<div class="mt-4 text-center">
						<a href="/catalog" class="text-sm text-rr-red hover:text-rr-red-lt font-medium">
							Continue shopping
						</a>
					</div>
				</div>
			</div>
		}
	</div>
}

templ CartPage(props CartPageProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:     "Cart",
		CartCount: props.CartCount,
	}) {
		@CartContent(props)
	}
}

templ CartBadge(count int) {
	if count > 0 {
		<span id="cart-badge" hx-swap-oob="true" class="absolute -top-1 -right-1 flex size-5 items-center justify-center rounded-full bg-rr-red text-xs font-bold text-white">
			{ fmt.Sprintf("%d", count) }
		</span>
	} else {
		<span id="cart-badge" hx-swap-oob="true" class="absolute -top-1 -right-1"></span>
	}
}
