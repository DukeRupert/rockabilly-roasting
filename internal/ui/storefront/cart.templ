package storefront

import (
	"encoding/json"
	"fmt"
	"strings"
	"github.com/google/uuid"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type CartItemDisplay struct {
	ItemID       uuid.UUID
	VariantID    uuid.UUID
	ProductTitle string
	ProductSlug  string
	VariantLabel string // human-readable options, e.g. "Whole Bean · 12oz"; "" when the product has no options
	ThumbnailURL string
	SKU          string
	Quantity     int
	UnitPrice    int
	LineTotal    int
}

type CartPageProps struct {
	CartID             uuid.UUID // real cart ID, shown as a short reference on the receipt strip
	Items              []CartItemDisplay
	Subtotal           int
	CartCount          int
	FreeShippingHint   string // e.g. "Spend $12.00 more for free shipping"; "" if unused
}

// cartRef renders the cart's short reference — the first 8 hex chars of the
// real cart UUID. Stable across edits and usable in a support conversation,
// unlike a decorative made-up number.
func cartRef(id uuid.UUID) string {
	return strings.ToUpper(id.String()[:8])
}

// cartAnalyticsScript renders the cart contents for view_cart / remove_from_cart,
// wrapped in a <script id="ga-cart-data"> tag. The tag is emitted via
// @templ.Raw because templ does not interpolate Go expressions inside <script>
// bodies. VariantID is used as item_id since we don't expose the parent
// product UUID on the cart line — variant SKU still flows through as
// item_variant.
func cartAnalyticsScript(props CartPageProps) string {
	type itemEntry struct {
		ItemID      string `json:"item_id"`
		ItemName    string `json:"item_name"`
		ItemVariant string `json:"item_variant,omitempty"`
		PriceCents  int    `json:"price_cents"`
		Quantity    int    `json:"quantity"`
	}
	items := make(map[string]itemEntry, len(props.Items))
	list := make([]itemEntry, 0, len(props.Items))
	for _, it := range props.Items {
		entry := itemEntry{
			ItemID:      it.VariantID.String(),
			ItemName:    it.ProductTitle,
			ItemVariant: it.SKU,
			PriceCents:  it.UnitPrice,
			Quantity:    it.Quantity,
		}
		items[it.ItemID.String()] = entry
		list = append(list, entry)
	}
	b, err := json.Marshal(map[string]any{
		"currency":     "USD",
		"value_cents":  props.Subtotal,
		"items":        list,
		"by_cart_item": items,
	})
	if err != nil {
		return ""
	}
	return `<script id="ga-cart-data" type="application/json">` + string(b) + `</script>`
}

// cartQtyState returns the Alpine component backing a cart line's quantity
// stepper. The minus/plus buttons submit the form themselves after a short
// debounce, so rapid taps collapse into one request instead of one swap each.
func cartQtyState(qty int) string {
	return fmt.Sprintf(`{
		qty: %d,
		timer: null,
		clamp() {
			let v = parseInt(this.qty, 10);
			if (isNaN(v) || v < 1) v = 1;
			else if (v > 99) v = 99;
			this.qty = v;
		},
		bump(delta) {
			const next = Math.max(1, Math.min(99, this.qty + delta));
			if (next === this.qty) return;
			this.qty = next;
			this.queue();
		},
		queue() {
			clearTimeout(this.timer);
			this.timer = setTimeout(() => this.$root.requestSubmit(), 400);
		}
	}`, qty)
}

templ CartContent(props CartPageProps) {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)]">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-4xl px-6 sm:px-10 lg:px-14 py-10 sm:py-14">
			<!-- Page heading -->
			<div class="mb-8 sm:mb-10">
				<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
					Your order
				</p>
				<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(2.25rem, 5vw, 3.5rem); letter-spacing:-0.005em;">
					In the
					<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">bag.</span>
				</h1>
			</div>
			if len(props.Items) == 0 {
				<!-- Empty state -->
				<div class="border-2 border-ink bg-cream-hi py-16 px-6 text-center shadow-stamp">
					<svg class="mx-auto size-10 text-ink mb-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"></path>
					</svg>
					<p class="font-oswald text-ink text-base" style="letter-spacing:0.04em;">Nothing in the bag yet.</p>
					<a href="/catalog" class="btn-stamp inline-flex items-center gap-2 mt-6 bg-rust text-paper border-2 border-ink px-6 py-3 font-oswald font-bold text-sm" style="letter-spacing:0.14em; text-transform:uppercase;">
						Browse all coffee
						<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
						</svg>
					</a>
				</div>
			} else {
				<div id="cart-items" class="grid lg:grid-cols-3 lg:gap-10 gap-8">
					<!-- Line items column -->
					<div class="lg:col-span-2">
						<h2 class="sr-only">Items in your cart</h2>
						<!-- Receipt-style header strip -->
						<div class="border-t-2 border-b-2 border-ink py-2 flex items-center justify-between">
							<span class="font-oswald font-bold text-ink text-[11px]" style="letter-spacing:0.2em; text-transform:uppercase;">
								{ fmt.Sprintf("%d %s", itemCount(props.Items), itemCountLabel(props.Items)) }
							</span>
							<span class="font-special text-chrome-deep text-xs">cart #{ cartRef(props.CartID) }</span>
						</div>
						<ul class="divide-y-2 divide-ink">
							for _, item := range props.Items {
								<!-- One row at every width: thumbnail, then details with the
								     line total pinned right and the controls underneath. The
								     old stacked-on-mobile version ran ~320px per line, which
								     pushed the checkout button off a phone screen after a
								     single item. -->
								<li class="py-5 flex items-start gap-4">
									<!-- Thumbnail -->
									<a
										href={ templ.SafeURL("/catalog/" + item.ProductSlug) }
										class="flex-shrink-0 w-16 h-16 sm:w-20 sm:h-20 bg-paper-warm border-2 border-ink overflow-hidden"
										aria-hidden="true"
										tabindex="-1"
									>
										if item.ThumbnailURL != "" {
											<img
												src={ item.ThumbnailURL }
												alt=""
												width="160"
												height="160"
												class="h-full w-full object-cover object-center"
												loading="lazy"
											/>
										} else {
											<span class="flex h-full w-full items-center justify-center font-slab text-ink text-xl leading-none uppercase">
												{ string([]rune(item.ProductTitle)[0:1]) }
											</span>
										}
									</a>
									<!-- Details: title, variant, unit price, line total, controls -->
									<div class="flex-1 min-w-0">
										<div class="flex items-start justify-between gap-3">
											<h3 class="font-slab text-ink uppercase leading-[0.95] text-lg sm:text-xl min-w-0" style="letter-spacing:-0.005em;">
												<a href={ templ.SafeURL("/catalog/" + item.ProductSlug) } class="hover:text-rust transition-colors">
													{ item.ProductTitle }
												</a>
											</h3>
											<p class="font-special text-ink text-base shrink-0">{ formatCents(item.LineTotal) }</p>
										</div>
										if item.VariantLabel != "" {
											<p class="font-special text-ink-soft text-sm mt-1">{ item.VariantLabel }</p>
										}
										<p class="font-special text-ink-soft text-sm mt-1">
											{ formatCents(item.UnitPrice) } &middot; ea
										</p>
										<div class="mt-3 flex items-center justify-between sm:justify-start gap-3 sm:gap-6">
											<!-- Quantity stepper. The minus/plus buttons submit the form
											     themselves (debounced, so a double tap is one request) —
											     typing into a number field and hunting for a 15px "Update"
											     link is not a thing you can do one-handed on a phone. The
											     submit button stays as the no-JS path. -->
											<form
												method="post"
												action="/cart/update"
												hx-post="/cart/update"
												hx-target="#main-content"
												hx-swap="innerHTML"
												class="inline-flex items-stretch border-2 border-ink"
												x-data={ cartQtyState(item.Quantity) }
											>
												<input type="hidden" name="item_id" value={ item.ItemID.String() }/>
												<button
													type="button"
													@click="bump(-1)"
													:disabled="qty <= 1"
													aria-label={ "Decrease quantity for " + item.ProductTitle }
													class="min-h-11 min-w-11 bg-paper-warm text-ink font-oswald font-bold text-lg leading-none border-r-2 border-ink hover:bg-ink hover:text-paper transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
												>
													&minus;
												</button>
												<input
													type="number"
													name="quantity"
													x-model.number="qty"
													@change="clamp(); queue()"
													value={ fmt.Sprintf("%d", item.Quantity) }
													min="1"
													max="99"
													aria-label={ "Quantity for " + item.ProductTitle }
													class="paper-input w-12 min-h-11 bg-cream-hi px-1 font-special text-center text-ink text-base focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
												/>
												<button
													type="button"
													@click="bump(1)"
													:disabled="qty >= 99"
													aria-label={ "Increase quantity for " + item.ProductTitle }
													class="min-h-11 min-w-11 bg-paper-warm text-ink font-oswald font-bold text-lg leading-none border-l-2 border-ink hover:bg-ink hover:text-paper transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
												>
													+
												</button>
												<button
													type="submit"
													class="sr-only"
													aria-label={ "Update quantity for " + item.ProductTitle }
												>
													Update
												</button>
											</form>
											<!-- Remove -->
											<form
												method="post"
												action="/cart/remove"
												hx-post="/cart/remove"
												hx-target="#main-content"
												hx-swap="innerHTML"
												data-rr-cart-remove
												data-rr-cart-item-id={ item.ItemID.String() }
											>
												<input type="hidden" name="item_id" value={ item.ItemID.String() }/>
												<button
													type="submit"
													class="font-oswald font-bold text-[10px] text-chrome-deep hover:text-rust transition-colors inline-flex items-center gap-1 min-h-11 px-2 -mr-2"
													style="letter-spacing:0.18em; text-transform:uppercase;"
													aria-label={ "Remove " + item.ProductTitle + " from cart" }
												>
													<svg class="size-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
														<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
													</svg>
													Remove
												</button>
											</form>
										</div>
									</div>
								</li>
							}
						</ul>
					</div>
					<!-- Summary column -->
					<aside class="lg:col-span-1">
						<div class="border-2 border-ink bg-cream-hi shadow-stamp p-6 sm:p-7 lg:sticky lg:top-24">
							<p class="font-oswald font-bold text-candle text-[11px] mb-4 pb-2 border-b-2 border-ink" style="letter-spacing:0.24em; text-transform:uppercase;">Summary</p>
							<dl class="space-y-2.5">
								<div class="flex items-baseline justify-between">
									<dt class="font-oswald text-ink-soft text-sm" style="letter-spacing:0.04em;">Subtotal</dt>
									<dd class="font-special text-ink text-base">{ formatCents(props.Subtotal) }</dd>
								</div>
								<div class="flex items-baseline justify-between">
									<dt class="font-oswald text-chrome-deep text-sm" style="letter-spacing:0.04em;">Shipping</dt>
									<dd class="font-special text-chrome-deep text-sm">At checkout</dd>
								</div>
								if props.FreeShippingHint != "" {
									<p class="font-oswald text-rust text-xs" style="letter-spacing:0.06em;">
										{ props.FreeShippingHint }
									</p>
								}
								<div class="flex items-baseline justify-between">
									<dt class="font-oswald text-chrome-deep text-sm" style="letter-spacing:0.04em;">Taxes</dt>
									<dd class="font-special text-chrome-deep text-sm">At checkout</dd>
								</div>
							</dl>
							<div class="mt-5 pt-4 border-t-2 border-ink flex items-baseline justify-between">
								<span class="font-slab text-ink text-lg uppercase" style="letter-spacing:0.02em;">Total</span>
								<span class="font-special text-ink text-xl">{ formatCents(props.Subtotal) }</span>
							</div>
							<a
								href="/checkout"
								hx-boost="false"
								class="btn-stamp mt-6 flex w-full items-center justify-center gap-2 bg-rust text-paper border-2 border-ink px-6 py-4 font-oswald font-bold text-sm"
								style="letter-spacing:0.16em; text-transform:uppercase;"
							>
								Checkout
								<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
								</svg>
							</a>
							<p class="mt-3 font-oswald text-chrome-deep text-xs text-center" style="letter-spacing:0.04em;">
								Secure checkout · Ships within 48 hours.
							</p>
							<a href="/catalog" class="mt-4 block text-center font-oswald font-bold text-xs text-ink hover:text-rust transition-colors" style="letter-spacing:0.18em; text-transform:uppercase;">
								← Keep shopping
							</a>
						</div>
					</aside>
				</div>
				<!-- Clearance for the sticky mobile checkout bar -->
				<div class="lg:hidden h-20" aria-hidden="true"></div>
				@cartMobileBar(props.Subtotal)
			}
		</div>
	</section>
	if len(props.Items) > 0 {
		@templ.Raw(cartAnalyticsScript(props))
		<script>
			(function() {
				var node = document.getElementById('ga-cart-data');
				if (!node || !window.rrTrack) return;
				var data;
				try { data = JSON.parse(node.textContent); } catch (e) { return; }
				var items = (data.items || []).map(function(it) {
					return {
						item_id: it.item_id,
						item_name: it.item_name,
						item_variant: it.item_variant || undefined,
						price: (it.price_cents || 0) / 100,
						quantity: it.quantity || 1
					};
				});
				window.rrTrack('view_cart', {
					currency: data.currency || 'USD',
					value: (data.value_cents || 0) / 100,
					items: items
				});
				document.querySelectorAll('form[data-rr-cart-remove]').forEach(function(f) {
					if (f.dataset.rrBound) return;
					f.dataset.rrBound = '1';
					f.addEventListener('htmx:beforeRequest', function() {
						var cartItemID = f.dataset.rrCartItemId;
						var entry = (data.by_cart_item || {})[cartItemID];
						if (!entry) return;
						var price = (entry.price_cents || 0) / 100;
						window.rrTrack('remove_from_cart', {
							currency: data.currency || 'USD',
							value: price * (entry.quantity || 1),
							items: [{
								item_id: entry.item_id,
								item_name: entry.item_name,
								item_variant: entry.item_variant || undefined,
								price: price,
								quantity: entry.quantity || 1
							}]
						});
					});
				});
			})();
		</script>
	}
}

// cartMobileBar is the phone/tablet sticky checkout bar. The summary card only
// becomes a sticky sidebar at lg; below that it sits under the line items, so
// on a phone the total and the checkout button scroll away entirely. The bar
// reveals itself once the real checkout button leaves the viewport.
templ cartMobileBar(subtotal int) {
	<div
		id="cart-mobile-bar"
		class="lg:hidden fixed inset-x-0 bottom-0 z-40 border-t-2 border-ink bg-paper translate-y-full motion-safe:transition-[translate,visibility] motion-safe:duration-200 motion-safe:ease-linear"
		style="padding:0.625rem 1rem calc(0.625rem + env(safe-area-inset-bottom));"
		aria-hidden="true"
	>
		<div class="flex items-center gap-3">
			<div class="min-w-0 flex-shrink-0">
				<p class="font-oswald font-bold text-chrome-deep text-[10px] leading-none" style="letter-spacing:0.14em; text-transform:uppercase;">Total</p>
				<p class="font-special text-ink text-lg leading-none mt-1">{ formatCents(subtotal) }</p>
			</div>
			<a
				href="/checkout"
				hx-boost="false"
				class="btn-stamp flex-1 inline-flex items-center justify-center gap-2 min-h-12 bg-rust text-paper border-2 border-ink px-4 py-3 font-oswald font-bold text-xs"
				style="letter-spacing:0.16em; text-transform:uppercase;"
			>
				Checkout
				<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
				</svg>
			</a>
		</div>
	</div>
	<script>
		(function() {
			// Every /cart/update and /cart/remove swaps #main-content and re-runs this
			// script, replacing the bar and the anchor. Elements are therefore
			// resolved per call, and the window listeners are registered once.
			function el(id) { return document.getElementById(id); }
			function anchorEl() { return document.querySelector('aside a[href="/checkout"]'); }
			if (!el('cart-mobile-bar')) return;

			var state = window.__rrCartBar;
			if (!state) state = window.__rrCartBar = { ticking: false };

			function reveal(visible) {
				var bar = el('cart-mobile-bar');
				if (!bar) return;
				// invisible as well as translated, so an off-screen bar does not put a
				// second Checkout link in the tab order.
				bar.classList.toggle('translate-y-full', !visible);
				bar.classList.toggle('invisible', !visible);
				bar.setAttribute('aria-hidden', visible ? 'false' : 'true');
			}

			function sync() {
				state.ticking = false;
				var anchor = anchorEl();
				if (!anchor) { reveal(true); return; }
				var rect = anchor.getBoundingClientRect();
				reveal(rect.bottom < 0 || rect.top > (window.innerHeight || 0));
			}

			function schedule() {
				if (state.ticking) return;
				state.ticking = true;
				window.requestAnimationFrame(sync);
			}

			if (!state.bound) {
				state.bound = true;
				window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule);
			}

			sync();
		})();
	</script>
}

templ CartPage(props CartPageProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:     "Cart",
		CartCount: props.CartCount,
	}) {
		@CartContent(props)
	}
}

// CartBadge updates the inline "· N" span inside the nav cart chip.
// Rendered via hx-swap-oob when the cart count changes.
templ CartBadge(count int) {
	if count > 0 {
		<span id="cart-badge" hx-swap-oob="true">&middot; { fmt.Sprintf("%d", count) }</span>
	} else {
		<span id="cart-badge" hx-swap-oob="true" class="sr-only">empty</span>
	}
}

// itemCount returns the total quantity across all cart lines.
func itemCount(items []CartItemDisplay) int {
	n := 0
	for _, i := range items {
		n += i.Quantity
	}
	return n
}

// itemCountLabel returns "item" or "items" for pluralization.
func itemCountLabel(items []CartItemDisplay) string {
	if itemCount(items) == 1 {
		return "item"
	}
	return "items"
}
