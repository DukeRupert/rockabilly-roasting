package storefront

import (
	"encoding/json"
	"fmt"
	"net/url"
	"strings"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type ProductCard struct {
	Product      domain.Product
	ThumbnailURL string
	BasePrice    *int
	CurrencyCode string
	Coffee       *CoffeeAttrs // nil if not a coffee product or attributes not populated
}

// CatalogFilter represents a filterable attribute with its allowed values and current selection.
type CatalogFilter struct {
	Key          domain.AttributeKey
	ActiveValues []string // currently selected values from URL
}

type CatalogPageProps struct {
	Products      []ProductCard
	Taxons        []domain.Taxon
	ActiveTaxon   string
	Search        string
	Filters       []CatalogFilter     // filterable attributes for the filter bar
	ActiveFilters map[string][]string // slug -> active values, for URL building
	Page          int
	TotalPages    int
	CartCount     int
	CanonicalURL  string
	BaseURL       string // e.g. "https://rockabillyroasting.com" — for JSON-LD absolute URLs
}

// hasActiveFilters returns true if any attribute filters are selected.
func (p CatalogPageProps) hasActiveFilters() bool {
	for _, vals := range p.ActiveFilters {
		if len(vals) > 0 {
			return true
		}
	}
	return false
}

func categoryPillClasses(active bool) string {
	if active {
		return "inline-flex items-center border-2 border-ink bg-rust text-paper px-4 py-1.5 font-oswald font-bold text-[11px] transition-colors"
	}
	return "inline-flex items-center border-2 border-ink bg-paper text-ink px-4 py-1.5 font-oswald font-bold text-[11px] hover:bg-ink hover:text-paper transition-colors"
}

// FilterSlugToParam translates an internal attribute slug to its public URL
// query parameter name. The `regions` slug is exposed as `origin` because
// some HTML parsers (notably Meta's crawler) misinterpret `&reg` as the ®
// entity and scrape malformed URLs — `&origin` has no such collision.
func FilterSlugToParam(slug string) string {
	if slug == "regions" {
		return "origin"
	}
	return slug
}

// FilterParamToSlug is the inverse of FilterSlugToParam. Also accepts the
// legacy `regions` param so bookmarks and external links keep working.
func FilterParamToSlug(param string) string {
	if param == "origin" {
		return "regions"
	}
	return param
}

// catalogURL builds a /catalog URL preserving category, search, page, and attribute filters.
func catalogURL(category, search string, page int, filters map[string][]string) string {
	v := url.Values{}
	if category != "" {
		v.Set("category", category)
	}
	if search != "" {
		v.Set("q", search)
	}
	for slug, vals := range filters {
		if len(vals) > 0 {
			v.Set(FilterSlugToParam(slug), strings.Join(vals, ","))
		}
	}
	if page > 1 {
		v.Set("page", fmt.Sprintf("%d", page))
	}
	q := v.Encode()
	if q != "" {
		return "/catalog?" + q
	}
	return "/catalog"
}

// filterToggleURL returns a catalog URL with the given filter value toggled on/off.
func filterToggleURL(category, search string, filters map[string][]string, slug, value string) string {
	updated := make(map[string][]string, len(filters))
	for k, vals := range filters {
		updated[k] = append([]string(nil), vals...)
	}
	// Toggle: remove if present, add if absent.
	existing := updated[slug]
	found := false
	for i, v := range existing {
		if v == value {
			updated[slug] = append(existing[:i], existing[i+1:]...)
			found = true
			break
		}
	}
	if !found {
		updated[slug] = append(existing, value)
	}
	// Reset to page 1 when changing filters.
	return catalogURL(category, search, 1, updated)
}

// filterSingleSelectURL returns a catalog URL that sets a filter to exactly one value,
// or clears it if the value is already active (single-select toggle).
func filterSingleSelectURL(category, search string, filters map[string][]string, slug, value string) string {
	updated := make(map[string][]string, len(filters))
	for k, vals := range filters {
		updated[k] = append([]string(nil), vals...)
	}
	// If already selected, clear it. Otherwise set to exactly this value.
	if len(updated[slug]) == 1 && updated[slug][0] == value {
		updated[slug] = nil
	} else {
		updated[slug] = []string{value}
	}
	return catalogURL(category, search, 1, updated)
}

// filterRemoveURL returns a catalog URL with a specific filter value removed.
func filterRemoveURL(category, search string, filters map[string][]string, slug, value string) string {
	updated := make(map[string][]string, len(filters))
	for k, vals := range filters {
		updated[k] = append([]string(nil), vals...)
	}
	existing := updated[slug]
	for i, v := range existing {
		if v == value {
			updated[slug] = append(existing[:i], existing[i+1:]...)
			break
		}
	}
	return catalogURL(category, search, 1, updated)
}

// isFilterActive returns true if the given value is active for the given filter slug.
func isFilterActive(filters map[string][]string, slug, value string) bool {
	for _, v := range filters[slug] {
		if v == value {
			return true
		}
	}
	return false
}

templ CatalogContent(props CatalogPageProps) {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)]">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-screen-2xl px-6 sm:px-10 lg:px-14 py-10 sm:py-14">
			<!-- Page heading -->
			<div class="mb-8 sm:mb-10">
				<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
					Every bag roasted to order
				</p>
				<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mt-3">
					<h1 class="font-slab text-ink uppercase leading-[0.92]" style="font-size: clamp(2.25rem, 5vw, 3.75rem); letter-spacing:-0.005em;">
						Pick your
						<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">roast.</span>
					</h1>
					<!-- Search -->
					<form
						id="catalog-search-form"
						action="/catalog"
						method="get"
						hx-get="/catalog"
						hx-trigger="input changed delay:1s from:#catalog-search, search from:#catalog-search, submit"
						hx-target="#main-content"
						hx-swap="innerHTML"
						hx-push-url="true"
						class="flex-shrink-0"
					>
						if props.ActiveTaxon != "" {
							<input type="hidden" name="category" value={ props.ActiveTaxon } data-search-filter/>
						}
						for slug, vals := range props.ActiveFilters {
							if len(vals) > 0 {
								<input type="hidden" name={ slug } value={ strings.Join(vals, ",") } data-search-filter/>
							}
						}
						<div class="relative">
							<label for="catalog-search" class="sr-only">Search roasts</label>
							<!-- Search icon (hidden during request) -->
							<svg class="search-icon absolute left-3 top-1/2 -translate-y-1/2 size-4 text-ink" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
								<circle cx="11" cy="11" r="8"></circle>
								<path d="m21 21-4.35-4.35"></path>
							</svg>
							<!-- Spinner (shown during request) -->
							<svg class="search-spinner absolute left-3 top-1/2 -translate-y-1/2 size-4 text-rust" aria-hidden="true" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
							</svg>
							<input
								type="search"
								id="catalog-search"
								name="q"
								value={ props.Search }
								placeholder="Search roasts…"
								class="paper-input w-full sm:w-72 border-2 border-ink bg-cream-hi font-oswald text-sm text-ink pl-10 pr-4 py-2.5 placeholder:text-chrome-deep focus:outline-none"
								style="letter-spacing:0.04em;"
							/>
						</div>
					</form>
				</div>
			</div>
			<script>
				document.getElementById('catalog-search-form').addEventListener('htmx:configRequest', function(evt) {
					var q = (evt.detail.parameters['q'] || '').trim();
					if (q === '') {
						// Clear all filters and category when search is emptied.
						var keys = Object.keys(evt.detail.parameters);
						for (var i = 0; i < keys.length; i++) {
							if (keys[i] !== 'q') {
								delete evt.detail.parameters[keys[i]];
							}
						}
					}
				});
			</script>
			<!-- Category filter pills — ink double-rule strip -->
			if len(props.Taxons) > 0 {
				<div class="mb-8 pb-6 border-b-2 border-ink flex flex-wrap gap-2">
					<a
						href={ templ.SafeURL(catalogURL("", props.Search, 1, props.ActiveFilters)) }
						class={ categoryPillClasses(props.ActiveTaxon == "") }
						style="letter-spacing:0.18em; text-transform:uppercase;"
					>
						All
					</a>
					for _, taxon := range props.Taxons {
						<a
							href={ templ.SafeURL(catalogURL(taxon.Slug, props.Search, 1, props.ActiveFilters)) }
							class={ categoryPillClasses(props.ActiveTaxon == taxon.Slug) }
							style="letter-spacing:0.18em; text-transform:uppercase;"
						>
							{ taxon.Name }
						</a>
					}
				</div>
			}
			<div id="catalog-results">
				@CatalogResults(props)
			</div>
		</div>
	</section>
}

// CatalogResults renders the sidebar + product grid + pagination.
// This is the htmx swap target for filter interactions.
templ CatalogResults(props CatalogPageProps) {
	<div class="flex gap-10">
		<!-- Desktop sidebar -->
		if len(props.Filters) > 0 {
			<aside class="hidden lg:block w-56 flex-shrink-0">
				@catalogSidebar(props)
			</aside>
		}
		<!-- Main grid area -->
		<div class="flex-1 min-w-0">
			<!-- Mobile filter button -->
			if len(props.Filters) > 0 {
				@mobileFilterButton(props)
			}
			<!-- Active filter tags -->
			if props.hasActiveFilters() {
				@activeFilterTags(props)
			}
			<!-- Product grid -->
			if len(props.Products) == 0 {
				<div class="border-2 border-ink bg-cream-hi py-16 px-6 text-center shadow-stamp">
					<svg class="mx-auto size-10 text-ink mb-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"></path>
					</svg>
					<p class="font-oswald text-ink text-base" style="letter-spacing:0.04em;">Nothing on the shelf matches those filters.</p>
					if props.ActiveTaxon != "" || props.Search != "" || props.hasActiveFilters() {
						<a href="/catalog" class="btn-stamp inline-flex items-center gap-2 mt-6 bg-rust text-paper border-2 border-ink px-6 py-3 font-oswald font-bold text-sm" style="letter-spacing:0.14em; text-transform:uppercase;">
							Browse all coffee
							<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
							</svg>
						</a>
					}
				</div>
			} else {
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-6 sm:gap-8">
					for _, card := range props.Products {
						@productCardPaper(card)
					}
				</div>
			}
			<!-- Pagination -->
			if props.TotalPages > 1 {
				<nav class="mt-14 flex items-center justify-center gap-2" aria-label="Pagination">
					if props.Page > 1 {
						<a
							href={ templ.SafeURL(catalogURL(props.ActiveTaxon, props.Search, props.Page-1, props.ActiveFilters)) }
							hx-get={ catalogURL(props.ActiveTaxon, props.Search, props.Page-1, props.ActiveFilters) }
							hx-target="#catalog-results"
							hx-swap="innerHTML"
							hx-push-url="true"
							aria-label="Previous page"
							class="btn-stamp inline-flex items-center justify-center w-10 h-10 bg-cream-hi text-ink border-2 border-ink font-oswald font-bold text-sm"
						>
							&lsaquo;
						</a>
					}
					for _, p := range pageRange(props.Page, props.TotalPages) {
						if p == props.Page {
							<span
								class="inline-flex items-center justify-center w-10 h-10 bg-rust text-paper border-2 border-ink font-oswald font-bold text-sm"
								style="box-shadow: var(--shadow-stamp-sm);"
								aria-current="page"
							>
								{ fmt.Sprintf("%d", p) }
							</span>
						} else {
							<a
								href={ templ.SafeURL(catalogURL(props.ActiveTaxon, props.Search, p, props.ActiveFilters)) }
								hx-get={ catalogURL(props.ActiveTaxon, props.Search, p, props.ActiveFilters) }
								hx-target="#catalog-results"
								hx-swap="innerHTML"
								hx-push-url="true"
								aria-label={ fmt.Sprintf("Page %d", p) }
								class="btn-stamp inline-flex items-center justify-center w-10 h-10 bg-cream-hi text-ink border-2 border-ink font-oswald font-bold text-sm hover:bg-paper-warm"
							>
								{ fmt.Sprintf("%d", p) }
							</a>
						}
					}
					if props.Page < props.TotalPages {
						<a
							href={ templ.SafeURL(catalogURL(props.ActiveTaxon, props.Search, props.Page+1, props.ActiveFilters)) }
							hx-get={ catalogURL(props.ActiveTaxon, props.Search, props.Page+1, props.ActiveFilters) }
							hx-target="#catalog-results"
							hx-swap="innerHTML"
							hx-push-url="true"
							aria-label="Next page"
							class="btn-stamp inline-flex items-center justify-center w-10 h-10 bg-cream-hi text-ink border-2 border-ink font-oswald font-bold text-sm"
						>
							&rsaquo;
						</a>
					}
				</nav>
			}
		</div>
	</div>
	<!-- Mobile filter drawer -->
	if len(props.Filters) > 0 {
		@mobileFilterDrawer(props)
	}
}

// productCardPaper is the paper-and-ink product card used on the catalog grid
// and the home "Popular Roasts" section.
templ productCardPaper(card ProductCard) {
	<a href={ templ.SafeURL("/catalog/" + card.Product.Slug) } class="btn-stamp group block bg-cream-hi border-2 border-ink">
		<!-- Image panel -->
		<div class="relative aspect-square bg-paper-warm border-b-2 border-ink overflow-hidden">
			if card.ThumbnailURL != "" {
				<img
					src={ card.ThumbnailURL }
					alt={ cardAltText(card.Product.Title, card.Coffee) }
					width="800"
					height="800"
					class="h-full w-full object-cover object-center"
					loading="lazy"
				/>
			} else {
				<div class="flex h-full w-full items-center justify-center">
					<div class="w-16 h-16 border-2 border-ink bg-paper flex items-center justify-center">
						<span class="font-slab text-ink text-2xl leading-none">
							{ string([]rune(card.Product.Title)[0:1]) }
						</span>
					</div>
				</div>
			}
			<!-- Seasonal — amber corner sticker, top-left -->
			if card.Coffee != nil && card.Coffee.IsSeasonal {
				<div class="absolute top-2 left-2">
					<span class="inline-block font-oswald font-bold text-[10px] text-ink bg-candle border-2 border-ink px-2 py-0.5" style="letter-spacing:0.16em; text-transform:uppercase;">
						Seasonal
					</span>
				</div>
			}
			<!-- Decaf — ink chip, top-right -->
			if card.Coffee != nil && card.Coffee.IsDecaf {
				<div class="absolute top-2 right-2">
					<span class="inline-block font-oswald font-bold text-[10px] text-paper bg-ink border-2 border-paper px-2 py-0.5" style="letter-spacing:0.16em; text-transform:uppercase;">
						Decaf
					</span>
				</div>
			}
		</div>
		<!-- Content -->
		<div class="p-4 sm:p-5 flex flex-col gap-2">
			<!-- Origin tag -->
			if card.Coffee != nil && len(card.Coffee.Regions) > 0 {
				<p class="font-oswald text-chrome-deep text-[10px] sm:text-[11px] font-semibold" style="letter-spacing:0.2em; text-transform:uppercase;">
					{ card.Coffee.Regions[0] }
				</p>
			} else if card.Coffee != nil && validRoastLevel(card.Coffee.RoastLevel) {
				<p class="font-oswald text-chrome-deep text-[10px] sm:text-[11px] font-semibold" style="letter-spacing:0.2em; text-transform:uppercase;">
					{ roastLevelLabel(card.Coffee.RoastLevel) } roast
				</p>
			}
			<!-- Title -->
			<h3 class="font-slab text-ink uppercase leading-[0.95] text-xl sm:text-2xl group-hover:text-rust transition-colors" style="letter-spacing:-0.005em;">
				{ card.Product.Title }
			</h3>
			<!-- Tasting notes -->
			if card.Coffee != nil && len(card.Coffee.TastingNotes) > 0 {
				<ul class="flex flex-wrap gap-1.5 mt-1">
					for _, note := range cardTastingNotesList(card.Coffee.TastingNotes, 3) {
						<li class="font-oswald font-bold text-[9px] sm:text-[10px] text-ink bg-paper border-2 border-ink px-2 py-0.5 rounded-full" style="letter-spacing:0.12em; text-transform:uppercase;">
							{ note }
						</li>
					}
				</ul>
			}
			<!-- Footer row: price + shop indicator, separated by ink double-rule -->
			<div class="mt-3 pt-3 border-t-2 border-ink flex items-center justify-between">
				if card.BasePrice != nil {
					<span class="font-special text-ink text-sm sm:text-base">
						{ formatCents(*card.BasePrice) } · 12oz
					</span>
				} else {
					<span></span>
				}
				<span class="inline-flex items-center gap-1 font-oswald font-bold text-[10px] sm:text-[11px] text-rust group-hover:text-rust-deep transition-colors" style="letter-spacing:0.16em; text-transform:uppercase;">
					Shop
					<svg class="size-3 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
					</svg>
				</span>
			</div>
		</div>
	</a>
}

// roastDots renders 5 heat-indicator dots for roast level.
// size: "small" (cards) or "large" (detail page).
templ roastDots(level string, size string) {
	<div class={ "flex items-center gap-0.5 flex-shrink-0", templ.KV("gap-1", size == "large") } role="img" aria-label={ roastLevelLabel(level) + " roast" }>
		<span class={ roastEndLabel(size) } aria-hidden="true">LIGHT</span>
		for i := 1; i <= 5; i++ {
			if i <= roastLevelIndex(level) {
				<span class={ roastDotFilled(i, size) }></span>
			} else {
				<span class={ roastDotEmpty(size) }></span>
			}
		}
		<span class={ roastEndLabel(size) } aria-hidden="true">DARK</span>
	</div>
}

// roastDots palette: candle → rust gradient, chrome-deep empty. Reads on
// both paper and ink surfaces — consumed by product detail (paper) and
// subscriptions cards (still dark).
func roastDotFilled(position int, size string) string {
	var color string
	switch {
	case position <= 1:
		color = "bg-candle-soft"
	case position == 2:
		color = "bg-candle"
	case position == 3:
		color = "bg-candle-deep"
	case position == 4:
		color = "bg-rust"
	default:
		color = "bg-rust-deep"
	}
	if size == "large" {
		return "size-2.5 rounded-full " + color
	}
	return "size-1.5 rounded-full " + color
}

func roastDotEmpty(size string) string {
	if size == "large" {
		return "size-2.5 rounded-full bg-chrome-deep/40"
	}
	return "size-1.5 rounded-full bg-chrome-deep/40"
}

// catalogSidebar renders the desktop filter sidebar with always-visible sections.
templ catalogSidebar(props CatalogPageProps) {
	<nav class="border-2 border-ink bg-cream-hi p-5 shadow-stamp" aria-label="Product filters">
		<div class="flex items-center justify-between pb-3 border-b-2 border-ink">
			<span class="font-slab text-ink text-base uppercase" style="letter-spacing:0.02em;">Filters</span>
			if props.hasActiveFilters() {
				<a
					href={ templ.SafeURL(catalogURL(props.ActiveTaxon, props.Search, 1, nil)) }
					hx-get={ catalogURL(props.ActiveTaxon, props.Search, 1, nil) }
					hx-target="#catalog-results"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="font-oswald font-bold text-[10px] text-rust hover:text-rust-deep transition-colors"
					style="letter-spacing:0.18em; text-transform:uppercase;"
				>
					Clear all
				</a>
			}
		</div>
		<div class="space-y-5 mt-5">
			for _, f := range props.Filters {
				<div class="pb-5 border-b border-ink last:border-b-0 last:pb-0">
					if f.Key.Slug == "roast-level" {
						@roastLevelFilter(props, f)
					} else if f.Key.ValueType == "boolean" {
						@booleanFilter(props, f)
					} else {
						@checkboxFilter(props, f)
					}
				</div>
			}
		</div>
	</nav>
}

// roastLevelFilter renders a clickable 5-dot roast scale (single-select).
// Clicking a dot selects that roast level; clicking the active dot clears the filter.
templ roastLevelFilter(props CatalogPageProps, f CatalogFilter) {
	<div>
		<span class="font-oswald font-bold text-ink text-[11px]" style="letter-spacing:0.2em; text-transform:uppercase;">{ f.Key.Name }</span>
		<div class="mt-3 flex items-center gap-1.5" role="radiogroup" aria-label="Roast level filter">
			<span class="font-oswald font-bold text-[9px] text-chrome-deep leading-none mr-0.5" style="letter-spacing:0.12em; text-transform:uppercase;">Light</span>
			for i, val := range roastFilterLevels() {
				<a
					href={ templ.SafeURL(filterSingleSelectURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, val)) }
					hx-get={ filterSingleSelectURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, val) }
					hx-target="#catalog-results"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="group/dot"
					role="radio"
					aria-checked={ boolAttr(isFilterActive(props.ActiveFilters, f.Key.Slug, val)) }
					aria-label={ formatFilterValue(val) + " roast" }
				>
					<span class={ roastFilterDot(i+1, isFilterActive(props.ActiveFilters, f.Key.Slug, val)) }></span>
				</a>
			}
			<span class="font-oswald font-bold text-[9px] text-chrome-deep leading-none ml-0.5" style="letter-spacing:0.12em; text-transform:uppercase;">Dark</span>
		</div>
		if len(f.ActiveValues) > 0 {
			<p class="mt-2 font-special text-rust text-xs">{ formatFilterValue(f.ActiveValues[0]) }</p>
		}
	</div>
}

// checkboxFilter renders a standard checkbox-style filter section.
templ checkboxFilter(props CatalogPageProps, f CatalogFilter) {
	<div>
		<span class="font-oswald font-bold text-ink text-[11px]" style="letter-spacing:0.2em; text-transform:uppercase;">{ f.Key.Name }</span>
		<div class="mt-2 space-y-1">
			for _, val := range f.Key.AllowedValues {
				<a
					href={ templ.SafeURL(filterToggleURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, val)) }
					hx-get={ filterToggleURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, val) }
					hx-target="#catalog-results"
					hx-swap="innerHTML"
					hx-push-url="true"
					class={ filterOptionClasses(isFilterActive(props.ActiveFilters, f.Key.Slug, val)) }
				>
					<span class={ filterCheckbox(isFilterActive(props.ActiveFilters, f.Key.Slug, val)) }>
						if isFilterActive(props.ActiveFilters, f.Key.Slug, val) {
							<svg class="size-2.5 text-paper" fill="none" viewBox="0 0 24 24" stroke-width="4" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
							</svg>
						}
					</span>
					{ formatFilterValue(val) }
				</a>
			}
		</div>
	</div>
}

// booleanFilter renders a toggle-style filter for boolean attributes.
templ booleanFilter(props CatalogPageProps, f CatalogFilter) {
	<a
		href={ templ.SafeURL(filterToggleURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, "true")) }
		hx-get={ filterToggleURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, "true") }
		hx-target="#catalog-results"
		hx-swap="innerHTML"
		hx-push-url="true"
		class={ booleanFilterClasses(isFilterActive(props.ActiveFilters, f.Key.Slug, "true")) }
	>
		<span class={ filterCheckbox(isFilterActive(props.ActiveFilters, f.Key.Slug, "true")) }>
			if isFilterActive(props.ActiveFilters, f.Key.Slug, "true") {
				<svg class="size-2.5 text-paper" fill="none" viewBox="0 0 24 24" stroke-width="4" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
				</svg>
			}
		</span>
		<span class="font-oswald text-ink" style="letter-spacing:0.14em; text-transform:uppercase;">{ f.Key.Name }</span>
	</a>
}

// mobileFilterButton renders the mobile filter trigger button.
templ mobileFilterButton(props CatalogPageProps) {
	<div class="lg:hidden mb-6">
		<button
			type="button"
			id="mobile-filter-open"
			class={ filterButtonClasses(props.hasActiveFilters()) }
			style="letter-spacing:0.18em; text-transform:uppercase;"
		>
			<svg class="size-4 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="2.25" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"></path>
			</svg>
			Filters
			if props.hasActiveFilters() {
				<span class="ml-2 size-5 inline-flex items-center justify-center bg-paper text-rust border-2 border-paper text-[10px] font-bold" style="letter-spacing:0;">
					{ fmt.Sprintf("%d", countActiveFilters(props.ActiveFilters)) }
				</span>
			}
		</button>
	</div>
}

// mobileFilterDrawer renders the bottom-sheet filter drawer for mobile.
templ mobileFilterDrawer(props CatalogPageProps) {
	<div id="mobile-filter-drawer" class="fixed inset-0 z-50 hidden" aria-modal="true" role="dialog">
		<div id="mobile-filter-backdrop" class="absolute inset-0 bg-ink/70"></div>
		<div class="absolute bottom-0 left-0 right-0 max-h-[80vh] overflow-y-auto border-t-2 border-ink bg-paper">
			<div class="sticky top-0 flex items-center justify-between border-b-2 border-ink bg-paper px-5 py-4 z-10">
				<span class="font-slab text-ink text-lg uppercase" style="letter-spacing:0.02em;">Filters</span>
				<button type="button" id="mobile-filter-close" class="font-oswald font-bold text-[11px] text-ink hover:text-rust transition-colors" style="letter-spacing:0.18em; text-transform:uppercase;">
					Close
				</button>
			</div>
			<div class="px-5 py-4 space-y-4">
				for _, f := range props.Filters {
					if f.Key.Slug == "roast-level" {
						<div class="pb-4 border-b border-ink">
							@roastLevelFilter(props, f)
						</div>
					} else if f.Key.ValueType == "boolean" {
						<div class="pb-4 border-b border-ink">
							<a
								href={ templ.SafeURL(filterToggleURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, "true")) }
								hx-get={ filterToggleURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, "true") }
								hx-target="#catalog-results"
								hx-swap="innerHTML"
								hx-push-url="true"
								class={ booleanFilterClasses(isFilterActive(props.ActiveFilters, f.Key.Slug, "true")) }
							>
								<span class={ filterCheckbox(isFilterActive(props.ActiveFilters, f.Key.Slug, "true")) }>
									if isFilterActive(props.ActiveFilters, f.Key.Slug, "true") {
										<svg class="size-2.5 text-paper" fill="none" viewBox="0 0 24 24" stroke-width="4" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
										</svg>
									}
								</span>
								<span class="font-oswald text-ink" style="letter-spacing:0.14em; text-transform:uppercase;">{ f.Key.Name }</span>
							</a>
						</div>
					} else if len(f.Key.AllowedValues) > 0 {
						<details class="group pb-4 border-b border-ink" open?={ len(f.ActiveValues) > 0 }>
							<summary class="flex items-center justify-between cursor-pointer py-1">
								<span class="font-oswald font-bold text-ink text-[11px]" style="letter-spacing:0.2em; text-transform:uppercase;">
									{ f.Key.Name }
									if len(f.ActiveValues) > 0 {
										<span class="ml-1 text-rust">({ fmt.Sprintf("%d", len(f.ActiveValues)) })</span>
									}
								</span>
								<svg class="size-3 text-ink transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
								</svg>
							</summary>
							<div class="mt-3 space-y-1">
								for _, val := range f.Key.AllowedValues {
									<a
										href={ templ.SafeURL(filterToggleURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, val)) }
										hx-get={ filterToggleURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, val) }
										hx-target="#catalog-results"
										hx-swap="innerHTML"
										hx-push-url="true"
										class={ filterOptionClasses(isFilterActive(props.ActiveFilters, f.Key.Slug, val)) }
									>
										<span class={ filterCheckbox(isFilterActive(props.ActiveFilters, f.Key.Slug, val)) }>
											if isFilterActive(props.ActiveFilters, f.Key.Slug, val) {
												<svg class="size-2.5 text-paper" fill="none" viewBox="0 0 24 24" stroke-width="4" stroke="currentColor">
													<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
												</svg>
											}
										</span>
										{ formatFilterValue(val) }
									</a>
								}
							</div>
						</details>
					}
				}
			</div>
			<div class="sticky bottom-0 border-t-2 border-ink bg-paper px-5 py-4 flex gap-3">
				if props.hasActiveFilters() {
					<a
						href={ templ.SafeURL(catalogURL(props.ActiveTaxon, props.Search, 1, nil)) }
						hx-get={ catalogURL(props.ActiveTaxon, props.Search, 1, nil) }
						hx-target="#catalog-results"
						hx-swap="innerHTML"
						hx-push-url="true"
						class="flex-1 text-center font-oswald font-bold text-xs border-2 border-ink bg-paper px-4 py-3 text-ink hover:bg-ink hover:text-paper transition-colors"
						style="letter-spacing:0.16em; text-transform:uppercase;"
					>
						Clear all
					</a>
				}
				<button type="button" id="mobile-filter-close-bottom" class="btn-stamp flex-1 bg-rust text-paper border-2 border-ink px-4 py-3 font-oswald font-bold text-xs" style="letter-spacing:0.16em; text-transform:uppercase;">
					See results
				</button>
			</div>
		</div>
	</div>
	@mobileDrawerScript()
}

// activeFilterTags renders removable tag pills for each active filter value.
templ activeFilterTags(props CatalogPageProps) {
	<div class="mb-6 flex flex-wrap items-center gap-2">
		for _, f := range props.Filters {
			for _, val := range f.ActiveValues {
				<a
					href={ templ.SafeURL(filterRemoveURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, val)) }
					hx-get={ filterRemoveURL(props.ActiveTaxon, props.Search, props.ActiveFilters, f.Key.Slug, val) }
					hx-target="#catalog-results"
					hx-swap="innerHTML"
					hx-push-url="true"
					class="inline-flex items-center gap-1.5 font-oswald font-bold text-[10px] text-rust border-2 border-rust bg-cream-hi px-2.5 py-1 hover:bg-rust hover:text-paper transition-colors"
					style="letter-spacing:0.14em; text-transform:uppercase;"
				>
					{ f.Key.Name }: { formatFilterValue(val) }
					<svg class="size-3" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
					</svg>
				</a>
			}
		}
	</div>
}

// mobileDrawerScript handles mobile filter drawer open/close.
// Uses event delegation on the document so it survives htmx swaps.
templ mobileDrawerScript() {
	<script>
		(function() {
			function initDrawer() {
				var drawer = document.getElementById('mobile-filter-drawer');
				var openBtn = document.getElementById('mobile-filter-open');
				var closeBtn = document.getElementById('mobile-filter-close');
				var closeBottomBtn = document.getElementById('mobile-filter-close-bottom');
				var backdrop = document.getElementById('mobile-filter-backdrop');
				var previousFocus = null;

				function openDrawer() {
					if (!drawer) return;
					previousFocus = document.activeElement;
					drawer.classList.remove('hidden');
					// Focus first interactive element inside the drawer
					var first = drawer.querySelector('button, a, input, [tabindex]');
					if (first) first.focus();
				}
				function closeDrawer() {
					if (!drawer) return;
					drawer.classList.add('hidden');
					if (previousFocus) previousFocus.focus();
				}

				if (openBtn) openBtn.addEventListener('click', openDrawer);
				if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
				if (closeBottomBtn) closeBottomBtn.addEventListener('click', closeDrawer);
				if (backdrop) backdrop.addEventListener('click', closeDrawer);

				// Escape key closes drawer
				document.addEventListener('keydown', function(e) {
					if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) {
						closeDrawer();
					}
				});

				// Trap focus inside drawer when open
				if (drawer) {
					drawer.addEventListener('keydown', function(e) {
						if (e.key !== 'Tab') return;
						var focusable = drawer.querySelectorAll('a, button, input, [tabindex]:not([tabindex="-1"])');
						if (focusable.length === 0) return;
						var first = focusable[0];
						var last = focusable[focusable.length - 1];
						if (e.shiftKey && document.activeElement === first) {
							e.preventDefault();
							last.focus();
						} else if (!e.shiftKey && document.activeElement === last) {
							e.preventDefault();
							first.focus();
						}
					});
				}
			}
			initDrawer();
			// Re-initialize after htmx swaps the catalog-results container.
			document.addEventListener('htmx:afterSwap', function(evt) {
				if (evt.detail.target && evt.detail.target.id === 'catalog-results') {
					initDrawer();
				}
			});
		})();
	</script>
}

// roastFilterLevels returns the 5 roast level slugs in order from light to dark.
func roastFilterLevels() []string {
	return []string{"light", "medium-light", "medium", "medium-dark", "dark"}
}

// roastFilterDot returns CSS classes for a clickable roast dot in the filter.
// position is 1-5 (light to dark). active means this dot is the selected filter.
func roastFilterDot(position int, active bool) string {
	base := "roast-dot block size-5 rounded-full cursor-pointer border-2 border-ink"
	if active {
		base += " roast-dot-active ring-2 ring-rust ring-offset-2"
		base += " [--tw-ring-offset-color:var(--color-cream-hi)]"
	} else {
		base += " group-hover/dot:ring-2 group-hover/dot:ring-ink group-hover/dot:ring-offset-1"
	}
	// Color gradient from candle (light) to rust (dark).
	switch {
	case position <= 1:
		return base + " bg-candle-soft"
	case position == 2:
		return base + " bg-candle"
	case position == 3:
		return base + " bg-candle-deep"
	case position == 4:
		return base + " bg-rust"
	default:
		return base + " bg-rust-deep"
	}
}

func boolAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func booleanFilterClasses(active bool) string {
	if active {
		return "flex items-center gap-2 px-2 py-1.5 text-sm bg-rust/10 border border-rust transition-colors"
	}
	return "flex items-center gap-2 px-2 py-1.5 text-sm border border-transparent hover:bg-paper-warm transition-colors"
}

func filterButtonClasses(active bool) string {
	if active {
		return "btn-stamp inline-flex items-center bg-rust text-paper border-2 border-ink px-5 py-2.5 font-oswald font-bold text-[11px]"
	}
	return "btn-stamp inline-flex items-center bg-cream-hi text-ink border-2 border-ink px-5 py-2.5 font-oswald font-bold text-[11px]"
}

func filterOptionClasses(active bool) string {
	if active {
		return "flex items-center gap-2 px-2 py-1.5 font-oswald text-sm text-ink bg-rust/10 transition-colors"
	}
	return "flex items-center gap-2 px-2 py-1.5 font-oswald text-sm text-ink-soft hover:text-ink hover:bg-paper-warm transition-colors"
}

func filterCheckbox(checked bool) string {
	if checked {
		return "size-4 border-2 border-ink bg-rust inline-flex items-center justify-center flex-shrink-0"
	}
	return "size-4 border-2 border-ink bg-cream-hi inline-flex items-center justify-center flex-shrink-0"
}

func countActiveFilters(filters map[string][]string) int {
	n := 0
	for _, vals := range filters {
		n += len(vals)
	}
	return n
}

// catalogItemListJSONLD renders an ItemList of the products on the current
// catalog page so search engines understand the grid is a listing.
func catalogItemListJSONLD(props CatalogPageProps) string {
	if len(props.Products) == 0 || props.BaseURL == "" {
		return ""
	}
	items := make([]map[string]any, 0, len(props.Products))
	for i, card := range props.Products {
		items = append(items, map[string]any{
			"@type":    "ListItem",
			"position": i + 1,
			"url":      props.BaseURL + "/catalog/" + card.Product.Slug,
			"name":     card.Product.Title,
		})
	}
	ld := map[string]any{
		"@context":        "https://schema.org",
		"@type":           "ItemList",
		"itemListElement": items,
	}
	b, _ := json.Marshal(ld)
	return `<script type="application/ld+json">` + string(b) + `</script>`
}

templ CatalogPage(props CatalogPageProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:        "Shop",
		Description:  "Browse our collection of products",
		CartCount:    props.CartCount,
		CanonicalURL: props.CanonicalURL,
	}) {
		@CatalogContent(props)
		@templ.Raw(catalogItemListJSONLD(props))
	}
}
