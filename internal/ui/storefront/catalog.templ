package storefront

import (
	"fmt"
	"net/url"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type ProductCard struct {
	Product      domain.Product
	ThumbnailURL string
	BasePrice    *int
	CurrencyCode string
}

type CatalogPageProps struct {
	Products    []ProductCard
	Taxons      []domain.Taxon
	ActiveTaxon string
	Search      string
	Page        int
	TotalPages  int
	CartCount   int
}

func categoryPillClasses(active bool) string {
	if active {
		return "label-font inline-flex items-center rounded-sm border-2 border-rr-red bg-rr-red/5 px-3 py-1.5 text-rr-red"
	}
	return "label-font inline-flex items-center rounded-sm border border-rr-border px-3 py-1.5 text-rr-muted hover:border-rr-amber hover:text-rr-heading transition-colors"
}

// catalogURL builds a /catalog URL preserving the given query params.
func catalogURL(category, search string, page int) string {
	v := url.Values{}
	if category != "" {
		v.Set("category", category)
	}
	if search != "" {
		v.Set("q", search)
	}
	if page > 1 {
		v.Set("page", fmt.Sprintf("%d", page))
	}
	q := v.Encode()
	if q != "" {
		return "/catalog?" + q
	}
	return "/catalog"
}

templ CatalogContent(props CatalogPageProps) {
	<div>
		<!-- Page heading -->
		<div class="flex items-baseline justify-between border-b border-rr-border pb-6 mb-6">
			<div>
				<h1 class="font-display text-4xl tracking-widest text-rr-heading">SHOP</h1>
				<p class="mt-1 font-body text-sm text-rr-muted">Browse our collection</p>
			</div>
			<!-- Search -->
			<form action="/catalog" method="get">
				if props.ActiveTaxon != "" {
					<input type="hidden" name="category" value={ props.ActiveTaxon }/>
				}
				<div class="relative">
					<svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-rr-amber" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.35-4.35"></path>
					</svg>
					<input
						type="search"
						name="q"
						value={ props.Search }
						placeholder="Search roasts..."
						class="rr-input w-56 rounded-sm border border-rr-border bg-rr-bg font-body text-sm text-rr-heading pl-10 pr-4 py-2 placeholder:text-rr-border"
					/>
				</div>
			</form>
		</div>
		<!-- Category filter pills -->
		if len(props.Taxons) > 0 {
			<div class="mb-6 flex flex-wrap gap-2">
				<a
					href={ templ.SafeURL(catalogURL("", props.Search, 1)) }
					class={ categoryPillClasses(props.ActiveTaxon == "") }
				>
					ALL
				</a>
				for _, taxon := range props.Taxons {
					<a
						href={ templ.SafeURL(catalogURL(taxon.Slug, props.Search, 1)) }
						class={ categoryPillClasses(props.ActiveTaxon == taxon.Slug) }
					>
						{ taxon.Name }
					</a>
				}
			</div>
		}
		<!-- Product grid — compact BRCC-style layout -->
		if len(props.Products) == 0 {
			<div class="text-center py-16">
				<p class="font-body text-rr-muted">No products found.</p>
			</div>
		} else {
			<div class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
				for _, card := range props.Products {
					@productCard(card)
				}
			</div>
		}
		<!-- Pagination -->
		if props.TotalPages > 1 {
			<nav class="mt-10 flex items-center justify-center gap-1.5" aria-label="Pagination">
				if props.Page > 1 {
					<a
						href={ templ.SafeURL(catalogURL(props.ActiveTaxon, props.Search, props.Page-1)) }
						class="btn label-font text-rr-muted border border-rr-border px-3 py-2 rounded-sm text-xs bg-rr-bg"
					>
						&lsaquo;
					</a>
				}
				for _, p := range pageRange(props.Page, props.TotalPages) {
					if p == props.Page {
						<span class="label-font text-white w-8 h-8 rounded-sm text-xs flex items-center justify-center bg-rr-red">
							{ fmt.Sprintf("%d", p) }
						</span>
					} else {
						<a
							href={ templ.SafeURL(catalogURL(props.ActiveTaxon, props.Search, p)) }
							class="btn label-font text-rr-muted border border-rr-border w-8 h-8 rounded-sm text-xs flex items-center justify-center bg-rr-bg hover:border-rr-amber transition-colors"
						>
							{ fmt.Sprintf("%d", p) }
						</a>
					}
				}
				if props.Page < props.TotalPages {
					<a
						href={ templ.SafeURL(catalogURL(props.ActiveTaxon, props.Search, props.Page+1)) }
						class="btn label-font text-rr-muted border border-rr-border px-3 py-2 rounded-sm text-xs bg-rr-bg"
					>
						&rsaquo;
					</a>
				}
			</nav>
		}
	</div>
}

templ productCard(card ProductCard) {
	<a href={ templ.SafeURL("/catalog/" + card.Product.Slug) } class="product-card group rounded-sm overflow-hidden border border-rr-border bg-rr-surface">
		<!-- Compact image — 3:4 aspect ratio instead of square -->
		<div class="aspect-3/4 w-full overflow-hidden bg-rr-bg relative">
			if card.ThumbnailURL != "" {
				<img
					src={ card.ThumbnailURL }
					alt={ card.Product.Title }
					class="h-full w-full object-cover object-center group-hover:opacity-80 transition-opacity"
					loading="lazy"
				/>
			} else {
				<div class="texture-dots absolute inset-0"></div>
				<div class="flex h-full w-full items-center justify-center relative">
					<div class="w-16 h-16 rounded-full border-2 border-rr-border bg-rr-surface flex items-center justify-center">
						<span class="font-display text-rr-muted text-lg tracking-widest">
							{ string([]rune(card.Product.Title)[0:1]) }
						</span>
					</div>
				</div>
			}
		</div>
		<!-- Product info — tight padding -->
		<div class="p-3">
			<h3 class="font-heading text-rr-heading text-base leading-tight group-hover:text-rr-red transition-colors">{ card.Product.Title }</h3>
			if card.BasePrice != nil {
				<p class="mt-1 font-heading text-rr-heading text-lg">{ formatCents(*card.BasePrice) }</p>
			}
		</div>
	</a>
}

templ CatalogPage(props CatalogPageProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Shop",
		Description: "Browse our collection of products",
		CartCount:   props.CartCount,
	}) {
		@CatalogContent(props)
	}
}
