package storefront

import (
	"fmt"

	"github.com/google/uuid"

	"github.com/dukerupert/hiri/internal/domain"
)

// DriverRouteProps drives the delivery driver's stop list — a phone page,
// used one-handed, standing next to a van.
//
// Deliberately not the admin shell: there is no login, no sidebar, and nothing
// to navigate to. Everything on screen is either the next stop or a way to
// resolve it.
type DriverRouteProps struct {
	// Token is echoed into the action URLs so each button posts back to the
	// same authenticated route.
	Token     string
	Stops     []DriverStop
	Progress  domain.RouteProgress
	Completed bool
	OriginLat float64
	OriginLng float64
	Roundtrip bool
	// EndAddress is where the run finishes when that is not the roastery.
	// Shown, never navigated to: the driver knows the way to their own house,
	// but seeing it here confirms the stop order was planned around it.
	EndAddress string
	// NavChunks are "navigate the next N stops" links. A Google Maps URL holds
	// ten stops, so a longer run becomes several sequential links rather than
	// one that the maps app silently truncates.
	NavChunks []domain.NavChunk
}

// DriverStop is one delivery as the driver sees it.
type DriverStop struct {
	ID           uuid.UUID
	Position     int
	CustomerName string
	Address      string
	Notes        string
	Status       domain.RouteStopStatus
	SkipReason   string
	// GoogleURL and AppleURL are built by domain.GoogleMapsStopURL /
	// AppleMapsStopURL in the handler. The view does not construct navigation
	// URLs: there is one tested implementation, and coordinate formatting is
	// too easy to get subtly wrong in two places.
	GoogleURL string
	AppleURL  string
}

// nextStop returns the first unresolved stop — the one the driver is heading
// to right now. Highlighting it means the page answers "where next?" without
// the driver reading the list.
func nextStop(stops []DriverStop) (DriverStop, bool) {
	for _, s := range stops {
		if s.Status == domain.RouteStopPending {
			return s, true
		}
	}
	return DriverStop{}, false
}

func stopDeliveredAction(token string, id uuid.UUID) string {
	return fmt.Sprintf("/routes/%s/stops/%s/delivered", token, id)
}

func stopSkipAction(token string, id uuid.UUID) string {
	return fmt.Sprintf("/routes/%s/stops/%s/skip", token, id)
}

// DriverRoutePage is the standalone page. No site chrome: this is a tool, and
// a driver holding a phone in one hand does not need the shop's navigation.
templ DriverRoutePage(props DriverRouteProps) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<!-- No indexing: the token in this URL is a credential. -->
			<meta name="robots" content="noindex, nofollow"/>
			<title>Delivery route — Rockabilly Roasting Co.</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/alpine.min.js" defer></script>
			<style>[x-cloak]{display:none !important}</style>
		</head>
		<body class="h-full bg-paper text-ink">
			<div id="driver-route" class="mx-auto w-full max-w-xl px-4 py-5">
				@DriverRouteBody(props)
			</div>
		</body>
	</html>
}

// DriverRouteBody is everything that changes when a stop is resolved. Swapped
// whole over htmx so the progress header, the highlighted next stop, and the
// list can never disagree with each other.
templ DriverRouteBody(props DriverRouteProps) {
	<div id="driver-route-body" class="space-y-4">
		<header class="border-2 border-ink bg-cream-hi p-4">
			<div class="flex items-baseline justify-between gap-3">
				<h1 class="font-slab uppercase text-ink text-xl" style="letter-spacing:0.04em;">Today's run</h1>
				<span class="font-special text-sm text-ink-soft tabular-nums">
					{ fmt.Sprintf("%d of %d", props.Progress.Delivered+props.Progress.Skipped, props.Progress.Total) }
				</span>
			</div>
			<div class="mt-3 h-2 w-full border border-ink bg-paper">
				<div
					class="h-full bg-rust"
					style={ fmt.Sprintf("width: %d%%", progressPercent(props.Progress)) }
				></div>
			</div>
			if props.EndAddress != "" {
				<p class="mt-2 font-oswald text-xs text-ink-soft">
					Ends at { props.EndAddress } — no need to come back to the shop.
				</p>
			}
			if props.Progress.Skipped > 0 {
				<p class="mt-2 font-oswald text-xs text-ink-soft">
					{ fmt.Sprintf("%d skipped — those orders stay on the list for the next run.", props.Progress.Skipped) }
				</p>
			}
		</header>
		if !props.Completed && len(props.NavChunks) > 0 {
			<!-- Google only; Apple Maps has no multi-stop URL scheme at all. -->
			<section class="border-2 border-ink bg-paper p-3">
				<p class="font-oswald text-xs uppercase text-ink-soft" style="letter-spacing:0.18em;">
					if len(props.NavChunks) == 1 {
						Navigate the whole run
					} else {
						Navigate in { fmt.Sprintf("%d", len(props.NavChunks)) } legs
					}
				</p>
				<div class="mt-2 space-y-2">
					for _, chunk := range props.NavChunks {
						<a
							href={ templ.SafeURL(chunk.URL) }
							target="_blank"
							rel="noopener"
							class="block border-2 border-ink bg-ink px-3 py-3 text-center font-oswald text-sm font-semibold uppercase text-paper"
							style="letter-spacing:0.08em;"
						>
							{ chunk.Label() }
						</a>
					}
				</div>
				if len(props.NavChunks) > 1 {
					<p class="mt-2 font-oswald text-xs text-ink-soft">
						Google Maps holds ten stops per route. Work through the legs in order.
					</p>
				}
			</section>
		}
		if props.Completed {
			<div class="border-2 border-ink bg-cream-hi p-6 text-center">
				<p class="font-slab uppercase text-ink text-lg">Run complete</p>
				<p class="mt-2 font-oswald text-sm text-ink-soft">
					Every stop is accounted for. This link is now closed — head back to the shop.
				</p>
			</div>
		} else {
			if stop, ok := nextStop(props.Stops); ok {
				<!-- The next stop is repeated at the top, big, because that is
				     the only thing a driver pulling away from a curb needs. -->
				<section class="border-2 border-ink bg-cream-hi shadow-stamp p-4">
					<p class="font-oswald text-xs uppercase text-rust" style="letter-spacing:0.18em;">Next stop</p>
					<p class="mt-1 font-slab uppercase text-ink text-lg leading-tight">{ stop.CustomerName }</p>
					<p class="mt-1 font-oswald text-base text-ink-soft">{ stop.Address }</p>
					if stop.Notes != "" {
						<p class="mt-2 border-l-4 border-amber pl-2 font-oswald text-sm text-ink">{ stop.Notes }</p>
					}
					@navigateButtons(stop)
					@stopActions(props.Token, stop)
				</section>
			}
		}
		<ol class="space-y-3">
			for _, stop := range props.Stops {
				@driverStopCard(props.Token, stop)
			}
		</ol>
	</div>
}

// progressPercent is the width of the progress bar. Guards the empty route so
// the style attribute never renders a NaN.
func progressPercent(p domain.RouteProgress) int {
	if p.Total == 0 {
		return 0
	}
	return ((p.Delivered + p.Skipped) * 100) / p.Total
}

templ driverStopCard(token string, stop DriverStop) {
	<li
		class={ "border-2 border-ink p-3",
			templ.KV("bg-cream-hi", stop.Status == domain.RouteStopPending),
			templ.KV("bg-paper opacity-70", stop.Status != domain.RouteStopPending) }
	>
		<div class="flex items-start gap-3">
			<span class="font-slab text-ink text-lg tabular-nums">{ fmt.Sprintf("%d", stop.Position) }</span>
			<div class="min-w-0 flex-1">
				<p class="font-oswald font-semibold text-ink">{ stop.CustomerName }</p>
				<p class="font-oswald text-sm text-ink-soft break-words">{ stop.Address }</p>
				if stop.Notes != "" && stop.Status == domain.RouteStopPending {
					<p class="mt-1 font-oswald text-sm text-ink">{ stop.Notes }</p>
				}
				switch stop.Status {
					case domain.RouteStopDelivered:
						<p class="mt-1 font-oswald text-xs uppercase text-rust" style="letter-spacing:0.14em;">Delivered</p>
					case domain.RouteStopSkipped:
						<p class="mt-1 font-oswald text-xs uppercase text-ink-soft" style="letter-spacing:0.14em;">
							Skipped
							if stop.SkipReason != "" {
								— { stop.SkipReason }
							}
						</p>
					default:
						@navigateButtons(stop)
						@stopActions(token, stop)
				}
			</div>
		</div>
	</li>
}

// navigateButtons hand the stop to whichever maps app the driver uses. Both are
// offered rather than sniffing the user agent: a wrong guess strands a driver
// with a link that does nothing, and two buttons cost one line of screen.
templ navigateButtons(stop DriverStop) {
	<div class="mt-3 flex gap-2">
		<a
			href={ templ.SafeURL(stop.GoogleURL) }
			target="_blank"
			rel="noopener"
			class="flex-1 border-2 border-ink bg-rust px-3 py-3 text-center font-oswald text-sm font-semibold uppercase text-paper"
			style="letter-spacing:0.08em;"
		>
			Google Maps
		</a>
		<a
			href={ templ.SafeURL(stop.AppleURL) }
			target="_blank"
			rel="noopener"
			class="flex-1 border-2 border-ink bg-cream-hi px-3 py-3 text-center font-oswald text-sm font-semibold uppercase text-ink"
			style="letter-spacing:0.08em;"
		>
			Apple Maps
		</a>
	</div>
}

// stopActions are the two outcomes of a stop. Both POST — never GET — so a
// link prefetcher can't resolve a delivery on the driver's behalf.
//
// Buttons are full-width and tall because they are pressed with a thumb while
// holding a box of coffee.
templ stopActions(token string, stop DriverStop) {
	<div class="mt-2 space-y-2" x-data="{ skipping: false }">
		<form
			hx-post={ stopDeliveredAction(token, stop.ID) }
			hx-target="#driver-route-body"
			hx-swap="outerHTML"
			hx-disabled-elt="find button"
		>
			<button
				type="submit"
				class="w-full border-2 border-ink bg-ink px-3 py-3 font-oswald text-sm font-semibold uppercase text-paper"
				style="letter-spacing:0.08em;"
			>
				Delivered
			</button>
		</form>
		<button
			type="button"
			x-show="!skipping"
			@click="skipping = true"
			class="w-full border-2 border-ink bg-paper px-3 py-2 font-oswald text-xs uppercase text-ink-soft"
			style="letter-spacing:0.08em;"
		>
			Skip this stop
		</button>
		<!-- The reason is required by the UI, not the schema: a skip with no
		     explanation leaves staff guessing at what to fix before the next
		     run, which is the entire point of recording it. -->
		<form
			x-show="skipping"
			x-cloak
			hx-post={ stopSkipAction(token, stop.ID) }
			hx-target="#driver-route-body"
			hx-swap="outerHTML"
			hx-disabled-elt="find button"
			class="space-y-2"
		>
			<input
				type="text"
				name="reason"
				required
				maxlength="200"
				placeholder="Why? e.g. wrong address, nobody home"
				class="w-full border-2 border-ink bg-paper px-3 py-2 font-oswald text-sm text-ink"
			/>
			<div class="flex gap-2">
				<button
					type="submit"
					class="flex-1 border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm font-semibold uppercase text-ink"
					style="letter-spacing:0.08em;"
				>
					Confirm skip
				</button>
				<button
					type="button"
					@click="skipping = false"
					class="border-2 border-ink bg-paper px-3 py-2 font-oswald text-sm uppercase text-ink-soft"
				>
					Cancel
				</button>
			</div>
		</form>
	</div>
}

// DriverRouteGonePage is what an unknown, draft, or finished token gets. One
// page for all three: the link expiring at the end of a run is the normal end
// state, and naming which case it is would only help someone guessing tokens.
templ DriverRouteGonePage() {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>Route closed — Rockabilly Roasting Co.</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
		</head>
		<body class="h-full bg-paper text-ink">
			<div class="mx-auto flex min-h-full max-w-md items-center px-4">
				<div class="w-full border-2 border-ink bg-cream-hi p-6 text-center shadow-stamp">
					<h1 class="font-slab uppercase text-ink text-xl">Route closed</h1>
					<p class="mt-3 font-oswald text-sm text-ink-soft">
						This delivery link isn't active. If today's run is still going, ask the shop for a fresh link.
					</p>
				</div>
			</div>
		</body>
	</html>
}
