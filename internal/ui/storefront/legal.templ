package storefront

// legalSection renders a titled block of long-form policy copy with a short
// ink rule above the Oswald heading — used by /terms, /privacy, /shipping.
templ legalSection(heading string) {
	<section class="relative pt-2">
		<span aria-hidden="true" class="block w-12 h-[2px] bg-ink mb-5"></span>
		<h2 class="font-oswald font-bold text-ink text-sm mb-4" style="letter-spacing:0.22em; text-transform:uppercase;">
			{ heading }
		</h2>
		<div class="font-oswald text-ink-soft text-base leading-relaxed space-y-4 [&_p]:leading-relaxed">
			{ children... }
		</div>
	</section>
}

// legalContactCard renders the stamped "Contact" block shared across legal
// pages. Ink-bordered cream-hi panel with candle section flag and the
// standard Rockabilly contact trio.
templ legalContactCard() {
	<aside class="mt-14 border-2 border-ink bg-cream-hi shadow-stamp p-6 sm:p-7">
		<p class="font-oswald font-bold text-candle text-[11px] mb-4 pb-2 border-b-2 border-ink" style="letter-spacing:0.24em; text-transform:uppercase;">
			Contact
		</p>
		<p class="font-oswald text-ink-soft text-sm sm:text-base leading-relaxed">
			Questions? Drop us a line — we read everything.
		</p>
		<dl class="mt-4 space-y-1.5">
			<div>
				<dt class="sr-only">Email</dt>
				<dd>
					<a href="mailto:info@rockabillyroasting.com" class="font-special text-rust hover:text-rust-deep underline underline-offset-2">
						info@rockabillyroasting.com
					</a>
				</dd>
			</div>
			<div>
				<dt class="sr-only">Phone</dt>
				<dd class="font-special text-ink-soft text-sm sm:text-base">509-585-2320</dd>
			</div>
			<div>
				<dt class="sr-only">Address</dt>
				<dd class="font-oswald text-ink text-sm sm:text-base" style="letter-spacing:0.04em;">
					101 W. Kennewick Ave., Kennewick, WA
				</dd>
			</div>
		</dl>
	</aside>
}
