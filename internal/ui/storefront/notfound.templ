package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type NotFoundProps struct {
	CartCount    int
	CanonicalURL string
}

templ NotFoundContent(props NotFoundProps) {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)] flex items-center">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-xl px-6 sm:px-10 lg:px-14 py-16 sm:py-20 text-center">
			<!-- Giant 404 with "not found" stamp overlay -->
			<div class="relative inline-block">
				<p class="font-slab text-ink leading-[0.85]" style="font-size: clamp(7rem, 20vw, 11rem); letter-spacing:-0.02em;">
					404
				</p>
				<span
					class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 inline-block font-oswald font-bold text-[13px] sm:text-sm text-rust bg-paper px-3 py-1.5 border-2 border-rust whitespace-nowrap"
					style="letter-spacing:0.18em; text-transform:uppercase; transform: translate(-50%, -50%) rotate(-8deg); outline:2px solid var(--color-rust); outline-offset:3px;"
				>
					Not found
				</span>
			</div>
			<!-- Heading -->
			<h1 class="font-slab text-ink uppercase leading-[0.92] mt-8" style="font-size: clamp(1.75rem, 4vw, 2.75rem); letter-spacing:-0.005em;">
				This page
				<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">skipped town.</span>
			</h1>
			<p class="mt-5 font-oswald text-ink-soft text-base leading-relaxed max-w-md mx-auto">
				Either the link's wrong or we moved the furniture. Either way, let's get you back to the coffee.
			</p>
			<!-- CTAs -->
			<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
				<a
					href="/catalog"
					class="btn-stamp inline-flex items-center gap-2 bg-rust text-paper border-2 border-ink px-7 py-3.5 font-oswald font-bold text-sm"
					style="letter-spacing:0.14em; text-transform:uppercase;"
				>
					Shop coffee
					<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
					</svg>
				</a>
				<a
					href="/"
					class="inline-flex items-center gap-2 bg-transparent text-ink border-2 border-ink px-7 py-3.5 font-oswald font-bold text-sm hover:bg-ink hover:text-paper transition-colors"
					style="letter-spacing:0.14em; text-transform:uppercase;"
				>
					Back to home
				</a>
			</div>
		</div>
	</section>
}

templ NotFoundPage(props NotFoundProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:        "Page Not Found",
		Description:  "The page you're looking for doesn't exist.",
		CartCount:    props.CartCount,
		CanonicalURL: props.CanonicalURL,
	}) {
		@NotFoundContent(props)
	}
}
