package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type PrivacyProps struct {
	CartCount    int
	CanonicalURL string
}

templ PrivacyContent(props PrivacyProps) {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)]">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-3xl px-6 sm:px-10 lg:px-14 py-12 sm:py-16">
			<!-- Page heading -->
			<header class="mb-12">
				<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
					How we handle your data
				</p>
				<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(2rem, 5vw, 3.25rem); letter-spacing:-0.005em;">
					Privacy
					<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">policy.</span>
				</h1>
				<p class="font-special text-chrome-deep text-sm mt-4">Last updated: March 2026</p>
			</header>
			<!-- Legal body -->
			<article class="space-y-10">
				@legalSection("What we collect") {
					<p>When you place an order, we collect the information needed to fulfill it: your name, email, shipping address, and payment details. Payment is processed by Stripe — we never see or store your full card number.</p>
					<p>If you create an account or subscribe, we store your email and order history so you can manage your purchases.</p>
				}
				@legalSection("Analytics") {
					<p>We use <a href="https://plausible.io" class="text-rust hover:text-rust-deep underline underline-offset-2">Plausible Analytics</a>, a privacy-focused analytics tool. Plausible doesn't use cookies, doesn't collect personal data, and doesn't track you across sites. All data is aggregated — we see page view counts, not individual visitors.</p>
				}
				@legalSection("How we use your information") {
					<ul class="list-disc pl-5 space-y-2">
						<li>To fulfill and ship your orders</li>
						<li>To send order confirmations and shipping updates</li>
						<li>To process returns or resolve issues</li>
						<li>To send subscription-related emails (if you subscribe)</li>
					</ul>
					<p>We don't sell your data. We don't send marketing emails unless you opt in.</p>
				}
				@legalSection("Third-party services") {
					<p>We share only what's necessary with the following services:</p>
					<ul class="list-disc pl-5 space-y-2">
						<li><strong class="font-oswald font-bold text-ink">Stripe</strong> — payment processing</li>
						<li><strong class="font-oswald font-bold text-ink">EasyPost</strong> — shipping label generation and tracking</li>
						<li><strong class="font-oswald font-bold text-ink">Plausible</strong> — privacy-focused analytics (no personal data shared)</li>
					</ul>
				}
				@legalSection("Cookies") {
					<p>We use a session cookie to keep you logged in and to maintain your shopping cart. That's it. No tracking cookies, no third-party advertising cookies.</p>
				}
				@legalSection("Data retention") {
					<p>We keep order records as long as needed for tax and legal compliance. If you want your account deleted, contact us and we'll take care of it.</p>
				}
			</article>
			<!-- Contact card -->
			@legalContactCard()
		</div>
	</section>
}

templ PrivacyPage(props PrivacyProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:        "Privacy Policy",
		Description:  "How Rockabilly Roasting Co. handles your data.",
		CartCount:    props.CartCount,
		CanonicalURL: props.CanonicalURL,
	}) {
		@PrivacyContent(props)
	}
}
