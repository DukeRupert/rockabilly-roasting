package storefront

import (
	"encoding/json"
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/media"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type OptionWithValues struct {
	Option domain.ProductOption
	Values []domain.ProductOptionValue
}

type VariantWithPrice struct {
	Variant      domain.Variant
	BasePrice    *int
	CurrencyCode string
}

// VariantOptionEntry maps a variant to its option value IDs and price for JS variant resolution.
type VariantOptionEntry struct {
	OptionValueIDs []string `json:"optionValueIDs"`
	Price          *int     `json:"price"`
}

type ProductDetailProps struct {
	Product           *domain.Product
	Media             []domain.ProductMedia
	MediaConfig       *media.Config
	Variants          []VariantWithPrice
	Options           []OptionWithValues
	VariantMap        map[string]VariantOptionEntry // variantID -> option value IDs + price
	DefaultPrice      *int
	DefaultSKU        string // SKU of the default variant; used in Product JSON-LD Offer
	CurrencyCode      string
	CartCount         int
	SubscriptionPlans []domain.SubscriptionPlan
	Coffee            *CoffeeAttrs // nil if not a coffee product
	PrevProduct       *ProductNav  // nil when catalog has ≤1 active product
	NextProduct       *ProductNav
	RoastBased        bool // true when PrevProduct/NextProduct were picked on the lighter/darker roast axis
	Category          string // taxon name, used as item_category on GA4 events
	CanonicalURL      string
	OGImage           string
	BaseURL           string // e.g. "https://rockabillyroasting.com" — for JSON-LD absolute URLs
}

// productAnalyticsScript builds the GA4 payload for view_item / add_to_cart
// and returns it wrapped in a <script id="ga-product-data"> tag. The full
// tag is emitted via @templ.Raw because templ does not interpolate Go
// expressions inside <script> bodies.
func productAnalyticsScript(props ProductDetailProps) string {
	type variantEntry struct {
		SKU        string `json:"sku"`
		PriceCents int    `json:"price_cents"`
	}
	variants := make(map[string]variantEntry, len(props.Variants))
	for _, v := range props.Variants {
		entry := variantEntry{SKU: v.Variant.SKU}
		if v.BasePrice != nil {
			entry.PriceCents = *v.BasePrice
		}
		variants[v.Variant.ID.String()] = entry
	}
	var defaultPrice int
	if props.DefaultPrice != nil {
		defaultPrice = *props.DefaultPrice
	}
	b, err := json.Marshal(map[string]any{
		"item_id":             props.Product.ID.String(),
		"item_name":           props.Product.Title,
		"item_category":       props.Category,
		"currency":            props.CurrencyCode,
		"default_price_cents": defaultPrice,
		"variants":            variants,
	})
	if err != nil {
		return ""
	}
	return `<script id="ga-product-data" type="application/json">` + string(b) + `</script>`
}

// ProductNav carries the minimum data needed for prev/next links at the
// bottom of the product detail page. RoastLevel is set when the pair is
// chosen on a "lighter / darker" axis so the card can render roast dots.
type ProductNav struct {
	Title        string
	Slug         string
	ThumbnailURL string
	RoastLevel   string // optional, drives the dot scale on roast-based pairs
}

templ ProductContent(props ProductDetailProps) {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)]">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-7xl px-6 sm:px-10 lg:px-14 py-10 sm:py-14">
			<!-- Breadcrumb -->
			<nav class="mb-8">
				<ol class="flex items-center gap-2 font-oswald font-semibold text-[11px]" style="letter-spacing:0.18em; text-transform:uppercase;">
					<li><a href="/catalog" class="text-chrome-deep hover:text-rust transition-colors">Shop</a></li>
					<li><span class="text-chrome-deep" aria-hidden="true">/</span></li>
					<li class="text-ink">{ props.Product.Title }</li>
				</ol>
			</nav>
			<!-- Product layout: image left on desktop, info right -->
			<div class="lg:grid lg:grid-cols-2 lg:gap-x-12">
				<!-- LEFT: Product image -->
				<div class="order-1 lg:order-none">
					if len(props.Media) > 0 {
						<!-- Main image, ink-bordered with stamp shadow -->
						<div class="relative aspect-square w-full overflow-hidden bg-paper-warm border-2 border-ink shadow-stamp">
							<img
								id="main-product-image"
								src={ props.MediaConfig.ProductImageURL(props.Media[0].R2Key, media.VariantHero) }
								alt={ props.Media[0].AltText }
								class="absolute inset-0 h-full w-full object-cover object-center"
							/>
							<!-- "Fresh Weekly" stamp sticker -->
							<div class="absolute top-4 left-4 pointer-events-none">
								<span
									class="inline-block font-oswald font-bold text-[11px] text-rust bg-paper px-3 py-1.5 border-2 border-rust"
									style="letter-spacing:0.18em; text-transform:uppercase; transform:rotate(-4deg); outline:2px solid var(--color-rust); outline-offset:2px;"
								>
									Fresh Weekly
								</span>
							</div>
						</div>
						<!-- Thumbnails -->
						if len(props.Media) > 1 {
							<div class="mt-4 grid grid-cols-4 gap-3">
								for i, m := range props.Media {
									<button
										type="button"
										class={ "product-thumb aspect-square overflow-hidden bg-paper-warm border-2 cursor-pointer transition-all",
											templ.KV("border-ink shadow-stamp-sm", i == 0),
											templ.KV("border-chrome-deep/40 hover:border-ink", i != 0) }
										aria-label={ "View " + m.AltText }
										aria-pressed={ fmt.Sprintf("%t", i == 0) }
										data-hero-src={ props.MediaConfig.ProductImageURL(m.R2Key, media.VariantHero) }
										data-alt={ m.AltText }
									>
										<img
											src={ props.MediaConfig.ProductImageURL(m.R2Key, media.VariantThumbnail) }
											alt=""
											class="h-full w-full object-cover object-center"
										/>
									</button>
								}
							</div>
							@productThumbScript()
						}
					} else {
						<div class="aspect-square w-full overflow-hidden bg-paper-warm border-2 border-ink shadow-stamp flex items-center justify-center relative">
							<div class="w-24 h-24 border-2 border-ink bg-paper flex items-center justify-center">
								<span class="font-slab text-ink text-4xl uppercase leading-none">
									{ string([]rune(props.Product.Title)[0:2]) }
								</span>
							</div>
						</div>
					}
				</div>
				<!-- RIGHT: Product info + actions -->
				<div class="mt-8 lg:mt-0 order-2 lg:order-none">
					<!-- Origin eyebrow -->
					if props.Coffee != nil && originLine(props.Coffee) != "" {
						<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
							{ originLine(props.Coffee) }
						</p>
					}
					<!-- Title -->
					<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(2.25rem, 5vw, 3.5rem); letter-spacing:-0.005em;">
						{ props.Product.Title }
					</h1>
					<!-- Roast scale -->
					if props.Coffee != nil && validRoastLevel(props.Coffee.RoastLevel) {
						<div class="mt-5 flex items-center gap-3">
							@roastDots(props.Coffee.RoastLevel, "large")
							<span class="font-oswald font-bold text-ink text-xs" style="letter-spacing:0.2em; text-transform:uppercase;">{ roastLevelLabel(props.Coffee.RoastLevel) } roast</span>
						</div>
					}
					<!-- Price tag — ink-bordered, Special Elite typewriter -->
					if props.DefaultPrice != nil {
						<div class="mt-6 inline-flex items-center gap-3 border-2 border-ink bg-paper-warm px-5 py-3" id="price-display" aria-live="polite" aria-atomic="true">
							<span class="font-special text-ink text-2xl sm:text-3xl leading-none" data-base-price={ fmt.Sprintf("%d", *props.DefaultPrice) }>{ formatCents(*props.DefaultPrice) }</span>
						</div>
					}
					<!-- Tasting notes -->
					if props.Coffee != nil && len(props.Coffee.TastingNotes) > 0 {
						<ul class="mt-6 flex flex-wrap gap-2">
							for _, note := range props.Coffee.TastingNotes {
								<li class="font-oswald font-bold text-[10px] text-ink bg-paper border-2 border-ink px-2.5 py-1 rounded-full" style="letter-spacing:0.14em; text-transform:uppercase;">
									{ note }
								</li>
							}
						</ul>
					}
					<!-- Description -->
					if props.Product.Description != "" {
						<p class="mt-6 font-oswald text-ink-soft text-base leading-relaxed max-w-lg">{ props.Product.Description }</p>
					}
					<!-- Variant options -->
					if len(props.Options) > 0 {
						<div class="mt-8 space-y-6">
							for _, opt := range props.Options {
								@optionPillGroup(opt, defaultOptionValueIDSet(props.Variants, props.VariantMap))
							}
						</div>
					}
					if len(props.Variants) > 0 {
						<!-- Purchase mode selector -->
						<div class="mt-8" id="purchase-section">
							if len(props.SubscriptionPlans) > 0 {
								<!-- Mode toggle tabs -->
								<div class="grid grid-cols-2 gap-3" id="purchase-mode-toggle" role="tablist" aria-label="Purchase type">
									<button
										type="button"
										role="tab"
										aria-selected="true"
										aria-controls="onetime-form"
										data-mode="onetime"
										class="purchase-mode-btn border-2 border-ink bg-paper-warm p-4 text-left transition-all"
										style="box-shadow: var(--shadow-stamp-sm);"
									>
										<span class="block font-oswald font-bold text-ink text-[11px]" style="letter-spacing:0.2em; text-transform:uppercase;">One-time</span>
										<span class="block font-oswald text-chrome-deep text-xs mt-1">Single bag, one-off</span>
									</button>
									<button
										type="button"
										role="tab"
										aria-selected="false"
										aria-controls="subscribe-form"
										data-mode="subscribe"
										class="purchase-mode-btn border-2 border-ink bg-cream-hi p-4 text-left transition-all"
									>
										<span class="block font-oswald font-bold text-ink text-[11px]" style="letter-spacing:0.2em; text-transform:uppercase;">Subscribe</span>
										<span class="block font-oswald text-rust text-xs font-semibold mt-1">
											Save up to { fmt.Sprintf("%d%%", maxDiscount(props.SubscriptionPlans)) }
										</span>
									</button>
								</div>
								<!-- Subscription frequency options (hidden by default) -->
								<div id="subscribe-options" class="hidden mt-5">
									<p class="font-oswald font-bold text-ink text-[11px] mb-3" style="letter-spacing:0.2em; text-transform:uppercase;">Delivery every</p>
									<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
										for i, plan := range props.SubscriptionPlans {
											<label
												class={ "subscribe-frequency-option flex items-center justify-between border-2 p-3 cursor-pointer transition-all",
													templ.KV("border-ink bg-paper-warm", i == 0),
													templ.KV("border-chrome-deep/40 bg-cream-hi hover:border-ink", i != 0) }
												data-plan-id={ plan.ID.String() }
												data-discount={ fmt.Sprintf("%d", plan.DiscountPct) }
												if i == 0 {
													style="box-shadow: var(--shadow-stamp-sm);"
												}
											>
												<div class="flex items-center gap-3">
													<input
														type="radio"
														name="plan_id"
														value={ plan.ID.String() }
														if i == 0 {
															checked
														}
														class="size-4 accent-rust"
													/>
													<span class="font-oswald text-ink text-sm" style="letter-spacing:0.04em;">{ subscriptionIntervalLabel(plan.Interval, plan.IntervalCount) }</span>
												</div>
												if plan.DiscountPct > 0 {
													<span class="font-oswald font-bold text-[10px] text-rust border-2 border-rust bg-paper px-2 py-0.5" style="letter-spacing:0.14em; text-transform:uppercase;">
														Save { fmt.Sprintf("%d%%", plan.DiscountPct) }
													</span>
												}
											</label>
										}
									</div>
								</div>
							}
							<!-- One-time purchase form — stamp CTA -->
							<div
								id="onetime-form"
								role="tabpanel"
								class="mt-6"
								x-data="{
									qty: 1,
									state: 'idle',
									_t: 0,
									_spinTimer: null,
									clampQty() {
										let v = parseInt(this.qty, 10);
										if (isNaN(v) || v < 1) v = 1;
										else if (v > 10) v = 10;
										this.qty = v;
									},
									submit() {
										this._t = Date.now();
										this._spinTimer = setTimeout(() => { if (this.state === 'pending') this.state = 'sending' }, 250);
										this.state = 'pending';
									},
									done(ok) {
										clearTimeout(this._spinTimer);
										if (!ok) { this.state = 'idle'; return; }
										const elapsed = Date.now() - this._t;
										const delay = this.state === 'sending' ? Math.max(0, 600 - elapsed) : 0;
										setTimeout(() => {
											this.state = 'added';
											setTimeout(() => this.state = 'idle', 2000);
										}, delay);
									}
								}"
							>
								<form
									method="post"
									action="/cart/add"
									hx-post="/cart/add"
									hx-swap="none"
									@htmx:before-request.camel="submit()"
									@htmx:after-request.camel="done($event.detail.successful)"
								>
									<input type="hidden" name="variant_id" id="selected-variant-id" value={ defaultVariantID(props.Variants) }/>
									<!-- Quantity stepper -->
									<div class="mb-4">
										<label for="onetime-quantity" class="font-oswald font-bold text-ink text-[11px] mb-3 block" style="letter-spacing:0.2em; text-transform:uppercase;">Quantity</label>
										<div class="inline-flex border-2 border-ink">
											<button
												type="button"
												@click="if (qty > 1) qty = qty - 1"
												:disabled="qty <= 1 || state !== 'idle'"
												aria-label="Decrease quantity"
												class="bg-paper-warm text-ink font-oswald font-bold px-4 py-2.5 text-lg leading-none border-r-2 border-ink hover:bg-ink hover:text-paper transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
											>
												&minus;
											</button>
											<input
												type="number"
												id="onetime-quantity"
												name="quantity"
												x-model.number="qty"
												@change="clampQty()"
												min="1"
												max="10"
												:disabled="state !== 'idle'"
												class="w-16 bg-cream-hi text-ink font-special text-center py-2.5 focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
											/>
											<button
												type="button"
												@click="if (qty < 10) qty = qty + 1"
												:disabled="qty >= 10 || state !== 'idle'"
												aria-label="Increase quantity"
												class="bg-paper-warm text-ink font-oswald font-bold px-4 py-2.5 text-lg leading-none border-l-2 border-ink hover:bg-ink hover:text-paper transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
											>
												+
											</button>
										</div>
									</div>
									<button
										type="submit"
										class="btn-stamp w-full border-2 border-ink px-6 py-4 font-oswald font-bold text-sm transition-colors"
										style="letter-spacing:0.16em; text-transform:uppercase;"
										:class="state === 'added' ? 'bg-candle text-ink' : 'bg-rust text-paper'"
										:disabled="state !== 'idle'"
									>
										<span x-show="state === 'idle' || state === 'pending'" class="inline-flex items-center justify-center gap-2">
											Add to cart
											<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
												<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
											</svg>
										</span>
										<span
											x-show="state === 'sending'"
											x-cloak
											x-transition:enter="transition ease-out duration-200"
											x-transition:enter-start="opacity-0"
											x-transition:enter-end="opacity-100"
											class="inline-flex items-center justify-center gap-2"
										>
											<svg class="size-4 animate-spin" fill="none" viewBox="0 0 24 24">
												<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
												<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
											</svg>
											Adding…
										</span>
										<span
											x-show="state === 'added'"
											x-cloak
											x-transition:enter="transition ease-out duration-300"
											x-transition:enter-start="opacity-0 scale-95"
											x-transition:enter-end="opacity-100 scale-100"
											class="inline-flex items-center justify-center gap-2"
										>
											<svg class="size-4 cart-checkmark" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
												<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
											</svg>
											Added!
										</span>
									</button>
								</form>
							</div>
							<!-- Subscribe form -->
							if len(props.SubscriptionPlans) > 0 {
								<div id="subscribe-form" role="tabpanel" class="hidden mt-6">
									<!-- Quantity selector -->
									<div class="mb-4">
										<label for="subscribe-quantity" class="font-oswald font-bold text-ink text-[11px] mb-3 block" style="letter-spacing:0.2em; text-transform:uppercase;">Quantity</label>
										<div class="inline-flex border-2 border-ink">
											<button
												type="button"
												id="subscribe-qty-minus"
												class="bg-paper-warm text-ink font-oswald font-bold px-4 py-2.5 text-lg leading-none border-r-2 border-ink hover:bg-ink hover:text-paper transition-colors"
											>
												&minus;
											</button>
											<input
												type="number"
												id="subscribe-quantity"
												value="1"
												min="1"
												max="10"
												class="w-16 bg-cream-hi text-ink font-special text-center py-2.5 focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
											/>
											<button
												type="button"
												id="subscribe-qty-plus"
												class="bg-paper-warm text-ink font-oswald font-bold px-4 py-2.5 text-lg leading-none border-l-2 border-ink hover:bg-ink hover:text-paper transition-colors"
											>
												+
											</button>
										</div>
									</div>
									<button
										type="button"
										id="subscribe-action"
										class="btn-stamp block w-full bg-rust text-paper border-2 border-ink px-6 py-4 font-oswald font-bold text-sm text-center"
										style="letter-spacing:0.16em; text-transform:uppercase;"
									>
										Subscribe &amp; save
									</button>
									<p class="mt-3 text-center font-oswald text-chrome-deep text-xs">Cancel or modify anytime from your account.</p>
								</div>
							}
						</div>
					}
					<!-- In stock indicator -->
					<div class="mt-6 flex items-center gap-2">
						<svg class="size-4 text-rust" aria-hidden="true" viewBox="0 0 20 20" fill="currentColor">
							<path d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" fill-rule="evenodd"></path>
						</svg>
						<p class="font-oswald text-ink-soft text-sm" style="letter-spacing:0.04em;">In stock &middot; roasted fresh &middot; ships within 48 hours</p>
					</div>
				</div>
			</div>
			<!-- Tasting profile -->
			if props.Coffee != nil && hasTastingProfile(props.Coffee) {
				@tastingProfile(props.Coffee)
			}
			<!-- Try another roast (or generic prev/next when no roast data) -->
			if props.PrevProduct != nil && props.NextProduct != nil {
				@productNavPair(props.PrevProduct, props.NextProduct, props.RoastBased)
			}
		</div>
	</section>
	if len(props.Options) > 0 && len(props.VariantMap) > 0 {
		@optionSelectionScript(props.VariantMap)
	}
	if len(props.SubscriptionPlans) > 0 && len(props.Variants) > 0 {
		@purchaseModeScript()
	}
	@templ.Raw(productAnalyticsScript(props))
	<script>
		(function() {
			var node = document.getElementById('ga-product-data');
			if (!node || !window.rrTrack) return;
			var data;
			try { data = JSON.parse(node.textContent); } catch (e) { return; }
			var defaultPrice = (data.default_price_cents || 0) / 100;
			window.rrTrack('view_item', {
				currency: data.currency || 'USD',
				value: defaultPrice,
				items: [{
					item_id: data.item_id,
					item_name: data.item_name,
					item_category: data.item_category || undefined,
					price: defaultPrice,
					quantity: 1
				}]
			});
			// Hook the one-time-purchase add-to-cart form. The Alpine submit
			// component prevents reading variant after a successful swap, so we
			// snapshot at htmx:beforeRequest and dispatch on success.
			var form = document.querySelector('#onetime-form form[hx-post="/cart/add"]');
			if (!form) return;
			var pending = null;
			form.addEventListener('htmx:beforeRequest', function() {
				var fd = new FormData(form);
				var variantID = fd.get('variant_id');
				var qty = parseInt(fd.get('quantity') || '1', 10) || 1;
				var v = (data.variants || {})[variantID] || {};
				pending = {
					variant_id: variantID,
					sku: v.sku || '',
					price: (v.price_cents || data.default_price_cents || 0) / 100,
					quantity: qty
				};
			});
			form.addEventListener('htmx:afterRequest', function(evt) {
				if (!pending || !evt.detail || !evt.detail.successful) { pending = null; return; }
				window.rrTrack('add_to_cart', {
					currency: data.currency || 'USD',
					value: pending.price * pending.quantity,
					items: [{
						item_id: data.item_id,
						item_name: data.item_name,
						item_variant: pending.sku || undefined,
						item_category: data.item_category || undefined,
						price: pending.price,
						quantity: pending.quantity
					}]
				});
				pending = null;
			});
		})();
	</script>
}

templ optionPillGroup(opt OptionWithValues, defaultIDs map[string]bool) {
	<fieldset>
		<legend class="font-oswald font-bold text-ink text-[11px] mb-3 block" style="letter-spacing:0.2em; text-transform:uppercase;">{ opt.Option.Name }</legend>
		<div class="flex flex-wrap gap-2" data-option-id={ opt.Option.ID.String() } role="radiogroup" aria-label={ opt.Option.Name }>
			for i, val := range opt.Values {
				<button
					type="button"
					class={ "option-pill " + optionPillClasses(pillActive(val, opt.Values, defaultIDs, i)) }
					data-option-id={ opt.Option.ID.String() }
					data-value-id={ val.ID.String() }
					aria-pressed={ fmt.Sprintf("%t", pillActive(val, opt.Values, defaultIDs, i)) }
				>
					{ val.Value }
				</button>
			}
		</div>
	</fieldset>
}

templ tastingProfile(attrs *CoffeeAttrs) {
	<section class="mt-16 pt-10 border-t-2 border-ink">
		<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">What's in the cup</p>
		<h2 class="font-slab text-ink uppercase leading-[0.95] mt-2 mb-10" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); letter-spacing:-0.005em;">
			Tasting
			<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">profile.</span>
		</h2>
		<div class={ "grid grid-cols-1 gap-10", templ.KV("lg:grid-cols-2", hasFlavorScales(attrs) && hasProfileDetails(attrs)) }>
			if hasFlavorScales(attrs) {
				<div class="border-2 border-ink bg-cream-hi p-6 shadow-stamp space-y-5">
					if attrs.Body != "" {
						@flavorScale("Body", attrs.Body)
					}
					if attrs.Acidity != "" {
						@flavorScale("Acidity", attrs.Acidity)
					}
					if attrs.Sweetness != "" {
						@flavorScale("Sweetness", attrs.Sweetness)
					}
				</div>
			}
			if hasProfileDetails(attrs) {
				<div class="space-y-6">
					if attrs.Process != "" {
						<div class="border-b border-ink pb-4">
							<p class="font-oswald font-bold text-ink text-[11px] mb-1.5" style="letter-spacing:0.2em; text-transform:uppercase;">Process</p>
							<p class="font-oswald text-ink-soft text-base capitalize">{ attrs.Process }</p>
						</div>
					}
					if attrs.Finish != "" {
						<div class="border-b border-ink pb-4">
							<p class="font-oswald font-bold text-ink text-[11px] mb-1.5" style="letter-spacing:0.2em; text-transform:uppercase;">Finish</p>
							<p class="font-heritage text-ink-soft text-base italic">{ attrs.Finish }</p>
						</div>
					}
					if len(attrs.BrewMethods) > 0 {
						<div class="border-b border-ink pb-4">
							<p class="font-oswald font-bold text-ink text-[11px] mb-2.5" style="letter-spacing:0.2em; text-transform:uppercase;">Best brewed as</p>
							<div class="flex flex-wrap gap-1.5">
								for _, method := range attrs.BrewMethods {
									<span class="font-oswald font-bold text-[10px] text-ink border-2 border-ink bg-paper px-2.5 py-1" style="letter-spacing:0.14em; text-transform:uppercase;">
										{ formatBrewMethod(method) }
									</span>
								}
							</div>
						</div>
					}
					if len(attrs.Certifications) > 0 || attrs.IsSeasonal {
						<div class="flex flex-wrap gap-1.5">
							for _, cert := range attrs.Certifications {
								<span class="font-oswald font-bold text-[10px] text-ink border-2 border-ink bg-paper px-2.5 py-1 rounded-full" style="letter-spacing:0.14em; text-transform:uppercase;">
									{ formatCertification(cert) }
								</span>
							}
							if attrs.IsSeasonal {
								<span class="font-oswald font-bold text-[10px] text-ink bg-candle border-2 border-ink px-2.5 py-1" style="letter-spacing:0.14em; text-transform:uppercase;">
									Seasonal
								</span>
							}
						</div>
					}
				</div>
			}
		</div>
	</section>
}

// productNavPair renders a two-panel "try another roast" strip below the
// tasting profile. When roastBased is true, the cards label themselves
// "Lighter / Darker" and show a dot scale; otherwise they fall back to a
// neutral "another to try" framing.
templ productNavPair(prev *ProductNav, next *ProductNav, roastBased bool) {
	<nav class="mt-16 pt-10 border-t-2 border-ink" aria-label="Other coffees to try">
		<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
			if roastBased {
				Try another roast
			} else {
				Another to try
			}
		</p>
		<h2 class="font-slab text-ink uppercase leading-[0.95] mt-2 mb-8" style="font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing:-0.005em;">
			if roastBased {
				Lighter or
				<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">darker?</span>
			} else {
				Pour another
				<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">cup.</span>
			}
		</h2>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-8">
			@productNavCard(prev, false, roastBased)
			@productNavCard(next, true, roastBased)
		</div>
	</nav>
}

// productNavCard renders one side of the recommendation pair. forward=true
// means it's the "right" side — label and arrow on the right, image on the
// left. roastBased flips the eyebrow to a Lighter/Darker call and shows the
// roast dot scale beneath the title.
templ productNavCard(nav *ProductNav, forward bool, roastBased bool) {
	<a
		href={ templ.SafeURL("/catalog/" + nav.Slug) }
		class={ "btn-stamp group flex items-center gap-4 bg-cream-hi border-2 border-ink p-4", templ.KV("sm:flex-row-reverse sm:text-right", forward) }
	>
		<!-- Thumbnail -->
		<div class="flex-shrink-0 w-20 h-20 sm:w-24 sm:h-24 bg-paper-warm border-2 border-ink overflow-hidden">
			if nav.ThumbnailURL != "" {
				<img
					src={ nav.ThumbnailURL }
					alt={ nav.Title }
					class="h-full w-full object-cover object-center"
					loading="lazy"
				/>
			} else {
				<div class="flex h-full w-full items-center justify-center">
					<span class="font-slab text-ink text-2xl leading-none uppercase">
						{ string([]rune(nav.Title)[0:1]) }
					</span>
				</div>
			}
		</div>
		<!-- Label + title -->
		<div class="min-w-0 flex-1">
			<p class={ "inline-flex items-center gap-1.5 font-oswald font-bold text-rust text-[11px]", templ.KV("sm:flex-row-reverse", forward) } style="letter-spacing:0.2em; text-transform:uppercase;">
				if !forward {
					<svg class="size-3 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
					</svg>
					if roastBased {
						<span>Lighter</span>
					} else {
						<span>Try this</span>
					}
				} else {
					if roastBased {
						<span>Darker</span>
					} else {
						<span>Try this</span>
					}
					<svg class="size-3 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
					</svg>
				}
			</p>
			<p class="font-slab text-ink uppercase leading-[1.0] mt-1.5 text-lg sm:text-xl group-hover:text-rust transition-colors truncate" style="letter-spacing:-0.005em;">
				{ nav.Title }
			</p>
			if roastBased && validRoastLevel(nav.RoastLevel) {
				<div class={ "mt-2 flex items-center gap-2", templ.KV("sm:justify-end", forward) }>
					@roastDots(nav.RoastLevel, "small")
					<span class="font-oswald font-bold text-chrome-deep text-[10px]" style="letter-spacing:0.18em; text-transform:uppercase;">{ roastLevelLabel(nav.RoastLevel) }</span>
				</div>
			}
		</div>
	</a>
}

// flavorScale renders a labeled 3-dot scale (low / medium / high).
templ flavorScale(label string, value string) {
	<div class="flex items-center justify-between">
		<p class="font-oswald font-bold text-ink text-[11px] w-24" style="letter-spacing:0.2em; text-transform:uppercase;">{ label }</p>
		<div class="flex items-center gap-4 flex-1">
			<div class="flex items-center gap-1.5">
				for i := 1; i <= 3; i++ {
					if i <= scaleLevel(value) {
						<span class="size-2.5 rounded-full bg-rust border-2 border-ink"></span>
					} else {
						<span class="size-2.5 rounded-full bg-paper-warm border-2 border-ink/30"></span>
					}
				}
			</div>
			<span class="font-special text-ink-soft text-sm capitalize">{ value }</span>
		</div>
	</div>
}

// productThumbScript wires up the thumbnail click handler to swap the main image.
templ productThumbScript() {
	<script>
		(function() {
			var mainImg = document.getElementById('main-product-image');
			if (!mainImg) return;
			document.querySelectorAll('.product-thumb').forEach(function(btn) {
				btn.addEventListener('click', function() {
					mainImg.src = btn.dataset.heroSrc;
					mainImg.alt = btn.dataset.alt || '';
					document.querySelectorAll('.product-thumb').forEach(function(b) {
						b.classList.remove('border-ink', 'shadow-stamp-sm');
						b.classList.add('border-chrome-deep/40');
						b.setAttribute('aria-pressed', 'false');
					});
					btn.classList.remove('border-chrome-deep/40');
					btn.classList.add('border-ink', 'shadow-stamp-sm');
					btn.setAttribute('aria-pressed', 'true');
				});
			});
		})();
	</script>
}

func defaultVariantID(variants []VariantWithPrice) string {
	for _, v := range variants {
		if v.Variant.IsDefault {
			return v.Variant.ID.String()
		}
	}
	if len(variants) > 0 {
		return variants[0].Variant.ID.String()
	}
	return ""
}

// defaultOptionValueIDSet returns the option-value IDs of the default variant.
// Used to mark the initially-active option pill so the visual selection always
// matches the variant_id the form submits (otherwise the customer can see "drip"
// highlighted while the form posts the whole-bean variant — orders ship wrong).
func defaultOptionValueIDSet(variants []VariantWithPrice, variantMap map[string]VariantOptionEntry) map[string]bool {
	defaultID := defaultVariantID(variants)
	if defaultID == "" {
		return nil
	}
	entry, ok := variantMap[defaultID]
	if !ok {
		return nil
	}
	set := make(map[string]bool, len(entry.OptionValueIDs))
	for _, id := range entry.OptionValueIDs {
		set[id] = true
	}
	return set
}

// pillActive picks which option pill is initially active: the default variant's
// value when this option group has one, otherwise the first pill.
func pillActive(val domain.ProductOptionValue, values []domain.ProductOptionValue, defaultIDs map[string]bool, i int) bool {
	if defaultIDs[val.ID.String()] {
		return true
	}
	for _, v := range values {
		if defaultIDs[v.ID.String()] {
			return false
		}
	}
	return i == 0
}

func maxDiscount(plans []domain.SubscriptionPlan) int {
	max := 0
	for _, p := range plans {
		if p.DiscountPct > max {
			max = p.DiscountPct
		}
	}
	return max
}

func variantMapJSON(m map[string]VariantOptionEntry) string {
	b, _ := json.Marshal(m)
	return string(b)
}

func optionPillClasses(selected bool) string {
	if selected {
		return "font-oswald font-bold text-[11px] text-paper bg-rust border-2 border-ink px-4 py-2 transition-colors"
	}
	return "font-oswald font-bold text-[11px] text-ink bg-cream-hi border-2 border-ink px-4 py-2 hover:bg-paper-warm transition-colors"
}

func subscriptionIntervalLabel(interval domain.SubscriptionInterval, count int) string {
	switch interval {
	case domain.SubscriptionIntervalEvery2Minutes:
		return "Every 2 Minutes"
	case domain.SubscriptionIntervalEvery7Days:
		return "Every Week"
	case domain.SubscriptionIntervalEvery14Days:
		return "Every 2 Weeks"
	case domain.SubscriptionIntervalEvery21Days:
		return "Every 3 Weeks"
	case domain.SubscriptionIntervalEvery30Days:
		return "Every Month"
	case domain.SubscriptionIntervalEvery60Days:
		return "Every 2 Months"
	case domain.SubscriptionIntervalEvery90Days:
		return "Every 3 Months"
	default:
		return string(interval)
	}
}

templ optionSelectionScript(variantMap map[string]VariantOptionEntry) {
	<script data-variant-map={ variantMapJSON(variantMap) }>
		(function() {
			var scriptEl = document.querySelector('script[data-variant-map]');
			var variantMap = JSON.parse(scriptEl.dataset.variantMap);
			var activeCls = 'option-pill font-oswald font-bold text-[11px] text-paper bg-rust border-2 border-ink px-4 py-2 transition-colors';
			var inactiveCls = 'option-pill font-oswald font-bold text-[11px] text-ink bg-cream-hi border-2 border-ink px-4 py-2 hover:bg-paper-warm transition-colors';

			// Handle option pill clicks
			document.querySelectorAll('.option-pill').forEach(function(btn) {
				btn.addEventListener('click', function() {
					var optionId = btn.dataset.optionId;
					document.querySelectorAll('.option-pill[data-option-id="' + optionId + '"]').forEach(function(b) {
						b.className = inactiveCls;
						b.setAttribute('aria-pressed', 'false');
					});
					btn.className = activeCls;
					btn.setAttribute('aria-pressed', 'true');
					resolveVariant();
				});
			});

			function resolveVariant() {
				var selected = [];
				document.querySelectorAll('div[data-option-id]').forEach(function(group) {
					var active = group.querySelector('.option-pill[aria-pressed="true"]');
					if (active) selected.push(active.dataset.valueId);
				});
				if (selected.length === 0) return;
				for (var vid in variantMap) {
					var entry = variantMap[vid];
					var ids = entry.optionValueIDs;
					if (ids.length === selected.length && selected.every(function(s) { return ids.indexOf(s) !== -1; })) {
						var input = document.getElementById('selected-variant-id');
						if (input) input.value = vid;
						if (entry.price !== null) {
							var display = document.getElementById('price-display');
							if (display) {
								display.innerHTML = '<span class="font-special text-ink text-2xl sm:text-3xl leading-none" data-base-price="' + entry.price + '">' + formatCents(entry.price) + '</span>';
							}
						}
						break;
					}
				}
			}

			function formatCents(cents) {
				return '$' + (cents / 100).toFixed(2);
			}
		})();
	</script>
}

templ purchaseModeScript() {
	<script>
		(function() {
			var mode = 'onetime';
			var variantID = document.getElementById('selected-variant-id');
			var qtyInput = document.getElementById('subscribe-quantity');
			var qtyMinus = document.getElementById('subscribe-qty-minus');
			var qtyPlus = document.getElementById('subscribe-qty-plus');

			var activeTabCls = 'purchase-mode-btn border-2 border-ink bg-paper-warm p-4 text-left transition-all';
			var inactiveTabCls = 'purchase-mode-btn border-2 border-ink bg-cream-hi p-4 text-left transition-all';

			// Mode toggle
			document.querySelectorAll('.purchase-mode-btn').forEach(function(btn) {
				btn.addEventListener('click', function() {
					mode = btn.dataset.mode;
					document.querySelectorAll('.purchase-mode-btn').forEach(function(b) {
						var isActive = b.dataset.mode === mode;
						b.setAttribute('aria-selected', String(isActive));
						b.className = isActive ? activeTabCls : inactiveTabCls;
						if (isActive) {
							b.style.boxShadow = 'var(--shadow-stamp-sm)';
						} else {
							b.style.boxShadow = '';
						}
					});
					var onetimeForm = document.getElementById('onetime-form');
					var subscribeForm = document.getElementById('subscribe-form');
					var subscribeOptions = document.getElementById('subscribe-options');
					if (mode === 'subscribe') {
						onetimeForm.classList.add('hidden');
						subscribeForm.classList.remove('hidden');
						subscribeOptions.classList.remove('hidden');
						updatePrice();
					} else {
						onetimeForm.classList.remove('hidden');
						subscribeForm.classList.add('hidden');
						subscribeOptions.classList.add('hidden');
						resetPrice();
					}
				});
			});

			// Quantity controls
			if (qtyMinus && qtyPlus && qtyInput) {
				qtyMinus.addEventListener('click', function() {
					var val = parseInt(qtyInput.value, 10) || 1;
					if (val > 1) {
						qtyInput.value = val - 1;
						onQuantityChange();
					}
				});
				qtyPlus.addEventListener('click', function() {
					var val = parseInt(qtyInput.value, 10) || 1;
					if (val < 10) {
						qtyInput.value = val + 1;
						onQuantityChange();
					}
				});
				qtyInput.addEventListener('change', function() {
					var val = parseInt(qtyInput.value, 10);
					if (isNaN(val) || val < 1) qtyInput.value = 1;
					else if (val > 10) qtyInput.value = 10;
					onQuantityChange();
				});
				qtyInput.addEventListener('input', function() {
					var val = parseInt(qtyInput.value, 10);
					if (!isNaN(val) && val >= 1 && val <= 10) {
						onQuantityChange();
					}
				});
			}

			function onQuantityChange() {
				updateQtyButtons();
				var checked = document.querySelector('.subscribe-frequency-option input:checked');
				if (checked) {
					var label = checked.closest('.subscribe-frequency-option');
					updateSubscribeLink(label.dataset.planId);
				}
				if (mode === 'subscribe') updatePrice();
			}

			function updateQtyButtons() {
				var val = parseInt(qtyInput.value, 10) || 1;
				if (qtyMinus) qtyMinus.disabled = val <= 1;
				if (qtyPlus) qtyPlus.disabled = val >= 10;
			}

			// Frequency selection
			document.querySelectorAll('.subscribe-frequency-option').forEach(function(label) {
				var radio = label.querySelector('input[type="radio"]');
				radio.addEventListener('change', function() {
					document.querySelectorAll('.subscribe-frequency-option').forEach(function(l) {
						l.classList.remove('border-ink', 'bg-paper-warm');
						l.classList.add('border-chrome-deep/40', 'bg-cream-hi');
						l.style.boxShadow = '';
					});
					label.classList.remove('border-chrome-deep/40', 'bg-cream-hi');
					label.classList.add('border-ink', 'bg-paper-warm');
					label.style.boxShadow = 'var(--shadow-stamp-sm)';
					updateSubscribeLink(label.dataset.planId);
					updatePrice();
				});
			});

			function getQuantity() {
				return parseInt(qtyInput ? qtyInput.value : '1', 10) || 1;
			}

			var selectedPlanId = '';
			function updateSubscribeLink(planId) {
				selectedPlanId = planId;
			}

			var subscribeBtn = document.getElementById('subscribe-action');
			if (subscribeBtn) {
				subscribeBtn.addEventListener('click', function() {
					var vid = variantID ? variantID.value : '';
					var qty = getQuantity();
					var pid = selectedPlanId;
					if (!pid) {
						var checked = document.querySelector('.subscribe-frequency-option input:checked');
						if (checked) pid = checked.closest('.subscribe-frequency-option').dataset.planId;
					}
					if (pid) window.location.href = '/subscribe?plan_id=' + pid + '&variant_id=' + vid + '&quantity=' + qty;
				});
			}

			function updatePrice() {
				var priceEl = document.querySelector('[data-base-price]');
				if (!priceEl) return;
				var baseCents = parseInt(priceEl.dataset.basePrice, 10);
				var qty = getQuantity();
				var checked = document.querySelector('.subscribe-frequency-option input:checked');
				if (!checked) return;
				var label = checked.closest('.subscribe-frequency-option');
				var discount = parseInt(label.dataset.discount, 10) || 0;
				var unitCents = Math.round(baseCents * (100 - discount) / 100);
				var totalCents = unitCents * qty;
				var display = document.getElementById('price-display');
				var qtyPrefix = qty > 1 ? qty + ' × ' : '';
				if (discount > 0) {
					display.innerHTML = '<span class="font-special text-chrome-deep text-lg line-through">' + formatCents(baseCents) + '</span>' +
						' <span class="font-special text-rust text-2xl sm:text-3xl leading-none">' + qtyPrefix + formatCents(totalCents) + '</span>';
				} else {
					display.innerHTML = '<span class="font-special text-ink text-2xl sm:text-3xl leading-none">' + qtyPrefix + formatCents(totalCents) + '</span>';
				}
			}

			function resetPrice() {
				var priceEl = document.querySelector('[data-base-price]');
				if (!priceEl) return;
				var baseCents = parseInt(priceEl.dataset.basePrice, 10);
				var display = document.getElementById('price-display');
				display.innerHTML = '<span class="font-special text-ink text-2xl sm:text-3xl leading-none" data-base-price="' + baseCents + '">' + formatCents(baseCents) + '</span>';
			}

			function formatCents(cents) {
				return '$' + (cents / 100).toFixed(2);
			}

			// Auto-activate subscribe mode if ?mode=subscribe is present
			var params = new URLSearchParams(window.location.search);
			if (params.get('mode') === 'subscribe') {
				var subscribeTab = document.querySelector('.purchase-mode-btn[data-mode="subscribe"]');
				if (subscribeTab) subscribeTab.click();
			}

			updateQtyButtons();
		})();
	</script>
}

// productJSONLDScript returns <script type="application/ld+json"> tags with
// Product and BreadcrumbList structured data.
func productJSONLDScript(props ProductDetailProps) string {
	productURL := props.BaseURL + "/catalog/" + props.Product.Slug
	product := map[string]any{
		"@context":    "https://schema.org",
		"@type":       "Product",
		"name":        props.Product.Title,
		"description": props.Product.Description,
		"url":         productURL,
		"brand": map[string]any{
			"@type": "Brand",
			"name":  "Rockabilly Roasting Co.",
		},
	}

	if len(props.Media) > 0 && props.MediaConfig != nil {
		product["image"] = props.MediaConfig.ProductImageURL(props.Media[0].R2Key, media.VariantPublic)
	}

	if props.DefaultPrice != nil {
		offer := map[string]any{
			"@type":         "Offer",
			"price":         fmt.Sprintf("%.2f", float64(*props.DefaultPrice)/100),
			"priceCurrency": props.CurrencyCode,
			"availability":  "https://schema.org/InStock",
			"url":           productURL,
		}
		if props.DefaultSKU != "" {
			offer["sku"] = props.DefaultSKU
			product["sku"] = props.DefaultSKU
		}
		product["offers"] = offer
	}

	breadcrumb := map[string]any{
		"@context": "https://schema.org",
		"@type":    "BreadcrumbList",
		"itemListElement": []map[string]any{
			{"@type": "ListItem", "position": 1, "name": "Shop", "item": props.BaseURL + "/catalog"},
			{"@type": "ListItem", "position": 2, "name": props.Product.Title, "item": productURL},
		},
	}

	productJSON, _ := json.Marshal(product)
	breadcrumbJSON, _ := json.Marshal(breadcrumb)
	return `<script type="application/ld+json">` + string(productJSON) + `</script>` +
		`<script type="application/ld+json">` + string(breadcrumbJSON) + `</script>`
}

templ ProductPage(props ProductDetailProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:        props.Product.Title,
		Description:  props.Product.Description,
		CartCount:    props.CartCount,
		CanonicalURL: props.CanonicalURL,
		OGImage:      props.OGImage,
		OGType:       "product",
	}) {
		@ProductContent(props)
		@templ.Raw(productJSONLDScript(props))
	}
}
