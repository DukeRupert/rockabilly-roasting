package storefront

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type OptionWithValues struct {
	Option domain.ProductOption
	Values []domain.ProductOptionValue
}

type VariantWithPrice struct {
	Variant      domain.Variant
	BasePrice    *int
	CurrencyCode string
}

type ProductDetailProps struct {
	Product           *domain.Product
	Media             []domain.ProductMedia
	Variants          []VariantWithPrice
	Options           []OptionWithValues
	DefaultPrice      *int
	CurrencyCode      string
	CartCount         int
	SubscriptionPlans []domain.SubscriptionPlan
}

templ ProductContent(props ProductDetailProps) {
	<div>
		<!-- Breadcrumb -->
		<nav class="mb-8">
			<ol class="flex items-center gap-2 text-sm text-hiri-text-secondary">
				<li><a href="/catalog" class="hover:text-hiri-teal">Shop</a></li>
				<li><span class="mx-1">/</span></li>
				<li class="text-hiri-text">{ props.Product.Title }</li>
			</ol>
		</nav>
		<!-- Product layout: 2 columns -->
		<div class="lg:grid lg:grid-cols-2 lg:gap-x-12">
			<!-- Image gallery -->
			<div>
				if len(props.Media) > 0 {
					<!-- Main image -->
					<div class="aspect-square w-full overflow-hidden rounded-lg bg-stone-100">
						<img
							src={ props.Media[0].URL }
							alt={ props.Media[0].AltText }
							class="h-full w-full object-cover object-center"
						/>
					</div>
					<!-- Thumbnails -->
					if len(props.Media) > 1 {
						<div class="mt-4 grid grid-cols-4 gap-4">
							for _, m := range props.Media {
								<div class="aspect-square overflow-hidden rounded-lg bg-stone-100">
									<img
										src={ m.URL }
										alt={ m.AltText }
										class="h-full w-full object-cover object-center"
									/>
								</div>
							}
						</div>
					}
				} else {
					<div class="aspect-square w-full overflow-hidden rounded-lg bg-stone-100 flex items-center justify-center">
						<svg class="size-24 text-stone-300" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"></path>
						</svg>
					</div>
				}
			</div>
			<!-- Product info -->
			<div class="mt-8 lg:mt-0">
				<h1 class="text-3xl font-bold tracking-tight text-hiri-text">{ props.Product.Title }</h1>
				<!-- Price display -->
				if props.DefaultPrice != nil {
					<div class="mt-3" id="price-display">
						<span class="text-2xl font-semibold text-hiri-text" data-base-price={ fmt.Sprintf("%d", *props.DefaultPrice) }>{ formatCents(*props.DefaultPrice) }</span>
					</div>
				}
				<!-- Description -->
				if props.Product.Description != "" {
					<div class="mt-6">
						<p class="text-base text-hiri-text-secondary">{ props.Product.Description }</p>
					</div>
				}
				<!-- Options -->
				if len(props.Options) > 0 {
					<div class="mt-8 space-y-6">
						for _, opt := range props.Options {
							<div>
								<h3 class="text-sm font-medium text-hiri-text">{ opt.Option.Name }</h3>
								<div class="mt-2 flex flex-wrap gap-2">
									for i, val := range opt.Values {
										<button
											type="button"
											class={ optionPillClasses(i == 0) }
										>
											{ val.Value }
										</button>
									}
								</div>
							</div>
						}
					</div>
				}
				if len(props.Variants) > 0 {
					<!-- Purchase mode selector -->
					<div class="mt-8" id="purchase-section">
						if len(props.SubscriptionPlans) > 0 {
							<!-- Mode toggle tabs -->
							<div class="grid grid-cols-2 gap-3" id="purchase-mode-toggle">
								<button
									type="button"
									data-mode="onetime"
									class="purchase-mode-btn relative rounded-lg border-2 border-hiri-teal bg-hiri-teal/5 p-4 text-left transition-colors"
								>
									<span class="block text-sm font-semibold text-hiri-text">One-Time Purchase</span>
								</button>
								<button
									type="button"
									data-mode="subscribe"
									class="purchase-mode-btn relative rounded-lg border-2 border-hiri-border bg-white p-4 text-left transition-colors"
								>
									<span class="block text-sm font-semibold text-hiri-text">Subscribe &amp; Save</span>
									<span class="block text-xs text-hiri-teal font-medium mt-0.5">
										{ fmt.Sprintf("Save up to %d%%", maxDiscount(props.SubscriptionPlans)) }
									</span>
								</button>
							</div>
							<!-- Subscription frequency options (hidden by default) -->
							<div id="subscribe-options" class="hidden mt-4">
								<p class="text-sm font-medium text-hiri-text mb-3">Delivery every</p>
								<div class="space-y-2">
									for i, plan := range props.SubscriptionPlans {
										<label
											class={ "subscribe-frequency-option flex items-center justify-between rounded-lg border p-3 cursor-pointer transition-colors",
												templ.KV("border-hiri-teal bg-hiri-teal/5", i == 0),
												templ.KV("border-hiri-border hover:border-stone-300", i != 0) }
											data-plan-id={ plan.ID.String() }
											data-discount={ fmt.Sprintf("%d", plan.DiscountPct) }
										>
											<div class="flex items-center gap-3">
												<input
													type="radio"
													name="plan_id"
													value={ plan.ID.String() }
													if i == 0 {
														checked
													}
													class="size-4 border-stone-300 text-hiri-teal focus:ring-hiri-teal"
												/>
												<span class="text-sm text-hiri-text">{ subscriptionIntervalLabel(plan.Interval, plan.IntervalCount) }</span>
											</div>
											if plan.DiscountPct > 0 {
												<span class="inline-flex items-center rounded-md bg-hiri-teal/10 px-2 py-0.5 text-xs font-medium text-hiri-teal">
													{ fmt.Sprintf("Save %d%%", plan.DiscountPct) }
												</span>
											}
										</label>
									}
								</div>
							</div>
						}
						<!-- One-time purchase form -->
						<div id="onetime-form" class="mt-4">
							<form
								method="post"
								action="/cart/add"
								hx-post="/cart/add"
								hx-swap="none"
							>
								<input type="hidden" name="variant_id" id="selected-variant-id" value={ defaultVariantID(props.Variants) }/>
								<input type="hidden" name="quantity" value="1"/>
								<button
									type="submit"
									class="w-full rounded-md bg-hiri-teal px-6 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-hiri-teal-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-hiri-teal"
								>
									Add to Cart
								</button>
							</form>
						</div>
						<!-- Subscribe form (hidden by default) -->
						if len(props.SubscriptionPlans) > 0 {
							<div id="subscribe-form" class="hidden mt-4">
								<!-- Quantity selector -->
								<div class="mb-4">
									<label for="subscribe-quantity" class="text-sm font-medium text-hiri-text">Quantity</label>
									<div class="mt-1 flex items-center gap-2">
										<button
											type="button"
											id="subscribe-qty-minus"
											class="flex size-9 items-center justify-center rounded-md border border-stone-300 text-stone-600 hover:bg-stone-50 disabled:opacity-40"
										>
											&minus;
										</button>
										<input
											type="number"
											id="subscribe-quantity"
											value="1"
											min="1"
											max="10"
											class="w-14 rounded-md border border-stone-300 px-2 py-1.5 text-center text-sm font-medium text-hiri-text focus:border-hiri-teal focus:ring-1 focus:ring-hiri-teal [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
										/>
										<button
											type="button"
											id="subscribe-qty-plus"
											class="flex size-9 items-center justify-center rounded-md border border-stone-300 text-stone-600 hover:bg-stone-50 disabled:opacity-40"
										>
											+
										</button>
									</div>
								</div>
								<button
									type="button"
									id="subscribe-action"
									class="block w-full rounded-md bg-hiri-teal px-6 py-3.5 text-center text-base font-semibold text-white shadow-sm hover:bg-hiri-teal-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-hiri-teal"
								>
									Subscribe
								</button>
								<p class="mt-2 text-center text-xs text-hiri-text-secondary">Cancel or modify anytime from your account.</p>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</div>
	if len(props.SubscriptionPlans) > 0 && len(props.Variants) > 0 {
		@purchaseModeScript()
	}
}

func defaultVariantID(variants []VariantWithPrice) string {
	for _, v := range variants {
		if v.Variant.IsDefault {
			return v.Variant.ID.String()
		}
	}
	if len(variants) > 0 {
		return variants[0].Variant.ID.String()
	}
	return ""
}

func maxDiscount(plans []domain.SubscriptionPlan) int {
	max := 0
	for _, p := range plans {
		if p.DiscountPct > max {
			max = p.DiscountPct
		}
	}
	return max
}

func optionPillClasses(selected bool) string {
	if selected {
		return "rounded-full border-2 border-hiri-teal bg-hiri-teal/5 px-4 py-2 text-sm font-medium text-hiri-teal"
	}
	return "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:border-hiri-teal hover:text-hiri-teal"
}

func subscriptionIntervalLabel(interval domain.SubscriptionInterval, count int) string {
	switch interval {
	case domain.SubscriptionIntervalEvery2Minutes:
		return "Every 2 Minutes"
	case domain.SubscriptionIntervalEvery14Days:
		return "Every 14 Days"
	case domain.SubscriptionIntervalEvery21Days:
		return "Every 21 Days"
	case domain.SubscriptionIntervalEvery30Days:
		return "Every 30 Days"
	case domain.SubscriptionIntervalEvery60Days:
		return "Every 60 Days"
	default:
		return string(interval)
	}
}

templ purchaseModeScript() {
	<script>
		(function() {
			var mode = 'onetime';
			var variantID = document.getElementById('selected-variant-id');
			var qtyInput = document.getElementById('subscribe-quantity');
			var qtyMinus = document.getElementById('subscribe-qty-minus');
			var qtyPlus = document.getElementById('subscribe-qty-plus');

			// Mode toggle
			document.querySelectorAll('.purchase-mode-btn').forEach(function(btn) {
				btn.addEventListener('click', function() {
					mode = btn.dataset.mode;
					// Update tab styles
					document.querySelectorAll('.purchase-mode-btn').forEach(function(b) {
						if (b.dataset.mode === mode) {
							b.className = 'purchase-mode-btn relative rounded-lg border-2 border-hiri-teal bg-hiri-teal/5 p-4 text-left transition-colors';
						} else {
							b.className = 'purchase-mode-btn relative rounded-lg border-2 border-hiri-border bg-white p-4 text-left transition-colors';
						}
					});
					// Toggle form visibility
					var onetimeForm = document.getElementById('onetime-form');
					var subscribeForm = document.getElementById('subscribe-form');
					var subscribeOptions = document.getElementById('subscribe-options');
					if (mode === 'subscribe') {
						onetimeForm.classList.add('hidden');
						subscribeForm.classList.remove('hidden');
						subscribeOptions.classList.remove('hidden');
						updatePrice();
					} else {
						onetimeForm.classList.remove('hidden');
						subscribeForm.classList.add('hidden');
						subscribeOptions.classList.add('hidden');
						resetPrice();
					}
				});
			});

			// Quantity controls
			if (qtyMinus && qtyPlus && qtyInput) {
				qtyMinus.addEventListener('click', function() {
					var val = parseInt(qtyInput.value, 10) || 1;
					if (val > 1) {
						qtyInput.value = val - 1;
						onQuantityChange();
					}
				});
				qtyPlus.addEventListener('click', function() {
					var val = parseInt(qtyInput.value, 10) || 1;
					if (val < 10) {
						qtyInput.value = val + 1;
						onQuantityChange();
					}
				});
				qtyInput.addEventListener('change', function() {
					var val = parseInt(qtyInput.value, 10);
					if (isNaN(val) || val < 1) qtyInput.value = 1;
					else if (val > 10) qtyInput.value = 10;
					onQuantityChange();
				});
				qtyInput.addEventListener('input', function() {
					var val = parseInt(qtyInput.value, 10);
					if (!isNaN(val) && val >= 1 && val <= 10) {
						onQuantityChange();
					}
				});
			}

			function onQuantityChange() {
				updateQtyButtons();
				var checked = document.querySelector('.subscribe-frequency-option input:checked');
				if (checked) {
					var label = checked.closest('.subscribe-frequency-option');
					updateSubscribeLink(label.dataset.planId);
				}
				if (mode === 'subscribe') updatePrice();
			}

			function updateQtyButtons() {
				var val = parseInt(qtyInput.value, 10) || 1;
				if (qtyMinus) qtyMinus.disabled = val <= 1;
				if (qtyPlus) qtyPlus.disabled = val >= 10;
			}

			// Frequency selection
			document.querySelectorAll('.subscribe-frequency-option').forEach(function(label) {
				var radio = label.querySelector('input[type="radio"]');
				radio.addEventListener('change', function() {
					// Update selected styles
					document.querySelectorAll('.subscribe-frequency-option').forEach(function(l) {
						l.classList.remove('border-hiri-teal', 'bg-hiri-teal/5');
						l.classList.add('border-hiri-border');
					});
					label.classList.remove('border-hiri-border');
					label.classList.add('border-hiri-teal', 'bg-hiri-teal/5');
					// Update subscribe link
					updateSubscribeLink(label.dataset.planId);
					updatePrice();
				});
			});

			function getQuantity() {
				return parseInt(qtyInput ? qtyInput.value : '1', 10) || 1;
			}

			var selectedPlanId = '';
			function updateSubscribeLink(planId) {
				selectedPlanId = planId;
			}

			// Navigate on subscribe button click
			var subscribeBtn = document.getElementById('subscribe-action');
			if (subscribeBtn) {
				subscribeBtn.addEventListener('click', function() {
					var vid = variantID ? variantID.value : '';
					var qty = getQuantity();
					var pid = selectedPlanId;
					if (!pid) {
						var checked = document.querySelector('.subscribe-frequency-option input:checked');
						if (checked) pid = checked.closest('.subscribe-frequency-option').dataset.planId;
					}
					if (pid) window.location.href = '/subscribe?plan_id=' + pid + '&variant_id=' + vid + '&quantity=' + qty;
				});
			}

			function updatePrice() {
				var priceEl = document.querySelector('[data-base-price]');
				if (!priceEl) return;
				var baseCents = parseInt(priceEl.dataset.basePrice, 10);
				var qty = getQuantity();
				var checked = document.querySelector('.subscribe-frequency-option input:checked');
				if (!checked) return;
				var label = checked.closest('.subscribe-frequency-option');
				var discount = parseInt(label.dataset.discount, 10) || 0;
				var unitCents = Math.round(baseCents * (100 - discount) / 100);
				var totalCents = unitCents * qty;
				var display = document.getElementById('price-display');
				var qtyPrefix = qty > 1 ? qty + ' × ' : '';
				if (discount > 0) {
					display.innerHTML = '<span class="text-lg text-hiri-text-secondary line-through">' + formatCents(baseCents) + '</span>' +
						' <span class="text-2xl font-semibold text-hiri-teal">' + qtyPrefix + formatCents(totalCents) + '</span>';
				} else {
					display.innerHTML = '<span class="text-2xl font-semibold text-hiri-text">' + qtyPrefix + formatCents(totalCents) + '</span>';
				}
			}

			function resetPrice() {
				var priceEl = document.querySelector('[data-base-price]');
				if (!priceEl) return;
				var baseCents = parseInt(priceEl.dataset.basePrice, 10);
				var display = document.getElementById('price-display');
				display.innerHTML = '<span class="text-2xl font-semibold text-hiri-text" data-base-price="' + baseCents + '">' + formatCents(baseCents) + '</span>';
			}

			function formatCents(cents) {
				return '$' + (cents / 100).toFixed(2);
			}

			// Initialize button states
			updateQtyButtons();
		})();
	</script>
}

templ ProductPage(props ProductDetailProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       props.Product.Title,
		Description: props.Product.Description,
		CartCount:   props.CartCount,
	}) {
		@ProductContent(props)
	}
}
