package storefront

import (
	"encoding/json"
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/platform/media"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type OptionWithValues struct {
	Option domain.ProductOption
	Values []domain.ProductOptionValue
}

type VariantWithPrice struct {
	Variant      domain.Variant
	BasePrice    *int
	CurrencyCode string
}

// VariantOptionEntry maps a variant to its option value IDs and price for JS variant resolution.
type VariantOptionEntry struct {
	OptionValueIDs []string `json:"optionValueIDs"`
	Price          *int     `json:"price"`
}

type ProductDetailProps struct {
	Product           *domain.Product
	Media             []domain.ProductMedia
	MediaConfig       *media.Config
	Variants          []VariantWithPrice
	Options           []OptionWithValues
	VariantMap        map[string]VariantOptionEntry // variantID -> option value IDs + price
	DefaultPrice      *int
	CurrencyCode      string
	CartCount         int
	SubscriptionPlans []domain.SubscriptionPlan
	Coffee            *CoffeeAttrs // nil if not a coffee product
}

templ ProductContent(props ProductDetailProps) {
	<div>
		<!-- Breadcrumb -->
		<nav class="mb-6">
			<ol class="flex items-center gap-2 font-body text-sm text-rr-muted">
				<li><a href="/catalog" class="hover:text-rr-heading transition-colors">Shop</a></li>
				<li><span class="text-rr-border">&rsaquo;</span></li>
				<li class="text-rr-heading font-medium">{ props.Product.Title }</li>
			</ol>
		</nav>
		<!-- Product layout: info-first, image-second (BRCC style) -->
		<div class="lg:grid lg:grid-cols-2 lg:gap-x-12">
			<!-- LEFT: Product info + actions (above the fold) -->
			<div class="lg:max-w-lg">
				<h1 class="font-display text-4xl tracking-widest text-rr-heading sm:text-5xl">{ props.Product.Title }</h1>
				<!-- Origin + roast level (above price for prestige signal) -->
				if props.Coffee != nil && (originLine(props.Coffee) != "" || validRoastLevel(props.Coffee.RoastLevel)) {
					<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
						if originLine(props.Coffee) != "" {
							<span class="label-font text-rr-muted text-xs">{ originLine(props.Coffee) }</span>
						}
						if validRoastLevel(props.Coffee.RoastLevel) {
							<div class="flex items-center gap-1.5">
								@roastDots(props.Coffee.RoastLevel, "large")
								<span class="label-font text-rr-faint text-xs">{ roastLevelLabel(props.Coffee.RoastLevel) }</span>
							</div>
						}
					</div>
				}
				<!-- Price — big and bold -->
				if props.DefaultPrice != nil {
					<div class="mt-3" id="price-display">
						<span class="font-heading text-3xl text-rr-heading" data-base-price={ fmt.Sprintf("%d", *props.DefaultPrice) }>{ formatCents(*props.DefaultPrice) }</span>
					</div>
				}
				<!-- Tasting notes as tag pills -->
				if props.Coffee != nil && len(props.Coffee.TastingNotes) > 0 {
					<div class="mt-3 flex flex-wrap gap-1.5">
						for _, note := range props.Coffee.TastingNotes {
							<span class="label-font px-2 py-0.5 rounded-sm text-rr-amber border border-rr-amber/30 bg-rr-amber/5 text-[0.6rem]">
								{ note }
							</span>
						}
					</div>
				}
				<!-- Description -->
				if props.Product.Description != "" {
					<p class="mt-4 font-body text-sm text-rr-muted leading-relaxed">{ props.Product.Description }</p>
				}
				<!-- Variant options (grind, size, etc.) as button pills -->
				if len(props.Options) > 0 {
					<div class="mt-6 space-y-5">
						for _, opt := range props.Options {
							<div>
								<label class="label-font text-rr-muted mb-2 block">{ opt.Option.Name }</label>
								<div class="flex flex-wrap gap-2" data-option-id={ opt.Option.ID.String() }>
									for i, val := range opt.Values {
										<button
											type="button"
											class={ "option-pill " + optionPillClasses(i == 0) }
											data-option-id={ opt.Option.ID.String() }
											data-value-id={ val.ID.String() }
										>
											{ val.Value }
										</button>
									}
								</div>
							</div>
						}
					</div>
				}
				if len(props.Variants) > 0 {
					<!-- Purchase mode selector -->
					<div class="mt-6" id="purchase-section">
						if len(props.SubscriptionPlans) > 0 {
							<!-- Mode toggle — two bold tabs -->
							<div class="grid grid-cols-2 gap-3" id="purchase-mode-toggle">
								<button
									type="button"
									data-mode="onetime"
									class="purchase-mode-btn relative rounded-sm border-2 border-rr-amber bg-rr-amber/5 p-3 text-left transition-colors"
								>
									<span class="block label-font text-rr-heading">ONE-TIME</span>
								</button>
								<button
									type="button"
									data-mode="subscribe"
									class="purchase-mode-btn relative rounded-sm border-2 border-rr-border bg-rr-surface p-3 text-left transition-colors"
								>
									<span class="block label-font text-rr-heading">SUBSCRIBE</span>
									<span class="block font-body text-xs text-rr-amber font-semibold mt-0.5">
										{ fmt.Sprintf("Save up to %d%%", maxDiscount(props.SubscriptionPlans)) }
									</span>
								</button>
							</div>
							<!-- Subscription frequency options (hidden by default) -->
							<div id="subscribe-options" class="hidden mt-4">
								<p class="label-font text-rr-muted mb-2">DELIVERY EVERY</p>
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
									for i, plan := range props.SubscriptionPlans {
										<label
											class={ "subscribe-frequency-option flex items-center justify-between rounded-sm border p-3 cursor-pointer transition-colors",
												templ.KV("border-rr-amber bg-rr-amber/5", i == 0),
												templ.KV("border-rr-border hover:border-rr-amber", i != 0) }
											data-plan-id={ plan.ID.String() }
											data-discount={ fmt.Sprintf("%d", plan.DiscountPct) }
										>
											<div class="flex items-center gap-3">
												<input
													type="radio"
													name="plan_id"
													value={ plan.ID.String() }
													if i == 0 {
														checked
													}
													class="size-4 border-rr-border text-rr-amber focus:ring-rr-amber"
												/>
												<span class="font-body text-sm text-rr-heading">{ subscriptionIntervalLabel(plan.Interval, plan.IntervalCount) }</span>
											</div>
											if plan.DiscountPct > 0 {
												<span class="label-font px-2 py-0.5 rounded-sm text-rr-amber border border-rr-amber bg-rr-amber/5">
													{ fmt.Sprintf("SAVE %d%%", plan.DiscountPct) }
												</span>
											}
										</label>
									}
								</div>
							</div>
						}
						<!-- One-time purchase form — BOLD CTA -->
						<div id="onetime-form" class="mt-5">
							<form
								method="post"
								action="/cart/add"
								hx-post="/cart/add"
								hx-swap="none"
							>
								<input type="hidden" name="variant_id" id="selected-variant-id" value={ defaultVariantID(props.Variants) }/>
								<input type="hidden" name="quantity" value="1"/>
								<button
									type="submit"
									class="btn w-full rounded-sm bg-rr-red px-6 py-4 label-font text-white text-sm glow-red hover:bg-rr-red-lt transition-colors"
								>
									ADD TO CART
								</button>
							</form>
						</div>
						<!-- Subscribe form (hidden by default) -->
						if len(props.SubscriptionPlans) > 0 {
							<div id="subscribe-form" class="hidden mt-5">
								<!-- Quantity selector -->
								<div class="mb-4">
									<label for="subscribe-quantity" class="label-font text-rr-muted mb-2 block">QUANTITY</label>
									<div class="flex">
										<button
											type="button"
											id="subscribe-qty-minus"
											class="btn bg-rr-raised border border-rr-border text-rr-heading font-bold px-4 py-2 rounded-l-sm text-lg leading-none border-r-0 transition-colors hover:bg-rr-red hover:text-white"
										>
											&minus;
										</button>
										<input
											type="number"
											id="subscribe-quantity"
											value="1"
											min="1"
											max="10"
											class="rr-input w-14 border-y border-rr-border text-rr-heading font-body text-sm text-center py-2 bg-rr-bg [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
										/>
										<button
											type="button"
											id="subscribe-qty-plus"
											class="btn bg-rr-raised border border-rr-border text-rr-heading font-bold px-4 py-2 rounded-r-sm text-lg leading-none border-l-0 transition-colors hover:bg-rr-red hover:text-white"
										>
											+
										</button>
									</div>
								</div>
								<button
									type="button"
									id="subscribe-action"
									class="btn block w-full rounded-sm bg-rr-red px-6 py-4 text-center label-font text-white text-sm glow-red hover:bg-rr-red-lt transition-colors"
								>
									SUBSCRIBE &amp; SAVE
								</button>
								<p class="mt-2 text-center font-body text-xs text-rr-muted">Cancel or modify anytime from your account.</p>
							</div>
						}
					</div>
				}
				<!-- In stock indicator -->
				<div class="mt-4 flex items-center gap-2">
					<svg class="size-4 text-rr-amber" viewBox="0 0 20 20" fill="currentColor">
						<path d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" fill-rule="evenodd"></path>
					</svg>
					<p class="font-body text-sm text-rr-muted">In stock and ready to ship</p>
				</div>
			</div>
			<!-- RIGHT: Product image (secondary, smaller) -->
			<div class="mt-8 lg:mt-0 lg:row-span-2">
				if len(props.Media) > 0 {
					<!-- Main image — contained, not dominant -->
					<div class="aspect-square w-full overflow-hidden rounded-sm bg-rr-bg border border-rr-border">
						<img
							src={ props.MediaConfig.ProductImageURL(props.Media[0].R2Key, media.VariantHero) }
							alt={ props.Media[0].AltText }
							class="h-full w-full object-cover object-center"
						/>
					</div>
					<!-- Thumbnails -->
					if len(props.Media) > 1 {
						<div class="mt-3 grid grid-cols-4 gap-3">
							for _, m := range props.Media {
								<div class="aspect-square overflow-hidden rounded-sm bg-rr-bg border border-rr-border cursor-pointer hover:border-rr-amber transition-colors">
									<img
										src={ props.MediaConfig.ProductImageURL(m.R2Key, media.VariantThumbnail) }
										alt={ m.AltText }
										class="h-full w-full object-cover object-center"
									/>
								</div>
							}
						</div>
					}
				} else {
					<div class="aspect-square w-full overflow-hidden rounded-sm bg-rr-bg border border-rr-border relative">
						<div class="texture-dots absolute inset-0"></div>
						<div class="flex h-full w-full items-center justify-center relative">
							<div class="w-24 h-24 rounded-full border-2 border-rr-border bg-rr-surface flex items-center justify-center">
								<span class="font-display text-rr-muted text-2xl tracking-widest">
									{ string([]rune(props.Product.Title)[0:2]) }
								</span>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
	<!-- Tasting profile — full-width section below product layout -->
	if props.Coffee != nil && hasTastingProfile(props.Coffee) {
		@tastingProfile(props.Coffee)
	}
	if len(props.Options) > 0 && len(props.VariantMap) > 0 {
		@optionSelectionScript(props.VariantMap)
	}
	if len(props.SubscriptionPlans) > 0 && len(props.Variants) > 0 {
		@purchaseModeScript()
	}
}

templ tastingProfile(attrs *CoffeeAttrs) {
	<section class="mt-12 pt-10 border-t border-rr-border">
		<h2 class="font-display text-2xl tracking-widest text-rr-heading mb-6">TASTING PROFILE</h2>
		<!-- Adapt grid: two columns if both sides have data, single column otherwise -->
		<div class={ "grid grid-cols-1 gap-8", templ.KV("lg:grid-cols-2", hasFlavorScales(attrs) && hasProfileDetails(attrs)) }>
			if hasFlavorScales(attrs) {
				<div class="space-y-5">
					if attrs.Body != "" {
						@flavorScale("Body", attrs.Body)
					}
					if attrs.Acidity != "" {
						@flavorScale("Acidity", attrs.Acidity)
					}
					if attrs.Sweetness != "" {
						@flavorScale("Sweetness", attrs.Sweetness)
					}
				</div>
			}
			if hasProfileDetails(attrs) {
				<div class="space-y-5">
					if attrs.Process != "" {
						<div>
							<p class="label-font text-rr-faint text-xs mb-1">PROCESS</p>
							<p class="font-body text-sm text-rr-heading capitalize">{ attrs.Process }</p>
						</div>
					}
					if attrs.Finish != "" {
						<div>
							<p class="label-font text-rr-faint text-xs mb-1">FINISH</p>
							<p class="font-serif text-sm text-rr-body italic">{ attrs.Finish }</p>
						</div>
					}
					if len(attrs.BrewMethods) > 0 {
						<div>
							<p class="label-font text-rr-faint text-xs mb-2">BEST BREWED AS</p>
							<div class="flex flex-wrap gap-1.5">
								for _, method := range attrs.BrewMethods {
									<span class="label-font px-2.5 py-1 rounded-sm text-rr-muted border border-rr-border bg-rr-surface text-[0.6rem]">
										{ formatBrewMethod(method) }
									</span>
								}
							</div>
						</div>
					}
					if len(attrs.Certifications) > 0 || attrs.IsSeasonal {
						<div class="flex flex-wrap gap-1.5">
							for _, cert := range attrs.Certifications {
								<span class="label-font px-2 py-0.5 rounded-sm text-rr-teal border border-rr-teal/30 bg-rr-teal/5 text-[0.6rem]">
									{ formatCertification(cert) }
								</span>
							}
							if attrs.IsSeasonal {
								<span class="label-font px-2 py-0.5 rounded-sm text-rr-amber border border-rr-amber/30 bg-rr-amber/5 text-[0.6rem]">
									SEASONAL
								</span>
							}
						</div>
					}
				</div>
			}
		</div>
	</section>
}

// flavorScale renders a labeled 3-dot scale (low / medium / high).
templ flavorScale(label string, value string) {
	<div class="flex items-center justify-between">
		<p class="label-font text-rr-faint text-xs w-24">{ label }</p>
		<div class="flex items-center gap-4 flex-1">
			<div class="flex items-center gap-1.5">
				for i := 1; i <= 3; i++ {
					if i <= scaleLevel(value) {
						<span class="size-2.5 rounded-full bg-rr-amber"></span>
					} else {
						<span class="size-2.5 rounded-full bg-rr-border"></span>
					}
				}
			</div>
			<span class="font-body text-xs text-rr-muted capitalize">{ value }</span>
		</div>
	</div>
}

func defaultVariantID(variants []VariantWithPrice) string {
	for _, v := range variants {
		if v.Variant.IsDefault {
			return v.Variant.ID.String()
		}
	}
	if len(variants) > 0 {
		return variants[0].Variant.ID.String()
	}
	return ""
}

func maxDiscount(plans []domain.SubscriptionPlan) int {
	max := 0
	for _, p := range plans {
		if p.DiscountPct > max {
			max = p.DiscountPct
		}
	}
	return max
}

func variantMapJSON(m map[string]VariantOptionEntry) string {
	b, _ := json.Marshal(m)
	return string(b)
}

func optionPillClasses(selected bool) string {
	if selected {
		return "label-font border-2 border-rr-amber bg-rr-amber/5 px-4 py-2 rounded-sm text-rr-amber"
	}
	return "label-font border border-rr-border px-4 py-2 rounded-sm text-rr-muted hover:border-rr-amber hover:text-rr-heading transition-colors"
}

func subscriptionIntervalLabel(interval domain.SubscriptionInterval, count int) string {
	switch interval {
	case domain.SubscriptionIntervalEvery2Minutes:
		return "Every 2 Minutes"
	case domain.SubscriptionIntervalEvery7Days:
		return "Every Week"
	case domain.SubscriptionIntervalEvery14Days:
		return "Every 2 Weeks"
	case domain.SubscriptionIntervalEvery21Days:
		return "Every 3 Weeks"
	case domain.SubscriptionIntervalEvery30Days:
		return "Every Month"
	case domain.SubscriptionIntervalEvery60Days:
		return "Every 2 Months"
	case domain.SubscriptionIntervalEvery90Days:
		return "Every 3 Months"
	default:
		return string(interval)
	}
}

templ optionSelectionScript(variantMap map[string]VariantOptionEntry) {
	<script data-variant-map={ variantMapJSON(variantMap) }>
		(function() {
			var scriptEl = document.querySelector('script[data-variant-map]');
			var variantMap = JSON.parse(scriptEl.dataset.variantMap);
			var activeCls = 'option-pill label-font border-2 border-rr-amber bg-rr-amber/5 px-4 py-2 rounded-sm text-rr-amber';
			var inactiveCls = 'option-pill label-font border border-rr-border px-4 py-2 rounded-sm text-rr-muted hover:border-rr-amber hover:text-rr-heading transition-colors';

			// Handle option pill clicks
			document.querySelectorAll('.option-pill').forEach(function(btn) {
				btn.addEventListener('click', function() {
					var optionId = btn.dataset.optionId;
					// Deselect siblings, select this one
					document.querySelectorAll('.option-pill[data-option-id="' + optionId + '"]').forEach(function(b) {
						b.className = inactiveCls;
					});
					btn.className = activeCls;
					// Resolve variant from all selected options
					resolveVariant();
				});
			});

			function resolveVariant() {
				// Gather selected value IDs across all option groups
				var selected = [];
				document.querySelectorAll('div[data-option-id]').forEach(function(group) {
					var active = group.querySelector('.option-pill.border-rr-amber');
					if (active) selected.push(active.dataset.valueId);
				});
				if (selected.length === 0) return;
				// Find variant that matches all selected option values
				for (var vid in variantMap) {
					var entry = variantMap[vid];
					var ids = entry.optionValueIDs;
					if (ids.length === selected.length && selected.every(function(s) { return ids.indexOf(s) !== -1; })) {
						// Update hidden input
						var input = document.getElementById('selected-variant-id');
						if (input) input.value = vid;
						// Update price display
						if (entry.price !== null) {
							var display = document.getElementById('price-display');
							if (display) {
								display.innerHTML = '<span class="font-heading text-3xl text-rr-heading" data-base-price="' + entry.price + '">' + formatCents(entry.price) + '</span>';
							}
						}
						break;
					}
				}
			}

			function formatCents(cents) {
				return '$' + (cents / 100).toFixed(2);
			}
		})();
	</script>
}

templ purchaseModeScript() {
	<script>
		(function() {
			var mode = 'onetime';
			var variantID = document.getElementById('selected-variant-id');
			var qtyInput = document.getElementById('subscribe-quantity');
			var qtyMinus = document.getElementById('subscribe-qty-minus');
			var qtyPlus = document.getElementById('subscribe-qty-plus');

			// Mode toggle
			document.querySelectorAll('.purchase-mode-btn').forEach(function(btn) {
				btn.addEventListener('click', function() {
					mode = btn.dataset.mode;
					// Update tab styles
					document.querySelectorAll('.purchase-mode-btn').forEach(function(b) {
						if (b.dataset.mode === mode) {
							b.className = 'purchase-mode-btn relative rounded-sm border-2 border-rr-amber bg-rr-amber/5 p-3 text-left transition-colors';
						} else {
							b.className = 'purchase-mode-btn relative rounded-sm border-2 border-rr-border bg-rr-surface p-3 text-left transition-colors';
						}
					});
					// Toggle form visibility
					var onetimeForm = document.getElementById('onetime-form');
					var subscribeForm = document.getElementById('subscribe-form');
					var subscribeOptions = document.getElementById('subscribe-options');
					if (mode === 'subscribe') {
						onetimeForm.classList.add('hidden');
						subscribeForm.classList.remove('hidden');
						subscribeOptions.classList.remove('hidden');
						updatePrice();
					} else {
						onetimeForm.classList.remove('hidden');
						subscribeForm.classList.add('hidden');
						subscribeOptions.classList.add('hidden');
						resetPrice();
					}
				});
			});

			// Quantity controls
			if (qtyMinus && qtyPlus && qtyInput) {
				qtyMinus.addEventListener('click', function() {
					var val = parseInt(qtyInput.value, 10) || 1;
					if (val > 1) {
						qtyInput.value = val - 1;
						onQuantityChange();
					}
				});
				qtyPlus.addEventListener('click', function() {
					var val = parseInt(qtyInput.value, 10) || 1;
					if (val < 10) {
						qtyInput.value = val + 1;
						onQuantityChange();
					}
				});
				qtyInput.addEventListener('change', function() {
					var val = parseInt(qtyInput.value, 10);
					if (isNaN(val) || val < 1) qtyInput.value = 1;
					else if (val > 10) qtyInput.value = 10;
					onQuantityChange();
				});
				qtyInput.addEventListener('input', function() {
					var val = parseInt(qtyInput.value, 10);
					if (!isNaN(val) && val >= 1 && val <= 10) {
						onQuantityChange();
					}
				});
			}

			function onQuantityChange() {
				updateQtyButtons();
				var checked = document.querySelector('.subscribe-frequency-option input:checked');
				if (checked) {
					var label = checked.closest('.subscribe-frequency-option');
					updateSubscribeLink(label.dataset.planId);
				}
				if (mode === 'subscribe') updatePrice();
			}

			function updateQtyButtons() {
				var val = parseInt(qtyInput.value, 10) || 1;
				if (qtyMinus) qtyMinus.disabled = val <= 1;
				if (qtyPlus) qtyPlus.disabled = val >= 10;
			}

			// Frequency selection
			document.querySelectorAll('.subscribe-frequency-option').forEach(function(label) {
				var radio = label.querySelector('input[type="radio"]');
				radio.addEventListener('change', function() {
					// Update selected styles
					document.querySelectorAll('.subscribe-frequency-option').forEach(function(l) {
						l.classList.remove('border-rr-amber', 'bg-rr-amber/5');
						l.classList.add('border-rr-border');
					});
					label.classList.remove('border-rr-border');
					label.classList.add('border-rr-amber', 'bg-rr-amber/5');
					// Update subscribe link
					updateSubscribeLink(label.dataset.planId);
					updatePrice();
				});
			});

			function getQuantity() {
				return parseInt(qtyInput ? qtyInput.value : '1', 10) || 1;
			}

			var selectedPlanId = '';
			function updateSubscribeLink(planId) {
				selectedPlanId = planId;
			}

			// Navigate on subscribe button click
			var subscribeBtn = document.getElementById('subscribe-action');
			if (subscribeBtn) {
				subscribeBtn.addEventListener('click', function() {
					var vid = variantID ? variantID.value : '';
					var qty = getQuantity();
					var pid = selectedPlanId;
					if (!pid) {
						var checked = document.querySelector('.subscribe-frequency-option input:checked');
						if (checked) pid = checked.closest('.subscribe-frequency-option').dataset.planId;
					}
					if (pid) window.location.href = '/subscribe?plan_id=' + pid + '&variant_id=' + vid + '&quantity=' + qty;
				});
			}

			function updatePrice() {
				var priceEl = document.querySelector('[data-base-price]');
				if (!priceEl) return;
				var baseCents = parseInt(priceEl.dataset.basePrice, 10);
				var qty = getQuantity();
				var checked = document.querySelector('.subscribe-frequency-option input:checked');
				if (!checked) return;
				var label = checked.closest('.subscribe-frequency-option');
				var discount = parseInt(label.dataset.discount, 10) || 0;
				var unitCents = Math.round(baseCents * (100 - discount) / 100);
				var totalCents = unitCents * qty;
				var display = document.getElementById('price-display');
				var qtyPrefix = qty > 1 ? qty + ' × ' : '';
				if (discount > 0) {
					display.innerHTML = '<span class="font-heading text-xl text-rr-muted line-through">' + formatCents(baseCents) + '</span>' +
						' <span class="font-heading text-3xl text-rr-amber">' + qtyPrefix + formatCents(totalCents) + '</span>';
				} else {
					display.innerHTML = '<span class="font-heading text-3xl text-rr-heading">' + qtyPrefix + formatCents(totalCents) + '</span>';
				}
			}

			function resetPrice() {
				var priceEl = document.querySelector('[data-base-price]');
				if (!priceEl) return;
				var baseCents = parseInt(priceEl.dataset.basePrice, 10);
				var display = document.getElementById('price-display');
				display.innerHTML = '<span class="font-heading text-3xl text-rr-heading" data-base-price="' + baseCents + '">' + formatCents(baseCents) + '</span>';
			}

			function formatCents(cents) {
				return '$' + (cents / 100).toFixed(2);
			}

			// Auto-activate subscribe mode if ?mode=subscribe is present
			var params = new URLSearchParams(window.location.search);
			if (params.get('mode') === 'subscribe') {
				var subscribeTab = document.querySelector('.purchase-mode-btn[data-mode="subscribe"]');
				if (subscribeTab) subscribeTab.click();
			}

			// Initialize button states
			updateQtyButtons();
		})();
	</script>
}

// productJSONLDScript returns a <script type="application/ld+json"> tag with Product structured data.
func productJSONLDScript(props ProductDetailProps) string {
	ld := map[string]any{
		"@context":    "https://schema.org",
		"@type":       "Product",
		"name":        props.Product.Title,
		"description": props.Product.Description,
		"url":         "https://rockabillyroasting.com/catalog/" + props.Product.Slug,
		"brand": map[string]any{
			"@type": "Brand",
			"name":  "Rockabilly Roasting Co.",
		},
	}

	if len(props.Media) > 0 && props.MediaConfig != nil {
		ld["image"] = props.MediaConfig.ProductImageURL(props.Media[0].R2Key, media.VariantPublic)
	}

	if props.DefaultPrice != nil {
		ld["offers"] = map[string]any{
			"@type":         "Offer",
			"price":         fmt.Sprintf("%.2f", float64(*props.DefaultPrice)/100),
			"priceCurrency": props.CurrencyCode,
			"availability":  "https://schema.org/InStock",
			"url":           "https://rockabillyroasting.com/catalog/" + props.Product.Slug,
		}
	}

	b, _ := json.Marshal(ld)
	return `<script type="application/ld+json">` + string(b) + `</script>`
}

templ ProductPage(props ProductDetailProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       props.Product.Title,
		Description: props.Product.Description,
		CartCount:   props.CartCount,
	}) {
		@ProductContent(props)
		@templ.Raw(productJSONLDScript(props))
	}
}
