package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type ShippingProps struct {
	CartCount int
}

templ ShippingContent(props ShippingProps) {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)]">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-3xl px-6 sm:px-10 lg:px-14 py-12 sm:py-16">
			<!-- Page heading -->
			<header class="mb-12">
				<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
					How we get it to you
				</p>
				<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(2rem, 5vw, 3.25rem); letter-spacing:-0.005em;">
					Shipping &amp;
					<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">returns.</span>
				</h1>
			</header>
			<!-- Legal body -->
			<article class="space-y-10">
				@legalSection("Roasted fresh to order") {
					<p>Every order is roasted after you place it. We typically roast and ship within 1 to 3 business days so your coffee arrives at peak freshness.</p>
				}
				@legalSection("Shipping rates") {
					<p>Shipping is calculated at checkout based on your location and order weight. Orders over $40 ship free within the contiguous United States.</p>
				}
				@legalSection("Delivery times") {
					<p>Once shipped, delivery typically takes 2 to 5 business days depending on your location. You'll get a tracking number via email as soon as your order ships.</p>
				}
				@legalSection("Subscriptions") {
					<p>Subscription orders are roasted and shipped automatically on your selected schedule. You can pause, modify, or cancel anytime from your account page. Changes take effect on your next billing cycle.</p>
				}
				@legalSection("Returns & issues") {
					<p>Because coffee is perishable, we generally can't accept returns. If something's wrong with your order — damaged in shipping, wrong item, or a quality issue — contact us within 14 days and we'll make it right.</p>
				}
			</article>
			<!-- Contact card -->
			@legalContactCard()
		</div>
	</section>
}

templ ShippingPage(props ShippingProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Shipping & Returns",
		Description: "Shipping rates, delivery times, and return policy for Rockabilly Roasting Co.",
		CartCount:   props.CartCount,
	}) {
		@ShippingContent(props)
	}
}
