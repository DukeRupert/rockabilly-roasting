package storefront

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type SubscriptionProductCard struct {
	Product      domain.Product
	ThumbnailURL string
	BasePrice    *int
	MaxDiscount  int
	Coffee       *CoffeeAttrs
}

type SubscriptionsPageProps struct {
	Products  []SubscriptionProductCard
	Plans     []domain.SubscriptionPlan
	CartCount int
}

templ SubscriptionsContent(props SubscriptionsPageProps) {
	<!-- Hero -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8">
		<div class="relative" style="background: linear-gradient(rgba(14,15,16,0.85), rgba(14,15,16,0.85)), url('/static/rockabilly_shop.webp') center/cover no-repeat; background-color: #0E0F10;">
			<div class="texture-dots absolute inset-0 opacity-30"></div>
			<div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20 text-center">
				<p class="label-font text-rr-teal text-xs mb-3" style="letter-spacing: 0.35em;">FRESH ON YOUR SCHEDULE</p>
				<h1 class="font-display text-rr-heading leading-none tracking-wide" style="font-size: clamp(3rem, 10vw, 5.5rem);">
					THE DAILY GRIND
				</h1>
				<p class="mt-4 font-body text-lg text-rr-muted max-w-xl mx-auto leading-relaxed">
					Your favorite coffee, roasted fresh and delivered on your schedule.
					if props.maxDiscount() > 0 {
						Save up to { fmt.Sprintf("%d%%", props.maxDiscount()) } on every bag.
					}
				</p>
				<p class="mt-6 font-display text-rr-heading tracking-widest text-lg sm:text-xl">
					ALWAYS FRESH
					<span class="text-rr-teal mx-3">&middot;</span>
					if props.maxDiscount() > 0 {
						SAVE { fmt.Sprintf("%d%%", props.maxDiscount()) }
					} else {
						SAVE MORE
					}
					<span class="text-rr-teal mx-3">&middot;</span>
					CANCEL ANYTIME
				</p>
				<div class="mt-8">
					<a href="#subscribe-products" hx-boost="false" class="btn label-font px-10 py-4 rounded-sm text-white text-sm bg-rr-teal hover:bg-rr-teal-lt transition-colors">
						CHOOSE YOUR COFFEE
					</a>
				</div>
			</div>
			<div class="flame-stripe"></div>
		</div>
	</section>
	<!-- Product grid -->
	<section id="subscribe-products" class="-mx-4 sm:-mx-6 lg:-mx-8">
		<div class="relative bg-rr-surface/50">
			<div class="window-glow absolute inset-0 opacity-50"></div>
			<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
				<div class="text-center mb-10">
					<h2 class="font-display text-3xl tracking-widest text-rr-heading">PICK YOUR ROAST</h2>
					<p class="mt-1 font-body text-sm text-rr-muted">Choose a coffee below to set up your subscription.</p>
				</div>
		if len(props.Products) == 0 {
				<div class="text-center py-16">
					<svg class="mx-auto size-10 text-rr-faint mb-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"></path>
					</svg>
					<p class="font-body text-rr-muted">No subscribable products available yet.</p>
					<a href="/catalog" class="btn label-font inline-block mt-4 px-6 py-2.5 rounded-sm text-white text-sm bg-rr-red hover:bg-rr-red-lt transition-colors">
						BROWSE ALL COFFEE
					</a>
				</div>
			} else {
				<div class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-4">
					for _, card := range props.Products {
						@subscriptionProductCard(card)
					}
				</div>
				<div class="mt-10 text-center">
					<a href="/catalog" class="btn label-font px-10 py-4 rounded-sm text-white text-sm bg-rr-red hover:bg-rr-red-lt transition-colors">
						BROWSE ALL COFFEE
					</a>
				</div>
			}
			</div>
		</div>
	</section>
}

templ subscriptionProductCard(card SubscriptionProductCard) {
	<a href={ templ.SafeURL("/catalog/" + card.Product.Slug + "?mode=subscribe") } class="product-card group rounded-sm overflow-hidden border border-rr-border bg-rr-surface">
		<!-- Image — 3:4 ratio matching catalog cards -->
		<div class={ "aspect-3/4 w-full overflow-hidden bg-rr-bg relative", placeholderTint(card.Coffee) }>
			if card.ThumbnailURL != "" {
				<img
					src={ card.ThumbnailURL }
					alt={ cardAltText(card.Product.Title, card.Coffee) }
					class="h-full w-full object-cover object-center group-hover:opacity-80 transition-opacity"
					loading="lazy"
				/>
			} else {
				<div class="texture-dots absolute inset-0"></div>
				<div class="flex h-full w-full items-center justify-center relative">
					<div class="w-16 h-16 rounded-full border-2 border-rr-border bg-rr-surface flex items-center justify-center">
						<span class="font-display text-rr-muted text-lg tracking-widest">
							{ string([]rune(card.Product.Title)[0:1]) }
						</span>
					</div>
				</div>
			}
			<!-- Subscription badge overlay -->
			if card.MaxDiscount > 0 {
				<div class="absolute top-2 right-2">
					<span class="label-font px-2 py-1 rounded-sm text-white bg-rr-teal text-[0.6rem]">
						{ fmt.Sprintf("SAVE %d%%", card.MaxDiscount) }
					</span>
				</div>
			}
		</div>
		<!-- Product info — tight padding, matching catalog card pattern -->
		<div class="p-3">
			<h3 class="font-heading text-rr-heading text-base leading-tight group-hover:text-rr-teal transition-colors">{ card.Product.Title }</h3>
			<div class="mt-1 flex items-center gap-2">
				if card.BasePrice != nil && card.MaxDiscount > 0 {
					<span class="font-heading text-rr-muted text-sm line-through">{ formatCents(*card.BasePrice) }</span>
					<span class="font-heading text-rr-teal text-lg">{ formatCents(discountedPrice(*card.BasePrice, card.MaxDiscount)) }</span>
				} else if card.BasePrice != nil {
					<span class="font-heading text-rr-heading text-lg">{ formatCents(*card.BasePrice) }</span>
				}
			</div>
			<!-- Coffee attributes: roast scale + tasting note pills -->
			if card.Coffee != nil {
				if validRoastLevel(card.Coffee.RoastLevel) {
					<div class="mt-2">
						@roastDots(card.Coffee.RoastLevel, "small")
					</div>
				}
				if len(card.Coffee.TastingNotes) > 0 {
					<div class="mt-1.5 flex flex-wrap gap-1">
						for _, note := range cardTastingNotesList(card.Coffee.TastingNotes, 3) {
							<span class="label-font px-1.5 py-0.5 rounded-sm text-rr-amber/80 border border-rr-amber/20 bg-rr-amber/5 text-[0.6rem]">
								{ note }
							</span>
						}
					</div>
				}
			}
		</div>
	</a>
}

func (p SubscriptionsPageProps) maxDiscount() int {
	max := 0
	for _, plan := range p.Plans {
		if plan.DiscountPct > max {
			max = plan.DiscountPct
		}
	}
	return max
}

templ SubscriptionsPage(props SubscriptionsPageProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "The Daily Grind",
		Description: "Join The Daily Grind — subscribe to your favorite coffee and save on every delivery",
		CartCount:   props.CartCount,
	}) {
		@SubscriptionsContent(props)
	}
}
