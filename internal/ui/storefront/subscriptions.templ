package storefront

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type SubscriptionProductCard struct {
	Product      domain.Product
	ThumbnailURL string
	BasePrice    *int
	MaxDiscount  int
	Coffee       *CoffeeAttrs
}

type SubscriptionsPageProps struct {
	Products  []SubscriptionProductCard
	Plans     []domain.SubscriptionPlan
	CartCount int
}

templ SubscriptionsContent(props SubscriptionsPageProps) {
	<!-- Hero — full-width break-out with texture, matching home page energy -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 -mt-8">
		<div class="relative overflow-hidden bg-rr-void">
			<div class="texture-dots absolute inset-0"></div>
			<div class="texture-grid absolute inset-0"></div>
			<div class="window-glow absolute inset-0"></div>
			<div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center">
				<p class="label-font text-rr-teal text-xs mb-4" style="letter-spacing: 0.35em;">COFFEE SUBSCRIPTION</p>
				<h1 class="font-display text-rr-heading leading-none" style="font-size: clamp(3rem, 10vw, 6.5rem); letter-spacing: 0.05em;">
					THE DAILY GRIND
				</h1>
				<div class="flex items-center justify-center mt-2 mb-6">
					<div class="flex-1 h-px max-w-24" style="background: linear-gradient(to right, transparent, var(--color-rr-teal));"></div>
					<span class="font-display text-rr-teal px-4" style="font-size: clamp(0.7rem, 1.8vw, 1.1rem); letter-spacing: 0.4em;">SUBSCRIBE &amp; SAVE</span>
					<div class="flex-1 h-px max-w-24" style="background: linear-gradient(to left, transparent, var(--color-rr-teal));"></div>
				</div>
				<p class="font-body text-lg text-rr-muted max-w-xl mx-auto leading-relaxed">
					Your favorite coffee, roasted fresh and delivered on your schedule.
					if props.maxDiscount() > 0 {
						Save up to { fmt.Sprintf("%d%%", props.maxDiscount()) } on every bag.
					}
				</p>
				<a href="#subscribe-products" class="btn label-font inline-block mt-8 px-8 py-3.5 rounded-sm text-white text-sm bg-rr-teal glow-teal hover:bg-rr-teal-lt transition-colors">
					CHOOSE YOUR COFFEE
				</a>
			</div>
			<div class="flame-stripe"></div>
		</div>
	</section>
	<!-- Value props — three bold statements, not numbered steps -->
	<section class="mt-16 mb-16">
		<div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
			<div class="text-center sm:text-left">
				<div class="flex items-center justify-center sm:justify-start gap-3 mb-2">
					<svg class="size-5 text-rr-teal flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
						<path d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H4.598a.75.75 0 0 0-.75.75v3.634a.75.75 0 0 0 1.5 0v-2.033l.312.312a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.06-7.865a.75.75 0 0 0-.75.75v2.033l-.312-.312a7 7 0 0 0-11.712 3.138.75.75 0 0 0 1.449.39A5.5 5.5 0 0 1 14.2 7.576l.312.311h-2.433a.75.75 0 0 0 0 1.5h3.634a.75.75 0 0 0 .75-.75V4.998a.75.75 0 0 0-.75-.75Z"></path>
					</svg>
					<h3 class="font-display text-xl tracking-widest text-rr-heading">ALWAYS FRESH</h3>
				</div>
				<p class="font-body text-sm text-rr-muted leading-relaxed">Roasted to order before every shipment. Never sitting on a shelf.</p>
			</div>
			<div class="text-center sm:text-left">
				<div class="flex items-center justify-center sm:justify-start gap-3 mb-2">
					<svg class="size-5 text-rr-teal flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd" d="M5.5 3A2.5 2.5 0 0 0 3 5.5v2.879a2.5 2.5 0 0 0 .732 1.767l7.5 7.5a2.5 2.5 0 0 0 3.536 0l2.878-2.878a2.5 2.5 0 0 0 0-3.536l-7.5-7.5A2.5 2.5 0 0 0 8.38 3H5.5ZM6 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"></path>
					</svg>
					<h3 class="font-display text-xl tracking-widest text-rr-heading">
						if props.maxDiscount() > 0 {
							SAVE { fmt.Sprintf("%d%%", props.maxDiscount()) }
						} else {
							SAVE MORE
						}
					</h3>
				</div>
				<p class="font-body text-sm text-rr-muted leading-relaxed">Subscribers pay less on every bag. The more often, the more you save.</p>
			</div>
			<div class="text-center sm:text-left">
				<div class="flex items-center justify-center sm:justify-start gap-3 mb-2">
					<svg class="size-5 text-rr-teal flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
						<path fill-rule="evenodd" d="M10 2a.75.75 0 0 1 .75.75v.258a33.186 33.186 0 0 1 6.668.83.75.75 0 0 1-.336 1.461 31.28 31.28 0 0 0-1.103-.232l1.702 7.545a.75.75 0 0 1-.387.832A4.981 4.981 0 0 1 15 14c-.825 0-1.606-.2-2.294-.556a.75.75 0 0 1-.387-.832l1.77-7.849a31.743 31.743 0 0 0-3.339-.254v11.505a20.01 20.01 0 0 1 3.78.501.75.75 0 1 1-.339 1.462A18.558 18.558 0 0 0 10 17.5c-1.442 0-2.845.165-4.191.477a.75.75 0 0 1-.338-1.462 20.01 20.01 0 0 1 3.779-.501V4.509c-1.129.026-2.243.112-3.34.254l1.771 7.85a.75.75 0 0 1-.387.83A4.981 4.981 0 0 1 5 14a4.981 4.981 0 0 1-2.294-.556.75.75 0 0 1-.387-.832L4.02 5.067c-.37.07-.738.148-1.103.232a.75.75 0 0 1-.336-1.462 33.186 33.186 0 0 1 6.668-.829V2.75A.75.75 0 0 1 10 2ZM5 12.662l-1.395-6.185a31.52 31.52 0 0 0-1.39.572L3.61 13.233A3.489 3.489 0 0 0 5 12.661Zm10 0a3.489 3.489 0 0 0 1.389.572l1.396-6.184a31.52 31.52 0 0 0-1.39-.572L15 12.662Z" clip-rule="evenodd"></path>
					</svg>
					<h3 class="font-display text-xl tracking-widest text-rr-heading">NO COMMITMENT</h3>
				</div>
				<p class="font-body text-sm text-rr-muted leading-relaxed">Skip, pause, or cancel anytime from your account. No strings attached.</p>
			</div>
		</div>
	</section>
	<!-- Delivery frequency options -->
	if len(props.Plans) > 0 {
		<section class="mb-14">
			<div class="rounded-sm border border-rr-border bg-rr-surface relative overflow-hidden">
				<div class="texture-dots absolute inset-0 opacity-30"></div>
				<div class="relative px-6 py-8 sm:px-10">
					<h2 class="font-display text-2xl tracking-widest text-rr-heading mb-5">DELIVERY SCHEDULES</h2>
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
						for _, plan := range props.Plans {
							<div class="flex items-center justify-between rounded-sm border border-rr-border bg-rr-bg px-4 py-3">
								<span class="font-body text-sm font-medium text-rr-heading">{ subscriptionIntervalLabel(plan.Interval, plan.IntervalCount) }</span>
								if plan.DiscountPct > 0 {
									<span class="label-font px-2 py-0.5 rounded-sm text-rr-teal border border-rr-teal bg-rr-teal/5">
										{ fmt.Sprintf("SAVE %d%%", plan.DiscountPct) }
									</span>
								}
							</div>
						}
					</div>
					<p class="font-body text-xs text-rr-faint mt-4">Subscribe to multiple products and they ship together on the same schedule.</p>
				</div>
			</div>
		</section>
	}
	<!-- Product grid -->
	<section id="subscribe-products">
		<div class="flex items-baseline justify-between mb-8">
			<div>
				<h2 class="font-display text-3xl tracking-widest text-rr-heading">CHOOSE YOUR COFFEE</h2>
				<p class="mt-1 font-body text-sm text-rr-muted">Pick a roast below to set up your subscription.</p>
			</div>
			<a href="/catalog" class="hidden sm:inline-block label-font text-rr-amber text-xs hover:text-rr-amber-lt transition-colors">
				VIEW ALL COFFEE &rarr;
			</a>
		</div>
		if len(props.Products) == 0 {
			<div class="text-center py-16">
				<svg class="mx-auto size-10 text-rr-faint mb-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"></path>
				</svg>
				<p class="font-body text-rr-muted">No subscribable products available yet.</p>
				<a href="/catalog" class="btn label-font inline-block mt-4 px-6 py-2.5 rounded-sm text-white text-sm bg-rr-red hover:bg-rr-red-lt transition-colors">
					BROWSE ALL COFFEE
				</a>
			</div>
		} else {
			<div class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-4">
				for _, card := range props.Products {
					@subscriptionProductCard(card)
				}
			</div>
			<div class="mt-6 text-center sm:hidden">
				<a href="/catalog" class="label-font text-rr-amber text-xs hover:text-rr-amber-lt transition-colors">
					VIEW ALL COFFEE &rarr;
				</a>
			</div>
		}
	</section>
}

templ subscriptionProductCard(card SubscriptionProductCard) {
	<a href={ templ.SafeURL("/catalog/" + card.Product.Slug + "?mode=subscribe") } class="product-card group rounded-sm overflow-hidden border border-rr-border bg-rr-surface">
		<!-- Image — 3:4 ratio matching catalog cards -->
		<div class={ "aspect-3/4 w-full overflow-hidden bg-rr-bg relative", placeholderTint(card.Coffee) }>
			if card.ThumbnailURL != "" {
				<img
					src={ card.ThumbnailURL }
					alt={ cardAltText(card.Product.Title, card.Coffee) }
					class="h-full w-full object-cover object-center group-hover:opacity-80 transition-opacity"
					loading="lazy"
				/>
			} else {
				<div class="texture-dots absolute inset-0"></div>
				<div class="flex h-full w-full items-center justify-center relative">
					<div class="w-16 h-16 rounded-full border-2 border-rr-border bg-rr-surface flex items-center justify-center">
						<span class="font-display text-rr-muted text-lg tracking-widest">
							{ string([]rune(card.Product.Title)[0:1]) }
						</span>
					</div>
				</div>
			}
			<!-- Subscription badge overlay -->
			if card.MaxDiscount > 0 {
				<div class="absolute top-2 right-2">
					<span class="label-font px-2 py-1 rounded-sm text-white bg-rr-teal text-[0.6rem]">
						{ fmt.Sprintf("SAVE %d%%", card.MaxDiscount) }
					</span>
				</div>
			}
		</div>
		<!-- Product info — tight padding, matching catalog card pattern -->
		<div class="p-3">
			<h3 class="font-heading text-rr-heading text-base leading-tight group-hover:text-rr-teal transition-colors">{ card.Product.Title }</h3>
			<div class="mt-1 flex items-center gap-2">
				if card.BasePrice != nil && card.MaxDiscount > 0 {
					<span class="font-heading text-rr-muted text-sm line-through">{ formatCents(*card.BasePrice) }</span>
					<span class="font-heading text-rr-teal text-lg">{ formatCents(discountedPrice(*card.BasePrice, card.MaxDiscount)) }</span>
				} else if card.BasePrice != nil {
					<span class="font-heading text-rr-heading text-lg">{ formatCents(*card.BasePrice) }</span>
				}
			</div>
			<!-- Coffee attributes: roast scale + tasting note pills -->
			if card.Coffee != nil {
				if validRoastLevel(card.Coffee.RoastLevel) {
					<div class="mt-2">
						@roastDots(card.Coffee.RoastLevel, "small")
					</div>
				}
				if len(card.Coffee.TastingNotes) > 0 {
					<div class="mt-1.5 flex flex-wrap gap-1">
						for _, note := range cardTastingNotesList(card.Coffee.TastingNotes, 3) {
							<span class="label-font px-1.5 py-0.5 rounded-sm text-rr-amber/80 border border-rr-amber/20 bg-rr-amber/5 text-[0.6rem]">
								{ note }
							</span>
						}
					</div>
				}
			}
		</div>
	</a>
}

func (p SubscriptionsPageProps) maxDiscount() int {
	max := 0
	for _, plan := range p.Plans {
		if plan.DiscountPct > max {
			max = plan.DiscountPct
		}
	}
	return max
}

templ SubscriptionsPage(props SubscriptionsPageProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "The Daily Grind",
		Description: "Join The Daily Grind — subscribe to your favorite coffee and save on every delivery",
		CartCount:   props.CartCount,
	}) {
		@SubscriptionsContent(props)
	}
}
