package storefront

import (
	"fmt"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type SubscriptionProductCard struct {
	Product      domain.Product
	ThumbnailURL string
	BasePrice    *int
	MaxDiscount  int
}

type SubscriptionsPageProps struct {
	Products  []SubscriptionProductCard
	Plans     []domain.SubscriptionPlan
	CartCount int
}

templ SubscriptionsContent(props SubscriptionsPageProps) {
	<div>
		<!-- Hero -->
		<div class="mb-10">
			<h1 class="text-3xl font-bold tracking-tight text-hiri-text">Subscribe & Save</h1>
			<p class="mt-2 max-w-2xl text-base text-hiri-text-secondary">
				Never run out of your favorite coffee. Choose your products, pick a delivery frequency, and save on every order.
				Subscribe to multiple products and they'll ship together.
			</p>
		</div>
		<!-- How it works -->
		<div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
			<div class="rounded-lg border border-stone-200 bg-white p-5">
				<div class="mb-2 flex size-8 items-center justify-center rounded-full bg-hiri-teal/10 text-sm font-bold text-hiri-teal">1</div>
				<h3 class="text-sm font-semibold text-hiri-text">Choose your coffee</h3>
				<p class="mt-1 text-xs text-hiri-text-secondary">Pick from any of our subscribable products below.</p>
			</div>
			<div class="rounded-lg border border-stone-200 bg-white p-5">
				<div class="mb-2 flex size-8 items-center justify-center rounded-full bg-hiri-teal/10 text-sm font-bold text-hiri-teal">2</div>
				<h3 class="text-sm font-semibold text-hiri-text">Pick your frequency</h3>
				<p class="mt-1 text-xs text-hiri-text-secondary">Select how often you want it delivered.</p>
			</div>
			<div class="rounded-lg border border-stone-200 bg-white p-5">
				<div class="mb-2 flex size-8 items-center justify-center rounded-full bg-hiri-teal/10 text-sm font-bold text-hiri-teal">3</div>
				<h3 class="text-sm font-semibold text-hiri-text">Save on every order</h3>
				<p class="mt-1 text-xs text-hiri-text-secondary">
					if props.maxDiscount() > 0 {
						{ fmt.Sprintf("Up to %d%% off", props.maxDiscount()) } every delivery. Modify or cancel anytime.
					} else {
						Enjoy savings on every delivery. Modify or cancel anytime.
					}
				</p>
			</div>
		</div>
		<!-- Frequency options summary -->
		if len(props.Plans) > 0 {
			<div class="mb-10">
				<h2 class="mb-3 text-lg font-semibold text-hiri-text">Delivery frequencies</h2>
				<div class="flex flex-wrap gap-2">
					for _, plan := range props.Plans {
						<div class="inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-4 py-2 text-sm">
							<span class="font-medium text-hiri-text">{ subscriptionIntervalLabel(plan.Interval, plan.IntervalCount) }</span>
							if plan.DiscountPct > 0 {
								<span class="rounded-full bg-hiri-teal/10 px-2 py-0.5 text-xs font-medium text-hiri-teal">
									{ fmt.Sprintf("Save %d%%", plan.DiscountPct) }
								</span>
							}
						</div>
					}
				</div>
			</div>
		}
		<!-- Product grid -->
		if len(props.Products) == 0 {
			<div class="py-12 text-center">
				<p class="text-hiri-text-secondary">No subscribable products available yet.</p>
			</div>
		} else {
			<h2 class="mb-4 text-lg font-semibold text-hiri-text">Our products</h2>
			<div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				for _, card := range props.Products {
					@subscriptionProductCard(card)
				}
			</div>
		}
	</div>
}

templ subscriptionProductCard(card SubscriptionProductCard) {
	<a href={ templ.SafeURL("/catalog/" + card.Product.Slug + "?mode=subscribe") } class="group rounded-lg border border-stone-200 bg-white transition-shadow hover:shadow-md">
		<div class="aspect-square w-full overflow-hidden rounded-t-lg bg-stone-100">
			if card.ThumbnailURL != "" {
				<img
					src={ card.ThumbnailURL }
					alt={ card.Product.Title }
					class="h-full w-full object-cover object-center group-hover:opacity-75 transition-opacity"
				/>
			} else {
				<div class="flex h-full w-full items-center justify-center">
					<svg class="size-12 text-stone-300" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"></path>
					</svg>
				</div>
			}
		</div>
		<div class="p-4">
			<h3 class="text-sm font-medium text-hiri-text group-hover:text-hiri-teal">{ card.Product.Title }</h3>
			if card.Product.Description != "" {
				<p class="mt-1 text-xs text-hiri-text-secondary line-clamp-2">{ card.Product.Description }</p>
			}
			<div class="mt-3 flex items-center gap-2">
				if card.BasePrice != nil && card.MaxDiscount > 0 {
					<span class="text-sm text-hiri-text-secondary line-through">{ formatCents(*card.BasePrice) }</span>
					<span class="text-sm font-semibold text-hiri-teal">{ formatCents(discountedPrice(*card.BasePrice, card.MaxDiscount)) }</span>
				} else if card.BasePrice != nil {
					<span class="text-sm font-semibold text-hiri-text">{ formatCents(*card.BasePrice) }</span>
				}
			</div>
			<div class="mt-3">
				<span class="inline-flex w-full items-center justify-center rounded-md border border-hiri-teal px-3 py-2 text-sm font-medium text-hiri-teal group-hover:bg-hiri-teal group-hover:text-white transition-colors">
					Subscribe
				</span>
			</div>
		</div>
	</a>
}

func (p SubscriptionsPageProps) maxDiscount() int {
	max := 0
	for _, plan := range p.Plans {
		if plan.DiscountPct > max {
			max = plan.DiscountPct
		}
	}
	return max
}

templ SubscriptionsPage(props SubscriptionsPageProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Subscribe & Save",
		Description: "Subscribe to your favorite products and save on every delivery",
		CartCount:   props.CartCount,
	}) {
		@SubscriptionsContent(props)
	}
}
