package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

// UpdateCardReason names why the card-update link could not be honoured, so the
// page can say something useful instead of a generic failure.
type UpdateCardReason string

const (
	// UpdateCardReasonInvalid covers a link we cannot verify — malformed,
	// tampered with, or signed under a rotated secret. Deliberately vague: a
	// probe must not be able to learn which subscription IDs exist.
	UpdateCardReasonInvalid UpdateCardReason = "invalid"
	// UpdateCardReasonExpired is a genuine link that has aged out. By the time
	// one of these expires the subscription has usually ended, so the copy
	// points at starting fresh rather than at fixing a card.
	UpdateCardReasonExpired UpdateCardReason = "expired"
	// UpdateCardReasonNotPastDue is a subscription that is no longer behind on
	// payment — the card already went through, or the customer cancelled. Good
	// news, and worth saying plainly.
	UpdateCardReasonNotPastDue UpdateCardReason = "not_past_due"
	// UpdateCardReasonUnavailable is our end failing: no Stripe customer on the
	// account, or the portal session could not be created.
	UpdateCardReasonUnavailable UpdateCardReason = "unavailable"
)

type UpdateCardProps struct {
	// Token is echoed back so the confirm button can POST it. The page never
	// acts on GET — see web/update_card.go for why.
	Token       string
	ProductName string
	PlanName    string
	// EndsOn is the day the subscription is given up on if the card is never
	// fixed, already formatted for display.
	EndsOn string
	// HardDecline is true when the issuer has permanently blocked the card, so
	// the page can ask for a *different* card rather than a retry.
	HardDecline bool
	Reason      UpdateCardReason
}

// updateCardShell wraps every outcome in one paper card, mirroring
// undoSkipShell and switchToPickupShell — all three are one-off pages a
// customer reaches from an email.
templ updateCardShell(eyebrow, heading, script string) {
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)] flex items-center">
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-md lg:max-w-xl w-full px-6 sm:px-10 lg:px-14 py-14 sm:py-20">
			<div class="text-center mb-8">
				<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
					{ eyebrow }
				</p>
				<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(1.75rem, 4.5vw, 2.75rem); letter-spacing:-0.005em;">
					{ heading }
					<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">{ script }</span>
				</h1>
			</div>
			<div class="border-2 border-ink bg-cream-hi shadow-stamp p-6 sm:p-8 text-center">
				{ children... }
			</div>
		</div>
	</section>
}

templ UpdateCardConfirmContent(props UpdateCardProps) {
	@updateCardShell("Payment", "New card,", "same coffee.") {
		<p class="font-oswald text-ink-soft text-sm leading-relaxed">
			We couldn't charge the card on file for your <strong class="text-ink">{ props.ProductName }</strong> subscription
			if props.PlanName != "" {
				({ props.PlanName })
			}
			, so the next shipment is on hold.
		</p>
		if props.HardDecline {
			<p class="font-oswald text-ink-soft text-sm mt-4 leading-relaxed">
				Your bank has blocked that card for good, so this one needs a different card &mdash; retrying the old one won't get there.
			</p>
		}
		if props.EndsOn != "" {
			<div class="mt-5 border-2 border-ink bg-paper p-4">
				<p class="font-oswald font-bold text-chrome-deep text-[10px]" style="letter-spacing:0.2em; text-transform:uppercase;">Closes out on</p>
				<p class="font-special text-ink text-lg mt-1">{ props.EndsOn }</p>
			</div>
		}
		<p class="font-oswald text-ink-soft text-sm mt-4 leading-relaxed">
			The button takes you to our payment processor to put a card on file. Nothing else about your subscription changes.
		</p>
		<form method="post" action="/subscriptions/update-card" class="mt-6">
			<input type="hidden" name="t" value={ props.Token }/>
			<button type="submit" class="btn-stamp w-full border-2 border-ink bg-rust text-paper px-5 py-3 font-oswald font-bold text-sm" style="letter-spacing:0.16em; text-transform:uppercase;">
				Update payment method
			</button>
		</form>
		<a href="/account/subscriptions" class="inline-block mt-4 font-oswald font-bold text-rust text-xs underline" style="letter-spacing:0.14em; text-transform:uppercase;">
			Sign in instead
		</a>
	}
}

templ UpdateCardProblemContent(props UpdateCardProps) {
	switch props.Reason {
		case UpdateCardReasonExpired:
			@updateCardShell("Payment", "Link", "expired.") {
				<p class="font-oswald text-ink-soft text-sm leading-relaxed">
					That link has aged out. If the subscription closed while the card was down, starting a fresh one takes about a minute &mdash; same coffee, same cadence.
				</p>
				<a href="/subscriptions" class="btn-stamp inline-block mt-6 border-2 border-ink bg-rust text-paper px-5 py-3 font-oswald font-bold text-sm" style="letter-spacing:0.16em; text-transform:uppercase;">
					Start a subscription
				</a>
			}
		case UpdateCardReasonNotPastDue:
			@updateCardShell("Payment", "Already", "sorted.") {
				<p class="font-oswald text-ink-soft text-sm leading-relaxed">
					This subscription isn't behind on payment &mdash; either the charge went through or the subscription has since changed.
				</p>
				<p class="font-oswald text-ink-soft text-sm mt-3 leading-relaxed">
					Nothing to do here. Sign in if you'd still like to change the card on file.
				</p>
				<a href="/account/subscriptions" class="inline-block mt-5 font-oswald font-bold text-rust text-xs underline" style="letter-spacing:0.14em; text-transform:uppercase;">
					Your subscriptions
				</a>
			}
		case UpdateCardReasonUnavailable:
			@updateCardShell("Payment", "Can't open", "that right now.") {
				<p class="font-oswald text-ink-soft text-sm leading-relaxed">
					Something on our end is keeping us from opening the payment form. Your subscription hasn't changed.
				</p>
				<p class="font-oswald text-ink-soft text-sm mt-3 leading-relaxed">
					Try again in a few minutes, sign in to update the card, or reply to the email and we'll sort it by hand.
				</p>
				<a href="/account/subscriptions" class="inline-block mt-5 font-oswald font-bold text-rust text-xs underline" style="letter-spacing:0.14em; text-transform:uppercase;">
					Your subscriptions
				</a>
			}
		default:
			@updateCardShell("Payment", "Link", "not recognized.") {
				<p class="font-oswald text-ink-soft text-sm leading-relaxed">
					We couldn't read that link. Email clients sometimes break them in transit.
				</p>
				<p class="font-oswald text-ink-soft text-sm mt-3 leading-relaxed">
					Sign in to update your card, or reply to the email and we'll handle it.
				</p>
				<a href="/account/subscriptions" class="inline-block mt-5 font-oswald font-bold text-rust text-xs underline" style="letter-spacing:0.14em; text-transform:uppercase;">
					Your subscriptions
				</a>
			}
	}
}

templ UpdateCardConfirmPage(props UpdateCardProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Update Payment Method",
		Description: "Put a working card on file for your Rockabilly Roasting Co. subscription.",
	}) {
		@UpdateCardConfirmContent(props)
	}
}

templ UpdateCardProblemPage(props UpdateCardProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Update Payment Method",
		Description: "We couldn't open the payment form.",
	}) {
		@UpdateCardProblemContent(props)
	}
}
