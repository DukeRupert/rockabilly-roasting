package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type WholesaleProps struct {
	CartCount int
}

templ WholesaleContent(props WholesaleProps) {
	<div class="mx-auto max-w-3xl py-12">
		<h1 class="font-display text-4xl text-rr-heading tracking-wide mb-4">WHOLESALE &amp; WHITE LABEL</h1>
		<div class="w-16 h-1 bg-rr-red mx-auto sm:mx-0 mb-8 rounded-full"></div>
		<p class="font-body text-lg text-rr-muted leading-relaxed mb-10">
			Partner with us to bring specialty coffee to your business. We offer wholesale pricing for cafes,
			restaurants, and retailers — plus white label roasting for brands that want their own custom coffee.
		</p>
		<!-- Two columns -->
		<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 mb-12">
			<div class="rounded-sm border border-rr-border bg-rr-surface p-6">
				<div class="mb-3 flex size-10 items-center justify-center rounded-full bg-rr-amber/10">
					<svg class="size-5 text-rr-amber" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"></path>
					</svg>
				</div>
				<h2 class="label-font text-rr-heading text-xs mb-2">WHOLESALE</h2>
				<p class="font-body text-sm text-rr-muted leading-relaxed">
					Volume pricing for cafes, restaurants, offices, and retail shops. Fresh-roasted beans
					delivered on your schedule with dedicated account support.
				</p>
			</div>
			<div class="rounded-sm border border-rr-border bg-rr-surface p-6">
				<div class="mb-3 flex size-10 items-center justify-center rounded-full bg-rr-teal/10">
					<svg class="size-5 text-rr-teal" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"></path>
					</svg>
				</div>
				<h2 class="label-font text-rr-heading text-xs mb-2">WHITE LABEL</h2>
				<p class="font-body text-sm text-rr-muted leading-relaxed">
					Your brand, our beans. We roast, package, and ship custom-labeled coffee for your
					business. Perfect for corporate gifts, branded merch, or launching your own line.
				</p>
			</div>
		</div>
		<!-- CTA -->
		<div class="text-center sm:text-left">
			<a
				href="/wholesale/apply"
				class="btn inline-block label-font px-6 py-3 rounded-sm text-white text-sm bg-rr-red glow-red hover:bg-rr-red-lt transition-colors"
			>
				APPLY NOW
			</a>
			<p class="font-body text-xs text-rr-muted mt-4">
				Already have an account?
				<a href="/wholesale/login" class="text-rr-red hover:text-rr-red-lt transition-colors">Sign in here</a>.
			</p>
		</div>
	</div>
}

templ WholesalePage(props WholesaleProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Wholesale & White Label",
		Description: "Wholesale coffee and white label roasting for cafes, restaurants, and brands",
		CartCount:   props.CartCount,
	}) {
		@WholesaleContent(props)
	}
}
