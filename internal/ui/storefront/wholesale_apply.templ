package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type WholesaleApplyProps struct {
	CartCount int
}

templ WholesaleApplyContent(props WholesaleApplyProps) {
	<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
		<div class="sm:mx-auto sm:w-full sm:max-w-md">
			<h2 class="text-center text-2xl/9 font-bold tracking-tight text-gray-900">Wholesale Application</h2>
			<p class="mt-2 text-center text-sm/6 text-gray-500">
				Apply for a wholesale account to access bulk pricing and net terms.
			</p>
		</div>
		<div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
			<div class="bg-white px-6 py-12 shadow-sm sm:rounded-lg sm:px-12">
				<form method="post" action="/wholesale/apply" class="space-y-6">
					<div class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
						<div>
							<label for="first_name" class="block text-sm/6 font-medium text-gray-900">First name</label>
							<div class="mt-2">
								<input type="text" name="first_name" id="first_name" required autocomplete="given-name" class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"/>
							</div>
						</div>
						<div>
							<label for="last_name" class="block text-sm/6 font-medium text-gray-900">Last name</label>
							<div class="mt-2">
								<input type="text" name="last_name" id="last_name" required autocomplete="family-name" class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"/>
							</div>
						</div>
					</div>
					<div>
						<label for="email" class="block text-sm/6 font-medium text-gray-900">Email address</label>
						<div class="mt-2">
							<input type="email" name="email" id="email" required autocomplete="email" class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"/>
						</div>
					</div>
					<div>
						<label for="company_name" class="block text-sm/6 font-medium text-gray-900">Company name</label>
						<div class="mt-2">
							<input type="text" name="company_name" id="company_name" required autocomplete="organization" class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"/>
						</div>
					</div>
					<div class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
						<div>
							<label for="phone" class="block text-sm/6 font-medium text-gray-900">Phone <span class="text-gray-400">(optional)</span></label>
							<div class="mt-2">
								<input type="tel" name="phone" id="phone" autocomplete="tel" class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"/>
							</div>
						</div>
						<div>
							<label for="website" class="block text-sm/6 font-medium text-gray-900">Website <span class="text-gray-400">(optional)</span></label>
							<div class="mt-2">
								<input type="url" name="website" id="website" autocomplete="url" placeholder="https://" class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-rr-red sm:text-sm/6"/>
							</div>
						</div>
					</div>
					<div>
						<button
							type="submit"
							class="flex w-full justify-center rounded-md bg-rr-red px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
						>
							Submit Application
						</button>
					</div>
				</form>
			</div>
			<p class="mt-10 text-center text-sm/6 text-gray-500">
				Already have a wholesale account?
				<a href="/wholesale/login" class="font-semibold text-rr-red hover:text-rr-red-lt">Sign in</a>
			</p>
		</div>
	</div>
}

templ WholesaleApplyPage(props WholesaleApplyProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:     "Wholesale Application",
		CartCount: props.CartCount,
	}) {
		@WholesaleApplyContent(props)
	}
}

templ WholesaleApplyConfirmation() {
	<div class="mx-auto max-w-lg text-center py-12">
		<svg class="mx-auto size-16 text-rr-red" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
		</svg>
		<h1 class="mt-4 text-2xl font-bold text-rr-heading">Application Received</h1>
		<p class="mt-2 text-sm text-rr-muted">
			Thank you for your interest! We'll review your application and get back to you within 2 business days.
		</p>
		<div class="mt-8">
			<a href="/catalog" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">&larr; Continue shopping</a>
		</div>
	</div>
}
