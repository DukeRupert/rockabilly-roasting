package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type WholesaleApplyProps struct {
	CartCount        int
	TurnstileSiteKey string // empty disables the widget (honeypot still active)
}

templ WholesaleApplyContent(props WholesaleApplyProps) {
	if props.TurnstileSiteKey != "" {
		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
	}
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 -mt-8 relative bg-paper min-h-[calc(100vh-4rem)]">
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-xl w-full px-6 sm:px-10 lg:px-14 py-14 sm:py-20">
			<!-- Page heading -->
			<div class="text-center mb-8">
				<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
					For the trade
				</p>
				<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(1.75rem, 4.5vw, 2.75rem); letter-spacing:-0.005em;">
					Wholesale
					<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">application.</span>
				</h1>
				<p class="font-oswald text-ink-soft text-sm mt-4 max-w-md mx-auto leading-relaxed">
					Apply for a wholesale account to access bulk pricing and net terms. We review every application and usually reply within a business day.
				</p>
			</div>
			<!-- Card -->
			<div class="border-2 border-ink bg-cream-hi shadow-stamp p-6 sm:p-8">
				<form method="post" action="/wholesale/apply" class="space-y-5">
					<!-- Honeypot field — hidden from real users, catches bots -->
					<div class="hidden" aria-hidden="true">
						<input type="text" name="fax" tabindex="-1" autocomplete="off"/>
					</div>
					<div class="grid grid-cols-1 gap-x-4 gap-y-5 sm:grid-cols-2">
						<div>
							<label for="first_name" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">First name</label>
							<input
								type="text"
								name="first_name"
								id="first_name"
								required
								autocomplete="given-name"
								class="paper-input w-full border-2 border-ink bg-paper px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
								style="letter-spacing:0.04em;"
							/>
						</div>
						<div>
							<label for="last_name" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Last name</label>
							<input
								type="text"
								name="last_name"
								id="last_name"
								required
								autocomplete="family-name"
								class="paper-input w-full border-2 border-ink bg-paper px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
								style="letter-spacing:0.04em;"
							/>
						</div>
					</div>
					<div>
						<label for="email" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Email address</label>
						<input
							type="email"
							name="email"
							id="email"
							required
							autocomplete="email"
							placeholder="you@example.com"
							class="paper-input w-full border-2 border-ink bg-paper px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
							style="letter-spacing:0.04em;"
						/>
					</div>
					<div>
						<label for="company_name" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Company name</label>
						<input
							type="text"
							name="company_name"
							id="company_name"
							required
							autocomplete="organization"
							class="paper-input w-full border-2 border-ink bg-paper px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
							style="letter-spacing:0.04em;"
						/>
					</div>
					<div class="grid grid-cols-1 gap-x-4 gap-y-5 sm:grid-cols-2">
						<div>
							<label for="phone" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">
								Phone <span class="text-chrome-deep font-normal normal-case" style="letter-spacing:0.04em;">(optional)</span>
							</label>
							<input
								type="tel"
								name="phone"
								id="phone"
								autocomplete="tel"
								class="paper-input w-full border-2 border-ink bg-paper px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
								style="letter-spacing:0.04em;"
							/>
						</div>
						<div>
							<label for="website" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">
								Website <span class="text-chrome-deep font-normal normal-case" style="letter-spacing:0.04em;">(optional)</span>
							</label>
							<input
								type="url"
								name="website"
								id="website"
								autocomplete="url"
								placeholder="https://"
								class="paper-input w-full border-2 border-ink bg-paper px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
								style="letter-spacing:0.04em;"
							/>
						</div>
					</div>
					if props.TurnstileSiteKey != "" {
						<div class="flex justify-center pt-1">
							<div class="cf-turnstile" data-sitekey={ props.TurnstileSiteKey } data-theme="light"></div>
						</div>
					}
					<button
						type="submit"
						class="btn-stamp w-full inline-flex items-center justify-center gap-2 bg-rust text-paper border-2 border-ink px-6 py-3.5 font-oswald font-bold text-sm"
						style="letter-spacing:0.16em; text-transform:uppercase;"
					>
						Submit application
						<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
						</svg>
					</button>
				</form>
			</div>
			<p class="mt-6 text-center font-oswald text-chrome-deep text-sm">
				Already have a wholesale account?
				<a href="/wholesale/login" class="font-bold text-rust hover:text-rust-deep underline underline-offset-2">Sign in</a>
			</p>
		</div>
	</section>
}

templ WholesaleApplyPage(props WholesaleApplyProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Wholesale Application",
		Description: "Apply for a wholesale account with Rockabilly Roasting Co. Our team reviews every application and usually replies within a business day.",
		CartCount:   props.CartCount,
	}) {
		@WholesaleApplyContent(props)
	}
}

templ WholesaleApplyConfirmation() {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 -mt-8 relative bg-paper min-h-[calc(100vh-4rem)] flex items-center">
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-md w-full px-6 sm:px-10 lg:px-14 py-14 sm:py-20 text-center">
			<!-- Tilted "received" stamp -->
			<div class="inline-flex items-center justify-center mb-8">
				<span
					class="relative inline-flex size-20 items-center justify-center bg-paper-warm border-2 border-ink"
					style="box-shadow: var(--shadow-stamp); transform: rotate(-4deg);"
				>
					<svg class="size-10 text-ink" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
					</svg>
					<span
						class="absolute -bottom-2 -right-3 inline-block font-oswald font-bold text-[10px] text-rust bg-paper px-2 py-0.5 border-2 border-rust"
						style="letter-spacing:0.16em; text-transform:uppercase; transform:rotate(-10deg); outline:2px solid var(--color-rust); outline-offset:2px;"
					>
						Received
					</span>
				</span>
			</div>
			<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
				Application received
			</p>
			<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(1.75rem, 4.5vw, 2.75rem); letter-spacing:-0.005em;">
				We got
				<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">it.</span>
			</h1>
			<p class="mt-5 font-oswald text-ink-soft text-base leading-relaxed max-w-sm mx-auto">
				Thanks for your interest. We'll review your application and get back to you within two business days.
			</p>
			<a
				href="/catalog"
				class="btn-stamp inline-flex items-center gap-2 mt-8 bg-rust text-paper border-2 border-ink px-7 py-3.5 font-oswald font-bold text-sm"
				style="letter-spacing:0.14em; text-transform:uppercase;"
			>
				<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
				</svg>
				Continue shopping
			</a>
		</div>
	</section>
}
