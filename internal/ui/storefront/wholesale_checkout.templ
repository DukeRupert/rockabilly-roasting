package storefront

import (
	"encoding/json"
	"fmt"
	"strings"
	"github.com/google/uuid"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type WholesaleCheckoutItem struct {
	ItemID      uuid.UUID
	VariantID   uuid.UUID
	ProductName string
	SKU         string
	Quantity    int
	UnitPrice   int
	LineTotal   int
	// Wholesale ordering rules, shown as a hint and enforced by Place Order.
	MinQty   *int
	Multiple *int
	// Ladder is the customer's volume ladder for this variant — the same value
	// the line was priced from, so the breaks shown are the breaks they'd get.
	Ladder domain.TierLadder
	// Drop is set on the one line whose quantity change just cost it a volume
	// rung. It rides on the item rather than the page so it renders where it
	// happened, which also means it needs no product name to identify itself.
	Drop *domain.Drop
}

type WholesaleCheckoutProps struct {
	CompanyName       string
	Items             []WholesaleCheckoutItem
	Subtotal          int
	Error             string
	// Notice is an informational (non-error) banner, e.g. the reorder summary
	// telling the buyer how many items were loaded and how many were skipped.
	Notice            string
	CartCount         int
	PriceChangeBanner bool
	// MOQProblems lists cart lines that would fail wholesale minimum/multiple
	// validation at Place Order, pre-formatted one per line.
	MOQProblems []string
	Addresses         []domain.Address
	// DefaultAddressID preselects a saved address for shipping; empty means
	// the "new address" form is shown by default (e.g. customer has none).
	DefaultAddressID string

	// Local fulfillment options. LocalDeliveryEnabled gates whether the
	// "local delivery" radio is offered at all; LocalZipCodes is the local
	// zone the checkout uses (client-side) to show that radio only when the
	// ship-to ZIP qualifies. The two display strings annotate the options.
	LocalDeliveryEnabled    bool
	LocalZipCodes           []string
	LocalDeliveryDays       string
	LocalPickupInstructions string

	// LocalDeliveryDate is the specific run this order would ride if placed
	// now — "Thursday, August 13" — resolved against the delivery weekdays and
	// the order-by cutoff. Empty when no schedule is configured, in which case
	// the radio falls back to the general LocalDeliveryDays phrasing.
	//
	// It is a snapshot taken when the page rendered. A buyer who leaves
	// checkout open across the cutoff sees a stale date; the order is placed
	// against a freshly computed one, and the confirmation email carries the
	// authoritative answer.
	LocalDeliveryDate string
	// LocalDeliveryCutoff is the order-by time ("9am") named alongside the
	// date, so the buyer can see why it is that day and what to beat next time.
	LocalDeliveryCutoff string
}

// minQtyAttr is the qty input's min: the wholesale minimum when set, else 1
// (a checkout line always has at least one unit — removal is a separate action).
func minQtyAttr(minQty *int) string {
	if minQty != nil && *minQty > 1 {
		return fmt.Sprint(*minQty)
	}
	return "1"
}

// multipleAttr is the qty input's step: the wholesale case multiple when set.
func multipleAttr(multiple *int) string {
	if multiple != nil && *multiple > 1 {
		return fmt.Sprint(*multiple)
	}
	return "1"
}

// moqHint renders the ordering rules under a qty input, e.g. "min 6 · ×6".
func moqHint(minQty, multiple *int) string {
	parts := []string{}
	if minQty != nil && *minQty > 1 {
		parts = append(parts, fmt.Sprintf("min %d", *minQty))
	}
	if multiple != nil && *multiple > 1 {
		parts = append(parts, fmt.Sprintf("×%d", *multiple))
	}
	return strings.Join(parts, " · ")
}

// normalizeZipJS mirrors domain.normalizeZip for building the client-side local
// zone list: trims whitespace and strips a ZIP+4 suffix so comparisons match.
func normalizeZipJS(z string) string {
	z = strings.TrimSpace(z)
	if i := strings.Index(z, "-"); i >= 0 {
		z = z[:i]
	}
	return z
}

// wholesaleAddrXData seeds the Alpine state for the checkout address step:
// shipMode is a saved address ID or "new", billing defaults to "same as
// shipping", and the billing selector starts on the new-address form.
// The delivery option depends on the live ship-to ZIP, which changes as the
// buyer switches saved addresses or types a new one. We seed Alpine with the
// local zone (localZips) and each saved address's ZIP (savedZips) so the
// shipZip/deliveryEligible getters resolve the current ZIP without a round-trip,
// and the local-delivery radio shows only when it qualifies.
func wholesaleAddrXData(props WholesaleCheckoutProps) string {
	ship := "new"
	if props.DefaultAddressID != "" {
		ship = props.DefaultAddressID
	}
	localZips := make([]string, 0, len(props.LocalZipCodes))
	for _, z := range props.LocalZipCodes {
		localZips = append(localZips, normalizeZipJS(z))
	}
	savedZips := make(map[string]string, len(props.Addresses))
	for _, a := range props.Addresses {
		savedZips[a.ID.String()] = normalizeZipJS(a.PostalCode)
	}
	lz, _ := json.Marshal(localZips)
	sz, _ := json.Marshal(savedZips)
	return fmt.Sprintf(
		"{ shipMode: '%s', billSame: true, billMode: 'new', method: 'shipped', newZip: '', localZips: %s, savedZips: %s, "+
			"get shipZip() { const z = this.shipMode === 'new' ? this.newZip : (this.savedZips[this.shipMode] || ''); return (z || '').trim().split('-')[0]; }, "+
			"get deliveryEligible() { return this.localZips.includes(this.shipZip); } }",
		ship, string(lz), string(sz),
	)
}

templ WholesaleCheckoutContent(props WholesaleCheckoutProps) {
	<div id="wholesale-checkout" class="mx-auto max-w-3xl space-y-6 py-8 sm:py-10">
		<!-- Header -->
		<div class="border-b-2 border-ink pb-5">
			<p class="font-oswald font-semibold text-chrome-deep text-[11px]" style="letter-spacing:0.24em; text-transform:uppercase;">The Crew · Wholesale</p>
			<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(2rem, 4.5vw, 3rem); letter-spacing:-0.005em;">Review Order</h1>
			<p class="mt-3 font-oswald text-ink-soft text-base leading-relaxed">
				Look it over before you send it our way.
			</p>
		</div>
		if props.Error != "" {
			<div class="border-2 border-rust bg-paper-warm p-4">
				<p class="font-oswald font-semibold text-sm text-rust">{ props.Error }</p>
			</div>
		}
		if props.Notice != "" {
			<div class="flex items-start gap-3 border-2 border-ink bg-candle-soft p-4">
				<svg class="size-5 shrink-0 text-ink" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
				</svg>
				<p class="font-oswald text-sm text-ink">{ props.Notice }</p>
			</div>
		}
		if props.PriceChangeBanner {
			<div class="border-2 border-ink bg-candle-soft p-4">
				<p class="font-oswald text-sm text-ink">
					Some prices changed since you added items to your cart. Give it another look before continuing.
				</p>
			</div>
		}
		if len(props.MOQProblems) > 0 {
			<div class="border-2 border-rust bg-paper-warm p-4" role="alert">
				<p class="font-oswald font-bold text-sm text-rust uppercase" style="letter-spacing:0.1em;">Below wholesale minimums</p>
				<ul class="mt-2 space-y-1 font-oswald text-sm text-ink list-disc pl-5">
					for _, problem := range props.MOQProblems {
						<li>{ problem }</li>
					}
				</ul>
				<p class="mt-2 font-oswald text-sm text-ink-soft">Adjust the quantities below — the order can't go out until these are squared away.</p>
			</div>
		}
		if len(props.Items) == 0 {
			<div class="border-2 border-ink bg-cream-hi p-12 text-center" style="box-shadow: var(--shadow-stamp);">
				<p class="font-slab text-ink text-xl uppercase">Nothing here yet</p>
				<p class="mt-2 font-oswald text-chrome-deep text-sm">Your order is empty.</p>
				<a href="/wholesale/portal" class="mt-5 inline-block font-oswald font-bold text-xs text-rust hover:text-rust-deep" style="letter-spacing:0.16em; text-transform:uppercase;">
					&larr; Back to Quick Order
				</a>
			</div>
		} else {
			<!--
				Line-item summary — desktop renders a table; on mobile each row
				collapses into a labeled card (the same pattern as the quick-order
				portal) so there's no horizontal scroll.
			-->
			<div class="border-2 border-ink bg-cream-hi p-3 sm:p-0 sm:overflow-hidden" style="box-shadow: var(--shadow-stamp);">
				<table class="w-full block sm:table">
					<thead class="hidden sm:table-header-group">
						<tr class="border-b-2 border-ink bg-paper-warm text-left font-oswald font-bold text-[11px] text-ink" style="letter-spacing:0.14em; text-transform:uppercase;">
							<th class="px-4 py-3">Product</th>
							<th class="px-4 py-3">SKU</th>
							<th class="px-4 py-3 text-right">Unit Price</th>
							<th class="px-4 py-3 text-center">Qty</th>
							<th class="px-4 py-3 text-right">Total</th>
							<th class="px-4 py-3 w-10"></th>
						</tr>
					</thead>
					<tbody class="block sm:table-row-group">
						for _, item := range props.Items {
							<tr class="block border-2 border-ink mb-3 last:mb-0 px-3 py-2 sm:table-row sm:border-x-0 sm:border-t-0 sm:border-b sm:border-ink/15 sm:last:border-b-0 sm:p-0">
								<td class="block py-1 font-oswald font-bold text-ink text-base sm:table-cell sm:px-4 sm:py-3 sm:text-sm">{ item.ProductName }</td>
								<td class="flex items-center justify-between gap-4 py-1 sm:table-cell sm:px-4 sm:py-3">
									<span class="sm:hidden font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.12em;">SKU</span>
									<span class="font-special text-sm text-chrome-deep">{ item.SKU }</span>
								</td>
								<td class="flex items-center justify-between gap-4 py-1 sm:table-cell sm:px-4 sm:py-3 sm:text-right">
									<span class="sm:hidden font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.12em;">Unit Price</span>
									<span class="inline-flex flex-col items-end gap-0.5">
										<span class="font-special text-sm text-ink">{ formatCents(item.UnitPrice) }</span>
										if note := priceNoteFor(item); note.Kind != PriceNoteNone {
											<span
												class={ "font-oswald text-[11px] leading-snug text-right sm:max-w-[15rem]", priceNoteClass(note.Kind) }
												style="letter-spacing:0.02em;"
												if note.Kind == PriceNoteDrop {
													role="status"
												}
											>{ note.Text }</span>
										}
									</span>
								</td>
								<td class="flex items-center justify-between gap-4 py-1 sm:table-cell sm:px-4 sm:py-3 sm:text-center">
									<span class="sm:hidden font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.12em;">Qty</span>
									<span class="inline-flex flex-col items-end sm:items-center gap-0.5">
										<input
											type="number"
											name="quantity"
											value={ fmt.Sprint(item.Quantity) }
											min={ minQtyAttr(item.MinQty) }
											step={ multipleAttr(item.Multiple) }
											aria-label={ "Quantity for " + item.ProductName }
											class="paper-input w-16 border-2 border-ink bg-cream-hi px-2 py-1 text-center font-special text-sm text-ink focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
											style="box-shadow: var(--shadow-stamp-sm);"
											hx-post={ fmt.Sprintf("/wholesale/cart/update?item_id=%s", item.ItemID.String()) }
											hx-trigger="change"
											hx-target="#wholesale-checkout"
											hx-swap="outerHTML"
											hx-include="this"
										/>
										if hint := moqHint(item.MinQty, item.Multiple); hint != "" {
											<span class="font-oswald text-[10px] text-chrome-deep whitespace-nowrap" style="letter-spacing:0.04em;">{ hint }</span>
										}
									</span>
								</td>
								<td class="flex items-center justify-between gap-4 py-1 sm:table-cell sm:px-4 sm:py-3 sm:text-right">
									<span class="sm:hidden font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.12em;">Total</span>
									<span class="font-special text-base text-ink">{ formatCents(item.LineTotal) }</span>
								</td>
								<td class="flex justify-end pt-1 sm:table-cell sm:px-4 sm:py-3 sm:text-center sm:pt-3">
									<button
										type="button"
										class="inline-flex items-center gap-1.5 font-oswald font-bold text-[11px] text-chrome-deep hover:text-rust transition-colors sm:gap-0" style="letter-spacing:0.12em; text-transform:uppercase;"
										aria-label={ "Remove " + item.ProductName }
										hx-post={ fmt.Sprintf("/wholesale/cart/remove?item_id=%s", item.ItemID.String()) }
										hx-target="#wholesale-checkout"
										hx-swap="outerHTML"
									>
										<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
										</svg>
										<span class="sm:hidden">Remove</span>
									</button>
								</td>
							</tr>
						}
					</tbody>
					<tfoot class="block sm:table-footer-group">
						<tr class="flex items-center justify-between border-t-2 border-ink bg-paper-warm px-3 py-3 mt-3 sm:mt-0 sm:table-row">
							<td colspan="4" class="font-oswald font-bold text-ink sm:px-4 sm:py-3 sm:text-right" style="letter-spacing:0.1em; text-transform:uppercase;">Subtotal</td>
							<td class="font-special text-lg text-ink sm:px-4 sm:py-3 sm:text-right">{ formatCents(props.Subtotal) }</td>
							<td class="hidden sm:table-cell"></td>
						</tr>
					</tfoot>
				</table>
			</div>
			<form method="post" action="/wholesale/checkout/confirm" class="space-y-6" x-data={ wholesaleAddrXData(props) } x-effect="if (method === 'local_delivery' && !deliveryEligible) method = 'shipped'">
				<!-- Shipping -->
				<div class="border-2 border-ink bg-cream-hi p-6 space-y-4" style="box-shadow: var(--shadow-stamp);">
					<div>
						<h2 class="font-slab text-ink text-lg uppercase leading-none">Shipping Address</h2>
						<p class="mt-1.5 font-oswald text-chrome-deep text-sm">Where should we deliver this order?</p>
					</div>
					if len(props.Addresses) > 0 {
						<div class="space-y-2">
							for _, addr := range props.Addresses {
								<label class="flex items-start gap-3 border-2 border-ink bg-paper p-3 cursor-pointer hover:bg-paper-warm transition-colors">
									<input type="radio" name="shipping_address_id" value={ addr.ID.String() } x-model="shipMode" class="mt-1 accent-rust"/>
									@wholesaleAddrLabel(addr)
								</label>
							}
							<label class="flex items-center gap-3 border-2 border-ink bg-paper p-3 cursor-pointer hover:bg-paper-warm transition-colors">
								<input type="radio" name="shipping_address_id" value="new" x-model="shipMode" class="accent-rust"/>
								<span class="font-oswald font-semibold text-sm text-ink">Ship to a new address</span>
							</label>
						</div>
					}
					<div x-show="shipMode === 'new'" x-cloak>
						@wholesaleAddressFields("ship", "shipMode === 'new'", "newZip")
					</div>
				</div>
				<!-- Delivery method — every option is free; local delivery shows only
					when the ship-to ZIP is inside the local zone. -->
				<div class="border-2 border-ink bg-cream-hi p-6 space-y-4" style="box-shadow: var(--shadow-stamp);">
					<div>
						<h2 class="font-slab text-ink text-lg uppercase leading-none">Delivery Method</h2>
						<p class="mt-1.5 font-oswald text-chrome-deep text-sm">How should this order reach you? Every option is on us — no shipping charge.</p>
					</div>
					<div class="space-y-2">
						if props.LocalDeliveryEnabled {
							<label x-show="deliveryEligible" x-cloak class="flex items-start gap-3 border-2 border-ink bg-paper p-3 cursor-pointer hover:bg-paper-warm transition-colors">
								<input type="radio" name="fulfillment_method" value="local_delivery" x-model="method" class="mt-1 accent-rust"/>
								<span class="font-oswald text-sm text-ink leading-relaxed">
									<span class="font-bold">Free local delivery</span>
									if props.LocalDeliveryDate != "" {
										<br/>
										<span class="text-chrome-deep">{ "Out for delivery " + props.LocalDeliveryDate + "." }</span>
										if props.LocalDeliveryCutoff != "" {
											<br/>
											<span class="text-chrome-deep">{ "Orders in by " + props.LocalDeliveryCutoff + " ride that day's run." }</span>
										}
									} else if props.LocalDeliveryDays != "" {
										<br/>
										<span class="text-chrome-deep">{ "Out for delivery on " + props.LocalDeliveryDays + "." }</span>
									}
								</span>
							</label>
						}
						<label class="flex items-start gap-3 border-2 border-ink bg-paper p-3 cursor-pointer hover:bg-paper-warm transition-colors">
							<input type="radio" name="fulfillment_method" value="pickup" x-model="method" class="mt-1 accent-rust"/>
							<span class="font-oswald text-sm text-ink leading-relaxed">
								<span class="font-bold">Pickup at the shop</span>
								if props.LocalPickupInstructions != "" {
									<br/>
									<span class="text-chrome-deep">{ props.LocalPickupInstructions }</span>
								}
							</span>
						</label>
						<label class="flex items-start gap-3 border-2 border-ink bg-paper p-3 cursor-pointer hover:bg-paper-warm transition-colors">
							<input type="radio" name="fulfillment_method" value="shipped" x-model="method" class="mt-1 accent-rust"/>
							<span class="font-oswald text-sm text-ink leading-relaxed">
								<span class="font-bold">Free shipping</span>
								<br/>
								<span class="text-chrome-deep">We'll send it your way — shipping's on us.</span>
							</span>
						</label>
					</div>
				</div>
				<!-- Billing -->
				<div class="border-2 border-ink bg-cream-hi p-6 space-y-4" style="box-shadow: var(--shadow-stamp);">
					<h2 class="font-slab text-ink text-lg uppercase leading-none">Billing Address</h2>
					<label class="flex items-center gap-3 cursor-pointer">
						<input type="checkbox" name="billing_same" x-model="billSame" checked class="accent-rust"/>
						<span class="font-oswald text-sm text-ink">Billing address same as shipping</span>
					</label>
					<div x-show="!billSame" x-cloak class="space-y-4">
						if len(props.Addresses) > 0 {
							<div class="space-y-2">
								for _, addr := range props.Addresses {
									<label class="flex items-start gap-3 border-2 border-ink bg-paper p-3 cursor-pointer hover:bg-paper-warm transition-colors">
										<input type="radio" name="billing_address_id" value={ addr.ID.String() } x-model="billMode" class="mt-1 accent-rust"/>
										@wholesaleAddrLabel(addr)
									</label>
								}
								<label class="flex items-center gap-3 border-2 border-ink bg-paper p-3 cursor-pointer hover:bg-paper-warm transition-colors">
									<input type="radio" name="billing_address_id" value="new" x-model="billMode" class="accent-rust"/>
									<span class="font-oswald font-semibold text-sm text-ink">Use a new billing address</span>
								</label>
							</div>
						}
						<div x-show="billMode === 'new'" x-cloak>
							@wholesaleAddressFields("bill", "!billSame && billMode === 'new'", "")
						</div>
					</div>
				</div>
				<!-- PO + notes -->
				<div class="border-2 border-ink bg-cream-hi p-6 space-y-4" style="box-shadow: var(--shadow-stamp);">
					<div>
						<label for="po_number" class="block font-oswald font-bold text-[11px] text-ink uppercase" style="letter-spacing:0.16em;">PO Number (optional)</label>
						<input
							type="text"
							name="po_number"
							id="po_number"
							placeholder="Enter your purchase order number"
							class="paper-input mt-2 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
						/>
					</div>
					<div>
						<label for="notes" class="block font-oswald font-bold text-[11px] text-ink uppercase" style="letter-spacing:0.16em;">Order Notes (optional)</label>
						<textarea
							name="notes"
							id="notes"
							rows="3"
							placeholder="Any special instructions for this order"
							class="paper-input mt-2 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none"
						></textarea>
					</div>
				</div>
				<div class="flex items-center justify-between gap-4">
					<a href="/wholesale/portal" class="font-oswald font-bold text-xs text-rust hover:text-rust-deep" style="letter-spacing:0.16em; text-transform:uppercase;">
						&larr; Back to Quick Order
					</a>
					<button
						type="submit"
						class="btn-stamp inline-flex items-center border-2 border-ink bg-rust text-paper px-6 py-3 font-oswald font-bold text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rust"
						style="letter-spacing:0.16em; text-transform:uppercase;"
					>
						Place Order
					</button>
				</div>
				<p class="font-oswald text-chrome-deep text-xs text-center">
					An invoice will be sent after your order is confirmed. No payment is collected now.
				</p>
			</form>
		}
	</div>
}

// wholesaleAddrLabel renders a one-line summary of a saved address for the
// shipping/billing radio selectors.
templ wholesaleAddrLabel(addr domain.Address) {
	<span class="font-oswald text-sm text-ink leading-relaxed">
		if addr.FirstName != "" || addr.LastName != "" {
			<span class="font-bold">{ addr.FirstName } { addr.LastName }</span>
			<br/>
		}
		if addr.Company != nil {
			<span class="text-chrome-deep">{ *addr.Company }</span>
			<br/>
		}
		{ addr.Line1 }
		if addr.Line2 != nil {
			{ ", " + *addr.Line2 }
		}
		<br/>
		{ fmt.Sprintf("%s, %s %s", addr.City, addr.State, addr.PostalCode) }
	</span>
}

// wholesaleAddressFields renders the new-address inputs for a checkout section.
// Field names are namespaced by prefix ("ship"/"bill"). requiredExpr is an
// Alpine expression bound to required so the inputs only block submission while
// their section is visible. zipModel, when non-empty, binds the ZIP input to an
// Alpine model so the delivery-method gate reacts to the live ship-to ZIP.
templ wholesaleAddressFields(prefix string, requiredExpr string, zipModel string) {
	<div class="space-y-3">
		<input type="hidden" name={ prefix + "_country_code" } value="US"/>
		<div class="grid grid-cols-2 gap-3">
			<div>
				<label class="block font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.14em;">First name</label>
				<input type="text" name={ prefix + "_first_name" } class="paper-input mt-1.5 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink focus:outline-none"/>
			</div>
			<div>
				<label class="block font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.14em;">Last name</label>
				<input type="text" name={ prefix + "_last_name" } class="paper-input mt-1.5 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink focus:outline-none"/>
			</div>
		</div>
		<div>
			<label class="block font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.14em;">Company (optional)</label>
			<input type="text" name={ prefix + "_company" } class="paper-input mt-1.5 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink focus:outline-none"/>
		</div>
		<div>
			<label class="block font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.14em;">Address</label>
			<input type="text" name={ prefix + "_line1" } x-bind:required={ requiredExpr } class="paper-input mt-1.5 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink focus:outline-none"/>
		</div>
		<div>
			<label class="block font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.14em;">Apt, suite, etc. (optional)</label>
			<input type="text" name={ prefix + "_line2" } class="paper-input mt-1.5 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink focus:outline-none"/>
		</div>
		<div class="grid grid-cols-3 gap-3">
			<div>
				<label class="block font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.14em;">City</label>
				<input type="text" name={ prefix + "_city" } x-bind:required={ requiredExpr } class="paper-input mt-1.5 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink focus:outline-none"/>
			</div>
			<div>
				<label class="block font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.14em;">State</label>
				<input type="text" name={ prefix + "_state" } x-bind:required={ requiredExpr } class="paper-input mt-1.5 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink focus:outline-none"/>
			</div>
			<div>
				<label class="block font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.14em;">ZIP</label>
				if zipModel != "" {
					<input type="text" name={ prefix + "_postal_code" } x-model={ zipModel } x-bind:required={ requiredExpr } class="paper-input mt-1.5 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink focus:outline-none"/>
				} else {
					<input type="text" name={ prefix + "_postal_code" } x-bind:required={ requiredExpr } class="paper-input mt-1.5 block w-full border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink focus:outline-none"/>
				}
			</div>
		</div>
	</div>
}

templ WholesaleCheckoutPage(props WholesaleCheckoutProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:     "Review Order",
		CartURL:   "/wholesale/checkout",
		CartCount: props.CartCount,
	}) {
		@WholesaleCheckoutContent(props)
	}
}
