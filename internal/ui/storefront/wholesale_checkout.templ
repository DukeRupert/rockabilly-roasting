package storefront

import (
	"fmt"
	"github.com/google/uuid"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type WholesaleCheckoutItem struct {
	ItemID      uuid.UUID
	VariantID   uuid.UUID
	ProductName string
	SKU         string
	Quantity    int
	UnitPrice   int
	LineTotal   int
}

type WholesaleCheckoutProps struct {
	CompanyName       string
	Items             []WholesaleCheckoutItem
	Subtotal          int
	Error             string
	CartCount         int
	PriceChangeBanner bool
	Addresses         []domain.Address
	// DefaultAddressID preselects a saved address for shipping; empty means
	// the "new address" form is shown by default (e.g. customer has none).
	DefaultAddressID string
}

// wholesaleAddrXData seeds the Alpine state for the checkout address step:
// shipMode is a saved address ID or "new", billing defaults to "same as
// shipping", and the billing selector starts on the new-address form.
func wholesaleAddrXData(props WholesaleCheckoutProps) string {
	ship := "new"
	if props.DefaultAddressID != "" {
		ship = props.DefaultAddressID
	}
	return fmt.Sprintf("{ shipMode: '%s', billSame: true, billMode: 'new' }", ship)
}

templ WholesaleCheckoutContent(props WholesaleCheckoutProps) {
	<div id="wholesale-checkout" class="mx-auto max-w-3xl space-y-6">
		<div>
			<h1 class="font-display text-2xl tracking-widest text-rr-heading">REVIEW ORDER</h1>
			<p class="mt-1 text-sm text-rr-muted">
				Review your wholesale order before submitting.
			</p>
		</div>
		if props.Error != "" {
			<div class="rounded-sm bg-rr-red/10 border border-rr-red/20 p-4">
				<p class="text-sm font-body text-rr-red-lt">{ props.Error }</p>
			</div>
		}
		if props.PriceChangeBanner {
			<div class="rounded-sm bg-rr-amber/10 border border-rr-amber/30 p-4">
				<p class="text-sm font-body text-rr-heading">
					Some prices changed since you added items to your cart. Please review your cart before continuing.
				</p>
			</div>
		}
		if len(props.Items) == 0 {
			<div class="rounded-sm border border-rr-border bg-rr-surface p-12 text-center">
				<p class="text-sm text-rr-muted">Your order is empty.</p>
				<a href="/wholesale/portal" class="mt-4 inline-block text-sm font-semibold text-rr-red hover:text-rr-red-lt">
					&larr; Back to Quick Order
				</a>
			</div>
		} else {
			<div class="rounded-sm border border-rr-border bg-rr-surface overflow-hidden">
				<table class="min-w-full divide-y divide-rr-border">
					<thead>
						<tr class="bg-rr-bg text-left text-xs font-medium uppercase tracking-wider text-rr-muted">
							<th class="px-4 py-3">Product</th>
							<th class="px-4 py-3">SKU</th>
							<th class="px-4 py-3 text-right">Unit Price</th>
							<th class="px-4 py-3 text-center">Qty</th>
							<th class="px-4 py-3 text-right">Total</th>
							<th class="px-4 py-3 w-10"></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rr-border">
						for _, item := range props.Items {
							<tr>
								<td class="px-4 py-3 text-sm text-rr-heading">{ item.ProductName }</td>
								<td class="px-4 py-3 text-sm font-mono text-rr-muted">{ item.SKU }</td>
								<td class="px-4 py-3 text-sm text-right text-rr-heading">{ formatCents(item.UnitPrice) }</td>
								<td class="px-4 py-3 text-center">
									<input
										type="number"
										name="quantity"
										value={ fmt.Sprint(item.Quantity) }
										min="1"
										class="rr-input w-16 rounded-sm border border-rr-border bg-rr-bg px-2 py-1 text-center text-sm text-rr-heading focus:outline-none"
										hx-post={ fmt.Sprintf("/wholesale/cart/update?item_id=%s", item.ItemID.String()) }
										hx-trigger="change"
										hx-target="#wholesale-checkout"
										hx-swap="outerHTML"
										hx-include="this"
									/>
								</td>
								<td class="px-4 py-3 text-sm text-right font-medium text-rr-heading">{ formatCents(item.LineTotal) }</td>
								<td class="px-4 py-3 text-center">
									<button
										type="button"
										class="text-rr-muted hover:text-rr-red"
										hx-post={ fmt.Sprintf("/wholesale/cart/remove?item_id=%s", item.ItemID.String()) }
										hx-target="#wholesale-checkout"
										hx-swap="outerHTML"
									>
										<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
										</svg>
									</button>
								</td>
							</tr>
						}
					</tbody>
					<tfoot>
						<tr class="border-t-2 border-rr-border bg-rr-bg">
							<td colspan="4" class="px-4 py-3 text-sm font-semibold text-rr-heading text-right">Subtotal</td>
							<td class="px-4 py-3 text-sm font-bold text-rr-heading text-right">{ formatCents(props.Subtotal) }</td>
							<td></td>
						</tr>
					</tfoot>
				</table>
			</div>
			<form method="post" action="/wholesale/checkout/confirm" class="space-y-4" x-data={ wholesaleAddrXData(props) }>
				<div class="rounded-sm border border-rr-border bg-rr-surface p-6 space-y-4">
					<div>
						<h2 class="font-display text-lg tracking-wide text-rr-heading">SHIPPING ADDRESS</h2>
						<p class="mt-1 text-sm text-rr-muted">Where should we deliver this order?</p>
					</div>
					if len(props.Addresses) > 0 {
						<div class="space-y-2">
							for _, addr := range props.Addresses {
								<label class="flex items-start gap-3 rounded-sm border border-rr-border bg-rr-bg p-3 cursor-pointer">
									<input type="radio" name="shipping_address_id" value={ addr.ID.String() } x-model="shipMode" class="mt-1 text-rr-red focus:ring-rr-red"/>
									@wholesaleAddrLabel(addr)
								</label>
							}
							<label class="flex items-center gap-3 rounded-sm border border-rr-border bg-rr-bg p-3 cursor-pointer">
								<input type="radio" name="shipping_address_id" value="new" x-model="shipMode" class="text-rr-red focus:ring-rr-red"/>
								<span class="text-sm font-medium text-rr-heading">Ship to a new address</span>
							</label>
						</div>
					}
					<div x-show="shipMode === 'new'" x-cloak>
						@wholesaleAddressFields("ship", "shipMode === 'new'")
					</div>
				</div>
				<div class="rounded-sm border border-rr-border bg-rr-surface p-6 space-y-4">
					<h2 class="font-display text-lg tracking-wide text-rr-heading">BILLING ADDRESS</h2>
					<label class="flex items-center gap-3 cursor-pointer">
						<input type="checkbox" name="billing_same" x-model="billSame" checked class="rounded-sm text-rr-red focus:ring-rr-red"/>
						<span class="text-sm text-rr-heading">Billing address same as shipping</span>
					</label>
					<div x-show="!billSame" x-cloak class="space-y-4">
						if len(props.Addresses) > 0 {
							<div class="space-y-2">
								for _, addr := range props.Addresses {
									<label class="flex items-start gap-3 rounded-sm border border-rr-border bg-rr-bg p-3 cursor-pointer">
										<input type="radio" name="billing_address_id" value={ addr.ID.String() } x-model="billMode" class="mt-1 text-rr-red focus:ring-rr-red"/>
										@wholesaleAddrLabel(addr)
									</label>
								}
								<label class="flex items-center gap-3 rounded-sm border border-rr-border bg-rr-bg p-3 cursor-pointer">
									<input type="radio" name="billing_address_id" value="new" x-model="billMode" class="text-rr-red focus:ring-rr-red"/>
									<span class="text-sm font-medium text-rr-heading">Use a new billing address</span>
								</label>
							</div>
						}
						<div x-show="billMode === 'new'" x-cloak>
							@wholesaleAddressFields("bill", "!billSame && billMode === 'new'")
						</div>
					</div>
				</div>
				<div class="rounded-sm border border-rr-border bg-rr-surface p-6 space-y-4">
					<div>
						<label for="po_number" class="block text-sm font-medium text-rr-heading">PO Number (optional)</label>
						<input
							type="text"
							name="po_number"
							id="po_number"
							placeholder="Enter your purchase order number"
							class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading placeholder:text-rr-faint focus:outline-none sm:text-sm"
						/>
					</div>
					<div>
						<label for="notes" class="block text-sm font-medium text-rr-heading">Order Notes (optional)</label>
						<textarea
							name="notes"
							id="notes"
							rows="3"
							placeholder="Any special instructions for this order"
							class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading placeholder:text-rr-faint focus:outline-none sm:text-sm"
						></textarea>
					</div>
				</div>
				<div class="flex items-center justify-between">
					<a href="/wholesale/portal" class="text-sm font-semibold text-rr-red hover:text-rr-red-lt">
						&larr; Back to Quick Order
					</a>
					<button
						type="submit"
						class="btn inline-flex items-center rounded-sm bg-rr-red px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
					>
						Place Order
					</button>
				</div>
				<p class="text-xs text-rr-muted text-center">
					An invoice will be sent after your order is confirmed. No payment is collected now.
				</p>
			</form>
		}
	</div>
}

// wholesaleAddrLabel renders a one-line summary of a saved address for the
// shipping/billing radio selectors.
templ wholesaleAddrLabel(addr domain.Address) {
	<span class="text-sm text-rr-heading">
		if addr.FirstName != "" || addr.LastName != "" {
			<span class="font-medium">{ addr.FirstName } { addr.LastName }</span>
			<br/>
		}
		if addr.Company != nil {
			<span class="text-rr-muted">{ *addr.Company }</span>
			<br/>
		}
		{ addr.Line1 }
		if addr.Line2 != nil {
			{ ", " + *addr.Line2 }
		}
		<br/>
		{ fmt.Sprintf("%s, %s %s", addr.City, addr.State, addr.PostalCode) }
	</span>
}

// wholesaleAddressFields renders the new-address inputs for a checkout section.
// Field names are namespaced by prefix ("ship"/"bill"). requiredExpr is an
// Alpine expression bound to required so the inputs only block submission while
// their section is visible.
templ wholesaleAddressFields(prefix string, requiredExpr string) {
	<div class="space-y-3">
		<input type="hidden" name={ prefix + "_country_code" } value="US"/>
		<div class="grid grid-cols-2 gap-3">
			<div>
				<label class="block text-xs font-medium uppercase tracking-wider text-rr-muted">First name</label>
				<input type="text" name={ prefix + "_first_name" } class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading focus:outline-none sm:text-sm"/>
			</div>
			<div>
				<label class="block text-xs font-medium uppercase tracking-wider text-rr-muted">Last name</label>
				<input type="text" name={ prefix + "_last_name" } class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading focus:outline-none sm:text-sm"/>
			</div>
		</div>
		<div>
			<label class="block text-xs font-medium uppercase tracking-wider text-rr-muted">Company (optional)</label>
			<input type="text" name={ prefix + "_company" } class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading focus:outline-none sm:text-sm"/>
		</div>
		<div>
			<label class="block text-xs font-medium uppercase tracking-wider text-rr-muted">Address</label>
			<input type="text" name={ prefix + "_line1" } x-bind:required={ requiredExpr } class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading focus:outline-none sm:text-sm"/>
		</div>
		<div>
			<label class="block text-xs font-medium uppercase tracking-wider text-rr-muted">Apt, suite, etc. (optional)</label>
			<input type="text" name={ prefix + "_line2" } class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading focus:outline-none sm:text-sm"/>
		</div>
		<div class="grid grid-cols-3 gap-3">
			<div>
				<label class="block text-xs font-medium uppercase tracking-wider text-rr-muted">City</label>
				<input type="text" name={ prefix + "_city" } x-bind:required={ requiredExpr } class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading focus:outline-none sm:text-sm"/>
			</div>
			<div>
				<label class="block text-xs font-medium uppercase tracking-wider text-rr-muted">State</label>
				<input type="text" name={ prefix + "_state" } x-bind:required={ requiredExpr } class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading focus:outline-none sm:text-sm"/>
			</div>
			<div>
				<label class="block text-xs font-medium uppercase tracking-wider text-rr-muted">ZIP</label>
				<input type="text" name={ prefix + "_postal_code" } x-bind:required={ requiredExpr } class="rr-input mt-1 block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-2 text-rr-heading focus:outline-none sm:text-sm"/>
			</div>
		</div>
	</div>
}

templ WholesaleCheckoutPage(props WholesaleCheckoutProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:     "Review Order",
		CartURL:   "/wholesale/checkout",
		CartCount: props.CartCount,
	}) {
		@WholesaleCheckoutContent(props)
	}
}
