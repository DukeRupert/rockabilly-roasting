package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type WholesaleLoginProps struct {
	Error string
	Email string
}

templ WholesaleLoginContent(props WholesaleLoginProps) {
	<div class="mx-auto max-w-sm">
		<div class="text-center">
			<h1 class="text-2xl font-bold text-hiri-text">Wholesale Sign In</h1>
			<p class="mt-2 text-sm text-hiri-text-secondary">
				Sign in to your wholesale account to place orders.
			</p>
		</div>
		if props.Error != "" {
			<div class="mt-4 rounded-md bg-red-50 p-3">
				<p class="text-sm text-red-700">{ props.Error }</p>
			</div>
		}
		<form method="post" action="/wholesale/login" class="mt-8 space-y-5">
			<div>
				<label for="email" class="block text-sm font-medium text-hiri-text">Email</label>
				<input
					type="email"
					name="email"
					id="email"
					required
					value={ props.Email }
					class="mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-hiri-teal focus:ring-hiri-teal sm:text-sm"
				/>
			</div>
			<div>
				<label for="password" class="block text-sm font-medium text-hiri-text">Password</label>
				<input
					type="password"
					name="password"
					id="password"
					required
					class="mt-1 block w-full rounded-md border-stone-300 shadow-sm focus:border-hiri-teal focus:ring-hiri-teal sm:text-sm"
				/>
			</div>
			<div class="flex items-center justify-between">
				<div class="flex items-center">
					<input type="checkbox" name="remember_me" id="remember_me" class="size-4 rounded border-stone-300 text-hiri-teal focus:ring-hiri-teal"/>
					<label for="remember_me" class="ml-2 text-sm text-hiri-text-secondary">Remember me</label>
				</div>
			</div>
			<button
				type="submit"
				class="flex w-full justify-center rounded-md bg-hiri-teal px-3 py-3 text-sm font-semibold text-white shadow-sm hover:bg-hiri-teal-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-hiri-teal"
			>
				Sign in
			</button>
		</form>
		<p class="mt-6 text-center text-sm text-hiri-text-secondary">
			Don't have a wholesale account?
			<a href="/wholesale/apply" class="font-semibold text-hiri-teal hover:text-hiri-teal-dark">Apply here</a>
		</p>
	</div>
}

templ WholesaleLoginPage(props WholesaleLoginProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title: "Wholesale Sign In",
	}) {
		@WholesaleLoginContent(props)
	}
}
