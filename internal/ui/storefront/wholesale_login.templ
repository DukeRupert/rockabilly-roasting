package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

type WholesaleLoginProps struct {
	Error string
	Email string
}

templ WholesaleLoginContent(props WholesaleLoginProps) {
	<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
		<div class="sm:mx-auto sm:w-full sm:max-w-md">
			<h2 class="text-center text-2xl/9 font-bold tracking-tight text-rr-heading">Wholesale Sign In</h2>
			<p class="mt-2 text-center text-sm/6 text-rr-muted">
				Sign in to your wholesale account to place orders.
			</p>
		</div>
		<div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
			<div class="bg-rr-surface px-6 py-12 shadow-sm sm:rounded-sm sm:px-12">
				if props.Error != "" {
					<div class="mb-6 rounded-sm bg-rr-red/10 border border-rr-red/20 p-3">
						<p class="text-sm/6 font-body text-rr-red-lt">{ props.Error }</p>
					</div>
				}
				<form method="post" action="/wholesale/login" class="space-y-6">
					<div>
						<label for="email" class="block text-sm/6 font-medium text-rr-body">Email address</label>
						<div class="mt-2">
							<input
								type="email"
								name="email"
								id="email"
								required
								autocomplete="email"
								value={ props.Email }
								class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-base text-rr-heading placeholder:text-rr-faint focus:outline-none sm:text-sm/6"
							/>
						</div>
					</div>
					<div>
						<label for="password" class="block text-sm/6 font-medium text-rr-body">Password</label>
						<div class="mt-2">
							<input
								type="password"
								name="password"
								id="password"
								required
								autocomplete="current-password"
								class="rr-input block w-full rounded-sm border border-rr-border bg-rr-bg px-3 py-1.5 text-base text-rr-heading placeholder:text-rr-faint focus:outline-none sm:text-sm/6"
							/>
						</div>
					</div>
					<div class="flex items-center justify-between">
						<div class="flex gap-3">
							<div class="flex h-6 shrink-0 items-center">
								<input type="checkbox" name="remember_me" id="remember_me" class="size-4 rounded-sm border border-rr-border bg-rr-bg checked:border-rr-red checked:bg-rr-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"/>
							</div>
							<label for="remember_me" class="block text-sm/6 text-rr-body">Remember me</label>
						</div>
					</div>
					<div>
						<button
							type="submit"
							class="btn flex w-full justify-center rounded-sm bg-rr-red px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
						>
							Sign in
						</button>
					</div>
				</form>
			</div>
			<p class="mt-10 text-center text-sm/6 text-rr-muted">
				Don't have a wholesale account?
				<a href="/wholesale/apply" class="font-semibold text-rr-red hover:text-rr-red-lt">Apply here</a>
			</p>
		</div>
	</div>
}

templ WholesaleLoginPage(props WholesaleLoginProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title: "Wholesale Sign In",
	}) {
		@WholesaleLoginContent(props)
	}
}
