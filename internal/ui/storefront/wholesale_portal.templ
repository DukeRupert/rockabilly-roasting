package storefront

import (
	"fmt"
	"github.com/google/uuid"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

type QuickOrderVariant struct {
	ID           uuid.UUID
	SKU          string
	OptionValues []string
	UnitPrice    int
	MinQty       *int
	Multiple     *int
	InStock      bool
}

type QuickOrderProduct struct {
	ID       uuid.UUID
	Title    string
	ImageURL string
	Options  []string
	Variants []QuickOrderVariant
}

type WholesalePortalProps struct {
	CompanyName string
	Products    []QuickOrderProduct
	CartCount   int
}

templ WholesalePortalContent(props WholesalePortalProps) {
	<div class="space-y-6">
		<!-- Header -->
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-2xl font-bold text-rr-heading">Quick Order</h1>
				<p class="mt-1 text-sm text-rr-muted">
					Welcome back, { props.CompanyName }. Enter quantities and add to your order.
				</p>
			</div>
			<a
				href="/wholesale/checkout"
				class="btn inline-flex items-center rounded-sm bg-rr-red px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt"
			>
				Review Order
				<svg class="ml-2 -mr-0.5 size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
				</svg>
			</a>
		</div>
		<!-- Quick order form -->
		<form method="post" action="/wholesale/portal/bulk-add">
			if len(props.Products) == 0 {
				<div class="rounded-sm border border-rr-border bg-rr-surface p-12 text-center">
					<p class="text-sm text-rr-muted">No products available at this time.</p>
				</div>
			}
			for _, product := range props.Products {
				<div class="rounded-sm border border-rr-border bg-rr-surface overflow-hidden">
					<!-- Product header -->
					<div class="flex items-center gap-4 border-b border-rr-border bg-rr-bg px-4 py-3">
						if product.ImageURL != "" {
							<img
								src={ product.ImageURL }
								alt={ product.Title }
								class="size-12 rounded-sm object-cover"
							/>
						} else {
							<div class="flex size-12 items-center justify-center rounded-sm bg-rr-raised">
								<svg class="size-6 text-rr-muted" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"></path>
								</svg>
							</div>
						}
						<h2 class="text-lg font-semibold text-rr-heading">{ product.Title }</h2>
					</div>
					<!-- Variant table -->
					<div class="overflow-x-auto">
						<table class="min-w-full divide-y divide-rr-border">
							<thead>
								<tr class="bg-rr-bg text-left text-xs font-medium uppercase tracking-wider text-rr-muted">
									<th class="px-4 py-2">Code</th>
									for _, optName := range product.Options {
										<th class="px-4 py-2">{ optName }</th>
									}
									<th class="px-4 py-2">Unit Price</th>
									<th class="px-4 py-2 text-center">Qty</th>
									<th class="px-4 py-2">Stock</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-rr-border">
								for _, variant := range product.Variants {
									<tr class="hover:bg-rr-bg/50">
										<td class="whitespace-nowrap px-4 py-2 text-sm font-mono text-rr-muted">
											{ variant.SKU }
										</td>
										for _, val := range variant.OptionValues {
											<td class="whitespace-nowrap px-4 py-2 text-sm text-rr-heading">
												{ val }
											</td>
										}
										<td class="whitespace-nowrap px-4 py-2 text-sm font-medium text-rr-heading">
											{ formatCents(variant.UnitPrice) }
											if variant.MinQty != nil {
												<span class="ml-1 text-xs text-rr-muted">
													(min { fmt.Sprint(*variant.MinQty) })
												</span>
											}
										</td>
										<td class="px-4 py-2 text-center">
											<input
												type="number"
												name={ fmt.Sprintf("qty[%s]", variant.ID.String()) }
												min="0"
												step={
													func() string {
														if variant.Multiple != nil && *variant.Multiple > 1 {
															return fmt.Sprint(*variant.Multiple)
														}
														return "1"
													}()
												}
												placeholder="0"
												aria-label={ "Quantity for " + variant.SKU }
												class="rr-input w-20 rounded-sm border border-rr-border bg-rr-bg px-2 py-1.5 text-center text-sm text-rr-heading focus:outline-none"
											/>
										</td>
										<td class="whitespace-nowrap px-4 py-2">
											if variant.InStock {
												<span class="inline-flex items-center rounded-sm bg-rr-teal/10 px-2 py-0.5 text-xs font-medium text-rr-teal-lt">
													In Stock
												</span>
											} else {
												<span class="inline-flex items-center rounded-sm bg-rr-red/10 px-2 py-0.5 text-xs font-medium text-rr-red-lt">
													Out of Stock
												</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
			if len(props.Products) > 0 {
				<!-- Sticky bottom bar -->
				<div class="sticky bottom-0 flex items-center justify-end gap-4 rounded-sm border border-rr-border bg-rr-surface px-6 py-4 shadow-lg">
					<button
						type="submit"
						class="btn inline-flex items-center rounded-sm bg-rr-red px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-rr-red-lt focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rr-red"
					>
						Add to Order
					</button>
				</div>
			}
		</form>
	</div>
}

templ WholesalePortalPage(props WholesalePortalProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:     "Quick Order",
		CartURL:   "/wholesale/checkout",
		CartCount: props.CartCount,
	}) {
		@WholesalePortalContent(props)
	}
}
