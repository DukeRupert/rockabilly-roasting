package storefront

import (
	"fmt"
	"strings"
	"time"

	"github.com/google/uuid"
	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// quickOrderFilterText is the lowercase haystack a product card is matched
// against by the client-side sheet filter: title, SKUs, and option values.
func quickOrderFilterText(p QuickOrderProduct) string {
	parts := []string{strings.ToLower(p.Title)}
	for _, v := range p.Variants {
		parts = append(parts, strings.ToLower(v.SKU))
		for _, ov := range v.OptionValues {
			parts = append(parts, strings.ToLower(ov))
		}
	}
	return strings.Join(parts, " ")
}

type QuickOrderVariant struct {
	ID           uuid.UUID
	SKU          string
	OptionValues []string
	UnitPrice    int
	MinQty       *int
	Multiple     *int
	// CartQty is what's already in the buyer's cart for this variant; the row
	// pre-fills with it so the sheet reflects the current order.
	CartQty int
	// Ladder is the customer's volume ladder for this variant. The sheet prices
	// rows as the buyer types, so it carries the whole ladder rather than one
	// resolved price.
	Ladder domain.TierLadder
}

type QuickOrderProduct struct {
	ID       uuid.UUID
	Title    string
	ImageURL string
	Options  []string
	Variants []QuickOrderVariant
}

// PortalLastOrder summarizes the buyer's most recent order for the one-click
// reorder shortcut at the top of the sheet.
type PortalLastOrder struct {
	ID       uuid.UUID
	Number   string
	PlacedAt time.Time
	Total    int
}

type WholesalePortalProps struct {
	CompanyName string
	Products    []QuickOrderProduct
	CartCount   int
	LastOrder   *PortalLastOrder
}

templ WholesalePortalContent(props WholesalePortalProps) {
	<div class="space-y-8 py-8 sm:py-10">
		<!-- Header -->
		<div class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-ink pb-5">
			<div>
				<p class="font-oswald font-semibold text-chrome-deep text-[11px]" style="letter-spacing:0.24em; text-transform:uppercase;">The Crew · Wholesale</p>
				<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(2rem, 4.5vw, 3rem); letter-spacing:-0.005em;">Quick Order</h1>
				<p class="mt-3 font-oswald text-ink-soft text-base leading-relaxed max-w-lg">
					Welcome back, { props.CompanyName } — enter quantities below and stack your order.
				</p>
				<a href="/wholesale/account/orders" class="mt-3 inline-flex items-center gap-1.5 font-oswald font-bold text-[11px] text-rust hover:text-rust-deep transition-colors" style="letter-spacing:0.18em; text-transform:uppercase;">
					Order history &amp; account
					<svg class="size-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
					</svg>
				</a>
			</div>
			<a
				href="/wholesale/checkout"
				class="inline-flex items-center gap-2 border-2 border-ink bg-paper text-ink px-4 py-2.5 font-oswald font-bold text-xs hover:bg-ink hover:text-paper transition-colors"
				style="letter-spacing:0.16em; text-transform:uppercase; box-shadow: var(--shadow-stamp-sm);"
			>
				Review Order
				if props.CartCount > 0 {
					<span class="font-special text-rust">({ fmt.Sprint(props.CartCount) })</span>
				}
				<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
				</svg>
			</a>
		</div>
		<!--
			One-click restock: shown only while the order is empty — once the
			buyer starts building a sheet, pinning it to a past order from up
			here would silently rewrite their work.
		-->
		if props.LastOrder != nil && props.CartCount == 0 {
			<div class="flex flex-wrap items-center justify-between gap-4 border-2 border-ink bg-candle-soft px-5 py-4" style="box-shadow: var(--shadow-stamp);">
				<div>
					<p class="font-oswald font-bold text-ink text-sm" style="letter-spacing:0.06em;">Same as last time?</p>
					<p class="mt-0.5 font-oswald text-ink-soft text-sm">
						Load your order from { formatDate(props.LastOrder.PlacedAt) } — { props.LastOrder.Number }, { formatCents(props.LastOrder.Total) } — and review it before it goes out.
					</p>
				</div>
				<form method="POST" action={ templ.SafeURL("/wholesale/account/orders/" + props.LastOrder.ID.String() + "/reorder") }>
					<button type="submit" class="btn-stamp inline-flex items-center gap-2 border-2 border-ink bg-paper text-ink px-4 py-2.5 font-oswald font-bold text-xs hover:bg-ink hover:text-paper transition-colors" style="letter-spacing:0.16em; text-transform:uppercase;">
						<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"></path>
						</svg>
						Reorder Last Order
					</button>
				</form>
			</div>
		}
		<!-- Quick order form -->
		<!--
			The sheet IS the order: rows pre-fill with the cart's current
			quantities and bulk-add uses set semantics, so what's on screen is
			exactly what's in the order — resubmitting never doubles lines and
			clearing a row removes it. Each qty input carries its unit price in
			data-price and pings recompute() on input, so the sticky bar shows a
			running unit count + subtotal client-side — no server round-trip.
			Prices match the catalog the page was rendered with; checkout
			re-resolves and flags any drift.
		-->
		<form
			method="post"
			action="/wholesale/portal/bulk-add"
			class="space-y-6"
			data-nudge-pct={ nudgePctAttr() }
			data-nudge-floor={ nudgeFloorAttr() }
			x-data="{
				units: 0,
				cents: 0,
				q: '',
				match(hay) { const n = this.q.toLowerCase().trim(); return !n || hay.includes(n); },
				get hits() { return Array.from(this.$root.querySelectorAll('[data-filter]')).filter(el => this.match(el.dataset.filter)).length; },
				// --- Volume pricing, mirrored from domain.TierLadder ---
				// The sheet reprices as the buyer types, so it has to pick rungs
				// client-side. This is a display echo only: every write goes
				// through the server, which prices the line from the same ladder
				// and reprices it if these two ever disagree.
				rungs(el) { try { return JSON.parse(el.dataset.ladder || '[]'); } catch { return []; } },
				ceilTo(n, k) { return k < 2 ? n : n + ((k - n % k) % k); },
				unitPriceAt(rungs, q) {
					if (!rungs.length) return 0;
					let price = rungs[0][1];
					for (const [min, amt] of rungs) { if (min > q) break; price = amt; }
					return price;
				},
				// Mirrors TierLadder.TierAt: the highest break the quantity has
					// reached, or 0 while it is still on the base price.
					activeRung(rungs, q) {
						let active = 0;
						for (const [min] of rungs) { if (min > q) break; if (min > 1) active = min; }
						return active;
					},
					// Mirrors TierLadder.Upgrade: round the target up to a whole case
				// so the ask is orderable, price the rounded target rather than
				// the rung it aimed at, and widen the window to one case for the
				// same reason.
				upgrade(rungs, q, mult) {
					if (q < 1) return null;
					const next = rungs.find(([min]) => min > q);
					if (!next) return null;
					const m = mult > 0 ? mult : 1;
					const target = this.ceilTo(next[0], m);
					const cur = this.unitPriceAt(rungs, q), tgt = this.unitPriceAt(rungs, target);
					if (tgt >= cur) return null;
					const add = target - q;
					const pct = parseFloat(this.$root.dataset.nudgePct) || 0;
					const floor = parseInt(this.$root.dataset.nudgeFloor, 10) || 0;
					if (add > this.ceilTo(Math.max(floor, Math.ceil(pct * next[0])), m)) return null;
					return { add, target, unit: tgt, unitSaving: cur - tgt, totalSaving: q * cur - target * tgt };
				},
				nudgeText(u) {
					const more = u.add === 1 ? 'more' : 'more';
					return u.totalSaving > 0
						? 'Add ' + u.add + ' ' + more + ' and pay ' + this.money(u.totalSaving) + ' less — ' + this.money(u.unit) + ' each at ' + u.target + '+.'
						: 'Add ' + u.add + ' ' + more + ' to reach ' + this.money(u.unit) + ' each — ' + this.money(u.unitSaving) + ' off every unit.';
				},
				recompute() {
					let units = 0, cents = 0;
					this.$root.querySelectorAll('input[data-ladder]').forEach(el => {
						const q = parseInt(el.value, 10) || 0;
						// Flag quantities that break the wholesale minimum or case
						// multiple via native validation, so submit stops at the
						// offending input with a plain message instead of a server
						// rejection later.
						const min = parseInt(el.dataset.min, 10) || 0;
						const mult = parseInt(el.dataset.mult, 10) || 0;
						let problem = '';
						if (q > 0 && min && q < min) problem = 'Minimum for this item is ' + min + '.';
						else if (q > 0 && mult && q % mult !== 0) problem = 'This item comes in multiples of ' + mult + '.';
						el.setCustomValidity(problem);

						// Unit price is a function of quantity now, so the row's
						// price is recomputed rather than read off a fixed value.
						const rungs = this.rungs(el);
						const row = el.closest('tr');
						const price = this.unitPriceAt(rungs, q > 0 ? q : (min || 1));
						const unitCell = row?.querySelector('[data-unit-price]');
						if (unitCell) unitCell.textContent = this.money(price);

						// One slot: the nudge when a break is within reach, the
						// ladder otherwise. Never both.
						const u = this.upgrade(rungs, q, mult);
						const ladderNote = row?.querySelector('[data-ladder-note]');
						const nudgeNote = row?.querySelector('[data-nudge-note]');
						if (ladderNote && nudgeNote) {
							nudgeNote.textContent = u ? this.nudgeText(u) : '';
							nudgeNote.classList.toggle('hidden', !u);
							ladderNote.classList.toggle('hidden', !!u);
						}
						// Move the weight onto the rung this quantity has earned.
						// Only classes move — the rung text is Go's to write.
						const active = this.activeRung(rungs, q);
						row?.querySelectorAll('[data-rung]').forEach(r => {
							const on = parseInt(r.dataset.rung, 10) === active;
							r.classList.toggle('text-ink', on);
							r.classList.toggle('font-semibold', on);
							r.classList.toggle('text-ink-soft', !on);
						});

						// Extended price per row, so a buyer working to a budget
						// never does qty × unit in their head.
						const lineTotal = row?.querySelector('[data-line-total]');
						if (lineTotal) lineTotal.textContent = q > 0 ? this.money(q * price) : '—';
						if (q > 0) { units += q; cents += q * price; }
					});
					this.units = units;
					this.cents = cents;
				},
				money(c) { return '$' + (c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); },
			}"
			x-init="recompute()"
		>
			<!--
				Sheet filter — client-side only, so filtered-out rows keep their
				values and still submit with the form. Enter is swallowed so a
				quick search never submits the order.
			-->
			if len(props.Products) > 5 {
				<div class="flex items-center gap-3">
					<input
						type="search"
						placeholder="Filter the sheet — coffee, SKU, grind…"
						aria-label="Filter products"
						x-model="q"
						x-on:keydown.enter.prevent
						class="paper-input w-full max-w-sm border-2 border-ink bg-cream-hi px-3 py-2 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none focus:bg-paper"
						style="box-shadow: var(--shadow-stamp-sm);"
					/>
					<p class="font-oswald text-chrome-deep text-xs" x-show="q" x-cloak>
						<span x-text="hits"></span> of { fmt.Sprint(len(props.Products)) } match
					</p>
				</div>
				<p class="border-2 border-ink bg-cream-hi p-6 text-center font-oswald text-chrome-deep text-sm" x-show="q && hits === 0" x-cloak>
					Nothing on the sheet matches — clear the filter to see the full lineup.
				</p>
			}
			if len(props.Products) == 0 {
				<div class="border-2 border-ink bg-cream-hi p-12 text-center" style="box-shadow: var(--shadow-stamp);">
					<p class="font-slab text-ink text-xl uppercase">The shelf's empty</p>
					<p class="mt-2 font-oswald text-chrome-deep text-sm">No coffee available to order right now — check back soon.</p>
				</div>
			}
			for _, product := range props.Products {
				<div class="border-2 border-ink bg-cream-hi" style="box-shadow: var(--shadow-stamp);" data-filter={ quickOrderFilterText(product) } x-show="match($el.dataset.filter)">
					<!-- Product header -->
					<div class="flex items-center gap-4 border-b-2 border-ink bg-paper-warm px-4 py-3">
						if product.ImageURL != "" {
							<img
								src={ product.ImageURL }
								alt={ product.Title }
								class="size-12 border-2 border-ink object-cover"
							/>
						} else {
							<div class="flex size-12 items-center justify-center border-2 border-ink bg-paper">
								<span class="font-slab text-ink text-lg uppercase leading-none">{ initial(product.Title) }</span>
							</div>
						}
						<h2 class="font-slab text-ink text-lg sm:text-xl uppercase leading-none" style="letter-spacing:0.01em;">{ product.Title }</h2>
					</div>
					<!--
						Variant table — desktop renders a true table; on mobile each
						<tr> collapses into a labeled card (weight, grind, price, qty,
						stock stacked) so there's no horizontal scroll. SKU is hidden
						on mobile since it's internal, not something buyers scan for.
					-->
					<div class="p-3 sm:p-0 sm:overflow-x-auto">
						<table class="w-full block sm:table">
							<thead class="hidden sm:table-header-group">
								<tr class="border-b-2 border-ink text-left font-oswald font-bold text-[11px] text-ink" style="letter-spacing:0.14em; text-transform:uppercase;">
									<th class="px-4 py-2.5">Code</th>
									for _, optName := range product.Options {
										<th class="px-4 py-2.5">{ optName }</th>
									}
									<!--
									Fixed width, because the price note under this column
									swaps between a ladder and a longer nudge as quantities
									change. Left to size itself, the column would resize
									mid-edit and shove the qty input sideways under the
									cursor — which is exactly when it must not move.
								-->
								<th class="px-4 py-2.5 w-72">Unit Price</th>
									<th class="px-4 py-2.5 text-center">Qty</th>
									<th class="px-4 py-2.5 text-right">Total</th>
								</tr>
							</thead>
							<tbody class="block sm:table-row-group">
								for _, variant := range product.Variants {
									<tr class="block border-2 border-ink mb-3 last:mb-0 px-3 py-1 sm:table-row sm:border-x-0 sm:border-t-0 sm:border-b sm:border-ink/15 sm:last:border-b-0 sm:p-0 sm:mb-0 hover:bg-paper-warm/60 transition-colors">
										<td class="hidden sm:table-cell whitespace-nowrap px-4 py-2.5 font-special text-sm text-chrome-deep">
											{ variant.SKU }
										</td>
										for i, val := range variant.OptionValues {
											<td class="flex items-center justify-between gap-4 py-1.5 sm:table-cell sm:whitespace-nowrap sm:px-4 sm:py-2.5">
												if i < len(product.Options) {
													<span class="sm:hidden font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.12em;">{ product.Options[i] }</span>
												}
												<span class="font-oswald text-sm text-ink">{ val }</span>
											</td>
										}
										<td class="flex items-baseline justify-between gap-4 py-1.5 sm:table-cell sm:whitespace-nowrap sm:px-4 sm:py-2.5">
											<span class="sm:hidden font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.12em;">Unit Price</span>
											<span>
												<span class="font-special text-base text-ink" data-unit-price>{ formatCents(variant.UnitPrice) }</span>
												if hint := moqHint(variant.MinQty, variant.Multiple); hint != "" {
													<span class="ml-1.5 font-oswald text-[11px] text-chrome-deep" style="letter-spacing:0.04em;">
														{ hint }
													</span>
												}
												<!--
													One note, two possible contents, swapped by
													recompute(): the ladder when no break is near, the
													nudge when one is. Saying both restates rather
													than informs — the nudge already names the rung it
													aims at.

													The ladder is rendered in Go, rungs and all, and
													the script only moves emphasis between them. It
													never formats a price, which is the whole reason
													the two stay in step.
												-->
												<span class="block font-oswald text-xs leading-snug" style="letter-spacing:0.04em;">
													<span data-ladder-note>
														@ladderNote(variant.Ladder, variant.CartQty)
													</span>
													<span class="hidden text-rust" data-nudge-note></span>
												</span>
											</span>
										</td>
										<td class="flex items-center justify-between gap-4 py-1.5 sm:table-cell sm:px-4 sm:py-2.5 sm:text-center">
											<span class="sm:hidden font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.12em;">Qty</span>
											<input
												type="number"
												name={ fmt.Sprintf("qty[%s]", variant.ID.String()) }
												min="0"
												step={ multipleAttr(variant.Multiple) }
												placeholder="0"
												if variant.CartQty > 0 {
													value={ fmt.Sprint(variant.CartQty) }
												}
												aria-label={ "Quantity for " + variant.SKU }
												data-ladder={ ladderJSON(variant.Ladder) }
												if variant.MinQty != nil {
													data-min={ fmt.Sprint(*variant.MinQty) }
												}
												if variant.Multiple != nil {
													data-mult={ fmt.Sprint(*variant.Multiple) }
												}
												x-on:input="recompute()"
												class="w-20 border-2 border-ink bg-cream-hi px-2 py-1.5 text-center font-special text-sm text-ink focus:outline-none focus:bg-paper [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
												style="box-shadow: var(--shadow-stamp-sm);"
											/>
										</td>
										<td class="flex items-baseline justify-between gap-4 py-1.5 sm:table-cell sm:whitespace-nowrap sm:px-4 sm:py-2.5 sm:text-right">
											<span class="sm:hidden font-oswald font-bold text-[10px] text-chrome-deep uppercase" style="letter-spacing:0.12em;">Total</span>
											<span class="font-special text-base text-ink" data-line-total>&mdash;</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			}
			if len(props.Products) > 0 {
				<!-- Sticky bottom bar — running total updates as quantities change -->
				<div class="sticky bottom-4 flex items-center justify-between gap-4 border-2 border-ink bg-paper-warm px-5 sm:px-6 py-4" style="box-shadow: var(--shadow-stamp);">
					<div class="min-w-0">
						<p class="font-oswald text-chrome-deep text-sm" x-show="cents === 0">Enter quantities to build your order.</p>
						<div class="flex items-baseline gap-2" x-show="cents > 0" x-cloak>
							<span class="font-special text-ink text-xl sm:text-2xl" x-text="money(cents)"></span>
							<span class="font-oswald font-bold text-chrome-deep text-[11px] uppercase" style="letter-spacing:0.14em;" x-text="units + (units === 1 ? ' unit' : ' units')"></span>
						</div>
					</div>
					<button
						type="submit"
						class="btn-stamp inline-flex shrink-0 items-center border-2 border-ink bg-rust text-paper px-6 py-3 font-oswald font-bold text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rust"
						style="letter-spacing:0.16em; text-transform:uppercase;"
					>
						if props.CartCount > 0 {
							Update Order
						} else {
							Add to Order
						}
					</button>
				</div>
			}
		</form>
	</div>
}

templ WholesalePortalPage(props WholesalePortalProps) {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:     "Quick Order",
		CartURL:   "/wholesale/checkout",
		CartCount: props.CartCount,
	}) {
		@WholesalePortalContent(props)
	}
}
