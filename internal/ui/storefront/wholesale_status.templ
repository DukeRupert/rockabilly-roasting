package storefront

import "github.com/dukerupert/hiri/internal/ui/layouts"

// WholesalePending is shown to wholesale customers whose application is still pending.
templ WholesalePendingContent() {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)] flex items-center">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-md w-full px-6 sm:px-10 lg:px-14 py-14 sm:py-20 text-center">
			<!-- Tilted "under review" stamp -->
			<div class="inline-flex items-center justify-center mb-8">
				<span
					class="relative inline-flex size-20 items-center justify-center bg-paper-warm border-2 border-ink"
					style="box-shadow: var(--shadow-stamp); transform: rotate(-4deg);"
				>
					<svg class="size-10 text-ink" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
					</svg>
				</span>
			</div>
			<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
				Hang tight
			</p>
			<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(1.75rem, 4.5vw, 2.75rem); letter-spacing:-0.005em;">
				Under
				<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">review.</span>
			</h1>
			<p class="mt-5 font-oswald text-ink-soft text-base leading-relaxed max-w-sm mx-auto">
				We're looking over your wholesale application now. We'll email you once it's approved — usually within two business days.
			</p>
			<a
				href="/catalog"
				class="btn-stamp inline-flex items-center gap-2 mt-8 bg-rust text-paper border-2 border-ink px-7 py-3.5 font-oswald font-bold text-sm"
				style="letter-spacing:0.14em; text-transform:uppercase;"
			>
				<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
				</svg>
				Keep shopping
			</a>
		</div>
	</section>
}

templ WholesalePending() {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Application Under Review",
		Description: "Your Rockabilly Roasting Co. wholesale application is being reviewed.",
	}) {
		@WholesalePendingContent()
	}
}

// WholesaleSuspended is shown to wholesale customers whose account has been suspended.
templ WholesaleSuspendedContent() {
	<!-- Full-bleed paper surface -->
	<section class="-mx-4 sm:-mx-6 lg:-mx-8 relative bg-paper min-h-[calc(100vh-4rem)] flex items-center">
		<!-- Paper grain overlay -->
		<div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle, rgba(14,13,12,0.6) 1px, transparent 1px); background-size: 3px 3px;"></div>
		<div class="relative mx-auto max-w-md w-full px-6 sm:px-10 lg:px-14 py-14 sm:py-20 text-center">
			<!-- Tilted "suspended" stamp -->
			<div class="inline-flex items-center justify-center mb-8">
				<span
					class="relative inline-flex size-20 items-center justify-center bg-paper-warm border-2 border-ink"
					style="box-shadow: var(--shadow-stamp); transform: rotate(-4deg);"
				>
					<svg class="size-10 text-ink" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"></path>
					</svg>
					<span
						class="absolute -bottom-2 -right-3 inline-block font-oswald font-bold text-[10px] text-rust bg-paper px-2 py-0.5 border-2 border-rust"
						style="letter-spacing:0.16em; text-transform:uppercase; transform:rotate(-10deg); outline:2px solid var(--color-rust); outline-offset:2px;"
					>
						On hold
					</span>
				</span>
			</div>
			<p class="font-oswald text-chrome-deep text-xs font-semibold" style="letter-spacing:0.24em; text-transform:uppercase;">
				Account paused
			</p>
			<h1 class="font-slab text-ink uppercase leading-[0.92] mt-2" style="font-size: clamp(1.75rem, 4.5vw, 2.75rem); letter-spacing:-0.005em;">
				Account
				<span class="font-script text-rust normal-case inline-block align-baseline" style="font-size:1.1em; letter-spacing:0;">on hold.</span>
			</h1>
			<p class="mt-5 font-oswald text-ink-soft text-base leading-relaxed max-w-sm mx-auto">
				Your wholesale account is suspended. Get in touch and we'll sort it out.
			</p>
			<a
				href="/catalog"
				class="btn-stamp inline-flex items-center gap-2 mt-8 bg-rust text-paper border-2 border-ink px-7 py-3.5 font-oswald font-bold text-sm"
				style="letter-spacing:0.14em; text-transform:uppercase;"
			>
				<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
				</svg>
				Keep shopping
			</a>
		</div>
	</section>
}

templ WholesaleSuspended() {
	@layouts.Storefront(layouts.StorefrontProps{
		Title:       "Account Suspended",
		Description: "Your Rockabilly Roasting Co. wholesale account is currently suspended.",
	}) {
		@WholesaleSuspendedContent()
	}
}
