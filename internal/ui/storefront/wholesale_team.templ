package storefront

import (
	"strings"

	"github.com/dukerupert/hiri/internal/domain"
	"github.com/dukerupert/hiri/internal/ui/layouts"
)

// --- Team (additional wholesale sign-ins) ---
//
// The account's primary sign-in is the customers row itself and has no
// customer_users record, so it is rendered from Customer rather than from
// Members and cannot be revoked here. Everything in Members is an invited
// teammate.

type WholesaleTeamProps struct {
	Customer    *domain.Customer
	CompanyName string
	Members     []domain.CustomerUser
	CartCount   int
	// ActingUserID is the invited teammate viewing the page, if the session
	// belongs to one rather than to the primary sign-in. Used to label their own
	// row and to warn before they remove themselves.
	ActingUserID string
	Success      string
	Error        string
	// InviteEmail / InviteName repopulate the form after a failed submit.
	InviteEmail string
	InviteName  string
}

templ WholesaleTeamContent(props WholesaleTeamProps) {
	@wholesaleAccountLayout("/wholesale/account/team", props.CompanyName) {
		<div class="max-w-2xl">
			@accountPageHeading("The Crew · Wholesale", "Who can order")
			if props.Success != "" {
				<div class="mb-6 border-2 border-ink bg-candle/20 px-4 py-3">
					<p class="font-oswald text-ink text-sm" style="letter-spacing:0.04em;">{ props.Success }</p>
				</div>
			}
			if props.Error != "" {
				<div class="mb-6 border-2 border-rust bg-cream-hi px-4 py-3">
					<p class="font-oswald font-bold text-rust text-sm" style="letter-spacing:0.04em;">{ props.Error }</p>
				</div>
			}
			<p class="font-oswald text-ink-soft text-sm mb-8" style="letter-spacing:0.04em; line-height:1.6;">
				Anyone here can sign in with their own password and place orders on the { props.CompanyName } account. Orders, pricing, and history stay on the account — not on the person.
			</p>
			<!-- Roster -->
			<div class="border-2 border-ink bg-cream-hi shadow-stamp mb-10">
				<!-- Primary sign-in — always present, never revocable -->
				<div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-4 border-b-2 border-ink/20">
					<div class="min-w-0 flex-1">
						<p class="font-oswald font-bold text-ink text-sm truncate" style="letter-spacing:0.04em;">{ props.Customer.Email }</p>
						<p class="font-special text-chrome-deep text-xs mt-0.5">Account contact · always receives email</p>
					</div>
					<span class="shrink-0 border-2 border-ink bg-paper px-2.5 py-1 font-oswald font-bold text-ink text-[10px]" style="letter-spacing:0.16em; text-transform:uppercase;">Primary</span>
				</div>
				if len(props.Members) == 0 {
					<div class="px-5 py-8 text-center">
						<p class="font-oswald text-ink-soft text-sm" style="letter-spacing:0.04em;">No one else yet. Invite a manager below and they'll get their own sign-in.</p>
					</div>
				} else {
					for _, m := range props.Members {
						@teamMemberRow(m, props.ActingUserID)
					}
				}
			</div>
			<!-- Invite -->
			<div class="border-2 border-ink bg-paper p-6">
				<p class="font-oswald font-bold text-candle text-[11px] mb-4 pb-2 border-b-2 border-ink" style="letter-spacing:0.24em; text-transform:uppercase;">Invite someone</p>
				<form method="POST" action="/wholesale/account/team/invite" class="space-y-5">
					<div class="grid sm:grid-cols-2 gap-4">
						<div>
							<label for="invite_email" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Email</label>
							<input type="email" id="invite_email" name="email" value={ props.InviteEmail } required autocomplete="off" placeholder="manager@cafe.com"
								class="paper-input w-full border-2 border-ink bg-cream-hi px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none" style="letter-spacing:0.04em;"/>
						</div>
						<div>
							<label for="invite_name" class="font-oswald font-bold text-ink text-[11px] mb-2 block" style="letter-spacing:0.2em; text-transform:uppercase;">Name (optional)</label>
							<input type="text" id="invite_name" name="name" value={ props.InviteName } autocomplete="off" placeholder="Sam Rivera"
								class="paper-input w-full border-2 border-ink bg-cream-hi px-3.5 py-2.5 font-oswald text-sm text-ink placeholder:text-chrome-deep focus:outline-none" style="letter-spacing:0.04em;"/>
						</div>
					</div>
					<label class="flex items-start gap-3 cursor-pointer">
						<input type="checkbox" name="receives_notifications" value="1" class="mt-0.5 size-4 shrink-0 border-2 border-ink accent-rust"/>
						<span class="font-oswald text-ink text-sm" style="letter-spacing:0.04em;">
							Send them order confirmations and the weekly reminder
							<span class="block font-oswald text-chrome-deep text-xs mt-0.5">Off by default — the account contact always gets these.</span>
						</span>
					</label>
					<div class="pt-1">
						<button type="submit" class="btn-stamp inline-flex items-center gap-2 bg-rust text-paper border-2 border-ink px-6 py-3 font-oswald font-bold text-sm" style="letter-spacing:0.16em; text-transform:uppercase;">
							Send invite
						</button>
					</div>
					<p class="font-oswald text-chrome-deep text-xs" style="letter-spacing:0.04em;">
						They'll get an email with a link to set their own password. The link is good for 72 hours.
					</p>
				</form>
			</div>
		</div>
	}
}

// teamMemberRow renders one invited teammate: their status, their email
// preference toggle, and the controls to re-send or revoke.
templ teamMemberRow(m domain.CustomerUser, actingUserID string) {
	<div class="flex flex-wrap items-center gap-x-4 gap-y-3 px-5 py-4 border-b-2 border-ink/20 last:border-b-0">
		<div class="min-w-0 flex-1">
			<p class="font-oswald font-bold text-ink text-sm truncate" style="letter-spacing:0.04em;">
				{ m.DisplayName() }
				if m.ID.String() == actingUserID {
					<span class="font-normal text-chrome-deep">(you)</span>
				}
			</p>
			if m.Name != "" {
				<p class="font-special text-chrome-deep text-xs mt-0.5 truncate">{ m.Email }</p>
			}
		</div>
		if !m.HasAcceptedInvite() {
			<span class="shrink-0 border-2 border-candle bg-candle/20 px-2.5 py-1 font-oswald font-bold text-ink text-[10px]" style="letter-spacing:0.16em; text-transform:uppercase;">Invited</span>
		}
		<!-- Email preference — posts on change, no separate save button -->
		<form method="POST" action={ templ.SafeURL("/wholesale/account/team/" + m.ID.String() + "/notifications") } class="shrink-0">
			<input type="hidden" name="enabled" value={ toggleTarget(m.ReceivesNotifications) }/>
			<button type="submit" class={ teamToggleClass(m.ReceivesNotifications) } style="letter-spacing:0.14em; text-transform:uppercase;"
				title="Order confirmations and the weekly reminder">
				if m.ReceivesNotifications {
					Email on
				} else {
					Email off
				}
			</button>
		</form>
		<div class="flex shrink-0 items-center gap-2">
			<form method="POST" action={ templ.SafeURL("/wholesale/account/team/" + m.ID.String() + "/resend") }>
				<button type="submit" class="font-oswald font-bold text-[10px] text-chrome-deep hover:text-rust transition-colors" style="letter-spacing:0.16em; text-transform:uppercase;">
					if m.HasAcceptedInvite() {
						Reset
					} else {
						Resend
					}
				</button>
			</form>
			<span class="text-ink/30" aria-hidden="true">·</span>
			<form method="POST" action={ templ.SafeURL("/wholesale/account/team/" + m.ID.String() + "/revoke") }
				x-data
				x-on:submit={ teamRevokeConfirm(m, actingUserID) }>
				<button type="submit" class="font-oswald font-bold text-[10px] text-chrome-deep hover:text-rust transition-colors" style="letter-spacing:0.16em; text-transform:uppercase;">
					Remove
				</button>
			</form>
		</div>
	</div>
}

// toggleTarget returns the value the notification form should post — the
// opposite of the current state.
func toggleTarget(enabled bool) string {
	if enabled {
		return "0"
	}
	return "1"
}

func teamToggleClass(enabled bool) string {
	base := "border-2 px-2.5 py-1 font-oswald font-bold text-[10px] transition-colors "
	if enabled {
		return base + "border-ink bg-ink text-paper hover:bg-rust hover:border-rust"
	}
	return base + "border-ink/40 bg-paper text-chrome-deep hover:border-ink hover:text-ink"
}

// teamRevokeConfirm warns before removal. Removing yourself ends your own
// session immediately, so that case gets its own wording.
func teamRevokeConfirm(m domain.CustomerUser, actingUserID string) string {
	msg := "Remove " + m.Email + " from this account? They will be signed out immediately."
	if m.ID.String() == actingUserID {
		msg = "Remove your own sign-in? You will be signed out immediately and will need a new invite to get back in."
	}
	return "if (!confirm('" + escapeJSSingleQuoted(msg) + "')) $event.preventDefault()"
}

// escapeJSSingleQuoted makes a string safe to embed in a single-quoted JS
// literal. An email local-part may legally contain an apostrophe or backslash
// (o'brien@cafe.com is a valid address), which would otherwise terminate the
// literal and break the confirm dialog.
func escapeJSSingleQuoted(s string) string {
	s = strings.ReplaceAll(s, `\`, `\\`)
	return strings.ReplaceAll(s, `'`, `\'`)
}

templ WholesaleTeamPage(props WholesaleTeamProps) {
	@layouts.Storefront(layouts.StorefrontProps{Title: "Team", CartURL: "/wholesale/checkout", CartCount: props.CartCount}) {
		@WholesaleTeamContent(props)
	}
}
