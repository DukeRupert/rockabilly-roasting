# Deploy to /opt/rockabilly-roasting/backup.env (chmod 600, deploy:deploy)
# Loaded by /usr/local/sbin/rr-backup.sh — rclone picks up RCLONE_CONFIG_* automatically.

# --- destination ---
R2_BUCKET=rockabilly-roasting-db

# rclone remote (inline env config — no rclone.conf needed)
RCLONE_CONFIG_R2BACKUPS_TYPE=s3
RCLONE_CONFIG_R2BACKUPS_PROVIDER=Cloudflare
RCLONE_CONFIG_R2BACKUPS_ACCESS_KEY_ID=CHANGE_ME
RCLONE_CONFIG_R2BACKUPS_SECRET_ACCESS_KEY=CHANGE_ME
RCLONE_CONFIG_R2BACKUPS_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
RCLONE_CONFIG_R2BACKUPS_REGION=auto
RCLONE_CONFIG_R2BACKUPS_ACL=private

# --- alerting (reuses app Postmark + from address) ---
POSTMARK_SERVER_TOKEN=CHANGE_ME
EMAIL_FROM=noreply@rockabillyroasting.com
ALERT_EMAIL=logan@fireflysoftware.dev
